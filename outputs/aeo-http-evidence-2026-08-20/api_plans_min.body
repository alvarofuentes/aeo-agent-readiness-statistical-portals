/id_institution":"45197","responsible_institution/name_institution":"Coordenadoria de Governo Aberto - Secretaria Executiva de Relações Institucionais (SERI) de Sāo Paulo"}],"plan_number":"3","link":"9124a71b-e772-49f2-b5e3-6d28e5ba5578","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/gravity_forms/29-0e9f68e16ea0d3f95fde8489616a2fcb/2024/07/3o-Plano-de-Acao-em-Governo-Aberto-documento_compressed-1.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de São Paulo/ Ciudad de São Paulo","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"São Paulo se unió a Alianza para el Gobierno Abierto  como parte de la cohorte de 2016. El tercer plan de acción incluye compromisos relacionados con la contratación abierta, la salud, los ODS y la participación ciudadana.","description_en":"São Paulo joined the Open Government Partnership as part of the 2016 cohort. The third action plan includes commitments related to open contracting, health, the SDGs, and citizen participation.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b16f0b32-dc49-45b7-9f25-61d21285162e","meta/deprecatedID":"uuid:14dadecf-e7f3-435b-a77a-d4642616fa4a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b16f0b32-dc49-45b7-9f25-61d21285162e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:25","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b16f0b32-dc49-45b7-9f25-61d21285162e"},{"_id":46526,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:27.487","end":"2025-11-07T14:26:27.487","id_drupal":"2045","country":"cri","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Sarchí 2023-2024","name_en":"First Open Government Action Plan of Sarchí 2023-2024","responsible_institution":[{"responsible_institution/institution":"Departamento Legal y Departamento de Planificación de Sarchí","responsible_institution/id_institution":"45500","responsible_institution/name_institution":"Departamento Legal y Departamento de Planificación de Sarchí"}],"coordinator":"Concejo Cantonal de Coordinación Institucional de Sarchi","id_coordinator":"45102","name_coordinator":"Concejo Cantonal de Coordinación Institucional de Sarchi","plan_number":"1","primary_link":"https://www.opengovpartnership.org/documents/action-plan-sarchi-costa-rica-2023-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Cantón de Sarchí","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Sarchi se unió a Alianza para el Gobierno Abierto  como parte de la cohorte 2022.El primer plan de acción presenta compromisos relacionados con la gobernanza digital y el espacio cívico.","description_en":"Sarchí joined the Open Government Partnership as part of the 2022 cohort. The first action plan presents commitments related to digital governance and civic space.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ad22180a-b98f-49f8-883d-9512d2536526","meta/deprecatedID":"uuid:d1c99d5e-fcfd-470b-9839-c56b9635290b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ad22180a-b98f-49f8-883d-9512d2536526","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ad22180a-b98f-49f8-883d-9512d2536526"},{"_id":46527,"start":"2025-11-07T14:26:28.208-03:00","end":"2026-01-14T15:49:12.177-03:00","id_drupal":"1858","country":"cri","theme":"public_investment","original_language":"es","name_es":"Plan Nacional de Desarrollo e Inversión Pública 2023-2026","name_en":"National Development and Public Investment Plan 2023-2026","responsible_institution":[{"responsible_institution/institution":"Unidad de Inversiones Públicas","responsible_institution/id_institution":"45384","responsible_institution/name_institution":"Unidad de Inversiones Públicas"}],"link":"00389692-b1e8-4f90-a2d1-4a5dc991074f","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"Se considera al Plan Nacional de Desarrollo e Inversión Pública como un instrumento para la formulación de prioridades estratégicas para el desarrollo del país. Es un instrumento que se construye a partir de las mejores prácticas internacionales en materia de planificación y evaluación de las políticas públicas, donde se consideran aquellos ámbitos estratégicos con alto potencial hacia el desarrollo económico y social requerido por nuestro país. Asimismo, es el instrumento principal de política pública de mediano plazo para el país, donde la promesa democrática se concreta y se valida de forma directa por el mandato de gobierno dado en las urnas en el pasado proceso de elecciones democráticas.\n\nEste PNDIP considera al ciudadano y la búsqueda de su mayor bienestar y prosperidad, como un elemento central en la planificación estratégica de las distintas intervenciones públicas basadas en el Modelo de Gestión para los Resultados de Desarrollo, las cuales se ajustan a las necesidades actuales y futuras de la sociedad costarricense, así como a las distintas agendas y objetivos internacionales para el desarrollo, como el Consenso de Montevideo sobre Población y Desarrollo y los ODS de la Agenda 2030. De esta manera se concretan los distintos esfuerzos de políticas, metas, programas y proyectos sectoriales de relevancia para la visión de desarrollo sectorial y regional de la actual Administración. Se destaca la priorización de líneas estratégicas en atención a los desafíos económicos, sociales, ambientales, de seguridad ciudadana, que accionan prioridades como la modernización del aparato estatal, la reactivación económica, la disminución del costo de la vida, del desempleo, la pobreza, la desigualdad, las brechas territoriales, entre otras; las cuales a partir de un enfoque integral y moderno de las políticas públicas, permitan impactar de manera real, sobre aquellos ámbitos que aquejan la gobernanza estatal para dinamizar la atención de estos desafíos y con ello alcanzar el bienestar de los costarricenses.\n\nEl Plan Nacional de Desarrollo e Inversión Pública 2023-2026 (PNDIP) hace referencia al marco orientador de las políticas del Gobierno para un período de cuatro años, elaborado bajo la coordinación de Mideplan con las demás instituciones del Sistema Nacional de Planificación (SNP) y la participación ciudadana. El PNDIP debe estar en congruencia con el Plan Estratégico Nacional (PEN) y considerando los Planes Nacionales Sectoriales (PNS) y Planes Regionales de Desarrollo (PRD). El PNDIP define objetivos, intervenciones y metas para el desarrollo del país, así como las prioridades presupuestarias públicas.","description_en":"The National Development and Public Investment Plan is considered a tool for formulating strategic priorities for the country’s development. It is built from the best international practices in public policy planning and evaluation, focusing on strategic areas with high potential for the economic and social development needed by our country. It is also the main medium-term public policy instrument for the country, where the democratic promise is directly realized and validated by the government mandate given at the ballot box during the past democratic elections. \n\nThis PNDIP places the citizen and the search for their greater well-being and prosperity at the center of the strategic planning of various public interventions based on the Results-Based Management Model, which aligns with the current and future needs of Costa Rican society, as well as various international development agendas and objectives, such as the Montevideo Consensus on Population and Development and the SDGs of the 2030 Agenda. In this way, the various efforts in policies, goals, programs, and sectoral projects relevant to the current Administration’s sectoral and regional development vision are materialized. The prioritization of strategic lines in response to economic, social, environmental, and public security challenges is highlighted, addressing priorities such as modernization of the state apparatus, economic recovery, reduction of the cost of living, unemployment, poverty, inequality, territorial gaps, and others. These priorities, through an integrated and modern approach to public policies, aim to have a real impact on areas that affect state governance, facilitating the response to these challenges and ultimately achieving the well-being of Costa Ricans.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_5 sdg_8 sdg_9 sdg_10 sdg_13 sdg_16 sdg_17","pip/pip_project_list":"yes","pip/pip_period":"multiannual","pip/pip_project_list_es":"Se presenta un resumen consolidado de las propuestas sectoriales en el que se detallan las metas, intervención pública, presupuesto, vinculación con Plan Regional de Desarrollo, Plan Estratégico Nacional 2050, ODS y Consenso de Montevideo.","pip/pip_project_list_en":"A consolidated summary of the sectoral proposals is presented, detailing the goals, public intervention, budget, and linkages with the Regional Development Plan, the National Strategic Plan 2050, the SDGs, and the Montevideo Consensus.","pip/pip_costing":"yes","pip/pip_costing_es":"El plan nacional de inversiones considera el costeo de los proyectos de inversión.","pip/pip_costing_en":"The National Investment Plan takes into account the costing of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con estimación presupuestaria.","pip/pip_budget_en":"The investment projects included in the plan have budget estimates.","pip/pip_territorialization":"no","pip/pip_indicators":"yes","pip/pip_indicators_es":"El Plan de Inversiones incluye indicadores de producto y/o resultados.","pip/pip_indicators_en":"The Investment Plan includes output and/or outcome indicators.","pip/pip_priorization":"yes","pip/pip_priorization_es":"Además de la priorización con la estrategia de la Administración Nacional, se encuentran: Tasa de crecimiento del PIB real, deuda pública como porcentaje del PIB, la tasa de desempleo abierto Total, el porcentaje de hogares pobres según Línea de Pobreza, el coeficiente de Gini, el número de homicidios dolosos Total y la Tasa de variación interanual de las emisiones de CO2 debido a uso de combustibles fósiles.","pip/pip_priorization_en":"In addition to prioritization aligned with the National Administration’s strategy, the following indicators are considered: the real GDP growth rate, public debt as a percentage of GDP, the total open unemployment rate, the percentage of poor households according to the poverty line, the Gini coefficient, the total number of intentional homicides, and the year-on-year rate of change in CO₂ emissions due to the use of fossil fuels.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Estratégico Nacional 2050 de Costa Rica","link_block/plan_id":"46558","link_block/plan_name":"Plan Estratégico Nacional 2050 de Costa Rica"},{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Decreto 43903. Emisión del Plan Nacional de Desarrollo e Inversión Pública (PNDIP) 2023-2026","link_block/external_link_text_en":"Decree 43903: Issuance of the National Development and Public Investment Plan (NDIP) 2023–2026","link_block/external_link_text_url":"https://repositorio.mopt.go.cr/items/e8e44139-16df-4159-b3a5-4ae0fed17534"}],"meta/instanceID":"uuid:d0e235c4-db42-4b05-a1be-53beefea0d99","meta/deprecatedID":"uuid:ef4e2c3c-0c1c-4f50-be9e-d1d3c8d4fbc2","__version__":"vLkfVRQgpZUqPYUdunwjBx","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d0e235c4-db42-4b05-a1be-53beefea0d99","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:27","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d0e235c4-db42-4b05-a1be-53beefea0d99"},{"_id":46528,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:28.923","end":"2025-11-07T14:26:28.923","id_drupal":"1746","country":"dom","theme":"mobility","original_language":"es","name_es":"Plan de Movilidad Urbana Sostenible (PMUS) del Gran Santo Domingo","name_en":"Sustainable Urban Mobility Plan for Greater Santo Domingo","responsible_institution":[{"responsible_institution/institution":"Instituto Nacional de Tránsito y Transporte Terrestre (INTRANT)","responsible_institution/id_institution":"44956","responsible_institution/name_institution":"Instituto Nacional de Tránsito y Transporte Terrestre (INTRANT)"}],"link":"ea137946-8d8e-486e-9239-c0a4c62f9d3b","primary_link":"https://www.mobiliseyourcity.net/sites/default/files/2020-01/PMUS%20Gran%20Santo%20Domingo.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Gran Santo Domingo","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","description_es":"Se definen los siguientes objetivos 1.Desarrollo de una red estructurante completa,. 2 Planear una forma urbana más eficiente 3.Devolver espacios a la movilidad sostenible ","description_en":"The following objectives are defined:\n\nDevelop a complete structural network.\n\nPlan a more efficient urban form.\n\nReturn spaces to sustainable mobility.","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_gender_es":"Se considera mediante la inclusión de cuota de mujeres dentro de los usuarios regulares de la red de transporte.","pmu/pmu_gender_en":"It is considered through the inclusion of a quota for women within the regular users of the transport network.","pmu/pmu_budget":"1650000000","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f9ed2103-f509-4b69-8d35-4bcc378d5f77","meta/deprecatedID":"uuid:e0b3aca2-c510-4fc9-9cf1-4e6763923bda","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f9ed2103-f509-4b69-8d35-4bcc378d5f77","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:28","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f9ed2103-f509-4b69-8d35-4bcc378d5f77"},{"_id":46529,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:29.651","end":"2025-11-07T14:26:29.651","id_drupal":"1738","country":"bol","theme":"mobility","original_language":"es","name_es":"Movilidad intraurbana en la Región Metropolitana de La Paz","name_en":"Intra-Urban Mobility in the Metropolitan Region of La Paz","responsible_institution":[{"responsible_institution/institution":"Secretaría Municipal de Planificación para el Desarrollo / Dirección de Investigación e Información Municipal","responsible_institution/id_institution":"45545","responsible_institution/name_institution":"Secretaría Municipal de Planificación para el Desarrollo / Dirección de Investigación e Información Municipal"}],"link":"00dc78e8-3330-4ec6-b437-a8434c03d6f5","primary_link":"https://sitservicios.lapaz.bo/cartillas/otraspublicaciones/Movilidad%20intra-urbana_12_1.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Región Metropolitana de la Paz","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2041-01-01","effective_today":"yes","temporality":"long_term","description_es":"Se definen tres ámbitos de objetivos: Mejorar la infraestructura vial, así como dotar de equipamiento adecuado para un mejor desenvolvimiento de las actividades diarias de la ciudadanía bajo un enfoque de calidad e inclusión. Desarrollar el transporte masivo a nivel municipal y metropolitano para brindar un mejor servicio a los habitantes de la Región Metropolitana de La Paz. Y mejorar la calidad de la movilidad Intraurbana a través del trabajo conjunto entre autoridades municipales y departamentales para mejorar las condiciones de vida de los habitantes de la Región Metropolitana de La Paz.","description_en":"Three objective areas are defined: Improve road infrastructure and provide adequate equipment to facilitate citizens' daily activities under a quality and inclusion approach. Develop mass transit at the municipal and metropolitan levels to provide better service to the inhabitants of the Metropolitan Region of La Paz. Improve intra-urban mobility quality through joint work between municipal and departmental authorities to enhance living conditions.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Se plantea proveer de facilidades adecuadas y convenientemente ubicadas para los servicios de taxis en afueras de los principales sitios de intercambio modal (191) se recomienda el cambio de algunas terminales de taxis existents para la provisión de servicios de taxis y/o radiotaxis a las terminales principales del SITP, como una forma de fomentar el uso del transporte público a los usuarios que se cambie del modo vehículo particular. El PMUS propone conformar un Sistema Integrado de Transporte Público como el eje estructurados del sistema de movilidad en la ciudad, articulando los diferentes modos, en donde éste modo de transporte y el transporte a pie sean las primeras prioridades para las inversiones del GAMLP en materia de transporte\"\" (135). Restructuración de las rutas del sistema de transporte público actual (136). Restricción de estacionamientos en el centro de la ciudad e implantación de estacionamientos disuasorios (88) (95) la gestión del estacionamiento es considerada como el instrumento individualmente mas eficaz para desincentivar el uso de vehículo privado y promover el transporte público\"\" (124) Se especifica las calles donde implementar las restricciones de estacionamientos. Medidas para proveer a peatones (33) Las estrategias específicas para mejorar la movilidad de los peatones y personas con movilidad reducida incluyen la implantación de las siguientes medidas: Mejoramiento de infraestructura en los circuitos peatonales; Ampliación de aceras en sectores específicos; Peatonalización de vías; Implantación de zonas de tráfico calmado o Zonas 20; Implantación de red de funiculares. Implantación de ciclovías (62) Se hacen propuestas de ciclovias a corto, mediano plazo\"","pmu/pmu_prioritization_en":"It is proposed to provide adequate and conveniently located facilities for taxi services in the outskirts of the main modal interchange sites (191) it is recommended to change some existing taxi terminals for the provision of taxi and/or radio taxi services to the main terminals of the SITP, as a way of encouraging the use of public transport to users who change from the private vehicle mode. The SUMP proposes to form an Integrated Public Transport System as the structured axis of the mobility system in the city, articulating the different modes, where this mode of transport and walking transport are the first priorities for the GAMLP's investments in transport\"\" (135). Restructuring of the routes of the current public transport system (136). Restriction of parking in the city center and implementation of dissuasive parking (88) (95) parking management is considered to be the single most effective instrument to discourage the use of private vehicles and promote public transport\"\" (124) The streets where parking restrictions are implemented are specified. Measures to provide for pedestrians (33) Specific strategies to improve the mobility of pedestrians and people with reduced mobility include the implementation of the following measures: Improvement of infrastructure in pedestrian circuits; Widening of sidewalks in specific sectors; Pedestrianization of roads; Implementation of traffic calming zones or Zones 20; Implementation of a network of funiculars. Implementation of bike lanes (62) Proposals for bike lanes are made in the short and medium term\"","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:4b6878ca-a710-473c-934d-92509f11d309","meta/deprecatedID":"uuid:15d58f2a-e932-4b99-b3f3-6f4b849496be","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4b6878ca-a710-473c-934d-92509f11d309","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:28","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4b6878ca-a710-473c-934d-92509f11d309"},{"_id":46530,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:30.382","end":"2025-11-07T14:26:30.382","id_drupal":"1754","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad urbana sustentable Zona Metropolitana de Tuxtla Gutierrez","name_en":"Comprehensive Sustainable Urban Mobility Plan for the Tuxtla Gutiérrez Metropolitan Area","responsible_institution":[{"responsible_institution/institution":"Gobierno del Estado de Chiapas","responsible_institution/id_institution":"45531","responsible_institution/name_institution":"Gobierno del Estado de Chiapas"}],"primary_link":"http://www.sop.chiapas.gob.mx/descargassop/ANEXOS/PIMUS%20ZM%20TUXTLA%20GTZ/1.3.%20PIMUS%20ZM%20TUXTLA%20GTZ.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Zona Metropolitana de Tuxtla Gutiérrez (ZM-TG) ","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","description_es":"Sus ejes estratégicos son: ciudades accesibles, ciudades para el transporte no motorizado, ciudades con eficiente movilidad motorizada, y ciudades con un sistema integrado de transporte público metropolitano sustentable.","description_en":"Strategic axes are: accessible cities, cities for non-motorized transport, cities with efficient motorized mobility, and cities with an integrated, sustainable metropolitan public transport system.\n","linking_sdg_plans":"yes","pga/pga_monitoring_platform":"|","pmu/pmu_implementation":"goals","pmu/pmu_implementation_es":"Transporte urbano: Minimizar las emisiones de Gases Efecto Invernadero (GEI) y la contaminación a través del desarrollo de sistemas eficientes de transporte sustentable.","pmu/pmu_implementation_en":"Urban transport: Minimize greenhouse gas (GHG) emissions and pollution through the development of efficient sustainable transport systems.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"*Peatón: constituir andadores o corredores peatonales en la zona centro de Tuxtla Gutiérrez. Establecer bahías para protección de peatones, señalamiento vertical y horizontal y dispositivos electrónicos para la protección de transeúntes. *Transporte público: reestructurar y reorganizar las rutas de transporte público úrbano y suburbano, pavimentar los accesos a colonias populares para garantizar la eficiencia de las rutas de transporte público. *Bicicleta: implementar un sistema y subsistema de ciclovías en el área mtropolitana particularmente en las zonas urbanas donde exista mayor demanda; constituir un sistema de bicicletas públicas en la zona centro de la capital *Transporte privado: establecer campañas de difusión para el uso racional del automóvil, preferentemente en distancias mayores a los 2.00km. Construir nuevas vialidades que funjan como rutas alternas, consolidar la red vial primaria y secundaria, ampliar la capacidad de las vialidades primarias y secundarias mediante la ampliación de carriles. \"","pmu/pmu_prioritization_en":"*Pedestrian: constitute walkways or pedestrian corridors in the downtown area of Tuxtla Gutiérrez. Establish bays for pedestrian protection, vertical and horizontal signaling and electronic devices for the protection of pedestrians. *Public transport: restructure and reorganize the urban and suburban public transport routes, pave the accesses to popular neighborhoods to guarantee the efficiency of public transport routes. * Bicycle: implement a system and subsystem of bicycle lanes in the metropolitan area, particularly in urban areas where there is greater demand; To establish a system of public bicycles in the downtown area of the capital *Private transport: to establish dissemination campaigns for the rational use of the car, preferably in distances greater than 2.00km. Build new roads that serve as alternate routes, consolidate the primary and secondary road network, expand the capacity of primary and secondary roads by widening lanes. \"","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective.","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:076237d4-8a29-4795-87f2-da0ebe0a90a4","meta/deprecatedID":"uuid:323fd61a-e8eb-43f4-bd36-6175fcc6fdc4","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"076237d4-8a29-4795-87f2-da0ebe0a90a4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:076237d4-8a29-4795-87f2-da0ebe0a90a4"},{"_id":46531,"start":"2025-11-07T14:26:31.196-03:00","end":"2026-03-09T17:42:49.010-03:00","id_drupal":"1723","country":"bol","theme":"development_planning","original_language":"es","name_es":"Plan de Desarrollo Económico y Social (PDES) 2021-2025 de Bolivia","name_en":"Economic and Social Development Plan (PDES) 2021-2025 of Bolivia","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación del Desarrollo (MPD) de Bolivia","responsible_institution/id_institution":"45246","responsible_institution/name_institution":"Ministerio de Planificación del Desarrollo (MPD) de Bolivia"}],"link":"4970e0b6-e93d-4587-bd91-e05a5913b96a","primary_link":"https://www.planificacion.gob.bo/uploads/PDES_2021-2025aa.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de Desarrollo Económico y Social 2021- 2025 “Reconstruyendo la Economía para Vivir Bien, Hacia la Industrialización con Sustitución de Importaciones” se constituye en el plan de mediano plazo del Estado Plurinacional de Bolivia.\n\nEl Plan está organizado en diez Ejes Estratégicos articulados con los 13 pilares de la Agenda Patriótica del Bicentenario 2025, y establece las metas, resultados y acciones para avanzar en el último tramo hacia el cumplimiento de esta.","description_en":"The Economic and Social Development Plan 2021–2025, titled “Rebuilding the Economy for Living Well, Towards Industrialization with Import Substitution,” constitutes the medium-term plan of the Plurinational State of Bolivia.\n\nThe Plan is organized into ten Strategic Axes, aligned with the 13 pillars of the Patriotic Agenda of the Bicentennial 2025, and sets forth the goals, results, and actions needed to advance in the final stage toward achieving those national objectives.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:295319d4-ca94-4347-bd4c-738d9d0a34a1","meta/deprecatedID":"uuid:fa2ac8ae-cd17-4bb4-a3e0-5cf6bb2c4f4a","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"295319d4-ca94-4347-bd4c-738d9d0a34a1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:30","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:295319d4-ca94-4347-bd4c-738d9d0a34a1"},{"_id":46532,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:31.913","end":"2025-11-07T14:26:31.913","id_drupal":"2055","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Tlalnepantla de Baz 2021-2023","name_en":"First Open Government Action Plan of Tlalnepantla de Baz 2021-2023","responsible_institution":[{"responsible_institution/institution":"Instituto de Transparencia, Acceso a la Información Pública y Protección de Datos Personales del Estado de México y Municipios (INFOEM) / Secretaría de la Contraloría","responsible_institution/id_institution":"45112","responsible_institution/name_institution":"Instituto de Transparencia, Acceso a la Información Pública y Protección de Datos Personales del Estado de México y Municipios (INFOEM) / Secretaría de la Contraloría"}],"coordinator":"Secretariado Técnico Local del Estado de México","id_coordinator":"45315","name_coordinator":"Secretariado Técnico Local del Estado de México","plan_number":"1","link":"f806a445-6807-4dbc-895c-491de0fe7054","primary_link":"https://www.infoem.org.mx/doc/gobiernoAbierto/20211221_Plan_de_Accion_Local_Edomex.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de México","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Tlalnepantla de Baz se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción presenta compromisos relacionados con el acceso a la justicia, datos abiertos, acceso a la información y participación ciudadana.  Este primer plan de acción es un trabajo en consorcio con el Estado de México.\n\n El Primer Plan de Acción cuenta con 8 compromisos:\nCompromiso 1: Fortalecimiento y ampliación del programa de justicia itinerante y acceso a la justicia “Caravanas por la Justicia Cotidiana”\nCompromiso 2: Interoperabilidad institucional a través de la tarjeta legal\nCompromiso 3: Fortalecimiento de los Mecanismos Alternativos de Solución de Controversias como medio de acceso a la justicia cotidiana\nCompromiso 4: Legislación estatal en materia de Justicia Cotidiana\nCompromiso 5: Fortalecimiento de los medios de acceso a la transparencia pública, datos abiertos y datos de interés público\nCompromiso 6: Generar alianzas con los municipios del Estado de México para difundir el uso y beneficios del acceso a la información\nCompromiso 7: Cultura de gobierno abierto\nCompromiso 8: Fortalecimiento de la democracia","description_en":"Tlalnepantla de Baz joined the Open Government Partnership as part of the 2020 Cohort. The first action plan presents commitments related to access to justice, open data, access to information, and citizen participation. This first action plan is a collaborative effort with the State of Mexico.\n\nThe First Action Plan includes 8 commitments:\nCommitment 1: Strengthening and expanding the itinerant justice program and access to justice \"Caravans for Daily Justice.\"\nCommitment 2: Institutional interoperability through the legal card.\nCommitment 3: Strengthening Alternative Dispute Resolution Mechanisms as a means of daily justice access.\nCommitment 4: State legislation on Daily Justice.\nCommitment 5: Strengthening public transparency, open data, and data of public interest access.\nCommitment 6: Generating partnerships with municipalities in the State of Mexico to promote the use and benefits of access to information.\nCommitment 7: Open government culture.\nCommitment 8: Strengthening democracy.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2a92f6ae-97a1-487b-ad6e-331d4743a067","meta/deprecatedID":"uuid:b26ad46b-3fa9-4c7f-993a-18a945a0faab","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2a92f6ae-97a1-487b-ad6e-331d4743a067","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2a92f6ae-97a1-487b-ad6e-331d4743a067"},{"_id":46533,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:32.631","end":"2025-11-07T14:26:32.631","id_drupal":"987","country":"ury","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Uruguay (2018-2020)","name_en":"Fourth National Open Government Action Plan of Uruguay (2018-2020)","responsible_institution":[{"responsible_institution/institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay","responsible_institution/id_institution":"45242","responsible_institution/name_institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","id_coordinator":"45001","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","plan_number":"4","link":"b1dd27d9-6edc-4b98-a963-e61f0f234912","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2018/10/Uruguay_Action-Plan_2018-2020.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Uruguay elaboró el 4° Plan Nacional de Acción de Gobierno Abierto a través de un proceso participativo que implicó un diálogo constante y la activa participación de representantes de las Instituciones Públicas, de la Sociedad civil organizada, de la Academia y del Sector Privado. El proceso fue diseñado y liderado por el Grupo de Trabajo de Gobierno Abierto.\n\nPara la construcción se establecieron espacios y plataformas de diálogo y cocreación efectivizándose a través de mesas de diálogo, grupos de trabajo y talleres específicos para debatir e intercambiar ideas y propuestas de compromisos para el plan con el objetivo que desde su concepción estuvieran representados la mayor cantidad de actores involucrados. La totalidad de las ideas fueron registradas, sistematizadas, analizadas, y canalizadas a los organismos correspondientes analizando su viabilidad.","description_en":"Uruguay developed the 4th National Open Government Action Plan through a participatory process that involved continuous dialogue and the active participation of representatives from Public Institutions, organized Civil Society, Academia, and the Private Sector. The process was designed and led by the Open Government Working Group.\n\nFor its development, spaces and platforms for dialogue and co-creation were established, carried out through dialogue tables, working groups, and specific workshops to discuss and exchange ideas and proposals for the commitments of the plan. The goal was to ensure that as many involved actors as possible were represented from the very conception of the plan. All ideas were recorded, systematized, analyzed, and channeled to the corresponding bodies for feasibility assessment.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://miradordegobiernoabierto.agesic.gub.uy/SigesVisualizador/gu/o/GA","pga/pga_mechanism_text_es":"Informes semestrales de seguimiento","pga/pga_mechanism_url":"https://visualizador.gobiernoabierto.gub.uy/visualizador/api/repos/:public:datosAbiertos:da_avance_comp.wcdf/generatedContent","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9eda50a4-eb21-47b5-8b3b-eb973a75124e","meta/deprecatedID":"uuid:2c19a34e-0da5-439f-aec7-cd502269bedc","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9eda50a4-eb21-47b5-8b3b-eb973a75124e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9eda50a4-eb21-47b5-8b3b-eb973a75124e"},{"_id":46534,"start":"2025-11-07T14:26:33.346-04:00","end":"2026-04-08T09:10:32.010-04:00","id_drupal":"696","country":"blz","theme":"urban_development","original_language":"en","name_es":"Manual de orientación para la planificación del desarrollo municipal en Belice","name_en":"Guidance Manual for Municipal Development Planning in Belize","responsible_institution":[{"responsible_institution/institution":"Instututo para el Desarrollo Internacional Urbano","responsible_institution/id_institution":"45435","responsible_institution/name_institution":"Instututo para el Desarrollo Internacional Urbano"}],"link":"ac4f5b3e-62be-462d-b3b9-d67331f8763b","primary_link":"http://library.i2ud.org/library/docs_p/2012/2012_10_003/Belize_Municipal_Development_Plan_Guidance_Manual_Final_Report_June_2014.pdf","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Ciudades y pueblos","type_territorial_unit_en":"Cities and towns","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Los planes municipales detallan visiones, estrategias y escenarios de desarrollo. Presentan propuestas de uso del suelo, necesidades de planificación e inversión en infraestructura, así como estrategias de implementación. Los planes municipales se formulan como un instrumento de largo plazo para asistir al consejo municipal correspondiente en el cumplimiento de sus responsabilidades de administración territorial, responder al crecimiento poblacional y a los cambios económicos, gestionar la infraestructura existente, manejar la expansión urbana y proveer los servicios necesarios para garantizar la cohesión social, económica, funcional y ambiental, así como una buena calidad de vida para los habitantes de la comunidad.\n\nMás específicamente, los planes municipales contienen: (1) un diagnóstico; (2) una propuesta de visión, estrategia y escenarios de desarrollo; (3) propuestas de uso del suelo; (4) planificación de infraestructura e inversiones; (5) estrategias de implementación. Los planes municipales se rigen de acuerdo con los lineamientos del “Manual de Operaciones del Plan de Desarrollo Municipal de Belice”.","description_en":"The municipal plans detail visions, strategies and development scenarios. They detail land use proposals, detail planning needs and investment in infrastructure, and implementation strategies. The municipal plans are formulated as a long-term instrument, to assist the corresponding city council, to carry out the responsibilities of territorial administration, respond to population growth and economic changes, manage existing infrastructure, manage urban expansion and provide the necessary services to ensure social, economic, functional and environmental cohesion, as well as a good quality of life for the residents of the community.\n\nMore in detail, the municipal plans contain (1) a diagnosis; (2) A proposal of vision, strategy and development scenarios; (3) Proposals for land use; (4) Infrastructure and investment planning; (5) Implementation Strategies. The municipal plans are governed according to the guidelines of the \"Belize Municipal Development Plan Operations Manual\".","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:9c1ab940-2d87-4948-b9dd-d4e9c8a4b984","meta/deprecatedID":"uuid:e14e6879-61f1-40d0-ae2b-e39a315a8e0b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9c1ab940-2d87-4948-b9dd-d4e9c8a4b984","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:32","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775653857,"uid":"validation_status_on_hold","by_whom":"paulinestockins","color":"#0000ff","label":"On Hold"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9c1ab940-2d87-4948-b9dd-d4e9c8a4b984"},{"_id":46535,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:34.063","end":"2025-11-07T14:26:34.063","id_drupal":"1755","country":"col","theme":"mobility","original_language":"es","name_es":"Plan Maestro de Movilidad para el Valle de Aburrá","name_en":"Master Mobility Plan for the Aburrá Valley ","responsible_institution":[{"responsible_institution/institution":"Subdirección de Transporte del Área Metropolitana del Valle de Aburrá","responsible_institution/id_institution":"45126","responsible_institution/name_institution":"Subdirección de Transporte del Área Metropolitana del Valle de Aburrá"}],"link":"24552ea2-3ee6-4647-a057-7b154a63cae2","primary_link":"https://www.metropol.gov.co/movilidad/PlanMaestro/Plan%20Maestro%20de%20Movilidad.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Área Metropolitana del Valle de Aburrá (AMVA)","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"no","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"Se plantea renovar la flota de buses para el transporte público e incorporar el uso de buses eléctricos para disminuir las emisiones contaminantes del sector de transporte.","pmu/pmu_implementation_en":"It is proposed to renew the fleet of buses for public transport and incorporate the use of electric buses to reduce polluting emissions from the transport sector.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Se propone ampliar la cobertura del sistema del transporte público a través de la implementación de corredores de movilidad sostenibles. Mejorar la accesibilidad al SITVA dismnuyendo los transbordos y cumpliendo con estándares mundiales de infraestructura y acceso a vehículos. Reestructurar la política de integación tarifaria del SITVA con la implementación de un sistema tarifario simple que sea fácil de entender para los usuarios y que esté soportado en plataformas tecnológicas, así poder constribuir a la eficiencia de los desplazamientos. Consolidar un sistema de información que permita planificar los viajes en tiempo real. Fortalecer los convenios de colaboración empresarial. Consolidar el sistema de Gestión de Transporte Público Coelctivo. Renovar la flota de buses con vehículos eléctricos para disminuir la emisión de gases contaminantes.","pmu/pmu_prioritization_en":"It is proposed to expand the coverage of the public transport system through the implementation of sustainable mobility corridors. Improve accessibility to SITVA by reducing transshipments and complying with global standards for infrastructure and vehicle access. Restructure the SITVA fare integration policy with the implementation of a simple fare system that is easy for users to understand and that is supported by technological platforms, thus contributing to the efficiency of travel. Consolidate an information system that allows planning trips in real time. Strengthen business collaboration agreements. Consolidate the Co-Selective Public Transport Management System. Renew the fleet of buses with electric vehicles to reduce the emission of polluting gases.","pmu/pmu_gender_es":"Se busca lograr la gestión e incorporación del enfoque de género en todos los temas entorno a la movilidad en el Valle de Aburrá entendiendo la diferencia que hay entre los patrones de viajes entre hombres y mujeres","pmu/pmu_gender_en":"It seeks to achieve the management and incorporation of the gender approach in all issues around mobility in the Aburrá Valley, understanding the difference between travel patterns between men and women","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:96a20642-b149-42fb-a6eb-cf6653ef5a57","meta/deprecatedID":"uuid:6545cb55-7591-4a2b-8fa0-c88a54219232","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"96a20642-b149-42fb-a6eb-cf6653ef5a57","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:33","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:96a20642-b149-42fb-a6eb-cf6653ef5a57"},{"_id":46536,"start":"2025-11-07T14:26:34.787-03:00","end":"2026-03-07T12:42:49.868-03:00","id_drupal":"390","country":"arg","theme":"development_planning","original_language":"es","name_es":"Objetivos de Gobierno de la Argentina (2015-2019)","name_en":"Government Objectives of Argentina (2015-2019)","responsible_institution":[{"responsible_institution/institution":"Presidencia de la Nación","responsible_institution/id_institution":"45298","responsible_institution/name_institution":"Presidencia de la Nación"}],"link":"963bc40f-3d59-4cf2-82ce-dc74d251c09f","primary_link":"https://www.casarosada.gob.ar/objetivosdegobierno/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"En diciembre de 2015, el Presidente Mauricio Macri decidió establecer 8 objetivos nacionales y 100 prioridades en el marco de la modificación de la Administración Nacional Pública, para comenzar la vinculación de los mismos con la Agenda 2030 de Naciones Unidas.\n\nLos *8 objetivos de los que se desprenden las 100 prioridades* son:\n1. Estabilidad macroeconómica\n2. Acuerdo productivo nacional\n3. Desarrollo de infraestructura\n4. Desarrollo humano sustentable\n5. Combate al narcotráfico y mejora de la seguridad\n6. Fortalecimiento institucional\n7. Modernización del Estado\n8. Inserción inteligente al mundo\n\nLos objetivos de gobierno 2015-2019 no cuentan con un sistema definido de seguimiento y monitoreo o con un sistema de evaluación. Sin embargo, Argentina cuenta con un sistema de gestión por resultados (Sistema Integral de Seguimiento y Evaluación de la Gestión – SISEG), que es un herramienta de monitoreo de planes, programas y proyectos sustantivos de los organismos de la administración pública.","description_en":"In December 2015, President Mauricio Macri decided to establish eight national objectives and one hundred priorities within the framework of the reform of the National Public Administration, in order to begin aligning them with the United Nations 2030 Agenda.\n\nThe *eight objectives from which the one hundred priorities* are derived are:\n1. Macroeconomic stability\n2. National productive agreement\n3. Infrastructure development\n4. Sustainable human development\n5. Combating drug trafficking and improving security\n6. Institutional strengthening\n7. Modernization of the State\n8. Smart integration into the world\n\nThe 2015–2019 government objectives did not have a defined monitoring and evaluation system. However, Argentina has a results-based management system (Integrated System for Monitoring and Evaluation of Management – SISEG), which serves as a tool for monitoring substantive plans, programs, and projects of public administration bodies.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_8 sdg_9 sdg_10 sdg_11 sdg_12 sdg_13 sdg_14 sdg_15 sdg_16 sdg_17","ipd/ipd_type":"government","ipd/ipd_action_plan":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:69198638-6ce6-402a-a83d-6b59bac9ee66","meta/deprecatedID":"uuid:77e22deb-13bf-4b52-a4cd-122f4ad83ffe","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"69198638-6ce6-402a-a83d-6b59bac9ee66","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:33","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:69198638-6ce6-402a-a83d-6b59bac9ee66"},{"_id":46537,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:35.526","end":"2025-11-07T14:26:35.526","id_drupal":"380","country":"atg","theme":"development_planning","original_language":"en","name_es":"Plan Estratégico de Desarrollo a Mediano Plazo de Antigua y Barbuda (2016-2020)","name_en":"Medium Term Strategic Development Plan of Antigua y Barbuda (2016-2020)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Finanzas, Gobernanza Corporativa y Asociaciones Público-Privadas de Antigua y Barbuda","responsible_institution/id_institution":"45140","responsible_institution/name_institution":"Ministerio de Finanzas, Gobernanza Corporativa y Asociaciones Público-Privadas de Antigua y Barbuda"}],"link":"cc39acdd-02f2-4a29-8cfc-18039c2b8119","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Estratégico de Desarrollo a Mediano Plazo destaca las prioridades estratégicas de desarrollo del país para el período 2016-2020.\n\nEl plan establece Cuatro Dimensiones de Desarrollo Sostenible:\n1. Generación Óptima de Riqueza Nacional\n2. Mayor Cohesión Social\n3. Mejora de la Salud del Medio Ambiente Natural y Conservación de los Recursos Históricos y Culturales\n4. Mayor Seguridad Ciudadana\n\nSiete Prioridades Emblemáticas:\n1. Infraestructura adecuada\n2. Industria turística fuerte como eje económico\n3. Transformar Barbuda en un destino turístico verde, de baja densidad y alto nivel\n4. Mejor aprovechamiento de nuestro espacio marino\n5. Exportación de servicios distintos al turismo\n6. Reducción del costo de la energía y mejora de la seguridad energética\n7. Mejor acceso a vivienda adecuada\n\nEstas dimensiones y prioridades guían el resto de los objetivos y acciones contenidas en el Plan. Dentro de cada dimensión existen ciertas Condiciones Necesarias (NC) que deben cumplirse para alcanzar los objetivos finales.\n\nEl plan también establece un sistema de Monitoreo y Evaluación que se detalla en el Capítulo VII.","description_en":"The Medium Term Strategic Development Plan highlights the strategic development priorities for the country for the period 2016-2020.\n\nThe plan establishes Four Sustainable Development Dimensions:\n1. Optimal Generation of National Wealth\n2. Enhanced Social Cohesion\n3. Improved Health of the Natural Environment and Sustained Historical and Cultural Assets\n4. Enhanced Citizen Security\n\nSeven Flagship Priorities:\n1. Adequate Infrastructure\n2. Strong Tourism Industry as an Economic Anchor\n3. Transform Barbuda into a Green, Low Density, High-End Tourism Destination\n4. Better Utilization of our Marine Space\n5. Export of Non-Tourism Services\n6 .Reducing the Cost of Energy and Improving Energy Security\n7. Better Access to Adequate Housing\nThese dimensions and priorities guide the rest of goals and actions contained in the Plan. Within each dimension there are certain Necessary Conditions (NC) that must be fulfilled to achieve the ultimate goals. \n\nThe plan also establishes a Monitoring and Evaluation system that is detailed in Chapter VII.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Una Antigua y Barbuda armoniosa, próspera y moderna, fundada en los principios de sostenibilidad y crecimiento inclusivo; donde prevalezcan la igualdad de oportunidades, la paz y la justicia para todos los ciudadanos y residentes.\"","ipd/ipd_vision_en":"\"A harmonious, prosperous and modern Antigua and Barbuda founded on the principles of sustainability and inclusive growth; where equality of opportunity, peace, and justice prevail for all citizens and residents\"","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ae01c3dd-9104-4774-856f-60b3ae59adfa","meta/deprecatedID":"uuid:6a85bcc4-9037-44c7-8952-e8a5779feaf0","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ae01c3dd-9104-4774-856f-60b3ae59adfa","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ae01c3dd-9104-4774-856f-60b3ae59adfa"},{"_id":46538,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:36.250","end":"2025-11-07T14:26:36.250","id_drupal":"344","country":"bhs","theme":"development_planning","original_language":"en","name_es":"Visión 2040, Plan Nacional de Desarrollo de las Bahamas","name_en":"Vision 2040, National Development Plan of the Bahamas","responsible_institution":[{"responsible_institution/institution":"Secretaría del Plan Nacional de Desarrollo de las Bahamas","responsible_institution/id_institution":"45402","responsible_institution/name_institution":"Secretaría del Plan Nacional de Desarrollo de las Bahamas"}],"link":"3d2bbca9-0920-4499-924d-6f377c38c355","primary_link":"https://www.vision2040bahamas.org/media/uploads/2nd_Working_Draft_of_the_NDP_website_30.11.17c.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo: Visión 2040 proporciona una hoja de ruta para el desarrollo futuro de Las Bahamas. El Plan incluye un marco de políticas integral que guía la toma de decisiones gubernamentales y la inversión durante las próximas décadas.\n\nVisión 2040 es una iniciativa del Gobierno de Las Bahamas, desarrollada por la Unidad de Desarrollo Económico y Planificación (EDPU) en colaboración con el Banco Interamericano de Desarrollo y en estrecha cooperación con la Universidad de Las Bahamas y la Cámara de Comercio y Confederación de Empleadores de Las Bahamas. El Plan se ha elaborado con base en una amplia investigación, análisis y consulta pública generalizada, con el objetivo de abordar cuatro pilares principales de política: Economía, Gobernanza, Política Social y Medio Ambiente (natural y construido).\n\nActualmente, el Plan Nacional se encuentra en su segundo borrador y aún no ha sido aprobado por el Parlamento. Sin embargo, los ministerios están utilizando esta herramienta para orientar su trabajo y ajustándola a sus responsabilidades. Al mismo tiempo, el Plan se ha articulado con los ODS mediante la metodología RIA del PNUD, mostrando un 88 % de compatibilidad.\n\nEl proceso de monitoreo y evaluación del Plan Nacional de Desarrollo es llevado a cabo por la EDPU, con asistencia del Instituto de Gobierno y Políticas Públicas de la Universidad de Las Bahamas.\n\nAunque el Plan Nacional de Desarrollo: Visión 2040 aún se encuentra en su segundo borrador y no ha sido aprobado por el Parlamento, los ministerios ya están utilizando esta herramienta para guiar su trabajo y ajustándola a sus responsabilidades.","description_en":"The National Development Plan: Vision 2040, provides a roadmap for the future development of The Bahamas. The Plan includes a comprehensive policy framework that guides government decision making and investment over the next decades.\n\nVision 2040 is an initiative of the Government of The Bahamas, developed by the Economic Development and Planning Unit (EDPU) in partnership with the Inter-American Development Bank and in close cooperation with the University of The Bahamas and The Bahamas Chamber of Commerce and Employers Confederation. The Plan has been guided by extensive research, analysis and widespread public consultation aimed at addressing four main policy pillars: The Economy, Governance, Social Policy and Environment (Natural and Built). \n\nThe National Plan is currently in its second draft and not approved yet by Parliament. However, ministries are currently using this tool to guide their work and adjusting it to their responsibilities. At the same time, this Plan has been articulated with the SDGs through the RIA methodology of UNDP, and it shows an 88% of compatibility.\n\nThe monitoring and evaluation process of the National Development Plan is carried out then by EDPU, with assistance in the monitoring and evaluation process of the Government and Public Policy Institute of the University of Bahamas.\n\n* Even though the National Development Plan: Vision 2040 is currently in its second draft and not approved yet by Parliament, ministries are currently using this tool to guide their work and adjusting it to their responsibilities. ","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:27cb6b49-df04-4c97-8c37-0bc918d545a3","meta/deprecatedID":"uuid:cefdf096-f701-4220-8569-6a598a20aab8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"27cb6b49-df04-4c97-8c37-0bc918d545a3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:35","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:27cb6b49-df04-4c97-8c37-0bc918d545a3"},{"_id":46539,"start":"2025-11-07T14:26:37.397-03:00","end":"2026-01-13T16:34:57.116-03:00","id_drupal":"343","country":"bra","theme":"development_planning","original_language":"pt","name_es":"Plan Plurianual de Brasil (2016-2019)","name_en":"Multi-Year Plan of Brazil (2016-2019)","responsible_institution":[{"responsible_institution/institution":"Secretaria Nacional de Planificación(SEPLAN)","responsible_institution/id_institution":"45460","responsible_institution/name_institution":"Secretaria Nacional de Planificación(SEPLAN)"}],"link":"39ac14b2-df51-4f56-a912-43bd511a7049","primary_link":"https://www.gov.br/economia/pt-br/arquivos/planejamento/arquivos-e-imagens/secretarias/arquivo/spi-1/ppa-2016-2019/ppa-2016-2019-ascom-3-1.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Plurianual (PPA) es un instrumento previsto en el artículo 165 de la Constitución Federal, destinado a organizar y viabilizar la acción pública, con el objetivo de cumplir con los fundamentos y objetivos de la República. A través del PPA, se declaran las políticas públicas del gobierno para un período de cuatro años, así como los caminos para alcanzar las metas planificadas. Además, cuenta con la herramienta “PPA Ciudadano”, que forma parte del esfuerzo del Gobierno Federal por ofrecer mayor transparencia en torno a la acción pública, permitiendo a cualquier ciudadano consultar los detalles del PPA.\n\nEl PPA cuenta también con un sistema de monitoreo y evaluación, especificado en la Guía de Monitoreo y Evaluación, que se realiza anualmente. Esto se lleva a cabo utilizando una base de datos vinculada a la implementación de cada uno de los programas. El Secretario de Planificación y Asuntos Económicos, junto con la entidad encargada de coordinar este sistema, supervisa su ejecución. Su respaldo legal se encuentra en el Decreto 8.759.","description_en":"The Pluriannual Plan (PPA) is an instrument provided for in Article 165 of the Federal Constitution, intended to organize and enable public action with a view to fulfilling the foundations and objectives of the Republic. Through the PPA, the government’s public policies are declared for a four-year period, along with the pathways to achieve the planned targets. In addition, it includes the “Citizen PPA” tool, part of the Federal Government’s effort to provide greater transparency regarding public action, allowing any citizen to consult the details of the PPA.\n\nThe PPA also has a monitoring and evaluation system, specified in the Monitoring and Evaluation Guide, which is carried out annually. This is done using a database based on the implementation of each program. The Secretary of Planning and Economic Affairs, together with the entity responsible for coordinating this system, oversees its execution. Its legal backing is provided by Decree 8,759.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_10 sdg_11 sdg_16 sdg_17","ipd/ipd_vision_es":"“Una sociedad inclusiva, democrática y más igualitaria, con educación de calidad, respeto y valoración de la diversidad, que haya superado la extrema pobreza; una economía sólida, dinámica y sostenible, capaz de expandir y renovar competitivamente su estructura productiva, generando empleos de calidad y respetando el medio ambiente”.","ipd/ipd_vision_en":"“An inclusive, democratic, and more equitable society, with quality education, respect for and appreciation of diversity, and having overcome extreme poverty; a solid, dynamic, and sustainable economy capable of competitively expanding and renewing its productive structure, generating quality employment and respecting the environment.”","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:2a24e4ea-40e1-4205-a540-9ed78120f44f","meta/deprecatedID":"uuid:d495cb17-a86e-4bad-8dd2-9a60068331b5","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2a24e4ea-40e1-4205-a540-9ed78120f44f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:36","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2a24e4ea-40e1-4205-a540-9ed78120f44f"},{"_id":46540,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:38.119","end":"2025-11-07T14:26:38.119","id_drupal":"426","country":"blz","theme":"development_planning","original_language":"en","name_es":"Estrategia de Crecimiento y Desarrollo Sostenible de Belice (2016-2019)","name_en":"Growth and Sustainable Development Strategy of Belize (2016-2019)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Económico (MED) de Belice","responsible_institution/id_institution":"45403","responsible_institution/name_institution":"Ministerio de Desarrollo Económico (MED) de Belice"}],"link":"11916378-b4de-4bc9-a955-73e085194920","primary_link":"https://www.dgft.gov.bz/wp-content/uploads/2017/07/Belize-Growth-Sustainable-Development-Strategy.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"La Estrategia de Crecimiento y Desarrollo Sostenible (GSDS, por sus siglas en inglés), 2016-2019, se basa en documentos previos, incluyendo especialmente Horizon 2030: Marco Nacional de Desarrollo para Belice 2010-2030. Esta GSDS es el principal documento de planificación del país, proporcionando orientación detallada sobre prioridades y acciones específicas a llevar a cabo durante el período de planificación, incluyendo acciones que contribuyen a objetivos de desarrollo a más largo plazo más allá de 2019.\n\nPor lo tanto, la GSDS busca integrar de manera sinérgica las políticas económicas, sociales y ambientales, de modo que trabajen conjuntamente para producir resultados óptimos. Apoya al país en la gestión de limitaciones de recursos y ayuda a incrementar su resiliencia frente a una economía global volátil y a un clima global cambiante. La estrategia establece cuatro factores críticos de éxito, que son metas subsidiarias que también proporcionan un marco organizativo para los objetivos y acciones subyacentes.\n\nTanto la GSDS como Horizon 2030 cuentan con sistemas de monitoreo y evaluación a cargo del Ministerio de Finanzas y Desarrollo Económico, en conjunto con el Instituto Estadístico de Belice. La GSDS elaborará de manera continua un plan de indicadores para todos los niveles de objetivos presentes en el plan, mientras que Horizon 2030 utilizará un sistema de gestión por resultados.","description_en":"The Growth and Sustainable Development Strategy (GSDS), 2016-2019 builds on previous documents including especially Horizon 2030: National Development Framework for Belize 2010-2030. This GSDS is the nation’s primary planning document, providing detailed guidance on priorities and on specific actions to be taken during the planning period, including actions that contribute to longer term development objectives beyond 2019.\n\nThe GSDS therefore strives to bring economic, social, and environmental policies into synergistic balance, so that policies work well together to produce optimal outcomes. It supports the country in coping with resource constraints, and helps to increase its resilience in the face of a volatile global economy and a changing global climate. It outlines four critical success factors, subsidiary goals that also provide an organizing framework for the underlying objectives and actions.\n\nBoth the GSDS and the Horizon 2030 have monitoring and evaluation systems in charge of the Ministry of Finance and Economic Development in conjunction with the Statistical Institute of Belize. The GSDS will continually prepare a plan of indicators for all levels of objectives present in the plan. The Horizon 2030 will use a results management system.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Un país de paz y tranquilidad, donde los ciudadanos viven en armonía con el entorno natural y disfrutan de una alta calidad de vida\".","ipd/ipd_vision_en":"\"A country of peace and tranquillity, where citizens live in harmony with the natural environment and enjoy a high quality of life”","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f806b332-19b5-417f-9a91-e2e27a138cb5","meta/deprecatedID":"uuid:eace7374-2495-4c53-afa4-617be6fd819e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f806b332-19b5-417f-9a91-e2e27a138cb5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:37","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f806b332-19b5-417f-9a91-e2e27a138cb5"},{"_id":46541,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:38.845","end":"2025-11-07T14:26:38.845","id_drupal":"694","country":"blz","theme":"development_planning","original_language":"en","name_es":"Horizonte 2030 - Marco Nacional de Desarrollo de Belice","name_en":"Horizon 2030 - National Development Framework of Belize","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Económico (MED) de Belice","responsible_institution/id_institution":"45403","responsible_institution/name_institution":"Ministerio de Desarrollo Económico (MED) de Belice"}],"link":"e67c1c17-feb1-4595-b2ff-245e0f9ecfa0","primary_link":"https://med.gov.bz/wp-content/uploads/2020/09/Horizon2030PreparationandImplementationProcess.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2010-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"Horizon 2030 encarna los valores fundamentales que deben guiar el comportamiento de los ciudadanos e informar las estrategias para alcanzar la visión común del futuro. Representa las opiniones consolidadas de numerosos actores: jóvenes y adultos, hombres y mujeres, estudiantes y maestros, políticos y votantes, empleadores y empleados, sectores público y privado, agricultores, operadores turísticos y artistas.\n\nDurante el proceso de formulación, el equipo de Horizon 2030 se reunió con actores de todos los distritos de Belice. Se observó una gran similitud de opiniones entre estos grupos tan diversos, no solo sobre los problemas críticos que enfrenta Belice, sino también sobre los objetivos deseados para el futuro y las estrategias para alcanzarlos.","description_en":"Horizon 2030 embodies the core values that are to guide citizen behaviour and inform the strategies to achieve the common vision for the future. It represents the consolidated views of many stakeholders: young and old, men and women, students and teachers, politicians and voters, employers and employees, public and private sectors, farmers, tourism operators and artists.\n\nDuring the formulation process the Horizon 2030 Team met with stakeholders in all the districts of Belize. There was great similarity of views across these very varied groups, not only on the critical issues facing Belize, but also on the desired goals for the future and the strategies to achieve these goals.","linking_sdg_plans":"no","ipd/ipd_vision_es":"“Para el año 2030, Belice será un país de paz y tranquilidad, donde los ciudadanos vivan en armonía con el medio ambiente natural y disfruten de una alta calidad de vida. Los beliceños son un pueblo enérgico, ingenioso e independiente, que se ocupa de su propio desarrollo de manera sostenible”.","ipd/ipd_vision_en":"\"By the year 2030, Belize is a country of peace and tranquility, where citizens live in harmony with the natural environment and enjoy a high quality of life. Belizeans are an energetic, resourceful and independent people looking after their own development in a sustainable way\".","ipd/ipd_type":"vision","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b7db436d-1bca-4629-a7d8-5daf350c6cf7","meta/deprecatedID":"uuid:a275ea1c-3168-46df-a63a-f6304f67eeb5","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b7db436d-1bca-4629-a7d8-5daf350c6cf7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:37","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b7db436d-1bca-4629-a7d8-5daf350c6cf7"},{"_id":46542,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:39.562","end":"2025-11-07T14:26:39.562","id_drupal":"327","country":"bol","theme":"development_planning","original_language":"es","name_es":"Plan de Desarrollo Económico y Social en el marco del Desarrollo Integral para Vivir Bien de Bolivia (2016-2020)","name_en":"Economic and Social Development Plan within the Framework of Integral Development for Living Well of Bolivia (2016-2020) ","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación del Desarrollo (MPD) de Bolivia","responsible_institution/id_institution":"45246","responsible_institution/name_institution":"Ministerio de Planificación del Desarrollo (MPD) de Bolivia"}],"link":"98bc6632-0962-4bc3-be47-dca252217e1a","primary_link":"https://www.planificacion.gob.bo/pdes/pdes2016-2020.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de Desarrollo Económico y Social en el marco del Desarrollo Integral para Vivir Bien (PDES) 2016 - 2020 del Estado Plurinacional de Bolivia, se constituye en el marco estratégico del tercer periodo del gobierno de la Revolución Democrática Cultural. Este se elabora sobre la base de la Agenda Patriótica 2025 y el Programa de Gobierno 2015 - 2020. La formulación del PDES, a cargo del Ministerio de Planificación para el Desarrollo (MDP), se encuentra estipulado en la Ley N°777 del Sistema de Planificación Integral del Estado-SPIE que se sancionó en el año 2016.\n\nEl PDES está construido metodológicamente por metas correspondientes a cada Pilar de la Agenda Patriótica. Asimismo, en el marco de cada meta, se plantean los resultados a ser logrados al 2020, de los que se desprenden las acciones necesarias para acometer las metas y por tanto avanzar en lo establecido en los respectivos pilares. En total, el PDES plantea 68 metas y 340 resultados.\n\nEl PDES también posee un sub sistema de seguimiento y evaluación integral de planes, siendo el conjunto de lineamientos, metodologías, procedimientos e instrumentos técnicos orientados a sistematizar, analizar y evaluar el cumplimiento de las metas, resultados y acciones de los planes. El Ministerio de Planificación del Desarrollo es la entidad encargada de coordinarlo. ","description_en":"The Economic and Social Development Plan within the Framework of Comprehensive Development for Living Well (PDES) 2016–2020 of the Plurinational State of Bolivia constitutes the strategic framework for the third period of the Government of the Democratic and Cultural Revolution. It was developed based on the Patriotic Agenda 2025 and the Government Program 2015–2020. The formulation of the PDES, under the responsibility of the Ministry of Development Planning (MPD), is established by Law No. 777 of the Comprehensive State Planning System (SPIE), enacted in 2016.\n\nThe PDES is methodologically structured around goals corresponding to each pillar of the Patriotic Agenda. Within each goal, specific results to be achieved by 2020 are defined, from which the necessary actions are derived to attain those goals and make progress within each pillar. In total, the PDES sets out 68 goals and 340 results.\n\nThe PDES also includes a subsystem for the comprehensive monitoring and evaluation of plans, which consists of a set of guidelines, methodologies, procedures, and technical instruments designed to systematize, analyze, and assess the achievement of the goals, results, and actions of the plans. The Ministry of Development Planning is the entity responsible for coordinating this process.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"El Vivir Bien como nuestro horizonte. Vivir Bien es construir de forma activa y sin descanso una relación armónica y metabólica entre los seres humanos con la naturaleza, donde todos los seres vivos viven en equilibrio y complementariedad con la Madre Tierra, respetando los derechos de las personas, de los pueblos y de la Madre Tierra\".","ipd/ipd_vision_en":"\"Living Well as our horizon. Living Well means actively and tirelessly building a harmonious and metabolic relationship between human beings and nature, where all living beings coexist in balance and complementarity with Mother Earth, respecting the rights of individuals, peoples, and Mother Earth.\"","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_investment":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2e268def-0884-45ea-bfee-6dc05e76ddb2","meta/deprecatedID":"uuid:491956b4-2297-4a41-9cc9-12d90f4c290b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2e268def-0884-45ea-bfee-6dc05e76ddb2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:38","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2e268def-0884-45ea-bfee-6dc05e76ddb2"},{"_id":46543,"start":"2025-11-07T14:26:40.285-03:00","end":"2026-03-09T17:34:47.328-03:00","id_drupal":"427","country":"bol","theme":"development_planning","original_language":"es","name_es":"Agenda Patriótica 2025- Plan de Desarrollo General Económico y Social para el Vivir Bien (PDGES) de Bolivia","name_en":"Patriotic Agenda 2025 - General Economic and Social Development Plan for Living Well (PDGES) of Bolivia","responsible_institution":[{"responsible_institution/institution":"Ministerio de Autonomías (Actual Viceministerio de Autonomías)","responsible_institution/id_institution":"45059","responsible_institution/name_institution":"Ministerio de Autonomías (Actual Viceministerio de Autonomías)"}],"link":"cc852e4b-9aaf-4846-950d-c767b877596a","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"El Año 2025 Bolivia cumplirá 200 años desde su fundación y como conmemoración a este futuro hito histórico, el Presidente del Estado Plurinacional, Evo Morales Ayma, ha planteado 13 pilares para constituir la Bolivia Digna y Soberana, con el objetivo de levantar una sociedad y un Estado más incluyente, participativo, democrático, sin discriminación, racismo, odio, ni división. Cada uno de estos pilares tiene una serie de dimensiones que suman un total de 68 dimensiones que habrá que cumplir para alcanzar los objetivos planteados. \n\nLa Agenda Patriótica constituye así el Plan de Desarrollo General Económico y Social (PDGES), a partir del cual se articulan los demás planes de mediano plazo que colaboran con la consecución de los pilares del PDGES.","description_en":"In 2025, Bolivia will celebrate 200 years since its founding, and in commemoration of this historic milestone, the President of the Plurinational State, Evo Morales Ayma, proposed 13 pillars to build a Dignified and Sovereign Bolivia, with the goal of creating a more inclusive, participatory, and democratic society and State — free from discrimination, racism, hatred, and division. Each of these pillars encompasses several dimensions, totaling 68 dimensions that must be fulfilled to achieve the stated objectives.\n\nThe Patriotic Agenda thus constitutes the General Economic and Social Development Plan (PDGES), from which other medium-term plans are articulated to contribute to the achievement of the pillars established in the PDGES.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_participation":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:f6864894-1e53-4ff5-aa04-42eef660c4f4","meta/deprecatedID":"uuid:2f79c367-5ee4-480d-9d8a-552d2bf25b51","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f6864894-1e53-4ff5-aa04-42eef660c4f4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:39","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f6864894-1e53-4ff5-aa04-42eef660c4f4"},{"_id":46544,"start":"2025-11-07T14:26:40.996-03:00","end":"2026-01-13T16:32:24.698-03:00","id_drupal":"1182","country":"bra","theme":"development_planning","original_language":"pt","name_es":"Plan Plurianual - PPA 2020-2023 de Brasil","name_en":"Multi-Year Plan - PPA 2020-2023 of Brazil","responsible_institution":[{"responsible_institution/institution":"Secretaria Nacional de Planificación(SEPLAN)","responsible_institution/id_institution":"45460","responsible_institution/name_institution":"Secretaria Nacional de Planificación(SEPLAN)"}],"instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Plurianual (PPA) es un instrumento de planificación gubernamental elaborado por la Secretaría de Evaluación, Planificación, Energía y Lotería (Secap), que define las directrices, objetivos y metas de la administración pública federal para un horizonte de cuatro años.\n\nA partir de la Ley del 27 de diciembre de 2019, se sanciona el nuevo Plan Plurianual de la Unión. Este incluye cuatro anexos:\n• Anexo I: Programas finalistas del Plan\n• Anexo II: Programas de gestión\n• Anexo III: Inversiones plurianuales prioritarias\n• Anexo IV: Inversiones plurianuales de empresas estatales no dependientes\n\nEl análisis de vinculación con los ODS se realiza en los programas detallados en el Anexo II, guiados por las siguientes directrices:\n• Mejoramiento de la gobernanza, modernización del Estado y gestión pública federal, con eficiencia administrativa, transparencia de la acción estatal, digitalización de servicios gubernamentales y promoción de la productividad de la estructura administrativa del Estado.\n• Eficiencia de la acción del sector público, con valorización de la ciencia y la tecnología y reducción de la intervención del Estado en la economía.\n• Garantía del equilibrio de las cuentas públicas, con el objetivo de reincorporar a Brasil entre los países con grado de inversión.\n• Intensificación de la lucha contra la corrupción, la violencia y el crimen organizado.\n• Promoción y defensa de los derechos humanos, con enfoque en el apoyo a la familia.\n• Dedicación prioritaria a la calidad de la educación básica, especialmente la educación infantil, y a la preparación para el mercado laboral.\n• Ampliación de la cobertura y efectividad de la atención primaria en salud, priorizando la prevención y fortaleciendo la integración de los servicios de salud.\n• Énfasis en la generación de oportunidades y estímulos para la inserción en el mercado laboral, con especial atención al primer empleo.\n• Promoción de la mejora de la calidad ambiental, conservación y uso sostenible de los recursos naturales, considerando los costos y beneficios ambientales.\n• Ampliación de la inversión privada en infraestructura, orientada por la combinación de planificación a largo plazo y reducción de la inseguridad jurídica.\n• Desarrollo de capacidades y condiciones necesarias para promover la soberanía y los intereses nacionales, considerando defensa nacional, relaciones exteriores y seguridad institucional.\n• Simplificación y progresividad del sistema tributario, mejora del ambiente de negocios, estímulo a la competencia y mayor apertura de la economía nacional al comercio exterior, priorizando apoyo a micro y pequeñas empresas y promoviendo la protección de la industria nacional al nivel de los países más industrializados.","description_en":"The Pluriannual Plan (PPA) is a governmental planning instrument prepared by the Secretariat of Evaluation, Planning, Energy, and Lottery (Secap), which defines the guidelines, objectives, and targets of the federal public administration for a four-year horizon.\n\nFollowing the Law of December 27, 2019, the new Pluriannual Plan of the Union was enacted. It includes four annexes:\n• Annex I: Final programs of the Plan\n• Annex II: Management programs\n• Annex III: Priority multi-year investments\n• Annex IV: Multi-year investments of non-dependent state-owned companies\n\nThe linkage analysis with the SDGs is carried out in the programs detailed in Annex II, guided by the following directives:\n• Improvement of governance, modernization of the State, and federal public management, ensuring administrative efficiency, transparency of state action, digitalization of government services, and promotion of productivity in the administrative structure of the State.\n• Efficiency of public sector action, valuing science and technology and reducing State intervention in the economy.\n• Guarantee of fiscal balance, aiming to reintegrate Brazil among countries with investment-grade ratings.\n• Intensification of the fight against corruption, violence, and organized crime.\n• Promotion and protection of human rights, with a focus on family support.\n• Priority dedication to the quality of basic education, especially early childhood education, and preparation for the labor market.\n• Expansion of coverage and effectiveness of primary healthcare, prioritizing prevention and strengthening the integration of health services.\n• Emphasis on creating opportunities and incentives for labor market entry, with special attention to first-time employment.\n• Promotion of environmental quality improvement, conservation, and sustainable use of natural resources, considering environmental costs and benefits.\n• Expansion of private investment in infrastructure, guided by the combination of long-term planning and reduction of legal uncertainty.\n• Development of capacities and conditions necessary to promote sovereignty and national interests, considering national defense, foreign relations, and institutional security.\n• Simplification and progressivity of the tax system, improvement of the business environment, promotion of competition, and greater opening of the national economy to foreign trade, prioritizing support for micro and small enterprises and promoting the protection of national industry at levels comparable to the most industrialized countries.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:0e5bc080-5f44-4ebe-8847-f208e223e7bf","meta/deprecatedID":"uuid:390ed9e5-1641-4ecc-a226-c6dbd6854349","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0e5bc080-5f44-4ebe-8847-f208e223e7bf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:40","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0e5bc080-5f44-4ebe-8847-f208e223e7bf"},{"_id":46545,"start":"2025-11-07T14:26:41.720-03:00","end":"2026-04-08T14:58:32.971-04:00","id_drupal":"1724","country":"bra","theme":"development_planning","original_language":"pt","name_es":"Estrategia Federal de Desarrollo (2020 - 2031) de Brasil","name_en":"Federal Development Strategy (2020 - 2031) of Brazil","responsible_institution":[{"responsible_institution/institution":"Presidencia de la Repúbica Federativa de Brasil","responsible_institution/id_institution":"45382","responsible_institution/name_institution":"Presidencia de la Repúbica Federativa de Brasil"}],"link":"b06d900c-e2d3-4c1b-a8c8-2ab3e25c7e82","primary_link":"https://www.gov.br/gestao/pt-br/assuntos/gestao/estrategia-federal-de-desenvolvimento/arquivos/efd-2020-2031_v2.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2031-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"La Estrategia Federal de Desarrollo es considerada un instrumento que materializa una visión de largo plazo para el país. Su función es orientar el Plan Plurianual (PPA), los planes nacionales, sectoriales, regionales y los planes estratégicos de las instituciones del Estado.\n\nLa estrategia contiene posibles escenarios macroeconómicos para los próximos doce años y ejes estratégicos.\n\nPara cada eje, establece directrices, desafíos, indicadores y metas.","description_en":"The Federal Development Strategy is considered an instrument that embodies a long-term vision for the country. Its role is to guide the Pluriannual Plan (PPA), national, sectoral, and regional plans, as well as the strategic plans of State institutions.\n\nThe strategy contains potential macroeconomic scenarios for the next twelve years and strategic axes.\n\nFor each axis, it establishes guidelines, challenges, indicators, and targets.","linking_sdg_plans":"no","sdg":"sdg_1 sdg_8 sdg_13 sdg_16","ipd/ipd_vision_es":"Directriz principal:\n\"Elevar los ingresos y la calidad de vida de la población brasileña, reduciendo las desigualdades sociales y regionales\"","ipd/ipd_vision_en":"Main guideline:\n\"Increase the income and quality of life of the Brazilian population while reducing social and regional inequalities\"","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_indicators":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema de Planejamento Nacional do Brasil","link_block/snp_id":"37658","link_block/snp_name":"Sistema de Planejamento Nacional do Brasil"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plano Plurianual 2024-2027 de Brasil"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","meta/instanceID":"uuid:d86ea30f-5d3e-4a29-b2c8-2bffd8fb5815","meta/deprecatedID":"uuid:498512af-e1f5-48dc-9eb1-e3a3cd314701","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d86ea30f-5d3e-4a29-b2c8-2bffd8fb5815","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:40","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d86ea30f-5d3e-4a29-b2c8-2bffd8fb5815"},{"_id":46546,"start":"2025-11-07T14:26:42.438-03:00","end":"2026-07-23T11:04:05.668-04:00","id_drupal":"2260","country":"bra","theme":"development_planning","original_language":"pt","name_es":"Plan Plurianual de Brasil (2024-2027)","name_en":"Multi-Year Plan of Brazil (2024-2027)","responsible_institution":[{"responsible_institution/institution":"Secretaria Nacional de Planificación(SEPLAN)"}],"link":"fb3d9357-4ddc-4a24-b2a8-24609af245f8","primary_link":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/plano-plurianual/copy_of_arquivos/mensagem-presidencial-ppa-2024-2027/2_mensagem_presidencial_web-1-1.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Plurianual (PPA) 2024-2027 es el principal instrumento de planificación presupuestaria de mediano plazo del Gobierno Federal de Brasil. Define las directrices, los objetivos y las metas de la administración pública federal y orienta las decisiones gubernamentales que se traducen en programas, gastos de capital, inversiones, acciones de duración continuada y asignaciones presupuestarias para un período de cuatro años. Su vigencia comienza en el segundo año del mandato presidencial y se extiende hasta el primer año del mandato siguiente.\n\nEl PPA se encuentra establecido en la Constitución Federal de Brasil como una de las leyes presupuestarias del país. De acuerdo con este marco, debe definir las directrices, los objetivos y las metas de la administración pública federal para los gastos de capital y otros derivados de ellos, así como para los programas de duración continuada. El PPA 2024-2027 fue instituido mediante la Ley N.º 14.802, de 10 de enero de 2024, y reglamentado por el Decreto N.º 12.066, de 18 de junio de 2024. Durante su vigencia, también orienta la elaboración de la Ley de Directrices Presupuestarias (LDO) y de la Ley de Presupuesto Anual (LOA).\n\nEl ente rector del Plan es el Ministerio de Planificación y Presupuesto (MPO), a través de la Secretaría Nacional de Planificación (SEPLAN). Su propósito con relación al PPA es coordinar la planificación federal de mediano plazo, conducir metodológicamente su formulación, articular a los distintos ministerios, orientar la programación gubernamental y fortalecer la capacidad del Estado para planificar, implementar, monitorear y evaluar las políticas públicas. La recreación del MPO y de la Secretaría Nacional de Planificación es presentada en el documento como un paso fundamental para recuperar la capacidad de planificación del Estado brasileño.\n\nEl PPA 2024-2027 fue elaborado mediante un proceso participativo e interinstitucional. Su formulación incluyó la definición metodológica, el alineamiento técnico con los gestores del Gobierno Federal, la elaboración de la dimensión estratégica, la realización de talleres multidisciplinarios para la construcción de la dimensión táctica y un proceso de consulta pública. En el ámbito gubernamental, se realizaron 125 talleres de trabajo con más de 4.400 participantes. Asimismo, se desarrollaron sesiones plenarias en las 27 unidades de la Federación, con más de 34.000 participantes. La plataforma Brasil Participativo registró más de 4 millones de accesos, más de 1,4 millones de participantes y 8.254 propuestas. El Plan también fue discutido en el Foro Interconsejos, con la participación de más de 500 personas y liderazgos sociales.\n\nEl PPA 2024-2027 se estructura en una dimensión estratégica y una dimensión táctica. La dimensión estratégica articula la visión de futuro para 2027, siete valores, trece directrices, siete indicadores clave nacionales, tres ejes temáticos y 35 objetivos estratégicos.\n\nLos tres ejes temáticos son:\n\n1. *Desarrollo social y garantía de derechos*, compuesto por 13 objetivos estratégicos.\n2. *Desarrollo económico y sostenibilidad socioambiental y climática*, compuesto por 15 objetivos estratégicos.\n3. *Defensa de la democracia y reconstrucción del Estado y de la soberanía*, compuesto por 7 objetivos estratégicos.\n\nLa dimensión táctica operacionaliza esta estructura mediante 88 programas organizados por ejes y 464 objetivos específicos, acompañados de indicadores, metas, entregas, inversiones plurianuales y medidas institucionales y normativas.","description_en":"The Multi-Year Plan (PPA) 2024–2027 is the main medium-term budget planning instrument of Brazil’s Federal Government. It defines the guidelines, objectives, and targets of the federal public administration and guides government decisions that translate into programs, capital expenditures, investments, ongoing initiatives, and budget allocations over a four-year period. Its term begins in the second year of a presidential administration and extends through the first year of the following administration.\n\nThe PPA is established in the Federal Constitution of Brazil as one of the country’s budget laws. Under this framework, it must define the guidelines, objectives, and targets of the federal public administration for capital expenditures and related expenses, as well as for ongoing programs. The PPA 2024–2027 was established by Law No. 14,802 of January 10, 2024, and regulated by Decree No. 12,066 of June 18, 2024. Throughout its term, it also guides the preparation of the Budget Guidelines Law (LDO) and the Annual Budget Law (LOA).\n\nThe entity responsible for overseeing the Plan is the Ministry of Planning and Budget (MPO), through the National Secretariat for Planning (SEPLAN). Its role in relation to the PPA is to coordinate medium-term federal planning, provide methodological guidance for its formulation, coordinate the work of the ministries, guide government programming, and strengthen the State’s capacity to plan, implement, monitor, and evaluate public policies. The re-establishment of the MPO and the National Secretariat for Planning is presented in the document as a fundamental step toward restoring the planning capacity of the Brazilian State.\n\nThe PPA 2024–2027 was prepared through a participatory and interinstitutional process. Its formulation included the definition of the methodology, technical coordination with Federal Government officials, the preparation of the strategic dimension, multidisciplinary workshops for the development of the tactical dimension, and a public consultation process. Within the government, 125 working sessions were held, involving more than 4,400 participants. Plenary sessions were also conducted in all 27 federative units, with more than 34,000 participants. The Brasil Participativo platform recorded more than 4 million visits, over 1.4 million participants, and 8,254 proposals. The Plan was also discussed at the Inter-Council Forum, with the participation of more than 500 people and social leaders.\n\nThe PPA 2024–2027 is structured around a strategic dimension and a tactical dimension. The strategic dimension brings together the 2027 vision for the future, seven values, thirteen guidelines, seven key national indicators, three thematic axes, and 35 strategic objectives.\n\nThe three thematic axes are:\n\n1. *Social development and the guarantee of rights*, comprising 13 strategic objectives.\n2. *Economic development and socio-environmental and climate sustainability*, comprising 15 strategic objectives.\n3. *Defense of democracy and the rebuilding of the State and national sovereignty*, comprising 7 strategic objectives.\n\nThe tactical dimension operationalizes this structure through 88 programs organized by thematic axis and 464 specific objectives, accompanied by indicators, targets, deliverables, multi-year investments, and institutional and regulatory measures.","linking_sdg_plans":"no","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_8 sdg_9 sdg_10 sdg_11 sdg_12 sdg_13 sdg_14 sdg_15 sdg_16 sdg_17","ipd/ipd_vision_es":"\"Um país democrático, justo, desenvolvido e ambientalmente sustentável, onde todas as pessoas vivam com qualidade, dignidade e respeito às diversidades.\"","ipd/ipd_vision_en":"“A democratic, just, developed, and environmentally sustainable country, where everyone lives with quality of life, dignity, and respect for diversity.”","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema de Planejamento Nacional do Brasil","link_block/snp_id":"37658","link_block/snp_name":"Sistema de Planejamento Nacional do Brasil"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Estratégia Federal de Desenvolvimento (2020 - 2031) do Brasil"},{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Ley (14.802/2024)","link_block/external_link_text_en":"Law (14.802/2024)","link_block/external_link_text_url":"https://www2.camara.leg.br/legin/fed/lei/2024/lei-14802-10-janeiro-2024-795232-publicacaooriginal-170806-pl.html"},{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Decreto 12.066/2024","link_block/external_link_text_en":"Decree 12.066/2024","link_block/external_link_text_url":"https://www2.camara.leg.br/legin/fed/decret/2024/decreto-12066-18-junho-2024-795800-publicacaooriginal-172130-pe.html"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:eee32ed5-27bc-46d5-80f5-a4f79f065ac8","meta/deprecatedID":"uuid:38de8aa1-2be7-46df-9369-8a857adf6816","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"eee32ed5-27bc-46d5-80f5-a4f79f065ac8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:41","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:eee32ed5-27bc-46d5-80f5-a4f79f065ac8"},{"_id":46547,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:43.158","end":"2025-11-07T14:26:43.158","id_drupal":"378","country":"brb","theme":"development_planning","original_language":"en","name_es":"Estrategia de Crecimiento y Desarrollo de Barbados (2013-2020)","name_en":"Barbados Growth and Development Strategy (2013-2020)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Finanzas, Asuntos Económicos e Inversión de Barbados","responsible_institution/id_institution":"44987","responsible_institution/name_institution":"Ministerio de Finanzas, Asuntos Económicos e Inversión de Barbados"}],"link":"9fd8493b-977c-4bfc-94a5-2f7b03643a87","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"La Estrategia de Crecimiento y Desarrollo (MGDS) 2013-2020 se creó por la necesidad de reactivar la productividad. La estrategia reformuló la economía de Barbados para lograr un alto crecimiento que debe ser “gestionado de manera ambiental y fiscalmente sostenible, generar oportunidades de empleo y asegurar que los frutos del crecimiento económico contribuyan a la reducción de la pobreza de manera equitativa”.\n\nEsta estrategia se basa en cuatro lineamientos:\n1. Ajuste: se requiere un ajuste inmediato para reducir el déficit fiscal y la relación deuda/PIB a niveles más sostenibles, al mismo tiempo que se incrementan las reservas internacionales.\n2. Reforma: establece las políticas y programas necesarios que deben implementarse a corto y mediano plazo para fortalecer los fundamentos económicos y sociales de Barbados.\n3. Recuperación: los impactos económicos positivos de las actividades de ajuste y reforma facilitarán la recuperación y el retorno a una trayectoria de crecimiento económico. La estrategia propone que el crecimiento se gestione sobre la base de metas anuales establecidas por la asociación social, con un seguimiento y control cercano del progreso y cumplimiento de dichas metas.\n4. Sostenibilidad: la sostenibilidad del crecimiento y desarrollo económico durante el periodo 2013-2020 se garantizará mediante el compromiso de la nación con la productividad, eficiencia, competitividad y excelencia en el servicio.\n\nPara articular una Estrategia de Crecimiento y Desarrollo integral para Barbados, se establece una visión nacional amplia, cuatro metas y veinte objetivos.","description_en":"The Growth and Development Strategy (MGDS) 2013-2020 was created by necessity to jumpstart the productivity. The strategy reformulated the barbadian economy, for achieving high growth that must be “managed in a way that is environmentally and fiscally sustainable, generates employment opportunities and ensures that the fruits of economic growth contribute to poverty alleviation in an equitable manner”.\n\nThis strategy has four guidelines:\n1. Adjustment: immediate adjustment is needed to reduce the fiscal deficit and the debt-to-GDP ratio to more sustainable levels, while growing the foreign reserves.\n2. Reform: it speaks to the necessary policies and programmes which must be implemented in the short to medium-term to strengthen Barbados’ economic and social fundamentals.\n3. Recovery: the positive economic impacts of the adjustment and reform activities will facilitate our recovery and return to a trajectory of economic growth. The strategy proposes that growth should be managed on the basis of annual targets set by the social partnership, with the progress and achievement of the targets being closely monitored and controlled. \n4. Sustainability:  sustainability of our economic growth and development over the 2013-2020 period will be assured through this nation’s commitment to productivity, efficiency, competitiveness and service excellence.\n\nIn an effort to articulate a comprehensive Growth and Development Strategy for Barbados, a broad national vision, four goals and twenty objectives are stated.","linking_sdg_plans":"no","ipd/ipd_vision_es":"“Una sociedad plenamente desarrollada y centrada en las personas, a través de nuevas vías de desarrollo”.","ipd/ipd_vision_en":"“A fully developed and people-centred society, through new development pathways”.","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:3dffb188-1488-4105-bc00-390c5a8d82e8","meta/deprecatedID":"uuid:abe06908-a8ea-421f-96c3-aeaa76fc16cb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3dffb188-1488-4105-bc00-390c5a8d82e8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3dffb188-1488-4105-bc00-390c5a8d82e8"},{"_id":46548,"start":"2025-11-07T14:26:43.878-03:00","end":"2026-01-29T10:53:27.902-03:00","id_drupal":"2374","country":"brb","theme":"development_planning","original_language":"en","name_es":"Plan Estratégico Nacional de Barbados 2006–2025","name_en":"National Strategic Plan of Barbados 2006–2025","responsible_institution":[{"responsible_institution/institution":"División de Asuntos Económicos","responsible_institution/id_institution":"44953","responsible_institution/name_institution":"División de Asuntos Económicos"}],"link":"07a16506-2804-4e89-a55c-63ac7c1022cd","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2006-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"El Plan Estratégico Nacional de Barbados 2006–2025 es el marco de desarrollo de largo plazo del país, diseñado para guiar la transformación nacional durante un horizonte de veinte años.\n\nDesarrollado por el Ministerio de Asuntos Económicos y Desarrollo, el plan establece seis objetivos estratégicos destinados a fomentar una sociedad próspera, socialmente justa y competitiva a nivel global:\n• “Inspirados, exultantes, libres” – Fortalecer la identidad espiritual y cultural de la nación.\n• “Firmes artesanos de nuestro destino” – Establecer una nueva gobernanza para nuevos tiempos.\n• “Fuerza y unidad” – Construir capital social.\n• “Estos campos y colinas” – Desarrollar una economía verde para el desarrollo sostenible.\n• “Hacia arriba y adelante” – Mejorar la prosperidad nacional y la competitividad global.\n• “Guardianes estrictos de nuestro patrimonio” – Posicionar a Barbados en el escenario global.\n\nCada objetivo estratégico cuenta con objetivos nacionales, estrategias y metas indicativas. El plan también propone el desarrollo de planes sectoriales quinquenales para apoyar la implementación y permitir revisiones periódicas.","description_en":"The National Strategic Plan of Barbados 2006–2025 is the country’s long-term development framework, designed to guide national transformation over a twenty-year horizon.\n\nDeveloped by the Ministry of Economic Affairs and Development, the plan outlines six strategic goals aimed at fostering a prosperous, socially just, and globally competitive society:\n• “Inspired, exulting, free” – Strengthening the spiritual and cultural identity of the nation.\n• “Firm craftsmen of our fate” – Establishing new governance for new times.\n• “Strength and unity” – Building social capital.\n• “These fields and hills” – Developing a green economy for sustainable development.\n• “Upward and onward” – Enhancing national prosperity and global competitiveness.\n• “Strict guardians of our heritage” – Positioning Barbados in the global arena.\n• Each strategic goal is supported by national objectives, strategies, and indicative targets. The plan also proposes the development of five-year sectoral plans to support implementation and allow for periodic revision.","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","meta/instanceID":"uuid:a3d10c45-55ef-4239-9336-304d7d8d541c","meta/deprecatedID":"uuid:27c394f2-60f6-4116-9bed-d7a87539217c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a3d10c45-55ef-4239-9336-304d7d8d541c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a3d10c45-55ef-4239-9336-304d7d8d541c"},{"_id":46549,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:44.595","end":"2025-11-07T14:26:44.595","id_drupal":"371","country":"chl","theme":"development_planning","original_language":"es","name_es":"Programa de Gobierno Michelle Bachellet 2014 - 2018","name_en":"Government Program of Michelle Bachelet 2014 - 2018","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Chile","responsible_institution/id_institution":"45273","responsible_institution/name_institution":"Presidencia de la República de Chile"}],"link":"bf704744-7499-4dd8-b4d6-1c0505dfa447","primary_link":"https://www.subdere.gov.cl/sites/default/files/noticias/archivos/programamb_1_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de Gobierno de Michelle Bachellet 2014-2018 se formula en el periodo de campaña presidencial. Nace como una necesidad de mostrar a la población interesada los lineamientos que se quieren conseguir durante el período estipulado, siendo en un principio una herramienta de difusión de ideales para lograr convencer a la ciudadanía, y luego, una vez electo el presidente o presidenta, se convierte en una herramienta que guiará la formulación de las políticas públicas para cumplir con lo prometido durante la campaña presidencial.\n\nEste plan presenta una visión que invita a construir juntos una nueva mayoría para un Chile de todos, a través de tres cimientos fundamentales de este gobierno: Reforma Educacional, Reforma Tributaria y Nueva Constitución, los cuales serán claves para conseguir un país de todos, donde chilenos y chilenas se incorporen al desarrollo. Este es uno de los mayores retos, ya que \"encara decididamente las desigualdades que persisten en el país, pues se funda en la convicción de que la desigualdad es insostenible no sólo desde un punto de vista económico y social, sino que también para una sana convivencia entre los chilenos y chilenas y para asegurar la paz social que requerimos para crecer y desarrollarnos de forma inclusiva. La gobernabilidad se funda en un destino compartido. La desigualdad es la negación de ese sentido común\".\n\nJunto a lo anterior, se presentan seis pilares fundamentales: \n1. Chilenos y chilenas que quieren ser protagonistas de su futuro, \n2. Abordar la desigualdad para mirar el futuro con confianza, \n3.Bases para una transformación social, política y económica, \n4.Un Chile que crece con todos, \n5.Un mejor Estado para el nuevo ciclo del país, \n6. Transformaciones con gobernabilidad\n\nEstos se complementan con los cuatro programas que abarcan diferentes aspectos de la vida social: \n1.Programa Económico, \n2. Protección y oportunidades, \n3. Descentralización, territorio y desarrollo y \n4. Derechos ciudadanos.","description_en":"The Government Plan of Michelle Bachelet 2014–2018 was formulated during the presidential campaign period. It emerged from the need to present to the public the main guidelines and goals to be pursued during the term, initially serving as a communication tool to share ideals and convince citizens. Once elected, the plan became a guiding framework for the formulation of public policies to fulfill the promises made during the campaign.\n\nThis plan presents a vision that invites citizens to build a new majority for a Chile that belongs to everyone, based on three fundamental pillars of this government: Educational Reform, Tax Reform, and a New Constitution. These pillars were seen as key to achieving a more inclusive country where all Chileans can take part in development. The plan tackles the persistent inequalities in the country, founded on the conviction that inequality is unsustainable — not only from an economic and social perspective, but also for fostering healthy coexistence among citizens and ensuring the social peace needed for inclusive growth and development. As the plan states, “governability is founded on a shared destiny. Inequality is the denial of that common purpose.”\n\nIn addition, the plan sets out six fundamental pillars:\n1. Chileans who want to be protagonists of their own future;\n2. Addressing inequality to look toward the future with confidence;\n3. Foundations for social, political, and economic transformation;\n4. A Chile that grows with everyone;\n5. A better State for the country’s new cycle; and\n6. Transformations with governability.\n\nThese are complemented by four thematic programs covering different aspects of social life:\n1. Economic Program,\n2. Protection and Opportunities,\n3. Decentralization, Territory and Development, and\n4. Citizens’ Rights.","linking_sdg_plans":"no","ipd/ipd_type":"government","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:76e8467b-3479-4a26-a94a-6ef9c0025c0d","meta/deprecatedID":"uuid:8aa6d771-961a-4ff0-af3e-31c4b0ae6d24","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"76e8467b-3479-4a26-a94a-6ef9c0025c0d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:76e8467b-3479-4a26-a94a-6ef9c0025c0d"},{"_id":46550,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:45.311","end":"2025-11-07T14:26:45.311","id_drupal":"465","country":"chl","theme":"development_planning","original_language":"es","name_es":"Programa de Gobierno de Chile (2018-2022)","name_en":"Government Program of Chile (2018-2022)","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Chile","responsible_institution/id_institution":"45273","responsible_institution/name_institution":"Presidencia de la República de Chile"}],"link":"ad1bf20e-6e8e-46fd-8b43-6939007c41fa","primary_link":"https://cdn.digital.gob.cl/filer_public/dd/70/dd70bc30-3fd1-45ef-846b-0f6cc03a41ab/programa_de_gobierno_de_sebastian_pinera.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de Gobierno \"Construyamos tiempos mejores para Chile 2018-2022\" nace como una necesidad de mostrar a la población los lineamientos que se quieren conseguir durante el período. Este fue pensado como una herramienta para guiar la formulación de las políticas públicas durante el período de gobierno.\n\nEste plan se centra en el bienestar de las familias, y busca promover y compatibilizar cuatro principios fundamentales: libertad, justicia, progreso y solidaridad. \n\nPresenta cuatro pilares fundamentales:\n1. Un Chile más libre que progresa creando oportunidades para\n2. Un Chile justo y solidario para caminar\n3. Un Chile seguro y en paz para progresar y vivir\n4. Un Chile para vivir una vida más plena y feliz\n ","description_en":"The Government Plan “Let’s Build Better Times for Chile 2018–2022” was conceived to present to the public the main guidelines and goals to be achieved during the presidential term. It was designed as a tool to guide the formulation of public policies throughout the government’s period in office.\n\nThis plan focuses on the well-being of families and seeks to promote and reconcile four fundamental principles: freedom, justice, progress, and solidarity.\n\nIt is structured around four fundamental pillars:\n1. A freer Chile that advances by creating opportunities;\n2. A just and supportive Chile that moves forward together;\n3. A safe and peaceful Chile that enables progress and quality of life;\n4. A Chile where people can live fuller and happier lives.\n","linking_sdg_plans":"no","ipd/ipd_type":"government","ipd/ipd_action_plan":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:cf6d589f-2d30-44da-aa81-115f101326d5","meta/deprecatedID":"uuid:162cebb0-da89-4503-a522-0f9c756773dd","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"cf6d589f-2d30-44da-aa81-115f101326d5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:44","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:cf6d589f-2d30-44da-aa81-115f101326d5"},{"_id":46551,"start":"2025-11-07T14:26:46.031-03:00","end":"2026-03-13T10:51:29.524-03:00","id_drupal":"1698","country":"chl","theme":"development_planning","original_language":"es","name_es":"Programa de Gobierno 2022-2026 de Chile","name_en":"Government Program 2022-2026 of Chile","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Chile","responsible_institution/id_institution":"45273","responsible_institution/name_institution":"Presidencia de la República de Chile"}],"link":"94fc0879-b344-4cd0-a7f7-7ca4535667ef","primary_link":"https://frenteampliochile.cl/wp-content/uploads/2024/06/3.-Programa-de-Gobierno-Apruebo-Dignidad-2022-2026.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de Gobierno tiene cuatro perspectivas transversales que recorren cada una de las propuestas hacia la búsqueda de justicia social y desconcentración del poder:\n\n1. Feminismo\n2.Transición ecológica justa\n3.Descentralización\n4. Garantía del trabajo decente\n\nA su vez, el Plan identifica tres tareas principales que tiene que afrontar el país:\n1.Enfrentar las consecuencias de la emergencia sanitaria y recuperar la economía\n2. Avanzar hacia una sociedad que ponga en el centro la sostenibilidad de la vida, el cuidado, la seguridad y el bienestar de las personas y las comunidades\n3. Promover la profundización de la democracia y cuidar el proceso de cambios\n\nPara el cumplimiento de cada una de estas tareas, el Plan identifica estrategias y medidas concretas.","description_en":"The Government Plan incorporates four cross-cutting perspectives that underpin all its proposals in pursuit of social justice and the decentralization of power:\n1. Feminism\n2. Just ecological transition\n3. Decentralization\n4. Guarantee of decent work\n\nIn addition, the Plan identifies three main tasks that the country must address:\n1. Confront the consequences of the health emergency and recover the economy\n2. Advance toward a society that places at its core the sustainability of life, care, safety, and the well-being of people and communities\n3. Promote the deepening of democracy and safeguard the process of change\n\nTo achieve each of these tasks, the Plan outlines specific strategies and concrete measures.","linking_sdg_plans":"no","ipd/ipd_type":"government","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","meta/instanceID":"uuid:3169d00d-f1ef-4058-9e42-0b40156f47f6","meta/deprecatedID":"uuid:97345531-394c-4e0c-b2fa-ddb61175c623","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3169d00d-f1ef-4058-9e42-0b40156f47f6","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:45","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3169d00d-f1ef-4058-9e42-0b40156f47f6"},{"_id":46552,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:46.753","end":"2025-11-07T14:26:46.753","id_drupal":"173","country":"col","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo \"Todos por un Nuevo País\" de Colombia (2014-2018)","name_en":"National Development Plan \"Todos por un Nuevo País\" of Colombia (2014-2018)","responsible_institution":[{"responsible_institution/institution":"Departamento Nacional de Planeación (DNP) de Colombia","responsible_institution/id_institution":"44978","responsible_institution/name_institution":"Departamento Nacional de Planeación (DNP) de Colombia"}],"link":"e790df7c-98b9-4e27-9372-efea56630c27","primary_link":"https://www.dnp.gov.co/plan-nacional-desarrollo/Paginas/todos-por-un-nuevo-pais-2014-2018-juan-manuel-santos.aspx","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo 2014-­2018 “Todos por un nuevo país\" se expide por medio de la Ley 1753 de 2015. Este Plan cuenta con tres ejes estratégicos que conforman un círculo virtuoso: la paz, la equidad y la educación. Además cuenta con seis objetivos nacionales que marcan los lineamientos para alcanzar el desarrollo: \n1. Competitividad e infraestructura estratégicas.\n2. Movilidad social.\n3. Transformación en el campo.\n4. Seguridad, justicia y democracia.\n5. Buen gobierno.\n6. Crecimiento verde.\n\nEl Plan posee un Sistema Nacional de  Evaluación y Gestión de Resultados (Sinergia), a cargo del Departamento Nacional de Planeación. Este sistema de seguimiento y evaluación contará con un comité técnico en todas las fases del proceso, el cual estará conformado por la Dirección de Seguimiento y Evaluación de Políticas Públicas, las direcciones técnicas relevantes dentro del DNP y las entidades ejecutoras de la política o programa evaluado. El sustento legal de este sistema lo brinda el Artículo 343 de la Constitución y la Ley 152 de 1994.","description_en":"The National Development Plan 2014–2018 “Todos por un nuevo país” (Everyone for a New Country) was enacted through Law No. 1753 of 2015. This Plan is structured around three strategic pillars that form a virtuous circle: peace, equity, and education. In addition, it establishes six national objectives that define the guidelines for achieving development:\n1. Competitiveness and strategic infrastructure\n2. Social mobility\n3. Transformation of the countryside\n4. Security, justice, and democracy\n5. Good governance\n6. Green growth\n\nThe Plan includes a National System for Evaluation and Results-Based Management (Sinergia), under the responsibility of the National Planning Department (DNP). This monitoring and evaluation system operates with a technical committee at all stages of the process, composed of the Directorate for Monitoring and Evaluation of Public Policies, relevant technical departments within the DNP, and the implementing entities of the evaluated policies or programs. The system’s legal foundation is provided by Article 343 of the Constitution and Law 152 of 1994.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Una sociedad en paz que pueda focalizar sus esfuerzos en el cierre de brechas y que pueda invertir recursos en mejorar la cobertura y calidad de su sistema educativo, envuelto en una estrategia de crecimiento verde\".","ipd/ipd_vision_en":"“A society at peace that can focus its efforts on closing gaps and investing resources in improving the coverage and quality of its education system, within a green growth strategy.”","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:295856c3-1385-4746-b7af-6cebaef15bf2","meta/deprecatedID":"uuid:630200c1-f067-4eb6-85f3-fcdfc75673d3","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"295856c3-1385-4746-b7af-6cebaef15bf2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:45","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:295856c3-1385-4746-b7af-6cebaef15bf2"},{"_id":46553,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:47.480","end":"2025-11-07T14:26:47.480","id_drupal":"916","country":"col","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo \"Pacto por Colombia, pacto por la equidad\" 2018 - 2022","name_en":"National Development Plan \"Pacto por Colombia, pacto por la equidad\" 2018 - 2022","responsible_institution":[{"responsible_institution/institution":"Departamento Nacional de Planeación (DNP) de Colombia","responsible_institution/id_institution":"44978","responsible_institution/name_institution":"Departamento Nacional de Planeación (DNP) de Colombia"}],"link":"3e42000d-5ed6-4c9d-b60e-d48dde07921b","primary_link":"https://colaboracion.dnp.gov.co/CDT/Prensa/PND-Pacto-por-Colombia-pacto-por-la-equidad-2018-2022.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo \"Pacto por Colombia, pacto por la equidad\"  pretende alcanzar la inclusión social y productiva, a través del Emprendimiento y la Legalidad.\n\nEn esta línea, se formulan tres pactos estructurales:\n1. El pacto por la legalidad que se basa en la consolidación del Estado Social de Derecho en todo el país;\n2. El pacto por el emprendimiento y la productividad, centrado en la transformación productiva que pretende reducir la dependencia del país de la minería y de los hidrocarburos, así como aumentar la formalización laboral y empresarial, dinamizar el desarrollo y la productividad en las zonas rurales del país.\n3. El pacto por la equidad se centra en garantizar la igualdad de oportunidades para la inclusión social (el acceso eficiente y con calidad a servicios de salud, cuidado infantil, educación y formación de capital humano, seguridad alimentaria, vivienda y hábitat) y las oportunidades para la inclusión productiva (acceso a mercados de trabajo e ingresos dignos).\n\nAdicionalmente, en el plan se plantean un conjunto de pactos transversales:\n• Pacto por la sostenibilidad: producir conservando y conservar produciendo\n• Pacto por la Ciencia, la Tecnología y la Innovación: un sistema para construir el conocimiento de la Colombia del futuro\n• Pacto por el transporte y la logística para la competitividad y la integración regional\n• Pacto por la transformación digital de Colombia: gobierno, empresas y hogares conectados con la era del conocimiento\n• Pacto por la calidad y eficiencia de servicios públicos: agua y energía para promover la competitividad y el bienestar de todos\n• Pacto por los recursos minero-energéticos para el crecimiento sostenible y la expansión de oportunidades\n• Pacto por la identidad y la creatividad: desarrollo de la economía naranja y protección y promoción de nuestra cultura\n• Pacto por la construcción de paz: víctimas, reintegración, estabilización y reconciliación\n• Pacto por la equidad de oportunidades para grupos étnicos: indígenas, negros, afros, raizales, palenqueros y Rom\n• Pacto por la inclusión y la dignidad de todas las personas con discapacidad\n• Pacto por la igualdad de la mujer\n• Pacto por la descentralización: conectar territorios, gobiernos y poblaciones\n• Pacto por la productividad y la equidad en las regiones","description_en":"The National Development Plan “Pact for Colombia, Pact for Equity” aims to achieve social and productive inclusion through entrepreneurship and legality.\n\nIn this context, the Plan defines three structural pacts:\n1. Pact for Legality, based on the consolidation of the Social Rule of Law throughout the country.\n2. Pact for Entrepreneurship and Productivity, focused on productive transformation to reduce the nation’s dependence on mining and hydrocarbons, increase labor and business formalization, and stimulate development and productivity in rural areas.\n3. Pact for Equity, which seeks to guarantee equal opportunities for social inclusion (efficient and quality access to health services, childcare, education and human capital formation, food security, housing, and habitat) and opportunities for productive inclusion (access to labor markets and decent incomes).\n\nAdditionally, the Plan includes a set of cross-cutting pacts:\n• Pact for Sustainability: producing while conserving and conserving while producing\n• Pact for Science, Technology, and Innovation: building a knowledge system for the Colombia of the future\n• Pact for Transport and Logistics for Competitiveness and Regional Integration\n• Pact for the Digital Transformation of Colombia: government, businesses, and households connected to the knowledge era\n• Pact for Quality and Efficiency in Public Services: water and energy to promote competitiveness and well-being for all\n• Pact for Mineral and Energy Resources: sustainable growth and the expansion of opportunities\n• Pact for Identity and Creativity: development of the orange economy and the protection and promotion of culture\n• Pact for Peacebuilding: victims, reintegration, stabilization, and reconciliation\n• Pact for Equal Opportunities for Ethnic Groups: Indigenous, Black, Afro-Colombian, Raizal, Palenquero, and Rom peoples\n• Pact for the Inclusion and Dignity of All Persons with Disabilities\n• Pact for Gender Equality\n• Pact for Decentralization: connecting territories, governments, and populations\n• Pact for Productivity and Equity in the Regions","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b9ae185b-dbfb-46ab-bb4e-8a8a9f3989ca","meta/deprecatedID":"uuid:36554df5-e2ea-4af4-a761-9ef54cbbc7eb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b9ae185b-dbfb-46ab-bb4e-8a8a9f3989ca","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b9ae185b-dbfb-46ab-bb4e-8a8a9f3989ca"},{"_id":46554,"start":"2025-11-07T14:26:48.217-03:00","end":"2026-01-07T15:21:13.168-03:00","id_drupal":"1726","country":"col","theme":"development_planning","original_language":"es","name_es":"Visión Colombia 2050","name_en":"Colombia Vision 2050","responsible_institution":[{"responsible_institution/institution":"Departamento Nacional de Planeación (DNP) de Colombia","responsible_institution/id_institution":"44978","responsible_institution/name_institution":"Departamento Nacional de Planeación (DNP) de Colombia"}],"link":"60c50c80-d55f-4a73-9417-b993cae1f0bb","primary_link":"https://colaboracion.dnp.gov.co/CDT/Prensa/Publicaciones/Documento_vision_colombia_2050.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"Visión Colombia 2050 propone una agenda de desarrollo estratégico y de largo plazo para los próximos 28 años que busca establecer unos principios básicos para la construcción de un bienestar sostenible, así como lograr acuerdos alrededor de propósitos superiores que debemos alcanzar como sociedad.\n\nEl propósito de este documento es convertirse en referente en la discusión de políticas públicas, reformas sociales y económicas, acuerdos nacionales y regionales y planes de desarrollo.\n\nVisión Colombia 2050 se estructura desde el Departamento Nacional de Planeación (DNP) a partir de discusiones con expertos de los sectores público y privado, organizaciones de la sociedad civil, la academia, gremios y la ciudadanía en general. Recoge también recomendaciones de diferentes misiones de expertos adelantadas en el país en las últimas décadas, ejercicios de prospectiva sectoriales y territoriales, agendas nacionales e internacionales, entre otros.\n\nVisión Colombia 2050 se estructura como un árbol, con un tronco que entrelaza cuatro bases para garantizar un bienestar integral para nuestra sociedad:\n1. Consolidar una senda de desarrollo humano en un marco de vidas más longevas, donde haya equidad y oportunidades para todos, sin pobreza extrema\n2. Convertir a Colombia en potencia ambiental\n3. Transformarnos hacia una economía productiva y sostenible\n4. Lograr una sociedad incluyente con un tejido social robusto e instituciones sólidas\n\nEstos cuatro pilares serán el tronco de un gran árbol promotor de equidad, bienestar y desarrollo para todos. A su vez, se establecen tres fuerzas transformadoras principales como motores dinamizadores de las bases de bienestar que potencian su alcance e impacto en la vida de cada colombiano.\n\nComo grandes puntos de llegada a 2050, las ramas que surgen gracias a un tronco robusto, se proponen cuatro ambiciones. El cumplimiento de estas ambiciones viene acompañado por agendas específicas que están en línea con las discusiones que se tuvieron con expertos y las tendencias mundiales. Estas agendas son propósitos intermedios para el fortalecimiento de las bases.","description_en":"Vision Colombia 2050 proposes a strategic, long-term development agenda for the next 28 years, aiming to establish basic principles for building sustainable well-being and to achieve agreements around higher-purpose goals that society must reach collectively.\n\nThe purpose of this document is to serve as a reference in discussions on public policies, social and economic reforms, national and regional agreements, and development plans.\n\nVision Colombia 2050 is structured by the National Planning Department (DNP) through consultations with experts from the public and private sectors, civil society organizations, academia, professional associations, and citizens at large. It also incorporates recommendations from various expert missions conducted in the country over recent decades, sectoral and territorial foresight exercises, national and international agendas, among other sources.\n\nVision Colombia 2050 is organized like a tree, with a trunk that interconnects four foundational pillars to ensure comprehensive well-being for society:\n1. Consolidate a path of human development within a framework of longer, healthier lives, with equity and opportunities for all, and without extreme poverty\n2. Transform Colombia into an environmental powerhouse\n3. Move towards a productive and sustainable economy\n4. Achieve an inclusive society with a strong social fabric and robust institutions\n\nThese four pillars form the trunk of a large tree promoting equity, well-being, and development for all. In addition, three main transformative forces are established as drivers that enhance the reach and impact of these foundational pillars on the life of every Colombian.\n\nAs major milestones toward 2050, the branches emerging from this robust trunk represent four ambitions. Achieving these ambitions is accompanied by specific agendas aligned with the discussions held with experts and global trends. These agendas serve as intermediate objectives to strengthen the foundational pillars.","linking_sdg_plans":"no","sdg":"sdg_2 sdg_3 sdg_4 sdg_6 sdg_7 sdg_8 sdg_9 sdg_11 sdg_13 sdg_15 sdg_17","ipd/ipd_type":"vision","ipd/ipd_legal_framework":"no","ipd/ipd_action_plan":"no","ipd/ipd_participation":"yes","ipd/ipd_budget":"no","ipd/ipd_tracking":"no","ipd/ipd_investment":"no","ipd/ipd_indicators":"no","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:bab915ae-5a6f-431b-827a-fa9bb2773378","meta/deprecatedID":"uuid:7cb41221-53c0-485d-b1d0-ba3f5ae74eff","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bab915ae-5a6f-431b-827a-fa9bb2773378","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:bab915ae-5a6f-431b-827a-fa9bb2773378"},{"_id":46555,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:49.047","end":"2025-11-07T14:26:49.047","id_drupal":"1729","country":"col","theme":"development_planning","original_language":"es","name_es":"Plan de Desarrollo Colombia Potencia Mundial de la Vida de Colombia","name_en":"National Development Plan Colombia Potencia Mundial de la Vida of Colombia","responsible_institution":[{"responsible_institution/institution":"Departamento Nacional de Planeación (DNP) de Colombia","responsible_institution/id_institution":"44978","responsible_institution/name_institution":"Departamento Nacional de Planeación (DNP) de Colombia"}],"link":"89ea5d08-1972-4428-9d00-cbc7cce5bb15","primary_link":"https://colaboracion.dnp.gov.co/CDT/Prensa/Publicaciones/plan-nacional-de-desarrollo-2022-2026-colombia-potencia-mundial-de-la-vida.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo 2022‑2026 “Colombia, Potencia Mundial de la Vida” es la hoja de ruta del Gobierno de Colombia para el periodo 2022‑2026, cuyo objetivo central es sentar las bases para que el país se convierta en líder global de la protección de la vida, mediante un nuevo contrato social que supere injusticias y exclusiones históricas, evite la repetición del conflicto, transforme la relación con el ambiente y promueva una producción sustentada en el conocimiento, en armonía con la naturaleza.\n\nEste plan se estructura a través de cinco grandes transformaciones:\n1. Derecho humano a la alimentación.\n2. Ordenamiento del territorio alrededor del agua.\n3. Seguridad humana.\n4. Economía productiva para la vida y lucha contra el cambio climático.\n5. Convergencia regional.\n\nEl plan pone especial énfasis en la protección de la vida, la justicia social, la sostenibilidad ambiental y el cierre de brechas territoriales y sociales. Además, está diseñado para alinearse con los Objetivos de Desarrollo Sostenible (ODS) y cuenta con un sistema de seguimiento y evaluación presidido por el Departamento Nacional de Planeación (DNP).","description_en":"The National Development Plan 2022‑2026 “Colombia, a Global Power for Life” is Colombia’s strategic roadmap for the 2022‑2026 period, whose core objective is to lay the foundations for the country to become a global leader in the protection of life, through a new social contract that overcomes historical injustices and exclusions, prevents the recurrence of conflict, transforms its relationship with the environment, and fosters knowledge‑based production in harmony with nature.\n\nThe plan is structured around five major transformations:\n1. Human right to food.\n2. Territorial planning centred on water.\n3. Human security.\n4. Productive economy for life and the fight against climate change.\n5. Regional convergence.\n\nThe plan emphasises life protection, social justice, environmental sustainability and the reduction of territorial and social gaps. It is also designed in alignment with the Sustainable Development Goals (SDGs) and features a monitoring and evaluation system overseen by the National Planning Department (DNP).","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_participation":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:bf44adc6-99a4-4585-bd6d-3b4bba2e473b","meta/deprecatedID":"uuid:4219e79f-65f7-4c3b-80ef-55db644ce549","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bf44adc6-99a4-4585-bd6d-3b4bba2e473b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:48","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:bf44adc6-99a4-4585-bd6d-3b4bba2e473b"},{"_id":46556,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:49.776","end":"2025-11-07T14:26:49.776","id_drupal":"330","country":"cri","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo “Alberto Cañas Escalante” de Costa Rica (2015-2018)","name_en":"National Development Plan \"Alberto Cañas Escalante\" of Costa Rica (2015-2018)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica","responsible_institution/id_institution":"45133","responsible_institution/name_institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica"}],"link":"4f0eccbd-231a-4a09-8e1e-d501be5da415","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo (PND) “Alberto Cañas Escalante”, con vigencia del 2015 al 2018, se realiza mediante mandato de Ley No. 5525 de Planificación Nacional. Ha sido diseñado desde la perspectiva de la gestión para resultados pues se requiere fortalecimiento institucional que se exprese en transparencia, efectividad, oportunidad y responsabilidad de la acción pública. La contraloría ciudadana y la activa participación de la sociedad civil en la construcción de alternativas para el desarrollo comunitario, local, territorial, regional y nacional son fundamentales en este propósito y así se concibe en el camino trazado en el PND, el cual incluye temáticas sensibles en la agenda nacional, la competitividad, la matriz energética, la pesca, el turismo rural comunitario, alternativas de transporte, la innovación tecnológica, así como la promoción del bienestar humano y animal, entre otros.\n\nLos tres pilares que sustentan la propuesta política del PND son el punto de partida para la definición de los objetivos y metas nacionales, las cuales se operacionalizan por medio de las propuestas sectoriales:\n• Impulsar el crecimiento económico y generar empleo de calidad.\n• Combate a la pobreza y reducción de la desigualdad.\n• Un Gobierno abierto, transparente, eficiente, en lucha frontal contra la corrupción.\n\nEl Plan posee un Sistema Nacional de Evaluación, que se realizará de acuerdo con las metodologías definidas y se implementará a través de los diversos nodos de la planificación nacional. Este sistema está a cargo del MIDPLAN. El sustento normativo lo brinda el Decreto SINE 35.755 y el Decreto Ejecutivo 37.735.","description_en":"The National Development Plan (NDP) “Alberto Cañas Escalante” (2015–2018) was formulated under the mandate of Law No. 5525 on National Planning. It was designed from a results-based management perspective, emphasizing the need for institutional strengthening expressed through transparency, effectiveness, timeliness, and accountability in public action. Citizen oversight and active civil society participation in building alternatives for community, local, territorial, regional, and national development are central to this purpose. The NDP addresses key issues on the national agenda such as competitiveness, the energy matrix, fisheries, community rural tourism, transportation alternatives, technological innovation, and the promotion of human and animal well-being, among others.\n\nThe three pillars that underpin the NDP’s political proposal serve as the foundation for defining national goals and objectives, which are operationalized through sectoral strategies:\n• Promote economic growth and generate quality employment.\n• Combat poverty and reduce inequality.\n• Foster an open, transparent, and efficient government committed to a strong fight against corruption.\n\nThe Plan includes a National Evaluation System, which is implemented according to established methodologies through various nodes of the national planning structure. This system is coordinated by MIDPLAN and supported by Decree SINE 35,755 and Executive Decree 37,735.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Un país solidario e inclusivo que garantiza el bienestar de las presentes y futuras generaciones, en el que la gente participa y confía en un sistema democrático e institucional, transparente y efectivo\".","ipd/ipd_vision_en":"“A supportive and inclusive country that guarantees the well-being of present and future generations, where people participate and trust in a transparent, effective, and democratic institutional system.”","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:3d9b70b8-fd54-462c-95c9-b32d789048d1","meta/deprecatedID":"uuid:33bee545-3493-4b24-949e-2d639306c7ae","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3d9b70b8-fd54-462c-95c9-b32d789048d1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:48","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3d9b70b8-fd54-462c-95c9-b32d789048d1"},{"_id":46557,"start":"2025-11-07T14:26:50.493-03:00","end":"2026-01-15T11:01:35.755-03:00","id_drupal":"1760","country":"cri","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo e Inversión Pública 2023-2026 de Costa Rica","name_en":"National Development and Public Investment Plan 2023-2026 of Costa Rica","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica","responsible_institution/id_institution":"45133","responsible_institution/name_institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica"}],"link":"ba49914b-baaa-4bd6-a4cb-6d27d99b3782","primary_link":"https://sites.google.com/expedientesmideplan.go.cr/pndip-2023-2026/pagina_principal","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo e Inversión Pública (PNDIP) es un instrumento para la formulación de prioridades estratégicas para el desarrollo del país. Se construye a partir de las mejores prácticas internacionales en materia de planificación y evaluación de las políticas públicas, donde se consideran aquellos ámbitos estratégicos con alto potencial hacia el desarrollo económico y social requerido por el país.\n\nAsimismo, es el instrumento principal de política pública de mediano plazo para el país, donde la promesa democrática se concreta y se valida de forma directa por el mandato de gobierno dado en las urnas en el pasado proceso de elecciones democráticas. Este PNDIP considera al ciudadano y la búsqueda de su mayor bienestar y prosperidad, como un elemento central en la planificación estratégica de las distintas intervenciones públicas basadas en el Modelo de Gestión para los Resultados de Desarrollo, las cuales se ajustan a las necesidades actuales y futuras de la sociedad costarricense, así como a las distintas agendas y objetivos internacionales para el desarrollo, como el Consenso de Montevideo sobre Población y Desarrollo y los ODS de la Agenda 2030.\n\nDe esta manera se concretan los distintos esfuerzos de políticas, metas, programas y proyectos sectoriales de relevancia para la visión de desarrollo sectorial y regional de la actual Administración. Se destaca la priorización de líneas estratégicas en atención a los desafíos económicos, sociales, ambientales, de seguridad ciudadana, que accionan prioridades como la modernización del aparato estatal, la reactivación económica, la disminución del costo de la vida, del desempleo, la pobreza, la desigualdad, las brechas territoriales, entre otras; las cuales a partir de un enfoque integral y moderno de las políticas públicas, permitan impactar de manera real, sobre aquellos ámbitos que aquejan la gobernanza estatal para dinamizar la atención de estos desafíos y con ello alcanzar el bienestar de los costarricenses.\n\nEl Plan Nacional de Desarrollo e Inversión Pública 2023-2026 (PNDIP) hace referencia al marco orientador de las políticas del Gobierno para un período de cuatro años, elaborado bajo la coordinación de Mideplan con las demás instituciones del Sistema Nacional de Planificación (SNP) y la participación ciudadana. El PNDIP debe estar en congruencia con el Plan Estratégico Nacional (PEN) y considerando los Planes Nacionales Sectoriales (PNS) y Planes Regionales de Desarrollo (PRD). El PNDIP define objetivos, intervenciones y metas para el desarrollo del país, así como las prioridades presupuestarias públicas.","description_en":"he National Development and Public Investment Plan (PNDIP) is a key instrument for formulating the country’s strategic development priorities. It is built upon international best practices in planning and public policy evaluation, focusing on strategic areas with high potential for driving the economic and social development required by the nation.\n\nIt also serves as the main medium-term public policy instrument, where the democratic promise is realized and validated through the mandate granted by citizens in the most recent democratic elections. The PNDIP places citizens and the pursuit of their well-being and prosperity at the center of strategic planning for public interventions, guided by the Results-Based Management for Development Model. These interventions are aligned with both current and future societal needs, as well as with international development frameworks such as the Montevideo Consensus on Population and Development and the 2030 Agenda for Sustainable Development (SDGs).\n\nThe plan brings together diverse policies, goals, programs, and sectoral projects that are central to the sectoral and regional development vision of the current Administration. It prioritizes strategic lines of action to address economic, social, environmental, and citizen security challenges, advancing priorities such as modernization of the State apparatus, economic recovery, and the reduction of living costs, unemployment, poverty, inequality, and territorial disparities. Through an integrated and modern approach to public policy, it seeks to effectively address these challenges and strengthen state governance to achieve greater well-being for all Costa Ricans.\n\nThe National Development and Public Investment Plan 2023–2026 (PNDIP) defines the policy framework guiding government action over a four-year period. It is coordinated by MIDEPLAN, in collaboration with the institutions of the National Planning System (SNP) and with citizen participation. The PNDIP must align with the National Strategic Plan (PEN) and take into account both the National Sectoral Plans (PNS) and Regional Development Plans (PRD). It establishes the objectives, interventions, and targets for national development, as well as public budget priorities.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_5 sdg_8 sdg_9 sdg_10 sdg_13 sdg_16 sdg_17","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Decreto 43903. Emisión del Plan Nacional de Desarrollo e Inversión Pública (PNDIP) 2023-2026","link_block/external_link_text_en":"Decree 43903: Issuance of the National Development and Public Investment Plan (NDIP) 2023–2026","link_block/external_link_text_url":"https://repositorio.mopt.go.cr/items/e8e44139-16df-4159-b3a5-4ae0fed17534"},{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema Nacional de Planificación de Costa Rica","link_block/snp_id":"37663","link_block/snp_name":"Sistema Nacional de Planificación de Costa Rica"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Estratégico Nacional 2050 de Costa Rica","link_block/plan_id":"46558","link_block/plan_name":"Plan Estratégico Nacional 2050 de Costa Rica"}],"meta/instanceID":"uuid:ec378814-3096-4d0b-a81c-5ed6097f99b4","meta/deprecatedID":"uuid:06899e3a-75ca-4680-945d-2e3769511686","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ec378814-3096-4d0b-a81c-5ed6097f99b4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:49","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ec378814-3096-4d0b-a81c-5ed6097f99b4"},{"_id":46558,"start":"2025-11-07T14:26:51.210-03:00","end":"2026-01-15T11:00:32.906-03:00","id_drupal":"2263","country":"cri","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico Nacional 2050 de Costa Rica","name_en":"National Strategic Plan 2050 of Costa Rica","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica","responsible_institution/id_institution":"45133","responsible_institution/name_institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica"}],"link":"5e8070da-2925-4139-8668-33d5f0817baf","primary_link":"https://www.mideplan.go.cr/plan-estrategico-nacional-2050","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Estratégico Nacional 2050 se constituye en el principal instrumento de planificación a largo plazo que permitirá lograr el cambio del paradigma sobre el que se llegarán a elaborar los esfuerzos y tareas nacionales de planificación. Este se construyó a partir de un conjunto comprensivo, estructurado y prospectivo de información recopilada. El PEN 50 es el instrumento clave para trazar la ruta hacia el progreso económico y social, el que requerirá de la construcción de amplios acuerdos políticos y sociales basados en el bien y la mirada comunes.","description_en":"The National Strategic Plan 2050 (PEN 2050) is the main long-term planning instrument designed to transform the paradigm guiding national planning efforts and initiatives. It was developed based on a comprehensive, structured, and forward-looking body of information, and serves as a key tool for charting the path toward economic and social progress. Achieving this vision will require the building of broad political and social agreements grounded in a shared sense of purpose and collective well-being.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"La visión de desarrollo para Costa Rica, comprende poder consolidarse como un país inclusivo, donde el aumento en la productividad y competitividad llegue a todos los sectores, procurando el mayor bienestar en un ambiente ecológicamente sostenible\".","ipd/ipd_vision_en":"\"The development vision for Costa Rica is to consolidate itself as an inclusive country, where increases in productivity and competitiveness reach all sectors, fostering greater well-being within an ecologically sustainable environment.\"","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley No. 5525 de Planificación Nacional de Costa Rica","link_block/legal_id":"49396","link_block/legal_name":"Ley No. 5525 de Planificación Nacional de Costa Rica"},{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema Nacional de Planificación de Costa Rica","link_block/snp_id":"37663","link_block/snp_name":"Sistema Nacional de Planificación de Costa Rica"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Nacional de Desarrollo e Inversión Pública 2023-2026 de Costa Rica","link_block/plan_id":"46557","link_block/plan_name":"Plan Nacional de Desarrollo e Inversión Pública 2023-2026 de Costa Rica"}],"meta/instanceID":"uuid:5db090ca-9800-44c8-bd80-48d46f1adaeb","meta/deprecatedID":"uuid:5b4ff825-8add-449f-b6a3-b8c89f4b78d3","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5db090ca-9800-44c8-bd80-48d46f1adaeb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:50","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:5db090ca-9800-44c8-bd80-48d46f1adaeb"},{"_id":46559,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:51.926","end":"2025-11-07T14:26:51.926","id_drupal":"2264","country":"cri","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo e Inversión Pública del Bicentenario de Costa Rica","name_en":"Bicentennial National Development and Public Investment Plan of Costa Rica","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica","responsible_institution/id_institution":"45133","responsible_institution/name_institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica"}],"link":"ba46ba88-8b94-4b02-9567-d4add661bd40","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo e Inversión Pública del Bicentenario 2019‑2022 de Costa Rica es la hoja de ruta del Gobierno para ese período, integrando por primera vez en un solo documento el desarrollo nacional y la inversión pública. Su objetivo principal es “generar crecimiento económico inclusivo a nivel nacional y regional, en armonía con el ambiente, promoviendo empleos de calidad y reduciendo la pobreza y la desigualdad”. El plan incluye más de 270 programas y proyectos de inversión pública, 7 metas nacionales y numerosas intervenciones estratégicas articuladas en siete áreas de acción. Además, incorpora indicadores vinculados a los Objetivos de Desarrollo Sostenible (ODS) y un sistema de seguimiento y evaluación coordinado por el Ministerio de Planificación Nacional y Política Económica (Mideplan).","description_en":"The National Development and Public Investment Plan of the Bicentennial 2019‑2022 of Costa Rica is the Government’s strategic roadmap for that period, combining national development and public investment in a single document for the first time. Its main objective is to “generate inclusive economic growth at both national and regional levels, in harmony with the environment, promoting quality jobs and reducing poverty and inequality”. The plan features over 270 investment programs and projects, 7 national targets and numerous strategic interventions organized across seven action areas. Moreover, it includes indicators aligned with the Sustainable Development Goals (SDGs) and a monitoring and evaluation system coordinated by the Ministry of National Planning and Economic Policy (Mideplan).","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:a4b01c5b-d654-475d-b650-30c01f09cd8c","meta/deprecatedID":"uuid:b55c151d-050b-43ba-856a-be8d2db3feb2","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a4b01c5b-d654-475d-b650-30c01f09cd8c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:51","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a4b01c5b-d654-475d-b650-30c01f09cd8c"},{"_id":46560,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:52.650","end":"2025-11-07T14:26:52.650","id_drupal":"1725","country":"cub","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo Económico y Social 2030 de Cuba","name_en":"National Economic and Social Development Plan 2030 of Cuba","responsible_institution":[{"responsible_institution/institution":"Ministerio de Economía y Planificación (MEP) de Cuba","responsible_institution/id_institution":"45222","responsible_institution/name_institution":"Ministerio de Economía y Planificación (MEP) de Cuba"}],"link":"984647cb-f0c5-4241-b397-4c56a358d635","primary_link":"https://www.mep.gob.cu/sites/default/files/Documentos/Archivos/FOLLETO%20PNDES%20%20FINAL%20est%C3%A1%20en%20planificaci%C3%B3n.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"En el PNDES 2030 se establecen seis ejes estratégicos, diseñados bajo un enfoque sistémico, que articulan la propuesta de desarrollo económico y social de Cuba a 2030.\n\nEn los seis ejes estratégicos se transversaliza el enfoque de género, la reducción de las desigualdades, el crecimiento económico, la sostenibilidad ambiental y el hambre cero, integrando las tres dimensiones del desarrollo sostenible.\n\nEl Plan es el documento rector del Sistema Nacional de Planificación, e incluye las estrategias, objetivos y acciones generales en materia económica, social y política, concebidas de manera integral y coherente para orientar la conducción del desarrollo y resolver los desequilibrios estructurales de la economía con una visión estratégica y consensuada a mediano y largo plazo.\n\nA su vez, constituye la herramienta principal para lograr los objetivos esenciales que se enuncian en la Conceptualización del Modelo Económico y Social Cubano de Desarrollo Socialista.\n\nLos seis ejes estratégicos del PNDES 2030 fueron expresados en macroprogramas y programas, que se articulan con los objetivos y metas de la Agenda 2030. Este sistema de trabajo busca contribuir a alinear visiones con respecto a las prioridades, focalizando la atención en las principales problemáticas nacionales y no en las funciones y competencias de las instituciones. Ello facilita la coordinación y coherencia de las políticas y acciones.","description_en":"The National Economic and Social Development Plan (PNDES) 2030 establishes six strategic axes, designed under a systemic approach that articulates Cuba’s economic and social development vision toward 2030.\n\nThese six strategic axes mainstream gender equality, inequality reduction, economic growth, environmental sustainability, and zero hunger, thereby integrating the three dimensions of sustainable development.\n\nThe Plan serves as the guiding document of the National Planning System, encompassing the strategies, objectives, and general actions in economic, social, and political matters. It is conceived in an integral and coherent manner to steer the country’s development and address the structural imbalances of the economy, with a strategic and consensus-based vision for the medium and long term.\n\nIn addition, it constitutes the main tool for achieving the essential objectives set forth in the Conceptualization of the Cuban Economic and Social Model of Socialist Development.\n\nThe six strategic axes of the PNDES 2030 are reflected in macroprograms and programs aligned with the objectives and targets of the 2030 Agenda. This system seeks to align national priorities, focusing attention on key national challenges rather than on institutional functions and competencies. This approach enhances policy coordination and coherence across sectors and levels of government.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:dfb1494b-986f-4875-837f-b542fa24d6e6","meta/deprecatedID":"uuid:8ac319c1-e308-45cd-9bee-081754578acd","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dfb1494b-986f-4875-837f-b542fa24d6e6","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:51","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dfb1494b-986f-4875-837f-b542fa24d6e6"},{"_id":46561,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:53.358","end":"2025-11-07T14:26:53.358","id_drupal":"354","country":"dma","theme":"development_planning","original_language":"en","name_es":"Estrategia de Crecimiento y Protección Social (2014-2018) de Dominica","name_en":"Growth and Social Protection Strategy (2014-2018) of Dominica","link":"778ec735-bdcb-4f15-b60b-6ddfd30f1a17","primary_link":"https://finance.gov.dm/en/news/publications/national-development-strategies?download=3:gsps-2014-2018","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"La cuarta revisión de la Estrategia de Crecimiento y Protección Social (GSPS) 2014 – 2018 reafirma el compromiso del Gobierno con la búsqueda del Desarrollo Sostenible mediante políticas sólidas orientadas a mejorar la calidad de vida de todos los dominicanos. De acuerdo con las ediciones anteriores, esta cuarta revisión a mediano plazo promueve el crecimiento económico sostenido como la principal vía para la reducción de la pobreza. El Gobierno de la Mancomunidad de Dominica mantiene sus esfuerzos para alcanzar lo siguiente:\n• Políticas fiscales sólidas y reforma administrativa, incluyendo la creación de un entorno favorable para la inversión privada local y la atracción de inversión extranjera directa;\n• Estrategias sectoriales para el crecimiento;\n• Estrategias para la reducción de la pobreza y la protección social.\n\nEl plan también incluye un sistema de monitoreo y evaluación, en el cual el Ministerio de Finanzas (autoridad de planificación) es responsable de la coordinación. El conjunto de indicadores seleccionados fue sugerido en el marco del Desarrollo de un Sistema de Evaluación del Desempeño (PAF), patrocinado por la Unión Europea.","description_en":"This fourth review of the Growth and Social Protection Strategy (GSPS) 2014 – 2018 reaffirms Government’s commitment to the pursuit of Sustainable Development through sound policies geared at improving the quality of life of all Dominicans. Consistent with earlier editions, this 4th medium-term review promotes sustained economic growth as the main route to poverty reduction. The Government of the Commonwealth of Dominica remains its efforts to accomplish the following:\n• Sound fiscal policy and administrative reform, including creating an enabling environment for local private investment and the attraction of foreign direct investment;\n• Sectoral strategies for growth;\n • Strategies for poverty reduction and social protection\n\nThe plan also includes a monitor and evaluation system in which the Ministry of Finance (plannig authority) is in charge of coordinating. The set of indicators selected were suggested in the EU-sponsored Development of a Performance Assessment Framework (PAF).","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Aprovechar todos los recursos humanos, naturales y financieros disponibles en el país, con el fin de materializar la visión de Dominica como un lugar caracterizado por el éxito económico y por una calidad de vida notablemente mejorada para su población, a través del empoderamiento de las personas y mediante políticas gubernamentales orientadas a facilitar un entorno en el que la empresa privada pueda prosperar\".","ipd/ipd_vision_en":"\"Leveraging all of the human, natural and financial resources available to the country, in order to realize the vision for Dominica as a place characterized by economic success and by the much-enhanced quality of life of its people, through their own empowerment, and through policies of Government geared to facilitating an environment within which private enterprise can flourish\".","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:d28e6c46-2638-450e-ad19-e44fa5462e9c","meta/deprecatedID":"uuid:1e7db7a7-2daf-4a89-a7fb-c80a56df413d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d28e6c46-2638-450e-ad19-e44fa5462e9c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d28e6c46-2638-450e-ad19-e44fa5462e9c"},{"_id":46562,"start":"2025-11-07T14:26:54.074-03:00","end":"2026-01-09T09:03:15.692-03:00","id_drupal":"670","country":"dma","theme":"development_planning","original_language":"en","name_es":"Estrategia Nacional de Desarrollo para la Resiliencia 2030 de Dominica","name_en":"National Resilience Development Strategy 2030 of Dominica","responsible_institution":[{"responsible_institution/institution":"Comité de Secretarios Permanentes de Dominica","responsible_institution/id_institution":"45214","responsible_institution/name_institution":"Comité de Secretarios Permanentes de Dominica"}],"instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Estrategia Nacional de Desarrollo Resiliente (NRDS, por sus siglas en inglés) se caracteriza por tres fuerzas principales: los Objetivos de Desarrollo Sostenible; la visión de construir el primer país resiliente al clima en el mundo; y el Desarrollo centrado en las personas.\n\nEstas fuerzas se articulan en tres elementos estratégicos:\n1. Protección ambiental\n2. Desarrollo social\n3. Desarrollo económico y transformación\n\nEn el núcleo de este marco estratégico se encuentran los objetivos nacionales de Sostenibilidad y Resiliencia.\n\nLas estrategias sectoriales, que se enfocan en las personas, políticas macroeconómicas y fiscales sólidas, gestión ambiental, crecimiento sostenible e inclusivo con generación de empleo, y áreas sinérgicas y transversales, son los motores que impulsan la NRDS. Una vez implementadas con éxito, estas conducirán a una Dominica resiliente.","description_en":"The National Resilience Development Strategy (NRDS) is characterized by three major forces: Sustainable Development Goals;  Building the First Climate Resilient Country in the World vision and; People-centered Development.\n\nThese forces are shaped by three strategic elements:\n1. Environmental Protection\n2.Social Development\n3.Economic Development and Transformation\n\nAt the core of this strategic framework are the national goals of Sustainability and Resilience.\n\nSectoral strategies which focuses on people, sound macro-economic and fiscal policies, environmental management, sustainable and inclusive growth with jobs, and synergistic and cross-cutting areas are the engines that drive the NRDS, and once successfully implemented will lead to a resilient Dominica.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:4506d128-c230-447d-8aa5-3e4d8ab1c235","meta/deprecatedID":"uuid:3244b3b9-3884-4b65-b952-94f226beb84b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4506d128-c230-447d-8aa5-3e4d8ab1c235","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4506d128-c230-447d-8aa5-3e4d8ab1c235"},{"_id":46563,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:54.796","end":"2025-11-07T14:26:54.796","id_drupal":"335","country":"dom","theme":"development_planning","original_language":"es","name_es":"Estrategia Nacional de Desarrollo 2010-2030. Un viaje de transformación hacia un país mejor de República Dominicana","name_en":"National Development Strategy 2010-2030: A Transformational Journey Towards a Better Country of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Ministerio de Economía, Planificación y Desarrollo de República Dominicana","responsible_institution/id_institution":"45420","responsible_institution/name_institution":"Ministerio de Economía, Planificación y Desarrollo de República Dominicana"}],"link":"233601c3-c5c4-4226-99ab-97794a0d6c60","primary_link":"https://mepyd.gob.do/mepyd/wp-content/uploads/archivos/end/marco-legal/ley-estrategia-nacional-de-desarrollo.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2010-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"En 2006, el Congreso Nacional aprobó la Ley de Planificación e Inversión Pública, en la cual se ordena el diseño de una Estrategia de Desarrollo como parte de los instrumentos de planificación. En el cumplimiento de ese mandato, el Ministerio de Economía, Planificación y Desarrollo (MEPyD), con la colaboración del Consejo Nacional de Reforma del Estado (CONARE), elaboró una propuesta de Estrategia Nacional de Desarrollo (END).\n\nSu elaboración se hizo mediante la Ley 1-12, la cual contiene la formulación de la visión de Nación de largo plazo, los Ejes, Objetivos y Líneas de Acción estratégicas, un conjunto de indicadores y metas que el país se propone lograr en el horizonte temporal de aplicación de la Estrategia.\n\nLa END se articula en torno a cuatro ejes estratégicos:\n1. Un Estado con instituciones eficientes y transparentes, al servicio de una ciudadanía responsable y participativa, que garantiza la seguridad y promueve el desarrollo y la convivencia pacífica.\n2. Una sociedad cohesionada, con igualdad de oportunidades y bajos niveles de pobreza y desigualdad.\n3. Una economía articulada, innovadora y sostenible, con una estructura productiva que genera crecimiento alto y sostenido con empleo decente, y que se inserta de forma competitiva en la economía global.\n4. Un manejo sustentable del medio ambiente y una adecuada adaptación al cambio climático\n\nAdemás, cuenta con un Sistema Nacional de Monitoreo y Evaluación, avalado por la Ley No. 1-12 de Estrategia Nacional de Desarrollo 2030 de República Dominicana. El Ministerio de Economía, Planificación y Desarrollo (MEPyD) es la entidad a cargo de este sistema.","description_en":"In 2006, the National Congress approved the Law on Planning and Public Investment, which mandated the design of a Development Strategy as part of the country’s planning instruments. In compliance with this mandate, the Ministry of Economy, Planning and Development (MEPyD), in collaboration with the National Council for State Reform (CONARE), prepared a proposal for the National Development Strategy (END).\n\nThe strategy was formalized through Law No. 1-12, which establishes the long-term national vision, along with the strategic pillars, objectives, and lines of action, as well as a set of indicators and targets the country aims to achieve within the implementation timeframe of the Strategy.\n\nThe END is structured around four strategic pillars:\n1. A State with efficient and transparent institutions, serving a responsible and participatory citizenry, ensuring security, and promoting development and peaceful coexistence.\n2. A cohesive society with equal opportunities and low levels of poverty and inequality.\n3. An articulated, innovative, and sustainable economy with a productive structure that generates high and sustained growth, provides decent employment, and competes successfully in the global economy.\n4. Sustainable management of the environment and appropriate adaptation to climate change.\n\nThe Strategy also includes a National Monitoring and Evaluation System, established under Law No. 1-12 on the National Development Strategy 2030 of the Dominican Republic, coordinated by the Ministry of Economy, Planning and Development (MEPyD).","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"República Dominicana es un país próspero, donde se vive con dignidad, seguridad y paz, con igualdad de oportunidades, en un marco de democracia participativa, ciudadanía responsable e inserción competitiva en la economía global, y que aprovecha sus recursos para desarrollarse de forma innovadora y sostenible\".","ipd/ipd_vision_en":"\"The Dominican Republic is a prosperous country where people live with dignity, security, and peace, with equal opportunities, in a framework of participatory democracy, responsible citizenship, and competitive integration into the global economy, making innovative and sustainable use of its resources for development.\"","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f66acf93-97ff-4faa-ba20-d5f9c2967fb3","meta/deprecatedID":"uuid:e000fcc2-5135-49ef-9549-b86e7d1f8703","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f66acf93-97ff-4faa-ba20-d5f9c2967fb3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f66acf93-97ff-4faa-ba20-d5f9c2967fb3"},{"_id":46564,"start":"2025-11-07T14:26:55.505-03:00","end":"2026-03-16T17:04:04.530-03:00","id_drupal":"1943","country":"dom","theme":"development_planning","original_language":"es","name_es":"Plan Nacional Plurianual del Sector Público 2021-2024 de República Dominicana","name_en":"Multi-Year National Public Sector Plan 2021-2024 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Ministerio de Economía, Planificación y Desarrollo de República Dominicana","responsible_institution/id_institution":"45420","responsible_institution/name_institution":"Ministerio de Economía, Planificación y Desarrollo de República Dominicana"}],"link":"40c18a46-3161-4365-99ef-a0c8875b23d0","primary_link":"https://mepyd.gob.do/publicaciones/plan-nacional-plurianual-del-sector-publico-2021-2024/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El instrumento estratégico de mayor jerarquía en el Sistema Nacional de Planificación e Inversión Pública (SNPIP) es la Estrategia Nacional de Desarrollo (END), aprobada por la Ley No. 1-12 y su reglamento de aplicación, aprobado mediante el Decreto 134-14.\n\nEl Plan Nacional Plurianual del Sector Público (PNPSP), opera con un horizonte temporal de mediano plazo (cuatro años) y su alcance está circunscripto al sector público. Es el instrumento que define y organiza el aporte del sector público a la concreción de la END en el mediano plazo.","description_en":"The National Development Strategy (END) is the highest-level strategic instrument within the National Planning and Public Investment System (SNPIP). It was approved by Law No. 1-12 and its implementing regulation, enacted through Decree No. 134-14.\n\nThe Multiyear National Public Sector Plan (PNPSP) operates within a medium-term horizon (four years) and is limited in scope to the public sector. It serves as the instrument that defines and organizes the public sector’s contribution to the implementation of the END over the medium term.","linking_sdg_plans":"no","sdg":"sdg_3 sdg_4 sdg_6 sdg_8 sdg_9 sdg_11 sdg_16","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:9981827e-9cd8-4803-ba6c-20ef68a8387c","meta/deprecatedID":"uuid:516f2c53-9cce-42f9-931d-0a26456f7e64","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9981827e-9cd8-4803-ba6c-20ef68a8387c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:54","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9981827e-9cd8-4803-ba6c-20ef68a8387c"},{"_id":46565,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:56.222","end":"2025-11-07T14:26:56.222","id_drupal":"337","country":"ecu","theme":"development_planning","original_language":"es","name_es":"Plan Nacional del Buen Vivir 2013-2017 de Ecuador","name_en":"National Plan for Good Living 2013-2017 of Ecuador","responsible_institution":[{"responsible_institution/institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)","responsible_institution/id_institution":"45088","responsible_institution/name_institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)"}],"link":"950cfc0a-9c03-4e65-9ee6-cd27622f3301","primary_link":"https://educacion.gob.ec/wp-content/uploads/downloads/2015/02/Plan-Nacional-para-el-Buen-Vivir-2013-2017.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"Este Plan de Desarrollo es el instrumento de planificación del Ecuador. Se titula “Plan Nacional del Buen Vivir” y su tercera versión, 2013-2017, es la que da los fundamentos sobre los que se basa esta información. Este Plan se sustenta en la noción del Buen Vivir, siendo este algo que \"(...) Se planifica, no se improvisa. El Buen Vivir es la forma de vida que permite la felicidad y la permanencia de la diversidad cultural y ambiental; es armonía, igualdad, equidad y solidaridad\". \n\nEl plan actual está delineado por seis dimensiones básicas: Diversificación productiva y seguridad económica, acceso universal a bienes superiores, equidad social, participación social, diversidad cultural y sustentabilidad . Estas dimensiones se concretan a través de un conjunto de 12 lineamientos estratégicos que, compuestos a su vez por objetivos, expresan la voluntad de continuar con la transformación histórica del Ecuador.","description_en":"This Development Plan is Ecuador’s main planning instrument. Entitled “National Plan for Good Living” (Plan Nacional del Buen Vivir), its third version (2013–2017) provides the foundation on which this information is based. The Plan is grounded in the concept of “Buen Vivir” (Good Living), which “(...) is planned, not improvised. Good Living is a way of life that enables happiness and the preservation of cultural and environmental diversity; it is harmony, equality, equity, and solidarity.”\n\nThe current plan is structured around six core dimensions: productive diversification and economic security, universal access to essential goods, social equity, social participation, cultural diversity, and sustainability. These dimensions are operationalized through twelve strategic guidelines, each composed of specific objectives, reflecting the country’s commitment to advancing Ecuador’s historical transformation.","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:87822d63-a26b-4ed0-bc83-90dbc2808736","meta/deprecatedID":"uuid:95a8361a-e345-4eba-8eb6-abd72c1922f9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"87822d63-a26b-4ed0-bc83-90dbc2808736","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:55","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:87822d63-a26b-4ed0-bc83-90dbc2808736"},{"_id":46566,"start":"2025-11-07T14:26:56.933-03:00","end":"2026-03-09T17:45:15.147-03:00","id_drupal":"447","country":"ecu","theme":"development_planning","original_language":"es","name_es":"\"Plan Nacional de Desarrollo 2017-2021 Toda una Vida\" de Ecuador","name_en":"National Development Plan 2017-2021 \"Toda Una Vida\" of Ecuador","responsible_institution":[{"responsible_institution/institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)","responsible_institution/id_institution":"45088","responsible_institution/name_institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)"}],"link":"3269aa2b-eed9-4544-90b1-e3e24a68498d","primary_link":"https://www.gob.ec/sites/default/files/regulations/2018-10/Plan%20Nacional%20de%20Desarrollo%20Toda%20Una%20Vida%202017%20-%202021.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El \"Plan Nacional de Desarrollo 2017-2021 Toda una Vida\" de Ecuador es el principal instrumento del Sistema Nacional Descentralizado de Planificación Participativa (SNDPP), y su objetivo es contribuir al cumplimiento progresivo de:\n1. Los derechos constitucionales\n2. Los objetivos del régimen de desarrollo y disposiciones del régimen de desarrollo (a través de la implementación de políticas públicas)\n3. Los programas, proyectos e intervenciones que de allí se desprenden\n\nSe enmarca sobre dos pilares que son la sustentabilidad ambiental y el desarrollo territorial equitativo. Se fundamenta en los logros de los últimos 10 años y pone en evidencia la existencia de nuevos retos por alcanzar, en torno a tres ejes principales:\n1. Derechos para todos durante toda la vida.\n2. Economía al servicio de la sociedad.\n3. Más sociedad, mejor Estado, que contienen a su vez tres objetivos nacionales de desarrollo que rompen con la lógica sectorial y dan cuenta de las prioridades que tiene el país. \n\nEsta visión se enmarca, también, en los compromisos internacionales de desarrollo global, como la Agenda 2030 y sus Objetivos de Desarrollo Sostenible.\n\nConforme a la Constitución del Ecuador, en sus artículos 293 y 294, el Plan Nacional de Desarrollo es la guía para políticas, programas y proyectos públicos; la programación y la formulación y ejecución del presupuesto de Estado.","description_en":"Ecuador’s “National Development Plan 2017–2021: Toda una Vida (A Lifetime of Achievements)” is the main instrument of the National Decentralized System for Participatory Planning (SNDPP). Its purpose is to contribute to the progressive fulfillment of:\n1. Constitutional rights;\n2. The objectives and provisions of the development regime, through the implementation of public policies; and\n3. The programs, projects, and interventions derived from these policies.\n\nThe Plan is built upon two pillars: environmental sustainability and equitable territorial development. It draws on the achievements of the past decade while identifying new challenges to be addressed, organized around three main axes:\n1. Rights for all throughout life;\n2. An economy at the service of society;\n3. More society, better State.\n\nThese axes encompass three national development objectives that move beyond a sectoral logic and reflect the country’s strategic priorities.\n\nThis vision is also aligned with international global development commitments, such as the 2030 Agenda and its Sustainable Development Goals (SDGs).\n\nAccording to Articles 293 and 294 of the Constitution of Ecuador, the National Development Plan serves as the guiding framework for public policies, programs, and projects, as well as for budget programming, formulation, and execution.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:5f5fc57a-076c-4317-9537-721b5067af55","meta/deprecatedID":"uuid:5ba79a4f-62f5-445f-894b-6dcda1efb3d9","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5f5fc57a-076c-4317-9537-721b5067af55","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:56","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:5f5fc57a-076c-4317-9537-721b5067af55"},{"_id":46567,"start":"2025-11-07T14:26:57.651-03:00","end":"2026-03-09T17:44:52.661-03:00","id_drupal":"1675","country":"ecu","theme":"development_planning","original_language":"es","name_es":"Plan de Creación de Oportunidades 2021-2025 de Ecuador","name_en":"Opportunity Creation Plan 2021-2025 of Ecuador","responsible_institution":[{"responsible_institution/institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)","responsible_institution/id_institution":"45088","responsible_institution/name_institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)"}],"link":"b4fc5a2c-a934-4ed4-9c79-19a793a355f5","primary_link":"https://www.planificacion.gob.ec/wp-content/uploads/2021/09/Plan-de-Creacio%CC%81n-de-Oportunidades-2021-2025-Aprobado.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de Creación de Oportunidades 2021-2025 es la máxima directriz política y administrativa para el diseño y aplicación de la política pública en Ecuador, a través del cual el Gobierno Nacional ejecutará las propuestas presentadas en el Plan de Gobierno.\n\nEl Plan establece las prioridades del país para el período señalado, en alineación con el Plan de Gobierno 2021-2025 y la Agenda 2030 de Desarrollo Sostenible. Cada una de las políticas planteadas hace referencia a temas de relevancia para el Ecuador; y cuenta con una o más metas asociadas que posibilitará el seguimiento y la evaluación permanente para su cumplimiento.\n\nSe estructura en 5 ejes, 16 objetivos, 55 políticas y 130 metas:\n1. Eje Económico y Generación de Empleo: 4 objetivos, 14 políticas y 38 metas.\n2. Eje Social: 4 objetivos, 20 políticas y 46 metas.\n3. Eje Seguridad Integral: 2 objetivos, 5 políticas y 13 metas.\n4. Eje Transición Ecológica: 3 objetivos, 9 políticas y 17 metas.\n5. Eje Institucional: 3 objetivos, 7 políticas y 16 metas.\n\nEn este documento también se incluye:\n• Evaluación socioeconómica de los efectos de la pandemia causada por el COVID-19.\n• Visión de largo plazo y Escenario deseado a 2030.\n• Estrategia y Modelo Territorial Nacional.","description_en":"The “Plan for the Creation of Opportunities 2021–2025” is Ecuador’s highest political and administrative directive for the design and implementation of public policy, through which the National Government will execute the proposals presented in the Government Plan.\n\nThe Plan defines the country’s priorities for the indicated period, in alignment with the 2021–2025 Government Plan and the 2030 Agenda for Sustainable Development. Each policy addresses issues of national relevance and includes one or more associated targets, enabling continuous monitoring and evaluation of progress.\n\nThe Plan is structured around five pillars, comprising 16 objectives, 55 policies, and 130 targets:\n1. conomic and Employment Generation Pillar: 4 objectives, 14 policies, and 38 targets.\n2. Social Pillar: 4 objectives, 20 policies, and 46 targets.\n3. Comprehensive Security Pillar: 2 objectives, 5 policies, and 13 targets.\n4. Ecological Transition Pillar: 3 objectives, 9 policies, and 17 targets.\n5. Institutional Pillar: 3 objectives, 7 policies, and 16 targets.\n\nThe document also includes:\n• A socioeconomic assessment of the effects of the COVID-19 pandemic.\n• A long-term vision and desired scenario for 2030.\n• A National Territorial Strategy and Model.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_participation":"yes","ipd/ipd_investment":"yes","ipd/ipd_other_instrument":"yes","meta/instanceID":"uuid:2a967ae7-1f78-4d54-b7ad-491dd6065c45","meta/deprecatedID":"uuid:d9c231e5-3952-4e6c-9d5e-af29e77f6336","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2a967ae7-1f78-4d54-b7ad-491dd6065c45","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:56","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2a967ae7-1f78-4d54-b7ad-491dd6065c45"},{"_id":46568,"start":"2025-11-07T14:26:58.810-03:00","end":"2026-03-09T17:46:10.178-03:00","id_drupal":"2237","country":"ecu","theme":"development_planning","original_language":"es","name_es":"Plan de Desarrollo para el Nuevo Ecuador 2024-2025","name_en":"Development Plan for the New Ecuador 2024-2025","responsible_institution":[{"responsible_institution/institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)","responsible_institution/id_institution":"45088","responsible_institution/name_institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)"}],"link":"3543d193-bfd7-405f-9ed8-27c70ec4cbb3","primary_link":"https://www.planificacion.gob.ec/plan-de-desarrollo-para-el-nuevo-ecuador-2024-2025/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo es el máximo instrumento de planificación nacional, en el que se establece la directriz política y administrativa para diseñar e implementar la política pública en Ecuador.","description_en":"The National Development Plan is the highest national planning instrument, which establishes the political and administrative guidelines for designing and implementing public policy in Ecuador.","linking_sdg_plans":"no","ipd/ipd_type":"development","meta/instanceID":"uuid:342525ab-0e78-4437-8c2d-83abcfccee77","meta/deprecatedID":"uuid:06afc098-9b04-4363-be86-d946ed601d01","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"342525ab-0e78-4437-8c2d-83abcfccee77","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:57","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:342525ab-0e78-4437-8c2d-83abcfccee77"},{"_id":46569,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:59.539","end":"2025-11-07T14:26:59.539","id_drupal":"377","country":"hnd","theme":"development_planning","original_language":"es","name_es":"Visión de País 2010–2038 y Plan de Nación 2010‐2022 de Honduras","name_en":"Country Vision 2010–2038 and Nation Plan 2010‐2022 of Honduras","link":"0a012bd3-d41a-4ff3-8094-cd0bcdaa8a17","primary_link":"https://www.tsc.gob.hn/biblioteca/index.php/planes/154-plan-de-nacion","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2010-01-01","validity_applies_until":"yes","effective_until":"2038-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Congreso de la República de Honduras, consciente de la necesidad de dar contexto jurídico e institucional a la permanente aspiración de contar con una Visión de País con un horizonte de planeamiento de largo plazo, inició un camino de preparación que contó con el apoyo de los cinco partidos políticos legalmente inscritos y de sus candidatos Presidenciales.\n\nPor tanto, actualmente Honduras cuenta con tres instrumentos para su planificación. El primero es la Visión de País 2010-2038, que recoge las condiciones de una nación posible, materializada mediante el establecimiento de 17 principios orientadores de desarrollo, cuatro objetivos nacionales y 22 metas de prioridad nacional. El segundo es el Plan de la Nación 2010-2022, que contiene guía de 11 lineamientos estratégicos para alcanzar la Visión de País. Por último, están los Planes de Gobierno, que en períodos de cuatro años materializan el esfuerzo gubernamental por alcanzar metas de corto plazo. \n\nHonduras cuenta con el Sistema de Monitoreo y Evaluación de la Visión de País y el Plan de Nación que se rige por el Decreto Legislativo No. 286-2009. La entidad encargada de coordinar este sistema es el Foro Nacional de Convergencia (FONAC) y se apoya en los indicadores que se hallan definidos según cada uno de los lineamientos estratégicos del plan. ","description_en":"The National Congress of the Republic of Honduras, aware of the need to provide a legal and institutional framework to the country’s long-standing aspiration of having a long-term national vision, initiated a preparatory process that involved the participation and support of all five legally registered political parties and their presidential candidates.\n\nAs a result, Honduras currently has three key planning instruments:\n1. Vision of the Country 2010–2038, which outlines the conditions for a possible nation, articulated through 17 guiding development principles, four national objectives, and 22 national priority targets.\n2. National Plan 2010–2022, which establishes 11 strategic guidelines to achieve the Vision of the Country.\n3. Government Plans, developed every four years, which operationalize the government’s short-term efforts to achieve the defined goals.\n\nHonduras also has a Monitoring and Evaluation System for the Vision of the Country and the National Plan, established under Legislative Decree No. 286-2009. This system is coordinated by the National Convergence Forum (FONAC) and is supported by a set of indicators defined according to each of the strategic guidelines of the plan.","linking_sdg_plans":"no","ipd/ipd_vision_es":"Honduras plasma su visión de forma detallada en su documento Visión de País 2010-2038, donde explica que los fundamentos de la Visión de País que se recogen, reconocen que la Constitución de la República manda que el Estado promueva el desarrollo integral del país, en lo económico y en lo social, debiendo estar sujeto a una planificación estratégica que exige la participación de los Poderes del Estado y las organizaciones políticas, económicas y sociales, en una formulación incluyente y participativa.","ipd/ipd_vision_en":"Honduras articulates its vision in detail in the Vision of the Country 2010–2038 document, which underscores that the foundations of this vision recognize the constitutional mandate requiring the State to promote the country’s integral economic and social development through strategic planning. This planning process must ensure the inclusive and participatory involvement of the branches of government and of political, economic, and social organizations.","ipd/ipd_type":"vision","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ce442d31-00fc-4de8-a25b-ed32d7408bbe","meta/deprecatedID":"uuid:bf863c13-56e1-49b9-b75b-85c6b89b5b7f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ce442d31-00fc-4de8-a25b-ed32d7408bbe","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:58","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ce442d31-00fc-4de8-a25b-ed32d7408bbe"},{"_id":46570,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:00.254","end":"2025-11-07T14:27:00.254","id_drupal":"1576","country":"grd","theme":"development_planning","original_language":"en","name_es":"Plan Nacional de Desarrollo Sostenible 2020-2035 de Granada","name_en":"National Sustainable Development Plan 2020-2035 Grenada","responsible_institution":[{"responsible_institution/institution":"Ministerio de Finanzas de Granada","responsible_institution/id_institution":"45427","responsible_institution/name_institution":"Ministerio de Finanzas de Granada"}],"link":"16a868d3-965f-44f8-9b5c-b11c75f0ba20","primary_link":"https://www.finance.gd/docs/NSDP2020-2035-FVi.pdf#:~:text=The%20National%20Sustainable%20Development%20Plan%20(NSDP)%20is,guide%20Grenada's%20strategic%20priorities%20for%20balanced%20and.","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2035-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo Sostenible de Granada 2020-2035 establece la visión para el desarrollo sostenible del país y su transformación a largo plazo.\n\nEste Plan proporciona una dirección estratégica para guiar al Estado de las Tres Islas hacia el logro de la Visión 2035 y, como tal, propone soluciones localizadas orientadas a mejorar de manera fundamental la forma en que los granadinos viven, trabajan, interactúan con el entorno natural y se relacionan con las instituciones. El Plan está firmemente basado en la realidad de Granada y se construye sobre las aspiraciones de su población.\n\nSe ha formulado mediante un diálogo amplio, extenso e intensivo con los granadinos de todos los ámbitos.\n\nEl enfoque estratégico del NSDP 2020-2035 se centra en tres pilares del desarrollo sostenible: sociedad, economía y medio ambiente. En consecuencia, la Visión 2035 se traduce en los siguientes tres Objetivos Nacionales:\n• Objetivo 1: Alto desarrollo humano y social: poniendo a las personas en el centro del desarrollo sostenible y la transformación.\n• Objetivo 2: Economía vibrante, dinámica y competitiva con infraestructura resiliente al clima y a desastres.\n• Objetivo 3: Sostenibilidad y seguridad ambiental.\n\nLos Objetivos Nacionales se relacionan con ocho Resultados Nacionales, los cuales representan mejoras o cambios positivos en instituciones, sistemas, comunidades, comportamientos, condiciones de vida o conocimientos.\n\nCada Resultado Nacional está vinculado a los Objetivos de Desarrollo Sostenible (ODS) correspondientes.\n\n*Resultados Nacionales:*\n1. Población saludable\n2. Ciudadanos educados, productivos, altamente capacitados, entrenados y conscientes\n3. Sociedad resiliente, inclusiva, sensible al género y pacífica\n4. Crecimiento económico amplio, inclusivo, sostenible y transformador\n5. Entorno empresarial competitivo\n6. Infraestructura moderna, resiliente al clima y a desastres\n7. Resiliencia climática y reducción del riesgo ante peligros\n8. Seguridad y eficiencia energética\n\nPara alcanzar cada resultado, el Plan establece un total de 217 acciones estratégicas distribuidas entre los ocho resultados y los tres objetivos.","description_en":"Grenada's National Sustainable Development Plan 2020-2035 sets out the vision for the country's sustainable development and long-term transformation.\n\nThis Plan provides strategic direction to steer the Tri-island State towards achieving Vision 2035 and as such, it puts forward localised solutions thar are aimed at fundamentally improving the way Grenadians live, work, treat natural environment and interact with institutions. The Plan is firmly grounded in Grenadian realities and it is built on the aspirations of the Grenadian people.\n\nIt has been formulated on broad-based extensive and intensive dialogue with Grenadians across all spheres.\n\nThe strategic focus of the NSDP 2020-2035 rests on the tree sustainable development pillars: society, economy and environment. Accordingly, Vision 2035 is translated into the following three National Goals:\n• Goal 1: High human and social development: putting people at the center of sustainable development and transformation.\n• Goal 2: Vibrant, dynamic, competitive economy with supporting climate and disaster resilient infrastructure. \n• Goal 3: Environmental sustainability and security.\n\n The National Goals are mapped into eight National Outcomes, which are improvements or positive changes in institutions, systems, communities, behaviors, living conditions or knowledge.\n\n Each National Outcome is linked to relevant Sustainable Development Goals (SDGs).\n\n*The National Outcomes are:*\n1. A healthy populations\n​​​​​​​2. Educated, productive, highly-skilled, trained and conscious citizens\n3. A resilient, inclusive gender-sensitive and peaceful society\n4. Broad-based, inclusive and sustainable economic growth and transformation\n​​​​​​​5. Competitive business environment\n​​​​​​​6. Modern climate and disaster resilient infrastructure\n​​​​​​​7. Climate resilience and hazard risk reduction\n​​​​​​​8. Energy security and efficiency\n\nTo achieve each outcome the Plan sets out a total of 217 strategic actions that are spread across the eight outcomes and three goals.","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:897210f1-a06a-4c11-97a8-2f73db9d976f","meta/deprecatedID":"uuid:98a5da27-ea86-4308-82f7-b6e5db107bc8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"897210f1-a06a-4c11-97a8-2f73db9d976f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:59","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:897210f1-a06a-4c11-97a8-2f73db9d976f"},{"_id":46571,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:00.981","end":"2025-11-07T14:27:00.982","id_drupal":"3000","country":"grd","theme":"development_planning","original_language":"en","name_es":"Plan de Acción a Mediano Plazo 2022-2024","name_en":"Medium Term Action Plan 2022-2024","responsible_institution":[{"responsible_institution/institution":"Ministerio de Finanzas de Granada","responsible_institution/id_institution":"45427","responsible_institution/name_institution":"Ministerio de Finanzas de Granada"}],"link":"a5c8b85e-336f-411a-ac47-2eb413792b67","primary_link":"https://www.finance.gd/FinalMTAP2022-2024.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción a Mediano Plazo 2022-2024 de Granada es el instrumento operativo diseñado para implementar el Plan Nacional de Desarrollo Sostenible 2020-2035. Este plan establece prioridades estratégicas para el desarrollo sostenible del país durante el periodo 2022-2024, alineadas con los Objetivos de Desarrollo Sostenible.\n\nEl MTAP proporciona dirección estratégica para el sector público, orientando acciones concretas en áreas clave como economía, sociedad, medio ambiente, salud, equidad, resiliencia y recuperación post-pandemia. Incluye diagnósticos del contexto socioeconómico, programas y proyectos específicos, responsables de su ejecución, indicadores de seguimiento y un marco de monitoreo basado en resultados. Además, contempla la gestión de riesgos asociados a su implementación, como desastres naturales o limitaciones institucionales.\n\nEn conjunto, el MTAP conecta la visión de largo plazo del desarrollo sostenible con acciones concretas de mediano plazo, asegurando coherencia, participación y alineación con la agenda nacional y los ODS, garantizando un desarrollo integral y sostenible para el país.","description_en":"The Medium-Term Action Plan (MTAP) 2022-2024 of Grenada is the operational instrument designed to implement the National Sustainable Development Plan 2020-2035. The plan sets strategic priorities for sustainable development over the 2022-2024 period, aligned with the Sustainable Development Goals.\n\nThe MTAP provides strategic direction for the public sector, guiding concrete actions in key areas such as the economy, society, environment, health, equity, resilience, and post-pandemic recovery. It includes diagnostics of the socio-economic context, specific programs and projects, responsible entities, monitoring indicators, and a results-based monitoring framework. It also addresses risk management related to implementation, including natural disasters and institutional limitations.\n\nOverall, the MTAP bridges the long-term vision of sustainable development with medium-term concrete actions, ensuring coherence, stakeholder participation, and alignment with the national agenda and SDGs, promoting integrated and sustainable development across the country.","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:6e4b0f25-7615-43c0-8e2f-a50132891cbd","meta/deprecatedID":"uuid:6b277ecf-1ffe-48c9-85ff-ff8e425a3231","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6e4b0f25-7615-43c0-8e2f-a50132891cbd","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:00","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:6e4b0f25-7615-43c0-8e2f-a50132891cbd"},{"_id":46572,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:01.712","end":"2025-11-07T14:27:01.712","id_drupal":"355","country":"gtm","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo: K'atun Nuestra Guatemala 2032","name_en":"National Development Plan: K'atun Nuestra Guatemala 2032","responsible_institution":[{"responsible_institution/institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala","responsible_institution/id_institution":"45131","responsible_institution/name_institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala"}],"link":"2474d3c3-5d1d-4760-831d-6f937a376c67","primary_link":"https://portal.segeplan.gob.gt/segeplan/wp-content/uploads/2022/08/GuatemalaPlanNacionaldeDesarrollo2032.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2032-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo: \"K’atun, Nuestra Guatemala 2032\" constituye la política nacional de desarrollo de largo plazo, que articula las políticas, planes, programas, proyectos e inversiones en el país. \n\nEl Plan se formuló en el seno del Consejo Nacional de Desarrollo Urbano y Rural (Conadur), entidad que asume, de esta manera, el rol que le corresponde en cumplimiento del mandato constitucional de organizar y coordinar la administración pública mediante la formulación de políticas de desarrollo, planes y programas presupuestarios, y mediante el impulso de la coordinación interinstitucional, pública y privada.\n\nCon tales fines, el Conadur integró la Comisión de Formulación y Seguimiento del Plan Nacional de Desarrollo: K’atun, Nuestra Guatemala 2032, e instruyó a la Secretaría de Planificación y Programación de la Presidencia (Segeplán) para que asesorara y acompañara técnicamente el proceso. \n\nSu nombre proviene de la cosmovisión maya, en donde un K'atun correspondía al lapso de tiempo en el que concurría  el proceso de edificación de una gestión. Esta forma de medir el tiempo se basó en un profundo conocimiento de la astronomía que luego se aplicó a la cotidianidad. Al inicio y al final de cada k’atun, los gobernantes mayas presentaban resultados de sus logros.\n\nLo anterior intenta ser rescatado por este plan. A través de este instrumento los guatemaltecos y guatemaltecas sientan las bases de un nuevo proceso de gestión, delineando un futuro común que consiga un desarrollo sostenido de aquí al 2032.\n\nEl Plan establece cinco ejes prioritarios:\n1.Guatemala urbana y rural\n2.Bienestar para la gente\n3.Riquezas para todos y para todas\n4.Recursos naturales para hoy y para el futuro\n5.Estado garante de los derechos humanos y conductor del desarrollo\n\nEstos 5 ejes dirigen la formulación de todas las políticas públicas, el gasto fiscal, y la orientación geográfica y sectorial de la inversión pública y privada.\n\nEl del plan K’atun 2030 de Guatemala, también posee un sistema de seguimiento, monitoreo y evaluación, siendo el CONADUR la entidad encargada de coordinarlo. La cualidad estratégica de este plan de desarrollo, se tradujo en la inclusión de indicadores en los distintos niveles y ámbitos de la planificación nacional. Asimismo, el país definió tres tipos de indicadores: de proceso, de resultado y de impacto.\n\nEl sustento jurídico de este sistema de seguimiento se lo otorga el Decreto No.11-2002: \"Ley de Consejos de Desarrollo Urbano y Rural\" (artículo 6). ","description_en":"The National Development Plan: “K’atun, Our Guatemala 2032” constitutes the long-term national development policy that articulates the country’s policies, plans, programs, projects, and investments.\n\nThe Plan was formulated within the National Council for Urban and Rural Development (Conadur), the entity responsible for fulfilling the constitutional mandate to organize and coordinate public administration through the formulation of development policies, plans, and budgetary programs, and by promoting inter-institutional coordination among public and private actors.\n\nTo this end, Conadur established the Commission for the Formulation and Monitoring of the National Development Plan: K’atun, Our Guatemala 2032, and instructed the Secretariat for Planning and Programming of the Presidency (Segeplán) to provide technical advice and support throughout the process.\n\nIts name derives from the Mayan worldview, in which a k’atun represented a time period used to build a management process. This measurement of time was based on deep astronomical knowledge later applied to daily life. At the beginning and end of each k’atun, Mayan rulers would present the results of their achievements.\n\nThis tradition is symbolically revived in the plan, through which Guatemalans lay the foundations for a new management process—shaping a shared future aimed at achieving sustainable development by 2032.\n\nThe Plan defines five priority axes:\n1. Urban and rural Guatemala\n2. Well-being for the people\n3. Wealth for all\n4. Natural resources for today and the future\n5. A state that guarantees human rights and leads development\n\nThese five axes guide the formulation of all public policies, fiscal expenditure, and the geographic and sectoral allocation of public and private investment.\n\nThe K’atun 2032 Plan also includes a monitoring, follow-up, and evaluation system coordinated by Conadur. Its strategic nature is reflected in the inclusion of indicators across different levels and areas of national planning. The country defined three types of indicators: process, outcome, and impact.\n\nThe legal basis for this monitoring system is established in Decree No. 11-2002, the Law of Urban and Rural Development Councils (Article 6).","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Visión común de país, un sueño compartido, con confianza en un futuro diferente y mejor. Considera la diversidad como fuente de riqueza para la construcción de relaciones de convivencia intercultural y el afincamiento de una cultura de paz. Las personas y sus particularidades, devenidas de la condición, posición y situación sociocultural, económica y política a la que pertenecen\".","ipd/ipd_vision_en":"\"A shared national vision, a common dream grounded in confidence in a different and better future. It recognizes diversity as a source of richness for building intercultural coexistence and fostering a culture of peace. It places people and their specific conditions—stemming from their sociocultural, economic, and political contexts—at the center of development.\"","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0f2073c5-22d0-44d2-af30-f2727d1360bd","meta/deprecatedID":"uuid:4421a04c-3be1-4d89-acaf-75f5f31e9d2f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0f2073c5-22d0-44d2-af30-f2727d1360bd","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:00","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0f2073c5-22d0-44d2-af30-f2727d1360bd"},{"_id":46573,"start":"2025-11-07T14:27:02.466-04:00","end":"2026-04-08T09:11:18.375-04:00","id_drupal":"697","country":"blz","theme":"urban_development","original_language":"en","name_es":"Plan Maestro de Ciudad de Belice","name_en":"City Master Plan of Belize","responsible_institution":[{"responsible_institution/institution":"Consejo de la Ciudad de Belice","responsible_institution/id_institution":"44947","responsible_institution/name_institution":"Consejo de la Ciudad de Belice"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","validity_applies_from":"yes","effective_since":"2010-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Proyecto del Plan Maestro de la Ciudad de Belice, una Cooperación Técnica entre el Gobierno de Belice y el Banco Interamericano de Desarrollo, se estableció en septiembre de 2010 para responder a estas preguntas:\n\n¿Qué tipo de ciudad queremos habitar en los próximos 20 a 30 años?\n¿Qué necesitamos hacer para llegar allí?\n\nAhora es el momento de responder a estas preguntas, especialmente con proyectos complementarios que ya se están implementando, como el Programa RESTORE Belize, la Visión Horizonte 2030, entre otros.","description_en":"The Belize City Master Plan Project, a Technical Cooperation between the Government of Belize and the Inter-American Development Bank, set out in the September 2010, to answer these questions:\n\nWhat type of City do we want to live in, in the next 20 to 30 years?\nWhat do we need to do to get there?\nNow, is the time to answer these questions, especially with complimentary projects already being implemented such as the RESTORE Belize Program, the Horizon 2030 Vision, amongst others.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:12a7c161-fdc6-422d-bda3-39deb86ad345","meta/deprecatedID":"uuid:8acf60ca-90ca-4ee1-a0e3-130acac67737","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"12a7c161-fdc6-422d-bda3-39deb86ad345","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:12a7c161-fdc6-422d-bda3-39deb86ad345"},{"_id":46574,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:03.311","end":"2025-11-07T14:27:03.311","id_drupal":"1722","country":"guy","theme":"development_planning","original_language":"en","name_es":"Estrategia de Desarrollo de Bajas Emisiones de Carbono de Guyana 2030","name_en":"Guyana’s Low Carbon Development Strategy 2030 of Guyana","responsible_institution":[{"responsible_institution/institution":"Oficina del Presidente de Guyana","responsible_institution/id_institution":"45409","responsible_institution/name_institution":"Oficina del Presidente de Guyana"}],"link":"26c129c9-0a77-436d-ac0d-5e7feb67d8b3","primary_link":"https://lcds.gov.gy/wp-content/uploads/2022/08/Guyanas-Low-Carbon-Development-Strategy-2030.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La nueva Estrategia de Desarrollo Bajo en Carbono 2030 (Low Carbon Development Strategy, LCDS 2030) creará una economía baja en carbono en Guyana mediante el establecimiento de incentivos que valoren los servicios ecosistémicos del mundo y promoviendo estos como un componente esencial de un nuevo modelo de desarrollo global con la sostenibilidad como núcleo central.\n\nLa Estrategia fue respaldada mediante la Resolución Parlamentaria No. 45 en agosto de 2022.\n\nLa implementación de la LCDS 2030 impulsará el progreso hacia los Objetivos de Desarrollo Sostenible de la ONU y los acuerdos multilaterales, regionales y bilaterales de Guyana dentro de las áreas temáticas de cada programa. De hecho, la LCDS está alineada con todos los ODS en diversos grados. Esta alineación se incorporará a la planificación a nivel sectorial y se integrará dentro de la programación institucional a nivel gubernamental.\n\nObjetivos principales de la LCDS 2030:\n1. Crear nuevos incentivos para una economía baja en carbono\n2. Proteger frente al cambio climático y la pérdida de biodiversidad\n3. Estimular el crecimiento futuro: energía limpia y desarrollo bajo en carbono\n4. Alinear con los objetivos globales de clima y biodiversidad","description_en":"The new Low Carbon Development Strategy 2030 will create a new-low-carbon economy in Guyana by establishing incentives which value the world’s ecosystem services, and promoting these as an essential component of a new model of global development with sustainability at its core.\n\nThe Strategy was endorsed by Parliamentary Resolution NO.45. in August 2022.\n\nImplementing LCDS 2030 will advance progress towards the UN Sustainable Development Goals, and Guyana’s multilateral, regional and bilateral agreements within the thematic areas of each programme. In fact, the LCDS is aligned to all SDGs to varying degrees. This alignment will feed into sector level planning and will be integrated within institutional programming at Governmental level.\n\nLCDS 2030 main goals:\n1. Create New Incentives for a Low-Carbon Economy\n2. Protect against Climate Change and Biodiversity Loss\n3. Stimulate Future Growth: Clean Energy and Low-carbon Development\n4. Align with Global Climate and Biodiversity Goals","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_participation":"yes","ipd/ipd_investment":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f3a96b4d-39a4-497e-a2e0-d43937498fa8","meta/deprecatedID":"uuid:aad23c45-fecd-44e9-b042-6dacf218ff97","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f3a96b4d-39a4-497e-a2e0-d43937498fa8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:02","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f3a96b4d-39a4-497e-a2e0-d43937498fa8"},{"_id":46575,"start":"2025-11-07T14:27:04.045-03:00","end":"2026-04-08T09:09:43.529-04:00","id_drupal":"868","country":"bhs","theme":"urban_development","original_language":"en","name_es":"Planes de Uso del Suelo de Bahamas","name_en":"Land Use Plans of Bahamas","responsible_institution":[{"responsible_institution/institution":"Ministerio de Obras Públicas de las Bahamas","responsible_institution/id_institution":"45177","responsible_institution/name_institution":"Ministerio de Obras Públicas de las Bahamas"}],"link":"0fa9eefd-0304-4a24-874f-f8ad4fd28a72","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Islas y Distritos","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"De acuerdo con la *Ley de Planificación y Subdivisión (2010)*, debe existir un Plan de Uso del Suelo para cada isla de Las Bahamas, consistente con todas las Políticas Nacionales de Desarrollo y Uso del Suelo, el cual deberá ser elaborado por el Departamento o para este, y deberá:\n\n(a) Incluir declaraciones escritas respecto a los objetivos, metas y políticas de uso del suelo establecidas principalmente para gestionar y dirigir los cambios físicos y sus efectos sobre el entorno social, económico y natural, así como otros asuntos que puedan ser prescritos;\n(b) Contener designaciones de uso del suelo para asignar terrenos a fines residenciales, industriales, comerciales, agrícolas, de conservación, institucionales, recreativos, turísticos y otros propósitos especificados en el plan;\n(c) Designar áreas que, por razones de inundaciones, erosión, subsidencia, inestabilidad, seguridad aérea, otros peligros, conservación u otras consideraciones ambientales, incluyendo humedales, no deben ser desarrolladas;\n(d) Definir la ubicación de las vías existentes y planificadas y los corredores de servicios públicos, incluyendo un sistema jerárquico de carreteras;\n(e) Contener políticas para prevenir y minimizar los conflictos de uso del suelo entre actividades incompatibles, incluyendo los conflictos asociados con el desarrollo residencial que invade operaciones agrícolas o ganaderas preexistentes;\n(f) Incluir mapas, cronogramas, tablas y material descriptivo que sea necesario para ilustrar las declaraciones escritas con el grado de detalle apropiado;\n(g) Prever el desarrollo de infraestructura, edificios públicos, espacios abiertos y otras obras de inversión del sector público;\n(h) Prever la preservación de edificios, sitios y otros elementos por razones arquitectónicas, culturales o históricas; y\n(i) Contener otros asuntos que el Ministro pueda indicar.","description_en":"According to the the *Planning and Subdivision Act  (2010)*, there shall be a Land Use Plan for each island of The Bahamas, consistent with all National Land Use Development Policies, which shall be prepared by or for the Department and should to:\n\n(a) Include written statements in respect of goals, objectives and land use policy established primarily to manage and direct physical change and the effects on the social, economic and natural environment and such other matters as may be prescribed; \n(b) Contain land use designations to allocate land for residential, industrial, commercial, agricultural, conservation, institutional, recreational, tourism and other purposes as specified in the plan;\n(c) Designate areas which, for reasons of flooding, erosion, subsidence, instability, aircraft safety, other hazards, conservation or other environmental considerations including wetlands, should not be developed; \n(d) Define the location of existing and planned roads and utility corridors including a road hierarchy system;\n(e) Contain policies to prevent and minimize the occasion of land use conflicts between incompatible activities including the conflicts associated with residential development encroaching on preexisting agricultural livestock operations;\n(f) Include such maps, schedules, tables and descriptive matter as may be necessary to illustrate the written statements with such degree of particularity as may be appropriate; \n(g) Make provision for the development of infrastructure, public buildings, open spaces and other public sector investment works; \n(h) Make provision for the preservation of buildings, sites and other features for architectural, cultural or historical reasons; and,\n(i) Contain such other matters as the Minister may direct.","linking_sdg_plans":"yes","sdg":"sdg_9 sdg_11","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley de Planificación y Subdivisión (2010) de Bahamas","link_block/legal_id":"49594","link_block/legal_name":"Ley de Planificación y Subdivisión (2010) de Bahamas"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:7e39d5d6-4ac4-4c15-bde7-a2c54b1a1e79","meta/deprecatedID":"uuid:fef4ee18-d268-4161-8323-9eaccc66004f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7e39d5d6-4ac4-4c15-bde7-a2c54b1a1e79","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7e39d5d6-4ac4-4c15-bde7-a2c54b1a1e79"},{"_id":46576,"start":"2025-11-07T14:27:04.793-03:00","end":"2026-04-08T09:10:05.693-04:00","id_drupal":"869","country":"bhs","theme":"urban_development","original_language":"en","name_es":"Planes Secundarios de Bahamas","name_en":"Secondary Plans of Bahamas","responsible_institution":[{"responsible_institution/institution":"Ministerio de Obras Públicas de las Bahamas","responsible_institution/id_institution":"45177","responsible_institution/name_institution":"Ministerio de Obras Públicas de las Bahamas"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Islas y Distritos","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"De acuerdo con la *Ley de Planificación y Subdivisión (2010)*, los Plane Secundarios deberán elaborarse para las Áreas de Planificación Secundaria definidas en un Plan de Uso del Suelo con el fin de:\n\n(a) Asegurar una mejor planificación y regeneración de áreas seleccionadas;\n(b) Proporcionar un proceso y un marco para abordar los problemas de planificación que afectan o caracterizan áreas específicas;\n(c) Fortalecer las áreas ya desarrolladas y facilitar, cuando sea deseable, un rediseño adecuado y ordenado;\n(d) Asegurar el desarrollo ordenado, eficiente y apropiado de grandes extensiones de terreno vacío o subutilizado;\n(e) Garantizar que las características deseables de un área sean protegidas y mejoradas.","description_en":"According to the *Planning and Subdivision Act (2010)*, the Secondary Plans shall be prepared for Secondary Planning Areas defined in a Land Use Plan in order to\n\n(a) Ensure the better planning and regeneration of selected areas;\n(b) Provide a process and a framework for addressing planning issues affecting or characterizing specific areas; \n(c) Strengthen existing developed areas and to facilitate, where desirable, appropriate and orderly redevelopment;\n(d) Ensure the orderly, efficient and appropriate development of large tracts of vacant or underutilized land;\n(e) Ensure that desirable characteristics of an area are protected and enhanced.","linking_sdg_plans":"yes","sdg":"sdg_9 sdg_11","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley de Planificación y Subdivisión (2010) de Bahamas","link_block/legal_id":"49594","link_block/legal_name":"Ley de Planificación y Subdivisión (2010) de Bahamas"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:b6d86582-19f0-4d81-b466-717651d2a4ea","meta/deprecatedID":"uuid:f3e8ab23-d8e9-4983-ab7e-d69d77fc2f24","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b6d86582-19f0-4d81-b466-717651d2a4ea","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b6d86582-19f0-4d81-b466-717651d2a4ea"},{"_id":46577,"start":"2025-11-07T14:27:05.527-04:00","end":"2026-04-08T09:16:43.759-04:00","id_drupal":"877","country":"dma","theme":"urban_development","original_language":"en","name_es":"Planes de Áreas Locales de Dominica","name_en":"Local Area Plans of Dominica","responsible_institution":[{"responsible_institution/institution":"Parroquias de Dominica","responsible_institution/id_institution":"45450","responsible_institution/name_institution":"Parroquias de Dominica"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"De acuerdo con la Política Nacional de Uso del Suelo, la planificación adecuada, la ubicación y la provisión de infraestructura deben realizarse antes del desarrollo de nuevas áreas de asentamiento. Esto se llevará a cabo mediante Planes de Área Local, que son los instrumentos que definen los límites físicos de las parroquias y garantizan la existencia de instalaciones y servicios comunitarios adecuados.\n\nAdemás, los Planes de Área Local deben identificar los impactos o impactos potenciales del cambio climático e indicar las medidas de adaptación correspondientes.\n\nAlgunos ejemplos de Planes de Área Local son:\n• Plan de Desarrollo de Roseau\n• Plan de Uso del Suelo del Área Noreste\n• Plan de Pont Casse y sus Alrededores\n• Plan de Portsmouth y Cotton Hill\n• Plan del Territorio Carib","description_en":"In accordance with the National Land Use Policy proper planning, siting, and infrastructure provision shall occur prior to development of new settlement areas. This shall take the form of Local Area Plans, which are the instruments that defines the parishes physical boundaries and guarantees the adequate community facilities and amenities. \n\nMoreover, Local Area Plans should identify the impacts/potential impacts of climate change and identify adaptation measures.  \n\nSome examples of Local Area Plans are: \n• Roseau Development Plan\n• Northeast Area Land Use Plan\n•  Pont Casse and Environs Plan\n• Portsmouth and Cotton Hill Plan\n•  Carib Territory Area Plan","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:d983b0d3-ef86-4828-b1fc-957646b8f8e9","meta/deprecatedID":"uuid:b63c3031-5e7f-413a-acf1-b8164d2aff90","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d983b0d3-ef86-4828-b1fc-957646b8f8e9","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:04","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d983b0d3-ef86-4828-b1fc-957646b8f8e9"},{"_id":46578,"start":"2025-11-07T14:27:06.249-04:00","end":"2026-04-08T09:18:38.896-04:00","id_drupal":"891","country":"guy","theme":"urban_development","original_language":"en","name_es":"Esquema de Planificación Urbana de Guyana","name_en":"Town Planning Scheme of Guyana","responsible_institution":[{"responsible_institution/institution":"Consejos Municipales de Guyana","responsible_institution/id_institution":"45040","responsible_institution/name_institution":"Consejos Municipales de Guyana"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"Este Esquema es un instrumento de planificación que puede aplicarse a áreas urbanas o rurales, con el fin de garantizar una urbanización adecuada, vías de comunicación, servicios públicos, equipamientos y promover la conservación y el desarrollo natural del área especificada. Es aprobado por el Ministerio de Gobierno Local y Desarrollo Regional.","description_en":"This Scheme is a planning instrument that could refers to urban or rural areas, in order to ensure adequate urbanization, roads, public services, amenities and to promote the natural conservation and development of the specified area. It is approved by the Ministry of Local Government & Regional Development.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:a0850d92-0d8b-4f30-a24c-01999686d55f","meta/deprecatedID":"uuid:985848fa-2d09-403a-8251-cdf38c4f8d06","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a0850d92-0d8b-4f30-a24c-01999686d55f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:05","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a0850d92-0d8b-4f30-a24c-01999686d55f"},{"_id":46579,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:07.238","end":"2025-11-07T14:27:07.238","id_drupal":"909","country":"tto","theme":"urban_development","original_language":"en","name_es":"Plan de Desarrollo de Trinidad y Tobago","name_en":"Development plan of Trinidad and Tobago","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Desarrollo Urbano de Trinidad y Tobago","responsible_institution/id_institution":"45448","responsible_institution/name_institution":"Ministerio de Vivienda y Desarrollo Urbano de Trinidad y Tobago"}],"instrument_type":"plan","territorial_scale":"subnational","validity_applies_from":"yes","effective_since":"1990-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"De acuerdo con la Ley de Planificación Urbana y Rural, el plan de desarrollo debe:\n(a) definir los sitios de las carreteras propuestas, edificios y obras públicas y de otro tipo, aeródromos, parques, áreas recreativas, reservas naturales y otros espacios abiertos;\n(b) asignar áreas de terreno para su uso agrícola, residencial, industrial u otros fines de cualquier tipo especificado en el plan;\n(c) designar tierras sujetas a expropiación obligatoria por parte del Ministro.","description_en":"According to the Town and Country Planning Act, the development plan should: \n(a) define the sites of proposed roads, public and other buildings and works, airfields, parks, pleasure grounds, nature reserves and other open spaces;\n(b) allocate areas of land for use for agricultural, residential, industrial or other purposes of any class specified in the plan;\n(c) designate, as land subject to compulsory acquisition by the Minister","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:490a2e81-2883-4d7d-a3a0-a523ddf476c5","meta/deprecatedID":"uuid:af301505-bee2-428d-bcf4-d6eab3b7effa","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"490a2e81-2883-4d7d-a3a0-a523ddf476c5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:490a2e81-2883-4d7d-a3a0-a523ddf476c5"},{"_id":46580,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:08.136","end":"2025-11-07T14:27:08.136","id_drupal":"734","country":"hnd","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico de Gobierno 2018-2022 de Honduras","name_en":"Strategic Government Plan 2018-2022 of Honduras","responsible_institution":[{"responsible_institution/institution":"Secretaría de Coordinación General de Gobierno de Honduras","responsible_institution/id_institution":"45036","responsible_institution/name_institution":"Secretaría de Coordinación General de Gobierno de Honduras"}],"link":"810c67c2-616d-4e49-ad16-55e0ea7a4329","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Estratégico de Gobierno (PEG), 2018-2022 servirá de herramienta de planificación, de mediano plazo, para avanzar en el cumplimiento de los objetivos y metas nacionales de la Visión de País (2010-2038), y los lineamientos e indicadores del Plan de Nación (2010-2022).\n\nEl documento comprende cinco capítulos, que integran los objetivos y resultados esperados, con carácter mandatorio para el periodo 2018-2021, e indicativo para 2022, para igual número de sectores: \n1. Bienestar y Desarrollo Social; \n2. Crecimiento Económico Incluyente y Sostenible;\n3. Infraestructura y Desarrollo Logístico; \n4. Sociedad más Justa, Pacifica e Inclusiva; y, \n5. Gobernabilidad Democrática y Desarrollo. \n\nAdemás, incluye un capítulo en el cual se abordan cuatro temas transversales: \n• Promoción y Respeto de los Derechos Humanos; \n• Seguridad Alimentaria y Nutricional; \n• Protección y Conservación del Medio Ambiente; y, \n• Desarrollo Territorial.","description_en":"The Strategic Government Plan (PEG) 2018–2022 serves as a medium-term planning tool to advance progress toward the national objectives and targets established in the Vision of the Country (2010–2038) and the guidelines and indicators set forth in the National Plan (2010–2022).\n\nThe document is composed of five chapters, which integrate the objectives and expected results that are mandatory for the 2018–2021 period and indicative for 2022, covering the following five sectors:\n1. Social Welfare and Development\n2. Inclusive and Sustainable Economic Growth\n3. Infrastructure and Logistics Development\n4. A More Just, Peaceful, and Inclusive Society\n5. Democratic Governance and Development\n\nAdditionally, the plan includes a chapter addressing four cross-cutting themes:\n• Promotion and respect for human rights\n• Food and nutritional security\n• Environmental protection and conservation\n• Territorial development","linking_sdg_plans":"no","ipd/ipd_type":"government","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:6a955fe3-017c-4561-a00c-eb652785b1fb","meta/deprecatedID":"uuid:108a0063-9490-4cd0-99b8-79e682948ccb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6a955fe3-017c-4561-a00c-eb652785b1fb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:6a955fe3-017c-4561-a00c-eb652785b1fb"},{"_id":46581,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:08.842","end":"2025-11-07T14:27:08.842","id_drupal":"1719","country":"hnd","theme":"development_planning","original_language":"es","name_es":"Plan de Gobierno para Refundar Honduras 2022-2026 de Honduras","name_en":"Government Plan to Refound Honduras 2022-2026","link":"24f51511-ae9d-4f81-a05f-796a05e0cc42","primary_link":"https://observatorioplanificacion.cepal.org/sites/default/files/plan/files/PLAN-DE-GOBIERNO-XIOMARA-CASTRO_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"En este plan Honduras traza el camino para la construcción de un socialismo democrático y de un país con fuerza de voluntad ciudadana, popular y libre. El documento busca poner las ideas y acciones en orden lógico y concatenado. Este busca responder a las preguntas: ¿hacia dónde vamos? ¿Qué queremos? \n\nSus principales líneas de acción son:\n1. Estado socialista democrático\n2. Derechos humanos\n3. Lucha contra la corrupción\n4. Salud\n5. Educación\n6. Seguridad ciudadana\n7. Migración\n8. Género\n9. Desarrollo agropecuario y seguridad alimentaria\n10. Medio Ambiente\n11. Desarrollo industrial\n12. Turismo\n13. Política fiscal\n14. Inversión pública\n15. Relaciones internacionales\n16. Ciencia y tecnología\n17. Estado abierto y república digital\n18. Adulto mayor\n19. Discapacidad\n20. Niñez y juventud\n21. Pueblos indígenas y afrodescendientes\n22. Personas LGBTIQ+","description_en":"In this plan, Honduras outlines the path toward building a democratic socialism and a nation driven by citizen, popular, and free will. The document aims to organize ideas and actions in a logical and coherent framework, addressing fundamental questions such as: Where are we going? and What do we want?\n\nIts main lines of action are as follows:\n1. Democratic socialist state\n2. Human rights\n3. Fight against corruption\n4. Health\n5. Education\n6. Citizen security\n7. Migration\n8. Gender\n9. Agricultural development and food security\n10. Environment\n11. Industrial development\n12. Tourism\n13. Fiscal policy\n14. Public investment\n15. International relations\n16. Science and technology\n17. Open government and digital republic\n18. Older adults\n19. Persons with disabilities\n20. Children and youth\n21. Indigenous and Afro-descendant peoples\n22. LGBTIQ+ persons","linking_sdg_plans":"no","ipd/ipd_type":"government","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:3763f2db-6750-4aad-8627-7fed289a569e","meta/deprecatedID":"uuid:6befdb43-f853-44f7-a14f-735267e4be2c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3763f2db-6750-4aad-8627-7fed289a569e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3763f2db-6750-4aad-8627-7fed289a569e"},{"_id":46582,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:09.557","end":"2025-11-07T14:27:09.557","id_drupal":"366","country":"hti","theme":"development_planning","original_language":"fr","name_es":"Plan Estratégico de Desarrollo de Haití (PSDH)","name_en":"Plan Estratégico de Desarrollo de Haití / Strategic Development Plan of Haiti ","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación y Cooperación Externa (MPCE)","responsible_institution/id_institution":"45412","responsible_institution/name_institution":"Ministerio de Planificación y Cooperación Externa (MPCE)"}],"link":"68b5a6dc-3f15-47c2-8f84-0b4cf21aebd4","primary_link":"https://www.undp.org/sites/g/files/zskgke326/files/migration/ht/c2ede4d8b7161d7ad687d2180d7378d725648ff3a96a9ce81f5e260638d8ec77.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Estratégico de Desarrollo de Haití (PSDH) es el instrumento de planificación a largo plazo del Estado haitiano que tiene como objetivo transformar profundamente el país para que alcance el estatus de “país emergente” hacia el año 2030.\n\nEl Plan está organizado en torno a grandes “Chantiers” o grandes ejes de reconstrucción y desarrollo:\n1. Re­fundación territorial (infraestructura, urbanismo, descentralización).\n2. Re­fundación económica (crecimiento, sector privado, modernización de agricultura, servicios e industria).\n3. Re­fundación social (educación, salud, vivienda, inclusión, cultura).\n4. Re­fundación institucional (gobernabilidad, justicia, Estado de derecho).\n\nEl PSDH surge como una respuesta estructurada al terremoto de 2010 y a los desafíos persistentes del país, poniendo énfasis en la participación ciudadana, la alianza público‑privada, la movilización de la inversión nacional e internacional, y la articulación con los Objetivos de Desarrollo Sostenible.\n\nEl documento de consulta pública define una visión de país en la cual Haití transforma su situación en una trayectoria de crecimiento más sólido, creación de empleo, reducción de la pobreza y acceso más equitativo a los servicios.\nCuenta con un marco de seguimiento que permitirá vincular los grandes ejes con programas específicos, subprogramas y proyectos prioritarios, de corto, mediano y largo plazo.","description_en":"The Strategic Development Plan of Haiti (PSDH) is the nation’s long‑term planning instrument aimed at fundamentally transforming Haiti so that it achieves the status of an “emerging country” by 2030.\n\nThe Plan is structured around major “large works” (Grand Chantiers) for reconstruction and development:\n1. Territorial Refoundation (infrastructure, urban planning, decentralization).\n2. Economic Refoundation (growth, private sector, modernization of agriculture, services and industry).\n3. Social Refoundation (education, health, housing, inclusion, culture).\n4. Institutional Refoundation (governance, justice, rule of law).\n\nThe PSDH was formulated in response to the 2010 earthquake and ongoing national challenges, emphasizing citizen participation, public–private partnerships, mobilization of domestic and international investment, and alignment with the Sustainable Development Goals (SDGs).\n\nThe document presents a country vision in which Haiti shifts to a trajectory of stronger growth, job creation, poverty reduction and more equitable access to services.\nIt includes a monitoring framework designed to link strategic axes with specific programmes, sub‑programmes and priority projects across short, medium and long term.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:7df38179-6962-4abc-bde7-3320b96ef22c","meta/deprecatedID":"uuid:cd996ad6-5e8f-4831-bc0f-c2e2a2513d90","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7df38179-6962-4abc-bde7-3320b96ef22c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:08","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7df38179-6962-4abc-bde7-3320b96ef22c"},{"_id":46583,"start":"2025-11-07T14:27:10.266-04:00","end":"2026-08-14T10:40:26.040-04:00","id_drupal":"305","country":"jam","theme":"development_planning","original_language":"en","name_es":"Visión 2030 Jamaica. Plan Nacional de Desarrollo (PND)","name_en":"Vision 2030 Jamaica. National Development Plan (NDP)","responsible_institution":[{"responsible_institution/institution":"Instituto de Planificación de Jamaica (PIOJ)","responsible_institution/id_institution":"45417","responsible_institution/name_institution":"Instituto de Planificación de Jamaica (PIOJ)"}],"link":"1313463c-a225-40d2-b29b-34b5ea651945","primary_link":"https://www.pioj.gov.jm/policies/vision-2030-jamaica-the-national-development-plan/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2009-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Visión 2030 Jamaica tiene un alcance amplio, es inclusiva y no partidista, y ha recibido aportes de los sectores público y privado, sindicatos, ONG, agencias externas y ciudadanos en general. El producto final es un Plan Nacional de Desarrollo que refleja las diversas necesidades y aspiraciones del pueblo jamaicano, guiado por el extenso trabajo del Instituto de Planificación de Jamaica (PIOJ).\n\nEste plan de desarrollo a largo plazo busca posicionar a Jamaica para alcanzar el estatus de país desarrollado para 2030. A través de prioridades, políticas y programas a corto y mediano plazo, plasmados en el Marco de Política Socioeconómica a Mediano Plazo (MTF), el Plan proporciona dinamismo y flexibilidad. Este marco de implementación facilita el monitoreo y la evaluación consistentes, y permite que los cambios nacionales y globales se reflejen e incorporen en el proceso de planificación.\n\nEl Plan se guía por cuatro Objetivos Nacionales interrelacionados que identifican lo que Jamaica desea lograr en sociedad, economía, medio ambiente y gobernanza. También contiene 15 Resultados Nacionales vinculados a los Objetivos Nacionales correspondientes; 84 Estrategias Nacionales que orientan los pasos de los ministerios, departamentos y agencias del gobierno (MDAs), del sector privado y de la sociedad civil desde 2009 hasta 2030; y un marco de Monitoreo y Evaluación basado en Resultados con indicadores y metas a nivel nacional y sectorial.\n\nEste marco de Monitoreo y Evaluación basado en Resultados se presenta en detalle en la Visión, asignando al PIOJ (autoridad de planificación) como coordinador del mecanismo, junto con otras instituciones y actores relevantes (el sistema define roles y responsabilidades en tres niveles: político, técnico y consultivo). El marco aún se encuentra en proceso, dado que la matriz de indicadores sigue en desarrollo.","description_en":"Vision 2030 Jamaica is broad-based in scope, non-partisan and inclusive, the recipient of input from the public and private sectors, Trade Unions, NGOs, external agencies and ordinary citizens. The final product is a National Development Plan which captures the very diverse needs and aspirations of the people of Jamaica, which are guided by the extensive work of the Planning Institute of Jamaica (PIOJ).\n\nThis long-term development plan seeks to put Jamaica in the position to achieve developed country status by 2030. Through short- and medium-term priorities, policies and programs which are captured in the Medium Term Socio-Economic Policy Framework (MTF), the Plan provides dynamism and flexibility. This framework for implementation facilitates consistent monitoring and evaluation and allows domestic as well as global changes to be reflected and incorporated in the planning process.\n\nThe Plan is guided by 4 interrelated National Goals that identify what Jamaica wants to achieve for the society, economy, environment and in governance. It also contains 15 National Outcomes that are linked to the relevant National Goals; 84 National Strategies that guide the steps of ministries, departments and agencies of government (MDAs), private sector, civil society from 2009 to 2030 and; a Results-based Monitoring & Evaluation framework with indicators and targets at the national and sector levels.\n\nThis Results-based Monitoring & Evaluation framework is presented in detail in the Vision assigning the PIOJ (planning authority) as the coordinator of the mechanism, among other institutions and stakeholders (the system defines roles and resposabilities at three levels: Political, Techinical and Consultative). The framework is in process due to the fact that the indicator's matriz is still an ongoing process.","linking_sdg_plans":"no","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_8 sdg_9 sdg_10 sdg_11 sdg_12 sdg_13 sdg_14 sdg_15 sdg_16 sdg_17","ipd/ipd_vision_es":"“Desde los bulliciosos pueblos y ciudades hasta la «irie» campiña, somos un pueblo dotado de un enorme talento y potencial otorgados por Dios. A pesar de las diversas dificultades, seguimos siendo fuertes y profundamente espirituales. Jamaica, una joya isleña bañada por un sol radiante, donde las frescas aguas caen en cascada desde las montañas hasta los fértiles suelos de los valles que se extienden a sus pies.\"","ipd/ipd_vision_en":"“From bustling townships and cities to the “irie” countryside, we are a people of tremendous God-given talent and potential. Out of diverse hardships we remain strong and deeply spiritual. Jamaica, an island gem basking in brilliant sunshine where cool waters cascade from the mountains to the fertile soils of the valleys below.”.","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","link_block":[{"link_block/link_type":"external","link_block/external_link_type":"document","link_block/external_link_text_es":"Alineación de las estrategias nacionales del  (MTF) 2018-2021 de «Visión 2030 Jamaica» con los indicadores y metas de los Objetivos de Desarrollo Sostenible (ODS)","link_block/external_link_text_en":"Alignment of the Vision 2030 Jamaica MTF 2018-2021 National Strategies to the Sustainable Development Goals (SDGs) Indicators and Targets","link_block/external_link_text_url":"vision2030.gov.jm/wp-content/uploads/sites/2/2021/05/Alignment-of-the-Vision-2030-Jamaica-MTF-2018-2021-National-Strategies-to-the-Sustainable-Development-Goals-SDGs-Indicators-and-Targets.pdf"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:0158b83a-70ee-44e3-80fc-821f88952a35","meta/deprecatedID":"uuid:79088167-9109-414c-9733-168d087fb253","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0158b83a-70ee-44e3-80fc-821f88952a35","meta/rootUuid":"uuid:0158b83a-70ee-44e3-80fc-821f88952a35","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1786976483,"uid":"validation_status_approved","by_whom":"paulinestockins","label":"Approved"},"_submitted_by":"hcastellaro"},{"_id":46584,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:10.988","end":"2025-11-07T14:27:10.988","id_drupal":"1762","country":"jam","theme":"development_planning","original_language":"en","name_es":"Marco de Política Socioeconómica a Mediano Plazo de Jamaica ","name_en":"Medium Term Socio-Economic Policy Framework of Jamaica","responsible_institution":[{"responsible_institution/institution":"Instituto de Planificación de Jamaica (PIOJ)","responsible_institution/id_institution":"45417","responsible_institution/name_institution":"Instituto de Planificación de Jamaica (PIOJ)"}],"link":"66b87ac7-b208-4478-822f-43ec2470d49a","primary_link":"https://www.pioj.gov.jm/wp-content/uploads/2022/11/Medium-Term-Socio-Economic-Policy-Framework-MTF-2021-2024.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El MTF (Marco de Resultados a Mediano Plazo) sirve como el principio central del marco de implementación de la Visión 2030 Jamaica y como el principal vehículo para avanzar en la implementación de la Agenda 2030 y sus 17 ODS. Hasta la fecha, el MTF ha incluido un paquete de estrategias nacionales y sectoriales priorizadas, así como las acciones más críticas/catalizadoras que operativizan las estrategias sectoriales. Cada MTF se fundamenta en varias fuentes de evidencia, marcos de política pública y arreglos institucionales.\n\nEl MTF también se nutre de otras consideraciones de desarrollo, incluyendo el desempeño en el desarrollo, tales como logros, retrocesos y brechas; el contexto nacional y global de desarrollo; y las perspectivas y experiencias de los actores involucrados. El MTF se implementa mediante la alineación del programa de desarrollo (incluyendo subprogramas y proyectos) de los ministerios, departamentos y agencias (MDAs) y otros actores de desarrollo con el marco de resultados y estrategias del MTF.","description_en":"The MTF serves as the central tenet of the implementation framework of Vision 2030 Jamaica and the main vehicle for advancing the implementation of the 2030 Agenda and its 17 SDGs. To date, the MTF has included a package of prioritized national strategies and sector strategies, and the most critical/catalytic actions that operationalize the sector strategies. Each MTF is informed by several sources of evidence, public policy frameworks and arrangements.\n\nThe MTF is also informed by other development considerations, including development performance, such as gains, slippages, and gaps; the national and global development context; and the perspectives/experiences of stakeholders. The MTF is implemented through the alignment of the development programme (including subprogrammes, and projects) of ministries, departments, and agencies (MDAs) and other development actors with the results and strategy framework of the MTF.\n\n","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_participation":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ee54f3bd-6b06-4158-836b-b88951cec223","meta/deprecatedID":"uuid:8adfc90d-7d8d-4c41-b855-2771469255a7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ee54f3bd-6b06-4158-836b-b88951cec223","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ee54f3bd-6b06-4158-836b-b88951cec223"},{"_id":46585,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:11.713","end":"2025-11-07T14:27:11.713","id_drupal":"418","country":"kna","theme":"development_planning","original_language":"en","name_es":"Estrategia de Adaptación en Respuesta al Nuevo Régimen Azucarero de la UE 2006 – 2013 de San Cristóbal y Nieves","name_en":"Adaptation Strategy in Response to The New EU Sugar Regime 2006 – 2013 of St. Kitts and Nevis","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Sostenible, Medio Ambiente, Acción Climática y Empoderamiento de Circunscripciones de Saint Kitts y Nevis","responsible_institution/id_institution":"44932","responsible_institution/name_institution":"Ministerio de Desarrollo Sostenible, Medio Ambiente, Acción Climática y Empoderamiento de Circunscripciones de Saint Kitts y Nevis"}],"link":"2264f4c2-1d24-4c2e-bb4b-56afc20c90ee","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2006-01-01","validity_applies_until":"yes","effective_until":"2013-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"El 30 de julio de 2005 marcó el fin de la producción comercial de azúcar en San Cristóbal y, con ello, la desaparición definitiva de la industria que había dominado el panorama socioeconómico de San Cristóbal y Nieves durante más de trescientos cincuenta años. Como resultado, la Estrategia de Adaptación constituye un intento de trazar un rumbo para guiar y llevar a cabo la tarea de reconstrucción y transformación durante los siguientes diez años.\n\nLa Estrategia se alinea con los objetivos establecidos en los incisos 1(b) y 1(c) del Art.4 del Reglamento (CE) N.º 266-2006. Aunque la Estrategia de Adaptación estaba inicialmente planificada para concluir en 2013, el gobierno de San Cristóbal y Nieves decidió continuarla, por lo que todavía se encuentra en aplicación.\n\nLa Estrategia de Adaptación se elaboró con la conciencia de que, aunque San Cristóbal y Nieves “visualiza un futuro brillante y próspero para todos, enfrentamos desafíos considerables que pueden socavar seriamente nuestros esfuerzos para alcanzar nuestras metas”.\n\nLa estrategia se divide en Áreas de Política y Temas, y a su vez, estos se subdividen en objetivos y acciones a cumplir.","description_en":"The 30th of July 2005 marked the end of the commercial production of sugar on St. Kitts and thus brought about the final demise of the industry that had dominated the socio- economic landscape of St. Kitts and Nevis for over three hundred and fifty years. As a result, the Adaptation Strategy is the attempt to chart a course to guide and set about the task of reconstruction and transformation over the next ten years.\n\nThe Strategy is in line with the objectives set out in Art.4 1(b) and (c) of the Regulation (EC) No. 266-2006. Eventhough the Adaptation Strategy was aimed to end on 2013, the government of St. Kitts and Nevis decided to continue it so it is still being applied. \n\nThe Adaptation Strategy was framed in the knowledge that even as St. Kitts and Nevis \"envision a bright and prosperous future for all, we face considerable challenges that can seriously undermine our efforts to achieve our goals.\" \n\nThe strategy is divided in Policy Areas and Issues. At the same time these are subdivided into objectives and actions to be accomplish. ","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_investment":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:7d03a494-9cb9-44e6-91b0-34d65d18c75a","meta/deprecatedID":"uuid:54eab2d6-aca0-46e9-8039-16e6294055b7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7d03a494-9cb9-44e6-91b0-34d65d18c75a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7d03a494-9cb9-44e6-91b0-34d65d18c75a"},{"_id":46586,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:12.439","end":"2025-11-07T14:27:12.439","id_drupal":"403","country":"lca","theme":"development_planning","original_language":"en","name_es":"Plan Nacional de Desarrollo de Santa Lucía","name_en":"National Development Plan of Saint Lucia","primary_link":"https://www.commonwealthgovernance.org/countries/americas/st_lucia/national-development-plan/#:~:text=National%20Development%20Plan%20of%20Saint,jobs%20and%20circulating%20wealth%20widely.","instrument_type":"plan","territorial_scale":"national","validity_applies_until":"yes","visible_description":"yes","description_es":"El Plan Nacional de Visión de Santa Lucía es el plan nacional de desarrollo a largo plazo. Está basado en amplias consultas públicas y uno de sus objetivos principales es que la inversión se distribuya por toda la isla, generando empleo y promoviendo una circulación amplia de la riqueza.\nLa Estrategia de Desarrollo a Mediano Plazo es el plan de acción relacionado y priorizado, que abarca un período de tres a cinco años e incluye todas las áreas de actividad gubernamental. Establece metas y prioridades de desarrollo.","description_en":"The Saint Lucia National Vision Plan is the national longrange development plan. It is based on broad public consultations and an important objective of the plan is that investment should be spread throughout the island, creating jobs and circulating wealth widely.\n\nThe Medium-Term Development Strategy is the related prioritised action plan, spanning a three- or five-year period and encompassing all areas of government activity. It sets development goals and priorities.","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:eb7ed30d-1a1a-4dee-8980-3f96163f871e","meta/deprecatedID":"uuid:3fb8cc32-d881-4975-906c-f5fb7fc339d0","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"eb7ed30d-1a1a-4dee-8980-3f96163f871e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:11","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:eb7ed30d-1a1a-4dee-8980-3f96163f871e"},{"_id":46587,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:13.151","end":"2025-11-07T14:27:13.151","id_drupal":"1609","country":"lca","theme":"development_planning","original_language":"en","name_es":"Estrategia de Desarrollo a Mediano Plazo 2020 - 2023 de Santa Lucía","name_en":"Medium Term Development Strategy 2020 - 2023 of St. Lucia","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Económico, Vivienda, Renovación Urbana, Transporte y Aviación Civil de Santa Lucía","responsible_institution/id_institution":"45436","responsible_institution/name_institution":"Ministerio de Desarrollo Económico, Vivienda, Renovación Urbana, Transporte y Aviación Civil de Santa Lucía"}],"link":"56ac2530-3933-4298-ae83-458194479814","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"La Estrategia de Desarrollo de Mediano Plazo 2020-2023, titulada “Crecimiento Económico en el A.R.I.S.E. – Nou Tout Ansanm”, es un llamado claro a la acción colectiva para impulsar la agenda de desarrollo de Santa Lucía. Busca resaltar la naturaleza interconectada de la planificación del desarrollo al asegurar que las consideraciones económicas, sociales y ambientales se incorporen y se integren de manera transversal en el marco de planificación nacional de Santa Lucía.\n\nLa MTDS no es un documento de planificación independiente. Se inspira en documentos nacionales de planificación anteriores, como el borrador del Plan Estratégico de Desarrollo de Mediano Plazo 2011-2015 y el Plan Nacional de Visión de 2008, para establecer el contexto y situarse dentro del continuo más amplio del proceso de desarrollo nacional de Santa Lucía. Como resultado, muchos de los temas destacados en este documento son similares a los de sus predecesores, reflejando en gran medida la persistencia y naturaleza estructural de muchos de los desafíos del país. Sin embargo, la modalidad de implementación de la MTDS se aparta del statu quo en varios aspectos.\n\nCuenta con seis Áreas Clave de Resultados: Agricultura, infraestructura, turismo, seguridad ciudadana, educación y atención en salud. El enfoque descrito anteriormente es el vehículo mediante el cual Santa Lucía logrará los amplios objetivos del Crecimiento Económico Compartido Acelerado, Resiliente, Inclusivo, Sostenible y Equitativo (A.R.I.S.E.).\n\nPróximamente se lanzará una Estrategia de Desarrollo de Mediano Plazo actualizada (MTDS 2021-2026) que reemplazará la versión 2020-2023. La actualización está siendo realizada por el Departamento de Desarrollo Económico.","description_en":"The 2020-2023 Medium Term Development Strategy, entitled “Economic Growth on the A.R.I.S.E. – Nou Tout Ansanm”, is a clarion call for collective action to drive Saint Lucia’s development agenda. It seeks to accentuate the interconnected nature of development planning by ensuring economic, social and environmental considerations are incorporated and mainstreamed into Saint Lucia’s national planning framework.\n \nThe MTDS is not a stand-alone planning document. It draws inspiration from previous legacy national planning documents, such as the draft 2011-2015 Medium Term Development Strategic Plan and the National Vision Plan of 2008, to establish context and to situate itself within the broader continuum of Saint Lucia’s national development journey. As a result, many of the issues highlighted in this document are similar to those in its predecessors, largely reflective of the persistence and structural nature of many of Saint Lucia’s challenges. However, the modality of delivery for the MTDS departs from the status quo in several ways.\n\nIt has 6 Key Result Areas: Agriculture, infrastructure, tourism, citizen security, education and healthcare. The approach outlined above is the vehicle through which Saint Lucia will achieve the broad objectives of Accelerated, Resilient, Inclusive, Sustainable and Equitably (A.R.I.S.E.) Shared Economic Growth.\n\nAn updated Medium Term Development Strategy (MTDS) 2021 – 2026 will soon be launched to replace the 2020 -2023 version. The update is being conducted by the Department of Economic Development. ","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:65005252-1e26-4d20-9aee-4a0caca16a42","meta/deprecatedID":"uuid:41b30d39-653a-4177-bebf-7556dbde13c7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"65005252-1e26-4d20-9aee-4a0caca16a42","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:65005252-1e26-4d20-9aee-4a0caca16a42"},{"_id":46588,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:13.883","end":"2025-11-07T14:27:13.883","id_drupal":"334","country":"mex","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo 2013-2018 de México","name_en":"National Development Plan 2013-2018 of Mexico","responsible_institution":[{"responsible_institution/institution":"Presidencia de los Estados Unidos Mexicanos/ Ejecutivo Federal de México","responsible_institution/id_institution":"45407","responsible_institution/name_institution":"Presidencia de los Estados Unidos Mexicanos/ Ejecutivo Federal de México"}],"link":"11b5722e-db0a-4c25-b1ed-faf6f0fbc8de","primary_link":"https://www.gob.mx/cms/uploads/attachment/file/32349/plan-nacional-de-desarrollo-2013-2018.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"Este plan se origina por el deber que tiene cada Presidente de la República de México al asumir su cargo, según el Artículo 21 de la Ley de Planeación \"El Plan Nacional de Desarrollo deberá elaborarse, aprobarse y publicarse dentro de un plazo de seis meses contados a partir de la fecha en que toma posesión el  Presidente de la República, y su vigencia no excederá del período constitucional que le corresponda...\". Y se construye a partir de un amplio ejercicio democrático, que tomó en cuenta actores gubernamentales y no gubernamentales, así como también, de la sociedad civil, con el fin de reunir ideas, visiones y propuestas para llevar a México a su máximo potencial. Considerando además, “que la tarea del desarrollo y del crecimiento corresponde a todos los actores, todos los sectores y todas las personas del país”.\n\nEl plan funciona como un documento de trabajo que rige la programación y presupuestación de toda la Administración Pública Federal; ha sido concebido como un canal de comunicación del Gobierno de la República, que transmite a toda la ciudadanía de una manera clara, concisa y medible la visión y estrategia de gobierno de la presente Administración.\n\nSe proponen como Metas Nacionales: \n1. Un México en Paz, un México Incluyente,\n2. Un México con Educación de Calidad,\n3. Un México Próspero y,\n4. Un México con Responsabilidad Global. \n\nAsimismo, se presentan Estrategias Transversales para:\n• Democratizar la Productividad,\n• Alcanzar un Gobierno Cercano y Moderno, y,\n• Tener una Perspectiva de Género en todos los programas de la Administración Pública Federal.\n\nEl plan también detalla el Sistema de Evaluación y Compensación por el Desempeño, que es regido por el Ejecutivo Federal y Secretaría de Hacienda y Crédito Público, avalado jurídicamente por la Ley de Planeación (artículo 9).\n\nLa Administración Pública Federal se propuso incluir, por primera vez, dentro del Plan Nacional de Desarrollo 2013-2018, indicadores que reflejen la situación del país en relación con los temas considerados como prioritarios, para darles puntual seguimiento y conocer el avance en la consecución de las metas establecidas y, en su caso, hacer los ajustes necesarios para asegurar su cumplimiento. Los indicadores propuestos fueron diseñados por instituciones y organismos reconocidos internacionalmente y son calculados periódicamente, lo cual asegura su disponibilidad, calidad e imparcialidad.","description_en":"This plan originates from the obligation that each President of the Republic of Mexico has upon taking office, as established in Article 21 of the Planning Law, which states: “The National Development Plan must be prepared, approved, and published within six months from the date the President of the Republic takes office, and its validity shall not exceed the constitutional term of the administration.”\n\nIt was built through a broad democratic process, involving governmental and non-governmental actors, as well as civil society, in order to gather ideas, visions, and proposals aimed at bringing Mexico to its full potential—recognizing that “the task of development and growth belongs to all actors, sectors, and individuals in the country.”\n\nThe plan functions as a working document that guides the programming and budgeting of the entire Federal Public Administration. It serves as a communication channel between the Government of the Republic and the citizenry, conveying in a clear, concise, and measurable manner the vision and strategy of the administration.\n\nThe National Goals proposed are:\n1. A Mexico in Peace\n2. An Inclusive Mexico\n3. A Mexico with Quality Education\n4. A Prosperous Mexico\n5. A Globally Responsible Mexico\n\nAdditionally, it defines Cross-cutting Strategies to:\n• Democratize productivity\n• Achieve a close and modern government\n• Integrate a gender perspective across all federal programs\n\nThe plan also outlines the Performance Evaluation and Compensation System, overseen by the Federal Executive and the Ministry of Finance and Public Credit (SHCP), and legally supported by Article 9 of the Planning Law.\n\nFor the first time, the National Development Plan 2013–2018 incorporated indicators to reflect the country’s situation on priority issues, ensuring accurate monitoring and enabling necessary adjustments to achieve the established goals. These indicators were designed by internationally recognized institutions and organizations, ensuring their availability, quality, and impartiality.","linking_sdg_plans":"no","ipd/ipd_vision_es":"Representa la imagen de país que el Estado proyecta a través del objetivo general del Plan Nacional de Desarrollo: \n\"Llevar a México a su máximo potencial en un sentido amplio. Además del crecimiento económico o el ingreso, factores como el desarrollo humano, la igualdad sustantiva entre mujeres y hombres, la protección de los recursos naturales, la salud, educación, participación política y seguridad, forman parte integral de la visión que se tiene para alcanzar dicho potencial\"","ipd/ipd_vision_en":"The vision represents the image of the country projected through the general objective of the National Development Plan:\n“To bring Mexico to its fullest potential in a broad sense. Beyond economic growth or income, factors such as human development, substantive equality between women and men, the protection of natural resources, health, education, political participation, and security are integral parts of the vision for achieving that potential.”","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:cc7a246d-18a3-4c9f-adb4-e43dcb60d486","meta/deprecatedID":"uuid:7468b139-b16d-4739-855b-2dcff3fa96d8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"cc7a246d-18a3-4c9f-adb4-e43dcb60d486","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:cc7a246d-18a3-4c9f-adb4-e43dcb60d486"},{"_id":46589,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:14.606","end":"2025-11-07T14:27:14.606","id_drupal":"1014","country":"mex","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo de México 2019-2024","name_en":"National Development Plan of Mexico 2019-2024","responsible_institution":[{"responsible_institution/institution":"Presidencia de los Estados Unidos Mexicanos/ Ejecutivo Federal de México","responsible_institution/id_institution":"45407","responsible_institution/name_institution":"Presidencia de los Estados Unidos Mexicanos/ Ejecutivo Federal de México"}],"link":"d040044b-6cd5-439f-8667-bc94693bdfe8","primary_link":"https://www.gob.mx/agricultura/documentos/plan-nacional-de-desarrollo-gobierno-de-mexico-2019-2024","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"En cumplimiento a las disposiciones contenidas en los artículos 26° (inciso A) de la Constitución Política de los Estados Unidos Mexicanos y 5o y 20 de la Ley de Planeación, el Ejecutivo Federal elaboró el Plan Nacional de Desarrollo 2019-2024.\n\nEl Plan fue desarrollado a través de un amplio procedimiento de participación y consulta popular, en el marco del Sistema Nacional de Planeación. Este fue aprobado por el Poder Legislativo.\n\nAsimismo, el Plan Nacional de Desarrollo cuenta con tres ejes centrales:\n1. Política y Gobierno\n2. Política Social\n3. Economía\n\nCada uno de los cuales cuenta con objetivos y programas asociados.\n\n","description_en":"In compliance with the provisions established in Article 26 (Section A) of the Political Constitution of the United Mexican States and Articles 5 and 20 of the Planning Law, the Federal Executive prepared the National Development Plan 2019–2024.\n\nThe Plan was developed through a broad process of participation and public consultation within the framework of the National Planning System, and was subsequently approved by the Legislative Branch.\n\nThe National Development Plan is structured around three central pillars:\n1. Politics and Government\n2. Social Policy\n3. Economy\n\nEach pillar includes specific objectives and associated programs that guide public policy actions during the 2019–2024 administration.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:529ca694-8a90-4318-afff-556e73622191","meta/deprecatedID":"uuid:705cd777-8609-4856-a9be-c165fd0e166c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"529ca694-8a90-4318-afff-556e73622191","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:13","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:529ca694-8a90-4318-afff-556e73622191"},{"_id":46590,"start":"2025-11-07T14:27:15.354-03:00","end":"2026-07-29T12:59:40.114-04:00","id_drupal":"10040","country":"mex","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo 2025-2030","name_en":"National Development Plan 2025-2030","responsible_institution":[{"responsible_institution/institution":"Presidencia de los Estados Unidos Mexicanos/ Ejecutivo Federal de México","responsible_institution/id_institution":"45407","responsible_institution/name_institution":"Presidencia de los Estados Unidos Mexicanos/ Ejecutivo Federal de México"}],"link":"e3407f8e-57a5-4408-89ad-0ae554f8d157","primary_link":"https://www.gob.mx/presidencia/documentos/plan-nacional-de-desarrollo-2025-2030-391771","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo (PND) 2025-2030 es la guía que establece los objetivos y las acciones del Gobierno de México para los próximos años. Estos objetivos buscan consolidar la transformación del país bajo un modelo de desarrollo basado en el bienestar, la justicia social y la sustentabilidad.\n\nEl Plan fue elaborado por el Ejecutivo Federal en cumplimiento de las disposiciones contenidas en el artículo 26, apartado A, de la Constitución Política de los Estados Unidos Mexicanos y en los artículos 5 y 21 de la Ley de Planeación.\n\nEl PND fue aprobado por el Poder Legislativo y tiene como propósito orientar las políticas públicas, los programas y los proyectos de la Administración Pública Federal durante el sexenio.\n\nSu elaboración se desarrolló mediante un amplio proceso de participación y consulta ciudadana, realizado en el marco del Sistema Nacional de Planeación.\n\nEl documento se estructura en cuatro ejes generales y tres ejes transversales, que organizan las prioridades nacionales.\n\n*Ejes generales:*\n\n1. Gobernanza con justicia y participación ciudadana.\n2. Desarrollo con bienestar y humanismo.\n3. Economía moral y trabajo.\n4. Desarrollo sustentable.\n\n*Ejes transversales:*\n\n5. Igualdad sustantiva y derechos de las mujeres.\n6. Innovación pública para el desarrollo tecnológico nacional.\n7. Derechos de las comunidades indígenas y afromexicanas.","description_en":"The National Development Plan (NDP) 2025–2030 is the document that sets out the objectives and actions of the Government of Mexico for the coming years. These objectives seek to consolidate the country’s transformation under a development model based on well-being, social justice, and sustainability.\n\nThe Plan was prepared by the Federal Executive in compliance with the provisions established in Article 26, Section A, of the Political Constitution of the United Mexican States and Articles 5 and 21 of the Planning Law.\n\nThe NDP was approved by the Legislative Branch and is intended to guide the public policies, programs, and projects of the Federal Public Administration throughout the six-year presidential term.\n\nThe Plan was developed through a broad process of citizen participation and consultation within the framework of the National Planning System.\n\nThe document is structured around four general axes and three cross-cutting axes that organize national priorities.\n\n*General axes:*\n\n1. Governance with justice and citizen participation.\n2. Development with well-being and humanism.\n3. Moral economy and labor.\n4. Sustainable development.\n\n*Cross-cutting axes:*\n\n5. Substantive equality and women’s rights.\n6. Public innovation for national technological development.\n7. Rights of Indigenous and Afro-Mexican communities.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_5 sdg_8 sdg_9 sdg_10 sdg_13 sdg_16","ipd/ipd_vision_es":"El Plan México busca, a través de un enfoque integral, fortalecer la industria local, aprovechar más la situación geográfica y obtener ingresos remunerativos para los trabajadores. \n\nEl PND se plantea una nueva estrategia de industrialización que garantice que el crecimiento económico no solo se traduzca en más exportaciones, sino en una mayor industrialización en el país. Uno de sus principales objetivos es incrementar la participación de empresas mexicanas en la cadena de proveeduría de las exportaciones.\n\nEl fortalecimiento de la industria nacional no solo es una estrategia económica, sino una política social. Una economía más integrada y diversificada permite distribuir los beneficios del crecimiento en todo el país, cerrando brechas de desarrollo entre regiones y evitando la concentración de la inversión en unas pocas zonas industriales. Con una mayor presencia de empresas mexicanas en la cadena de proveeduría, se creará un círculo virtuoso en el que la industria nacional impulse el crecimiento interno y refuerce el mercado laboral.\n\nEl éxito del Plan México también depende de una infraestructura moderna y eficiente que permita una producción a gran escala con costos competitivos. En este sentido, el Gobierno ha diseñado una estrategia de inversión en  infraestructura productiva que abarca desde la expansión de la red ferroviaria hasta la modernización de los puertos y aeropuertos del país.  \n\nEl mundo se encuentra en un proceso acelerado de transformación digital e innovación tecnológica, por lo que el Plan México buscará fortalecer la innovación tecnológica, el desarrollo de semiconductores y la electromovilidad, asegurando que el país se convierta en un actor clave en la manufactura avanzada. El plan también contempla el impulso a la industria farmacéutica y aeroespacial, sectores con un alto potencial de crecimiento y generación de empleos de calidad. Además, busca la transformación digital de la industria automotriz y manufacturera, incorporando nuevas tecnologías que eleven la productividad y reduzcan costos operativos.\n\nEl Plan México es una apuesta por el futuro del país. No se trata solo de aumentar la producción o mejorar las exportaciones, sino de transformar la estructura productiva de manera que el crecimiento sea equitativo, sostenible y con soberanía. El Plan México es una apuesta por el futuro del país. No se trata solo de aumentar la producción o mejorar las exportaciones, sino de transformar la estructura productiva de manera que el crecimiento sea equitativo, sostenible y con soberanía.\n\n*Este texto es un resumen de la visión declarada en el documento*","ipd/ipd_vision_en":"The Mexico Plan seeks, through a comprehensive approach, to strengthen local industry, make greater use of the country’s geographic position, and secure better wages for workers.\n\nThe National Development Plan proposes a new industrialization strategy aimed at ensuring that economic growth translates not only into increased exports, but also into greater industrial development within the country. One of its main objectives is to increase the participation of Mexican companies in export supply chains.\n\nStrengthening domestic industry is not only an economic strategy, but also a social policy. A more integrated and diversified economy makes it possible to distribute the benefits of growth throughout the country, reduce development gaps between regions, and prevent investment from becoming concentrated in only a few industrial areas. Greater participation by Mexican companies in supply chains will create a virtuous cycle in which domestic industry drives internal growth and strengthens the labor market.\n\nThe success of the Mexico Plan also depends on modern and efficient infrastructure that enables large-scale production at competitive costs. In this regard, the Government has designed an investment strategy for productive infrastructure, ranging from the expansion of the railway network to the modernization of the country’s ports and airports.\n\nThe world is undergoing an accelerated process of digital transformation and technological innovation. The Mexico Plan will therefore seek to strengthen technological innovation, semiconductor development, and electromobility, ensuring that the country becomes a key player in advanced manufacturing. The Plan also promotes the pharmaceutical and aerospace industries, sectors with significant potential for growth and the creation of quality jobs. In addition, it seeks to advance the digital transformation of the automotive and manufacturing industries by incorporating new technologies that increase productivity and reduce operating costs.\n\nThe Mexico Plan is an investment in the country’s future. It is not only about increasing production or improving exports, but also about transforming the productive structure so that growth is equitable, sustainable, and sovereign.\n\n*This text is a summary of the vision stated in the document*","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"no","ipd/ipd_tracking":"yes","ipd/ipd_investment":"no","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Constitución Política de 1917 de los Estados Unidos Mexicanos","link_block/legal_id":"49404","link_block/legal_name":"Constitución Política de 1917 de los Estados Unidos Mexicanos"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley de Planeación de México","link_block/legal_id":"49401","link_block/legal_name":"Ley de Planeación de México"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:882c67fe-581c-4a92-b627-421b8b2e0797","meta/deprecatedID":"uuid:4ed55fe8-1444-4887-8cb2-972d29931786","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"882c67fe-581c-4a92-b627-421b8b2e0797","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:14","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:882c67fe-581c-4a92-b627-421b8b2e0797"},{"_id":46591,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:16.083","end":"2025-11-07T14:27:16.083","id_drupal":"338","country":"nic","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo Humano 2012-2016 \"A seguir transformando Nicaragua\"","name_en":"National Human Development Plan 2012-2016 \"A seguir transformando Nicaragua\"","responsible_institution":[{"responsible_institution/institution":"Presidencia- Gobierno de Reconciliación y Unidad Nacional (GRUN) de Nicaragua","responsible_institution/id_institution":"45551","responsible_institution/name_institution":"Presidencia- Gobierno de Reconciliación y Unidad Nacional (GRUN) de Nicaragua"}],"link":"0bb93f5c-3aff-4d53-b7f2-4914cae1e765","primary_link":"https://www.pndh.gob.ni/documentos/planesanteriores/02_PNDH_2012-2016(27sept13).pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo Humano (PNDH) 2012-2016 es un plan vivo, en continua construcción, abierto a los aportes de la sociedad nicaragüense, que es actualizado de manera periódica para ajustarse a los procesos cambiantes internos y externos. Es el Gobierno de Reconciliación y Unidad Nacional (GRUN) quien formula el plan amparado en la Ley No.7 de Planificación Nacional. Si bien la idea inicial fue que el plan se concluyera en 2016, el gobierno de Nicaragua decidió continuar aplicándolo por lo que este Plan sigue vigente.\n\nLa Estrategia del Plan está construida con base en doce lineamientos que combinan la continuidad de las políticas que han transformado al país a partir del 2007, con la incorporación de nuevas prioridades cuyo propósito es atender las necesidades inaplazables de transformación productiva y social del país. Sin embargo, para su análisis, estas se agruparon en 8 categorías siguiendo la Matriz Directiva 2012-2016 presentada en el documento del plan.\n\nEn el marco del Sistema Nacional de Planificación, Inversiones, Presupuesto y Cooperación, se utilizan en ejercicios de control cruzado los siguientes sistemas: SIGRUN, SIGFA, SNIP y SysODA para monitorear, dar seguimiento y evaluar el plan. Esto se regula a partir del Decreto N°113 de 2007 (artículo 5) y tiene al CONPES (autoridad de planificación) como coordinador.  Se ha diseñado la Matriz Directiva del PNDH, la cual sintetiza los lineamientos, políticas, ejes de trabajo, indicadores y metas más relevantes definidos por el GRUN para dar seguimiento y evaluar el avance en el cumplimiento de los objetivos del plan.","description_en":"The National Human Development Plan (PNDH) 2012–2016 is a living, continuously evolving plan—open to the contributions of Nicaraguan society—and periodically updated to adapt to changing internal and external processes. The Government of Reconciliation and National Unity (GRUN) formulates the plan under the provisions of Law No. 7 on National Planning. Although the plan was originally intended to conclude in 2016, the Government of Nicaragua decided to continue its implementation; therefore, the Plan remains in force.\n\nThe strategy of the Plan is built on twelve guidelines that combine the continuity of policies that have transformed the country since 2007 with the inclusion of new priorities aimed at addressing the urgent needs of Nicaragua’s productive and social transformation. For analytical purposes, these guidelines were grouped into eight categories, following the 2012–2016 Directive Matrix presented in the Plan’s document.\n\nWithin the framework of the National System for Planning, Investment, Budget, and Cooperation, several systems—SIGRUN, SIGFA, SNIP, and SysODA—are used for cross-checking, monitoring, follow-up, and evaluation of the Plan. This process is regulated by Decree No. 113 of 2007 (Article 5), with CONPES (the national planning authority) serving as the coordinating entity. The Directive Matrix of the PNDH synthesizes the main guidelines, policies, work axes, indicators, and targets defined by the GRUN to monitor and assess progress toward the Plan’s objectives.","linking_sdg_plans":"no","ipd/ipd_vision_es":"Su visión está basada en la \"Dimensión Ética\": tiene como suprema aspiración humana erradicar la pobreza y conseguir la paz por la que se ha luchado históricamente y que se construye ahora, en la restitución de derechos del hombre y la mujer para satisfacer sus necesidades básicas (alimento, vestimenta, vivienda, salud, educación, descanso, seguridad), crear las condiciones para alcanzar una vida decorosa y digna, que conduzca a los nicaragüenses a alcanzar la mayor cima de felicidad, en el que el Estado tiene una responsabilidad y deber moral de prestar los servicios que aseguren ese bienestar anhelado.","ipd/ipd_vision_en":"The Plan’s vision is grounded in an “Ethical Dimension”, with the supreme human aspiration of eradicating poverty and achieving peace—a goal pursued throughout Nicaragua’s history and now built through the restitution of rights for men and women to meet their basic needs (food, clothing, housing, health, education, rest, and security). It seeks to create conditions for a dignified and decent life, leading Nicaraguans toward their highest level of happiness, while recognizing the State’s moral duty and responsibility to provide the services necessary to ensure this desired well-being.","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:3f3c0a4e-16ba-416a-9edc-7e7c44b65a19","meta/deprecatedID":"uuid:efcd6474-2e23-4bb4-9826-5ddcf50ee343","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3f3c0a4e-16ba-416a-9edc-7e7c44b65a19","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3f3c0a4e-16ba-416a-9edc-7e7c44b65a19"},{"_id":46592,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:16.813","end":"2025-11-07T14:27:16.813","id_drupal":"666","country":"nic","theme":"development_planning","original_language":"es","name_es":"Ejes del Programa Nacional de Desarrollo Humano 2018-2021 de Nicaragua","name_en":"Axes of the National Human Development Plan 2018-2021 of Nicaragua ","responsible_institution":[{"responsible_institution/institution":"Presidencia- Gobierno de Reconciliación y Unidad Nacional (GRUN) de Nicaragua","responsible_institution/id_institution":"45551","responsible_institution/name_institution":"Presidencia- Gobierno de Reconciliación y Unidad Nacional (GRUN) de Nicaragua"}],"link":"ce517863-b86a-48f1-9c57-95def64db6bc","primary_link":"https://www.pndh.gob.ni/documentos/planesanteriores/03_PNDH_2017-2021(12dic2017).pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo \"Tiempos de Victoria\" de Nicaragua detalla los objetivos nacionales propuestos para alcanzar el desarrollo humano.\n\nEste plan se estructura de la siguiente forma:\n• 19 ejes de desarrollo humano\n• 34 áreas temáticas\n• 233 objetivos vinculados a áreas y ejes","description_en":"The National Development Plan “Times of Victory” of Nicaragua outlines the national objectives proposed to achieve human development.\n\nThe Plan is structured as follows:\n• 19 human development pillars\n• 34 thematic areas\n• 233 objectives linked to the respective areas and pillars","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:86d583aa-6435-4252-ba5d-80c63a5b7e1b","meta/deprecatedID":"uuid:c8fb7e43-318f-4338-96e1-ee6c644340c7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"86d583aa-6435-4252-ba5d-80c63a5b7e1b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:86d583aa-6435-4252-ba5d-80c63a5b7e1b"},{"_id":46593,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:17.529","end":"2025-11-07T14:27:17.529","id_drupal":"1727","country":"nic","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Lucha contra la Pobreza y para el Desarrollo Humano 2022 - 2026 de Nicaragua","name_en":"National Plan to Fight Poverty and for Human Development 2022 - 2026 of Nicaragua","responsible_institution":[{"responsible_institution/institution":"Presidencia- Gobierno de Reconciliación y Unidad Nacional (GRUN) de Nicaragua","responsible_institution/id_institution":"45551","responsible_institution/name_institution":"Presidencia- Gobierno de Reconciliación y Unidad Nacional (GRUN) de Nicaragua"}],"link":"9c4bf77d-d27b-41cd-8b77-5045dd9d6ab7","primary_link":"https://www.pndh.gob.ni/documentos/pnlc-dh/PNCL-DH_2022-2026(19Jul21).pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Lucha Contra la Pobreza y para el Desarrollo Humano 2022-2026 constituye el instrumento rector de la gestión pública, contiene políticas, estrategias y acciones transformadoras que ratifican la ruta de crecimiento económico y la defensa y restitución de los derechos de las familias nicaragüenses, con reducción de la pobreza y las desigualdades.\n\nLineamientos:\n1. Estabilidad Macroeconómica\n2. Reforzar las Condiciones Básicas para el Desarrollo\n3. Desarrollo de los Talentos Humanos\n4. Consolidar los Bienes y Servicios Públicos\n5. Igualdad entre los Géneros\n6. Juventud como Eje Central del Desarrollo\n7. Más y Mejor Producción\n8. Desarrollar la Economía Creativa\n9. Dinamizar el Comercio y los Mercados\n10. Ciudades Inclusivas, Seguras y Resilientes\n11. Medidas para Enfrentar la Variabilidad y el Cambio Climático\n12. Costa Caribe, Zona Especial de Desarrollo","description_en":"The National Plan for the Fight Against Poverty and for Human Development 2022–2026 serves as the guiding instrument for public management in Nicaragua. It establishes policies, strategies, and transformative actions that reaffirm the country’s path toward economic growth and the defense and restoration of the rights of Nicaraguan families, aiming to reduce poverty and inequality.\n\nGuidelines:\n1. Macroeconomic Stability\n2. Strengthening Basic Conditions for Development\n3. Development of Human Talent\n4. Consolidation of Public Goods and Services\n5. Gender Equality\n6. Youth as a Central Axis of Development\n7. Greater and Better Production\n8. Development of the Creative Economy\n9. Promotion of Trade and Markets\n10. Inclusive, Safe, and Resilient Cities\n11. Measures to Address Climate Variability and Change\n12. Caribbean Coast as a Special Development Zone","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:6e9a9a93-b1d7-4163-bffa-cd408934c966","meta/deprecatedID":"uuid:7e765b0c-d50f-4e18-82bc-c83de01557be","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6e9a9a93-b1d7-4163-bffa-cd408934c966","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:16","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:6e9a9a93-b1d7-4163-bffa-cd408934c966"},{"_id":46594,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:18.268","end":"2025-11-07T14:27:18.268","id_drupal":"325","country":"pan","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico de Gobierno 2015-2019 \"Un sólo país\" de Panamá","name_en":"Strategic Government Plan 2015-2019 \"Un solo país\" for Panama","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)","responsible_institution/id_institution":"44942","responsible_institution/name_institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)"}],"link":"66058fd3-5d1f-4221-9315-e0ee58881c39","primary_link":"https://www.mef.gob.pa/wp-content/uploads/2020/12/Plan-Estrategico-de-Gobierno-2015-2019-1.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Presidente de la República, Juan Carlos Varela Rodríguez, presentó a la ciudadanía en general el Plan Estratégico de Gobierno 2015-2019 (PEG), que regirá durante los cinco años de su gestión al frente del Órgano Ejecutivo. El PEG honra lo establecido en la Ley No.34 sobre Responsabilidad Social Fiscal, que exige a la administración entrante presentar durante los primeros seis meses de su gestión un programa de gobierno para el próximo quinquenio.\n\nEn este sentido, el PEG se basa en cuatro ejes fundamentales: una Estrategia Social, una Estrategia Económica, un Plan Quinquenal de Inversiones y una Programación Financiera. Cada uno de los ámbitos de actuación desencadena una serie de líneas de intervención específicas.\n\nEl PEG presenta un sistema de monitoreo, seguimiento y evaluación que lidera el Ministerio de Finanzas (MEF) que a su vez es la autoridad de planificación. Se sustenta en la Ley No.34 de Ley de Responsabilidad Fiscal. Para cada objetivo se determinan cuáles son los resultados esperados y los indicadores a utilizar para su medición y las metas que se asignan en el periodo de Gobierno.","description_en":"The Strategic Government Plan (PEG) 2015–2019 was presented to the public by the President of the Republic, Juan Carlos Varela Rodríguez, to guide the actions of the Executive Branch during his five-year administration. The PEG complies with Law No. 34 on Fiscal Social Responsibility, which requires each incoming administration to present a government program for the next five-year period within the first six months in office.\n\nIn this regard, the PEG is structured around four fundamental pillars: a Social Strategy, an Economic Strategy, a Five-Year Investment Plan, and a Financial Program. Each area of action gives rise to specific lines of intervention.\n\nThe PEG includes a monitoring, follow-up, and evaluation system led by the Ministry of Economy and Finance (MEF), which also serves as the national planning authority. It is grounded in Law No. 34 on Fiscal Responsibility. For each objective, expected results, indicators for measurement, and specific targets for the government period are defined.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Un solo país, integrado y cohesionado, con armonía social y sostenibilidad ambiental, generador de buenas condiciones de vida y de oportunidades de desarrollo humano, dinámicamente posicionado en el escenario regional y mundial.\"","ipd/ipd_vision_en":"\"One single country, integrated and cohesive, with social harmony and environmental sustainability, generating good living conditions and opportunities for human development, and dynamically positioned in the regional and global arena.\"","ipd/ipd_type":"government","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:c0a790e8-a544-48cb-9c62-fcb5437e3b7b","meta/deprecatedID":"uuid:16582613-57ad-450c-9397-c2f96f69b29e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c0a790e8-a544-48cb-9c62-fcb5437e3b7b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c0a790e8-a544-48cb-9c62-fcb5437e3b7b"},{"_id":46595,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:18.992","end":"2025-11-07T14:27:18.992","id_drupal":"346","country":"pan","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico Nacional con Visión de Estado (PEN) Panamá 2030","name_en":"National Strategic Plan with State Vision (PEN) Panama 2030","responsible_institution":[{"responsible_institution/institution":"Consejo de la Concertación Nacional para el Desarrollo (CCND) de Panamá","responsible_institution/id_institution":"45271","responsible_institution/name_institution":"Consejo de la Concertación Nacional para el Desarrollo (CCND) de Panamá"}],"link":"b3f52205-f898-48d8-93a9-18a069dbce3e","primary_link":"https://siteal.iiep.unesco.org/sites/default/files/sit_accion_files/panama_plan_panama_2030.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Presidente de la República de Panamá, Juan Carlos Varela, en su discurso del 2 de enero de 2016, informó a la Nación su decisión de llamar a todas las fuerzas sociales y políticas del país para que, a través del Consejo de la Concertación Nacional para el Desarrollo (CCND), se iniciara un diálogo con miras a la adopción de un Plan Estratégico Nacional con Visión de Estado “Panamá 2030” (PEN 2030), que permita hacer realidad los 17 Objetivos de Desarrollo Sostenible (ODS), aprobados en las Naciones Unidas y adoptados en Panamá mediante Decreto Ejecutivo No.393 de septiembre de 2015.\n\n La visión del PEN 2030 se basa en que: \n\"El desarrollo pleno después de 2015 es una meta estratégica para el país, en tanto es la esperanza y la oportunidad para alcanzar la inclusión plena de los ciudadanos y su articulación al crecimiento económico. Panamá tiene actualmente el potencial para superar muchos de los retos para reducir la pobreza, transformar la vida cotidiana y encontrar nuevas formas de proteger el planeta. Una mirada estratégica al desarrollo de la nación pasa precisamente por una acción integral y conjunta que permita superar los contratiempos metodológicos del comienzo y ponerse en sintonía con el futuro y dimensionar los retos que, como país, aspira definir sus prioridades en el Desarrollo Nacional y actuar en consecuencia\".\n\n El PEN se ha planteado cinco Objetivos Meta que fundamentan hoy el desarrollo del país: \n1. Buena vida para todos; \n2 Crecer más y mejor; \n3. Sostenibilidad ambiental; \n4. Democracia, institucionalidad y gobernanza; \n5. Alianzas estratégicas para el desarrollo. De cada uno de estos Objetivo Meta se desprenden estrategias, objetivos y énfasis.","description_en":"The President of the Republic of Panama, Juan Carlos Varela, announced in his speech on January 2, 2016, his decision to call upon all social and political forces in the country to engage in a dialogue—through the National Council for Sustainable Development (CCND)—aimed at adopting a National Strategic Plan with a State Vision “Panama 2030” (PEN 2030). This plan seeks to make the 17 Sustainable Development Goals (SDGs)—approved by the United Nations and adopted in Panama through Executive Decree No. 393 of September 2015—a national reality.\n\nThe vision of PEN 2030 is grounded in the idea that:\n“Full development beyond 2015 is a strategic goal for the country, as it represents the hope and opportunity to achieve full inclusion of citizens and their integration into economic growth. Panama currently has the potential to overcome many of the challenges to reduce poverty, transform daily life, and find new ways to protect the planet. A strategic vision for national development requires precisely an integrated and collective action to overcome early methodological challenges, align with the future, and define the priorities that the country aspires to pursue in its national development agenda.”\n\nThe PEN 2030 establishes five overarching goals that currently guide the country’s development:\n1. Good living for all\n2. Grow more and better\n3. Environmental sustainability\n4. Democracy, institutional strength, and governance\n5. Strategic partnerships for development\n\nEach of these overarching goals gives rise to specific strategies, objectives, and priorities for implementation.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:47513393-328b-43b0-bfcf-c5c2fbf76817","meta/deprecatedID":"uuid:608512da-4579-40e6-93ec-991f7381b105","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"47513393-328b-43b0-bfcf-c5c2fbf76817","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:47513393-328b-43b0-bfcf-c5c2fbf76817"},{"_id":46596,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:19.808","end":"2025-11-07T14:27:19.808","id_drupal":"1175","country":"pan","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico de Gobierno 2019-2024 de Panamá","name_en":"Strategic Government Plan 2019-2024 for Panama","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)","responsible_institution/id_institution":"44942","responsible_institution/name_institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)"}],"link":"fa1389fa-07a3-45a4-a5d9-1cd5e6bde3f2","primary_link":"https://www.mef.gob.pa/plan-estrategico-de-gobierno/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"Así como establece, en su Artículo 16, la Ley 34 del 2008, al inicio de cada administración, y dentro de los primeros seis meses de su mandato, se debe elaborar y aprobar un nuevo Plan Estratégico de Gobierno (PEG) enmarcado dentro de los objetivos y metas que surgen de la Concertación Nacional. Apoyado en los decretos 147, 148 y 149 se aprueba en diciembre 2019 el nuevo PEG para el período 2019-2024.\n\nAdemás de un diagnóstico inicial, en el que se detalla la situación actual del país y su estado financiero, el Plan comprende una estrategia económica y social integrada por cinco pilares estratégicos, a saber:\n1. Buen Gobierno\n2. Estado de Derecho\n3. Economía Competitiva que genere empleos\n4. Combate a la Pobreza y la Desigualdad\n5. Educación, Ciencia, Tecnología y Cultura\n\nCada pilar estratégico cuenta con una serie objetivos específicos de los que se desprenden las tareas principales. Además, también se destaca una acción prioritaria para cada objetivo para implementar a corto plazo con efectos al mediano plazo. \n\nAdicionalmente el PEG 2019-2014 incorpora el Plan Quinquenal de Inversiones (PQI) el cual detalla las iniciativas de inversión programadas por las entidades que conforman el Sector Público No Financiero. De acuerdo con el Artículo 16 de la Ley N° 34 de Responsabilidad Social Fiscal (LRSF) el PQI debe de ser actualizado anualmente. La elaboración y actualización del PQI es responsabilidad de la Dirección de Programación de Inversiones (DPI) del Ministerio de Economía y Finanzas (MEF). Dentro del PQI 2019-2024 se incluyen 125 proyectos y programas de inversión considerados como prioritarios, para cada uno de ellos se indica el nombre del proyecto, pilar estratégico al que contribuyen y entidad responsable de su ejecución. \n\nEl PEG se encuentra alineado a los objetivos de largo plazo del Plan Estratégico Nacional con Visión de Estado (PEN) Panamá 2030.","description_en":"As established in Article 16 of Law No. 34 of 2008, at the beginning of each administration and within the first six months of its mandate, a new Government Strategic Plan (PEG) must be prepared and approved, framed within the objectives and goals arising from the National Concertation process. Supported by Decrees 147, 148, and 149, the new PEG for the 2019–2024 period was approved in December 2019.\n\nIn addition to an initial diagnosis describing the country’s current situation and financial status, the Plan includes an economic and social strategy structured around five strategic pillars:\n1. Good Governance\n2. Rule of Law\n3. Competitive Economy that Generates Employment\n4. Combating Poverty and Inequality\n5. Education, Science, Technology, and Culture\n\nEach strategic pillar contains a series of specific objectives from which the main tasks are derived. Moreover, each objective identifies a priority action to be implemented in the short term, expected to yield medium-term effects.\n\nAdditionally, the PEG 2019–2024 incorporates the Five-Year Investment Plan (PQI), which details the investment initiatives programmed by entities that make up the Non-Financial Public Sector. According to Article 16 of the Law No. 34 on Fiscal Social Responsibility (LRSF), the PQI must be updated annually. The Investment Programming Directorate (DPI) of the Ministry of Economy and Finance (MEF) is responsible for preparing and updating it. The PQI 2019–2024 includes 125 priority investment projects and programs, each specifying the project name, the strategic pillar it contributes to, and the executing entity responsible.\n\nThe PEG is aligned with the long-term objectives of the National Strategic Plan with a State Vision (PEN) Panama 2030.","linking_sdg_plans":"no","ipd/ipd_type":"government","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:db3e5850-7481-48e1-ac50-f630f8caa24a","meta/deprecatedID":"uuid:730dc51d-5637-4f43-8bec-6e68f3a50928","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"db3e5850-7481-48e1-ac50-f630f8caa24a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:db3e5850-7481-48e1-ac50-f630f8caa24a"},{"_id":46597,"start":"2025-11-07T14:27:20.526-03:00","end":"2026-03-16T17:02:40.758-03:00","id_drupal":"10060","country":"pan","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico de Gobierno 2025-2029","name_en":"Strategic Government Plan 2025-2029","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)","responsible_institution/id_institution":"44942","responsible_institution/name_institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)"}],"link":"7d38dd21-cc94-4d64-99ed-d44c3a14e32c","primary_link":"https://www.mef.gob.pa/plan-estrategico-de-gobierno/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2029-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Estratégico de Gobierno 2025‑2029 (PEG) de Panamá es el instrumento quinquenal que orienta la estrategia del Gobierno de cara al periodo 2025‑2029, con el objetivo de que el crecimiento económico se traduzca en bienestar social y oportunidades equitativas para todos los panameños.\n\nEntre sus pilares estratégicos destacan: el fortalecimiento de la infraestructura logística y de conectividad, la transformación del país en un hub global de comercio y servicios, la sostenibilidad ambiental combinada con responsabilidad fiscal, y el acceso equitativo a la educación, tecnología e innovación.\n\nEl documento integra un programa de inversiones públicas de amplio alcance, presupuesto quinquenal, metas de reducción del déficit fiscal y moderación de la deuda pública, así como un sistema de seguimiento y evaluación bajo la coordinación del Ministerio de Economía y Finanzas de Panamá.","description_en":"The Strategic Government Plan 2025‑2029 (PEG) of Panama is the five‑year policy instrument guiding the Government’s strategic direction for 2025‑2029, with the aim that economic growth translates into social welfare and equitable opportunities for all Panamanians.\n\nKey strategic pillars include: strengthening logistics and connectivity infrastructure, transforming Panama into a global trade and services hub, combining environmental sustainability with fiscal responsibility, and ensuring equitable access to education, technology and innovation.\n\nThe plan incorporates a large‑scale public investment program, a quinquennial budget framework, targets for deficit reduction and debt moderation, and a monitoring and evaluation system coordinated by the Ministry of Economy and Finance of Panama.","linking_sdg_plans":"no","ipd/ipd_type":"government","ipd/ipd_legal_framework":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","meta/instanceID":"uuid:a9a7f90c-aa03-49d5-befb-6540d0b187e5","meta/deprecatedID":"uuid:c6a8bf3c-b05a-4119-bf4c-e45a97d49498","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a9a7f90c-aa03-49d5-befb-6540d0b187e5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:19","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a9a7f90c-aa03-49d5-befb-6540d0b187e5"},{"_id":46598,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:21.246","end":"2025-11-07T14:27:21.246","id_drupal":"449","country":"per","theme":"development_planning","original_language":"es","name_es":"Plan Bicentenario","name_en":"Bicentennial Plan","responsible_institution":[{"responsible_institution/institution":"Centro Nacional de Planeamiento Estratégico (CEPLAN) de Perú","responsible_institution/id_institution":"45406","responsible_institution/name_institution":"Centro Nacional de Planeamiento Estratégico (CEPLAN) de Perú"}],"link":"ab954f65-a1bc-4216-8d34-ca1f419ec48c","primary_link":"https://www.ceplan.gob.pe/documentos_/plan-bicentenario-el-peru-hacia-el-2021/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2011-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"El Plan Bicentenario: El Perú hacia el 2021 es un instrumento de planificación de largo plazo formulado por el Centro Nacional de Planeamiento Estratégico (CEPLAN). Su propósito es articular una visión compartida de país para el siglo XXI, así como definir los lineamientos, prioridades, objetivos, metas y acciones estratégicas que orientarán el desarrollo armónico, integral y sostenible del país hasta el año 2021.\n\nEl plan está estructurado en torno a seis ejes estratégicos principales:\n1. Derechos fundamentales y dignidad de las personas.\n2. Oportunidades y acceso a los servicios.\n3. Estado y gobernabilidad.\n4. Economía, competitividad y empleo.\n5. Desarrollo regional e infraestructura.\n6. Recursos naturales y ambiente.\n\nCada eje contiene objetivos específicos, lineamientos de política, prioridades, metas y programas estratégicos. El documento se formuló mediante un proceso participativo amplio, que involucró diversos actores sociales, gubernamentales y regionales. Además, incluye un marco de seguimiento y evaluación que busca garantizar la coherencia entre las políticas nacionales, los planes sectoriales y los instrumentos de presupuesto público.","description_en":"The Bicentennial Plan: Peru towards 2021 is a long‑term strategic planning instrument developed by the National Center for Strategic Planning (CEPLAN). Its objective is to articulate a shared national vision for the 21st century and define the policy guidelines, priorities, objectives, targets, and strategic actions to guide Peru’s harmonious, integral and sustainable development until 2021.\n\nThe plan is structured around six strategic axes:\n1. Fundamental rights and human dignity.\n2. Opportunities and access to services.\n3. State and governance.\n4. Economy, competitiveness and employment.\n5. Regional development and infrastructure.\n6. Natural resources and the environment.\n\nEach axis comprises specific objectives, policy guidelines, priorities, targets and strategic programmes. The document was developed through a comprehensive participatory process involving social, governmental and regional stakeholders. It also includes a monitoring and evaluation framework to ensure alignment between national policies, sectoral plans and public budget instruments.","linking_sdg_plans":"no","ipd/ipd_type":"development","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:7cd75aee-7ec7-41de-8904-99bceab8cf07","meta/deprecatedID":"uuid:dac70c1d-43f1-43d4-8eb7-db9f9bb2c792","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7cd75aee-7ec7-41de-8904-99bceab8cf07","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:20","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7cd75aee-7ec7-41de-8904-99bceab8cf07"},{"_id":46599,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:21.967","end":"2025-11-07T14:27:21.967","id_drupal":"1747","country":"col","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad urbana de Santiago de Cali. Visión 2030","name_en":"Comprehensive Urban Mobility Plan for Santiago de Cali. Vision 2030","responsible_institution":[{"responsible_institution/institution":"Departamento Administrativo de Planeación Municipal, Subdirección de Planificación del Territorio","responsible_institution/id_institution":"45553","responsible_institution/name_institution":"Departamento Administrativo de Planeación Municipal, Subdirección de Planificación del Territorio"}],"link":"faa8531b-aa09-4be4-9a00-858f0a825e2d","primary_link":"https://idesc.cali.gov.co/download/movilidad/pimu/02_doc_tec_sop/dts_part_2_pimu.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Municipio de Santiago de Cali (con estatus de Distrito Especial)","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"no","linking_sdg_plans":"yes","pmu/pmu_prioritization_type":"public","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:05143b85-dd49-44b0-aff2-8a0425ebc8b2","meta/deprecatedID":"uuid:55319758-a35d-4066-8386-4c3be0ff324a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"05143b85-dd49-44b0-aff2-8a0425ebc8b2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:21","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:05143b85-dd49-44b0-aff2-8a0425ebc8b2"},{"_id":46600,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:22.682","end":"2025-11-07T14:27:22.682","id_drupal":"372","country":"vct","theme":"development_planning","original_language":"en","name_es":"Plan Nacional de Desarrollo Económico y Social 2013-2025 de San Vicente y las Granadinas","name_en":"National Economic and Social Development Plan 2013-2025 of Saint Vincent and the Grenadines","responsible_institution":[{"responsible_institution/institution":"División Central de Planificación (CPD) (actual Unidad de Planificación Económica y Desarrollo Social)","responsible_institution/id_institution":"45332","responsible_institution/name_institution":"División Central de Planificación (CPD) (actual Unidad de Planificación Económica y Desarrollo Social)"}],"link":"fcd4ab64-3b82-41ba-9bca-bbe79eabcc36","primary_link":"https://finance.gov.vc/finance/index.php/economic-planning-industry-and-social-development/national-economic-a-social-development-plan","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"Este Plan Nacional de Desarrollo Económico y Social (PNDES) toma en consideración los anteriores esfuerzos de planificación integral y sectorial realizados en San Vicente y las Granadinas. Por lo tanto, no parte de una hoja en blanco. De hecho, el Plan refleja el pensamiento que ha estado presente en los doce presupuestos nacionales que las sucesivas administraciones han presentado durante los últimos doce años, desde marzo de 2001.\n\nEl financiamiento para la preparación y elaboración de este Plan fue proporcionado por la Unión Europea (UE), a través de su programa continuo de cooperación con el gobierno de San Vicente y las Granadinas.\n\nEl Plan de Desarrollo de San Vicente y las Granadinas 2013-2025 ha sido elaborado en torno a un conjunto específico de metas, objetivos y propósitos estratégicos, con el fin de facilitar y orientar la mejora óptima de la calidad de vida de todos los vicentinos.\n\nEl Ministerio de Finanzas y Planificación Económica es responsable de monitorear el progreso del Plan mediante la revisión de los informes anuales de los ministerios, departamentos y agencias. El desempeño será evaluado con base en los indicadores acordados previamente, los cuales se adjuntan al documento.","description_en":"This National Economic and Social Development Plan (NESDP) takes account of earlier comprehensive and sectoral, planning efforts in St. Vincent and the Grenadines. Thus, it does not begin with a blank page. Indeed, the Plan reflects thinking which has been evident in the twelve national budgets which the successive administrations have delivered over the past twelve years, thus far, since March 2001.\n\n Financing for the preparation and production of this Plan was provided by the European Union (EU), through its continued cooperation programme with the government of St. Vincent and the Grenadines.\n\nThe St. Vincent and the Grenadines Development Plan 2013 - 2025 has been elaborated around a specific set of strategic goals, objectives and targets so as to facilitate and guide the optimal improvement of the quality of life for all Vincentians.\n\n The Ministry of Finance and Economic Planning is responsible the monitoring the Plan progress by reviewing annual reports from Ministries, departments and agencies. Performance will be assessed, based on the indicators agreed to a priori, and appended. ","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:d3cd79ed-bbaa-42b3-ba75-45d15fc17d07","meta/deprecatedID":"uuid:37ae0b98-bc04-4b5c-987b-6085fed57080","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d3cd79ed-bbaa-42b3-ba75-45d15fc17d07","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:21","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d3cd79ed-bbaa-42b3-ba75-45d15fc17d07"},{"_id":46601,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:23.398","end":"2025-11-07T14:27:23.398","id_drupal":"1012","country":"per","theme":"development_planning","original_language":"es","name_es":"Visión a 2050 de Perú","name_en":"Vision to 2050 of Peru","responsible_institution":[{"responsible_institution/institution":"Centro Nacional de Planeamiento Estratégico (CEPLAN) de Perú","responsible_institution/id_institution":"45406","responsible_institution/name_institution":"Centro Nacional de Planeamiento Estratégico (CEPLAN) de Perú"}],"link":"5a77513a-4dc6-4ef2-aea8-4dc5f03d7ff1","primary_link":"https://www.ceplan.gob.pe/visionperu2050/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Visión del Perú es el elemento orientador de la acción del Estado y la sociedad para alcanzar el desarrollo sostenible del país en el largo plazo. Su realización se concreta a través de la actualización e implementación de políticas y planes en los distintos sectores, niveles de gobierno e instituciones.\n\nEn el nivel de Estado, la Visión permitirá la revisión de las Políticas de Estado post 2021 y es la base para la formulación del Plan Estratégico de Desarrollo Nacional (PEDN), el cual debe contener los lineamientos, las prioridades, los objetivos, las metas y las acciones para el desarrollo armónico, sostenible y descentralizado del país, de forma consistente en el tiempo, trascendiendo los cambios de gobierno.\n\nPara implementar la Visión del Perú al 2050, se continuará convocando al Foro del Acuerdo Nacional, como instancia de concertación de la planificación estratégica nacional, y, de manera amplia, a toda entidad o persona que esté interesada.","description_en":"Peru’s National Vision serves as the guiding framework for the actions of both the State and society to achieve the country’s long-term sustainable development. Its realization takes place through the updating and implementation of policies and plans across different sectors, levels of government, and institutions.\n\nAt the State level, the Vision enables the review of the State Policies after 2021 and forms the basis for the formulation of the National Strategic Development Plan (PEDN), which must outline the guidelines, priorities, objectives, targets, and actions aimed at ensuring the country’s harmonious, sustainable, and decentralized development over time—transcending changes in government administrations.\n\nTo implement the Vision of Peru to 2050, the National Agreement Forum will continue to be convened as the space for strategic national planning dialogue and consensus-building, along with broad participation from any entity or individual interested in contributing to the process.","linking_sdg_plans":"no","ipd/ipd_vision_es":"Síntesis de la Visión a 2050:\nAl 2050, somos un país democrático, respetuoso del Estado de derecho y de la institucionalidad, integrado al mundo y proyectado hacia un futuro que garantiza la defensa de la persona humana y de su dignidad en todo el territorio nacional.\nEstamos orgullosos de nuestra identidad, propia de la diversidad étnica, cultural y lingüística del país. Respetamos nuestra historia y patrimonio milenario, y protegemos nuestra biodiversidad.\nEl Estado constitucional es unitario y descentralizado. Su accionar es ético, transparente, eficaz, eficiente, moderno y con enfoque intercultural.\nJuntos, hemos logrado un desarrollo inclusivo, en igualdad de oportunidades, competitivo y sostenible en todo el territorio nacional, que ha permitido erradicar la pobreza extrema y asegurar el fortalecimiento de la familia.","ipd/ipd_vision_en":"Summary of the Vision to 2050:\nBy 2050, Peru is a democratic country, respectful of the rule of law and institutional integrity, integrated into the world and projected toward a future that guarantees the protection of human dignity across the national territory.\nWe are proud of our identity, rooted in the country’s ethnic, cultural, and linguistic diversity. We respect our history and millenary heritage, and safeguard our biodiversity.\nThe constitutional State is unitary and decentralized, and its governance is ethical, transparent, effective, efficient, modern, and guided by an intercultural approach.\nTogether, we have achieved inclusive development—competitive, sustainable, and based on equal opportunities throughout the national territory—which has enabled us to eradicate extreme poverty and strengthen the family as the foundation of society.","ipd/ipd_type":"vision","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:4c4917b4-f601-48e0-acdb-b6232ec8b3eb","meta/deprecatedID":"uuid:74c42d41-6e7d-4724-a8c9-0fc0fed63afd","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4c4917b4-f601-48e0-acdb-b6232ec8b3eb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:22","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4c4917b4-f601-48e0-acdb-b6232ec8b3eb"},{"_id":46602,"start":"2025-11-07T14:27:24.124-04:00","end":"2026-07-14T15:11:48.209-04:00","id_drupal":"1728","country":"per","theme":"development_planning","original_language":"es","name_es":"Plan Estratégico de Desarrollo Nacional al 2050 de Perú","name_en":"National Strategic Development Plan to 2050 of Peru","responsible_institution":[{"responsible_institution/institution":"Centro Nacional de Planeamiento Estratégico (CEPLAN) de Perú","responsible_institution/id_institution":"45406","responsible_institution/name_institution":"Centro Nacional de Planeamiento Estratégico (CEPLAN) de Perú"}],"link":"b4071f63-45dc-4942-82fa-35811571db1e","primary_link":"https://www.gob.pe/institucion/ceplan/informes-publicaciones/4637571-peru-plan-estrategico-de-desarrollo-nacional-al-2050","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan fue aprobado mediante Decreto Supremo Nº 095-2022-PCM.\n\nEl CEPLAN condujo el proceso de formulación del Plan, cuya propuesta fue puesta a disposición de la ciudadanía para recibir aportes y comentarios.\n\nTodas las entidades que integran el Sistema Nacional de Planeamiento Estratégico deben articular sus Planes Estratégicos a los Objetivos Nacionales, Objetivos Específicos y a las Acciones Estratégicas previstas en el Plan Estratégico de Desarrollo Nacional al 2050.\n\nEste documento, que tiene como base lineamientos de política, prioridades, objetivos, metas y acciones de orden estratégico, propone cuatro Objetivos Nacionales:\n\n1) Alcanzar el pleno desarrollo de las capacidades de las personas sin dejar a nadie atrás;\n2) Gestionar el territorio de manera sostenible a fin de prevenir y reducir los riesgos y amenazas que afectan a las personas y sus medios de vida, con el uso intensivo del conocimiento y las comunicaciones, reconociendo la diversidad geográfica y cultural, en un contexto de cambio climático;\n3) Elevar los niveles de competitividad y productividad con empleo decente y en base al aprovechamiento sostenible de los recursos, el capital humano, el uso intensivo de la ciencia y tecnología, y la transformación digital del país; y\n4) Garantizar una sociedad justa, democrática, pacífica y un Estado efectivo al servicio de las personas, en base al diálogo, la concertación nacional y el fortalecimiento de las instituciones.","description_en":"The Plan was approved through Supreme Decree No. 095-2022-PCM.\n\nThe National Center for Strategic Planning (CEPLAN) led the formulation process of the Plan, whose draft was made available to the public for comments and contributions.\n\nAll entities that are part of the National Strategic Planning System must align their Strategic Plans with the National Objectives, Specific Objectives, and Strategic Actions established in the National Strategic Development Plan to 2050.\n\nThis document—based on policy guidelines, priorities, objectives, targets, and strategic actions—sets out four National Objectives:\n1. Achieve the full development of people’s capacities, leaving no one behind;\n2. Manage the territory sustainably to prevent and reduce risks and threats that affect people and their livelihoods, through the intensive use of knowledge and communications, while recognizing geographic and cultural diversity in the context of climate change;\n3. Increase competitiveness and productivity through decent employment, the sustainable use of resources, human capital development, the intensive use of science and technology, and the country’s digital transformation; and\n4. Ensure a just, democratic, and peaceful society and an effective State at the service of the people, based on dialogue, national consensus, and institutional strengthening.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_tracking":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:f5b1414f-124b-4c18-9143-2a671526f58b","meta/deprecatedID":"uuid:0d49cfb5-1a1e-48c9-8847-2eec229e763b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f5b1414f-124b-4c18-9143-2a671526f58b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f5b1414f-124b-4c18-9143-2a671526f58b"},{"_id":46603,"start":"2025-11-07T14:27:24.849-03:00","end":"2026-03-13T11:15:15.256-03:00","id_drupal":"104","country":"pry","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo Paraguay 2030","name_en":"National Development Plan Paraguay 2030","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"link":"54b9f03d-242a-4f49-9f3e-f673b5871331","primary_link":"https://www.stp.gov.py/pnd/wp-content/uploads/2014/12/pnd2030.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo: Paraguay 2030, es aprobado por el decreto N° 2794 de la Presidencia de la República.\n\nCuenta con tres ejes estratégicos para: la reducción de la pobreza y desarrollo social, el crecimiento económico inclusivo y la inserción del Paraguay al mundo en forma adecuada. De estos ejes se desprenden 12 estrategias para alcanzar el desarrollo y aumentar la calidad de vida de la población.\n\nJunto al Plan se establece un de sistema de seguimiento, monitoreo y evaluación a cargo de la Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP). En cuanto a la evaluación, se destaca el avance en la implementación del enfoque de gestión por resultados.","description_en":"The National Development Plan: Paraguay 2030 was approved by Decree No. 2794 of the Office of the President of the Republic.\n\nIt is structured around three strategic pillars aimed at: reducing poverty and promoting social development, fostering inclusive economic growth, and ensuring Paraguay’s effective integration into the global context. From these pillars stem 12 strategies designed to drive development and improve the population’s quality of life.\n\nAlongside the Plan, a monitoring, follow-up, and evaluation system was established under the responsibility of the Technical Secretariat for Economic and Social Development Planning (STP). Regarding evaluation, notable progress has been made in implementing a results-based management approach.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_8 sdg_9 sdg_10 sdg_16","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"no","ipd/ipd_tracking":"no","ipd/ipd_investment":"no","ipd/ipd_indicators":"no","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema de Planificación por Resultados (SPR) del Paraguay","link_block/snp_id":"37680","link_block/snp_name":"Sistema de Planificación por Resultados (SPR) del Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Decreto No. 2794-2014 de Paraguay","link_block/legal_id":"49629","link_block/legal_name":"Decreto No. 2794-2014 de Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Constitución de 1992 de la República del Paraguay","link_block/legal_id":"49470","link_block/legal_name":"Constitución de 1992 de la República del Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Decreto Ley No. 312-1962 de Paraguay","link_block/legal_id":"49623","link_block/legal_name":"Decreto Ley No. 312-1962 de Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal"}],"meta/instanceID":"uuid:1717c69e-4404-4adc-817e-8746f55d022a","meta/deprecatedID":"uuid:e35be607-ea20-4ac1-a1dd-28767cc50764","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1717c69e-4404-4adc-817e-8746f55d022a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1717c69e-4404-4adc-817e-8746f55d022a"},{"_id":46604,"start":"2025-11-07T14:27:25.558-03:00","end":"2026-03-13T11:15:41.696-03:00","id_drupal":"1678","country":"pry","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo Paraguay 2030: Avances y actualización 2021","name_en":"National Development Plan Paraguay 2030: Progress and Update 2021","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"link":"98033603-8867-41bf-bbf3-a491eff4002a","primary_link":"https://www.stp.gov.py/pnd/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"El PND se encuentra alineado en un 92% con los Objetivos del Desarrollo Sostenible y está compuesto por cuatro ejes estratégicos: la Reducción de Pobreza y Desarrollo social; el Crecimiento económico inclusivo; la Proyección de Paraguay en el mundo; y el Fortalecimiento Político-Institucional.\n\nCada eje estratégico incorpora cuatro ejes transversales: la igualdad de oportunidades; la gestión pública eficiente y transparente; el ordenamiento y desarrollo territorial; y la sostenibilidad ambiental.\n\nLa interacción de los 4 ejes estratégicos con los 4 ejes transversales, resulta en 16 objetivos estratégicos y 70 objetivos específicos que permiten la identificación de los desafíos fundamentales de desarrollo del país. El PND es de cumplimiento obligatorio para el sector público e indicativo para el sector privado.","description_en":"The National Development Plan (NDP) is 92% aligned with the Sustainable Development Goals (SDGs) and is structured around four strategic pillars: poverty reduction and social development, inclusive economic growth, Paraguay’s projection in the world, and political and institutional strengthening.\n\nEach strategic pillar incorporates four cross-cutting axes: equal opportunities, efficient and transparent public management, territorial planning and development, and environmental sustainability.\n\nThe interaction between the four strategic pillars and the four cross-cutting axes results in 16 strategic objectives and 70 specific objectives, which enable the identification of the country’s main development challenges. The NDP is binding for the public sector and indicative for the private sector.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_8 sdg_9 sdg_10 sdg_11 sdg_13 sdg_16 sdg_17","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"no","ipd/ipd_tracking":"yes","ipd/ipd_investment":"no","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema de Planificación por Resultados (SPR) del Paraguay","link_block/snp_id":"37680","link_block/snp_name":"Sistema de Planificación por Resultados (SPR) del Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Nacional de Desarrollo Paraguay 2030","link_block/plan_id":"46603","link_block/plan_name":"Plan Nacional de Desarrollo Paraguay 2030"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Constitución de 1992 de la República del Paraguay","link_block/legal_id":"49470","link_block/legal_name":"Constitución de 1992 de la República del Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Decreto No. 2794-2014 de Paraguay","link_block/legal_id":"49629","link_block/legal_name":"Decreto No. 2794-2014 de Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Decreto No. 2794-2014 de Paraguay","link_block/legal_id":"49629","link_block/legal_name":"Decreto No. 2794-2014 de Paraguay"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Decreto Nº 3581 de Paraguay","link_block/legal_id":"49628","link_block/legal_name":"Decreto Nº 3581 de Paraguay"}],"meta/instanceID":"uuid:765eb179-1de5-4aa7-9b83-f134fab88225","meta/deprecatedID":"uuid:e0cf3f97-0b9d-4247-b100-a418b36b4682","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"765eb179-1de5-4aa7-9b83-f134fab88225","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:24","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:765eb179-1de5-4aa7-9b83-f134fab88225"},{"_id":46605,"start":"2025-11-07T14:27:26.274-04:00","end":"2026-05-12T12:50:46.256-04:00","id_drupal":"10084","country":"per","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Cajamarca (2025-2026)","name_en":"1st Open Government Action Plan of Cajamarca (2025–2026)","responsible_institution":[{"responsible_institution/institution":"Gobierno Regional de Cajamarca","responsible_institution/id_institution":"45389","responsible_institution/name_institution":"Gobierno Regional de Cajamarca"}],"coordinator":"Foro Multiactor de Gobierno Abierto (Cajamarca)","id_coordinator":"51465","name_coordinator":"Foro Multiactor de Gobierno Abierto (Cajamarca)","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-cajamarca-peru-2025-2026/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Departamento/ Región de Cajamarca","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El 1er Plan de Acción de Gobierno Abierto de Cajamarca (2025–2026) es el instrumento estratégico mediante el cual el gobierno local inicia la implementación de una política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan representa un hito institucional al establecer por primera vez una agenda estructurada orientada a promover la transparencia, la participación ciudadana, la rendición de cuentas y la innovación pública en la gestión municipal.\n\nEl plan se concibe como un punto de partida para la consolidación de un modelo de gobernanza más abierto, inclusivo y colaborativo, adaptado al contexto territorial y alineado con estándares internacionales. En este sentido, busca fortalecer las capacidades institucionales del gobierno local, mejorar la relación entre el Estado y la ciudadanía, y promover una cultura de apertura en la gestión pública.\n\nSu elaboración se llevó a cabo mediante un proceso de cocreación que involucró a entidades del gobierno local, organizaciones de la sociedad civil, academia y ciudadanía. A través de espacios participativos, consultas públicas y mesas de trabajo, se definieron compromisos orientados a responder a prioridades locales y a fortalecer la legitimidad de la acción pública. Este enfoque participativo también se proyecta en la implementación del plan, que contempla mecanismos de seguimiento conjunto y evaluación participativa.\n\nEntre sus principales líneas de acción se encuentran el fortalecimiento de la transparencia y el acceso a la información pública, la promoción de la participación ciudadana mediante herramientas digitales y presenciales, el impulso de estrategias de datos abiertos y el desarrollo de iniciativas de innovación pública. Asimismo, el plan incorpora enfoques transversales como la inclusión, la equidad y el uso de tecnologías digitales para mejorar la gestión pública y la prestación de servicios.\n\nEn conjunto, el Primer Plan de Acción de Cajamarca busca sentar las bases para la institucionalización del gobierno abierto en el ámbito local, promoviendo un modelo de gestión más transparente, participativo y orientado a resultados, con el objetivo de mejorar la calidad de vida de la ciudadanía y fortalecer la confianza en las instituciones públicas.","description_en":"The 1st Open Government Action Plan of Cajamarca (2025–2026) is the strategic instrument through which the local government initiates the implementation of an open government policy within the framework of the Open Government Partnership (OGP) at the local level. This plan represents an important institutional milestone, as it establishes for the first time a structured agenda aimed at promoting transparency, citizen participation, accountability, and public sector innovation in local governance.\n\nThe plan is conceived as a starting point for consolidating a more open, inclusive, and collaborative governance model, adapted to the territorial context and aligned with international standards. In this regard, it seeks to strengthen institutional capacities, improve the relationship between government and citizens, and promote a culture of openness in public management.\n\nIt was developed through a co-creation process involving local government entities, civil society organizations, academia, and citizens. Through participatory spaces, public consultations, and working groups, commitments were defined to address local priorities and enhance the legitimacy of public action. This participatory approach is also reflected in the implementation phase, which includes joint monitoring mechanisms and participatory evaluation processes.\n\nIts main lines of action include strengthening transparency and access to public information, promoting citizen participation through both digital and in-person tools, advancing open data strategies, and fostering public innovation initiatives. The plan also incorporates cross-cutting approaches such as inclusion, equity, and the use of digital technologies to improve public management and service delivery.\n\nOverall, the First Action Plan of Cajamarca seeks to lay the foundations for the institutionalization of open government at the local level, promoting a more transparent, participatory, and results-oriented governance model aimed at improving citizens’ quality of life and strengthening trust in public institutions.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:f1f5f355-c728-4805-a256-56ebc78674d7","meta/deprecatedID":"uuid:7133c693-a74c-4073-8e42-3d9ad103ad31","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f1f5f355-c728-4805-a256-56ebc78674d7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:25","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f1f5f355-c728-4805-a256-56ebc78674d7"},{"_id":46606,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:26.987","end":"2025-11-07T14:27:26.987","id_drupal":"336","country":"slv","theme":"development_planning","original_language":"es","name_es":"Plan Quinquenal de Desarrollo 2014-2019 \"El Salvador productivo, educado y seguro\"","name_en":"Five-Year Development Plan 2014-2019 \"El Salvador productivo, educado y seguro\"","link":"87ac999d-a8d3-49ef-b955-1b9064781c6a","primary_link":"https://www.transparencia.gob.sv/system/documents/documents/000/264/705/original/Plan_Quinquenal_de_Desarrollo_-PQD-.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Quinquenal de Desarrollo 2014 – 2019 “El Salvador productivo, educado, y seguro” se configura como la primera piedra del Sistema Nacional de Planificación del país, el cual, en primera instancia define metas de corto plazo, que deberán ser cumplidas durante los primeros cinco años a partir del 1 junio del 2014. Se estructura en torno a tres grandes prioridades: \n1. Empleo productivo generado a través de un modelo de crecimiento económico sostenido, \n2. Educación con inclusión y equidad social, y,\n3. Seguridad ciudadana efectiva. Estas tres prioridades articulan los objetivos, las estrategias y las líneas de acción...\" que permitirán hacer de El Salvador, un país más desarrollado\".\n\nEl PQD 2014-2019 fue formulado y será implementado con la participación activa de todas las instituciones de gobierno y de los diferentes sectores y actores de la sociedad, como resultado del carácter participativo y democrático del Gobierno, y por decisión expresa del presidente de la república.\n\nPosee un sistema de seguimiento, monitoreo y evaluación denominado \"Subsistema de Seguimiento y Evaluación\", que se encuentra en proceso, ya que si bien plantea las instituciones a cargo y sus funciones, no define un plan de indicadores. La institución a cargo será el SETEPLAN que además es la autoridad de planificación. Esta entidad coordinará el sistema de seguimiento y evaluación del PQD 2014-2019, para lo cual diseñará los instrumentos, mecanismos y procedimientos que se utilizarán.","description_en":"The Five-Year Development Plan (PQD) 2014–2019, titled “Productive, Educated, and Safe El Salvador,” serves as the cornerstone of the country’s National Planning System. It primarily defines short-term goals to be achieved during the first five years beginning on June 1, 2014. The plan is structured around three key priorities:\n1. Productive employment generated through a model of sustained economic growth,\n2. Education with inclusion and social equity, and\n3. Effective citizen security.\n\nThese three priorities articulate the objectives, strategies, and lines of action designed to help make El Salvador a more developed and equitable country.\n\nThe PQD 2014–2019 was formulated and will be implemented with the active participation of all government institutions and various social actors and sectors, reflecting the participatory and democratic character of the government and the explicit decision of the President of the Republic.\n\nThe plan includes a Monitoring and Evaluation Subsystem, which remains under development. While it identifies the responsible institutions and their functions, it does not yet define a full set of indicators. The Technical and Planning Secretariat of the Presidency (SETEPLAN), as the national planning authority, is responsible for coordinating this monitoring and evaluation system and for designing the necessary instruments, mechanisms, and procedures.","linking_sdg_plans":"no","ipd/ipd_vision_es":"“Un país próspero, equitativo, incluyente, seguro, solidario, y democrático que ofrece oportunidades del buen vivir a toda su población”","ipd/ipd_vision_en":"A prosperous, equitable, inclusive, safe, supportive, and democratic country that offers good living opportunities to all its people.","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9bff7a16-05a0-4c0c-95ae-f361e46131f1","meta/deprecatedID":"uuid:fcf9b021-84e8-41a0-a3f1-6f9e826b270a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9bff7a16-05a0-4c0c-95ae-f361e46131f1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9bff7a16-05a0-4c0c-95ae-f361e46131f1"},{"_id":46607,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:27.710","end":"2025-11-07T14:27:27.710","id_drupal":"345","country":"sur","theme":"development_planning","original_language":"en","name_es":"Plan de Desarrollo Político 2017-2021 de Surinam","name_en":"Policy Development Plan 2017-2021 Suriname","responsible_institution":[{"responsible_institution/institution":"Oficina Nacional de Planificación de Suriname","responsible_institution/id_institution":"45456","responsible_institution/name_institution":"Oficina Nacional de Planificación de Suriname"}],"link":"33ac5441-271a-4fe2-a970-c4451817deaf","primary_link":"https://www.planningofficesuriname.com/wp-content/uploads/2018/02/2017-2021-DEVELOPMENT-PLAN.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Artículo 40 de la Constitución establece que, con la debida observancia de los objetivos sociales y económicos del Estado, cada cinco años debe adoptarse por ley un Plan de Desarrollo. Desde la perspectiva de una planificación y política basada en resultados, el Plan de Desarrollo 2017-2021 indica los objetivos de desarrollo y los resultados esperados para amplias áreas de política.\n\nSuriname desarrollaría y adoptaría formalmente una Visión 2035 mediante un proceso participativo.","description_en":"The Article 40 of the Constitution prescribes that with due observance of the social and economic goals of the State every five years a Development Plan must be adopted by law. In terms of a result-based planning and policy approach, the Development Plan 2017-2021 indicates the development goals and the outcomes for broad policy areas.\n\nSuriname would develop and formally adopt a Vision 2035 in a participatory process. ","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_investment":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:17d13bb9-83ea-431b-87d4-2f123d4c2275","meta/deprecatedID":"uuid:41cbd780-d4de-4f03-ab88-fbf2d2f93e40","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"17d13bb9-83ea-431b-87d4-2f123d4c2275","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:17d13bb9-83ea-431b-87d4-2f123d4c2275"},{"_id":46608,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:28.460","end":"2025-11-07T14:27:28.460","id_drupal":"1764","country":"sur","theme":"development_planning","original_language":"en","name_es":"Plan de Desarrollo Multianual 2022-2026 de la República de Surinam","name_en":"Multi-Annual Development Plan 2022-2026 of the Republic Suriname","responsible_institution":[{"responsible_institution/institution":"Oficina Nacional de Planificación de Suriname","responsible_institution/id_institution":"45456","responsible_institution/name_institution":"Oficina Nacional de Planificación de Suriname"}],"link":"a19a73e6-f079-477a-a0c3-872c8fac52ce","primary_link":"https://www.planningofficesuriname.com/wp-content/uploads/2022/10/MOP-2022-2026-Volledig-FINAL-DNA-approved-Engels.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"De acuerdo con el Artículo 40 de nuestra Constitución, la Administración Santokhi-Brunswijk ha preparado este Plan de Desarrollo Plurianual (MOP) 2022-2026. Este plan constituye el punto de partida para la fase de Crecimiento y Modernización de este Gobierno y, por lo tanto, sirve como un faro de luz hacia el futuro. Un plan sólido es una necesidad para la República, que ha experimentado una significativa disrupción socioeconómica y que ahora se encuentra en una situación más estable gracias a la implementación del Plan de Recuperación 2020-2022.\n\nEl Plan de Desarrollo Plurianual 2022-2026 se basa, por lo tanto, en el Plan de Recuperación 2020-2022 y además implementa la Ley de Planificación, cuya misión es un desarrollo equilibrado y socialmente justo de la sociedad. El Plan de Desarrollo Plurianual 2022-2026 no pretende resolver todos los problemas del país ni representar todos los intereses, sino establecer una estrategia (visión, dirección, prioridades e implementación). Estas se han elegido y formulado de manera que sean factibles en términos de capacidad de implementación y capacidad financiera, y para que la República pueda responder favorablemente a oportunidades y amenazas previsibles, como la globalización y el cambio climático.\n\nEl sistema de valores que sustenta este plan está formado por la justicia, la inclusión, la libertad, la igualdad y la sostenibilidad.","description_en":"In accordance with Article 40 of our Constitution, the Santokhi-Brunswijk Administration has prepared this Multi-Annual Development Plan (MOP) 2022-2026. This plan is the starting point for the Growth and Modernization phase of this Government and therefore serves as a beacon of light into the future. A solid plan is a necessity for the Republic, which has experienced significant socio -economic disruption, and which is now in a more stable situation due to the implementation of the Recovery Plan 2020-2022.\n\nThe Multi-Annual Development Plan 2022-2026 thus builds on the Recovery Plan 2020-2022 and further implements the Planning Act, which has as its mission a balanced socially-just development of society. The Multi-Annual Development Plan 2022-2026 does not intend to solve all problems in the country and represent all interests, but rather to set out a strategy (vision, direction, priorities, and implementation). These have been chosen and formulated in such a way that they are feasible in terms of implementation capacity and financial capacity, and so that the Republic can respond favorably to foreseeable opportunities and threats, such as globalization and climate change.\n\nThe value system underlying this plan is formed by justice, inclusiveness, freedom, equality and sustainability.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:e70890d1-298b-4809-8eba-060642d7f138","meta/deprecatedID":"uuid:58411985-3045-47ac-82db-2b3d59019724","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e70890d1-298b-4809-8eba-060642d7f138","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:27","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e70890d1-298b-4809-8eba-060642d7f138"},{"_id":46609,"start":"2025-11-07T14:27:29.178-04:00","end":"2026-07-23T11:45:34.621-04:00","id_drupal":"462","country":"tto","theme":"development_planning","original_language":"en","name_es":"Visión 2030: Estrategia Nacional de Desarrollo de Trinidad y Tobago","name_en":"Vision 2030: National Development Strategy of Trinidad and Tobago","responsible_institution":[{"responsible_institution/institution":"División de Planificación de Políticas Socioeconómicas (SEPPD)","responsible_institution/id_institution":"44988","responsible_institution/name_institution":"División de Planificación de Políticas Socioeconómicas (SEPPD)"}],"link":"3765a9ca-35aa-43b5-a7e8-070136c16a84","primary_link":"https://www.planning.gov.tt/content/vision-2030","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Estrategia Nacional de Desarrollo Visión 2030 establece el marco general de políticas para el desarrollo de Trinidad y Tobago. Define la visión nacional de largo plazo hacia 2030 y las prioridades de desarrollo del país, expresadas en objetivos de corto plazo al año 2020, junto con las principales iniciativas estratégicas previstas para alcanzarlos. Es impulsada por el Poder Ejecutivo y liderada por el Ministerio de Planificación y Desarrollo.\n\nEl Ministerio de Planificación y Desarrollo, como organismo central del Gobierno responsable de la política y la planificación nacional, tiene la responsabilidad general de preparar y gestionar la Estrategia Nacional Visión 2030. Para el cumplimiento de esta función, cuenta con los aportes y la orientación de otros ministerios y departamentos gubernamentales, la Junta Asesora para el Desarrollo Económico (Economic Development Advisory Board, EDAB), el Consejo Consultivo Tripartito Nacional (National Tripartite Advisory Council, NTAC), instituciones académicas y organismos internacionales de desarrollo y financiamiento.\n\nLa Estrategia se elaboró sobre la base del amplio proceso de consulta desarrollado previamente para Visión 2020, que incluyó más de 80 consultas nacionales y la participación de 27 subcomités integrados por representantes de la academia, el sector público, el sector privado y la sociedad civil. En su formulación también participaron ministerios y departamentos gubernamentales, organismos asesores nacionales, instituciones académicas y organismos internacionales de desarrollo y financiamiento.\n\nEl documento se estructura en cinco temas de desarrollo, que representan las principales prioridades nacionales y las áreas estratégicas de intervención. Dentro de cada uno de estos temas se identifican prioridades específicas, considerando los objetivos que deben alcanzarse durante los primeros cinco años de implementación de la Estrategia.","description_en":"The Vision 2030 National Development Strategy establishes the overarching policy framework for the development of Trinidad and Tobago. It defines the country’s long-term national vision toward 2030 and its development priorities, expressed through short-term objectives for 2020, together with the main strategic initiatives designed to achieve them. It is promoted by the Executive Branch and led by the Ministry of Planning and Development.\n\nThe Ministry of Planning and Development, as the central government body responsible for national policy and planning, has overall responsibility for preparing and managing the Vision 2030 National Strategy. In carrying out this role, it receives input and guidance from other ministries and government departments, the Economic Development Advisory Board (EDAB), the National Tripartite Advisory Council (NTAC), academic institutions, and international development and financing organizations.\n\nThe Strategy was developed on the basis of the broad consultation process previously conducted for Vision 2020, which included more than 80 national consultations and the participation of 27 subcommittees composed of representatives from academia, the public sector, the private sector, and civil society. Ministries and government departments, national advisory bodies, academic institutions, and international development and financing organizations also participated in its formulation.\n\nThe document is structured around five development themes, which represent the country’s main national priorities and strategic areas of intervention. Within each theme, specific priorities are identified, taking into account the objectives to be achieved during the first five years of the Strategy’s implementation.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_8 sdg_9 sdg_10 sdg_11 sdg_12 sdg_13 sdg_14 sdg_15 sdg_16 sdg_17","ipd/ipd_vision_es":"El Gobierno de Trinidad y Tobago “vislumbra una sociedad en la que la integridad y la moralidad en la vida pública sean la máxima prioridad, donde el Gobierno sirva al bien público por encima de todo, y donde las decisiones y acciones del Gobierno se tomen en el mejor interés de todos los involucrados”.","ipd/ipd_vision_en":"The Government of Trinidad and Tobago “envisions a society in which integrity and morality in public life are of the highest priority, where the Government serves the public good above all else, and where government decisions and actions are taken in the best interests of all stakeholders.”","ipd/ipd_type":"development","ipd/ipd_legal_framework":"no","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:70ebc90b-187a-4a51-b40c-6527d1b90368","meta/deprecatedID":"uuid:03c47112-3a71-4cc3-9b1a-8c5055388d7e","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"70ebc90b-187a-4a51-b40c-6527d1b90368","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:28","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:70ebc90b-187a-4a51-b40c-6527d1b90368"},{"_id":46610,"start":"2025-11-07T14:27:29.901-03:00","end":"2026-07-29T13:01:12.369-04:00","id_drupal":"394","country":"ury","theme":"development_planning","original_language":"es","name_es":"Estrategia Nacional de Desarrollo Uruguay 2050","name_en":"National Development Strategy Uruguay 2050","responsible_institution":[{"responsible_institution/institution":"Dirección de Planificación de Uruguay (Actual Área de Planeamiento de la Oficina de Planeamiento y Presupuesto)","responsible_institution/id_institution":"45082","responsible_institution/name_institution":"Dirección de Planificación de Uruguay (Actual Área de Planeamiento de la Oficina de Planeamiento y Presupuesto)"}],"link":"2e01ff52-60cc-4c22-b303-168e553b2cdf","primary_link":"https://www.opp.gub.uy/sites/default/files/documentos/2018-05/Hacia_una_Estrategia_Nacional_de_Desarrollo_Uruguay_2050-Publicacion.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Estrategia Nacional de Desarrollo Uruguay 2050 es un instrumento de planificación estratégica de largo plazo que establece las bases para que Uruguay avance hacia un desarrollo sustentable, estructural y con visión a 2050. El documento identifica los principales desafíos del país —como el cambio demográfico, la inclusión social y territorial, la transformación productiva, la sostenibilidad ambiental y la igualdad de género— y articula una estrategia integral que combina políticas macroeconómicas, productivas, sociales, culturales y ambientales.\n\nLa Estrategia se organiza alrededor de tres ejes estratégicos:\n1. Transformación productiva sostenible\n2. Transformación social con reducción de desigualdades\n3. Transformación de las relaciones de género\n\nAdemás, incluye un proceso participativo amplio que involucró a miles de técnicos, instituciones del Estado, sociedad civil, academia y sector privado, y cuenta con un sistema de monitoreo que permitirá dar seguimiento al avance en el tiempo.\n\n*Actualmente la Estrategia se encuentra en revisión y actualización por parte de las autoridades*","description_en":"The National Development Strategy Uruguay 2050 is a long‑term strategic planning instrument that lays the foundations for Uruguay’s journey towards sustainable, structural development with a horizon to 2050. The document identifies the country’s principal challenges—such as demographic change, social and territorial inclusion, productive transformation, environmental sustainability and gender equality—and articulates an integrated strategy combining macroeconomic, productive, social, cultural and environmental policies.\n\nThe Strategy is organized around three strategic axes:\n1. Sustainable productive transformation\n2. Social transformation with inequality reduction\n3. Transformation of gender relations\n\nMoreover, it includes a broad participatory process involving thousands of experts, state institutions, civil society, academia and the private sector, and features a monitoring system to track progress over time.\n\n*The Strategy is currently being reviewed and updated by the authorities*","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_5 sdg_8 sdg_9 sdg_10 sdg_12 sdg_13 sdg_14 sdg_17","ipd/ipd_type":"development","ipd/ipd_participation":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema Nacional de Planificación de Uruguay","link_block/snp_id":"37684","link_block/snp_name":"Sistema Nacional de Planificación de Uruguay"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:462074bb-bd28-44e5-aea1-22276ed48752","meta/deprecatedID":"uuid:4cf91949-dc77-4ba8-9ccf-424f54ae4928","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"462074bb-bd28-44e5-aea1-22276ed48752","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:28","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:462074bb-bd28-44e5-aea1-22276ed48752"},{"_id":46611,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:30.605","end":"2025-11-07T14:27:30.605","id_drupal":"374","country":"ven","theme":"development_planning","original_language":"es","name_es":"Plan de la Patria 2013-2019 de Venezuela","name_en":"Homeland Plan 2013-2019 of Venezuela","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República Bolivariana de Venezuela","responsible_institution/id_institution":"45137","responsible_institution/name_institution":"Presidencia de la República Bolivariana de Venezuela"}],"link":"32ccff7b-e00d-4b64-a4b4-8415dbf5be51","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"La constitución venezolana establece como una obligación del Ejecutivo Nacional la preparación de un Plan de Desarrollo Económico y Social de la Nación, cuyas líneas generales deben ser sometidas a la aprobación de la Asamblea Nacional en el transcurso del tercer trimestre del primer año de cada período constitucional. El Plan de la Patria contempla cinco objetivos históricos que se establecen como una visión de largo plazo y de los cuales se derivan veinticuatro objetivos nacionales y ciento cincuenta objetivos estratégicos y generales.\n\nLos objetivos históricos que establecen la visión son:\n1. Defender, expandir y consolidar el bien más preciado que hemos reconquistado después de 200 años: la independencia nacional.\n2. Continuar construyendo el socialismo bolivariano del siglo XXI, en Venezuela, como alternativa al sistema destructivo y salvaje del capitalismo y con ello asegurar la “mayor suma de seguridad social, mayor suma de estabilidad política y la mayor suma de felicidad”, para nuestro pueblo.\n3. Convertir a Venezuela en un país potencia en lo social, lo económico y lo político dentro de la gran potencia naciente de América Latina y El Caribe, que garanticen la conformación de una zona de paz en nuestra América.\n4. Contribuir al desarrollo de una nueva geopolítica internacional en la cual tome cuerpo un mundo multicéntrico y pluripolar que permita lograr el equilibrio del universo y garantizar la paz planetaria.\n5. Preservar la vida en el planeta y salvar la especie humana.","description_en":"The Venezuelan Constitution establishes it as a duty of the National Executive to prepare the Economic and Social Development Plan of the Nation, whose general guidelines must be submitted for approval by the National Assembly during the third quarter of the first year of each constitutional term.\n\nThe Plan de la Patria includes five historical objectives that define a long-term vision, from which twenty-four national objectives and one hundred and fifty strategic and general objectives are derived.\n\nThe historical objectives outlining this vision are:\n1. To defend, expand, and consolidate the most precious good that has been regained after 200 years: national independence.\n2. To continue building 21st-century Bolivarian socialism in Venezuela as an alternative to the destructive and savage capitalist system, thereby ensuring “the greatest possible social security, political stability, and happiness” for the people.\n3. To transform Venezuela into a social, economic, and political power within the emerging great power of Latin America and the Caribbean, ensuring the formation of a zone of peace in the region.\n4. To contribute to the development of a new international geopolitics, fostering a multicentric and multipolar world that achieves global balance and ensures planetary peace.\n5. To preserve life on the planet and save the human species.","linking_sdg_plans":"no","ipd/ipd_vision_es":"\"Convertir a Venezuela en un País Potencia en lo social, lo económico y lo político destacando que la idea de País Potencia fue asociada no solamente al componente económico y productivo, sino además a la dimensión social, tanto\ncomo una potencia sustentada en el componente educativo transformador, como en función de una visión de relación entre los humanos y la naturaleza en la cual esta última es considerada como sujeto y no como mero objeto mercantilizable\"","ipd/ipd_vision_en":"“To transform Venezuela into a social, economic, and political power.”\nThe notion of “national power” is understood not only in economic and productive terms but also in its social and educational dimensions, promoting a transformative approach to education and a harmonious relationship between humans and nature, where nature is regarded as a subject, not merely as a commodifiable object.","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:42dae074-b308-4e56-9d49-f42adb844189","meta/deprecatedID":"uuid:eb58183a-eeed-4e9b-b595-c0906af27f0a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"42dae074-b308-4e56-9d49-f42adb844189","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:42dae074-b308-4e56-9d49-f42adb844189"},{"_id":46612,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:31.314","end":"2025-11-07T14:27:31.314","id_drupal":"10051","country":"gtm","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública (PIP). Cartera Completa 2024-2028 e Inversión Social 2024","name_en":"Public Investment Program (PIP). Full Portfolio 2024–2028 and Social Investment 2024","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Inversión para el Desarrollo","responsible_institution/id_institution":"45216","responsible_institution/name_institution":"Subsecretaría de Inversión para el Desarrollo"}],"link":"a24e983a-5a4c-4e86-b938-e0e7859e4dbf","primary_link":"https://apps.snip.gt/sinip/iconos/Programa_de_Inversion_Publica_2024.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"no","linking_sdg_plans":"yes","pip/pip_period":"multiannual","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:542ed0d4-0851-478d-9d63-913274822222","meta/deprecatedID":"uuid:6ca00270-f21a-4915-bcc8-7520678f82de","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"542ed0d4-0851-478d-9d63-913274822222","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:30","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:542ed0d4-0851-478d-9d63-913274822222"},{"_id":46613,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:32.027","end":"2025-11-07T14:27:32.027","id_drupal":"10052","country":"gtm","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública 2025. Cartera Completa 2025-2028","name_en":"Public Investment Program (PIP). Full Portfolio 2025–2028","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Inversión para el Desarrollo","responsible_institution/id_institution":"45216","responsible_institution/name_institution":"Subsecretaría de Inversión para el Desarrollo"}],"link":"e52aef0a-24d0-4d0d-aea6-acafd594eaae","primary_link":"https://apps.snip.gt/sinip/snipgt/PIP_2025_29-07-2024_CARTERA_COMPLETA.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"no","linking_sdg_plans":"yes","pip/pip_period":"multiannual","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:7d511421-bca1-44ba-a6e4-50d9853ce765","meta/deprecatedID":"uuid:7ab4fcf5-0093-43d5-a015-b075c31c97e7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7d511421-bca1-44ba-a6e4-50d9853ce765","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7d511421-bca1-44ba-a6e4-50d9853ce765"},{"_id":46614,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:32.734","end":"2025-11-07T14:27:32.734","id_drupal":"10053","country":"gtm","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública 2026. Cartera Completa.","name_en":"Public Investment Program 2026. Full Portfolio","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Inversión para el Desarrollo","responsible_institution/id_institution":"45216","responsible_institution/name_institution":"Subsecretaría de Inversión para el Desarrollo"}],"link":"1fcb171b-98fb-496f-85f6-8a7f86ad8fe2","primary_link":"https://apps.snip.gt/sinip/snipgt/PIP_2026_CARTERA_COMPLETA.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2026-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"short_term","visible_description":"no","linking_sdg_plans":"yes","pip/pip_period":"annual","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:52985c42-285d-4c92-a630-d05e99e3dd82","meta/deprecatedID":"uuid:d68dce6d-b2d8-4889-b2bd-fed0b7d15984","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"52985c42-285d-4c92-a630-d05e99e3dd82","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:52985c42-285d-4c92-a630-d05e99e3dd82"},{"_id":46615,"start":"2025-11-07T14:27:33.548-03:00","end":"2026-01-15T11:30:33.414-03:00","id_drupal":"10054","country":"col","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversiones 2023-2026 de Colombia","name_en":"Multi-Year Investment Plan 2023-2026 of Colombia","responsible_institution":[{"responsible_institution/institution":"Subdirección de Inversiones, Seguimiento y Evaluación","responsible_institution/id_institution":"45380","responsible_institution/name_institution":"Subdirección de Inversiones, Seguimiento y Evaluación"}],"link":"00389692-b1e8-4f90-a2d1-4a5dc991074f","primary_link":"https://www.dnp.gov.co/plan-nacional-desarrollo/pnd-2022-2026/Paginas/plan-plurianual-de-inversiones.aspx","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"no","description_es":"El Plan Plurianual de Inversiones (PPI) 2023-2026 es el instrumento de programación de las inversiones públicas que acompaña al Plan Nacional de Desarrollo (PND) 2022-2026 “Colombia, potencia mundial de la vida”. Su elaboración está a cargo del Departamento Nacional de Planeación (DNP), en coordinación con el Ministerio de Hacienda y Crédito Público, y constituye el principal referente para orientar la asignación de recursos de inversión durante el cuatrienio de gobierno.\n\nEl PPI tiene un horizonte temporal de cuatro años, correspondiente al período 2023-2026, y establece una proyección indicativa de las inversiones necesarias para cumplir los objetivos, metas y transformaciones del PND. Este instrumento permite articular la planificación de mediano plazo con los presupuestos anuales, asegurando coherencia entre las prioridades estratégicas del gobierno y la programación financiera del Estado.\n\nDesde el punto de vista normativo, el Plan Plurianual de Inversiones se formula de conformidad con lo dispuesto en la Constitución Política de Colombia, que establece la obligación de incluir un plan de inversiones públicas dentro del Plan Nacional de Desarrollo, así como con las normas orgánicas del presupuesto y la planeación. Su contenido debe ser consistente con el Marco Fiscal de Mediano Plazo y es objeto de revisión y aprobación por parte del Congreso de la República como parte integral del trámite del PND.\n\nEl PPI presenta la estimación global de los recursos de inversión para el período, así como su distribución según fuentes de financiación, entre las que se incluyen el Presupuesto General de la Nación, el Sistema General de Participaciones, el Sistema General de Regalías, los recursos de las entidades territoriales, las empresas públicas y la cooperación internacional. Asimismo, contempla el papel de la inversión privada que puede ser apalancada a partir de la inversión pública.\n\nFinalmente, el Plan Plurianual de Inversiones incorpora una dimensión participativa, a través de audiencias públicas realizadas en todo el territorio nacional, que permiten recoger insumos de actores sociales, territoriales y sectoriales. De este modo, el PPI no solo cumple una función técnica y fiscal, sino que también refuerza la transparencia, la rendición de cuentas y la articulación entre la planificación nacional y las prioridades regionales y territoriales.","description_en":"The Pluriannual Investment Plan (PPI) 2023–2026 is the public investment programming instrument that accompanies Colombia’s National Development Plan (NDP) 2022–2026, “Colombia, a World Power of Life.” It is prepared by the National Planning Department (DNP), in coordination with the Ministry of Finance and Public Credit, and serves as the main reference for guiding public investment allocation over the government’s four-year term.\n\nThe PPI has a four-year time horizon, covering the period from 2023 to 2026, and provides an indicative projection of the investments required to achieve the objectives, goals, and structural transformations set out in the NDP. It links medium-term development planning with annual budget processes, ensuring consistency between strategic priorities and the State’s financial programming.\n\nFrom a regulatory perspective, the Pluriannual Investment Plan is formulated in accordance with the Colombian Constitution, which mandates the inclusion of a public investment plan within the National Development Plan, as well as with the country’s organic budget and planning regulations. Its projections must be consistent with the Medium-Term Fiscal Framework and are subject to review and approval by the Congress of the Republic as part of the NDP legislative process.\n\nThe PPI presents an aggregate estimate of investment resources for the period and their allocation by funding sources, including the General State Budget, the General System of Transfers, the General System of Royalties, territorial entities’ own resources, public enterprises, and international cooperation. It also considers the role of private investment leveraged through public investment efforts.\n\nFinally, the Pluriannual Investment Plan incorporates a participatory dimension through public hearings held across the country, enabling the involvement of social, sectoral, and territorial stakeholders. In this way, the PPI functions not only as a technical and fiscal instrument, but also as a tool to strengthen transparency, accountability, and alignment between national planning and regional and local development priorities.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_3 sdg_4 sdg_6 sdg_7 sdg_10 sdg_11","pip/pip_project_list":"no","pip/pip_period":"multiannual","pip/pip_costing":"no","pip/pip_budget":"yes","pip/pip_budget_es":"El Plan Plurianual de Inversiones presenta la estimación agregada de los recursos de inversión previstos para el período 2023–2026, así como su distribución según las principales fuentes de financiamiento público.","pip/pip_budget_en":"The Pluriannual Investment Plan presents an aggregate estimate of the investment resources projected for the 2023–2026 period, as well as their distribution across the main public funding sources.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El Plan incorpora una perspectiva territorial a través de la identificación de prioridades regionales y la realización de audiencias públicas en todo el país, aunque no territorializa las inversiones a nivel de proyectos específicos.","pip/pip_territorialization_en":"The Plan incorporates a territorial perspective through the identification of regional priorities and the holding of public hearings across the country, although it does not territorialize investments at the level of individual projects.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"La priorización de las inversiones se realiza de manera estratégica, en coherencia con los objetivos y transformaciones del Plan Nacional de Desarrollo, sin establecer un orden explícito de proyectos individuales.","pip/pip_priorization_en":"Investment prioritization is carried out at a strategic level, in line with the objectives and transformations of the National Development Plan, without establishing an explicit ranking of individual projects.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Constitución Política de 1991 de Colombia","link_block/legal_id":"49392","link_block/legal_name":"Constitución Política de 1991 de Colombia"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley No. 1753 de Colombia","link_block/legal_id":"49433","link_block/legal_name":"Ley No. 1753 de Colombia"},{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de Colombia","link_block/snip_id":"46752","link_block/snip_name":"Sistema Nacional de Inversión Pública de Colombia"}],"meta/instanceID":"uuid:1454baa2-59c5-406a-a5ff-f3a2e80ebd8b","meta/deprecatedID":"uuid:d52b72ba-cef6-4136-a9fc-b7d841e079af","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1454baa2-59c5-406a-a5ff-f3a2e80ebd8b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:32","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1454baa2-59c5-406a-a5ff-f3a2e80ebd8b"},{"_id":46616,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:34.277","end":"2025-11-07T14:27:34.277","id_drupal":"10055","country":"dom","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversión Pública 2023-2026 de República Dominicana","name_en":"Multi-Year Public Investment Plan 2023-2026 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45392","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"link":"7ba6b926-9e90-4a79-998a-e4303fb6312b","primary_link":"https://mepyd.gob.do/pnpip-2023-2026","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"no","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_budget":"yes","pip/pip_territorialization":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:78dbc480-73d8-4c03-a8d4-7387a8ded7a1","meta/deprecatedID":"uuid:0b081c82-bd80-4370-95e9-79a285ee1331","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"78dbc480-73d8-4c03-a8d4-7387a8ded7a1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:33","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:78dbc480-73d8-4c03-a8d4-7387a8ded7a1"},{"_id":46617,"start":"2025-11-07T14:27:34.986-03:00","end":"2026-01-14T14:44:55.114-03:00","id_drupal":"10056","country":"dom","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversión Pública 2022-2025 de República Dominicana","name_en":"Multi-Year Public Investment Plan 2022-2025 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45267","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"link":"e17b463a-56cc-41e2-9633-b46b12609794","primary_link":"https://mepyd.gob.do/pnpip-2022-2025","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","visible_description":"no","description_es":"El PNPIP 2022-2025 es un instrumento de planificación que formula y prioriza los proyectos de inversión pública en un horizonte plurianual para atender las demandas y necesidades de la población dominicana. Su objetivo es alinear los proyectos de inversión pública a las prioridades definidas por el Plan Nacional Plurianual del Sector Público (PNPSP) y la Estrategia Nacional de Desarrollo 2030, asegurando que las inversiones contribuyan a las metas de desarrollo económico y social del país.\n\nEl plan presenta una lista de proyectos de inversión por sector e institución, con montos asignados para cada año del período 2022-2025. Estos proyectos están asociados a las prioridades de política de inversión establecidas por el Gobierno y cuentan con el dictamen técnico o nota de prioridad cuando corresponde.\n\nMás allá de la programación financiera, el plan busca impulsar el cierre de brechas en el acceso a bienes y servicios públicos, mejorar la infraestructura y promover un desarrollo equilibrado y sostenible. La planificación plurianual permite prever el financiamiento, ejecución y seguimiento de proyectos con una visión integral, potenciando la eficiencia en la inversión pública.","description_en":"The Multiyear Public Investment Plan 2022-2025 (PNPIP) is a planning instrument designed to formulate and prioritize public investment projects over a multi-year horizon to meet the needs and demands of the Dominican population. Its purpose is to align public investment projects with the priorities set out in the National Multiyear Public Sector Plan (PNPSP) and the 2030 National Development Strategy, ensuring that investments contribute to the country’s economic and social development goals.\n\nThe plan outlines a list of public investment projects by sector and institution, including the investment amounts allocated for each year from 2022 to 2025. These projects are tied to government-defined investment policy priorities and generally have technical opinions or priority notes where applicable.\n\nBeyond financial programming, the plan aims to close gaps in access to public goods and services, improve infrastructure, and promote balanced, sustainable development. Multi-year planning allows for anticipating financing needs, execution timelines, and monitoring frameworks, thereby enhancing public investment effectiveness.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_6 sdg_8 sdg_9 sdg_10 sdg_11 sdg_16 sdg_17","pip/pip_project_list":"yes","pip/pip_period":"multiannual","pip/pip_project_list_es":"El plan presenta una lista de proyectos de inversión por sector e institución, con montos asignados para cada año del período 2022-2025.","pip/pip_costing":"yes","pip/pip_costing_es":"El Plan incluye el costeo de los proyectos, presentando los montos estimados de inversión asociados a cada iniciativa. Este costeo permite dimensionar financieramente los proyectos de inversión pública y constituye un insumo clave para la programación presupuestaria plurianual y la priorización de intervenciones conforme a las capacidades fiscales del Estado.","pip/pip_budget":"yes","pip/pip_budget_es":"El plan incluye información sobre el presupuesto asignado a los proyectos, desagregado por año dentro del período 2022-2025.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El PNPIP incluye un nivel limitado de territorialización, principalmente a través de la identificación de proyectos asociados a sectores e instituciones, y en algunos casos vinculados a ámbitos territoriales específicos. No obstante, la desagregación territorial no es homogénea para todos los proyectos, ya que el énfasis principal del plan está en la programación sectorial y financiera de la inversión pública.","pip/pip_indicators":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Plurianual de Inversión Pública 2025-2028 de República Dominicana","link_block/plan_id":"46400","link_block/plan_name":"Plan Plurianual de Inversión Pública 2025-2028 de República Dominicana"}],"meta/instanceID":"uuid:3080f3d3-7603-43e6-9792-e15b36920955","meta/deprecatedID":"uuid:67daedd2-8adc-414e-a224-d546e3dfd98f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3080f3d3-7603-43e6-9792-e15b36920955","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3080f3d3-7603-43e6-9792-e15b36920955"},{"_id":46618,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:35.695","end":"2025-11-07T14:27:35.695","id_drupal":"10059","country":"per","theme":"public_investment","original_language":"es","name_es":"Plan Nacional de Infraestructura Sostenible para la Competitividad 2022 - 2025","name_en":"National Sustainable Infrastructure Plan for Competitiveness 2022–2025","responsible_institution":[{"responsible_institution/institution":"Dirección General de Programación Multianual de Inversiones","responsible_institution/id_institution":"45385","responsible_institution/name_institution":"Dirección General de Programación Multianual de Inversiones"}],"link":"cb3839e8-9672-4fcf-b08e-bda394bd4b26","primary_link":"https://www.mef.gob.pe/contenidos/inv_privada/planes/PNISC_2022_2025_V2.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","visible_description":"no","linking_sdg_plans":"yes","pip/pip_period":"multiannual","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0a28a6b0-c9ee-450c-8ba2-1609225e99cf","meta/deprecatedID":"uuid:955e2bff-f5e5-45b6-b920-a1bc28448ee4","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0a28a6b0-c9ee-450c-8ba2-1609225e99cf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0a28a6b0-c9ee-450c-8ba2-1609225e99cf"},{"_id":46619,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:36.401","end":"2025-11-07T14:27:36.401","id_drupal":"1178","country":"ven","theme":"development_planning","original_language":"es","name_es":"Plan de la Patria 2025 de Venezuela","name_en":"Homeland Plan 2025 of Venezuela","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República Bolivariana de Venezuela","responsible_institution/id_institution":"45137","responsible_institution/name_institution":"Presidencia de la República Bolivariana de Venezuela"}],"link":"fb3f74d4-1b17-45aa-b5fd-50f4570b7a9a","primary_link":"https://mppp.gob.ve/wp-content/uploads/2023/03/Plan-Patria-2019-2025-1.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan de la Patria: \"Tercer Plan Socialista de Desarrollo Económico y Social de la Nación de Venezuela\" es un plan a mediano plazo para el período 2019-2025, que contiene lineamientos generales para su implementación. \n\nEl mismo contiene un programa de acción para el primer año de implementación del plan: La Agenda Concreta de Acción (ACA) del Plan de la Patria 2025: Estabilización y Paz Política y Económica 2019-2020.\n\nCon miras en un horizonte temporal a 2030, sus objetivos coinciden con los Objetivos de Desarrollo Sostenible de la Organización de Naciones Unidas.","description_en":"The Plan de la Patria: “Third Socialist Plan for the Economic and Social Development of the Nation of Venezuela” is a medium-term plan covering the period 2019–2025, which sets out the general guidelines for national implementation.\n\nIt includes a one-year action program called the Concrete Action Agenda (ACA) of the Plan de la Patria 2025: Political and Economic Stabilization and Peace 2019–2020, designed to guide the initial phase of execution.\n\nWith a long-term horizon to 2030, the plan’s objectives are aligned with the United Nations Sustainable Development Goals (SDGs), reflecting Venezuela’s commitment to advancing social justice, economic transformation, and sustainable development.","linking_sdg_plans":"no","ipd/ipd_type":"development","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:36971f93-66d0-4ff9-bfc1-8448e84eeaaa","meta/deprecatedID":"uuid:f5c79541-6ef5-432a-a77c-68ba7493c745","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"36971f93-66d0-4ff9-bfc1-8448e84eeaaa","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:35","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:36971f93-66d0-4ff9-bfc1-8448e84eeaaa"},{"_id":46620,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:37.138","end":"2025-11-07T14:27:37.138","id_drupal