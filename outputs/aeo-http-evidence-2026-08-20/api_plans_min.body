tution":"Municipalidad Provincial de Trujillo"}],"instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad Metropolitana de Trujillo","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","visible_description":"no","linking_sdg_plans":"yes","meta/instanceID":"uuid:0c6029b7-e494-446e-902d-1621018b9956","meta/deprecatedID":"uuid:c916f6d2-aea5-45f1-b43b-78b7a12cbb9e","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0c6029b7-e494-446e-902d-1621018b9956","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:36","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0c6029b7-e494-446e-902d-1621018b9956"},{"_id":46622,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:38.599","end":"2025-11-07T14:27:38.599","id_drupal":"10079","country":"per","theme":"mobility","original_language":"es","name_es":"Plan de Movilidad Urbana (PMU) para Lima y Callao","name_en":"Urban Mobility Plan (UMP) for Lima and Callao","responsible_institution":[{"responsible_institution/institution":"Autoridad de Transporte Urbano para Lima y Callao (ATU)","responsible_institution/id_institution":"45229","responsible_institution/name_institution":"Autoridad de Transporte Urbano para Lima y Callao (ATU)"}],"primary_link":"https://www.atumovilidad.pe/#/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Área Metropolitana de Lima-Callao","validity_applies_until":"no","effective_today":"under_development","visible_description":"no","linking_sdg_plans":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:48c9434e-9749-4b5d-a262-eea6829ac406","meta/deprecatedID":"uuid:c5f8c755-8f29-4673-891d-26592854b225","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"48c9434e-9749-4b5d-a262-eea6829ac406","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:37","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:48c9434e-9749-4b5d-a262-eea6829ac406"},{"_id":46623,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:39.310","end":"2025-11-07T14:27:39.310","id_drupal":"10082","country":"nic","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública 2024 (y proyección 2027) de Nicaragua","name_en":"Public Investment Program 2024 (and projection to 2027) of Nicaragua","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública ","responsible_institution/id_institution":"45383","responsible_institution/name_institution":"Dirección General de Inversión Pública "}],"instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"no","linking_sdg_plans":"yes","pip/pip_period":"multiannual","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:732c226b-62bf-471c-b58d-1c9c1918839d","meta/deprecatedID":"uuid:9f34bc4a-e633-4320-8c02-8d4be0230a85","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"732c226b-62bf-471c-b58d-1c9c1918839d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:38","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:732c226b-62bf-471c-b58d-1c9c1918839d"},{"_id":46624,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:40.019","end":"2025-11-07T14:27:40.019","id_drupal":"10083","country":"pan","theme":"public_investment","original_language":"es","name_es":"Plan Estratégico de Gobierno 2025-2029 - Plan Quinquenal Indicativo de Inversiones 2020-2024","name_en":"Five-Year Indicative Investment Plan 2025-2029 - Strategic Government Plan 2025-2029","responsible_institution":[{"responsible_institution/institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)","responsible_institution/id_institution":"44942","responsible_institution/name_institution":"Presidencia de la República de Panamá (Ministerio de la Presidencia)"}],"link":"65de4cd0-6a59-4bb6-bb10-5b2cd2977f49","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2029-01-01","temporality":"medium_term","visible_description":"no","linking_sdg_plans":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:88d5029a-37b3-4d01-ac36-7d9e8cce253b","meta/deprecatedID":"uuid:97af2824-c39c-4df2-a26d-5a9d68b72c79","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"88d5029a-37b3-4d01-ac36-7d9e8cce253b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:39","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:88d5029a-37b3-4d01-ac36-7d9e8cce253b"},{"_id":46625,"start":"2025-11-07T14:27:40.738-03:00","end":"2026-04-24T12:29:33.430-04:00","id_drupal":"10083","country":"arg","theme":"open_government","original_language":"es","name_es":"4to Plan de Acción de Gobierno Abierto de Buenos Aires 2025-2027","name_en":"4th Open Government Action Plan of Buenos Aires 2025-2027","responsible_institution":[{"responsible_institution/institution":"Dirección General de Acceso a la Información y Gobierno Abierto","responsible_institution/id_institution":"45064","responsible_institution/name_institution":"Dirección General de Acceso a la Información y Gobierno Abierto"}],"coordinator":"Mesa de Estado Abierto de Buenos Aires","id_coordinator":"45285","name_coordinator":"Mesa de Estado Abierto de Buenos Aires","plan_number":"4","link":"d087d6f7-6c5a-4337-ac0f-d0b1771c6be5","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad Autónoma de Buenos Aires","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"no","description_es":"El Cuarto Plan de Acción de Gobierno Abierto de la Ciudad Autónoma de Buenos Aires se gestó mediante un proceso de cocreación participativo y progresivo coordinado por la Mesa de Estado Abierto, estructurado en tres etapas principales que comenzaron con una convocatoria abierta donde se recibieron 54 propuestas de diversos sectores. Posteriormente, se llevaron a cabo mesas de trabajo técnicas con la participación de instituciones públicas de los tres poderes, organizaciones de la sociedad civil, la academia y el sector privado para diseñar colaborativamente los compromisos, finalizando con una fase de redacción técnica, validación y consulta pública para asegurar la aprobación de los textos finales. Este plan se integra formalmente por 5 compromisos estratégicos que buscan transformar la gestión pública bajo los pilares de transparencia, participación y colaboración.","description_en":"The Fourth Open Government Action Plan of the Autonomous City of Buenos Aires was developed through a participatory and progressive co-creation process coordinated by the Open State Table, structured into three main stages that began with an open call receiving 54 proposals from various sectors. Subsequently, technical work tables were held with the participation of public institutions from the three branches of government, civil society organizations, academia, and the private sector to collaboratively design the commitments, concluding with a phase of technical drafting, validation, and public consultation to ensure the approval of the final texts. This plan is formally composed of 5 strategic commitments aimed at transforming public management under the pillars of transparency, participation, and collaboration.","linking_sdg_plans":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"1er Plan de Acción de Gobierno Abierto de Buenos Aires 2016-2017","link_block/plan_id":"46645","link_block/plan_name":"1er Plan de Acción de Gobierno Abierto de Buenos Aires 2016-2017"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"2do Plan de Acción de Gobierno Abierto de Buenos Aires 2018-2020","link_block/plan_id":"46646","link_block/plan_name":"2do Plan de Acción de Gobierno Abierto de Buenos Aires 2018-2020"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"3er Plan de Acción de Gobierno Abierto de Buenos Aires 2021-2023","link_block/plan_id":"46647","link_block/plan_name":"3er Plan de Acción de Gobierno Abierto de Buenos Aires 2021-2023"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:8c3b8343-f0fc-407f-a5c5-8839be03b180","meta/deprecatedID":"uuid:d71b57f0-c3d0-4f06-b7de-41b26c1d09b7","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8c3b8343-f0fc-407f-a5c5-8839be03b180","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:39","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8c3b8343-f0fc-407f-a5c5-8839be03b180"},{"_id":46626,"start":"2025-11-07T14:27:41.471-04:00","end":"2026-05-12T11:36:21.106-04:00","id_drupal":"10083","country":"gtm","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Antigua (2025–2027)","name_en":"First Open Government Action Plan of Antigua (2025-2027)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto (Antigua)","responsible_institution/id_institution":"51365","responsible_institution/name_institution":"Dirección de Gobierno Abierto (Antigua)"}],"coordinator":"Comité de Gobierno Abierto de Antigua","id_coordinator":"45465","name_coordinator":"Comité de Gobierno Abierto de Antigua","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-antigua-guatemala-guatemala-2025-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Antigua Guatemala","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción de Gobierno Abierto de Antigua Guatemala 2025–2027 busca consolidar un modelo de gestión pública local más transparente, participativo e inclusivo, posicionando al municipio como un referente nacional en gobierno abierto. El plan fue cocreado entre la municipalidad, sociedad civil, academia, sector privado y comunidades territoriales, mediante amplios procesos de consulta ciudadana y trabajo multisectorial. \n\nEl plan se centra en fortalecer la relación entre ciudadanía y gobierno local a través de tres prioridades estratégicas:\n\n1. Fortalecimiento de la transparencia y el acceso a la información pública, promoviendo mecanismos de rendición de cuentas y monitoreo ciudadano de la gestión municipal.\n2. Ampliación de la participación ciudadana inclusiva, mediante espacios permanentes de cocreación y diálogo que incorporen comunidades, jóvenes, organizaciones sociales y actores locales.\n3. Impulso de la innovación y las herramientas digitales, utilizando tecnología cívica para mejorar la comunicación, la participación y la colaboración entre gobierno y ciudadanía. \n\nEl proceso de cocreación incluyó quince foros de consulta ciudadana y grupos de trabajo temáticos sobre movilidad, gestión ambiental, agua y seguridad, con participación de comunidades urbanas y rurales, especialmente sectores históricamente excluidos. \n\nEn conjunto, el plan busca transformar la cultura institucional del municipio hacia una gobernanza más abierta, colaborativa y cercana a las necesidades de la ciudadanía, fortaleciendo la confianza pública y promoviendo una participación más activa en la toma de decisiones locales.","description_en":"The Antigua Guatemala Open Government Action Plan 2025–2027 seeks to consolidate a more transparent, participatory, and inclusive model of local public management, positioning the municipality as a national reference in open government. The plan was co-created by the municipality, civil society, academia, the private sector, and territorial communities through broad citizen consultation processes and multi-stakeholder collaboration.\n\nThe plan focuses on strengthening the relationship between citizens and local government through three strategic priorities:\n\n1. Strengthening transparency and access to public information by promoting accountability mechanisms and citizen monitoring of municipal management.\n2. Expanding inclusive citizen participation through permanent spaces for co-creation and dialogue that involve communities, youth, social organizations, and local stakeholders.\n3. Promoting innovation and digital tools by using civic technology to improve communication, participation, and collaboration between government and citizens.\n\nThe co-creation process included fifteen citizen consultation forums and thematic working groups on mobility, environmental management, water, and security, with participation from urban and rural communities, especially historically excluded sectors.\n\nOverall, the plan seeks to transform the municipality’s institutional culture toward a more open, collaborative, and citizen-centered governance model, strengthening public trust and promoting more active participation in local decision-making.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:329d63b5-7c44-431f-9f74-0e0d7858b18d","meta/deprecatedID":"uuid:76a8ebb6-94b5-4244-87ad-add884ccf12f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"329d63b5-7c44-431f-9f74-0e0d7858b18d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:40","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:329d63b5-7c44-431f-9f74-0e0d7858b18d"},{"_id":46627,"start":"2025-11-07T14:27:42.200-03:00","end":"2026-04-08T09:13:10.258-04:00","id_drupal":"100022","country":"bra","theme":"urban_development","original_language":"pt","name_es":"Política Nacional de Desarrollo Urbano","name_en":"National Urban Development Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Ciudades","responsible_institution/id_institution":"45150","responsible_institution/name_institution":"Ministerio de Ciudades"},{"responsible_institution/institution":"Ministerio de Integración y Desarrollo Regional","responsible_institution/id_institution":"45310","responsible_institution/name_institution":"Ministerio de Integración y Desarrollo Regional"}],"link":"5a869841-9565-4996-b219-b652d394db20","primary_link":"https://www.gov.br/cidades/pt-br/acesso-a-informacao/acoes-e-programas/desenvolvimento-urbano-e-metropolitano/politica-nacional-de-desenvolvimento-urbano/arquivos/pndu_pndu_texto_base.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"La PNDU es una política pública en proceso de formulación, liderada por el Ministerio de las Ciudades, cuyo objetivo principal es reducir las desigualdades socioespaciales en diferentes escalas: intraurbana, supramunicipal y en la red de ciudades. Busca equilibrar los beneficios y los costos del proceso de urbanización en todo el territorio brasileño.\n\nLa política tiene como propósito fortalecer la capacidad de los municipios para implementar sus agendas locales de desarrollo urbano, mediante asistencia técnica, herramientas y programas que permitan diseñar o revisar políticas urbanas adaptadas a las realidades locales.\n\nLa PNDU se estructura en torno a los Objetivos de Desarrollo Urbano Sostenible (ODUS), que organizan una agenda nacional de acciones sostenibles con participación de la sociedad civil y los gobiernos locales, estaduales y federales.\nAdemás, el Ministerio promueve los Diálogos para una PNDU, eventos técnico-académicos realizados en colaboración con el IPEA y la ANPUR, con el fin de construir una visión compartida y pública del desarrollo urbano sostenible en Brasil.","description_en":"The National Urban Development Policy (PNDU) of Brazil is currently under development. Its main goal is to reduce socio-spatial inequalities at intra-urban, supra-municipal, and city network scales, aiming to balance the benefits and burdens of urbanization.\nThe PNDU also seeks to support municipalities in implementing their local urban development agendas by providing technical assistance, tools, and programs to help design or revise urban policies tailored to local contexts.\n\nThe policy is guided by the Sustainable Urban Development Goals (ODUS), which structure a national agenda for sustainable urban actions involving civil society and all levels of government.\n\nFurthermore, the Ministry of Cities is organizing Dialogues for a PNDU, a series of technical-academic events in partnership with IPEA and ANPUR, to build a shared and public vision for sustainable urban development in Brazil.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:1e0351f4-7d97-4cd7-8b8a-3e23534132a7","meta/deprecatedID":"uuid:fc426d07-82be-4a5a-a346-fce98bcef45c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1e0351f4-7d97-4cd7-8b8a-3e23534132a7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:41","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1e0351f4-7d97-4cd7-8b8a-3e23534132a7"},{"_id":46628,"start":"2025-11-07T14:27:42.922-03:00","end":"2026-04-10T12:19:10.474-04:00","id_drupal":"100023","country":"cri","theme":"urban_development","original_language":"es","name_es":"Política Nacional de Desarrollo Urbano","name_en":"National Urban Development Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica","responsible_institution/id_institution":"44992","responsible_institution/name_institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica"}],"link":"59d80c58-999b-4876-beae-827aa6f3ea42","primary_link":"https://www.mivah.go.cr/Documentos/politicas_directrices_planes/PNDU-2018_Politica_Plan_Pags_001-028.pdf","instrument_type":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","description_es":"La Política Nacional de Desarrollo Urbano 2018‑2030 de Costa Rica fue formulada con el propósito de promover un ordenamiento urbano sostenible que mejore la calidad de vida de los habitantes y fortalezca a las ciudades como sistemas productivos fundamentales para la competitividad económica y social del país. \n\nEsta política se guía por principios de sostenibilidad, innovación, productividad y buena gobernanza urbana, orientando la planificación de las ciudades hacia la eficiencia, la movilidad segura y sostenible, el acceso universal a servicios públicos y recreativos, y la participación ciudadana. Su elaboración se realizó mediante un proceso participativo amplio, incorporando aportes de instituciones públicas y actores sociales, y considerando de manera transversal temas de equidad, inclusión social, tecnología, cultura y gestión del riesgo. \n\nAdemás, reconoce la importancia de los compromisos internacionales de Costa Rica, en particular la Agenda 2030 para el Desarrollo Sostenible, y se orienta a contribuir al cumplimiento del Objetivo de Desarrollo Sostenible 11, que busca que las ciudades y los asentamientos humanos sean inclusivos, seguros, resilientes y sostenibles.","description_en":"The National Urban Development Policy 2018‑2030 of Costa Rica was designed to promote sustainable urban organization that improves the quality of life of residents and strengthens cities as productive systems crucial for the country’s economic and social competitiveness. \n\nThe policy is guided by principles of sustainability, innovation, productivity, and good urban governance, directing urban planning toward efficiency, safe and sustainable mobility, universal access to public and recreational services, and citizen participation. It was developed through a broad participatory process that incorporated contributions from public institutions and social actors, and it addresses cross-cutting issues such as equity, social inclusion, technology, culture, and risk management. \n\nThe policy also aligns with Costa Rica’s international commitments, particularly the United Nations 2030 Agenda for Sustainable Development, and aims to contribute to the achievement of Sustainable Development Goal 11, which seeks to make cities and human settlements inclusive, safe, resilient, and sustainable.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_8 sdg_10 sdg_11 sdg_12 sdg_13","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:ceadf4bc-8199-420a-a627-f3093c79833c","meta/deprecatedID":"uuid:3beb5dd2-959b-4cba-b2c8-56fa43c7b41e","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ceadf4bc-8199-420a-a627-f3093c79833c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ceadf4bc-8199-420a-a627-f3093c79833c"},{"_id":46629,"start":"2025-11-07T14:27:43.651-04:00","end":"2026-04-08T09:16:15.774-04:00","id_drupal":"100024","country":"cub","theme":"urban_development","original_language":"es","name_es":"Plan de Estado Para la implementación de la Nueva Agenda Urbana","name_en":"State Plan for the Implementation of the New Urban Agenda","responsible_institution":[{"responsible_institution/institution":"Instituto de Planificación Física de Cuba","responsible_institution/id_institution":"45334","responsible_institution/name_institution":"Instituto de Planificación Física de Cuba"}],"link":"ed080f3f-d637-4711-8e5b-9aa5e3bebe98","primary_link":"https://www.inotu.gob.cu/sites/default/files/upload_files/documentos/PLAN%20DE%20ESTADO%20NAUC%20con%20ACCIONES%20WEB%281%29.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2036-01-01","effective_today":"yes","temporality":"long_term","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:88128835-d84d-42c6-ae41-8bef7cf9ce49","meta/deprecatedID":"uuid:eeb2053d-0c13-4a12-a1b7-d4d5f4e34b9a","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"88128835-d84d-42c6-ae41-8bef7cf9ce49","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:88128835-d84d-42c6-ae41-8bef7cf9ce49"},{"_id":46630,"start":"2025-11-07T14:27:44.369-04:00","end":"2026-04-10T12:18:25.691-04:00","id_drupal":"100025","country":"ecu","theme":"urban_development","original_language":"es","name_es":"Política Urbana Nacional","name_en":"National Urban Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Urbano y Vivienda","responsible_institution/id_institution":"45029","responsible_institution/name_institution":"Ministerio de Desarrollo Urbano y Vivienda"}],"link":"0c540573-f867-42d0-a4d3-086c480117eb","primary_link":"https://faolex.fao.org/docs/pdf/ecu224025.pdf","instrument_type":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2036-01-01","effective_today":"yes","temporality":"long_term","description_es":"La Política Urbana Nacional (PUN) del Ecuador es un instrumento rector de política pública que orienta el desarrollo urbano sostenible del país, articulando acciones del Estado en distintos niveles de gobierno. Su objetivo principal es garantizar el derecho a un hábitat seguro y saludable, a una vivienda adecuada y al derecho a la ciudad, mediante intervenciones integrales, coordinadas y participativas.\n\nLa PUN se fundamenta en un enfoque de derechos y en una visión integral del territorio, reconociendo la interdependencia entre lo urbano, periurbano y rural. Asimismo, promueve ciudades inclusivas, seguras, resilientes y sostenibles, alineadas con marcos internacionales como la Agenda 2030 y la Nueva Agenda Urbana.\n\nEl instrumento establece principios, lineamientos estratégicos y líneas de acción que buscan mejorar la planificación territorial, fortalecer la gobernanza urbana y reducir desigualdades socioespaciales. En este marco, se enfatiza la coordinación interinstitucional, la participación de múltiples actores y el fortalecimiento de capacidades locales, especialmente de los gobiernos autónomos descentralizados, responsables de la implementación en el territorio.\n\nFinalmente, la PUN se articula con otros instrumentos nacionales como la Agenda Hábitat Sostenible del Ecuador 2036, promoviendo un desarrollo urbano productivo, equitativo y ambientalmente sostenible. A través de este enfoque, busca transformar los patrones de urbanización del país y mejorar la calidad de vida de la población, particularmente de los grupos en situación de vulnerabilidad.","description_en":"The National Urban Policy (PUN) of Ecuador is a strategic public policy framework designed to guide sustainable urban development across the country, coordinating actions among different levels of government. Its main objective is to guarantee the right to a safe and healthy habitat, adequate housing, and the right to the city through integrated, coordinated, and participatory interventions.\n\nThe policy is grounded in a rights-based approach and a comprehensive territorial perspective, recognizing the interconnections between urban, peri-urban, and rural areas. It promotes inclusive, safe, resilient, and sustainable cities, aligned with global frameworks such as the 2030 Agenda and the New Urban Agenda.\n\nThe PUN defines guiding principles, strategic priorities, and policy instruments aimed at improving territorial planning, strengthening urban governance, and addressing socio-spatial inequalities. It emphasizes interinstitutional coordination, multi-stakeholder participation, and the strengthening of local capacities, particularly those of decentralized autonomous governments responsible for implementation at the local level.\n\nFinally, the policy is closely linked to national frameworks such as the Ecuador Habitat and Housing Agenda 2036, fostering productive, equitable, and environmentally sustainable urban development. Through this approach, it seeks to transform urbanization patterns and improve quality of life, especially for vulnerable populations.","linking_sdg_plans":"yes","sdg":"sdg_11 sdg_13","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:3f4dbd31-68f4-4737-aa4b-63d094aed517","meta/deprecatedID":"uuid:5e74087a-9c93-4910-b8ee-92a525575df8","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3f4dbd31-68f4-4737-aa4b-63d094aed517","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3f4dbd31-68f4-4737-aa4b-63d094aed517"},{"_id":46631,"start":"2025-11-07T14:27:45.084-04:00","end":"2026-04-10T12:13:38.185-04:00","id_drupal":"100026","country":"pry","theme":"urban_development","original_language":"es","name_es":"Politica Nacional de la Vivienda y Habitat de Paraguay","name_en":"National Housing and Habitat Policy of Paraguay","responsible_institution":[{"responsible_institution/institution":"Ministerio de Urbanismo, Vivienda y Hábitat","responsible_institution/id_institution":"45171","responsible_institution/name_institution":"Ministerio de Urbanismo, Vivienda y Hábitat"}],"link":"668666b8-b5fd-41a5-8e48-67f64cf1a6de","primary_link":"https://www.muvh.gov.py/sitio/wp-content/uploads/2022/04/PNVH-Digital.pdf","instrument_type":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:e8fb6656-ecc8-4ef7-a575-1368585a72ea","meta/deprecatedID":"uuid:2ad767c2-0d5c-4b47-bfaf-01cee2368426","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e8fb6656-ecc8-4ef7-a575-1368585a72ea","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:44","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e8fb6656-ecc8-4ef7-a575-1368585a72ea"},{"_id":46632,"start":"2025-11-07T14:27:45.798-04:00","end":"2026-04-10T12:28:24.411-04:00","id_drupal":"100027","country":"per","theme":"urban_development","original_language":"es","name_es":"Política Nacional de Vivienda y Urbanismo","name_en":"National Housing and Urbanism Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda, Construcción y Saneamiento de Perú","responsible_institution/id_institution":"45264","responsible_institution/name_institution":"Ministerio de Vivienda, Construcción y Saneamiento de Perú"}],"link":"21e05b58-eba2-4b70-b8c3-b06faaf2218c","primary_link":"https://cdn.www.gob.pe/uploads/document/file/2017413/Pol%C3%ADtica%20Nacional%20de%20Vivienda%20y%20Urbanismo.pdf","instrument_type":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","description_es":"a Política Nacional de Vivienda y Urbanismo (PNVU) del Perú es el principal instrumento de política pública que orienta el desarrollo urbano y habitacional del país con un horizonte al año 2030. Su objetivo general es promover el desarrollo urbano-territorial sostenible de las ciudades y centros poblados, garantizando el acceso a una vivienda adecuada y a un hábitat de calidad. La política articula acciones entre los tres niveles de gobierno, el sector privado y la sociedad civil, con el fin de responder de manera integral a los desafíos del crecimiento urbano.\n\nLa PNVU surge como respuesta a problemáticas estructurales como el déficit habitacional, la expansión urbana desordenada, la informalidad en el uso del suelo y el acceso limitado a servicios urbanos básicos. En este contexto, propone un cambio de enfoque: pasar de un modelo basado en la expansión continua de las ciudades hacia uno orientado a su consolidación, integración y democratización, poniendo en el centro el derecho a la vivienda y el derecho a la ciudad.\n\nLa política se estructura en torno a objetivos prioritarios que incluyen: mejorar la planificación urbana y territorial, asegurar el uso sostenible del suelo, incrementar el acceso a vivienda adecuada —especialmente para poblaciones vulnerables— y mejorar las condiciones de habitabilidad en las ciudades. Para ello, establece lineamientos estratégicos orientados al fortalecimiento de capacidades institucionales, la coordinación intergubernamental y la implementación de instrumentos de gestión urbana más eficaces.\n\nFinalmente, la PNVU adopta un enfoque integral que articula vivienda, urbanismo y servicios urbanos (como infraestructura, equipamiento y espacio público), superando la fragmentación tradicional de estas políticas. Asimismo, se alinea con agendas internacionales como los Objetivos de Desarrollo Sostenible y la Nueva Agenda Urbana, buscando promover ciudades más inclusivas, resilientes y sostenibles, y mejorar la calidad de vida de la población.","description_en":"The National Housing and Urban Development Policy (PNVU) of Peru is the main public policy framework guiding urban and housing development in the country, with a time horizon to 2030. Its overall objective is to promote sustainable urban-territorial development in cities and human settlements, ensuring access to adequate housing and quality living environments. The policy coordinates actions across all levels of government, as well as with the private sector and civil society, to address urban challenges in a comprehensive manner.\n\nThe PNVU responds to structural challenges such as housing deficits, uncontrolled urban expansion, informal land occupation, and limited access to basic urban services. In this context, it proposes a shift from a model based on continuous urban expansion to one focused on consolidation, integration, and democratization of cities, placing the right to housing and the right to the city at its core.\n\nThe policy is organized around key priority objectives, including improving urban and territorial planning, ensuring sustainable land use, increasing access to adequate housing—especially for vulnerable populations—and enhancing overall urban habitability. To achieve these goals, it establishes strategic guidelines aimed at strengthening institutional capacities, improving intergovernmental coordination, and implementing more effective urban management tools.\n\nFinally, the PNVU adopts an integrated approach that brings together housing, urban planning, and urban services such as infrastructure, public spaces, and facilities, overcoming the traditional fragmentation of these sectors. It is also aligned with global agendas such as the Sustainable Development Goals and the New Urban Agenda, aiming to foster inclusive, resilient, and sustainable cities while improving quality of life for the population.","linking_sdg_plans":"yes","sdg":"sdg_11","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:9cd733b1-a60e-4e10-9788-0abd6d245d32","meta/deprecatedID":"uuid:07ecf797-073f-4aa0-b9aa-5d28b5cb631d","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9cd733b1-a60e-4e10-9788-0abd6d245d32","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:44","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9cd733b1-a60e-4e10-9788-0abd6d245d32"},{"_id":46633,"start":"2025-11-07T14:27:46.523-04:00","end":"2026-04-10T12:13:05.572-04:00","id_drupal":"100028","country":"slv","theme":"urban_development","original_language":"es","name_es":"Política Nacional de Vivienda y Hábitat","name_en":"National Housing and Habitat Policy","responsible_institution":[{"responsible_institution/institution":"Viceministerio de Vivienda y Desarrollo Urbano de El Salvador","responsible_institution/id_institution":"45034","responsible_institution/name_institution":"Viceministerio de Vivienda y Desarrollo Urbano de El Salvador"}],"link":"645ee417-2f1b-4655-943a-0a30d8c7ad05","primary_link":"https://www.transparencia.gob.sv/institutions/ilp/documents/124432/download","instrument_type":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:eaa0be8d-e39b-4501-9ff7-1377113560b6","meta/deprecatedID":"uuid:14fc5408-d068-462a-8b49-ecfc8e384cd4","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"eaa0be8d-e39b-4501-9ff7-1377113560b6","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:45","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:eaa0be8d-e39b-4501-9ff7-1377113560b6"},{"_id":46634,"start":"2025-11-07T14:27:47.245-03:00","end":"2026-04-08T09:20:11.965-04:00","id_drupal":"100029","country":"ury","theme":"urban_development","original_language":"es","name_es":"Estrategia Nacional de Acceso al Suelo Urbano","name_en":"National Strategy for Access to Urban Land","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente (MVOTMA) de Uruguay","responsible_institution/id_institution":"45095","responsible_institution/name_institution":"Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente (MVOTMA) de Uruguay"}],"link":"5a1a9f5d-6668-4937-a9c2-127d4a726940","primary_link":"https://www.gub.uy/ministerio-vivienda-ordenamiento-territorial/comunicacion/publicaciones/estrategia-nacional-acceso-suelo-urbano","instrument_type":"strategy","instrument_type2":"strategy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"La Estrategia Nacional de Acceso al Suelo Urbano es una iniciativa impulsada por el Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente de Uruguay para mejorar el acceso al suelo urbanizado, especialmente con fines habitacionales. La estrategia busca promover un uso más eficiente, sostenible y equitativo del suelo urbano, facilitar el acceso a un hábitat adecuado para toda la población —en particular para los sectores con mayores dificultades— y contribuir a ciudades más inclusivas, democráticas y sostenibles. \nPara ello, articula objetivos políticos, ejes programáticos, lineamientos estratégicos y acciones orientadas a optimizar el uso del suelo urbanizado, fortalecer la adquisición pública de suelo y mejorar la gestión del suelo público, en coordinación con distintos niveles de gobierno e instituciones.","description_en":"The National Strategy for Access to Urban Land is an initiative launched by Uruguay’s Ministry of Housing, Land Use Planning, and the Environment to improve access to developed land, particularly for housing purposes. The strategy seeks to promote a more efficient, sustainable, and equitable use of urban land, facilitate access to adequate housing for the entire population—particularly for the most vulnerable sectors—and contribute to more inclusive, democratic, and sustainable cities. \nTo this end, it articulates policy objectives, programmatic pillars, strategic guidelines, and actions aimed at optimizing the use of urban land, strengthening public land acquisition, and improving the management of public land, in coordination with different levels of government and institutions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:9ddb996b-7dba-4e5d-a489-f0b6d8b1b4a9","meta/deprecatedID":"uuid:4c29cfa2-296d-4b7c-a0c1-c74287d92d00","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9ddb996b-7dba-4e5d-a489-f0b6d8b1b4a9","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9ddb996b-7dba-4e5d-a489-f0b6d8b1b4a9"},{"_id":46635,"start":"2025-11-07T14:27:47.961-03:00","end":"2026-04-06T12:43:55.344-04:00","id_drupal":"100113","country":"mex","theme":"territorial_planning","original_language":"es","name_es":"Estrategia Nacional de Ordenamiento Territorial (ENOT)","name_en":"Estrategia Nacional de Ordenamiento Territorial (ENOT)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)","responsible_institution/id_institution":"45027","responsible_institution/name_institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)"}],"link":"dabb4e6f-9e63-4086-8b1c-01289408c24f","primary_link":"https://www.gob.mx/sedatu/documentos/estrategia-nacional-de-ordenamiento-territorial-de-la-sedatu?state=published","instrument_type":"strategy","instrument_type2":"strategy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"La Estrategia Nacional de Ordenamiento Territorial (ENOT) es el instrumento de política pública que orienta, a nivel nacional, la organización del territorio en México, con el objetivo de promover un desarrollo equilibrado, incluyente y sostenible. La ENOT establece una visión de largo plazo para la ocupación y el uso del territorio, considerando las dinámicas económicas, sociales, ambientales y demográficas del país, así como las profundas desigualdades territoriales existentes.\n\nEste instrumento busca articular las políticas sectoriales y los distintos niveles de gobierno en torno a un marco común de ordenamiento territorial. En ese sentido, la ENOT define directrices estratégicas para la localización de actividades productivas, infraestructura, asentamientos humanos y sistemas urbanos-rurales, promoviendo la coherencia entre el desarrollo urbano, el desarrollo regional y la protección del medio ambiente.\n\nLa ENOT pone especial énfasis en la reducción de brechas territoriales, el fortalecimiento de regiones rezagadas y la gestión integral del territorio frente a riesgos naturales y efectos del cambio climático. Asimismo, incorpora principios como la sostenibilidad ambiental, la equidad territorial, la resiliencia y el uso eficiente del suelo, alineándose con los compromisos internacionales asumidos por México, incluida la Agenda 2030 para el Desarrollo Sostenible.\n\nFinalmente, la Estrategia funciona como un marco orientador para la elaboración y actualización de programas de ordenamiento territorial y desarrollo urbano a nivel estatal, metropolitano y municipal. Si bien no sustituye los instrumentos de planeación subnacionales, la ENOT establece criterios comunes y lineamientos generales que facilitan la coordinación intergubernamental y la coherencia del sistema nacional de planeación territorial.","description_en":"The National Territorial Planning Strategy (Estrategia Nacional de Ordenamiento Territorial – ENOT) is Mexico’s national policy instrument that guides the organization and use of the country’s territory, with the aim of promoting balanced, inclusive, and sustainable development. The ENOT provides a long-term vision for territorial development, taking into account economic, social, environmental, and demographic dynamics, as well as the significant territorial inequalities that characterize the country.\n\nThe Strategy seeks to articulate sectoral policies and align the actions of different levels of government within a common territorial framework. To this end, the ENOT establishes strategic guidelines for the spatial distribution of productive activities, infrastructure, human settlements, and urban–rural systems, fostering coherence between urban development, regional development, and environmental protection.\n\nA central focus of the ENOT is the reduction of territorial disparities, the strengthening of lagging regions, and the comprehensive management of territory in the face of natural hazards and climate change impacts. The Strategy incorporates key principles such as environmental sustainability, territorial equity, resilience, and efficient land use, and is aligned with Mexico’s international commitments, including the 2030 Agenda for Sustainable Development.\n\nFinally, the ENOT serves as a guiding framework for the formulation and updating of territorial planning and urban development programs at the state, metropolitan, and municipal levels. While it does not replace subnational planning instruments, the Strategy provides common criteria and general guidelines that support intergovernmental coordination and enhance coherence across the national territorial planning system.","linking_sdg_plans":"yes","sdg":"sdg_10 sdg_11 sdg_13 sdg_15","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:d5307fbb-9fff-4478-9a34-6a0b9384f46d","meta/deprecatedID":"uuid:ea23c4ea-7731-47e6-bef5-ac8be76ae0f5","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d5307fbb-9fff-4478-9a34-6a0b9384f46d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d5307fbb-9fff-4478-9a34-6a0b9384f46d"},{"_id":46636,"start":"2025-11-07T14:27:48.683-04:00","end":"2026-04-06T13:01:10.561-04:00","id_drupal":"100116","country":"per","theme":"territorial_planning","original_language":"es","name_es":"Politica Nacional de Ordenamiento Territorial - PNOT","name_en":"National Territorial Planning Policy (PNOT)","responsible_institution":[{"responsible_institution/institution":"Viceministerio de Gobernanza Territorial","responsible_institution/id_institution":"45323","responsible_institution/name_institution":"Viceministerio de Gobernanza Territorial"}],"link":"baa5a1df-9583-4ed3-9b3e-033c9268ee97","primary_link":"https://www.gob.pe/institucion/pcm/informes-publicaciones/5146430-politica-nacional-de-ordenamiento-territorial-pnot","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:92a5d35b-d533-4f89-8981-f2c001ecaa60","meta/deprecatedID":"uuid:8783cdf7-19b1-489d-840d-98f52a564f70","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"92a5d35b-d533-4f89-8981-f2c001ecaa60","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:92a5d35b-d533-4f89-8981-f2c001ecaa60"},{"_id":46637,"start":"2025-11-07T14:27:49.496-03:00","end":"2026-01-13T16:58:23.454-03:00","id_drupal":"637","country":"bra","theme":"open_government","original_language":"pt","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Brasil (2012-2014)","name_en":"First National Open Government Action Plan of Brazil (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Secretaria de Transparencia y Prevensión de la Corrupción","responsible_institution/id_institution":"45014","responsible_institution/name_institution":"Secretaria de Transparencia y Prevensión de la Corrupción"}],"coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","id_coordinator":"45002","name_coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","plan_number":"1","link":"20d9e18a-d09d-4203-ba68-6a083416bc0c","primary_link":"https://repositorio.cgu.gov.br/xmlui/bitstream/handle/1/66727/1_plano_de_acao_portugues.pdf?sequence=1&amp;isAllowed=y","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Es responsabilidad del Estado rendir cuentas de sus acciones y ofrecer a sus ciudadanos acceso a la información pública mediante herramientas de fácil comprensión, así como incentivar el uso de dicha información por parte de la sociedad. Firme en esta convicción, Brasil está comprometido con este Plan de Acción de Gobierno Abierto mediante medidas que permitirán al país avanzar en la transparencia pública y, consecuentemente, mejorar sus prácticas de prevención y combate a la corrupción, acceso a la información, gestión de los recursos públicos, promoción de la integridad en los sectores público y privado, fomento de la participación ciudadana y prestación eficiente de los servicios públicos.\n\nEl Plan de Acción fue desarrollado a través de consultas a diversos órganos públicos del Poder Ejecutivo Federal brasileño, así como al Consejo de Transparencia Pública y Combate a la Corrupción, órgano consultivo y colegiado vinculado a la Controladuría General de la Unión. De igual manera, se creó el Comité Interministerial para el Gobierno Abierto (CIGA), que será el foro de discusión sobre la implementación y actualización de los Planes de Acción de Gobierno Abierto de Brasil en la Alianza para el Gobierno Abierto.\n\nEl proceso de consulta a la sociedad y a los actores privados sobre el plan de acción se realizó mediante reuniones presenciales y también utilizando la experiencia y los contactos de las redes de consulta existentes en la sociedad y en varios órganos públicos brasileños para asuntos específicos.\n\nEl primer plan de acción está vinculado al instrumento “Plan Plurianual Federal (2012-2015)”.","description_en":"\"It is the responsibility of the State to be accountable for its actions and to provide its citizens with access to public information through tools that are easy to understand, as well as to encourage the use of that information by society.\" Firm in this belief, Brazil is committed to this Open Government Action Plan through measures that will enable the country to advance public transparency and, consequently, improve its practices in preventing and combating corruption, access to information, public resource management, promoting integrity in both the public and private sectors, encouraging citizen participation, and delivering public services efficiently.\n\nThe Action Plan was developed through consultations with various public bodies of the Brazilian Federal Executive Branch, in addition to the Public Transparency and Anti-Corruption Council, an advisory and collegiate body linked to the Office of the Comptroller General. Likewise, the Interministerial Committee for Open Government (CIGA) was established, which will serve as the forum for discussions on the implementation and updating of Brazil’s Open Government Action Plans within the framework of the Open Government Partnership.\n\nThe consultation process with society and private actors regarding the action plan was carried out through face-to-face meetings, as well as by leveraging the experience and networks of existing consultation mechanisms within society and various Brazilian public bodies on specific issues.\n\nThe first action plan is linked to the instrument \"Federal Multi-Year Plan (2012–2015).\"","linking_sdg_plans":"no","meta/instanceID":"uuid:f9b5bfcf-7470-4a8f-bb1f-c21cb6d72349","meta/deprecatedID":"uuid:f2d781d3-48b8-471b-8ea2-b4f96a6d5bcb","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f9b5bfcf-7470-4a8f-bb1f-c21cb6d72349","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:48","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f9b5bfcf-7470-4a8f-bb1f-c21cb6d72349"},{"_id":46638,"start":"2025-11-07T14:27:50.220-04:00","end":"2026-04-08T09:13:39.842-04:00","id_drupal":"100053","country":"bra","theme":"urban_development","original_language":"pt","name_es":"Política Nacional de Desarrollo Urbano","name_en":"National Urban Development Policy","link":"4465b3cd-241a-48dd-a94f-6591314eb48b","primary_link":"https://erminiamaricato.wordpress.com/wp-content/uploads/2012/03/cadernos-mcidades-polc3adtica-nacional-de-desenvolvimento-urbano.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2004-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"La Política Nacional de Desarrollo Urbano (PNDU) de Brasil es una iniciativa del Ministerio de las Ciudades que busca establecer una estrategia nacional para enfrentar los desafíos del desarrollo urbano. Su objetivo principal es reducir las desigualdades socioespaciales en diferentes escalas (intraurbana, supramunicipal y en la red de ciudades), promoviendo un desarrollo más justo y equilibrado.\n\nActualmente, la PNDU está en proceso de reformulación. Esta nueva etapa se basa en los Objetivos de Desarrollo Urbano Sostenible (ODUS), que estructuran una agenda nacional de acciones sostenibles con participación de la sociedad civil y los gobiernos locales, estaduales y federales. También se promueven los Diálogos para una PNDU, espacios técnico-académicos que buscan construir una visión compartida del desarrollo urbano sostenible.\n\nPor otro lado, existe una versión anterior de la PNDU, publicada en los Cadernos MCidades (2004–2005), que fue elaborada en el contexto de las primeras conferencias nacionales de ciudades. Esta versión fundacional enfatizaba la justicia social, la descentralización, la participación ciudadana y la coordinación intersectorial como pilares del desarrollo urbano.","description_en":"Brazil’s National Urban Development Policy (PNDU) is an initiative led by the Ministry of Cities aimed at creating a national strategy to address urban development challenges. Its main goal is to reduce socio-spatial inequalities across various scales (intra-urban, supra-municipal, and city networks), promoting a more equitable and balanced urban development.x\n\nThe PNDU is currently undergoing reformulation. This new phase is guided by the Sustainable Urban Development Goals (ODUS), which organize a national agenda for sustainable actions involving civil society and all levels of government. The Ministry also promotes Dialogues for a PNDU, technical-academic events designed to build a shared vision for sustainable urban development.\n\nIn contrast, an earlier version of the PNDU, published in the Cadernos MCidades (2004–2005), was developed during Brazil’s first national city conferences. This foundational version emphasized social justice, decentralization, citizen participation, and intersectoral coordination as key pillars of urban policy.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:ac161a7a-ebdc-49bf-85e8-6a689c87fbb4","meta/deprecatedID":"uuid:77e01bee-0975-46b3-97fd-dd899bfda929","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ac161a7a-ebdc-49bf-85e8-6a689c87fbb4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:49","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ac161a7a-ebdc-49bf-85e8-6a689c87fbb4"},{"_id":46639,"start":"2025-11-07T14:27:50.942-03:00","end":"2026-01-13T16:57:43.630-03:00","id_drupal":"667","country":"bra","theme":"open_government","original_language":"pt","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Brasil (2018-2021)","name_en":"Fourth National Open Government Action Plan of Brazil (2018-2021)","responsible_institution":[{"responsible_institution/institution":"Secretaria de Transparencia y Prevensión de la Corrupción","responsible_institution/id_institution":"45014","responsible_institution/name_institution":"Secretaria de Transparencia y Prevensión de la Corrupción"}],"coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","id_coordinator":"45002","name_coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","plan_number":"4","link":"d5184d87-4c59-4eea-9197-0a48dc8d51a7","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2018/10/Brazil_Action-Plan_2018-2020_POR.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"La formulación del 4º Plan de Acción de Brasil siguió la metodología utilizada para la construcción del 3º Plan, dado que ésta materializó con éxito un cambio significativo respecto a los planes anteriores y aseguró el fortalecimiento de la colaboración entre gobierno y sociedad, resultando en la construcción de compromisos más dinámicos y objetivos. La nueva metodología prevé que el proceso de construcción de los planes se lleve a cabo en tres fases de trabajo: i) Fase de Definición de Temas; ii) Fase de Cocreación; y iii) Fase de Aprobación del Plan.\n\nEntre los puntos que merecen destacarse se menciona la participación directa, desde el Plan anterior y repitiéndose en el 4º Plan de Acción, de los entes subnacionales en las discusiones y en la construcción de compromisos, así como la participación del Poder Legislativo en el proceso de elaboración e implementación de un Plan de Acción Nacional.\n\nLos temas priorizados para la elaboración de los compromisos fueron: transparencia fundiaria; gobierno abierto y clima; gobierno abierto y recursos hídricos; transparencia gubernamental en estados y municipios.\n\nLos compromisos del plan están asociados a los \"Objetivos de Desarrollo Sostenible de la Agenda 2030\".","description_en":"The formulation of Brazil’s Fourth National Action Plan followed the methodology used in the development of the Third Plan, as it successfully brought about a significant shift from previous plans and ensured stronger collaboration between government and civil society, resulting in more dynamic and targeted commitments. The new methodology sets out three work phases for the plan development process: i) Theme Definition Phase; ii) Co-creation Phase; and iii) Plan Approval Phase.\n\nKey highlights include the direct involvement, starting from the previous plan and continuing in the Fourth Action Plan, of subnational entities in the discussions and commitment development, as well as the participation of the Legislative Branch in the drafting and implementation of the National Action Plan.\n\nThe prioritized topics for commitment development were: land transparency; open government and climate; open government and water resources; and government transparency at the state and municipal levels.\n\nThe plan’s commitments are aligned with the “Sustainable Development Goals of the 2030 Agenda.”","linking_sdg_plans":"no","meta/instanceID":"uuid:98ebaa6d-197d-4217-abf5-7ecd04fa5460","meta/deprecatedID":"uuid:46b52510-7333-4fbe-a812-38e062125197","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"98ebaa6d-197d-4217-abf5-7ecd04fa5460","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:50","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:98ebaa6d-197d-4217-abf5-7ecd04fa5460"},{"_id":46640,"start":"2025-11-07T14:27:51.654-03:00","end":"2025-11-07T12:24:31.587-03:00","id_drupal":"1745","country":"cri","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad urbana sostenible para el Área Metropolitana de San José, Costa Rica","name_en":"Comprehensive Sustainable Urban Mobility Plan for the Metropolitan Area of San José, Costa Rica","responsible_institution":[{"responsible_institution/institution":"Ministerio de Ambiente y Energía","responsible_institution/id_institution":"45004","responsible_institution/name_institution":"Ministerio de Ambiente y Energía"},{"responsible_institution/institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica","responsible_institution/id_institution":"44992","responsible_institution/name_institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica"},{"responsible_institution/institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica","responsible_institution/id_institution":"45133","responsible_institution/name_institution":"Ministerio de Planificación Nacional y Política Económica (MIDEPLAN) de Costa Rica"}],"link":"36d09ef6-dc32-4489-97c1-e246dc87c3f8","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Área Metropolitana de San José (AMSJ)","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2035-01-01","effective_today":"yes","temporality":"long_term","description_es":"A nivel de su visión define lograr en el AMSJ un sistema de movilidad metropolitana integrado eficiente e inclusivo, que permita a todas las personas acceder a sus actividades de manera ágil, ordenada y en cualquier modo de transporte y promueva una circulación organizada, sustentable y enfocada al desarrollo local. Como objetivos puntuales se considera: Incentivar modos activos de movilidad, Planificación integral participativa, Ciudad sostenible Accesibilidad universal y género, Movilidad segura, eficiente y limpia Transporte público de calidad","description_en":"The vision for AMSJ is to achieve an integrated, efficient, and inclusive metropolitan mobility system, enabling everyone to access their activities quickly, orderly, and using any transport mode. It promotes organized, sustainable circulation focused on local development. Specific objectives include: Promote active mobility modes, participatory comprehensive planning, sustainable city, universal accessibility and gender inclusion, safe, efficient, and clean mobility, and quality public transport.","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"En la meta 3 movilidad segura, eficiente y limpia se considera: Plan de Fomento para la Incorporación de Vehículos Eléctricos.","pmu/pmu_implementation_en":"Goal 3 safe, efficient and clean mobility considers: Plan for the Promotion of the Incorporation of Electric Vehicles.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Mediante el Sistema Integrado de Transporte Público. La reestructuración y Modernización del Sistema de Buses. Un Tren Rápido de Pasajeros. Tarifa Integrada, Asequible y con Pago Electrónico.","pmu/pmu_prioritization_en":"Through the Integrated Public Transport System. The restructuring and modernization of the Bus System. A Fast Passenger Train. Integrated, Affordable Rate with Electronic Payment.","pmu/pmu_gender_es":"Contribuir a la equidad de género, en virtud de las diferencias que actualmente existen entre los distintos géneros en lo que respecta a los modos de ocupación del espacio público.","pmu/pmu_gender_en":"To contribute to gender equity, by virtue of the differences that currently exist between the different genders with regard to the modes of occupation of public space.","pmu/pmu_budget":"3431200000","__version__":"vSXeMtyk63M8JxuiLGRBWU","meta/instanceID":"uuid:3b3be2fb-a5b5-40ed-84bb-5acd2cae3bfe","meta/deprecatedID":"uuid:a59ae26b-e8f0-498a-be95-e15db6cad90d","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3b3be2fb-a5b5-40ed-84bb-5acd2cae3bfe","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:50","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3b3be2fb-a5b5-40ed-84bb-5acd2cae3bfe"},{"_id":46641,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:52.374","end":"2025-11-07T14:27:52.374","id_drupal":"634","country":"chl","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Chile (2012-2014)","name_en":"First National Open Government Action Plan of Chile (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile","responsible_institution/id_institution":"45342","responsible_institution/name_institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile"}],"coordinator":"Mesa Nacional de Estado Abierto de Chile","id_coordinator":"45154","name_coordinator":"Mesa Nacional de Estado Abierto de Chile","plan_number":"1","link":"ad72301e-9fac-4090-9aca-f474819fe238","primary_link":"https://www.ogp.gob.cl/wp-content/uploads/2019/06/Plan_Accion_Chile-20121.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Avanzar hacia un Gobierno Abierto ha sido una prioridad del Gobierno chileno. El presente plan, es un compromiso para continuar profundizando las iniciativas que apuntan en esa dirección. Desarrollar un Gobierno Abierto requiere del compromiso de todos aquellos que trabajan en el sector público y la colaboración de la sociedad entera para impulsar un conjunto de iniciativas vinculadas al mejoramiento de los servicios públicos, la integridad pública, el incremento de la responsabilidad institucional y la creación de comunidades más seguras.\n\nEl gobierno coordinó mesas de trabajo con representantes de otros servicios públicos, con las principales entidades a cargo de promover la transparencia en la gestión pública, el poder legislativo y la sociedad civil. Se propuso rendir cuenta pública participativa de manera trimestral sobre los avances y el cumplimiento de este plan de acción, haciendo una invitación abierta a la sociedad civil a participar en una sesión de presentación de los avances del plan. Asimismo, se propuso el establecimiento de mesas de trabajo semestrales para dar seguimiento al plan, y velar por la implementación conjunta de las iniciativas y su cumplimiento.","description_en":"Advancing towards Open Government has been a priority for the Chilean government. This plan is a commitment to continue deepening initiatives that point in that direction. Developing an Open Government requires the commitment of all public sector workers and the collaboration of society as a whole to promote initiatives aimed at improving public services, public integrity, institutional accountability, and creating safer communities. The government coordinated working groups with representatives of other public services, transparency-promoting institutions, the legislative branch, and civil society. A proposal was made to hold quarterly participatory public accountability sessions on the progress and compliance of this action plan, with an open invitation to civil society. Additionally, it proposed biannual working groups to monitor the plan and ensure the joint implementation and fulfillment of its initiatives.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2de2145f-4ab5-48f5-98d7-72cdaeb7ddc1","meta/deprecatedID":"uuid:6e7aed38-ffec-4b9d-869e-9e1920dccb3f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2de2145f-4ab5-48f5-98d7-72cdaeb7ddc1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:51","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2de2145f-4ab5-48f5-98d7-72cdaeb7ddc1"},{"_id":46642,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:53.093","end":"2025-11-07T14:27:53.093","id_drupal":"2003","country":"col","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Bogotá 2021-2023","name_en":"First Open Government Action Plan of Bogotá 2021-2023","responsible_institution":[{"responsible_institution/institution":"Secretaría General; Secretaría de Gobierno e IDPAC; y Secretaría de Planeación de Bogotá","responsible_institution/id_institution":"45166","responsible_institution/name_institution":"Secretaría General; Secretaría de Gobierno e IDPAC; y Secretaría de Planeación de Bogotá"}],"coordinator":"Círculo de Gobierno Abierto de Bogotá","id_coordinator":"45060","name_coordinator":"Círculo de Gobierno Abierto de Bogotá","plan_number":"1","link":"6e8ae8d7-890f-46bf-9156-0da09b00d783","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-bogota-colombia-2021-2023/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Capital de Bogotá","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Bogotá se unió a Alianza para el Gobierno Abierto  como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con género, salud, acceso a la justicia, prestación de servicios públicos y participación ciudadana.","description_en":"Bogotá joined the Open Government Partnership as part of the 2020 cohort. The first action plan includes commitments related to gender, health, access to justice, public service delivery, and citizen participation.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b23eacb8-3231-4b50-8e53-2041154666c5","meta/deprecatedID":"uuid:b1accbd9-9217-45a9-8f04-20b2a42f3fbb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b23eacb8-3231-4b50-8e53-2041154666c5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b23eacb8-3231-4b50-8e53-2041154666c5"},{"_id":46643,"start":"2025-11-07T14:27:53.805-03:00","end":"2026-03-10T12:11:18.956-03:00","id_drupal":"1985","country":"arg","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Corrientes (ciudad) 2022-2025","name_en":"First Open Government Action Plan of Corrientes (city) 2022-2025","responsible_institution":[{"responsible_institution/institution":"Dirección General de Innovación Pública y Gobierno Abierto - Subsecretaría de Modernización, Innovación y Tecnología de la Secretaría de Coordinación","responsible_institution/id_institution":"45317","responsible_institution/name_institution":"Dirección General de Innovación Pública y Gobierno Abierto - Subsecretaría de Modernización, Innovación y Tecnología de la Secretaría de Coordinación"}],"coordinator":"Mesas de cocreación de Corrientes","id_coordinator":"45107","name_coordinator":"Mesas de cocreación de Corrientes","plan_number":"1","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Corrientes","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Corrientes (Ciudad) se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022. El primer plan de acción presenta un compromiso relacionado con el medio ambiente y el clima.","description_en":"Corrientes (City) joined the Open Government Partnership as part of the 2022 cohort. The first action plan presents a commitment related to the environment and climate.","linking_sdg_plans":"no","meta/instanceID":"uuid:3da952c9-2741-4b63-be6f-9daf2214ed27","meta/deprecatedID":"uuid:e4772362-6d2a-4597-ad7c-08f994b673dc","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3da952c9-2741-4b63-be6f-9daf2214ed27","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3da952c9-2741-4b63-be6f-9daf2214ed27"},{"_id":46644,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:54.532","end":"2025-11-07T14:27:54.532","id_drupal":"1751","country":"per","theme":"mobility","original_language":"es","name_es":"Plan Maestro de Movilidad Urbana Sostenible de la Provincia de Piura","name_en":"Sustainable Urban Mobility Master Plan for the Province of Piura","responsible_institution":[{"responsible_institution/institution":"Municipalidad Provincial de Piura","responsible_institution/id_institution":"45207","responsible_institution/name_institution":"Municipalidad Provincial de Piura"}],"link":"3426477c-e625-4c01-af68-fddd6d09221e","primary_link":"https://scioteca.caf.com/bitstream/handle/123456789/1414/Plan%20de%20movilidad%20Piura.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Piura","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","description_es":"Brindar alternativas de trasnsporte eficientes, incluyentes y seguras para los habitantes de la provincia de Piura en favor del desarrollo sostenible y competitivo. Tres ejes estratégicos: sistemas de movilidad sostenibles, gestión eficiete, y vías seguras. ","description_en":"Provide efficient, inclusive, and safe transport alternatives for the inhabitants of the Piura province to foster sustainable and competitive development. Three strategic axes: sustainable mobility systems, efficient management, and safe roads.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"\"De forma indirecta mediante taxis: Creación de programas para fomentar la sustitución de la flota actual por vehiculos más eficientes y amigables con el ambiente.\"","pmu/pmu_implementation_en":"\"Indirectly through taxis: Creation of programs to encourage the replacement of the current fleet with more efficient and environmentally friendly vehicles.\"","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Fomentar transporte público y no motorizado Plan peatonal, espacios públicos de calidad en zonas estratégicas con los siguientes lineamientos: seguridad, accesibilidad, conectividad, funcionalidad, comodidad, legibilidad. Plan ciclista, fomentar el uso de la bicicleta como medio de transporte interurbano en las ciudades de la provincia, con una red de movilidad que cumpla con los siguientes requisitos: rutas directas, trayectos seguros, red coherente, recorridos atractivos, itinerarios cómodos. Plan del sistema de transporte público, aumentar el uso del transporte público masivo mediante la restructuración del servicio actual hacia un sistema integrado.","pmu/pmu_prioritization_en":"Promote public and non-motorized transport Pedestrian plan, quality public spaces in strategic areas with the following guidelines: safety, accessibility, connectivity, functionality, comfort, readability. Cycling plan, to promote the use of bicycles as a means of interurban transport in the cities of the province, with a mobility network that meets the following requirements: direct routes, safe routes, coherent network, attractive routes, comfortable itineraries. Plan of the public transport system, increase the use of mass public transport by restructuring the current service towards an integrated system.","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","pmu/pmu_budget":"72781694","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:4d35f457-3576-4fa0-9282-f33422fe11d7","meta/deprecatedID":"uuid:03d37967-d888-41c1-a151-51f90d42dc5f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4d35f457-3576-4fa0-9282-f33422fe11d7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4d35f457-3576-4fa0-9282-f33422fe11d7"},{"_id":46645,"start":"2025-11-07T14:27:55.261-03:00","end":"2025-12-30T12:52:57.572-03:00","id_drupal":"2061","country":"arg","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Buenos Aires 2016-2017","name_en":"1st Open Government Action Plan of Buenos Aires 2016-2017","responsible_institution":[{"responsible_institution/institution":"Secretaría General y Relaciones Internacionales de Buenos Aires","responsible_institution/id_institution":"45550","responsible_institution/name_institution":"Secretaría General y Relaciones Internacionales de Buenos Aires"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Buenos Aires","id_coordinator":"45103","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Buenos Aires","plan_number":"1","lin