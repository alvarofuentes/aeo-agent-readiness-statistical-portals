{"count":366,"next":null,"previous":null,"results":[{"_id":46337,"start":"2025-11-07T14:24:06.277-03:00","end":"2026-04-08T09:17:33.631-04:00","id_drupal":"748","country":"ecu","theme":"urban_development","original_language":"es","name_es":"Planes Urbanísticos Complementarios de Ecuador (PUC)","name_en":"Complementary Urban Plans of Ecuador (PUC)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Urbano y Vivienda","responsible_institution/id_institution":"45029","responsible_institution/name_institution":"Ministerio de Desarrollo Urbano y Vivienda"}],"link":"3669abab-aa91-4b6e-bed7-21191057816d","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Municipalities and/or Cities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los planes complementarios son instrumentos de planificación de los niveles de gobierno regional, provincial, municipal y metropolitano, que tienen por objeto detallar, complementar y desarrollar de forma específica lo establecido en los planes de desarrollo y ordenamiento territorial. Estos planes podrán referirse al ejercicio de una competencia exclusiva, o a zonas de áreas específicas del territorio que presenten características o necesidades diferenciadas.","description_en":"Complementary plans are planning instruments at the regional, provincial, municipal, and metropolitan levels of government, aimed at detailing, complementing, and specifically developing what is established in development and territorial planning instruments. These plans may refer to the exercise of an exclusive competence or to specific territorial areas that present differentiated characteristics or needs.","linking_sdg_plans":"yes","sdg":"sdg_11","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Autónomos Descentralizados de Ecuador","local_implementings/id_local_implementing":"45179","local_implementings/name_local_implementing":"Gobiernos Autónomos Descentralizados de Ecuador"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:e9fa70b3-d6df-4748-a671-c21e2cb6c6f5","meta/deprecatedID":"uuid:c733bcba-475d-4674-af55-c508a8847da8","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e9fa70b3-d6df-4748-a671-c21e2cb6c6f5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:05","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e9fa70b3-d6df-4748-a671-c21e2cb6c6f5"},{"_id":46338,"start":"2025-11-07T14:24:07.339-04:00","end":"2026-04-06T12:40:30.575-04:00","id_drupal":"851","country":"ven","theme":"territorial_planning","original_language":"es","name_es":"Plan Nacional de Ordenación del Territorio de Venezuela","name_en":"National Territorial Planning Plan of Venezuela","responsible_institution":[{"responsible_institution/institution":"Comisión Nacional de Ordenación del Territorio de Venezuela","responsible_institution/id_institution":"45443","responsible_institution/name_institution":"Comisión Nacional de Ordenación del Territorio de Venezuela"}],"link":"fca4f4d1-f210-4188-8477-dc8b9247a80f","primary_link":"http://www.ucv.ve/fileadmin/user_upload/cenamb/ley_organica_para_la_ordenacion_del_territorio.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"1983-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Plan Nacional de Ordenación del Territorio de Venezuela Compartir Compartir Según la Ley Orgánica para la Ordenación del Territorio de 1983, el Plan Nacional de Ordenación del Territorio es un instrumento a largo plazo que sirve de marco de referencia espacial a los planes de desarrollo de mediano y corto plazo del país, y también a los planes sectoriales adoptados por el Estado.","description_en":"According to the Organic Law for Land Use Planning of 1983, Venezuela’s National Land Use Plan is a long-term instrument that serves as a spatial reference framework for the country’s medium- and short-term development plans, as well as for the sectoral plans adopted by the State.","local_implementings":[{"local_implementings/local_implementing":"Comisión Nacional de Ordenación del Territorio de Venezuela","local_implementings/id_local_implementing":"45443","local_implementings/name_local_implementing":"Comisión Nacional de Ordenación del Territorio de Venezuela"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:afe27545-65cb-484c-a916-da31b42a599d","meta/deprecatedID":"uuid:68bb4f63-004a-42ed-831f-550f3c4d120f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"afe27545-65cb-484c-a916-da31b42a599d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:afe27545-65cb-484c-a916-da31b42a599d"},{"_id":46339,"start":"2025-11-07T14:24:08.070-03:00","end":"2026-04-08T09:14:00.661-04:00","id_drupal":"711","country":"chl","theme":"urban_development","original_language":"es","name_es":"Planes Reguladores Intercomunales de Chile","name_en":"Intercommunal Regulatory Plans of Chile","responsible_institution":[{"responsible_institution/institution":"Secretarías Regionales Ministeriales de Vivienda y Urbanismo de Chile","responsible_institution/id_institution":"45349","responsible_institution/name_institution":"Secretarías Regionales Ministeriales de Vivienda y Urbanismo de Chile"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Intercommunal Metropolitan Areas","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"La Planificación Urbana Intercomunal se realizará por medio del Plan Regulador Intercomunal o del Plan Regulador Metropolitano, en su caso, instrumentos constituidos por un conjunto de normas y acciones para orientar y regular el desarrollo físico del área correspondiente.\n\nLas disposiciones de los artículos siguientes, referentes al Plan Regulador Intercomunal, regirán igualmente para los Planes Reguladores Metropolitanos.\n\nEl Plan Regulador Intercomunal está compuesto de:\n\na) Una memoria explicativa, que contendrá los objetivos, metas y programas de acción;\n b) Una Ordenanza, que contendrá las disposiciones reglamentarias pertinentes, y\n c) Los planos, que expresen gráficamente las disposiciones sobre zonificación general, equipamiento, relaciones viales, áreas de desarrollo prioritario, límites de extensión urbana, densidades, etc.\n\nSe elaborarán Planes Reguladores Intercomunales cuando se busque regular el desarrollo físico de las áreas urbanas y rurales de diversas comunas que, por sus relaciones, se integran en una unidad urbana. Cuando esta unidad sobrepase los 500.000 habitantes, le corresponderá la categoría de área metropolitana para los efectos de su planificación.","description_en":"Intercommunal Urban Planning shall be carried out through the Intercommunal Regulatory Plan or, where applicable, the Metropolitan Regulatory Plan, which are instruments consisting of a set of regulations and actions aimed at guiding and regulating the physical development of the corresponding area.\n\nThe provisions of the following articles concerning the Intercommunal Regulatory Plan shall likewise apply to Metropolitan Regulatory Plans.\n\nThe Intercommunal Regulatory Plan is composed of:\na) An explanatory report, containing the objectives, goals, and action programs;\nb) An ordinance, containing the relevant regulatory provisions; and\nc) Maps and plans that graphically express the provisions on general zoning, facilities, transportation networks, priority development areas, urban extension limits, densities, and related matters.\n\nIntercommunal Regulatory Plans shall be prepared when the physical development of urban and rural areas of multiple communes—linked by their functional relationships—needs to be regulated as a single urban unit. When such a unit exceeds 500,000 inhabitants, it shall be classified as a metropolitan area for planning purposes.","linking_sdg_plans":"yes","sdg":"sdg_11","local_implementings":[{"local_implementings/local_implementing":"Secretarías Regionales Ministeriales de Vivienda y Urbanismo de Chile","local_implementings/id_local_implementing":"45349","local_implementings/name_local_implementing":"Secretarías Regionales Ministeriales de Vivienda y Urbanismo de Chile"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:91e31748-482f-4229-adff-c75b4b6ab5a6","meta/deprecatedID":"uuid:73a47486-603a-4bec-87cf-609bb466476f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"91e31748-482f-4229-adff-c75b4b6ab5a6","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:91e31748-482f-4229-adff-c75b4b6ab5a6"},{"_id":46340,"start":"2025-11-07T14:24:08.823-03:00","end":"2026-04-08T09:11:39.093-04:00","id_drupal":"691","country":"bol","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Municipal (PDM) de Bolivia","name_en":"Municipal Development Plans (PDM) of Bolivia","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación del Desarrollo (MPD) de Bolivia","responsible_institution/id_institution":"45246","responsible_institution/name_institution":"Ministerio de Planificación del Desarrollo (MPD) de Bolivia"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"El Plan de Desarrollo Municipal (PDM), es un instrumento de planificación participativa municipal, en el cual se encuentran el conjunto de reglas que establecen procedimientos, de operación, definiciones técnicas y administrativas y el marco institucional para el proceso de la planificación del desarrollo Municipal y el desempeño de roles y funciones de los actores involucrados. Cada PDM tiene una vigencia de cinco años, al cabo de los cuales debe ser actualizado.","description_en":"The Municipal Development Plan (PDM) is a municipal participatory planning instrument that sets out the set of rules establishing operational procedures, technical and administrative definitions, and the institutional framework for the municipal development planning process, as well as the performance of the roles and functions of the actors involved. Each PDM has a duration of five years, after which it must be updated.","linking_sdg_plans":"yes","sdg":"sdg_11","local_implementings":[{"local_implementings/local_implementing":"Gobiernos autónomos municipales de Bolivia","local_implementings/id_local_implementing":"45428","local_implementings/name_local_implementing":"Gobiernos autónomos municipales de Bolivia"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:a1102750-3b47-4a68-b017-cdfcc07cc87a","meta/deprecatedID":"uuid:bd544249-4f78-4b89-afa4-8b6f95ba5b68","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a1102750-3b47-4a68-b017-cdfcc07cc87a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a1102750-3b47-4a68-b017-cdfcc07cc87a"},{"_id":46341,"start":"2025-11-07T14:24:09.556-04:00","end":"2026-04-08T09:12:04.795-04:00","id_drupal":"690","country":"bol","theme":"urban_development","original_language":"es","name_es":"Planes Municipales de Ordenamiento Territorial (PMOT) de Bolivia","name_en":"Municipal Territorial Planning Plans (PMOT) of Bolivia","responsible_institution":[{"responsible_institution/institution":"Dirección General de Ordenamiento Urbano –DGOU","responsible_institution/id_institution":"45434","responsible_institution/name_institution":"Dirección General de Ordenamiento Urbano –DGOU"}],"link":"bc96b46a-f60a-499d-96aa-f71c651e1a57","primary_link":"https://www.biblioteca-urbana-bolivia.org/upload/docu","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Cubre la totalidad del territorio municipal (rural y urbano). El Plan de Ordenamiento Territorial, es un instrumento de carácter normativo, técnico político y administrativo para la gestión del territorio mediante el cual se planifica y regula el uso del suelo y se optimiza las modalidades de su ocupación.\n\nExisten al nivel nacional, departamental y municipal. Es un instrumento técnico-normativo de vigencia de 10 años, que permite facilitar el proceso de Ordenamiento Territorial, estableciendo normas y acciones referidas al uso de los recursos naturales, a la distribución de la población, de los servicios sociales, y de las actividades productivas. Los Planes de Ordenamiento Territorial son la base para los Planes de Desarrollo a los niveles nacional, departamental y municipal.\n\nEl PMOT tiene dos componentes:\n\n1. Plan de uso del suelo: instrumento técnico normativo que define las categorías y subcategorías de uso del suelo, así como las reglas de intervención, reglas de uso y recomendaciones de manejo con el fin de lograr el aprovechamiento sostenible de los recursos naturales del departamento o de los municipios.\n2. Plan de ocupación del territorio: instrumento que promueve la estructuración del territorio mediante su vertebración, la optimización funcional de los centros, redes, flujos, de las actividades productivas y distribución de los servicios, basada en la jerarquización de los asentamientos humanos con el propósito de generar la regionalización.","description_en":"It covers the entire municipal territory (both rural and urban areas). The Land Use Plan (Plan de Ordenamiento Territorial) is a normative, technical, political, and administrative instrument for territorial management, through which land use is planned and regulated, and the modes of occupation are optimized.\n\nSuch plans exist at the national, departmental, and municipal levels. It is a technical and regulatory instrument with a ten-year validity period that facilitates the territorial planning process by establishing rules and actions related to the use of natural resources, the distribution of the population, social services, and productive activities. Land Use Plans serve as the foundation for Development Plans at the national, departmental, and municipal levels.\n\nThe Municipal Land Use Plan (PMOT) has two components:\n1. Land Use Plan: A technical and regulatory instrument that defines land use categories and subcategories, as well as intervention rules, usage rules, and management recommendations, in order to ensure the sustainable use of the department’s or municipalities’ natural resources.\n2. Territorial Occupation Plan: An instrument that promotes the structuring of the territory through its articulation, the functional optimization of centers, networks, flows, productive activities, and the distribution of services, based on the hierarchy of human settlements with the aim of promoting regionalization.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos autónomos municipales de Bolivia","local_implementings/id_local_implementing":"45428","local_implementings/name_local_implementing":"Gobiernos autónomos municipales de Bolivia"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:15756702-8142-43bf-a985-95f3f7bee909","meta/deprecatedID":"uuid:51b89006-b0b2-4bac-931e-3f9bb8e19207","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"15756702-8142-43bf-a985-95f3f7bee909","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:08","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:15756702-8142-43bf-a985-95f3f7bee909"},{"_id":46342,"start":"2025-11-07T14:24:10.283-03:00","end":"2026-04-08T09:12:34.378-04:00","id_drupal":"693","country":"bol","theme":"urban_development","original_language":"es","name_es":"Planes de Intervención Urbana (PIU) de Bolivia","name_en":"Urban Intervention Plans (PIU) of Bolivia","responsible_institution":[{"responsible_institution/institution":"Dirección General de Ordenamiento Urbano –DGOU","responsible_institution/id_institution":"45434","responsible_institution/name_institution":"Dirección General de Ordenamiento Urbano –DGOU"}],"link":"11f77b81-6f5d-4975-8651-d6a63d70a0f7","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Los Planes de Intervención Urbana (PIU) son los instrumentos de implementación y ejecución del Plan de Ordenamiento Urbano y Territorial (POUT), que contienen las intervenciones integrales de infraestructura vial, vivienda, equipamiento, redes de servicios básicos y servicios públicos de las áreas de intervención urbana definidas en las áreas de propuesta urbana del POUT. \n\nLos PIU pueden conducir a diferentes modalidades de intervención:\n\n1. Plan de Intervención Urbana Especial (PIUE)\n2. Plan de renovación urbana (PRU)\n3. Plan de urbanización (PU)","description_en":"Urban Intervention Plans (PIU) are implementation and execution instruments of the Urban and Territorial Planning Plan (POUT). They include comprehensive interventions in road infrastructure, housing, facilities, basic service networks, and public services within the urban intervention areas defined in the urban proposal zones of the POUT.\n\nThe PIUs may lead to different types of intervention modalities:\n1. Special Urban Intervention Plan (PIUE)\n2. Urban Renewal Plan (PRU)\n3. Urban Development Plan (PU)","linking_sdg_plans":"yes","sdg":"sdg_11","local_implementings":[{"local_implementings/local_implementing":"Gobiernos autónomos municipales de Bolivia","local_implementings/id_local_implementing":"45428","local_implementings/name_local_implementing":"Gobiernos autónomos municipales de Bolivia"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:ca52b6ba-5624-46dd-a5ab-a0f886be01cf","meta/deprecatedID":"uuid:c9ee6816-4149-4bf7-b806-1f45232fa663","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ca52b6ba-5624-46dd-a5ab-a0f886be01cf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ca52b6ba-5624-46dd-a5ab-a0f886be01cf"},{"_id":46343,"start":"2025-11-07T14:24:11.063-03:00","end":"2026-04-08T09:14:24.263-04:00","id_drupal":"710","country":"chl","theme":"urban_development","original_language":"es","name_es":"Planes Reguladores Comunales de Chile","name_en":"Regulatory Communal Plans of Chile","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Urbanismo (MINVU)","responsible_institution/id_institution":"45169","responsible_institution/name_institution":"Ministerio de Vivienda y Urbanismo (MINVU)"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Communes","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Instrumento constituido por un conjunto de normas sobre las condiciones de higiene y seguridad en los espacios urbanos y edificios de la comuna.\n\nEste documento, además, contiene las disposiciones sobre el uso de suelo o zonificación; localización del equipamiento comunitario; jerarquización de la estructura vial; fijación de límites urbanos; densidades y determinación de prioridades en la urbanización de terrenos para la expansión de la ciudad, en función de la factibilidad de ampliar o dotar de redes sanitarias y energéticas; y demás aspectos urbanísticos.\n\nEl Plan Regulador debe contener:\na) una memoria explicativa\n b) un estudio de factibilidad para ampliar/dotar de condiciones de urbanización\n c) ordenanza local\n d) planos que expresen gráficamente las disposiciones sobre uso de suelo, zonificación, equipamiento, relaciones viales, límite urbano, áreas prioritarias de desarrollo urbano.","description_en":"An instrument composed of a set of regulations establishing hygiene and safety conditions in urban spaces and buildings within the municipality.\n\nThis document also includes provisions regarding land use and zoning, the location of community facilities, the hierarchical structure of the road network, the definition of urban boundaries, population densities, and the prioritization of land urbanization for city expansion, based on the feasibility of extending or providing sanitary and energy networks, among other urban planning aspects.\n\nThe Regulatory Plan must include:\na) an explanatory report;\nb) a feasibility study for expanding or providing urbanization conditions;\nc) a local ordinance; and\nd) maps that graphically express the provisions related to land use, zoning, public facilities, road hierarchy, urban boundaries, and priority areas for urban development.","linking_sdg_plans":"yes","sdg":"sdg_11","local_implementings":[{"local_implementings/local_implementing":"Gobiernos municipales de Chile","local_implementings/id_local_implementing":"45487","local_implementings/name_local_implementing":"Gobiernos municipales de Chile"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:6542c135-86d1-490d-9755-b22ece4c5bc3","meta/deprecatedID":"uuid:c7626fb7-1aca-4f8a-a5a7-42987708dde5","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6542c135-86d1-490d-9755-b22ece4c5bc3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:6542c135-86d1-490d-9755-b22ece4c5bc3"},{"_id":46344,"start":"2025-11-07T14:24:11.787-04:00","end":"2026-04-08T09:14:50.294-04:00","id_drupal":"712","country":"chl","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Comunal (PLADECO) de Chile","name_en":"Communal Development Plans (PLADECO) of Chile","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Desarrollo Regional y Adminstrativo (Subdere)","responsible_institution/id_institution":"45024","responsible_institution/name_institution":"Subsecretaría de Desarrollo Regional y Adminstrativo (Subdere)"}],"link":"cf6b7dbd-ef36-40ca-85ff-1f6e068e3d4f","primary_link":"https://www.desarrollosocialyfamilia.gob.cl/btca/txtcompleto/mideplan/metod.pladeco1-20.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Comunas","type_territorial_unit_en":"Communes","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"El Plan de Desarrollo Comunal (PLADECO) es un instrumento indicativo que cada municipio debe tener según la Ley Orgánica Constitucional de Municipalidades y debe orientar el desarrollo de la comuna. Tiene una duración mínima de cuatro años y debe ser aprobado por el concejo municipal. Se considera un instrumento mínimo para la gestión municipal.","description_en":"The Communal Development Plan (PLADECO) is an indicative instrument that every municipality must have, in accordance with the Constitutional Organic Law of Municipalities, and is intended to guide the development of the commune. It has a minimum duration of four years and must be approved by the municipal council. It is considered a basic instrument for municipal management.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos municipales de Chile","local_implementings/id_local_implementing":"45487","local_implementings/name_local_implementing":"Gobiernos municipales de Chile"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:9d59c72a-490d-4f87-aac3-7c28fcb5fde5","meta/deprecatedID":"uuid:ae010b91-3cca-4356-b886-c35743ff0ab3","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9d59c72a-490d-4f87-aac3-7c28fcb5fde5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9d59c72a-490d-4f87-aac3-7c28fcb5fde5"},{"_id":46345,"start":"2025-11-07T14:24:12.510-03:00","end":"2026-04-06T12:47:38.318-04:00","id_drupal":"20006","country":"col","theme":"territorial_planning","original_language":"es","name_es":"Programas de Desarrollo con Enfoque Territorial (PDET)","name_en":"Territorial Focused Development Programs","responsible_institution":[{"responsible_institution/institution":"Agencia de Renovación del Territorio (ART)","responsible_institution/id_institution":"45421","responsible_institution/name_institution":"Agencia de Renovación del Territorio (ART)"}],"link":"923ae2dc-601e-4ec5-b9e6-d858c91dab44","primary_link":"https://www.renovacionterritorio.gov.co/especiales/especial_pdet/","instrument_type":"program","instrument_type2":"program","territorial_scale":"subnational","type_territorial_unit_en":"Municipalities","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"long_term","description_es":"Los Programas de Desarrollo con Enfoque Territorial (PDET) son instrumentos de planificación y gestión subregional diseñados para promover la transformación estructural de los territorios rurales más afectados por el conflicto armado, la pobreza, las economías ilícitas y la debilidad institucional. Se conciben como un proceso de planificación participativa de largo plazo (aproximadamente 10–15 años) que busca equilibrar la relación entre el campo y la ciudad e incentivar el desarrollo rural integral en las 170 municipalidades y 16 subregiones priorizadas en el marco del Acuerdo de Paz.\n\nLos PDET se construyen a través de un proceso de planeación participativa que involucra a comunidades locales, organizaciones sociales, autoridades territoriales y otros actores clave, con miles de iniciativas formuladas directamente por las comunidades. Como parte de esta planificación, se elaboran los *Planes de Acción para la Transformación Regional (PATR)* que contienen las apuestas estratégicas del territorio para alcanzar sus objetivos de desarrollo integral. \n\nDesde la perspectiva del ordenamiento territorial, los PDET se vinculan con la organización del territorio al centrar la planificación en las necesidades específicas de cada región y su contexto geográfico, socioeconómico e institucional, integrando las visiones locales sobre uso del suelo, infraestructura, servicios y cohesión territorial como parte del desarrollo rural. Aunque su enfoque es más amplio que el ordenamiento territorial técnico, incorpora principios de gobernanza territorial y participación para orientar políticas e inversiones en función de la situación específica de cada territorio rural.","description_en":"The Territorially Focused Development Programs (PDET) are subregional planning and management instruments aimed at fostering the structural transformation of rural areas most affected by armed conflict, poverty, illicit economies, and weak institutions. These programs are part of Colombia’s Peace Agreement implementation and are designed to support long-term (approximately 10–15 year) participatory planning that promotes balanced relationships between rural and urban areas and advances comprehensive rural development across 170 prioritized municipalities and 16 subregions. \n\nPDETs are developed through broad participatory planning processes involving local communities, social organizations, and multiple levels of government. This process has generated thousands of community-driven initiatives and results in *Regional Transformation Action Plans (PATR)* that outline strategic territorial development priorities. \n\nRegarding territorial planning, while PDETs are broader than conventional land use planning instruments, they integrate territorial perspectives by aligning development priorities with each region’s geographic, social, and economic context. Through participatory engagement and governance structures, PDETs help guide investments, infrastructure, services, and policies based on local territorial needs, contributing to more coherent and inclusive territorial development.","local_implementings":[{"local_implementings/local_implementing":"Alcaldías/ Municipalidades de Colombia","local_implementings/id_local_implementing":"45419","local_implementings/name_local_implementing":"Alcaldías/ Municipalidades de Colombia"}],"link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley Orgánica de Ordenamiento Territorial de Colombia","link_block/legal_id":"49559","link_block/legal_name":"Ley Orgánica de Ordenamiento Territorial de Colombia"},{"link_block/link_type":"external","link_block/external_link_type":"plan","link_block/external_link_text_es":"Planes de Acción para la Transformación Regional (PATR)","link_block/external_link_text_en":"Regional Transformation Action Plans (PATR)","link_block/external_link_text_url":"https://www.renovacionterritorio.gov.co/territoriosdevida/pdet-patr.html"},{"link_block/link_type":"internal","link_block/internal_link_type":"actor","link_block/actor_link":"Agencia de Renovación del Territorio (ART)","link_block/actor_id":"45421","link_block/actor_name":"Agencia de Renovación del Territorio (ART)"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:290658a5-06a0-4244-bf63-4ae0ff0c4ea7","meta/deprecatedID":"uuid:40f119d7-3b06-4be9-9998-53cbd0c292b0","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"290658a5-06a0-4244-bf63-4ae0ff0c4ea7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:11","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:290658a5-06a0-4244-bf63-4ae0ff0c4ea7"},{"_id":46346,"start":"2025-11-07T14:24:13.230-04:00","end":"2026-04-08T09:15:39.080-04:00","id_drupal":"720","country":"col","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Territoriales de Colombia (PDT)","name_en":"Territorial Development Plans of Colombia (PDT0","responsible_institution":[{"responsible_institution/institution":"Departamento Nacional de Planeación (DNP) de Colombia","responsible_institution/id_institution":"44978","responsible_institution/name_institution":"Departamento Nacional de Planeación (DNP) de Colombia"}],"link":"5cb53a50-f951-47f4-b276-c55292aaab89","primary_link":"https://colaboracion.dnp.gov.co/CDT/Desarrollo%20Territorial/SisPT/Planes%20de%20Desarrollo%20Territorial.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos y municipios","type_territorial_unit_en":"Departments and municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Tal como lo establece el artículo 32 de la Ley 152 de 1994, las entidades territoriales “tienen autonomía en materia de planeación del desarrollo económico, social y de la gestión ambiental, en el marco de las competencias, recursos y responsabilidades que les han atribuido la Constitución y la Ley”.\n\nEn esta vía, se ha establecido el plan de desarrollo territorial como el instrumento de planificación con el cual las administraciones locales definen los programas y proyectos que ejecutarán durante su período de gobierno (4 años).\n\nEn  los planes de desarrollo realizados por los niveles subnacionales se definen:\n1. Los objetivos, metas y programas del gobierno local o departamental.\n 2. El Plan de inversiones a mediano y corto plazo\n\nDichos instrumentos deben  garantizar la articulación de las propuestas territoriales con las disposiciones realizadas a nivel nacional, por lo cual es fundamental que el contenido de los planes territoriales de desarrollo guarde coherencia con las políticas y estrategias del Plan Nacional.","description_en":"As established in Article 32 of Law 152 of 1994, territorial entities “have autonomy in matters of planning for economic, social, and environmental management within the framework of the competencies, resources, and responsibilities granted to them by the Constitution and the Law.”\n\nIn this regard, the territorial development plan has been established as the planning instrument through which local administrations define the programs and projects to be implemented during their term of government (four years).\n\nIn the development plans prepared by subnational levels, the following are defined:\n1. The objectives, goals, and programs of the local or departmental government.\n2. The medium- and short-term investment plan.\n\nThese instruments must ensure the alignment of territorial proposals with national-level provisions; therefore, it is essential that the content of territorial development plans remain consistent with the policies and strategies of the National Plan.","local_implementings":[{"local_implementings/local_implementing":"Alcaldías/ Municipalidades de Colombia","local_implementings/id_local_implementing":"45419","local_implementings/name_local_implementing":"Alcaldías/ Municipalidades de Colombia"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:c4f663f1-4cbd-4e72-9a40-570016558f63","meta/deprecatedID":"uuid:285d99f7-e24d-44f8-9d12-a2291cfd1365","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c4f663f1-4cbd-4e72-9a40-570016558f63","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c4f663f1-4cbd-4e72-9a40-570016558f63"},{"_id":46347,"start":"2025-11-07T14:24:13.946-04:00","end":"2026-04-08T09:15:59.524-04:00","id_drupal":"724","country":"cri","theme":"urban_development","original_language":"es","name_es":"Planes Reguladores de Costa Rica","name_en":"Regulatory Plans of Costa Rica","responsible_institution":[{"responsible_institution/institution":"Instituto Nacional de Vivienda y Urbanismo (INVU)","responsible_institution/id_institution":"45028","responsible_institution/name_institution":"Instituto Nacional de Vivienda y Urbanismo (INVU)"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Cantones","type_territorial_unit_en":"Cantons","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"El Plan Regulador es el instrumento de planificación local que define en un conjunto de planos, mapas, reglamentos y cualquier otro documento, gráfico o suplemento, la política de desarrollo y los planes para distribución de la población, usos de la tierra, vías de circulación, servicios públicos, facilidades comunales, y construcción, conservación y rehabilitación de áreas urbanas.\n\nEl plan regulador local contendrá los siguientes elementos, sin tener que limitarse a ellos:\na) La política de desarrollo, con enunciación de los principios y normas en que se fundamenta, y los objetivos que plantean las necesidades y el crecimiento del área a planificar;\nb) El estudio de la población, que incluirá proyecciones hacia el futuro crecimiento demográfico, su distribución y normas recomendables sobre densidad;\nc) El uso de la tierra que muestre la situación y distribución de terrenos respecto a vivienda, comercio, industria, educación, recreación, fines públicos y cualquier otro destino pertinente;\nd) El estudio de la circulación, por medio del cual se señale, en forma general, la localización de las vías públicas principales y de las rutas y terminales del transporte;\ne) Los servicios comunales, para indicar ubicación y tamaño de las áreas requeridas para escuelas, colegios, parques, campos de juego, unidades sanitarias, hospitales, bibliotecas, museos, mercados públicos y cualquier otro similar;\nf) Los servicios públicos, con análisis y ubicación en forma general de los sistemas e instalaciones principales de cañerías, hidrantes, alcantarillados sanitarios y pluviales, recolección y disposición de basuras, así como cualquier otro de importancia análoga.\ng) La vivienda y renovación urbana con exposición de las necesidades y objetivos en vivienda, y referencia a las áreas que deben ser sometidas a conservación, rehabilitación y remodelamiento.\n\nLa Constitución Política costarricense, reconoce la competencia y autoridad de los Gobiernos Locales para planificar y controlar el desarrollo urbano, dentro de los límites de su territorio jurisdiccional","description_en":"The Regulatory Plan is the local planning instrument that defines, through a set of plans, maps, regulations, and any other documents, graphics, or supplements, the development policy and plans for the distribution of the population, land uses, transportation routes, public services, community facilities, and the construction, conservation, and rehabilitation of urban areas.\n\nThe local regulatory plan shall include, but not be limited to, the following elements:\na) Development policy: setting out the principles and standards on which it is based, as well as the objectives that address the needs and growth of the area to be planned;\nb) Population study: including projections of future demographic growth, its distribution, and recommended standards for density;\nc) Land use: showing the location and distribution of land for housing, commerce, industry, education, recreation, public purposes, and any other relevant uses;\nd) Transportation study: indicating, in general terms, the location of main public roads and the routes and terminals of the transport system;\ne) Community services: specifying the location and size of areas required for schools, colleges, parks, playgrounds, health units, hospitals, libraries, museums, public markets, and other similar facilities;\nf) Public services: analyzing and generally locating the main systems and installations for pipelines, hydrants, sanitary and storm sewers, waste collection and disposal, as well as any other services of similar importance;\ng) Housing and urban renewal: identifying housing needs and objectives, and referring to areas that should be subject to conservation, rehabilitation, and redevelopment.\n\nThe Political Constitution of Costa Rica recognizes the authority and competence of Local Governments to plan and control urban development within the limits of their territorial jurisdiction.","local_implementings":[{"local_implementings/local_implementing":"Municipalidades cantonales de Costa Rica","local_implementings/id_local_implementing":"45431","local_implementings/name_local_implementing":"Municipalidades cantonales de Costa Rica"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:f9d13fa5-2fa9-454a-bdb9-a3e4ca7e5638","meta/deprecatedID":"uuid:4cffa648-740f-4f4f-9f23-325587bff021","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f9d13fa5-2fa9-454a-bdb9-a3e4ca7e5638","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:13","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f9d13fa5-2fa9-454a-bdb9-a3e4ca7e5638"},{"_id":46348,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:14.670","end":"2025-11-07T14:24:14.670","id_drupal":"737","country":"hnd","theme":"urban_development","original_language":"es","name_es":"Planes Estratégicos Municipales (PEM) de Honduras","name_en":"Municipal Strategic Plans (PEM) of Honduras","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación Estratégica (SPE) de Honduras","responsible_institution/id_institution":"44982","responsible_institution/name_institution":"Secretaría de Planificación Estratégica (SPE) de Honduras"}],"link":"d0675c0f-94d3-4189-b4a9-14687b904811","primary_link":"https://spe.gob.hn/storage/post_documents/LQOxv784VOZyiN79EENTN7IT4zjSWH0YlkkxhmRh.pdf","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Son instrumentos de la planificación local que deberán incluir los objetivos, alcances, políticas, estrategias y plan de acción. Estos planteamientos deberán guardar concordancia con los objetivos y la visión del Plan de Nación y de la planificación directriz sectorial. Serán elaborados por los gobiernos locales en procesos de participación ciudadana.","description_en":"They are instruments of local planning that must include objectives, scope, policies, strategies, and an action plan. These components must be consistent with the objectives and vision of the National Plan and the overarching sectoral planning framework. They shall be developed by local governments through citizen participation processes.","local_implementings":[{"local_implementings/local_implementing":"Municipalidades de Honduras/ Corporaciones Municipales","local_implementings/id_local_implementing":"45507","local_implementings/name_local_implementing":"Municipalidades de Honduras/ Corporaciones Municipales"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f3c6fffc-68e6-4d21-acbb-8ed8b579fdf4","meta/deprecatedID":"uuid:9af04847-e781-41fd-a378-dc8f8499a2cb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f3c6fffc-68e6-4d21-acbb-8ed8b579fdf4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:13","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f3c6fffc-68e6-4d21-acbb-8ed8b579fdf4"},{"_id":46349,"start":"2025-11-07T14:24:15.389-04:00","end":"2026-04-06T12:59:09.680-04:00","id_drupal":"738","country":"hnd","theme":"territorial_planning","original_language":"es","name_es":"Planes Municipales de Ordenamiento Territorial de Honduras (PMOT)","name_en":"Honduras Municipal Land Use Plan (PMOT)","responsible_institution":[{"responsible_institution/institution":"Departamento de Ordenamiento Territorial (DOT)","responsible_institution/id_institution":"45009","responsible_institution/name_institution":"Departamento de Ordenamiento Territorial (DOT)"}],"link":"dbab1725-9af1-4871-9186-f19f1ff94af6","primary_link":"https://sinit.hn/recursos-digitales/","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Instrumento técnico que orienta actividades de los sectores económico, ambiental y social en el ámbito municipal y sirve de referencia a los diferentes planes y estrategias sectoriales y está constituido por los planes de uso y ocupación territorial a nivel municipal.\n\nEl Plan Municipal de Ordenamiento Territorial se elaborará sobre la base del diagnóstico territorial, del análisis de uso del territorio y sus conflictos y de las perspectivas de uso y ocupación del territorio.\n\nEl Plan Municipal de Ordenamiento Territorial estará referido obligatoriamente al Plan Regional y al Plan Nacional de Ordenamiento Territorial.\n\nEl diagnóstico territorial será un proceso participativo que considerará los aspectos siguientes:\n\n1. Poblacionales tales como evolución, estructura, índices demográficos, características culturales y étnicas;\n \n2. Asentamientos humanos, su jerarquía, grado de ocupación, evolución, límites administrativos y vivienda;\n \n3. Sociales tales como salud, educación, equidad de género, participación ciudadana, seguridad alimentaria, organizaciones sociales y políticas y grupos de interés;\n \n4. Biofísicos tales como geología, geomorfología, suelo, clima, fauna y vegetación;\n \n5. Económicos tales como sistemas de producción por los sectores primario, secundario y terciario, capacidad de generación de empleo, potencial para el desarrollo industrial, financiero y comercial;\n \n6. Equipamiento social tales como servicios de agua potable y saneamiento, energía, comunicaciones, transporte e instalaciones educativas, de salud, deportivas, comunitarias, sanitarias y recreativas;\n \n7. Infraestructuras tales como sistema vial, obras hidráulicas y sistemas de riego;\n \n8. Vulnerabilidad de las personas, de la infraestructura, de los servicios y de los ecosistemas ante los fenómenos naturales;\n \n9. Legales e institucionales tales como declaratorias, reservas, sistema catastral, registros, régimen de propiedad, límites, competencias y autoridades.\nLa elaboración de los Planes Municipales de Ordenamiento Territorial será un proceso participativo y concertado, para lo cual deberá cumplirse con las fases siguientes:\n\n1. Preparación y promoción, lo cual implica el acuerdo de la Corporación, la organización de la participación y consultas a la población, solicitudes de asesoría técnica, identificación de fuentes de financiamiento y la creación de las unidades administrativas necesarias;\n \n2. Elaboración del diagnóstico territorial con el apoyo de facilitadores y de asistencia técnica, y elaboración de la visión o imagen objetivo territorial, y la validación comunitaria de los mismos;\n \n3. Planteamiento de alternativas territoriales, del plan de ordenamiento, del plan regulador, de planes de áreas municipales bajo régimen especial y de los reglamentos generales y específicos;\n \n4. Aprobación del Plan Municipal de Ordenamiento Territorial por la Corporación Municipal en Cabildo Abierto de acuerdo a los procedimientos previstos en el Título IV de este Reglamento General;\n \n5. Notificación a la Dirección para su verificación de la compatibilidad con el Plan Nacional y Regional y Registro.","description_en":"Technical instrument that guides the activities of the economic, environmental, and social sectors at the municipal level and serves as a reference for the various sectoral plans and strategies, and is constituted by the land-use and land-occupation plans at the municipal level.\n\nThe Municipal Land-Use Plan shall be developed on the basis of the territorial diagnosis, the analysis of land use and its conflicts, and the perspectives for land use and occupation.\n\nThe Municipal Land-Use Plan shall be mandatorily linked to the Regional Plan and the National Land-Use Plan.\n\nThe territorial diagnosis shall be a participatory process that considers the following aspects:\n\nPopulation: such as population growth, structure, demographic indices, cultural and ethnic characteristics;\n\nHuman settlements: their hierarchy, degree of occupation, evolution, administrative boundaries, and housing;\n\nSocial aspects: such as health, education, gender equity, citizen participation, food security, social and political organizations, and interest groups;\n\nBiophysical aspects: such as geology, geomorphology, soil, climate, fauna, and vegetation;\n\nEconomic aspects: such as production systems in the primary, secondary, and tertiary sectors, employment generation capacity, potential for industrial, financial, and commercial development;\n\nSocial facilities: such as potable water and sanitation services, energy, communications, transportation, and educational, health, sports, community, sanitary, and recreational facilities;\n\nInfrastructure: such as road systems, hydraulic works, and irrigation systems;\n\nVulnerability: of people, infrastructure, services, and ecosystems to natural phenomena;\n\nLegal and institutional aspects: such as declarations, reserves, cadastral system, registries, property regime, boundaries, competencies, and authorities.\n\nThe formulation of the Municipal Land-Use Plans shall be a participatory and coordinated process, which must comply with the following phases:\n\nPreparation and promotion, which implies the agreement of the Municipal Corporation, the organization of participation and community consultations, requests for technical assistance, identification of funding sources, and the creation of the necessary administrative units;\n\nElaboration of the territorial diagnosis with the support of facilitators and technical assistance, development of the territorial vision or target image, and community validation of the same;\n\nFormulation of territorial alternatives, the land-use plan, the regulatory plan, plans for municipal areas under special regimes, and the general and specific regulations;\n\nApproval of the Municipal Land-Use Plan by the Municipal Corporation in an Open Town Council, in accordance with the procedures set forth in Title IV of this General Regulation;\n\nNotification to the Directorate for verification of compatibility with the National and Regional Plan, and registration.","local_implementings":[{"local_implementings/local_implementing":"Municipalidades de Honduras/ Corporaciones Municipales","local_implementings/id_local_implementing":"45507","local_implementings/name_local_implementing":"Municipalidades de Honduras/ Corporaciones Municipales"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:8bc2ec26-2e4a-414c-b3af-51f7f7b09a68","meta/deprecatedID":"uuid:a80a4faa-793c-49ca-b656-22efb7ce3ed4","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8bc2ec26-2e4a-414c-b3af-51f7f7b09a68","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:14","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8bc2ec26-2e4a-414c-b3af-51f7f7b09a68"},{"_id":46350,"start":"2025-11-07T14:24:16.123-03:00","end":"2026-04-06T12:58:09.695-04:00","id_drupal":"10006","country":"ecu","theme":"territorial_planning","original_language":"es","name_es":"Planes de Desarrollo y Ordenamiento Territorial (PDOT)","name_en":"Territorial Development and Land-Use Planning Plans (PDOT)","responsible_institution":[{"responsible_institution/institution":"Secretaria Nacional de Planificación y Desarrollo (SENPLADES) de Ecuador","responsible_institution/id_institution":"44933","responsible_institution/name_institution":"Secretaria Nacional de Planificación y Desarrollo (SENPLADES) de Ecuador"}],"link":"af09fa58-8e24-4525-88be-9683d38f763a","primary_link":"https://www.planificacion.gob.ec/wp-content/uploads/downloads/2019/08/Folletos-autoridades-provinciales.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Regiones, provicnias y municipios","type_territorial_unit_en":"Regions, provinces and municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","visible_description":"no","description_es":"Los Planes de Desarrollo y Ordenamiento Territorial (PDOT) son instrumentos de planificación pública que elaboran los gobiernos autónomos descentralizados (provinciales, cantonales y parroquiales) para orientar el desarrollo socioeconómico y la gestión del territorio en sus jurisdicciones. Su propósito es integrar las prioridades de desarrollo con decisiones sobre el uso y gestión del suelo, respetando el entorno natural y promoviendo el bienestar de la población local.\n\n• Un PDOT típicamente contiene al menos:\n• Un diagnóstico territorial, que describe las condiciones actuales del territorio, sus capacidades y necesidades.\n• La definición de políticas y objetivos de desarrollo de largo y mediano plazo.\n• Lineamientos estratégicos como guías de acción.\n• Programas y proyectos concretos con metas, indicadores y mecanismos para la evaluación y el control social.\n\nEl proceso de actualización de un PDOT incluye varias fases participativas: el mapeo de actores locales, la consolidación de instancias de planificación, la elaboración de un documento preliminar con diagnóstico, propuesta y modelo de gestión, y la socialización/validación en asambleas locales. Finalmente, la propuesta se envía a la entidad planificadora nacional y al órgano legislativo local para su aprobación y publicación.","description_en":"Development and Territorial Planning Plans (PDOTs) are formal planning instruments prepared by Decentralized Autonomous Governments (GADs) at the provincial, cantonal, and parish levels. They are designed to guide socio-economic development and territorial management within a jurisdiction, balancing local priorities with environmental sustainability and public participation.\n\nA typical PDOT includes:\n• A territorial diagnosis that identifies current conditions, potentials, and needs of the territory.\n• Clearly defined development policies and objectives for both medium and long terms.\n• Strategic guidelines to guide implementation.\n• Programs and projects with specific goals and instruments for monitoring, evaluation, and accountability.\n\nThe PDOT updating process involves participatory stages such as stakeholder mapping, establishment of planning bodies, drafting a preliminary plan (diagnosis, proposals, and management model), and social validation in local assemblies. The draft is then forwarded to national planning authorities and local legislatures for legal approval and publication.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_5 sdg_13 sdg_15","local_implementings":[{"local_implementings/local_implementing":"Gobiernos regionales, provinciales, municipales y metropolitanos de Ecuador","local_implementings/id_local_implementing":"45314","local_implementings/name_local_implementing":"Gobiernos regionales, provinciales, municipales y metropolitanos de Ecuador"}],"link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Código Orgánico de Organización Territorial, Autonomía y Descentralización de Ecuador","link_block/legal_id":"49567","link_block/legal_name":"Código Orgánico de Organización Territorial, Autonomía y Descentralización de Ecuador"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:0dac6f96-c02a-4d68-b51c-e13b4777249c","meta/deprecatedID":"uuid:1de9c652-03bd-4e07-bd13-03dfb9e7c995","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0dac6f96-c02a-4d68-b51c-e13b4777249c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0dac6f96-c02a-4d68-b51c-e13b4777249c"},{"_id":46351,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:16.915","end":"2025-11-07T14:24:16.915","id_drupal":"756","country":"slv","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Urbano y Rural de El Salvador","name_en":"Urban and Rural Development Plans of El Salvador","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda","responsible_institution/id_institution":"45182","responsible_institution/name_institution":"Ministerio de Vivienda"}],"primary_link":"https://vivienda.gob.sv/planificacion-territorial-y-urbana/","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los Planes de Desarrollo Urbano y Rural tienen por objeto el ordenamiento y desarrollo integral del territorio para encauzar los procesos de desarrollo urbano y de desarrollo rural, estableciendo una regulación detallada de los referidos procesos. Estos Planes serán de ámbito municipal o micro regional, abarcando siempre municipios completos. Podrán comprender un ámbito micro regional cuando el proceso de asociatividad municipal y el desarrollo de las capacidades locales en materia de ordenamiento y desarrollo territorial alcance la totalidad del referido ámbito.\n\nLos Planes de Desarrollo Urbano y Rural tendrán el contenido apropiado para ejercer de acuerdo a planificación, la competencia urbanística y de uso de los suelos productivos y para otorgar permisos o autorizaciones, excepto en ámbitos en los que por el plan, se establezca la necesidad de planes parciales.\n\nLos Planes de Desarrollo Urbano y Rural se configurarán a partir de los siguientes contenidos mínimos:\n\n1) Esquemas de estructura territorial, con consideración explícita de la dimensión ambiental y de los factores de riesgo.\n2) Zonificación del territorio y determinación de usos globales del suelo.\n3) Ordenamiento detallado de áreas para las que el plan así lo prevea.\n4) Ordenamiento simplificado de áreas de limitada dinámica urbanística y medidas de consolidación de sus núcleos de población.\n5) Previsiones para la gestión y desarrollo del plan.\n6) Previsiones para la mejora de vida de la población y para el desarrollo rural.\n7) Régimen aplicable a los edificios e instalaciones existentes que incumplan el ordenamiento por no estar acorde con la nueva planificación; y,\n8) Las restantes determinaciones que conforme a derecho resulten convenientes para el mejor desarrollo del plan.","description_en":"Urban and Rural Development Plans aim to guide the organization and comprehensive development of the territory, directing urban and rural development processes through detailed regulation of such processes. These plans may have a municipal or micro-regional scope, always encompassing complete municipalities. They may cover a micro-regional area when municipal associations and the development of local capacities in territorial planning and management extend throughout the entire area.\n\nThe Urban and Rural Development Plans shall contain the necessary elements to exercise, in accordance with planning principles, the competence in urban planning and the use of productive land, and to grant permits or authorizations, except in areas where the plan establishes the need for partial plans.\n\nThe Urban and Rural Development Plans shall include, at a minimum, the following components:\n\n1. Schemes of territorial structure, explicitly considering environmental dimensions and risk factors.\n2. Zoning of the territory and determination of general land uses.\n3. Detailed planning of areas for which the plan provides such regulation.\n4. Simplified planning for areas with limited urban dynamics and measures for the consolidation of population centers.\n5. Provisions for plan management and implementation.\n6. Provisions for improving the population’s living conditions and promoting rural development.\n7. Regulations applicable to existing buildings and facilities that do not comply with the new planning framework; and\n8. Any other determinations deemed appropriate, in accordance with the law, to ensure the effective implementation of the plan.","local_implementings":[{"local_implementings/local_implementing":"Municipalides de El Salvador","local_implementings/id_local_implementing":"45449","local_implementings/name_local_implementing":"Municipalides de El Salvador"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:019511e9-18d2-4fb9-9c02-3e23c484d850","meta/deprecatedID":"uuid:cfc4d95f-e199-44a6-a5ed-6d2158ba7dba","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"019511e9-18d2-4fb9-9c02-3e23c484d850","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:16","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:019511e9-18d2-4fb9-9c02-3e23c484d850"},{"_id":46352,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:17.633","end":"2025-11-07T14:24:17.633","id_drupal":"757","country":"slv","theme":"urban_development","original_language":"es","name_es":"Planes Parciales de Ordenamiento Urbano El Salvador","name_en":"Partial Urban Planning Plans of El Salvador","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda","responsible_institution/id_institution":"45182","responsible_institution/name_institution":"Ministerio de Vivienda"}],"primary_link":"https://vivienda.gob.sv/planificacion-territorial-y-urbana/","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los Planes Parciales de Ordenamiento Urbano detallan el contenido de los planes municipales o micro regionales de ordenamiento y desarrollo territorial.\n\nEstos localizan las redes de infraestructuras y servicios públicos propias de su ámbito y establecen el régimen específico de cada lotificación, así como las condiciones de urbanización y edificación en el marco de la normativa general en la materia.\n\nAdemás, tienen por objeto establecer el régimen específico de urbanización y edificación, detallando el contenido de los planes municipales y/o micro regionales, de forma que pueda actuarse directamente sin necesidad de otros instrumentos de planificación.","description_en":"Partial Urban Planning Plans specify the content of municipal or micro-regional territorial planning and development plans.\n\nThese plans identify the infrastructure and public service networks within their respective areas and establish the specific regulations for each subdivision, as well as the urbanization and building conditions, in accordance with the general regulatory framework on the subject.\n\nIn addition, their purpose is to define the specific urbanization and building regulations, detailing the content of the municipal and/or micro-regional plans in such a way that actions can be implemented directly, without the need for additional planning instruments.","local_implementings":[{"local_implementings/local_implementing":"Municipalides de El Salvador","local_implementings/id_local_implementing":"45449","local_implementings/name_local_implementing":"Municipalides de El Salvador"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:96fb6a68-3d7b-4e82-a40a-663f3a5002a4","meta/deprecatedID":"uuid:29e94332-32d2-4062-9586-b90fb4a3ae97","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"96fb6a68-3d7b-4e82-a40a-663f3a5002a4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:16","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:96fb6a68-3d7b-4e82-a40a-663f3a5002a4"},{"_id":46353,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:18.353","end":"2025-11-07T14:24:18.353","id_drupal":"754","country":"slv","theme":"urban_development","original_language":"es","name_es":"Planes Municipales de Ordenamiento y Desarrollo Territorial (PMODT) de El Salvador","name_en":"Municipal Territorial Planning and Development Plans (PMODT) of El Salvador","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda","responsible_institution/id_institution":"45182","responsible_institution/name_institution":"Ministerio de Vivienda"}],"primary_link":"https://vivienda.gob.sv/planificacion-territorial-y-urbana/","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los planes municipales y micro regionales de ordenamiento y desarrollo territorial, tienen por objeto el ordenamiento integral del territorio a nivel local para encauzar los procesos de desarrollo urbano, rural y áreas de protección.\n\nEl ámbito de estos planes podrá ser municipal y micro regional, abarcando siempre municipios completos.\n\nLos planes municipales y micro regionales de ordenamiento y desarrollo territorial, contendrán básicamente un diagnóstico que permita establecer la caracterización básica de su ámbito, integración en el sistema socio-territorial departamental, sus procesos y políticas relevantes y el análisis de problemas y oportunidades que sirva de base para la formulación de dichos planes.\n\nEl plan deberá incluir las siguientes disposiciones:\n\n(1) Las divisiones del territorio.\n(2) La localización de servicios públicos y equipamientos urbanos generales al servicio del conjunto de todo el municipio o ámbitos superiores y de aquellos que constituyen elementos esenciales de las redes locales.\n(3) Previsiones relativas al desarrollo rural en el marco de los lineamientos establecidos por las instituciones competentes.\n(4) Normas y estándares de urbanización, lotificación y edificación.\n(5) Previsiones para su desarrollo en zonas urbanas no consolidadas o de expansión urbana.\n(6) Previsiones de actuación en zonas rurales.\n(7) Previsiones para la gestión del proceso de desarrollo; incluyendo, en su caso, la adscripción de zonas verdes u otros equipamientos a terrenos o ámbitos de desarrollo específicos a los efectos de su obtención mediante cesiones.\n(8) Régimen aplicable a los edificios e instalaciones existentes que se hallen fuera de ordenación por resultar disconformes con el nuevo planeamiento, en los que no podrán realizarse otras obras que las expresamente previstas en el plan. En defecto de previsión expresa en el planeamiento no podrán realizarse otras obras más que las de reparación y conservación ordinaria, quedando excluidas las de consolidación, ampliación o mejora.\n(9) Procedimientos y criterios para solicitar y realizar cambios dentro de la zonificación del plan. Definiendo un sistema de compensación al municipio, cuando se solicite un cambio de zona no urbanizable o rural a zona de expansión urbana.\n(10) Procedimientos y/o trámites para la obtención de permisos para construcción, urbanización y lotificación así como cambios de zonificación y usos del suelo.\n(11) Definición de zonas sujetas a planes parciales, en aquellos lugares susceptibles a cambios importantes de usos del suelo y/o inversión pública y privada.","description_en":"Municipal and Micro-Regional Territorial Planning and Development Plans aim to ensure the comprehensive organization of the territory at the local level, guiding urban and rural development processes as well as areas under protection.\n\nThe scope of these plans may be municipal or micro-regional, always encompassing complete municipalities.\n\nMunicipal and Micro-Regional Territorial Planning and Development Plans shall include, as a minimum, a diagnostic assessment that allows for the characterization of their area, its integration within the departmental socio-territorial system, relevant processes and policies, and the analysis of problems and opportunities serving as the basis for plan formulation.\n\nThe plan must include the following provisions:\n\n(1) The divisions of the territory.\n(2) The location of public services and general urban facilities serving the municipality as a whole or broader areas, as well as those that form essential components of local networks.\n(3) Provisions related to rural development within the framework established by the competent institutions.\n(4) Urbanization, subdivision, and building standards and regulations.\n(5) Provisions for development in unconsolidated or urban expansion areas.\n(6) Provisions for interventions in rural areas.\n(7) Provisions for managing the development process, including, where appropriate, the assignment of green areas or other facilities to specific development areas for their acquisition through land transfers.\n(8) The regime applicable to existing buildings and facilities that are inconsistent with the new planning framework, where no works may be carried out other than those expressly provided for in the plan. In the absence of express provisions, only ordinary repair and maintenance works shall be permitted, excluding consolidation, expansion, or improvement works.\n(9) Procedures and criteria for requesting and implementing changes within the plan’s zoning, defining a compensation system for the municipality when a change is requested from non-developable or rural land to urban expansion areas.\n(10) Procedures and/or steps required for obtaining permits for construction, urbanization, and subdivision, as well as for changes in zoning and land use.\n(11) Definition of areas subject to partial plans, in locations likely to undergo significant changes in land use and/or public and private investment.","local_implementings":[{"local_implementings/local_implementing":"Municipalides de El Salvador","local_implementings/id_local_implementing":"45449","local_implementings/name_local_implementing":"Municipalides de El Salvador"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:69711cb4-6d6d-433c-91d7-39f17e5c1990","meta/deprecatedID":"uuid:743e4e88-384a-486d-b250-0f7b32b5a311","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"69711cb4-6d6d-433c-91d7-39f17e5c1990","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:69711cb4-6d6d-433c-91d7-39f17e5c1990"},{"_id":46354,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:19.080","end":"2025-11-07T14:24:19.080","id_drupal":"770","country":"gtm","theme":"urban_development","original_language":"es","name_es":"Plan Regulador Municipal de Guatemala","name_en":"Municipal Regulatory Plan of Guatemala ","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación y Programación de la Presidencia (SEGEPLAN) de Guatemala","responsible_institution/id_institution":"44969","responsible_institution/name_institution":"Secretaría de Planificación y Programación de la Presidencia (SEGEPLAN) de Guatemala"}],"link":"d8a48c78-0025-4d98-ba9b-a339468f2182","primary_link":"https://portal.segeplan.gob.gt/segeplan/wp-content/uploads/2022/08/Guia_PDM_OT.pdf","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Para los efectos del desarrollo urbanístico de las ciudades, las municipalidades de las cabeceras departamentales y de las poblaciones de más de 10,000 habitantes deberán por sí mismas (o por contrato) realizar -de conformidad con las recomendaciones del caso- los estudios para implantar en sus áreas de influencia urbana un plan regulador adecuado que contemple lo siguiente:\n\na) El sistema vial\nb) Los servicios públicos\nc) Los sistemas de tránsito y transportación\nd) El sistema recreativo y de espacios abiertos\ne) Los edificios públicos y servicios comunales\nf) Las zonas residenciales\ng) Las zonas comerciales\nh) Las zonas industriales\ni) Las zonas de servidumbre de reserva\n j) Cualesquiera otros aspectos que sea conveniente determinar","description_en":"For the purposes of urban development in cities, the municipalities of departmental capitals and towns with more than 10,000 inhabitants must, either directly or through contracts, carry out—according to relevant recommendations—the studies necessary to implement, within their areas of urban influence, an appropriate regulatory plan that includes the following:\n\na) The road system\nb) Public services\nc) Traffic and transportation systems\nd) The recreational system and open spaces\ne) Public buildings and community services\nf) Residential areas\ng) Commercial areas\nh) Industrial areas\ni) Easement and reserve zones\nj) Any other aspects deemed appropriate to determine","local_implementings":[{"local_implementings/local_implementing":"Gobiernos municipales de Guatemala","local_implementings/id_local_implementing":"45542","local_implementings/name_local_implementing":"Gobiernos municipales de Guatemala"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0a477860-beb6-4829-b95f-8a1f59b96c54","meta/deprecatedID":"uuid:41f9afbc-980d-4d08-ac8d-041cb4d737a1","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0a477860-beb6-4829-b95f-8a1f59b96c54","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0a477860-beb6-4829-b95f-8a1f59b96c54"},{"_id":46355,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:19.799","end":"2025-11-07T14:24:19.799","id_drupal":"769","country":"gtm","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Municipal y Ordenamiento Territorial de Guatemala","name_en":"Municipal Development and Territorial Planning Plans of Guatemala","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación y Programación de la Presidencia (SEGEPLAN) de Guatemala","responsible_institution/id_institution":"44969","responsible_institution/name_institution":"Secretaría de Planificación y Programación de la Presidencia (SEGEPLAN) de Guatemala"}],"link":"fcae96c3-367d-4560-921e-f870b65451b6","primary_link":"https://portal.segeplan.gob.gt/segeplan/wp-content/uploads/2022/08/Guia_PDM_OT.pdf","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"El Plan de Desarrollo deberá tener los siguientes elementos:\n1. Visión de desarrollo\n2. Organización territorial futura\n3. Usos futuros del territorio\n4. Modelo de Desarrollo Territorial Futuro. Este modelo deberá incluir un escenario futuro, resultados y productos estratégicos de desarrollo, directrices y lineamientos normativos de ordenamiento territorial.\n\nEl plan deberá ser aprobado por el concejo municipal.\n\nEn su elaboración, deberán estar presentes 4 etapas:\nFase 1: Generación de condiciones y prediagnóstico\nFase 2: Diagnóstico y análisis territorial, incluyendo un análisis de amenazas y vulnerabilidades, usos actuales, análisis de problemáticas y potencialidades, análisis de escenarios, modelo de desarrollo territorial actual.\nFase 3: Planificación y Ordenamiento Territorial, incluyendo visión de desarrollo, organización territorial futura, usos futuros del territorio, modelo de desarrollo territorial futuro.\nFase 4: Gestión y seguimiento, incluyendo socialización del PDM-OT, Gestión interinstitucional y alianzas, Instrumento de gestión, Instrumento de gestión, acciones de seguimiento, informes de seguimiento.","description_en":"The Development Plan must include the following elements:\n\n1. Development vision\n2. Future territorial organization\n3. Future land uses\n4. Future Territorial Development Model — this model must include a future scenario, strategic development outcomes and products, as well as regulatory guidelines and directives for territorial planning.\n\nThe plan must be approved by the municipal council.\n\nIts formulation should include four stages:\nPhase 1: Creation of enabling conditions and preliminary diagnosis\nPhase 2: Territorial diagnosis and analysis, including the assessment of threats and vulnerabilities, current land uses, problem and potential analysis, scenario analysis, and the current territorial development model\nPhase 3: Territorial Planning and Land Use Management, including the development vision, future territorial organization, future land uses, and the future territorial development model\nPhase 4: Management and monitoring, including dissemination of the Municipal Development and Territorial Planning Plan (PDM-OT), inter-institutional coordination and partnerships, management instruments, follow-up actions, and monitoring reports.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos municipales de Guatemala","local_implementings/id_local_implementing":"45542","local_implementings/name_local_implementing":"Gobiernos municipales de Guatemala"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:e45ecfa4-84a7-4776-a822-9485ff75ed41","meta/deprecatedID":"uuid:d227f764-c8eb-4ec2-8c6b-c4733db1386f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e45ecfa4-84a7-4776-a822-9485ff75ed41","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e45ecfa4-84a7-4776-a822-9485ff75ed41"},{"_id":46356,"start":"2025-11-07T14:24:20.511-03:00","end":"2026-01-29T12:48:31.244-03:00","id_drupal":"783","country":"mex","theme":"urban_development","original_language":"es","name_es":"Planes y Programas Municipales de Desarrollo Urbano en México","name_en":"Municipal Urban Development Plans and Programs in Mexico","responsible_institution":[{"responsible_institution/institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)","responsible_institution/id_institution":"45027","responsible_institution/name_institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)"}],"link":"924a4bbd-4ebe-461c-b400-563efb52881a","primary_link":"https://sedui.edomex.gob.mx/planes_municipales_de_desarrollo_urbano","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"La Ley General de Asentamientos Humanos, Ordenamiento Territorial y Desarrollo Urbano, establece que los Planes y Programas municipales de Desarrollo Urbano señalarán las acciones específicas necesarias para la Conservación, Mejoramiento y Crecimiento de los Centros de Población, asimismo establecerán la Zonificación correspondiente. \n\nLas entidades federativas y los municipios promoverán la elaboración de programas parciales y polígonos de actuación que permitan llevar a cabo acciones específicas para el Crecimiento, Mejoramiento y Conservación de los Centros de Población, para la formación de conjuntos urbanos y barrios integrales.\n\nDichos programas parciales serán regulados por la legislación estatal y podrán integrar los planteamientos sectoriales del Desarrollo Urbano, en materias tales como: centros históricos, Movilidad, medio ambiente, vivienda, agua y saneamiento, entre otras.\n\nLas leyes locales establecerán esquemas simplificados de planeación para las localidades menores a cincuenta mil habitantes que, en su caso, deberán tener la debida congruencia, coordinación y ajuste con planes o programas de Desarrollo Urbano elaborados conforme a las disposiciones de esta Ley.\n\nLos planes y programas de Desarrollo Urbano deberán considerar los ordenamientos ecológicos y los criterios generales de regulación ecológica de los Asentamientos Humanos establecidos en el artículo 23 de la Ley General del Equilibrio Ecológico y la Protección al Ambiente y en las normas oficiales mexicanas en materia ecológica.","description_en":"The General Law on Human Settlements, Land Use Planning and Urban Development establishes that municipal Urban Development Plans and Programs shall identify the specific actions required for the conservation, improvement, and growth of population centers, and shall also define the corresponding zoning.\n\nThe federal entities and municipalities shall promote the formulation of partial programs and action polygons to implement specific actions for the growth, improvement, and conservation of population centers, as well as for the creation of urban complexes and integrated neighborhoods.\n\nThese partial programs shall be regulated by state legislation and may incorporate sectoral approaches to urban development in areas such as historic centers, mobility, environment, housing, water and sanitation, among others.\n\nLocal laws shall establish simplified planning frameworks for localities with fewer than 50,000 inhabitants, which, where applicable, must maintain due consistency, coordination, and alignment with Urban Development Plans or Programs prepared in accordance with the provisions of this Law.\n\nUrban Development Plans and Programs must also take into account ecological zoning and the general criteria for the ecological regulation of human settlements, as established in Article 23 of the General Law on Ecological Balance and Environmental Protection, and in the relevant official Mexican ecological standards.","linking_sdg_plans":"yes","sdg":"sdg_11 sdg_12","local_implementings":[{"local_implementings/local_implementing":"Entidades federativas y municipios de México","local_implementings/id_local_implementing":"44976","local_implementings/name_local_implementing":"Entidades federativas y municipios de México"}],"meta/instanceID":"uuid:59e5e112-8012-4092-a859-8c40a2ffd8af","meta/deprecatedID":"uuid:017c2c09-8e2b-4e44-a17e-ced2e885f97f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"59e5e112-8012-4092-a859-8c40a2ffd8af","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:19","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:59e5e112-8012-4092-a859-8c40a2ffd8af"},{"_id":46357,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:21.243","end":"2025-11-07T14:24:21.243","id_drupal":"791","country":"nic","theme":"urban_development","original_language":"es","name_es":"Planes de Ordenamiento Territorial Municipal de Nicaragua","name_en":"Municipal Territorial Planning Plan of Nicaragua","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Según el Decreto Ejecutivo N°78-2002 (Art. 59), el Plan de Ordenamiento Territorial Municipal es el instrumento rector de planificación municipal y debe proponer lineamientos para el uso y ocupación del suelo, reconociendo las potencialidades, limitantes y conflictos presentes en el territorio, así como su  organización funcional. \n\nLos Planes de Ordenamiento Territorial Municipal tienen como objetivos fundamentales:\n1) Formular una política municipal de manejo del territorio para el desarrollo sostenible.\n2) Elaborar una propuesta concertada para orientar los usos de la tierra y la localización funcional de las actividades e infraestructuras, de forma que se fomente el aprovechamiento adecuado de los potencialidades, la recuperación de los espacios degradados y la mitigación de los conflictos e impactos ambientales.\n3) Definir las áreas vulnerables del territorio ante fenómenos naturales y proponer las medidas necesarias para la mitigación de los posibles daños.\n4) Proponer e implementar las medidas necesarias para la solución de los conflictos relativos al manejo del territorio municipal, tanto urbano como rural.\n5) Establecer un marco normativo para orientar e implementar las acciones y usos previstos en el plan, así como la determinación de mecanismos de seguimiento y gestión, que le permitan a la administración ajustar periódicamente las metas y actuaciones.\n6) Prever el futuro desarrollo del municipio mediante el diseño de escenarios alternativos de desarrollo, que fortalezcan las relaciones y vínculos funcionales entre el sistema de asentamientos, los usos y actividades actuales y previstas.\n7) Orientar los diferentes usos de la tierra.\n8) Contribuir a la distribución equilibrada y equitativa de la inversión pública, según los requerimientos actuales y futuros de la población en cuanto a infraestructura física y servicios.","description_en":"According to Executive Decree No. 78-2002 (Art. 59), the Municipal Land Use Plan (Plan de Ordenamiento Territorial Municipal) is the guiding instrument for municipal planning and must propose guidelines for land use and occupation, recognizing the potentialities, constraints, and conflicts present in the territory, as well as its functional organization.\n\nThe Municipal Land Use Plans have the following main objectives:\n1. Formulate a municipal policy for land management aimed at sustainable development.\n2. Develop a concerted proposal to guide land uses and the functional location of activities and infrastructure, in order to promote the appropriate use of potential resources, the recovery of degraded areas, and the mitigation of environmental conflicts and impacts.\n3. Identify vulnerable areas of the territory in relation to natural phenomena and propose the necessary measures to mitigate potential damages.\n4. Propose and implement the necessary measures to resolve conflicts related to the management of municipal land, both urban and rural.\n5. Establish a regulatory framework to guide and implement the actions and uses foreseen in the plan, as well as mechanisms for monitoring and management that allow the administration to periodically adjust goals and actions.\n6. Anticipate the future development of the municipality through the design of alternative development scenarios that strengthen relationships and functional linkages among the settlement system, current and planned land uses, and activities.\n7. Guide the different land uses.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Municipales de Nicaragua","local_implementings/id_local_implementing":"45120","local_implementings/name_local_implementing":"Gobiernos Municipales de Nicaragua"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9ab4fc62-426e-4525-ba34-e36422c1a476","meta/deprecatedID":"uuid:01657ad5-bc68-4b1b-8b01-4265aa5d3e79","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9ab4fc62-426e-4525-ba34-e36422c1a476","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:20","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9ab4fc62-426e-4525-ba34-e36422c1a476"},{"_id":46358,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:21.983","end":"2025-11-07T14:24:21.983","id_drupal":"789","country":"nic","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Municipal (PDM) de Nicaragua","name_en":"Municipal Development Plans (PDM) of Nicaragua","instrument_type":"plan","territorial_scale":"subnational","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"El  Plan de Desarrollo Municipal es un instrumento de planificación participativa que refleja los esfuerzos integrados del Gobierno Municipal con los Actores Locales, en el cual se definen los Ejes de Desarrollo y las Líneas Estratégicas a seguir para alcanzar el desarrollo del municipio en el corto, mediano y largo plazo.","description_en":"The Municipal Development Plan is a participatory planning instrument that reflects the integrated efforts of the Municipal Government and local stakeholders. It defines the development pillars and strategic lines to be followed in order to achieve the municipality’s development goals in the short, medium, and long term.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Municipales de Nicaragua","local_implementings/id_local_implementing":"45120","local_implementings/name_local_implementing":"Gobiernos Municipales de Nicaragua"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:fe8b5243-6a72-445a-ad4b-250cfbd3fbaf","meta/deprecatedID":"uuid:ea1648bf-c622-419c-86ea-8d7fdcce73ef","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"fe8b5243-6a72-445a-ad4b-250cfbd3fbaf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:21","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:fe8b5243-6a72-445a-ad4b-250cfbd3fbaf"},{"_id":46359,"start":"2025-11-07T14:24:22.712-04:00","end":"2026-04-06T12:52:35.881-04:00","id_drupal":"803","country":"pan","theme":"territorial_planning","original_language":"es","name_es":"Planes Locales de Ordenamiento Territorial y Urbano Panamá","name_en":"Local Town and Territorial Planning Plans Panama","responsible_institution":[{"responsible_institution/institution":"Dirección de Ordenamiento Territorial","responsible_institution/id_institution":"45266","responsible_institution/name_institution":"Dirección de Ordenamiento Territorial"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Distritos","type_territorial_unit_en":"Districts","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Según la Ley 6 de 2006, el Plan Local es el instrumento de planificación de alcance municipal para el logro de un desarrollo equilibrado de su territorio, en concordancia con los planes nacionales y regionales. Estos planes deben incorporar:\n\n1. Definición de las estrategias territoriales de uso, ocupación y manejo del suelo, en función de los objetivos económicos, sociales, urbanísticos y ambientales de la nación panameña;\n2. Diseño y adopción de los instrumentos y procedimientos de gestión y actuación, que permitan ejecutar actuaciones urbanas integrales y articular las actuaciones, por sector, que afecten la estructura del territorio. Además a un nivel general también se plantea que las actuaciones deberán atender las condiciones de diversidad étnica y cultural y el pluralismo. \n\nDe la misma manera, incorporarán los instrumentos que permitan optimizar la utilización de los recursos naturales y humanos para el logro de condiciones de vida digna para la población actual y futura.\n\nPor otra parte los instrumentos de escala local (Planes Locales y Planes Parciales) deben contener, adicionalmente la delimitación de las áreas de expansión urbana; los sitios para el tratamiento de residuos tóxicos y peligros; y las normativas para discapacitados.","description_en":"According to Law 6 of 2006, the Local Plan is the municipal-level planning instrument to achieve balanced development of its territory, aligned with national and regional plans. These plans must include:\n\n1. Definition of territorial strategies for land use, occupation, and management, in accordance with Panama’s economic, social, urban, and environmental objectives;\n2. Design and adoption of management and operational instruments and procedures that allow for integrated urban actions and coordination across sectors affecting the territory’s structure.\n\nAt a general level, the plans must also address ethnic and cultural diversity and pluralism. Additionally, they must include instruments to optimize the use of natural and human resources to achieve decent living conditions for the current and future population.\n\nMoreover, local-scale instruments (Local and Partial Plans) must also include: Delimitation of urban expansion areas; Sites for hazardous and toxic waste treatment; Regulations for persons with disabilities.","local_implementings":[{"local_implementings/local_implementing":"Municipalidades de Panamá","local_implementings/id_local_implementing":"45134","local_implementings/name_local_implementing":"Municipalidades de Panamá"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:6ec8a790-6632-430f-9fa1-17cf434f6f0b","meta/deprecatedID":"uuid:71be897c-2f8c-42e4-abc0-c7d555c30068","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6ec8a790-6632-430f-9fa1-17cf434f6f0b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:21","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:6ec8a790-6632-430f-9fa1-17cf434f6f0b"},{"_id":46360,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:23.442","end":"2025-11-07T14:24:23.442","id_drupal":"806","country":"pry","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Sostenible Municipal de Paraguay (PDSM)","name_en":"Sustainable Development Plans of the Municipalities of Paraguay","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"link":"f2d7c7bd-5a2b-4ed3-94cb-6c35d32033db","primary_link":"https://www.stp.gov.py/v1/wp-content/uploads/2018/07/Gu%C3%ADa-Plan-de-Desarrollo-Municipal.pdf","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","effective_since":"2010-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"El Plan de Desarrollo Sustentable es un instrumento técnico y de gestión municipal en el que se define los objetivos, líneas estratégicas, programas y proyectos en los ámbitos social, económico, ambiental, institucional y de infraestructura orientados a lograr la equidad social, el crecimiento económico y la sustentabilidad ecológica en el municipio. Contendrá: plan social, plan ambiental y plan económico. ","description_en":"The Sustainable Development Plan is a technical and municipal management instrument that defines the objectives, strategic lines, programs, and projects in the social, economic, environmental, institutional, and infrastructure areas, aimed at achieving social equity, economic growth, and ecological sustainability within the municipality. It includes a social plan, an environmental plan, and an economic plan.","local_implementings":[{"local_implementings/local_implementing":"Municipalidades de Paraguay","local_implementings/id_local_implementing":"45208","local_implementings/name_local_implementing":"Municipalidades de Paraguay"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b0b3bbc3-9aa8-4ccd-8529-e03aea594130","meta/deprecatedID":"uuid:94190351-9ec2-4074-a710-395b01212fc4","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b0b3bbc3-9aa8-4ccd-8529-e03aea594130","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:22","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b0b3bbc3-9aa8-4ccd-8529-e03aea594130"},{"_id":46361,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:24.153","end":"2025-11-07T14:24:24.153","id_drupal":"814","country":"per","theme":"urban_development","original_language":"es","name_es":"Planes de Acondicionamiento Territorial (PAT) de Perú","name_en":"Territorial Conditioning Plans (PAT) of Peru","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda, Construcción y Saneamiento de Perú","responsible_institution/id_institution":"45264","responsible_institution/name_institution":"Ministerio de Vivienda, Construcción y Saneamiento de Perú"}],"link":"578c1c88-b1f0-4e62-90a1-d1e8b0111994","primary_link":"https://cdn.www.gob.pe/uploads/document/file/305956/Manual_para_la_elaboracio%CC%81n_de_los_PAT_en_el_Marco_de_la_RCC.pdf","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Provincias","type_territorial_unit_en":"Provinces","effective_since":"2011-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"El Plan de Acondicionamiento Territorial (PAT) es el instrumento técnico-normativo que tiene como objetivo orientar y regular la organización física y espacial de las actividades humanas respecto a su distribución, jerarquía, roles y funciones de los centros poblados en los ámbitos urbano y rural. ","description_en":"The Territorial Conditioning Plan (PAT) is a technical and regulatory instrument aimed at guiding and regulating the physical and spatial organization of human activities in relation to the distribution, hierarchy, roles, and functions of population centers in both urban and rural areas.","local_implementings":[{"local_implementings/local_implementing":"Municipalidades provinciales del Perú","local_implementings/id_local_implementing":"45540","local_implementings/name_local_implementing":"Municipalidades provinciales del Perú"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:a0dc35ab-9b39-40e5-b4f4-ddc8c5349cae","meta/deprecatedID":"uuid:fef30e12-ec5a-470b-9b6d-36c28c3941ac","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a0dc35ab-9b39-40e5-b4f4-ddc8c5349cae","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a0dc35ab-9b39-40e5-b4f4-ddc8c5349cae"},{"_id":46362,"start":"2025-11-07T14:24:24.958-04:00","end":"2026-04-10T12:12:31.891-04:00","id_drupal":"848","country":"ury","theme":"urban_development","original_language":"es","name_es":"Programas de Actuación Integrada de Uruguay","name_en":"Integrated Action Programs of Uruguay","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Ordenamiento Territorial"}],"link":"a1a267ca-911c-4e84-99ed-7c8de55c900a","primary_link":"https://www.gub.uy/ministerio-vivienda-ordenamiento-territorial/sites/ministerio-vivienda-ordenamiento-territorial/files/2023-12/Programas%20de%20Actuaci%C3%B3n%20Integrada.pdf","instrument_type":"program","territorial_scale":"subnational","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los Programas de Actuación Integrada (PAI) constituyen el instrumento para la transformación de sectores de suelo categoría urbana, suelo categoría suburbana y con el atributo de potencialmente transformable.\n\nEstos Programas plantean los lineamientos para la ordenación y programación del desarrollo urbano. Establecen definiciones normativas sobre la subdivisión, los usos del suelo y  la edificación. Adicionalmente, incluyen definiciones y compromisos de actuación para el proceso de urbanización.\n\nEl PAI también debe realizar una evaluación de los impactos territoriales y ambientales que conlleva el desarrollo urbanístico propuesto, así como la adopción de medidas de prevención y mitigación.","description_en":"Integrated Action Programs (PAI) are instruments for the transformation of areas classified as urban land, suburban land, or land identified as potentially developable.\n\nThese programs set out the guidelines for the planning and scheduling of urban development. They establish regulatory definitions regarding subdivision, land use, and building. Additionally, they include definitions and commitments for action in the urbanization process.\n\nThe PAI must also include an assessment of the territorial and environmental impacts associated with the proposed urban development, as well as the adoption of prevention and mitigation measures.","local_implementings":[{"local_implementings/local_implementing":"Intendencias municipales de Uruguay","local_implementings/id_local_implementing":"44934","local_implementings/name_local_implementing":"Intendencias municipales de Uruguay"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:dcb82264-7427-4e15-9a26-0497a6b29d2b","meta/deprecatedID":"uuid:a7ccab9c-7287-44f7-b936-38237607c334","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dcb82264-7427-4e15-9a26-0497a6b29d2b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:24","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dcb82264-7427-4e15-9a26-0497a6b29d2b"},{"_id":46363,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:25.672","end":"2025-11-07T14:24:25.672","id_drupal":"849","country":"ury","theme":"urban_development","original_language":"es","name_es":"Planes Locales de Uruguay","name_en":"Local Plans of Uruguay ","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente (MVOTMA) de Uruguay","responsible_institution/id_institution":"45095","responsible_institution/name_institution":"Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente (MVOTMA) de Uruguay"}],"primary_link":"https://sit.mvot.gub.uy/inot/planificacion/departamental","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos","type_territorial_unit_en":"Departments","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los planes locales definen criterios para el ordenamiento territorial de una porción del territorio dentro de un departamento. Estos instrumentos normativizan los usos del suelo, la localización de las diferentes actividades socioeconómicas, servicios, infraestructura y viviendas.","description_en":"Local Plans define criteria for the territorial organization of a portion of land within a department. These instruments regulate land uses and the location of different socioeconomic activities, services, infrastructure, and housing.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Departamentales de Uruguay","local_implementings/id_local_implementing":"45514","local_implementings/name_local_implementing":"Gobiernos Departamentales de Uruguay"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:044a6704-d0f9-45d0-b559-d651d876da07","meta/deprecatedID":"uuid:0100d655-fd66-4a45-8129-0c05c85d2a46","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"044a6704-d0f9-45d0-b559-d651d876da07","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:24","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:044a6704-d0f9-45d0-b559-d651d876da07"},{"_id":46364,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:26.390","end":"2025-11-07T14:24:26.390","id_drupal":"850","country":"ury","theme":"urban_development","original_language":"es","name_es":"Planes sectoriales de Uruguay","name_en":"Sectoral Plans of Uruguay","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente (MVOTMA) de Uruguay","responsible_institution/id_institution":"45095","responsible_institution/name_institution":"Ministerio de Vivienda, Ordenamiento Territorial y Medio Ambiente (MVOTMA) de Uruguay"}],"primary_link":"https://sit.mvot.gub.uy/inot/planificacion/departamental","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos","type_territorial_unit_en":"Departments","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los Planes Sectoriales constituyen instrumentos para la regulación detallada de temas específicos en el marco del Plan Local o de otro instrumento, y en particular para el ordenamiento de los aspectos territoriales de las políticas y proyectos sectoriales con impacto estructurante.","description_en":"Sectoral Plans are instruments for the detailed regulation of specific issues within the framework of the Local Plan or another planning instrument, particularly for the organization of the territorial aspects of sectoral policies and projects with a structural impact.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Departamentales de Uruguay","local_implementings/id_local_implementing":"45514","local_implementings/name_local_implementing":"Gobiernos Departamentales de Uruguay"}],"__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:fe254109-425d-4613-9da9-cd672b4c245f","meta/deprecatedID":"uuid:288fb2b9-d30a-454d-8620-d5656db65c9f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"fe254109-425d-4613-9da9-cd672b4c245f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:25","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:fe254109-425d-4613-9da9-cd672b4c245f"},{"_id":46365,"start":"2025-11-07T14:24:27.112-03:00","end":"2026-04-06T12:42:22.908-04:00","id_drupal":"100111","country":"ury","theme":"territorial_planning","original_language":"es","name_es":"Planes Locales de Ordenamiento Territorial y Desarrollo Sostenible","name_en":"Local Plans for Territorial Planning and Sustainable Development","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Ordenamiento Territorial","responsible_institution/id_institution":"45172","responsible_institution/name_institution":"Ministerio de Vivienda y Ordenamiento Territorial"}],"primary_link":"https://www.impo.com.uy/bases/leyes/18308-2008","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos","type_territorial_unit_en":"Departments","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"no","description_es":"Los Planes Locales de Ordenamiento Territorial y Desarrollo Sostenible son instrumentos de planificación territorial establecidos por la Ley de Ordenamiento Territorial y Desarrollo Sostenible (Ley N.º 18.308) de Uruguay. Se aplican a ámbitos territoriales específicos dentro de los departamentos, como ciudades, centros poblados o áreas rurales, y tienen como objetivo orientar el uso del suelo, la organización del territorio y el desarrollo urbano o rural a escala local. Estos planes definen criterios para el desarrollo de asentamientos, la localización de actividades, la protección ambiental y la gestión sostenible del territorio.","description_en":"Local Land Use and Sustainable Development Plans are land-use planning instruments established by Uruguay’s Land Use and Sustainable Development Act (Law No. 18,308). They apply to specific territorial areas within departments, such as cities, towns, or rural areas, and aim to guide land use, territorial organization, and urban or rural development at the local level. These plans define criteria for settlement development, the location of activities, environmental protection, and sustainable land management.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Departamentales de Uruguay","local_implementings/id_local_implementing":"45514","local_implementings/name_local_implementing":"Gobiernos Departamentales de Uruguay"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:06d8cb63-5540-41f7-ba95-fbd8321c5389","meta/deprecatedID":"uuid:53d60a3b-54da-41d7-828d-3edefea7ca34","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"06d8cb63-5540-41f7-ba95-fbd8321c5389","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:06d8cb63-5540-41f7-ba95-fbd8321c5389"},{"_id":46366,"start":"2025-11-07T14:24:27.820-03:00","end":"2026-04-06T13:00:43.117-04:00","id_drupal":"100112","country":"ury","theme":"territorial_planning","original_language":"es","name_es":"Planes Interdepartamentales de Ordenamiento Territorial y Desarrollo Sostenible","name_en":"Interdepartmental Plans for Territorial Planning and Sustainable Development","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Ordenamiento Territorial","responsible_institution/id_institution":"45172","responsible_institution/name_institution":"Ministerio de Vivienda y Ordenamiento Territorial"}],"primary_link":"https://www.impo.com.uy/bases/leyes/18308-2008","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_en":"Shared regions","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"no","description_es":"Los Planes Interdepartamentales de Ordenamiento Territorial y Desarrollo Sostenible son instrumentos de planificación territorial previstos en la Ley de Ordenamiento Territorial y Desarrollo Sostenible (Ley N.º 18.308) de Uruguay. Su objetivo es orientar la organización, uso y gestión del territorio en áreas que comprenden más de un departamento, abordando problemáticas y dinámicas territoriales de escala regional. Estos planes establecen lineamientos para el uso del suelo, la localización de actividades, la protección de recursos naturales y la coordinación de políticas e inversiones públicas entre los gobiernos departamentales involucrados.","description_en":"Interdepartmental Land Use Planning and Sustainable Development Plans are territorial planning instruments established under Uruguay’s Land Use Planning and Sustainable Development Act (Law No. 18,308). Their purpose is to guide the organization, use, and management of land in areas spanning more than one department, addressing territorial issues and dynamics at the regional level. These plans establish guidelines for land use, the location of activities, the protection of natural resources, and the coordination of public policies and investments among the participating departmental governments.","local_implementings":[{"local_implementings/local_implementing":"Gobiernos Departamentales de Uruguay","local_implementings/id_local_implementing":"45514","local_implementings/name_local_implementing":"Gobiernos Departamentales de Uruguay"},{"local_implementings/local_implementing":"Ministerio de Vivienda y Ordenamiento Territorial","local_implementings/id_local_implementing":"45172","local_implementings/name_local_implementing":"Ministerio de Vivienda y Ordenamiento Territorial"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:0d53aff6-df7e-4e37-9440-c14489d2544d","meta/deprecatedID":"uuid:29d997d5-8657-453e-a674-34c6a72ee505","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0d53aff6-df7e-4e37-9440-c14489d2544d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0d53aff6-df7e-4e37-9440-c14489d2544d"},{"_id":46367,"start":"2025-11-07T14:24:28.547-04:00","end":"2026-04-06T12:51:12.125-04:00","id_drupal":"20005","country":"col","theme":"territorial_planning","original_language":"es","name_es":"Planes Departamentales de Ordenamiento Territorial (POD)","name_en":"Departmental Land Use Plans (POD)","responsible_institution":[{"responsible_institution/institution":"Departamento Nacional de Planeación (DNP) de Colombia","responsible_institution/id_institution":"44978","responsible_institution/name_institution":"Departamento Nacional de Planeación (DNP) de Colombia"}],"link":"0d6017c6-0576-423c-8ce5-75324faf7eaf","primary_link":"https://portalterritorial.dnp.gov.co/KitOT/Content/uploads/C%20POD.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos","type_territorial_unit_en":"Departments","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Falta descripción","description_en":"Falta descripción","local_implementings":[{"local_implementings/local_implementing":"Gobernaciones Departamentales de Colombia","local_implementings/id_local_implementing":"44998","local_implementings/name_local_implementing":"Gobernaciones Departamentales de Colombia"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:21a433d8-33df-47d8-b5a0-daf2afff4cf5","meta/deprecatedID":"uuid:04ad6af1-ce99-4b59-86fe-20fa879f838b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"21a433d8-33df-47d8-b5a0-daf2afff4cf5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:27","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:21a433d8-33df-47d8-b5a0-daf2afff4cf5"},{"_id":46368,"start":"2025-11-07T14:24:29.262-04:00","end":"2026-04-06T12:14:23.499-04:00","id_drupal":"804","country":"pan","theme":"territorial_planning","original_language":"es","name_es":"Planes Parciales de Ordenamiento Territorial de Panamá","name_en":"Territorial Planning Partial Plans of Panama","responsible_institution":[{"responsible_institution/institution":"Dirección de Ordenamiento Territorial","responsible_institution/id_institution":"45266","responsible_institution/name_institution":"Dirección de Ordenamiento Territorial"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Distritos y Corregimientos","type_territorial_unit_en":"Districts and Townships","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Según la Ley 6 de 2006, el Plan parcial es el instrumento de planificación detallado, cuyo objetivo principal es el ordenamiento, la creación, la defensa o el mejoramiento de algún sector particular de la ciudad; en especial las áreas de conservación histórica, monumental, arquitectónica o ambiental, las zonas de intereses turísticos o paisajístico, los asentamientos informales, las áreas de urbanización progresiva o cualquiera otra área cuyas condiciones específicas ameriten un tratamiento separado dentro del plan de ordenamiento territorial para el desarrollo urbano local.","description_en":"According to Law 6 of 2006, the Partial Plan is a detailed planning instrument whose main objective is the planning, creation, protection, or improvement of a particular sector of the city—especially historic, monumental, architectural, or environmental conservation areas; areas of tourist or scenic interest; informal settlements; progressive urbanization areas; or any other area whose specific conditions require a separate treatment within the territorial planning framework for local urban development.","local_implementings":[{"local_implementings/local_implementing":"Distritos y Corregimientos de Panamá","local_implementings/id_local_implementing":"45422","local_implementings/name_local_implementing":"Distritos y Corregimientos de Panamá"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:199ea725-2d88-4968-907c-67fc54e0fad1","meta/deprecatedID":"uuid:c2351427-17cf-4862-9b10-55f5b79a6552","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"199ea725-2d88-4968-907c-67fc54e0fad1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:28","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:199ea725-2d88-4968-907c-67fc54e0fad1"},{"_id":46369,"start":"2025-11-07T14:24:29.986-03:00","end":"2026-04-06T12:49:34.780-04:00","id_drupal":"20007","country":"dom","theme":"territorial_planning","original_language":"es","name_es":"Planes Municipales de Ordenamiento Territorial de República Dominicana","name_en":"Municipal Land Use Plans","responsible_institution":[{"responsible_institution/institution":"Viceministerio de Ordenamiento Territorial y Desarrollo Regional","responsible_institution/id_institution":"45013","responsible_institution/name_institution":"Viceministerio de Ordenamiento Territorial y Desarrollo Regional"}],"link":"d022c06d-d407-4a13-bb4f-3204137dc9a9","primary_link":"https://mepyd.gob.do/publicaciones/guia-metodologica-para-la-formulacion-del-plan-municipal-de-ordenamiento-territorial/","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Municipios","type_territorial_unit_en":"Municipalities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Los Planes Municipales de Ordenamiento Territorial (PMOT) de República Dominicana son instrumentos técnicos-normativos obligatorios, impulsados por la Ley No. 368-22, que regulan el uso del suelo y el desarrollo físico local. Coordinados por el Ministerio de Economía, Planificación y Desarrollo (MEPyD) y los gobiernos locales, buscan el uso sostenible de recursos, gestión de riesgos y ordenamiento urbano, apoyados por una Guía Metodológica específica.","description_en":"The Municipal Land Use Plans (PMOT) of the Dominican Republic are mandatory technical and regulatory instruments, established under Law No. 368-22, that regulate land use and local physical development. Coordinated by the Ministry of Economy, Planning, and Development (MEPyD) and local governments, they aim to promote sustainable resource use, risk management, and urban planning, supported by a specific Methodological Guide.","local_implementings":[{"local_implementings/local_implementing":"Ayuntamientos de República Dominicana","local_implementings/id_local_implementing":"45030","local_implementings/name_local_implementing":"Ayuntamientos de República Dominicana"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:b4642e62-6897-4610-b340-fc0bc4e7aa2a","meta/deprecatedID":"uuid:eef3d3e2-4354-423c-a994-ea5813e80809","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b4642e62-6897-4610-b340-fc0bc4e7aa2a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b4642e62-6897-4610-b340-fc0bc4e7aa2a"},{"_id":46370,"start":"2025-11-07T14:24:30.699-04:00","end":"2026-04-06T12:05:43.535-04:00","id_drupal":"20014","country":"ven","theme":"territorial_planning","original_language":"es","name_es":"Planes Regionales de Ordenación del Territorio de Venezuela","name_en":"Regional Land Use Plans of Venezuela","responsible_institution":[{"responsible_institution/institution":"Comisiones Regionales de Ordenación del Territorio de Venezuela","responsible_institution/id_institution":"45423","responsible_institution/name_institution":"Comisiones Regionales de Ordenación del Territorio de Venezuela"}],"link":"e21aadfb-0ef6-4a58-863b-be8f0ef30ea8","primary_link":"http://www.ucv.ve/fileadmin/user_upload/cenamb/ley_organica_para_la_ordenacion_del_territorio.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Regiones de Planificación","type_territorial_unit_en":"Planning Regions","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Falta descripción","description_en":"Falta descripción","local_implementings":[{"local_implementings/local_implementing":"Comisiones Regionales de Ordenación del Territorio de Venezuela","local_implementings/id_local_implementing":"45423","local_implementings/name_local_implementing":"Comisiones Regionales de Ordenación del Territorio de Venezuela"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:7e68fbc1-8df6-43d3-853e-d60a42425598","meta/deprecatedID":"uuid:114fa152-2d81-48b8-9b71-a7639a019550","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7e68fbc1-8df6-43d3-853e-d60a42425598","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7e68fbc1-8df6-43d3-853e-d60a42425598"},{"_id":46371,"start":"2025-11-07T14:24:31.414-03:00","end":"2026-04-08T09:08:43.018-04:00","id_drupal":"686","country":"arg","theme":"urban_development","original_language":"es","name_es":"Plan Urbano Ambiental de Buenos Aires (Argentina)","name_en":"Environmental Urban Plan of Buenos Aires (Argentina)","responsible_institution":[{"responsible_institution/institution":"Consejo del Plan Urbano Ambiental de Buenos Aires, Argentina","responsible_institution/id_institution":"45496","responsible_institution/name_institution":"Consejo del Plan Urbano Ambiental de Buenos Aires, Argentina"}],"link":"a525b3a0-1992-4f31-be01-9c33b821fc5f","primary_link":"https://buenosaires.gob.ar/sites/default/files/media/document/2020/09/18/1f10c9c1d6860d6d017a4ff4272071ec0520cfac.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad Autónoma de Buenos Aires","validity_applies_from":"yes","effective_since":"2008-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El objetivo central del Plan Urbano Ambiental *(que se desprende de la Ley 71)* es servir de instrumento técnico-político de gobierno para la identificación e implementación de las principales estrategias de ordenamiento y mejoramiento territorial y ambiental de Buenos Aires.\n\nEste contiene *vías de acción con los siguientes objetivos*:\n\na. Mejorar la calidad de vida de la población.\nb. Promover un desarrollo más equilibrado y equitativo de la ciudad.\nc. Generar oportunidades de consenso y compromiso institucionalizando mecanismos de concertación de políticas urbanas con los distintos sectores de la sociedad.\nd. Promover y hacer más eficientes, en términos sociales, ambientales, urbanísticos y económicos, las inversiones tanto del estado como del sector privado.\ne. Instrumentar una eficiente coordinación entre las áreas gubernamentales de la ciudad y el resto de las jurisdicciones de la región metropolitana, tendiente a una gestión de carácter integral.\nf. Tender a que todos los habitantes de la ciudad tengan acceso a disponer de aire, agua y alimentos, química y bacteriológicamente seguros, a circular y habitar en áreas libres de residuos, de contaminación visual y sonora y ambientalmente sanas, al uso y goce de espacios verdes y abiertos.\ng. Preservar el patrimonio cultural, arquitectónico y ambiental.","description_en":"The central objective of the Urban Environmental Plan *(established under Law No. 71)* is to serve as a technical–political instrument of government for the identification and implementation of the main strategies for territorial and environmental planning and improvement in Buenos Aires.\n\nIt includes *courses of action with the following objectives*:\n\na. To improve the population’s quality of life.\nb. To promote more balanced and equitable development of the city.\nc. To create opportunities for consensus and commitment by institutionalizing mechanisms for the coordination of urban policies with different sectors of society.\nd. To promote and enhance the efficiency— in social, environmental, urban, and economic terms—of investments by both the State and the private sector.\ne. To establish effective coordination among the city’s governmental areas and with the other jurisdictions of the metropolitan region, aimed at integrated management.\nf. To ensure that all city residents have access to chemically and bacteriologically safe air, water, and food; the ability to move through and live in areas free of waste, visual and noise pollution, and that are environmentally healthy; and the use and enjoyment of green and open spaces.\ng. To preserve cultural, architectural, and environmental heritage.","linking_sdg_plans":"yes","sdg":"sdg_11 sdg_13","link_block":[{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"LEY 71 1998","link_block/external_link_text_en":"LAW 71 1998","link_block/external_link_text_url":"https://boletinoficial.buenosaires.gob.ar/normativaba/norma/441"},{"link_block/link_type":"external","link_block/external_link_type":"platform","link_block/external_link_text_es":"Ciudad de Buenos Aires","link_block/external_link_text_en":"City of Buenos Aires","link_block/external_link_text_url":"https://buenosaires.gob.ar/inicio/"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:ada4fda5-3a6a-41c6-afd4-c7c423f54c1e","meta/deprecatedID":"uuid:46163dc0-4b9f-4f34-a62f-83c8f0b4438c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ada4fda5-3a6a-41c6-afd4-c7c423f54c1e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:30","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ada4fda5-3a6a-41c6-afd4-c7c423f54c1e"},{"_id":46372,"start":"2025-11-07T14:24:32.129-03:00","end":"2026-01-09T09:00:36.900-03:00","id_drupal":"1711","country":"slv","theme":"mobility","original_language":"es","name_es":"Política Metropolitana de Movilidad Urbana 2020. Área metropolitana de San Salvador","name_en":"Metropolitan Urban Mobility Policy 2020. Metropolitan Area of San Salvador","responsible_institution":[{"responsible_institution/institution":"Oficina de Planificación del Área Metropolitana de San Salvador (OPAMSS)","responsible_institution/id_institution":"45536","responsible_institution/name_institution":"Oficina de Planificación del Área Metropolitana de San Salvador (OPAMSS)"}],"instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Área Metropolitana de San Salvador (AMSS)/ Gran San Salvador","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","description_es":"El objetivo del plan se articula en dos bloques: \n• Un Modelo de Metrópolis que apuesta por una metrópolis compacta, policéntrica y de proximidad entre distintos usos del suelo y,\n• Un segundo bloque relacionado con el Modelo de Movilidad que considera aspectos relacionados con la infraestructura donde se realizan los desplazamientos y la gestión en la planificación de la movilidad relacionados con la gestión de datos y la participación ciudadana.","description_en":"The plan's objective is structured in two blocks:\n• A Metropolis Model, promoting a compact, polycentric metropolis with proximity between different land uses.\n• A Mobility Model, addressing infrastructure and mobility planning management, data management, and citizen participation.","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Se definen elementos para la defensa y promoción del cumplimiento de la normativa de accesibilidad en la flota de transporte público, junto con promover la implementación de medidas para facilitar el acceso de personas con discapacidad al entorno de paradas de transporte público.Promover espacios de concientización para el respeto del espacio para peatones e implementación de facilidades arquitectónicas para mantener una red peatonal accesible y libre de obstáculos, la implementación de medidas para facilitar el acceso de personas con discapacidad al entorno de paradas de transporte público. El acompañamiento en los esfuerzos institucionales del Gobierno Central para concretar un sistema de transporte masivo a nivel metropolitano; la modernización del sistema de transporte colectivo en aras de mejorar la calidad del servicio que reciben las personas que lo utilizan; La promoción de la mejora de la articulación entre el transporte interdepartamental, urbano y el metropolitano desde los esfuerzos de planificacion y control del desarrollo urbano.","pmu/pmu_prioritization_en":"Elements are defined for the defence and promotion of compliance with accessibility regulations in the public transport fleet, along with promoting the implementation of measures to facilitate access by people with disabilities to the surroundings of public transport stops. Promote awareness spaces for the respect of pedestrian space and implementation of architectural facilities to maintain an accessible pedestrian network free of obstacles, the implementation of measures to facilitate the access of people with disabilities to the surroundings of public transport stops. The accompaniment in the institutional efforts of the Central Government to realize a mass transportation system at the metropolitan level; the modernization of the collective transport system in order to improve the quality of service received by the people who use it; The promotion of the improvement of the articulation between interdepartmental, urban and metropolitan transport from the efforts of planning and control of urban development.","pmu/pmu_gender_es":"Se proponen medidas concretas para la institucionalización de una perspectiva de género (cambio en el marco institucional y legal). Se propone la necesidad de institucionalización aunque sin medidas concretas. Se define la Igualdad y no discriminación como principio rector (26) junto con la incorporación del enfoque de género e interseccionalidad en los planes, estrategias y proyectos de movilidad.(34) Al igual que la Identificación y promoción de estrategias y herramientas para incorporar más mujeres en el sistema de planificación y gestión de la movilidad y en los equipos de transporte público. Igualmente se incluye el Incremento de la seguridad de las mujeres y diversos sectores de la sociedad en la movilidad urbana desde la sensibilización, facilidades arquitectónicas, sistemas de denuncia efectivos. (34)\"","pmu/pmu_gender_en":"Concrete measures are proposed for the institutionalization of a gender perspective (change in the institutional and legal framework). The need for institutionalization is proposed, although without concrete measures. Equality and non-discrimination is defined as a guiding principle (26) along with the incorporation of the gender and intersectionality approach in mobility plans, strategies and projects. (34) As well as the identification and promotion of strategies and tools to incorporate more women into the mobility planning and management system and public transport teams. It also includes the increase in the safety of women and various sectors of society in urban mobility from awareness, architectural facilities, effective reporting systems. (34)\"","meta/instanceID":"uuid:2ef6d0bc-f375-4c87-adbd-e8c140ea99e8","meta/deprecatedID":"uuid:d5b839ac-8a11-492c-afd8-79367d5cdca7","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2ef6d0bc-f375-4c87-adbd-e8c140ea99e8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2ef6d0bc-f375-4c87-adbd-e8c140ea99e8"},{"_id":46373,"start":"2025-11-07T14:24:32.845-04:00","end":"2026-04-06T12:54:51.423-04:00","id_drupal":"802","country":"pan","theme":"territorial_planning","original_language":"es","name_es":"Política Nacional de Ordenamiento Territorial de Panamá","name_en":"National Territorial Planning Policy of Panama","responsible_institution":[{"responsible_institution/institution":"Dirección de Ordenamiento Territorial","responsible_institution/id_institution":"45266","responsible_institution/name_institution":"Dirección de Ordenamiento Territorial"}],"link":"5c878fd5-e214-45e6-86b4-6de0420a7de2","primary_link":"https://www.miviot.gob.pa/wp-content/uploads-new/miviot/miviotplanesot/plannacional/PlanNacionaldeOrdenamientoTerritorialPanama-PNOT-MIVIOT.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2006-01-01","effective_today":"no","temporality":"long_term","description_es":"El objetivo del Plan Nacional de Ordenamiento Territorial, es promover estrategias territoriales de uso, ocupación y manejo del suelo, en función de los objetivos económicos, sociales, urbanísticos y ambientales de la nación panameña, considerando:\n\n(a) la ejecución de actuaciones urbanas integrales y articulada;\n\n(b) regulación de las dinámicas de transformación territorial, a fin de optimizar la utilización de los recursos naturales y humanos para el logro de condiciones de vida digna para la población actual y las generaciones futuras. \n\nDe acuerdo con la Ley 06 de 2006, el Plan Nacional es el instrumento de planificación que determina las grandes directrices de ordenamiento territorial, en coordinación con la planificación económica y social para mayor bienestar de la población (Artículo 5).","description_en":"The objective of the National Land Use Plan is to promote territorial strategies for the use, occupation, and management of land, in line with Panama’s economic, social, urban, and environmental goals, by considering:\n(a) the implementation of comprehensive and coordinated urban actions;\n(b) the regulation of territorial transformation dynamics to optimize the use of natural and human resources, in order to achieve decent living conditions for current and future generations.\nAccording to Law 06 of 2006, the National Plan is the planning instrument that sets out the main land use planning guidelines in coordination with economic and social planning to enhance population well-being (Article 5).","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:4ba01881-d413-445d-a326-e8d6d2e9f147","meta/deprecatedID":"uuid:6ddac2ba-98af-48af-8f78-e2096cf2f8ae","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4ba01881-d413-445d-a326-e8d6d2e9f147","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4ba01881-d413-445d-a326-e8d6d2e9f147"},{"_id":46374,"start":"2025-11-07T14:24:33.570-03:00","end":"2026-01-09T09:01:09.421-03:00","id_drupal":"1706","country":"mex","theme":"mobility","original_language":"es","name_es":"Programa Integral de Movilidad Urbana Sustentable de la Zona Metropolitana de Monterrey","name_en":"Comprehensive Sustainable Urban Mobility Program for the Monterrey Metropolitan Area","responsible_institution":[{"responsible_institution/institution":"Secretaría de Desarrollo Sustentable (Movilidad y Planeación urbana)","responsible_institution/id_institution":"45128","responsible_institution/name_institution":"Secretaría de Desarrollo Sustentable (Movilidad y Planeación urbana)"}],"instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Zona Metropolitana de Monterrey","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"El objetivo general del PIMUS es contar con un instrumento de planeación, que vincule el desarrollo urbano con la movilidad, defina de manera precisa las acciones y  proyectos de manera priorizada y eslabonada para ser implementados en una secuencia de corto y mediano plazo, pero con una visión sustentable de largo plazo. El programa establecerá la ruta de cambio que promueva y privilegie la movilidad eficiente y sustentable, integrando en el análisis los aspectos urbanos, económicos, ambientales y de infraestructura, así como de la oferta, integralidad y calidad de los modos de transporte, buscando en el proceso generar mayor equidad, un desarrollo urbano más igualitario y potenciar la productividad de la zona metropolitana”. Tal objetivo está alineado a los Objetivos de Desarrollo Sostenible (ODS), establecidos en la Agenda 2030 del Programa de las Naciones Unidas para el Desarrollo.","description_en":"The overall objective of the PIMUS is to establish a planning instrument that links urban development with mobility, precisely defining prioritized and sequenced actions and projects for short- and medium-term implementation with a long-term sustainable vision. The program will define a change roadmap prioritizing efficient and sustainable mobility, integrating urban, economic, environmental, and infrastructure aspects, as well as the supply, integration, and quality of transport modes. It seeks greater equity, more equal urban development, and increased productivity in the metropolitan area. This goal aligns with the Sustainable Development Goals (SDGs) of the UN’s 2030 Agenda.","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Considera como lineamientos prioritarios el reordenamiento de transporte público, Plan maestro del SITME y Terminales de pasajeros y centros de transferencia","pmu/pmu_prioritization_en":"It considers as priority guidelines the reorganization of public transport, SITME Master Plan and passenger terminals and transfer centers","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género y no se menciona la institucionalización de una perspectiva de género","pmu/pmu_gender_en":"No project includes a gender perspective and there is no mention of the institutionalization of a gender perspective","meta/instanceID":"uuid:64436080-1b30-468f-81f4-59009a4f0232","meta/deprecatedID":"uuid:82eed97b-18d0-472d-8d1e-667c135af074","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"64436080-1b30-468f-81f4-59009a4f0232","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:32","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:64436080-1b30-468f-81f4-59009a4f0232"},{"_id":46375,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:34.294","end":"2025-11-07T14:24:34.294","id_drupal":"1748","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad Urbana Sustentable de los Mochis","name_en":"Comprehensive Sustainable Urban Mobility Plan for Los Mochis","responsible_institution":[{"responsible_institution/institution":"Instituto Municipal de Planeación de Ahome","responsible_institution/id_institution":"45235","responsible_institution/name_institution":"Instituto Municipal de Planeación de Ahome"}],"link":"be950fdb-85c4-4d1b-8472-5caab7a3ef27","primary_link":"https://implanahome.gob.mx/Sistema_de_Planeaci%C3%B3n/Plan_Integral_de_Movilidad_Urbana_Sustentable/Versi%C3%B3n_completa/PIMUS.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Los Mochis","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","description_es":"El objetivo principal es lograr una mejora en la calidad de movilidad urbana mediante estrategias que la hagan más eficaz y eficiente. Y como objetivo secundario se plantea proponer las actuaciones precisas para el desarrollo y ejecución del Plan Integral de Movilidad Urbana Sustentable para la ciudad de los Mochis, en sus diferentes fases.","description_en":"The main goal is to improve urban mobility quality through more effective and efficient strategies. A secondary goal is to propose specific actions for developing and executing the Sustainable Urban Mobility Master Plan for Los Mochis in its various phases.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Crear una nueva red de Transporte Público de tránsito rápido (BRT). Formular el Plan Maestro del Transporte Público que funcione en torno a las rutas de BRT para generar desplazamientos combinados entre el BRT y el autobús. La red del BRT va a disminuir los tiempos de desplazamiento, integrando las redes, la seguridad, la continuidad, la cobertura, la conectividad, la eficiencia y la eficacia. La red BRT va a inlcuir cuatro ejes viales. Dentro del Plan Maestro del Transporte Público deben incluirse paradas que coincidan con las nuevas estaciones de la red BRT junto con estaciones multimodales. Se propone integración tarifaria para incentivar el uso del transporte público y una simplificación de las tarifas.","pmu/pmu_prioritization_en":"Create a new Public Rapid Transit (BRT) network. Formulate the Public Transport Master Plan that works around BRT routes to generate combined journeys between BRT and bus. The BRT network will reduce travel times, integrating networks, security, continuity, coverage, connectivity, efficiency and effectiveness. The BRT network will include four road axes. Within the Public Transport Master Plan, stops that coincide with the new stations of the BRT network must be included along with multimodal stations. Fare integration is proposed to encourage the use of public transport and a simplification of fares.","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","pmu/pmu_budget":"139395410","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:c7031433-a7fc-46c0-b2fb-fb05da729387","meta/deprecatedID":"uuid:8ef04abe-136c-4e4f-be6f-34e4bf8aac70","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c7031433-a7fc-46c0-b2fb-fb05da729387","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:33","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c7031433-a7fc-46c0-b2fb-fb05da729387"},{"_id":46376,"start":"2025-11-07T14:24:35.029-03:00","end":"2025-12-30T12:03:28.880-03:00","id_drupal":"1800","country":"ecu","theme":"public_investment","original_language":"es","name_es":"Plan Anual de Inversión 2023","name_en":"Annual Investment Plan 2023","responsible_institution":[{"responsible_institution/institution":"Dirección de Planificación de la Inversión, Dirección de Seguimiento a la Inversión","responsible_institution/id_institution":"45212","responsible_institution/name_institution":"Dirección de Planificación de la Inversión, Dirección de Seguimiento a la Inversión"}],"link":"8ed44e6a-54e3-48de-95e6-4657fb6826bb","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El país estableció una proforma del Plan Anual de Inversión 2023 que contine el listado de estudios, programas y/o proyectos que de conformidad con las competencias establecidas a la Secretería Nacional de Planificación y en coordinación con el Ministerio de Economía y Finanzas son considerados para los gastos no permanentes (inversión) por institución. Además establece los montos asignados para los años siguientes en el marco del Plan Plurianual de Inversiones hasta 2026.","description_en":"The country established a pro forma of the 2023 Annual Investment Plan, which includes a list of studies, programs, and/or projects that, in accordance with the responsibilities assigned to the National Secretariat for Planning and in coordination with the Ministry of Economy and Finance, are considered non-permanent expenditures (investments) by institution. It also establishes the allocated amounts for subsequent years within the framework of the Multiannual Investment Plan through 2026.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El Plan de Inversiones incorpora listados de los proyectos por institución responsable","pip/pip_project_list_en":"The Investment Plan includes lists of projects by responsible institution.","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_costing_es":"El Plan de Inversiones contiene el presupuesto asignado a los proyectos.","pip/pip_costing_en":"The Investment Plan contains the budget allocated to the projects.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con presupuesto asignado.","pip/pip_budget_en":"The investment projects included in the plan have an allocated budget.","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de Ecuador","link_block/snip_id":"46754","link_block/snip_name":"Sistema Nacional de Inversión Pública de Ecuador"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:39d0a765-9b8b-4889-a7e1-bf66305b645f","meta/deprecatedID":"uuid:f2483a0a-1af6-4cb6-8da1-8ec1d3ccb87b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"39d0a765-9b8b-4889-a7e1-bf66305b645f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:39d0a765-9b8b-4889-a7e1-bf66305b645f"},{"_id":46377,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:35.758","end":"2025-11-07T14:24:35.758","id_drupal":"1739","country":"arg","theme":"mobility","original_language":"es","name_es":"Plan Integral de Movilidad Rosario","name_en":"Rosario Comprehensive Mobility Plan","responsible_institution":[{"responsible_institution/institution":"Ente del Transporte de Rosario","responsible_institution/id_institution":"44955","responsible_institution/name_institution":"Ente del Transporte de Rosario"}],"link":"a7f6628c-e78a-4f59-a85b-99c51f95dfcf","primary_link":"https://www.rosario.gob.ar/ArchivosWeb/plan_integral_movilidad.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Rosario","validity_applies_from":"yes","effective_since":"2011-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"long_term","description_es":"El PIM entiende a los sistemas de movilidad como un medio para generar equidad social y define políticas de movilidad que permitan construir una ciudad más solidaria, con mejor accesibilidad para las personas de recursos limitados, mejor conexión, mejores servicios de transporte urbano público de pasajeros, con un transporte intermodal de cargas y una mejor calidad de vida para la sociedad en general, siendo el objetivo máximo el de constituir a Rosario como bastión de la sustentabilidad ambiental y social.","description_en":"The PIM understands mobility systems as a means to generate social equity and defines mobility policies that help build a more supportive city, with better accessibility for people with limited resources, improved connectivity, better public urban passenger transport services, intermodal freight transport, and an overall better quality of life for society. The ultimate goal is to establish Rosario as a bastion of environmental and social sustainability.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"vision","pmu/pmu_implementation_es":"Se considera que el transporte público colectivo presta servicios con unidades eléctricas 3% (1 línea) y el análisis de los beneficios del tren-trams por Menor emisión de CO2 a la atmósfera y Ahorro energético. La operación mediante energía eléctrica (recurso renovable) suplanta el uso de combustibles derivados de fósiles no renovables. (170) Define la promoción de mejoras en el sistema de transporte público masivo (trenes, tranvías, trolebuses, BRT) mediante el uso de sistemas energéticos eficientes (eléctricos, combustibles limpios). (309) Como propuesta general.","pmu/pmu_implementation_en":"It is considered that collective public transport provides services with electric units 3% (1 line) and the analysis of the benefits of the train-trams by Lower emission of CO2 into the atmosphere and Energy savings. Operation using electricity (a renewable resource) replaces the use of non-renewable fossil fuels. (170) It defines the promotion of improvements in the mass public transport system (trains, trams, trolleybuses, BRT) through the use of efficient energy systems (electric, clean fuels). (309) As a general proposal.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Para el mediano y largo plazo, se prevé la implementación de una red metropolitana de transporte sobre rieles, recuperando las infraestructuras ferroviarias existentes donde resulte conveniente.(169) mediante la implementación de tren-trams. Se asignan corredores por los que operaria (171)\". Desarrollo del \"Sistema Integrado de Transporte público de Pasajeros\" que considera redes integradas conformadas por los distintos modos de transporte: ferroviario, tren-trams, tranviario y vial Se considera favorecer a la bicicleta como medio de transporte, a través de la promoción de su uso, el mantenimiento, ampliación y renovación de las infraestructuras.(239) mediante el \"Plan de Ciclovías\"\" , extender la red actual de 35km a 150km . Se designa zona propuesta \"estacionamientos para bicicletas\" y las campañas de promocion del uso de la bicicleta y de formación a ciclistas, junto con el Sistema de Transporte publico de bicicletas (URBICI) -> se estima el costo de implementación y mantenimiento (266) Se incluye al peatón como protagonista de la movilidad en la ciudad.(239) aunque sin proyectos específicos. Se incorporarán estacionamientos en las cabeceras de transporte urbano metropolita- nas, se promoverá la implementación de nuevas áreas de es- tacionamiento en los bordes de las áreas de mayor congestión vehicular y se dotará al sistema de servicios de intermodalidad que promuevan el uso del transporte no motorizado. (170) se incluye la necesidad de establecer medidas dirigidas al estacionamiento de rotación, fomentando el estacionamiento periférico al área central y en el sector de la costa (228) junto con la promocionar del estacionamiento subterráneo y, en conco- mitancia, eliminar el estacionamiento en calzada, (232) -> se propone proyectos concretos, se desginan zonas (236)","pmu/pmu_prioritization_en":"For the medium and long term, the implementation of a metropolitan rail transport network is planned, recovering existing railway infrastructures where appropriate. (169) through the implementation of train-trams. Corridors are assigned through which it would operate (171).\" Development of the \"Integrated Public Passenger Transport System\" which considers integrated networks made up of the different modes of transport: rail, train-trams, tram and road It is considered to favour the bicycle as a means of transport, through the promotion of its use, maintenance, expansion and renovation of infrastructures. (239) through the \"Plan de Ciclovías\", extend the current network from 35km to 150km. The proposed area is designated as \"bicycle parking\" and the campaigns to promote the use of bicycles and to train cyclists, together with the Public Bicycle Transport System (URBICI) -> the cost of implementation and maintenance is estimated (266) The pedestrian is included as the protagonist of mobility in the city. (239) although without specific projects. Parking lots will be incorporated at the metropolitan urban transport heads, the implementation of new parking areas will be promoted on the edges of the areas with the greatest traffic congestion and the system will be equipped with intermodal services that promote the use of non-motorized transport. (170) It includes the need to establish measures aimed at rotation parking, encouraging parking peripheral to the central area and in the coastal sector (228) together with the promotion of underground parking and, at the same time, eliminating parking on the road, (232) -> specific projects are proposed, zones are designated (236)","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. No se menciona la institucionalización de una perspectiva de género","pmu/pmu_gender_en":"No project includes a gender perspective. There is no mention of the institutionalization of a gender perspective","pmu/pmu_budget":"5898000000","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:c8296290-6d20-4d04-90b1-da9be7dfc0ad","meta/deprecatedID":"uuid:95bfe733-5bdb-43fb-ad4a-ebdae7a2d033","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c8296290-6d20-4d04-90b1-da9be7dfc0ad","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c8296290-6d20-4d04-90b1-da9be7dfc0ad"},{"_id":46378,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:36.484","end":"2025-11-07T14:24:36.484","id_drupal":"622","country":"pry","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Paraguay (2014-2016)","name_en":"Second National Open Government Action Plan of Paraguay (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","id_coordinator":"45441","name_coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","plan_number":"2","link":"8937d180-4ea9-4d58-9409-ab58ea656f2e","primary_link":"https://gobiernoabierto.gov.py/wp-content/uploads/2020/04/2do-Plan-de-Accion-Paraguay-espanol.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan contempla compromisos en las siguientes áreas: Transparencia, participación ciudadana y rendición de cuentas. Para su formulación, diferentes organizaciones sociales y privadas participaron de la definición de prioridades. También se llevaron a cabo seminarios y espacios de consulta con organizaciones de la sociedad civil. Asimismo, se realizaron talleres temáticos, en los que participaron instituciones públicas y organizaciones de la sociedad civil. El objetivo de estos talleres fue discutir cada compromiso. ","description_en":"The Plan includes commitments in the following areas: Transparency, citizen participation, and accountability. To formulate it, various social and private organizations participated in defining priorities. Seminars and consultation spaces with civil society organizations were also held. Additionally, thematic workshops were conducted, with the participation of public institutions and civil society organizations. The goal of these workshops was to discuss each commitment.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Paraguay_EOTR_2014-2016.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:344a688d-c8c1-4871-b2b8-67660cbcb443","meta/deprecatedID":"uuid:67c02c1b-0880-406b-ab19-ff6e79b3f6f1","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"344a688d-c8c1-4871-b2b8-67660cbcb443","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:35","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:344a688d-c8c1-4871-b2b8-67660cbcb443"},{"_id":46379,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:37.540","end":"2025-11-07T14:24:37.540","id_drupal":"630","country":"slv","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de El Salvador (2014-2016)","name_en":"Second Open Government National Action Plan of El Salvador (2014–2016)\n","responsible_institution":[{"responsible_institution/institution":"Secretaría de Participación Ciudadana, Transparencia y Anticorrupción (SPCTA) de El Salvador","responsible_institution/id_institution":"45111","responsible_institution/name_institution":"Secretaría de Participación Ciudadana, Transparencia y Anticorrupción (SPCTA) de El Salvador"}],"plan_number":"2","link":"33d62f4d-e29d-4d89-b95e-9e7ffa9f6ebc","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El plan contiene compromisos vinculados a los siguientes desafíos: administración de los recursos públicos; comunidades más seguras; integridad pública; mejora de los servicios; reponsabilidad empresarial. Asimismo, contempla la implementación de un mecanismo de seguimiento coordinado por la Secretaría de Participación Ciudadana, Transparencia y Anticorrupción y con participación activa de otras instituciones públicas y de la sociedad civil. El gobierno de El Salvador, en el marco del diseño del \"Plan Quinquenal de Desarrollo 2014-2019\", realizó una amplia consulta que comprendía cuatro modalidades: jornadas sectoriales, jornadas territoriales, consulta especializada y consulta en línea. Inmersos en este proceso,  se decidió construir sobre la base de esos insumos los compromisos que serían propuestos para el Plan de Acción – AGA 2014-2016. \n\nEl presente plan es el resultado de un proceso de consulta que incluyó dos metodologías, una realizada por la Secretaría de Participación  Ciudadana, Transparencia y Anticorrupción, y la otra, por organizaciones de la sociedad civil interesadas en el tema de Gobierno Abierto. En las consultas participaron ciudadanos y representantes de diversas organizaciones sociales, entidades autónomas y sectores empresariales, todos haciendo propuestas y aportado ideas para su implementación. Las organizaciones antes mencionadas llevaron a cabo un primer taller de consulta ciudadana para la formulación de las propuestas de acciones. Posteriormente realizaron una consulta en línea por medio de un portal web. De los insumos obtenidos en las consultas realizaron un proceso de discusión y sistematización del cual surgieron propuestas de compromisos e indicadores que fueron presentados en un taller de validación.  ","description_en":"The plan includes commitments related to the following challenges: public resource management; safer communities; public integrity; service improvement; and corporate accountability. It also provides for the implementation of a monitoring mechanism coordinated by the Secretariat for Citizen Participation, Transparency and Anti-Corruption, with the active participation of other public institutions and civil society organizations. As part of the development of the 2014–2019 Five-Year Development Plan, the Government of El Salvador carried out a broad consultation process that included four modalities: sectoral sessions, territorial sessions, specialized consultations, and an online consultation. Within this framework, it was decided to build the proposed Open Government Partnership 2014–2016 Action Plan commitments based on the inputs gathered through this process.\n\nThis plan is the result of a consultation process that included two methodologies: one led by the Secretariat for Citizen Participation, Transparency and Anti-Corruption, and the other by civil society organizations interested in the topic of open government. The consultations involved citizens and representatives of various social organizations, autonomous entities, and business sectors, all of whom contributed proposals and ideas for implementation. The aforementioned organizations carried out an initial citizen consultation workshop to formulate proposed actions. They subsequently conducted an online consultation through a dedicated website. Based on the inputs obtained, they engaged in a process of discussion and systematization, from which proposals for commitments and indicators emerged and were presented in a validation workshop.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:819ea70a-d29d-41e5-823a-96ffbf5cd737","meta/deprecatedID":"uuid:49c6c319-ec15-418d-aa9e-c7302b940816","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"819ea70a-d29d-41e5-823a-96ffbf5cd737","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:36","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:819ea70a-d29d-41e5-823a-96ffbf5cd737"},{"_id":46380,"start":"2025-11-07T14:24:38.251-03:00","end":"2025-12-30T12:01:09.251-03:00","id_drupal":"1798","country":"ecu","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversiones 2021-2025 - Plan de Creación de Oportunidades 2021-2025 de Ecuador","name_en":"Multi-Year Investment Plan 2021-2025 - Opportunity Creation Plan 2021-2025 of Ecuador","responsible_institution":[{"responsible_institution/institution":"Dirección de Planificación de la Inversión, Dirección de Seguimiento a la Inversión","responsible_institution/id_institution":"45212","responsible_institution/name_institution":"Dirección de Planificación de la Inversión, Dirección de Seguimiento a la Inversión"}],"link":"1dc39fe8-3c97-4677-b69b-e2c010dfa456","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","description_es":"El Plan Creación de Oportunidades 2021 - 2025 (Plan Nacional de Desarrollo-PND) contiene el Plan Plurianual de Inversión Pública (PPIP). El PPIP es un instrumento de programación de inversión pública que contiene la descripción técnica y presupuestaria de los estudios, programas y proyectos de inversión pública prioritarios para un periodo de 4 años. Este constituye una herramienta programática referencial que podrá ser ajustada cada año por el ente rector de la planificaicón nacional al momento de definir el Plan Anual de Inversiones correspondiente.","description_en":"The Opportunity Creation Plan 2021–2025 (National Development Plan – NDP) includes the Multiannual Public Investment Plan (MPIP). The MPIP is a public investment programming instrument that contains the technical and budgetary description of studies, programs, and priority public investment projects for a four-year period. It is a referential programming tool that may be adjusted annually by the national planning authority when defining the corresponding Annual Investment Plan.","linking_sdg_plans":"yes","pip/pip_project_list":"no","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_costing_es":"Costeo por sector y objetivos estratégicos del Plan de Desarrollo, no por proyectos en individual porque no realiza un listado.","pip/pip_costing_en":"Costing is carried out by sector and by the strategic objectives of the Development Plan, rather than by individual projects, as no project-by-project list is provided.","pip/pip_budget":"no","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"Los elementos orientadores para asignar en el ámbito público recursos y priorizar la inversión se encuentran agrupados de manera consistente con los 5 ejes temáticos definidos en el Plan Creación de Oportunidades 2021 - 2025. Considera criterios económicos, sociales, de seguridad integral, de transición ecológica e institucionales. De todas formas, se colocará énfasis en la generación de empleos y en salud como consecuencia de la Pandemia.","pip/pip_priorization_en":"The guiding elements for allocating public resources and prioritizing investment are grouped in a manner consistent with the five thematic pillars defined in the Creation of Opportunities Plan 2021–2025. They take into account economic, social, comprehensive security, ecological transition, and institutional criteria. Nevertheless, emphasis will be placed on job creation and health as a consequence of the pandemic.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de Ecuador","link_block/snip_id":"46754","link_block/snip_name":"Sistema Nacional de Inversión Pública de Ecuador"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:736c6c1e-3feb-437d-b8a4-2320b3eb2a7d","meta/deprecatedID":"uuid:04feba66-7c9e-4a37-808f-170de70539ad","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"736c6c1e-3feb-437d-b8a4-2320b3eb2a7d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:37","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:736c6c1e-3feb-437d-b8a4-2320b3eb2a7d"},{"_id":46381,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:38.968","end":"2025-11-07T14:24:38.968","id_drupal":"618","country":"hnd","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Honduras (2014-2016)","name_en":"Second National Open Government Action Plan of Honduras (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Dirección General de Transparencia y Prevención de la Corrupción","responsible_institution/id_institution":"45252","responsible_institution/name_institution":"Dirección General de Transparencia y Prevención de la Corrupción"}],"coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","id_coordinator":"45152","name_coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","plan_number":"2","link":"7e9c8453-f294-4c44-9825-9f149fe94197","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El plan cuenta con catorce grandes compromisos y metas asociadas, que están sujetos a una gestión por resultados. También posee las siguientes metas transversales: transparencia, rendición de cuentas, fomento de una cultura ética, respeto a la ley y seguridad jurídica. Asimismo, incorpora compromisos de acción relacionados a tres de los cinco desafíos que fueron objeto de compromisos en el plan de acción 2012- 2014 y que están encaminados a: i) Aumentar la integridad pública; ii) Gestionar de forma eficiente y efectiva los recursos públicos; iii) Mejorar los servicios públicos.\n\nPara la elaboración del plan se realizaron jornadas de sensibilización en cinco regiones del país (Choluteca, Tegucigalpa, La Ceiba, San Pedro Sula, Santa Rosa de Copán). También se convocó a jornadas de consulta en dichas regiones. Además de las consultas presenciales, hubo oportunidad para emitir comentarios al borrador del II Plan de Acción en el sitio web de gobierno abierto de Honduras, con el objetivo de garantizar la accesibilidad y brindar oportunidades para que la ciudadanía en general participara en línea.","description_en":"The plan includes fourteen major commitments and associated goals, which are subject to results-based management. It also has the following transversal goals: transparency, accountability, fostering an ethical culture, respect for the law, and legal security. Furthermore, it includes commitments related to three of the five challenges that were the subject of commitments in the 2012-2014 action plan, aimed at: i) Increasing public integrity; ii) Efficiently and effectively managing public resources; iii) Improving public services.\nFor the plan’s development, awareness-raising days were held in five regions of the country (Choluteca, Tegucigalpa, La Ceiba, San Pedro Sula, Santa Rosa de Copán). Consultative sessions were also called in these regions. In addition to in-person consultations, there was an opportunity to submit comments on the draft of the 2nd Action Plan on the Open Government website of Honduras, to ensure accessibility and provide opportunities for general citizens to participate online.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Honduras_EoT_2014-2016.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:4f9bd910-11be-45a0-a4cd-ceacbea3740a","meta/deprecatedID":"uuid:65d720db-7c87-461f-98f2-e95e745a5782","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4f9bd910-11be-45a0-a4cd-ceacbea3740a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:38","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4f9bd910-11be-45a0-a4cd-ceacbea3740a"},{"_id":46382,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:39.717","end":"2025-11-07T14:24:39.717","id_drupal":"586","country":"dom","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de República Dominicana (2014-2016)","name_en":"Second National Open Government Action Plan of the Dominican Republic (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana","responsible_institution/id_institution":"45523","responsible_institution/name_institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana"}],"coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","id_coordinator":"44999","name_coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","plan_number":"2","link":"75a4965b-f2d6-4dda-876f-a8664a24d27d","primary_link":"https://gobiernoabierto.gob.do/wp-content/uploads/2021/12/2do-plan-de-accion.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción 2014-2016 es producto de una amplia Consulta Nacional y está conformado por las propuestas más relevantes por mesa temática. Estas propuestas son las que contienen los criterios principales de gobierno abierto (Transparencia, Participación, Colaboración, uso de herramientas Tecnológicas). Varias de ellas fueron fusionadas por ser afines y tratar el mismo tema.\n\nEn el análisis de las propuestas fueron también tomados en cuenta cinco grandes retos de gobierno abierto: Mejora de servicios públicos; Integridad en el Sector Público; Incremento de la transparencia y rendición de cuentas; Seguridad en las Comunidades; Responsabilidad corporativa.\n\nLos compromisos fueron agrupados en siete grandes ejes temáticos: Tecnología y Datos Abiertos; Transparencia y rendición de cuentas; Participación de la ciudadanía en términos más incluyentes; Educación para el desarrollo; Salud cercana al ciudadano; Medioambiente responsable; Comunidades más seguras.\n\nSe utilizaron diversos canales para generar una mayor participación y colaboración ciudadana. Entre ellos, consultas presenciales realizadas en todo el territorio nacional, las redes sociales, correo electrónico, y una consulta en línea, abierta durante todo el periodo de co-creación del Plan. Con la finalidad de hacer la consulta al más amplio nivel, se colocó a disposición del público el cronograma de consultas públicas, así como de las mesas de trabajo sectoriales, y se realizó un despliegue territorial en las regiones.\n\nA medida que iban avanzando las Consultas se fue conformando la Red de Gobierno Abierto de la República Dominicana. Asimismo, se trabajó con mesas temáticas multiactor. \n\nEste plan de acción se articula con la \"Estrategia Nacional de Desarrollo 2010-2030. Un viaje de transformación hacia un país mejor\".","description_en":"The 2014-2016 Action Plan is the result of a wide national consultation and consists of the most relevant proposals by thematic table. These proposals include the main open government criteria: Transparency, Participation, Collaboration, and use of technological tools. Several were merged as they addressed the same topics. The analysis of proposals also considered five major open government challenges: Improvement of public services; Integrity in the public sector; Increased transparency and accountability; Security in communities; Corporate responsibility. The commitments were grouped into seven major thematic areas: Technology and Open Data; Transparency and accountability; More inclusive citizen participation; Education for development; Health closer to the citizen; Responsible environmental practices; Safer communities. Various channels were used for citizen participation, including in-person consultations throughout the country, social media, email, and online consultations. As consultations progressed, the Open Government Network of the Dominican Republic was formed, and thematic multi-actor tables were created. This action plan is aligned with the “National Development Strategy 2010-2030: A Journey of Transformation Towards a Better Country.”","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:754cda1d-1cea-419a-ac15-cefa624c6943","meta/deprecatedID":"uuid:d54a0733-ff4a-4a54-91ba-9c26439f3479","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"754cda1d-1cea-419a-ac15-cefa624c6943","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:38","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:754cda1d-1cea-419a-ac15-cefa624c6943"},{"_id":46383,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:40.439","end":"2025-11-07T14:24:40.439","id_drupal":"614","country":"mex","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de México (2016-2018)","name_en":"Third National Open Government Action Plan of Mexico (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Secretaría de la Función Pública de México","responsible_institution/id_institution":"45276","responsible_institution/name_institution":"Secretaría de la Función Pública de México"}],"coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","id_coordinator":"45155","name_coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","plan_number":"3","link":"8fc6c286-c3a9-4578-bf2b-1a86675b39f3","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Mexico_Plan-de-Accion-2016-2018.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción 2016-2018 se diseñó en conjunto por el Secretariado Técnico Tripartito a partir de los aprendizajes obtenidos de la construcción e implementación de los dos planes de acción nacionales previos y con miras a definir compromisos más ambiciosos en términos de impacto positivo en la vida cotidiana de las personas. En ese sentido, se elaboró una metodología orientada a: 1. Ampliar la participación ciudadana: Involucrar a la mayor cantidad de personas posible para formular compromisos inclusivos y transformadores; 2.Definir compromisos en términos de política pública : Plantear con claridad lo que se quiere lograr en función de un problema público; 3. Contribuir con los Objetivos de Desarrollo Sostenible : Alinear los compromisos con la Agenda 2030 de Desarrollo Sostenible de Naciones Unidas, en el contexto de la Declaración sobre Gobierno Abierto para la implementación de la Agenda 2030 para el Desarrollo Sostenible , promovida por México durante su presidencia en la AGA.\n\nUn grupo amplio y plural de actores de la Sociedad Civil, de la Academia y de Gobierno —a través de mecanismos como la Consulta Amplia, las Jornadas Abiertas y las Mesas de Trabajo— han contribuido a la identificación de los problemas públicos más urgentes dentro de los temas que se decidieron abordar. Los esfuerzos realizados a lo largo de este proceso se enmarcan en la búsqueda por generar nuevos modelos de gobernanza en el país, en los que la participación  ciudadana y la rendición de cuentas sean elementos imprescindibles de la relación entre ciudadanía y autoridades.\n\nLos compromisos de este plan de acción se encuentran vinculados a los Objetivos de Desarrollo Sostenible de la Agenda 2030.","description_en":"The 2016-2018 Action Plan was designed collaboratively by the Tripartite Technical Secretariat, drawing on lessons from the development and implementation of the two previous national action plans and with the aim of defining more ambitious commitments in terms of their positive impact on people's daily lives. A methodology was developed with the following objectives:\n\nExpand citizen participation: Engage as many people as possible to formulate inclusive and transformative commitments;\n\nDefine commitments in terms of public policy: Clearly outline what is to be achieved based on a public issue;\n\nContribute to the Sustainable Development Goals: Align commitments with the United Nations 2030 Sustainable Development Agenda in the context of the Declaration on Open Government for the implementation of the 2030 Agenda, promoted by Mexico during its presidency of the OGP.\n\nA broad and diverse group of actors from civil society, academia, and government—through mechanisms such as the Broad Consultation, Open Days, and Working Tables—contributed to identifying the most urgent public issues within the topics to be addressed. The efforts made throughout this process are framed in the search for new governance models in the country, where citizen participation and accountability are key elements of the relationship between citizens and authorities.\n\nThe commitments in this action plan are linked to the Sustainable Development Goals of the 2030 Agenda.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://tablero.gobabiertomx.org/","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:eed1b99e-65b3-4129-84a8-e7fe954e5262","meta/deprecatedID":"uuid:519857ba-26c4-4ecf-a627-000b87e04202","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"eed1b99e-65b3-4129-84a8-e7fe954e5262","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:39","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:eed1b99e-65b3-4129-84a8-e7fe954e5262"},{"_id":46384,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:41.271","end":"2025-11-07T14:24:41.271","id_drupal":"597","country":"cri","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Costa Rica (2013-2015)","name_en":"First National Open Government Action Plan of Costa Rica (2013-2015)","responsible_institution":[{"responsible_institution/institution":"Coordinación de Gobierno Abierto ","responsible_institution/id_institution":"45438","responsible_institution/name_institution":"Coordinación de Gobierno Abierto "}],"coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","id_coordinator":"45439","name_coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","plan_number":"1","link":"cce958a0-750b-45f9-835e-bdc94b73a528","primary_link":"https://www.opengovpartnership.org/documents/costa-rica-action-plan-2013-2014/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2015-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción de Gobierno Abierto de Costa Rica se fundamenta en la línea estratégica de Modernización del Estado del \"Plan Nacional de Desarrollo 2011-2014\", el cual señala que se requiere hacer cada vez más eficiente y eficaz todo el sector público para articular acuerdos y tomar decisiones de manera oportuna y fomentar una participación cada vez mayor de la ciudadanía en la solución de los problemas nacionales, mediante la construcción de agendas de desarrollo basadas en el diálogo y la integración.\n\nCosta Rica enfocó sus esfuerzos hacia el cumplimiento de tres grandes desafíos, a saber: 1. Mejorar los servicios públicos, 2. Aumentar la integridad pública, la transparencia, la rendición de cuentas y la participación ciudadana, y 3. Administrar los recursos públicos con mayor eficacia.\n\nEste Plan de Acción es el producto de una serie de reuniones de coordinación gubernamental con la sociedad civil y de la participación y colaboración abierta con la ciudadanía a través del Internet y los medios de comunicación.","description_en":"Costa Rica's Open Government Action Plan is based on the strategic line of State Modernization in the “National Development Plan 2011-2014,” which states the need to make the entire public sector more efficient and effective to facilitate agreements, timely decision-making, and increased citizen participation in solving national problems through development agendas based on dialogue and integration. Costa Rica focused its efforts on achieving three major goals: 1. Improving public services, 2. Increasing public integrity, transparency, accountability, and citizen participation, and 3. Managing public resources more effectively. This Action Plan is the result of a series of government coordination meetings with civil society and open collaboration with the public through the internet and media.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Costa_Rica_2013-14_Primer_Informe.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:df1b0776-959e-4f95-ae63-8f86a48bf2d7","meta/deprecatedID":"uuid:b87baca8-4c5b-4669-a61b-9b8c4d3921ae","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"df1b0776-959e-4f95-ae63-8f86a48bf2d7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:40","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:df1b0776-959e-4f95-ae63-8f86a48bf2d7"},{"_id":46385,"start":"2025-11-07T14:24:41.992-04:00","end":"2026-05-12T10:34:30.079-04:00","id_drupal":"1005","country":"gtm","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de San Jerónimo (2025–2027)","name_en":"First Action Plan of San Jeronimo (2025-2027)","responsible_institution":[{"responsible_institution/institution":"Municipalidad de San Jerónimo","responsible_institution/id_institution":"45468","responsible_institution/name_institution":"Municipalidad de San Jerónimo"}],"coordinator":"Proceso de cocreación multisectorial de San Jerónimo","id_coordinator":"45247","name_coordinator":"Proceso de cocreación multisectorial de San Jerónimo","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/members/antigua-guatemala-guatemala/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de San Jerónimo","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción Local de San Jerónimo (2025–2027) surge como una apuesta del gobierno municipal para fortalecer la participación ciudadana, la transparencia y la eficiencia de la gestión pública en el municipio. El proceso fue liderado por la Municipalidad de San Jerónimo en conjunto con el Consejo de Desarrollo Comunitario (COMUDE), con el acompañamiento de actores de la sociedad civil y de instituciones públicas y privadas con presencia local. \n\nDurante su fase de cocreación, se llevaron a cabo múltiples encuentros presenciales y virtuales que incluyeron reuniones individuales con distintas instituciones, sesiones de trabajo con el Consejo Municipal y presentaciones públicas. Este proceso permitió identificar de forma colaborativa los principales desafíos del municipio en términos de gobernanza, participación y desarrollo económico local.\n\nUno de los pilares del plan es la actualización de la Política Pública Municipal de Gobierno Abierto, vigente desde 2019, a fin de consolidar una gestión más inclusiva, participativa y responsable. El diseño del plan se orienta también a institucionalizar mecanismos de rendición de cuentas, fortalecer el presupuesto participativo y promover el desarrollo económico con enfoque sostenible e inclusivo.\n\nEste plan no explicita los Objetivos de Desarrollo Sostenible (ODS) vinculados a cada compromiso; estos fueron asociados por ILPES como parte del acompañamiento a los gobiernos locales.","description_en":"The Local Action Plan of San Jerónimo (2025–2027) represents a commitment by the municipal government to strengthen citizen participation, transparency, and the efficiency of public management in the municipality. The process was led by the Municipality of San Jerónimo in coordination with the Community Development Council (COMUDE), with the support of civil society actors and public and private institutions with a local presence.\n\nDuring the co-creation phase, multiple in-person and virtual meetings were held, including individual meetings with various institutions, working sessions with the Municipal Council, and public presentations. This process enabled the collaborative identification of the municipality’s main challenges in terms of governance, participation, and local economic development.\n\nOne of the pillars of the plan is the updating of the Municipal Public Policy on Open Government, in effect since 2019, in order to consolidate a more inclusive, participatory, and accountable approach to governance. The plan also aims to institutionalize accountability mechanisms, strengthen participatory budgeting, and promote economic development with a sustainable and inclusive approach.\n\nWhile the plan does not explicitly state the Sustainable Development Goals (SDGs) linked to each commitment, these were identified by ILPES as part of its support to local governments.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:8325d052-8401-40fa-9924-7beafa307e2d","meta/deprecatedID":"uuid:26e5e4aa-66dc-4863-baec-f9c0e0922c6b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8325d052-8401-40fa-9924-7beafa307e2d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:41","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8325d052-8401-40fa-9924-7beafa307e2d"},{"_id":46386,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:42.710","end":"2025-11-07T14:24:42.710","id_drupal":"643","country":"ury","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Uruguay (2012-2014)","name_en":"First National Open Government Action Plan of Uruguay (2012-2014) ","responsible_institution":[{"responsible_institution/institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay","responsible_institution/id_institution":"45242","responsible_institution/name_institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","id_coordinator":"45001","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","plan_number":"1","link":"f4dc990a-5488-4463-843a-9ec3f758a2fd","primary_link":"https://www.gub.uy/agencia-gobierno-electronico-sociedad-informacion-conocimiento/sites/agencia-gobierno-electronico-sociedad-informacion-conocimiento/files/2019-02/plan_accion_uruguay_2012_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción Nacional para el Gobierno Abierto se complementa con la estrategia establecida en la Agenda Digital del país. Establece iniciativas para impulsar la instalación de un Gobierno Abierto en Uruguay. El plan fue coordinado por la Presidencia de Uruguay, y desarrollado por un grupo de trabajo donde participaron representantes de la Oficina de Planificación y Presupuesto (OPP), el Ministerio de Asuntos Económicos y Financieros (MEF), el Ministerio de Relaciones Exteriores (MRREE) , la Oficina Nacional de Estadísticas (INE), la Unidad de Acceso a la Información Pública (UAIP) y la Agencia para el Desarrollo de un Gobierno Electrónico y una Sociedad de la Información y el Conocimiento (AGESIC).","description_en":"The National Action Plan for Open Government is complemented by the strategy outlined in the country’s Digital Agenda. It establishes initiatives to promote the implementation of Open Government in Uruguay. The plan was coordinated by the Presidency of Uruguay and developed by a working group that included representatives from the Office of Planning and Budget (OPP), the Ministry of Economic and Financial Affairs (MEF), the Ministry of Foreign Affairs (MRREE), the National Statistics Office (INE), the Unit for Access to Public Information (UAIP), and the Agency for the Development of E-Government and a Knowledge Society (AGESIC).","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://miradordegobiernoabierto.agesic.gub.uy/SigesVisualizador/gu/o/GA","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Uruguay_final_2012.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:edfa4d1c-2d83-4286-8262-443c1af420ca","meta/deprecatedID":"uuid:df65e981-7d07-462c-8508-5a32096ef961","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"edfa4d1c-2d83-4286-8262-443c1af420ca","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:41","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:edfa4d1c-2d83-4286-8262-443c1af420ca"},{"_id":46387,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:43.422","end":"2025-11-07T14:24:43.422","id_drupal":"606","country":"pan","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Panamá (2013-2015)","name_en":"First National Open Government Action Plan of Panama (2013-2015) ","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia","responsible_institution/id_institution":"45253","responsible_institution/name_institution":"Dirección de Transparencia"}],"coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","id_coordinator":"45147","name_coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","plan_number":"1","link":"148ea84e-e772-4f10-87b7-a53ed71b3fe8","primary_link":"https://gobiernoabierto.gob.pa/wp-content/uploads/2024/05/Plan-de-Accion-Nacional-de-Gobierno-Abierto-2013-2014-1.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2015-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción toma en cuenta los tres ejes principales de un gobierno abierto: transparencia, para que la ciudadanía tenga conocimiento de lo que hace el gobierno y sus instituciones; participación ciudadana, quien con conocimiento de la administración y gestiones del Estado pueda hacer recomendaciones y contribuir con su experiencia y conocimiento para mejorar las gestiones públicas; y colaboración, que constituye poner en marcha los mecanismos para dar respuesta efectiva a las necesidades de la ciudadanía, orientados por la participación ciudadana y la recomendación pública.\n\nConscientes de la gran importancia que representa la participación ciudadana, lo que constituye la esencia de la iniciativa de un gobierno abierto, una vez cumplidos los compromisos de acción del Plan, el gobierno se comprometió a convocar a la sociedad civil, para que la ciudadanía pueda opinar y hacer aportes respecto a la ampliación del Plan de Acción de Panamá.","description_en":"The Action Plan incorporates the three core pillars of open government:\n\nTransparency, to ensure that citizens are informed about the actions of government and its institutions;\n\nCitizen participation, enabling individuals to make recommendations and contribute their expertise to improve public management; and\n\nCollaboration, which involves putting mechanisms in place to effectively respond to citizens’ needs, guided by public participation and recommendations.\n\nAware of the fundamental importance of citizen engagement—central to the open government initiative—the government committed to reconvening civil society after fulfilling the plan’s commitments, so that the public can provide input and contribute to the expansion of Panama’s Action Plan.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:7022a999-ad45-4c0c-a577-474d84260bff","meta/deprecatedID":"uuid:ae932c59-92bb-452b-9da5-bfceac254d30","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7022a999-ad45-4c0c-a577-474d84260bff","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7022a999-ad45-4c0c-a577-474d84260bff"},{"_id":46388,"start":"2025-11-07T14:24:44.136-03:00","end":"2026-04-06T12:45:41.387-04:00","id_drupal":"707","country":"brb","theme":"territorial_planning","original_language":"en","name_es":"Plan de Desarrollo Físico de Barbados","name_en":"Physical Development Plan (PDP) of Barbados","responsible_institution":[{"responsible_institution/institution":"Oficina de Planificación del Desarrollo Urbano y Rural de Barbados","responsible_institution/id_institution":"45371","responsible_institution/name_institution":"Oficina de Planificación del Desarrollo Urbano y Rural de Barbados"}],"link":"a394a6fb-97e4-4e84-ba40-3c2a08e20c53","primary_link":"https://www.barbadosparliament.com/uploads/sittings/attachments/23aaba16d823369d5633a9c98b39f585.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2035-01-01","effective_today":"yes","temporality":"long_term","description_es":"El Plan de Desarrollo Físico Modificado 2017 (PDP, por sus siglas en inglés) tiene como objetivo proporcionar una visión para el crecimiento y desarrollo sostenible de la nación, estableciendo políticas que orienten las relaciones entre los usos del suelo, la forma construida, la movilidad, los equipamientos comunitarios y la infraestructura física. También se propone como un marco para facilitar y orientar la inversión, tanto pública como privada, hasta el año 2035, con el fin de promover una nación saludable, próspera y resiliente.\n\nLa planificación física en Barbados se lleva a cabo para el desarrollo ordenado y progresivo del territorio y para la preservación y mejora de los activos clave, la infraestructura y los servicios relacionados. La planificación física, como función gubernamental, se basa en la *Ley de Planificación Urbana y Rural de Barbados (Cap. 240).*\n\nLos objetivos del PDP son:\n• Fomentar el bienestar económico, ambiental, físico y social de los habitantes de Barbados.\n• Abordar los impactos críticos del cambio climático en Barbados como un Pequeño Estado Insular en Desarrollo (PEID), mediante políticas y estrategias que permitan al pueblo barbadense prosperar y mantener su resiliencia frente a las condiciones climáticas cambiantes.\n• Establecer una visión que oriente la forma futura del desarrollo en cuanto al uso del suelo, los patrones de asentamiento, la producción de alimentos, la infraestructura y la gestión ambiental.\n• Orientar la forma futura del desarrollo en la isla e informar a los sectores público, empresarial y gubernamental sobre la naturaleza, el alcance y la ubicación tanto de las áreas de desarrollo como de protección de activos clave.\n• Proporcionar un marco de inversión claro y accesible para las obras y acciones públicas y privadas que afectan la salud social, económica y ambiental de la nación.","description_en":"The Physical Development Plan Amended 2017 (PDP)  is intended to provide a vision for sustainable growth and development of the nation by setting out policies to guide relationships among land uses, built form, mobility, community facilities and physical infrastructure. It is also intended to be a framework to facilitate and guide investment, both public and private, to the year 2035 to advance a healthy, prosperous and resilient nation.\n\nPhysical planning is undertaken in Barbados for the orderly and progressive development of land and for the preservation and improvement of core assets, infrastructure and related amenities. Physical Planning as a government function is based on the *Town and Country Planning Act (Cap.240)*. \n\nThe purposes of the PDP are: \n• Foster the economic, environmental, physical and social well-being of the residents of Barbados.\n• Address the critical impacts of climate change on Barbados as a Small Island Developing State (SIDS) through policies and strategies that enable the people of Barbados to thrive and remain resilient under changing climatic conditions.\n• Establish a vision to guide the future form of development with respect to land use, settlement patterns, food production, infrastructure and environmental management.\n• Guide the future form of development on the island and inform the public, business and government sectors as to the nature, scope and location of both development and protection areas for core assets.\n• Provide a clear and accessible investment framework for private and public works and actions which impact the social, economic and environmental health of the nation.","linking_sdg_plans":"yes","sdg":"sdg_2 sdg_9 sdg_11 sdg_13","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley de Planificación Urbana y Rural de Barbados","link_block/legal_id":"49557","link_block/legal_name":"Ley de Planificación Urbana y Rural de Barbados"},{"link_block/link_type":"internal","link_block/internal_link_type":"articulation","link_block/articulation_link":"Mecanismo de articulación/coordinación entre la planificación sectorial y territorial en Barbados","link_block/articulation_id":"46769","link_block/articulation_name":"Mecanismo de articulación/coordinación entre la planificación sectorial y territorial en Barbados"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:9fb553e9-9a26-41ce-86b4-1418d4aa724c","meta/deprecatedID":"uuid:237c57ab-3217-46dc-a686-448f1db938bd","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9fb553e9-9a26-41ce-86b4-1418d4aa724c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9fb553e9-9a26-41ce-86b4-1418d4aa724c"},{"_id":46389,"start":"2025-11-07T14:24:44.846-03:00","end":"2025-12-30T12:44:42.683-03:00","id_drupal":"1373","country":"dom","theme":"public_investment","original_language":"es","name_es":"Plan de Inversión 2023 de República Dominicana","name_en":"Investment Plan 2023 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45267","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","description_es":"El Plan de Inversión 2023 es un documento de programación de la inversión elaborado por la Dirección General de Inversión Pública, de acuerdo con lo establecido en la Ley Orgánica de Presupuesto para el Sector Público, No. 423-06. El Plan de inversión del año 2023 detalla cada proyecto según su codificación, nombre, región, provincia, municipio, periodo de ejecuión, a la sección de gobierno que corresponde, la institución ejecutora, su vinculación con las acciones, objetivos y ejes de la Estrategia Nacional de Desarrollo, el costo,  lo programado y ejecutado.","description_en":"The 2023 Investment Plan is an investment programming document prepared by the General Directorate of Public Investment, in accordance with the provisions of the Organic Budget Law for the Public Sector, No. 423-06. The 2023 Investment Plan details each project by code, name, region, province, municipality, execution period, corresponding government section, implementing institution, its link to the actions, objectives, and axes of the National Development Strategy, its cost, and the programmed and executed amounts.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El listado identifica cada proyecto con su nombre y con su zona geográfica, asimismo se brinda la infromación sobre la tipología de la financiación, estado del proyecto, situación presupuestaria, institución que lo ejecuta y a que sección del gobierno compete, la funcionalidad de cada proyecto del plan y los costos de cada uno.","pip/pip_project_list_en":"The list identifies each project by name and geographic zone and also provides information on the type of financing, project status, budgetary situation, executing institution, the government section to which it pertains, the function of each project within the plan, and the costs of each project.","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_costing_es":"El Plan de Inversiones muestra el costeo total individual de los proyectos de inversión.","pip/pip_costing_en":"The Investment Plan shows the total individual costing of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con presupuesto asignado y estado del gasto.","pip/pip_budget_en":"The investment projects included in the plan have an allocated budget and a spending status.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"Se identifican según región, provincia y municipio.","pip/pip_territorialization_en":"They are identified by region, province, and municipality.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"Todos los proyectos se vinuclan con el Plan Plurianual de inversiones y este asume las políticas priorizadas del Plan Nacional Plurianual del Sector Público 2021-2024.","pip/pip_priorization_en":"All projects are linked to the Multiannual Investment Plan, which in turn adopts the prioritized policies of the National Multiannual Public Sector Plan 2021–2024.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Marco Plurianual de Inversión Pública 2021-2024 de República Dominicana","link_block/plan_id":"46402","link_block/plan_name":"Marco Plurianual de Inversión Pública 2021-2024 de República Dominicana"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley Orgánica de Presupuesto para el Sector Público, No. 423-06 de República Dominicana","link_block/legal_id":"49732","link_block/legal_name":"Ley Orgánica de Presupuesto para el Sector Público, No. 423-06 de República Dominicana"},{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de República Dominicana","link_block/snip_id":"46763","link_block/snip_name":"Sistema Nacional de Inversión Pública de República Dominicana"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:80674103-c331-4424-9c3c-30242dcaeca5","meta/deprecatedID":"uuid:45a94f1f-fc10-402b-abbb-4348902532ad","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"80674103-c331-4424-9c3c-30242dcaeca5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:80674103-c331-4424-9c3c-30242dcaeca5"},{"_id":46390,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:45.556","end":"2025-11-07T14:24:45.556","id_drupal":"10057","country":"dom","theme":"public_investment","original_language":"es","name_es":"Plan de Inversión 2024 de República Dominicana","name_en":"Investment Plan 2024 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45392","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"primary_link":"https://mepyd.gob.do/dgip/plan-anual-de-inversion-publica#17710-21370-2024-datos-de-inversion-publica","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","description_es":"El Plan de Inversión 2024 es un documento de programación de la inversión elaborado por la Dirección General de Inversión Pública, de acuerdo con lo establecido en la Ley Orgánica de Presupuesto para el Sector Público, No. 423-06. El Plan de inversión del año 2023 detalla cada proyecto según su codificación, nombre, región, provincia, municipio, periodo de ejecuión, a la sección de gobierno que corresponde, la institución ejecutora, su vinculación con las acciones, objetivos y ejes de la Estrategia Nacional de Desarrollo, el costo,  lo programado y ejecutado. ","description_en":"The 2024 Investment Plan is an investment programming document prepared by the General Directorate of Public Investment, in accordance with the provisions of the Organic Budget Law for the Public Sector, No. 423-06. The 2023 Investment Plan details each project by code, name, region, province, municipality, execution period, corresponding government section, implementing institution, its link to the actions, objectives, and axes of the National Development Strategy, its cost, and the programmed and executed amounts.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_budget":"yes","pip/pip_territorialization":"yes","pip/pip_priorization":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ff8fbfbe-be11-4eec-a7ae-3fe4d9f4daae","meta/deprecatedID":"uuid:c0958395-0b49-4fe1-ac5e-4138e30f52b9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ff8fbfbe-be11-4eec-a7ae-3fe4d9f4daae","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:44","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ff8fbfbe-be11-4eec-a7ae-3fe4d9f4daae"},{"_id":46391,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:46.289","end":"2025-11-07T14:24:46.289","id_drupal":"10058","country":"dom","theme":"public_investment","original_language":"es","name_es":"Plan de Inversión 2025 de República Dominicana","name_en":"Investment Plan 2025 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45392","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"primary_link":"https://mepyd.gob.do/dgip/plan-anual-de-inversion-publica#17710-21907-2025-datos-de-inversion-publica","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Inversión 2025 es un documento de programación de la inversión elaborado por la Dirección General de Inversión Pública, de acuerdo con lo establecido en la Ley Orgánica de Presupuesto para el Sector Público, No. 423-06. El Plan de inversión del año 2023 detalla cada proyecto según su codificación, nombre, región, provincia, municipio, periodo de ejecuión, a la sección de gobierno que corresponde, la institución ejecutora, su vinculación con las acciones, objetivos y ejes de la Estrategia Nacional de Desarrollo, el costo,  lo programado y ejecutado. ","description_en":"The 2025 Investment Plan is an investment programming document prepared by the General Directorate of Public Investment, in accordance with the provisions of the Organic Budget Law for the Public Sector, No. 423-06. The 2023 Investment Plan details each project by code, name, region, province, municipality, execution period, corresponding government section, implementing institution, its link to the actions, objectives, and axes of the National Development Strategy, its cost, and the programmed and executed amounts.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_budget":"yes","pip/pip_territorialization":"yes","pip/pip_priorization":"yes","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:a8272d94-124d-4562-b32d-f280148415b7","meta/deprecatedID":"uuid:e579cbe5-3a55-43bf-b4d9-19342337603b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a8272d94-124d-4562-b32d-f280148415b7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:45","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a8272d94-124d-4562-b32d-f280148415b7"},{"_id":46392,"start":"2025-11-07T14:24:47.012-03:00","end":"2025-12-30T12:15:54.842-03:00","id_drupal":"1241","country":"hnd","theme":"public_investment","original_language":"es","name_es":"Plan de Inversión Pública 2022 de Honduras","name_en":"Public Investment Plan 2022 of Honduras","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversiones Públicas","responsible_institution/id_institution":"45217","responsible_institution/name_institution":"Dirección General de Inversiones Públicas"}],"link":"cf8a1519-e111-4cb0-b7c8-9350ebb321f4","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Inversión Pública 2022, es uno de los instrumentos de planificación más importantes del Gobierno, ya que permite llevar a la práctica las políticas, planes, estrategias, programas y proyectos orientados a mejorar la calidad de vida de la población hondureña, haciendo uso óptimo de los recursos del Estado de forma que éstos brinden beneficios a los ciudadanos de manera oportuna, eficaz y sostenible. En ese sentido, los recursos invertidos producen mayor bienestar social a la comunidad, en coherencia con las prioridades de Gobierno establecidas en el Plan Estratégico de Gobierno Visión de País (2010-2038) y los lineamientos e indicadores del Plan de Nación (2010-2022).\n\nEste plan presenta los resultados obtenidos a julio 2021 por sector, las pespectivas de inversión en 2022 por sector e institución.","description_en":"The 2022 Public Investment Plan is one of the Government’s most important planning instruments, as it enables the implementation of policies, plans, strategies, programs, and projects aimed at improving the quality of life of the Honduran population through the optimal use of State resources, ensuring that they provide timely, efficient, and sustainable benefits to citizens. In this sense, invested resources produce greater social welfare in the community, in alignment with the Government’s priorities established in the Government Strategic Plan Vision of the Country (2010–2038) and the guidelines and indicators of the National Plan (2010–2022).\nThis plan presents the results achieved by July 2021 by sector, and the investment outlook for 2022 by sector and institution.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El Plan contiene un listado de proyectos.","pip/pip_project_list_en":"The Plan contains a list of projects.","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_costing_es":"El Plan de Inversiones muestra el costeo de los proyectos de inversión.","pip/pip_costing_en":"The Investment Plan shows the costing of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con presupuesto asignado.","pip/pip_budget_en":"The investment projects included in the plan have an allocated budget.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"Se detallan la distribución de montos asignados a proyectos de inversión según la ubicación geográfica (por departamento).","pip/pip_territorialization_en":"The distribution of amounts allocated to investment projects is detailed by geographic location (by department).","pip/pip_indicators":"no","pip/pip_priorization":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Estratégico de Gobierno 2018-2022 de Honduras","link_block/plan_id":"46580","link_block/plan_name":"Plan Estratégico de Gobierno 2018-2022 de Honduras"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Visión de País 2010–2038 y Plan de Nación 2010‐2022 de Honduras","link_block/plan_id":"46569","link_block/plan_name":"Visión de País 2010–2038 y Plan de Nación 2010‐2022 de Honduras"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:4643b47e-b1eb-4657-9d6a-f0b6c6c5e351","meta/deprecatedID":"uuid:7112eacb-e21d-4da2-be1d-7e2b87786701","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4643b47e-b1eb-4657-9d6a-f0b6c6c5e351","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4643b47e-b1eb-4657-9d6a-f0b6c6c5e351"},{"_id":46393,"start":"2025-11-07T14:24:47.771-03:00","end":"2026-04-06T11:54:40.077-04:00","id_drupal":"681","country":"arg","theme":"territorial_planning","original_language":"es","name_es":"Plan Estratégico Territorial (última actualización) de Argentina","name_en":"Strategic Territorial Plan (latest update) of Argentina","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación Territorial y Coordinación de la Obra Pública","responsible_institution/id_institution":"45425","responsible_institution/name_institution":"Secretaría de Planificación Territorial y Coordinación de la Obra Pública"}],"link":"82d138f2-7bd1-4a3a-8134-fea1dc359791","primary_link":"https://www.argentina.gob.ar/sites/default/files/plan_estrategico_territorial_2018_baja.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Estratégico Territorial Argentina (Avance 2018) constituye un marco de referencia integral para la planificación y gestión del desarrollo del territorio nacional. Su objetivo es orientar las políticas públicas y las inversiones en función de las características, necesidades y potencialidades de las diferentes regiones, promoviendo un desarrollo equilibrado, sostenible e inclusivo. A continuación, se destacan tres aspectos clave de este plan:\n\n*1. Un instrumento de planificación para el desarrollo y el ordenamiento territorial*\nEl Plan Estratégico Territorial Argentina (Avance 2018) es un instrumento de planificación que orienta el despliegue de la inversión pública y privada en todo el territorio nacional. Fue consolidado mediante consenso entre el Gobierno nacional, las provincias y los municipios, y forma parte de la Política Nacional de Desarrollo y Ordenamiento Territorial. Su propósito es promover un territorio más integrado, equilibrado, sustentable y socialmente inclusivo, orientando dichas inversiones hacia los desafíos y oportunidades concretos de las distintas regiones del país. \n\n*2. Un proceso y no solo un documento*\nEl plan no es concebido como un producto cerrado, sino como un proceso continuo y dinámico de planificación. Desde su génesis en 2008, se ha ido actualizando para incorporar estudios, indicadores y análisis territorial que permitan comprender mejor las realidades locales y así ajustar las políticas públicas a las necesidades reales de los territorios. De esta manera, el PET equilibra demandas de corto plazo con una visión de desarrollo de mediano y largo plazo. \n\n*3. Integración de agendas globales y sectoriales*\nEl PET Avance 2018 incorpora los Objetivos de Desarrollo Sostenible (ODS), los acuerdos del Marco de Sendai para la reducción del riesgo de desastres, y las prioridades de la Nueva Agenda Urbana (Hábitat III), situando al territorio como eje central de políticas públicas más amplias de desarrollo sostenible. Además busca articular la planificación sectorial con el enfoque territorial, integrando acciones vinculadas a infraestructura, asentamientos, vivienda, servicios básicos y cohesión social.","description_en":"The Argentina Territorial Strategic Plan (Advance 2018) serves as a comprehensive framework for planning and managing the development of the national territory. Its purpose is to guide public policies and investments according to the characteristics, needs, and potential of the different regions, promoting balanced, sustainable, and inclusive development. The following highlights three key aspects of this plan:\n\n*1. A planning instrument for development and territorial ordering*\nThe Argentina Territorial Strategic Plan (Advance 2018) is a planning instrument designed to guide the deployment of public and private investment across the national territory. It was consolidated through consensus among the national government, provincial governments and municipalities, and is part of the National Policy for Development and Territorial Planning. Its aim is to promote a more integrated, balanced, sustainable and socially inclusive territory by directing investments toward the specific challenges and opportunities in Argentina’s diverse regions. \n\n*2. A continuous and evolving planning process*\nThe plan is understood not as a static document but as a continuous and flexible planning process. Since its inception in 2008, it has been regularly updated with new data, studies and territorial indicators to better understand local conditions and adapt public policies accordingly. This allows the PET to balance immediate needs with a medium‑ and long‑term vision for territorial development. \nArgentina\n\n*3. Integration of global and sectoral agendas*\nThe PET Advance 2018 integrates global frameworks such as the Sustainable Development Goals (SDGs), the Sendai Framework for Disaster Risk Reduction, and the priorities of the New Urban Agenda (Habitat III). This positions territorial planning at the center of broader public policy objectives and encourages the alignment of sector‑specific strategies—such as infrastructure, urban services, housing, and social cohesion—with a territorial perspective.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_6 sdg_9 sdg_11 sdg_13 sdg_15","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"articulation","link_block/articulation_link":"Mecanismo de articulación/coordinación entre la planificación sectorial y territorial en Argentina","link_block/articulation_id":"46765","link_block/articulation_name":"Mecanismo de articulación/coordinación entre la planificación sectorial y territorial en Argentina"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Política Nacional de Desarrollo y Ordenamiento Territorial de Argentina","link_block/legal_id":"49772","link_block/legal_name":"Política Nacional de Desarrollo y Ordenamiento Territorial de Argentina"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley 25.675 General del Ambiente","link_block/legal_id":"49723","link_block/legal_name":"Ley 25.675 General del Ambiente"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Nacional de Suelo Urbano","link_block/plan_id":"46398","link_block/plan_name":"Plan Nacional de Suelo Urbano"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:929bb014-5cff-41e3-928b-e79df769e1d2","meta/deprecatedID":"uuid:8e4fb7d1-9bb8-4a60-8293-110e53d251f2","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"929bb014-5cff-41e3-928b-e79df769e1d2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:929bb014-5cff-41e3-928b-e79df769e1d2"},{"_id":46394,"start":"2025-11-07T14:24:48.506-04:00","end":"2026-04-06T13:02:00.804-04:00","id_drupal":"808","country":"pry","theme":"territorial_planning","original_language":"es","name_es":"Plan Marco Nacional de Desarrollo y Ordenamiento Territorial de Paraguay","name_en":"National Framework Plan for Development and Territorial Planning of Paraguay","responsible_institution":[{"responsible_institution/institution":"Dirección General de Desarrollo Territorial e Integración Regional (DGDTIR)","responsible_institution/id_institution":"45008","responsible_institution/name_institution":"Dirección General de Desarrollo Territorial e Integración Regional (DGDTIR)"}],"link":"4cf231f2-61c8-4f9a-8a6d-e444e4554e23","primary_link":"https://biblioteca.clacso.edu.ar/Paraguay/id/20170405041907/pdf_687.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","effective_today":"no","temporality":"long_term","description_es":"El Plan Marco Nacional de Desarrollo y Ordenamiento Territorial, ha sido elaborado en 2012 con la coordinación y supervisión de la Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP) y define acciones, normativas e instrumentos para organizar  el territorio, de manera que se generen las condiciones básicas que viabilicen el desarrollo económico productivo, la mejora de la calidad de vida de la población, el desarrollo político institucional y la sustentabilidad ambiental. Con este Plan se define un modelo de ocupación y organización del territorio de largo y mediano plazo que guíe el aprovechamiento racional de los recursos naturales existentes para alcanzar el desarrollo, evitando el deterioro del entorno físico de una manera irreversible, enfatizando en el desarrollo de ciertas áreas, la incorporación de equipamiento e infraestructura y la desconcentración y la descentralización económica como mecanismos para un desarrollo integral más armónico entre las diferentes entidades del territorio.","description_en":"The National Framework Plan for Development and Land Use Planning was developed in 2012 under the coordination and supervision of the Technical Secretariat for Economic and Social Development Planning (STP). It defines actions, regulations, and instruments to organize the territory in order to create the necessary conditions to enable productive economic development, improve the population’s quality of life, foster institutional political development, and promote environmental sustainability. The Plan sets out a medium- and long-term model for the occupation and organization of the territory, guiding the rational use of natural resources for development while avoiding irreversible degradation of the physical environment. It emphasizes the development of specific areas, infrastructure and facilities, and economic decentralization as mechanisms for a more harmonious and integrated territorial development.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:695c63be-903b-4d92-8b5d-c684ceb2e5b6","meta/deprecatedID":"uuid:8206b012-0e96-4ed0-95f4-4a0a88d93d91","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"695c63be-903b-4d92-8b5d-c684ceb2e5b6","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:695c63be-903b-4d92-8b5d-c684ceb2e5b6"},{"_id":46395,"start":"2025-11-07T14:24:49.229-04:00","end":"2026-04-06T12:53:47.170-04:00","id_drupal":"875","country":"dma","theme":"territorial_planning","original_language":"en","name_es":"Plan Nacional de Desarrollo Físico de Dominica","name_en":"National Physical Development Plan of Dominica","responsible_institution":[{"responsible_institution/institution":"División de Planificación Física de Dominica","responsible_institution/id_institution":"45260","responsible_institution/name_institution":"División de Planificación Física de Dominica"}],"link":"99a84e4d-8533-4a11-b145-4e3d7b6d1d20","primary_link":"https://physicalplanning.gov.dm/land-use-and-development/documents/138-draft-dominica-national-physical-development-plan-npdp","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2035-01-01","effective_today":"yes","temporality":"long_term","description_es":"El Plan Nacional de Desarrollo Físico (PNDF) de la Mancomunidad de Dominica actúa, junto con la Política Nacional de Uso del Suelo (PNUS), como uno de los dos documentos fundamentales que cumplen con los requisitos establecidos por la Ley de Planificación Física. Juntos, la PNUS y el PNDF orientan la planificación del uso del suelo y el desarrollo futuro en Dominica.\n\nEl Plan Nacional de Desarrollo Físico facilita una planificación racional, integrada y a largo plazo de todos los usos del suelo en el país. Este instrumento permite optimizar el uso del territorio minimizando los conflictos de uso del suelo, y ayuda a orientar las decisiones cuando existen compensaciones entre distintos usos.\n\nEl PNDF también contribuye a orientar decisiones sobre el uso del suelo que apoyen la protección y mejora del medio ambiente, así como aquellas que fomenten el desarrollo social y económico. El PNDF es el documento complementario de la PNUS, que es la política aprobada por el gabinete para guiar el uso del suelo y el crecimiento/desarrollo. Todas las políticas incluidas en el PNDF son coherentes con la PNUS. Ambos documentos están habilitados por la Ley de Planificación Física (2002).\n\nDe acuerdo con esta ley, la Autoridad de Planificación puede elaborar, o encargar la elaboración de, un PNDF para orientar las decisiones sobre planificación del uso del suelo en el país. La PNUS y el PNDF trabajan conjuntamente para conformar el Plan Nacional de Desarrollo Físico, tal como se describe en la Ley de Planificación Física.","description_en":"The National Physical Development Plan (NPDP) for the Commonwealth of Dominica acts together with the National Land Use Policy (NLUP) as the two core documents which fulfill the requirements of the Physical Planning Act. Together the NLUP and NPDP guide planning for future land use and development in Dominica. \n\nThe National Physical Development Plan will facilitate rational, integrated long-term planning of all uses of land in the country. This instrument makes it possible to optimize the use of land by minimizing land use conflicts and helps guide decisions when there are land use trade-offs. The NPDP also helps guide land use decisions that support environmental protection and enhancement, as well as decisions that support social and economic development.\n\nThe NPDP is the partner document to the NLUP, which is the Cabinet-approved policy to guide the use of land and growth/development. All the policies in the NPDP are consistent with the NLUP. Both the NLUP and the NPDP are enabled through the Physical Planning Act (2002). \n\nUnder the Act, the Planning Authority may prepare, or cause to be prepared a NPDP to guide land use planning decisions in the country. The NLUP and the NPDP documents work together to form the National Physical Development Plan as described in the Physical Planning Act.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:5d45a529-2332-4af1-90b7-c5c23055c4c8","meta/deprecatedID":"uuid:152b8e32-4946-40dc-85f7-dca071e3dc58","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5d45a529-2332-4af1-90b7-c5c23055c4c8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:48","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:5d45a529-2332-4af1-90b7-c5c23055c4c8"},{"_id":46396,"start":"2025-11-07T14:24:49.961-03:00","end":"2025-12-30T09:47:09.542-03:00","id_drupal":"1228","country":"arg","theme":"public_investment","original_language":"es","name_es":"Plan Nacional de Inversiones Públicas 2023-2025 de Argentina","name_en":"National Public Investment Plan 2023-2025 of Argentina","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Inversión Pública","responsible_institution/id_institution":"45215","responsible_institution/name_institution":"Dirección Nacional de Inversión Pública"}],"link":"41b413d6-e6db-4536-8876-35ccf71ec25e","primary_link":"https://www.argentina.gob.ar/sites/default/files/pnip_2023_2025.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan Nacional de Inversiones Públicas (PNIP) es un plan con horizonte multianual de 3 años y actualización anual, cuya elaboración se encuentra a cargo de Dirección Nacional de Inversión Pública (DNIP), de acuerdo a lo establecido por la Ley del Sistema Nacional de Inversiones Públicas (SNIP) Ley No. 24354. El PNIP comprende el detalle de los proyectos de inversión que integran el Proyecto de Ley de Presupuesto para el año de publicación, así como también sus previsiones para los dos años posteriores. En consecuencia, contempla la totalidad de los Gastos de Capital, tanto los destinados a la ejecución de obras como a la adquisición de bienes de capital a ejecutarse directamente por algún organismo de la Administración Pública Nacional (APN), los ejecutados por terceros con recursos de la APN (Transferencias de Capital), y la Inversión Financiera. Para algunos proyectos o conjunto de proyectos se hace mención de su vínculo con planes sectoriales y territoriales, un ejemplo de ello son el Plan Belgrano y el Plan Nacional del Agua.\n\nLa estructura del PNIP 2023-2025 se presenta de manera sistemática y organizada el conjunto de programas y proyectos de inversión pública (Gastos de Capital) incorporados al proyecto de Ley de Presupuesto General de la Administración Nacional. Las inversiones previstas para 2023 continuarán con su rol dinamizador del sistema económico, impulsando el crecimiento y asegurando su sustentabilidad en el mediano y largo plazo. El PNIP 2023-2025 comprende a los proyectos de inversión que integran el Proyecto de Ley de Presupuesto para el año 2023, así como también sus previsiones para los años 2024 y 2025. En consecuencia, contempla la totalidad de los Gastos de Capital destinados tanto a la realización de obras como a la adquisición de bienes de capital a ejecutarse directamente por algún organismo de la APN (IRD), a través de terceros con recursos de la APN (Transferencias de Capital), y la Inversión Financiera. A su vez, mantendrán su preponderancia en la mejora del contexto socioeconómico nacional y en la recuperación de la formación de capital.  Los principales sectores son: vivienda y urbanismo (18% del total), energía, combustibles y minería (17%), agua potable y alcantarillado (13%), vialidad (13%), educación y cultura (9%), transporte (9%) y ciencia y técnica (4%). El PNIP se estructura en diferentes apartados, que tratan: la evolución reciente de la Inversión Pública, la composición del Gasto de Capital, los principales sectores que abarca, las diferentes fuentes de Financiamiento, la ubicación geográfica de cada proyecto, las iniciativas de inversión, entre otros. Asimismo, y por último, menciona los aspectos metodológicos a tener en cuenta.","description_en":"The National Public Investment Plan (PNIP) is a multiannual horizontal 3-year plan and annual update elaborated by the National Directorate of Public Investment (DNIP), as established by Law No. 24454 on the National Public Investment System (SNIP). The PNIP comprises the details of the investment projects that are part of the Budget Bill for the year of publication, as well as its previsions for the years after. As a consequence, it provides for the totality of capital expenses, as well as the expenses for executing the works such as the acquisition of capital goods to be executed directly by some National Public Administration (APN) body, those executed by third parties with APN resources (capital transfers) and financial investment. For some projects or a set of projects, mention is made of its link with sectoral and territorial plans, examples of which are the Belgrano Plan and the National Water Plan.\n\nThe structure of the PNIP 2023-2025 presents in a systematic and organized manner the set of public investment programs and projects (Capital Expenditures) incorporated into the draft General Budget Law of the National Administration. The investments foreseen for 2023 will continue with their dynamizing role in the economic system, boosting growth and ensuring its sustainability in the medium and long term. The PNIP 2023-2025 includes the investment projects included in the Budget Bill for the year 2023, as well as its forecasts for the years 2024 and 2025. Consequently, it contemplates all the Capital Expenditures destined both to the execution of works and the acquisition of capital goods to be executed directly by any NPA agency (IRD), through third parties with NPA resources (Capital Transfers), and the Financial Investment. In turn, they will maintain their preponderance in the improvement of the national socioeconomic context and in the recovery of capital formation.  The main sectors are: housing and urban planning (18% of the total), energy, fuel and mining (17%), potable water and sewerage (13%), roads (13%), education and culture (9%), transportation (9%) and science and technology (4%). The PNIP is structured in different sections, which deal with: the recent evolution of Public Investment, the composition of Capital Expenditure, the main sectors covered, the different sources of Financing, the geographic location of each project, investment initiatives, among others. It also mentions the methodological aspects to be taken into account.","linking_sdg_plans":"yes","description_links/type_external_link":"plan","pip/pip_project_list":"yes","pip/pip_project_list_es":"El Plan de Inversiones incorpora listados de los principales proyectos por sector y en un anexo se incluyen la totalidad de los proyectos que forman parte del presupuesto anual.","pip/pip_project_list_en":"The Investment Plan includes lists of the main projects by sector, and an annex contains the full set of projects that make up the annual budget.","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_costing_es":"El plan nacional de inversiones considera el costeo de todos los proyectos de inversión. Asimismo, se considera la fuente de financiación.","pip/pip_costing_en":"The National Investment Plan takes into account the costing of all investment projects. It also specifies the source of financing.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con presupuesto asignado.","pip/pip_budget_en":"The investment projects included in the plan have an allocated budget.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El Plan de Inversiones cuenta con información de ubicación de proyectos, divide los montos de inversión por territorio, contempla planes territoriales de inversión. Es importante destacar que también se divide el listado en áreas temáticas (ciencia, trasnporte, educación, salud, etc). Los gastos de capital del Proyecto de Ley de Presupuesto 2023 de la Administración Nacional responden a una integración de las provincias de forma federal y articulada, entendiendo a la inversión pública como una herramienta indispensable del desarrollo de las economías regionales. Por ello organizan la territorialización del plan en zonas: Pampeana, NOA, NEA, Cuyo y Patagonia.","pip/pip_territorialization_en":"The Investment Plan includes information on project locations, breaks down investment amounts by territory, and incorporates territorial investment plans. It is also important to note that the list is organized by thematic areas (science, transport, education, health, etc.). The capital expenditures of the National Administration’s 2023 Budget Bill reflect a federal and coordinated integration of the provinces, viewing public investment as an essential tool for the development of regional economies. Accordingly, the territorialization of the plan is organized into zones: Pampas, Northwest (NOA), Northeast (NEA), Cuyo, and Patagonia.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"El listado de proyectos no incorpora orden de prelación y/o criterios de priorización. Sin embargo, se remarca mucho el contexto sanitario que debió atravesar el país en particular y el mundo en general para fundamentar ciertos proyectos sobre todo de saneamiento, sanitarios y de salud.","pip/pip_priorization_en":"The list of projects does not include an order of precedence and/or prioritization criteria. However, strong emphasis is placed on the health context that the country in particular, and the world in general, had to face, in order to justify certain projects, especially those related to sanitation, public health infrastructure, and healthcare.","pip/pip_sdg_link":"sdg_17","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley de Inversión Pública (Nro. 24.354) de Argentina","link_block/legal_id":"49748","link_block/legal_name":"Ley de Inversión Pública (Nro. 24.354) de Argentina"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:e0acd8f0-ff30-4513-b8a0-873635f6cb2b","meta/deprecatedID":"uuid:b2d514bd-d534-4ab7-a845-afb6b6cafd7f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e0acd8f0-ff30-4513-b8a0-873635f6cb2b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:49","_tags":[],"_notes":[],"_validation_status":{"timestamp":1783540111,"uid":"validation_status_not_approved","by_whom":"darenas","color":"#ff0000","label":"Not Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e0acd8f0-ff30-4513-b8a0-873635f6cb2b"},{"_id":46397,"start":"2025-11-07T14:24:50.678-04:00","end":"2026-04-06T12:51:49.781-04:00","id_drupal":"838","country":"dom","theme":"territorial_planning","original_language":"es","name_es":"Documento de consulta. Plan Nacional de Ordenamiento del Territorio de República Dominicana 2030","name_en":"Consultation Document. National Territorial Planning Plan of the Dominican Republic 2030","responsible_institution":[{"responsible_institution/institution":"Viceministerio de Ordenamiento Territorial y Desarrollo Regional","responsible_institution/id_institution":"45013","responsible_institution/name_institution":"Viceministerio de Ordenamiento Territorial y Desarrollo Regional"}],"link":"ebc900d0-fd61-40c1-9644-b57c2f2fc3fe","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","description_es":"El Plan Nacional de Ordenamiento Territorial (PNOT) ha sido concebido como un documento de política que orienta las decisiones de carácter nacional acerca del uso del territorio, compatibilizando las diferentes políticas sectoriales, con el objetivo de gestionar y aprovechar sus recursos para alcanzar el desarrollo sostenible, promover la cohesión territorial y mejorar las condiciones de vida de los habitantes de la Republica Dominicana.\n\nAdemás, el proceso del PNOT se desarrolla en un contexto en el cual las acciones de la comunidad internacional hasta 2030 están orientadas al logro de los Objetivos de Desarrollo Sostenible (ODS), centrados en la inclusión social, la sostenibilidad ambiental, la creación de empleo y trabajo decente, y el respeto de los derechos fundamentales de las personas.\n\nLas propuestas del PNOT son pautas para los planes de ordenamiento territorial y uso de suelo que se realicen en las escalas sub-nacionales y representa la expresión espacial en el territorio de los ejes estratégicos estipulados en términos sociales, económicos y ambientales.\n\nDicho plan aborda tres ejes prioritarios: \n1. Asentamientos humanos: referido a la calidad del hábitat y a la relación asentamiento humano- territorio.\n2. Protección y gestión del medioambiente: desarrollado considerando los distintos tipos de comportamiento que se experimentan en la relación sociedad-naturaleza.\n3. Competitividad y cohesión territorial: referida al logro de una estructura básica productiva articulada al mercado local y la economía global. Además al acceso de oportunidades de la población en el territorio, basado en la relación Estado- sociedad. \n\nAl mismo tiempo se plantean los siguientes ejes transversales:\na) Adaptación al Cambio Climático y Gestión de Riesgo\nb) Enfoque de Género\nc) Enfoque de Derechos Humanos\nd) Participación social","description_en":"The National Land Use Plan (PNOT) has been conceived as a policy document that guides national-level decisions regarding land use, aligning various sectoral policies with the aim of managing and utilizing resources to achieve sustainable development, promote territorial cohesion, and improve the living conditions of the population in the Dominican Republic.\n\nFurthermore, the PNOT process is being developed in a context where the actions of the international community through 2030 are geared toward achieving the Sustainable Development Goals (SDGs), focusing on social inclusion, environmental sustainability, job creation and decent work, and respect for fundamental human rights.\n\nThe proposals of the PNOT serve as guidelines for land use and planning initiatives at subnational levels and represent the spatial expression of the strategic pillars defined in social, economic, and environmental terms.\nThe plan addresses three priority areas:\n\n1. Human settlements: referring to the quality of habitat and the relationship between human settlements and territory.\n2. Environmental protection and management: developed with consideration of the different patterns of interaction between society and nature.\n3. Competitiveness and territorial cohesion: referring to the achievement of a basic productive structure linked to both the local market and the global economy, as well as to equitable access to opportunities across the territory, based on the relationship between the State and society.\n\nAt the same time, the following cross-cutting themes are proposed:\na) Climate Change Adaptation and Risk Management\nb) Gender Approach\nc) Human Rights-Based Approach\nd) Social Participation","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:ec684252-1431-49ce-9dc5-e5c75c4edb98","meta/deprecatedID":"uuid:972b0241-12f3-48d0-a109-34be245202e3","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ec684252-1431-49ce-9dc5-e5c75c4edb98","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:49","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ec684252-1431-49ce-9dc5-e5c75c4edb98"},{"_id":46398,"start":"2025-11-07T14:24:52.042-03:00","end":"2026-04-08T09:09:02.196-04:00","id_drupal":"100101","country":"arg","theme":"urban_development","original_language":"es","name_es":"Plan Nacional de Suelo Urbano","name_en":"National Urban Land Plan","responsible_institution":[{"responsible_institution/institution":"Ministerio del Interior de Argentina","responsible_institution/id_institution":"45297","responsible_institution/name_institution":"Ministerio del Interior de Argentina"}],"link":"3f241a30-c14d-462c-a2fa-97faaad3f4eb","primary_link":"https://www.argentina.gob.ar/sites/default/files/descripcion_del_pnasu.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Nacional de Suelo Urbano de Argentina busca ordenar el crecimiento urbano, generar lotes con servicios, garantizar acceso justo al suelo y facilitar políticas de vivienda, en coordinación con provincias y municipios. Sus ejes principales son:\n\n*1. Producción de lotes con servicios*\n• Financiar y apoyar a provincias y municipios para urbanizar tierras (abrir calles, dotar de agua, cloacas, electricidad, etc.).\n• Crear bancos de tierras urbanas.\n\n*2. Acceso equitativo al suelo*\n• Ofrecer lotes a familias a través de créditos o sorteos, con precios más bajos que en el mercado inmobiliario.\n• Promover la integración social y evitar la especulación del suelo.\n\n*3. Articulación con viviendas*\n• Complementarse con programas de construcción de viviendas como Procrear II y otras líneas habitacionales.\n\n*4. Desarrollo territorial sostenible*\n• Incentivar la planificación urbana, la expansión ordenada de las ciudades y el uso eficiente del suelo.\n• Favorecer ciudades más inclusivas, con criterios de equidad y sustentabilidad.","description_en":"The National Urban Land Plan of Argentina aims to regulate urban growth, generate serviced lots, ensure fair access to land, and facilitate housing policies in coordination with provinces and municipalities. Its main components are:\n\n*1. Production of serviced lots*\n• Finance and support provinces and municipalities in urbanizing land (opening streets, providing water, sanitation, electricity, etc.).\n• Create urban land banks.\n\n*2. Equitable access to land*\n• Offer lots to families through loans or lotteries, at prices lower than those of the real estate market.\n• Promote social integration and prevent land speculation.\n\n*3. Coordination with housing programs*\n• Complement housing construction programs such as Procrear II and other housing initiatives.\n\n*4. Sustainable territorial development*\n• Encourage urban planning, orderly city expansion, and efficient land use.\n• Promote more inclusive cities guided by principles of equity and sustainability.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_6 sdg_7 sdg_11","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:c957ceea-5612-4a9d-8a02-54ee0ff937f3","meta/deprecatedID":"uuid:4cbe5b23-a774-439f-ae99-cc95003ad8b8","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c957ceea-5612-4a9d-8a02-54ee0ff937f3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:51","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c957ceea-5612-4a9d-8a02-54ee0ff937f3"},{"_id":46399,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:52.756","end":"2025-11-07T14:24:52.756","id_drupal":"1003","country":"ecu","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción – Pastaza, Ecuador, 2024 – 2027","name_en":"First Action Plan – Pastaza, Ecuador, 2024 – 2027","responsible_institution":[{"responsible_institution/institution":"Gobierno Autónomo Descentralizado Provincial de Pastaza","responsible_institution/id_institution":"45471","responsible_institution/name_institution":"Gobierno Autónomo Descentralizado Provincial de Pastaza"}],"coordinator":"Proceso de cocreación multisectorial de Pastaza","id_coordinator":"45125","name_coordinator":"Proceso de cocreación multisectorial de Pastaza","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-pastaza-ecuador-2024-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Pastaza","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Primer Plan de Acción Local de Pastaza, Ecuador (2024-2027), marca la adhesión de la provincia a la iniciativa de Gobierno Abierto Local (OGP Local). El proceso fue liderado por el Gobierno Autónomo Descentralizado Provincial de Pastaza, con la participación activa de ciudadanía local, sociedad civil, academia, pueblos y nacionalidades indígenas, sector privado y técnicos de distintas áreas institucionales.\n\nDurante la etapa de cocreación se desarrollaron espacios participativos donde se identificaron problemáticas prioritarias y se formularon compromisos colaborativamente. El plan se orienta a fortalecer la transparencia institucional, mejorar la gestión ambiental y ampliar los canales de participación ciudadana en la provincia.\n\nAunque el plan no establece de forma explícita vínculos con los Objetivos de Desarrollo Sostenible (ODS), estos fueron enlazados metodológicamente por el ILPES.","description_en":"The First Local Action Plan of Pastaza, Ecuador (2024–2027) marks the province’s commitment to the Local Open Government Partnership (OGP Local) initiative. The process was led by the Decentralized Autonomous Provincial Government of Pastaza, with the active participation of local citizens, civil society, academia, Indigenous peoples and nationalities, the private sector, and professionals from various institutional areas.\n\nDuring the co-creation phase, participatory spaces were established to identify priority issues and collaboratively develop commitments. The plan aims to strengthen institutional transparency, improve environmental management, and expand citizen participation channels across the province.\n\nAlthough the plan does not explicitly reference the Sustainable Development Goals (SDGs), these were methodologically linked by ILPES as part of its support.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:644ecaf8-9571-48ea-a509-9cca54b87963","meta/deprecatedID":"uuid:d523c829-c9dc-4b2f-954c-606084b3548e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"644ecaf8-9571-48ea-a509-9cca54b87963","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:51","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:644ecaf8-9571-48ea-a509-9cca54b87963"},{"_id":46400,"start":"2025-11-07T14:24:53.464-03:00","end":"2026-01-14T14:53:54.933-03:00","id_drupal":"10050","country":"dom","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversión Pública 2025-2028 de República Dominicana","name_en":"Multi-Year Public Investment Plan 2025-2028 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45267","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"link":"ddc36528-1ffe-4e4b-b500-621e8817cb1d","primary_link":"https://mepyd.gob.do/pnpip-2025-2028","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional Plurianual de Inversión Pública (PNPIP) 2025-2028 de la República Dominicana, elaborado por el Ministerio de Economía, Planificación y Desarrollo, establece la hoja de ruta de las inversiones públicas para el cuatrienio, en coherencia con la Estrategia Nacional de Desarrollo 2030 y el Plan Nacional Plurianual del Sector Público. El plan busca orientar los recursos hacia proyectos que fortalezcan la infraestructura del país, promuevan el acceso equitativo a servicios básicos y potencien la competitividad económica de manera sostenible.\n\nLas prioridades del PNPIP se concentran en sectores estratégicos como el transporte, con proyectos emblemáticos de ampliación y modernización del sistema de movilidad urbana; la educación, mediante la construcción y adecuación de planteles y centros de formación; y la vivienda y los servicios comunitarios, con iniciativas orientadas a mejorar la calidad de vida de la población y reducir las brechas sociales y territoriales. También se incluyen inversiones en salud, seguridad ciudadana y gestión ambiental, con el objetivo de garantizar un desarrollo más inclusivo y resiliente.\n\nEl plan incorpora además enfoques transversales que refuerzan su impacto, tales como la adaptación y mitigación frente al cambio climático, la igualdad de género y la equidad territorial, asegurando que los proyectos contribuyan tanto a la sostenibilidad ambiental como a la cohesión social. Asimismo, la priorización de las inversiones responde a criterios de impacto, pertinencia territorial y alineación con las políticas nacionales, asegurando que los recursos se orienten a proyectos de alto valor público y a los compromisos del país con la Agenda 2030 para el Desarrollo Sostenible.","description_en":"The National Multi-Year Public Investment Plan (PNPIP) 2025–2028 of the Dominican Republic, prepared by the Ministry of Economy, Planning and Development, sets the roadmap for public investments over the four-year period, in line with the National Development Strategy 2030 and the National Multi-Year Public Sector Plan. The plan seeks to direct resources toward projects that strengthen the country’s infrastructure, promote equitable access to basic services, and foster economic competitiveness in a sustainable manner.\n\nThe priorities of the PNPIP focus on strategic sectors such as transportation, with flagship projects for the expansion and modernization of the urban mobility system; education, through the construction and upgrading of schools and training centers; and housing and community services, with initiatives aimed at improving people’s quality of life and reducing social and territorial gaps. It also includes investments in health, citizen security, and environmental management, with the objective of ensuring more inclusive and resilient development.\n\nThe plan also incorporates cross-cutting approaches that enhance its impact, such as climate change adaptation and mitigation, gender equality, and territorial equity, ensuring that projects contribute both to environmental sustainability and to social cohesion. Furthermore, the prioritization of investments is based on criteria of impact, territorial relevance, and alignment with national policies, guaranteeing that resources are directed toward high public value projects and the country’s commitments to the 2030 Agenda for Sustainable Development.","linking_sdg_plans":"yes","sdg":"sdg_5 sdg_8 sdg_9 sdg_10 sdg_13","pip/pip_project_list":"yes","pip/pip_period":"multiannual","pip/pip_project_list_es":"El plan presenta la cartera completa de proyectos de inversión pública con cifras actualizadas de cantidad total de iniciativas (alrededor de 1,947 proyectos), diferenciando entre proyectos de arrastre (continuación de iniciativas existentes) y proyectos nuevos.","pip/pip_project_list_en":"The plan presents the complete portfolio of public investment projects, with updated figures on the total number of initiatives (around 1,947 projects), distinguishing between carryover projects (the continuation of existing initiatives) and new projects.","pip/pip_costing":"yes","pip/pip_costing_es":"El plan presenta la programación financiera completa de los proyectos por año del cuatrienio y detalla la inversión total programada (más de RD$ 537,399.69 millones según estimaciones estadísticas de programación).","pip/pip_costing_en":"The plan presents the complete financial programming of the projects for each year of the four-year period and details the total programmed investment (more than RD$ 537,399.69 million, according to statistical programming estimates).","pip/pip_budget":"yes","pip/pip_budget_es":"La programación por año y por condición presupuestaria (proyectos de arrastre y nuevos), así como la inversión total por sectores funcionales, demuestra que sí se asignan montos presupuestarios específicos por proyecto y por año","pip/pip_budget_en":"The annual programming by budgetary status (carryover and new projects), as well as the total investment by functional sectors, shows that specific budget allocations are indeed assigned per project and per year.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El plan incorpora distribución geográfica de la inversión pública, asignando recursos a provincias y regiones, con representación de montos por cada área territorial, lo que permite comprender la focalización territorial de la inversión.","pip/pip_territorialization_en":"The plan incorporates the geographic distribution of public investment, allocating resources to provinces and regions and presenting amounts for each territorial area, which makes it possible to understand the territorial targeting of investment.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"El PNPIP 2025-2028 incorpora una metodología específica para priorizar proyectos dentro de la cartera de inversión pública, definida con criterios y subcriterios técnicos que permiten jerarquizar los proyectos con mayor valor público en función de su alineación con objetivos de desarrollo, atributos del proyecto y aspectos territoriales o socioeconómicos.\n\nLa priorización se aplica sobre la demanda de recursos de los proyectos registrados en el Sistema Nacional de Inversión Pública (SNIP), generando un orden descendente según la puntuación de cada proyecto y determinando cuáles son prioritarios para recibir financiamiento en el cuatrienio.","pip/pip_priorization_en":"The PNPIP 2025–2028 incorporates a specific methodology for prioritizing projects within the public investment portfolio, defined through technical criteria and subcriteria that make it possible to rank projects with the highest public value based on their alignment with development objectives, project attributes, and territorial or socioeconomic considerations.\n\nThis prioritization is applied to the resource demands of projects registered in the National Public Investment System (SNIP), producing a descending ranking according to each project’s score and determining which projects are prioritized for financing over the four-year period.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan de Inversión 2025 de República Dominicana","link_block/plan_id":"46391","link_block/plan_name":"Plan de Inversión 2025 de República Dominicana"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Plurianual de Inversión Pública 2023-2026 de República Dominicana","link_block/plan_id":"46616","link_block/plan_name":"Plan Plurianual de Inversión Pública 2023-2026 de República Dominicana"},{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de República Dominicana","link_block/snip_id":"46763","link_block/snip_name":"Sistema Nacional de Inversión Pública de República Dominicana"}],"meta/instanceID":"uuid:eae1bceb-2aa8-4d5c-b1a2-ed449c42ef8d","meta/deprecatedID":"uuid:a023222a-0272-4a23-a08a-d4b3b93ef496","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"eae1bceb-2aa8-4d5c-b1a2-ed449c42ef8d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:eae1bceb-2aa8-4d5c-b1a2-ed449c42ef8d"},{"_id":46401,"start":"2025-11-07T14:24:54.188-03:00","end":"2025-12-30T09:00:43.101-03:00","id_drupal":"1237","country":"col","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversiones 2018-2022 de Colombia","name_en":"Multi-Year Investment Plan 2018-2022 of Colombia","responsible_institution":[{"responsible_institution/institution":"Subdirección de Inversiones, Seguimiento y Evaluación","responsible_institution/id_institution":"45380","responsible_institution/name_institution":"Subdirección de Inversiones, Seguimiento y Evaluación"}],"link":"4784a511-c3e4-42bc-9c1c-b391427f72f8","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"medium_term","description_es":"El Plan Plurianual de Inversiones 2018-2022 es el documento que incorpora los proyectos de inversión que son considerados prioritarios para alcanzar las metas del Plan Nacional de Desarrollo (PND). El plan es elaborado por el Departamento Nacional de Planeación de acuerdo con lo establecido en la Ley 152 de 1994. Dentro del plan se estiman montos de inversión por sector, por región, por departamento y por cada uno de los pactos (ejes estratégicos) del PND. La inversión pública proyectada incluye recursos del Presupuesto General de la Nacional, de los territorios (Gobiernos departamentales y locales) y del sector privado. Otra particularidad es que dentro del documento se incluye también el Plan Plurianual de Inversiones para la Paz, conteniendo un listado de proyectos que contribuyen al restablecimiento de la paz a ejecutarse en en territorios específicos. El listado general de proyectos se divide por regiones y tipo de proyectos (estructurados, en estructuración y regionales), a su vez hay una segmentación por cada uno de los \"Pactos\" (ejes estratégicos) del PND. A nivel individual no se indican montos de inversión por proyecto o fuente de financiamiento.","description_en":"The 2018-2022 Multiannual Investment Plan is the document that incorporates investment projects considered a priority to achieve the goals of the National Development Plan (PND). The plan is prepared by the National Planning Department in accordance with the provisions of Law 152 of 1994. Within the plan, investment amounts are estimated by sector, region, department, and for each of the PND’s strategic axes (pacts). The projected public investment includes resources from the National General Budget, from territorial governments (departmental and local governments), and from the private sector. Another feature is that the document also includes the Multiannual Investment Plan for Peace, which contains a list of projects contributing to the restoration of peace to be implemented in specific territories. The general project list is divided by regions and project types (structured, under structuring, and regional), and there is segmentation by each of the PND’s \"Pacts\" (strategic axes). At the individual level, investment amounts per project or funding source are not provided.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El listado de proyectos está estructurado por regiones y presenta 3 tipos de proyectos: Proyectos estructurados, proyectos en proceso de estructuración y proyectos regionales.","pip/pip_project_list_en":"The list of projects is structured by regions and presents three types of projects: structured projects, projects in the process of being structured, and regional projects.","pip/pip_period":"multiannual","pip/pip_costing":"no","pip/pip_budget":"yes","pip/pip_budget_es":"Los montos de inversión contemplados en el plan son indicativos.","pip/pip_budget_en":"The investment amounts contemplated in the plan are indicative.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El Plan Plurianual de Inversiones identifica claramente los montos que se invertirán por regiones y departamentos. A su vez, el anexo con el listado completo de los proyectos se encuentra dividido por regiones.","pip/pip_territorialization_en":"The Multiannual Investment Plan clearly identifies the amounts to be invested by regions and departments. In addition, the annex containing the complete list of projects is organized by regions.","pip/pip_indicators":"no","pip/pip_priorization":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley No. 152 Orgánica del Plan de Desarrollo de Colombia","link_block/legal_id":"49391","link_block/legal_name":"Ley No. 152 Orgánica del Plan de Desarrollo de Colombia"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:0b3d2f94-a205-4856-ae7a-e69e013e9205","meta/deprecatedID":"uuid:7eb1c12e-e50d-4f56-a74c-240c3154e62c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0b3d2f94-a205-4856-ae7a-e69e013e9205","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0b3d2f94-a205-4856-ae7a-e69e013e9205"},{"_id":46402,"start":"2025-11-07T14:24:54.900-03:00","end":"2025-12-30T12:41:10.183-03:00","id_drupal":"1372","country":"dom","theme":"public_investment","original_language":"es","name_es":"Marco Plurianual de Inversión Pública 2021-2024 de República Dominicana","name_en":"Multi-Year Public Investment Framework 2021-2024 of the Dominican Republic","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45267","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"link":"497702e0-19d9-4fc8-8182-66e7f7e38cc8","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Plurianual Nacional del Sector Público 2021-2024 contiene el \"Marco plurianual de inversión pública\" y su elaboración está a cargo del Dirección General de Inversión Pública adscrita al Ministerio de Economía, Planificación y Desarrollo, de acuerdo con lo establecido en la Ley 498-06 y Ley 1-12. Este documento con horizonte de 4 años, contiene los proyectos de inversión más relevantes distribuidos de acuerdo a los ejes estratégicos a los que pertenecen.\n\nEste Marco presenta una distribución del gasto de inversión pública por política priorizada del Programa de Gobierno, 2021-2024","description_en":"The 2021–2024 National Multiannual Public Sector Plan contains the \"Multiannual Public Investment Framework\", and its preparation is the responsibility of the General Directorate of Public Investment under the Ministry of Economy, Planning and Development, in accordance with Laws 498-06 and 1-12. This four-year framework includes the most relevant investment projects, distributed according to their corresponding strategic axes.\nThis framework presents a distribution of public investment expenditure by prioritized policies of the Government Program, 2021–2024.","linking_sdg_plans":"yes","pip/pip_project_list":"no","pip/pip_period":"multiannual","pip/pip_costing":"no","pip/pip_budget":"yes","pip/pip_budget_es":"El Marco presenta la distribución del gasto de inversión pública por política priorizada del Programa de Gobierno, 2021-2024","pip/pip_budget_en":"The Framework presents the distribution of public investment expenditure by prioritized policy of the Government Program, 2021–2024.","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"El gasto de inversión pública esperado para el periodo se orienta hacia: 1) políticas orientadas a incrementar la capacidad productiva de los diferentes agentes (transporte, energía), y 2) políticas que hacen énfasis en la prestación de servicios sociales (vivienda, agua, educación, salud). En total, las seis políticas previamente mencionadas concentran aproximadamente el 86 % de la inversión pública esperada durante el cuatrienio.","pip/pip_priorization_en":"Expected public investment expenditure for the period is directed toward: (1) policies aimed at increasing the productive capacity of different agents (transport, energy), and (2) policies that emphasize the provision of social services (housing, water, education, health). In total, the six policies mentioned above account for approximately 86% of the public investment expected over the four-year period.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de República Dominicana","link_block/snip_id":"46763","link_block/snip_name":"Sistema Nacional de Inversión Pública de República Dominicana"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley No. 498 de Planificación e Inversión Pública de República Dominicana","link_block/legal_id":"49412","link_block/legal_name":"Ley No. 498 de Planificación e Inversión Pública de República Dominicana"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley No. 1-12 de Estrategia Nacional de Desarrollo 2030 de República Dominicana","link_block/legal_id":"49415","link_block/legal_name":"Ley No. 1-12 de Estrategia Nacional de Desarrollo 2030 de República Dominicana"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:24a46c1d-7917-4629-992c-1e19ba117491","meta/deprecatedID":"uuid:4763a6ed-3e0c-4b50-8315-bedf1a70c5d9","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"24a46c1d-7917-4629-992c-1e19ba117491","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:54","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:24a46c1d-7917-4629-992c-1e19ba117491"},{"_id":46403,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:55.714","end":"2025-11-07T14:24:55.714","id_drupal":"633","country":"slv","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de El Salvador (2016-2018)","name_en":"Third Open Government National Action Plan of El Salvador (2016–2018)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Participación, Transparencia y Anticorrupción (SPTA) de la Presidencia","responsible_institution/id_institution":"44993","responsible_institution/name_institution":"Secretaría de Participación, Transparencia y Anticorrupción (SPTA) de la Presidencia"}],"plan_number":"3","link":"67f0daaa-4b00-4668-8a3c-de0d97e14c68","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Quinquenal 2014-2019 del Gobierno de El Salvador, establece como uno de sus objetivos “Avanzar hacia la construcción de un Estado concertador, centrado en la ciudadanía y orientado en resultados”, para lo cual ha determinado que: \na) Promoverá la participación de la ciudadanía como protagonista en la gestión pública y la gobernabilidad democrática;\nb) Fortalecerá la transparencia, la lucha contra la corrupción y el ejercicio del derecho de acceso a información pública; y\nc) Construirá un gobierno con capacidad de planificar y gestionar el desarrollo y una administración pública profesional que garantice el acceso y la calidad en la prestación de bienes y servicios públicos.              \n\nLos compromisos del presenta plan de acción se enmarcan en las áreas de: transparencia, desarrollo económico y social, mejora de servicios públicos, medio ambiente sustentable, grupos vulnerables, transparencia en el sector privado, educación y participación ciudadana; áreas en las que cada una de las organizaciones miembros del Observatorio y las instituciones públicas tienen corresponsabilidad.\n\nDe la elaboración del plan participó una mesa de 25 organizaciones no gubernamentales, denominada “Observatorio de la Alianza para el Gobierno Abierto”, quienes se involucraron en la implementación y evaluación del plan 2014-2016 y que organizaron y sistematizaron consultas territoriales y especializadas. La Secretaría de Participación, Transparencia y Anticorrupción (SPTA), en conjunto con el Observatorio realizaron 10 talleres territoriales en nueve de departamentos del país; una consulta especializada con universidades, tanques de pensamiento y sector académico y un foro electrónico abierto al público en general, participando alrededor de 300 personas representantes de 150 organizaciones sociales, no gubernamentales y academia.","description_en":"The 2014–2019 Five-Year Government Plan of El Salvador establishes as one of its objectives: “To move toward building a consensus-based State, citizen-centered and results-oriented.” To achieve this, it sets out to:\n\na) Promote citizen participation as a central actor in public management and democratic governance;\nb) Strengthen transparency, the fight against corruption, and the exercise of the right to access public information; and\nc) Build a government capable of planning and managing development, as well as a professional public administration that ensures access to and quality in the provision of public goods and services.\n\nThe commitments in this action plan fall within the areas of: transparency, economic and social development, improvement of public services, environmental sustainability, vulnerable groups, private sector transparency, education, and citizen participation. These are areas in which both the member organizations of the Observatory and public institutions share responsibility.\n\nThe development of the plan involved a working group of 25 non-governmental organizations called the “Open Government Partnership Observatory,” which had also participated in the implementation and evaluation of the 2014–2016 plan. This group organized and systematized both territorial and specialized consultations. The Secretariat for Participation, Transparency and Anti-Corruption (SPTA), together with the Observatory, carried out 10 territorial workshops in nine departments of the country, one specialized consultation with universities, think tanks, and the academic sector, and an open online forum. Around 300 people participated, representing 150 social organizations, NGOs, and academic institutions.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b4f87e18-c833-41f5-ba2d-aa0f61e1da3a","meta/deprecatedID":"uuid:10a8a3de-678c-4ed5-ba85-dbd21e37efec","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b4f87e18-c833-41f5-ba2d-aa0f61e1da3a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:54","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b4f87e18-c833-41f5-ba2d-aa0f61e1da3a"},{"_id":46404,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:56.423","end":"2025-11-07T14:24:56.423","id_drupal":"1004","country":"ecu","theme":"open_government","original_language":"es","name_es":"Plan de acción – Pichincha, Ecuador, 2024 – 2027","name_en":"Action Plan – Pichincha, Ecuador, 2024 – 2027 ","responsible_institution":[{"responsible_institution/institution":"Gobierno Autónomo Descentralizado de la Provincia de Pichincha","responsible_institution/id_institution":"45054","responsible_institution/name_institution":"Gobierno Autónomo Descentralizado de la Provincia de Pichincha"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Pichincha","id_coordinator":"44991","name_coordinator":"Foro Multiactor de Gobierno Abierto de Pichincha","plan_number":"1","link":"4d7181bf-56d2-4b2a-9114-407603394349","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-pichincha-ecuador-2024-2027/\t\t\t\t\t","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Pichincha","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Primer Plan de Acción Local de Pichincha, Ecuador (2024-2027) marca el ingreso de la provincia a la iniciativa de Gobierno Abierto Local (OGP Local). El proceso de cocreación estuvo liderado por la Prefectura de Pichincha y se desarrolló en colaboración con organizaciones de la sociedad civil, sector privado, academia, instituciones públicas y ciudadanía en general.\n\nDurante esta etapa se llevaron a cabo talleres participativos donde se identificaron los principales desafíos locales y se formularon los compromisos del plan. El enfoque principal está en fortalecer los mecanismos de articulación intersectorial y desarrollar herramientas digitales de acceso a la información pública.\n\nAunque el plan no establece de forma explícita vínculos con los Objetivos de Desarrollo Sostenible (ODS), estos fueron enlazados metodológicamente por el ILPES.","description_en":"The First Local Action Plan of Pichincha, Ecuador (2024–2027) marks the province’s entry into the Open Government Partnership Local (OGP Local) initiative. The co-creation process was led by the Prefecture of Pichincha and carried out in collaboration with civil society organizations, the private sector, academia, public institutions, and the general public.\n\nDuring this phase, participatory workshops were held to identify key local challenges and formulate the plan’s commitments. The main focus is on strengthening intersectoral coordination mechanisms and developing digital tools for access to public information.\n\nAlthough the plan does not explicitly establish links with the Sustainable Development Goals (SDGs), these were methodologically aligned by ILPES.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b32ab8e9-e252-4053-b56b-f89ab0fe932a","meta/deprecatedID":"uuid:650cd032-441c-4dd5-9229-85f3a926c325","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b32ab8e9-e252-4053-b56b-f89ab0fe932a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:55","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b32ab8e9-e252-4053-b56b-f89ab0fe932a"},{"_id":46405,"start":"2025-11-07T14:24:57.147-03:00","end":"2025-12-30T12:26:49.885-03:00","id_drupal":"1835","country":"pan","theme":"public_investment","original_language":"es","name_es":"Plan Estratégico de Gobierno 2020-2024 - Plan Quinquenal Indicativo de Inversiones 2020-2024","name_en":"Five-Year Indicative Investment Plan 2020-2024 - Strategic Government Plan 2020-2024","responsible_institution":[{"responsible_institution/institution":"Dirección de Programación de Inversiones","responsible_institution/id_institution":"45375","responsible_institution/name_institution":"Dirección de Programación de Inversiones"}],"link":"3ffb42f6-83e1-4ddb-afd6-1d7a335aa753","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Quinquenal Indicativo de Inversiones 2020-2024 (PQI), está inserto dentro del Plan Estratégico de Gobierno 2019-2024. \n\nEl PQI detalla las iniciativas de inversión programadas por las entidades que conforman el Sector Público No Financiero. De acuerdo con el Artículo 16 de la Ley N° 34 de Responsabilidad Social Fiscal (LRSF) el PQI debe de ser actualizado anualmente. La elaboración y actualización del PQI es responsabilidad de la Dirección de Programación de Inversiones (DPI) del Ministerio de Economía y Finanzas (MEF). Dentro del PQI 2020-2024 se incluyen 125 proyectos y programas de inversión considerados como prioritarios, para cada uno de ellos se indica el nombre del proyecto, pilar estratégico al que contribuyen y entidad responsable de su ejecución.","description_en":"The Indicative Five-Year Investment Plan 2020–2024 (PQI) is part of the 2019–2024 Government Strategic Plan.\nThe PQI details investment initiatives programmed by entities comprising the Non-Financial Public Sector. According to Article 16 of Law No. 34 on Fiscal Social Responsibility (LRSF), the PQI must be updated annually.\nThe preparation and updating of the PQI is the responsibility of the Investment Programming Directorate (DPI) of the Ministry of Economy and Finance (MEF).\nThe 2020–2024 PQI includes 125 priority investment projects and programs. For each, the plan specifies the project name, the strategic pillar it contributes to, and the executing entity.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El Plan de Inversiones incorpora listados de proyectos. El listado de proyectos se divide en los cinco pilares estrategicos de la planificación nacional, que a su vez se dividen por areas estrategicas. Se incluye el nombre de las Acciones Proritarias y la intitución responsable de su ejecución.","pip/pip_project_list_en":"The Investment Plan includes lists of projects. The project list is organized around the five strategic pillars of national planning, which are in turn divided into strategic areas. The names of the Priority Actions and the institution responsible for their implementation are included.","pip/pip_period":"multiannual","pip/pip_costing":"no","pip/pip_budget":"no","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"Como parte del Plan Estratégico 2019-2024, el PQI es el resultado de un análisis tanto sectorial como territorial de las prioridades de Panamá. El listado de proyectos menciona la ubicación úbicación de algunos de los proyectos de inversión.","pip/pip_territorialization_en":"As part of the 2019–2024 Strategic Plan, the PQI is the result of both sectoral and territorial analyses of Panama’s priorities. The list of projects mentions the geographic location of some of the investment projects.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"Se menciona que los 125 proyectos en el Plan Quinquenal son considerados como prioritarios para el gobierno.","pip/pip_priorization_en":"It is stated that the 125 projects included in the Five-Year Plan are considered priorities for the government.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley No. 34 de Responsabilidad Fiscal de Panamá","link_block/legal_id":"49403","link_block/legal_name":"Ley No. 34 de Responsabilidad Fiscal de Panamá"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Estratégico de Gobierno 2019-2024 de Panamá","link_block/plan_id":"46596","link_block/plan_name":"Plan Estratégico de Gobierno 2019-2024 de Panamá"},{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de Panamá","link_block/snip_id":"46760","link_block/snip_name":"Sistema Nacional de Inversión Pública de Panamá"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:b9f5181b-6393-4328-8be8-e4d25e17831c","meta/deprecatedID":"uuid:0d0b4b82-1646-4dd2-a617-fe95d3387243","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b9f5181b-6393-4328-8be8-e4d25e17831c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:56","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b9f5181b-6393-4328-8be8-e4d25e17831c"},{"_id":46406,"start":"2025-11-07T14:24:57.855-04:00","end":"2026-04-06T12:55:14.977-04:00","id_drupal":"793","country":"pan","theme":"territorial_planning","original_language":"es","name_es":"Planes Regionales de Ordenamiento Territorial para el Desarrollo Urbano de Panamá","name_en":"Regional Land Use Plans for the Urban Development of Panama","responsible_institution":[{"responsible_institution/institution":"Dirección de Ordenamiento Territorial","responsible_institution/id_institution":"45266","responsible_institution/name_institution":"Dirección de Ordenamiento Territorial"}],"instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Regiones de Planificación","type_territorial_unit_en":"Planning Regions","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"El Plan Regional de Ordenamiento Territorial para el Desarrollo Urbano, establecido por la Ley No.6 de 2006 sobre el ordenamiento territorial para el desarrollo urbano, es el instrumento de planificación mediante el cual se regirá el desarrollo físico, ambiental, social y económico de un espacio definido como región por el Ministerio de Vivienda.\n\nDebe incorporar:\n\n1. Definición de las estrategias territoriales de uso, ocupación y manejo del suelo, en función de los objetivos económicos, sociales, urbanísticos y ambientales de la nación panameña;\n \n2. Diseño y adopción de los instrumentos y procedimientos de gestión y actuación, que permitan ejecutar actuaciones urbanas integrales y articular las actuaciones, por sector, que afecten la estructura del territorio.\n\nAdemás a un nivel general también se plantea que las actuaciones deberán atender las condiciones de diversidad étnica y cultural y el pluralismo. De la misma manera, incorporarán los instrumentos que permitan optimizar la utilización de los recursos naturales y humanos para el logro de condiciones de vida digna para la población actual y futura.\nAdicionalmente, estos planes deben contener disposiciones relativas a:\n\n1. Información estadística básica;\n \n2. Descripción de los usos del suelo;\n \n3. Clasificación del suelo urbano, rural y de expansión;\n \n4. Determinación de espacios abiertos y áreas de conservación;\n \n5. Trazo y jerarquía vial;\n \n6. Sistemas infraestructurales;\n \n7. Equipamientos básicos;\n \n8. Programa de inversiones para la ejecución;\n \n9. Conjuntos y monumentos históricos;\n \n10. Otros pertinentes.","description_en":"The Regional Land Use Plan for Urban Development, established by Law No. 6 of 2006 on land use planning for urban development, is the planning instrument that will govern the physical, environmental, social, and economic development of an area defined as a region by the Ministry of Housing.\nIt must include:\n\nDefinition of territorial strategies for land use, occupation, and management, in line with Panama’s goals;\n\nDesign and adoption of management and operational tools to implement comprehensive urban actions and coordinate sectoral interventions that affect the territory’s structure.\nAt a general level, actions must also consider ethnic and cultural diversity and pluralism. These plans must also include instruments to optimize the use of resources to ensure decent living conditions.\nAdditionally, the plans must contain provisions on:\n\nBasic statistical information;\n\nDescription of land uses;\n\nClassification of urban, rural, and expansion areas;\n\nDefinition of open spaces and conservation areas;\n\nRoad hierarchy and layout;\n\nInfrastructure systems;\n\nBasic public facilities;\n\nInvestment program for implementation;\n\nHistorical sites and monuments;\n\nOther relevant aspects.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:035784a6-c74f-45b0-a0d4-dfbd8244d7ac","meta/deprecatedID":"uuid:80587ce8-d8fd-4bd2-9e0f-c9ac1d86a822","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"035784a6-c74f-45b0-a0d4-dfbd8244d7ac","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:56","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:035784a6-c74f-45b0-a0d4-dfbd8244d7ac"},{"_id":46407,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:58.576","end":"2025-11-07T14:24:58.576","id_drupal":"591","country":"pry","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Paraguay (2012-2014)","name_en":"First National Open Government Action Plan of Paraguay (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","id_coordinator":"45441","name_coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","plan_number":"1","link":"e2d0db25-723b-49d9-85f1-029fe2221477","primary_link":"https://gobiernoabierto.gov.py/wp-content/uploads/2020/04/2do-Plan-de-Accion-Paraguay-espanol.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Plan se organiza en tres partes: \n1. Acciones previas para llegar a un Gobierno Abierto a partir del fortalecimiento del uso de las TICs; \n2. Acciones y compromisos en el marco de la Sociedad de Gobierno Abierto y; \n3. Consulta y diálogo con la sociedad civil.\n\nPara su formulación, se llevaron a cabo jornadas de consultas participativas, para presentar y debatir la propuesta diseñada previamente, pero sujeto a la mirada de la ciudadanía convocada. El objetivo fundamental de estas Jornadas fue instalar un espacio de diálogo, así como consultar y recibir propuestas tanto para otras acciones necesarias y para la generación de espacios de diálogos permanentes entre Estado y Sociedad Civil. De estas Jornadas participaron representantes y referentes de organizaciones de la sociedad civil, organizaciones ciudadanas, gremios profesionales y empresariales, exponentes del sector académico y universitario.","description_en":"The Plan is structured in three parts:\n1. Preliminary actions to achieve Open Government through enhanced use of ICTs\n2. Actions and commitments within the Open Government Society framework\n3. Consultation and dialogue with civil society\n\nIts formulation involved participatory consultation sessions where the preliminary proposal was presented for public feedback. The main goal of these sessions was to establish a space for dialogue and receive suggestions for further action and for the creation of permanent dialogue platforms between the State and civil society. These sessions were attended by representatives of civil society organizations, citizen groups, professional and business associations, and the academic and university sectors.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de mecanismo de revisión independiente de la alianza para el gobierno abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Paraguay_Final_2012_0_0.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b8772f8c-d5a0-41a4-be7b-d77b9ce5fa9c","meta/deprecatedID":"uuid:e3d0ece7-5fd9-44d0-914f-d8fcad5e0790","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b8772f8c-d5a0-41a4-be7b-d77b9ce5fa9c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:57","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b8772f8c-d5a0-41a4-be7b-d77b9ce5fa9c"},{"_id":46408,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:24:59.295","end":"2025-11-07T14:24:59.295","id_drupal":"644","country":"ury","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Uruguay (2014-2016)","name_en":"Second National Open Government Action Plan of Uruguay (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay","responsible_institution/id_institution":"45242","responsible_institution/name_institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","id_coordinator":"45001","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","plan_number":"2","link":"e1284d18-ba0b-4a87-be8e-02a91e216085","primary_link":"https://www.gub.uy/agencia-gobierno-electronico-sociedad-informacion-conocimiento/sites/agencia-gobierno-electronico-sociedad-informacion-conocimiento/files/2019-02/plan_accion_uruguay_2014-2016_f_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El presente Plan de Acción busca maximizar los esfuerzos del gobierno uruguayo hacia la apertura de información y de espacios participativos, así como promover en los ciudadanos la aprehensión de su nuevo rol.  \n\nLos compromisos de Plan se estructuran en 8 ejes: \n1)Promoción y desarrollo del Gobierno Abierto; \n2)Gobierno abierto para el desarrollo sectorial; \n3)Promoción del Derecho de Acceso a la Información Pública; \n4)De Datos Públicos a Datos Abiertos; \n5)Transparencia en las Compras y Gestión de los Recursos Públicos; \n6)Trámites y Servicios en línea; \n7)Servicios de Acercamiento a la Ciudadanía; \n8)Mejora de los Servicios al ciudadano en Gobiernos departamentales.\n\nEl plan surge como resultado de un proceso conducido por el gobierno, que contempló la participación de la academia y de actores de Sociedad Civil en diferentes instancias. AGESIC, en su rol de articulador, se planteó para el año 2014 mejorar los procesos de generación del Plan. Para lo cual implementó acciones como: ampliación del Grupo de Trabajo de Gobierno Abierto (incorporando representantes de la sociedad civil, de academia, de gobiernos departamentales y de la UNESCO como observador externo; consultas públicas y Mesas de Diálogo.","description_en":"The present Action Plan seeks to maximize the efforts of the Uruguayan government towards the opening of information and participatory spaces, as well as to encourage citizens to embrace their new role. \n\nThe commitments of the Plan are structured around 8 key areas: \n1) Promotion and development of Open Government; \n2) Open Government for sectoral development; \n3) Promotion of the Right to Access Public Information; \n4) From Public Data to Open Data; \n5) Transparency in Public Procurement and Resource Management; \n6) Online Procedures and Services; \n7) Services for Engaging with Citizens; \n8) Improvement of Citizen Services in Departmental Governments.\n\nThe plan emerged as a result of a process led by the government, which included the participation of academia and civil society actors at various stages. AGESIC, in its coordinating role, aimed to improve the processes of generating the Plan for the year 2014. To achieve this, it implemented actions such as: expanding the Open Government Working Group (incorporating representatives from civil society, academia, departmental governments, and UNESCO as an external observer); public consultations and Dialogue Tables.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://miradordegobiernoabierto.agesic.gub.uy/SigesVisualizador/gu/o/GA","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:7dbfa747-38f5-4ce9-8684-754345742ae3","meta/deprecatedID":"uuid:f531b468-f702-4fbe-b717-bc580bb6759d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7dbfa747-38f5-4ce9-8684-754345742ae3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:58","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7dbfa747-38f5-4ce9-8684-754345742ae3"},{"_id":46409,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:00.007","end":"2025-11-07T14:25:00.007","id_drupal":"631","country":"per","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Perú (2017-2019)","name_en":"Third National Open Government Action Plan of Peru (2017-2019)","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública","responsible_institution/id_institution":"45341","responsible_institution/name_institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Perú","id_coordinator":"45348","name_coordinator":"Foro Multiactor de Gobierno Abierto de Perú","plan_number":"3","link":"c57140c6-64fc-44e7-b6c0-89ec08df0ae2","primary_link":"https://cdn.www.gob.pe/uploads/document/file/3124218/III%20Plan%20de%20Acci%C3%B3n%20de%20Gobierno%20Abierto.pdf.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El presente Plan de Acción contiene compromisos en materia de seguridad ciudadana, educación, infraestructura, salud, saneamiento y ambiente. En este sentido se consideró un enfoque temático alineado con las prioridades del gobierno, las políticas nacionales y el plan estratégico de desarrollo nacional: \"Plan Bicentenario: Perú hacia el 2021\".\n\nPara la elaboración de este Plan se tomó en cuenta el trabajo desarrollado por organizaciones internacionales como CEPAL y la OCDE, y en particular, se vinculó los compromisos de acción con los Objetivos de Desarrollo Sostenible de la Agenda 2030.  \n\nAsimismo, para la elaboración de los compromisos se tuvo en cuenta situaciones que afectan severamente a algunas regiones del país. Como paso previo a la elaboración del Plan, la Secretaría de Gestión Pública de la Presidencia del Consejo de Ministros, desarrolló una consulta para contar con lecciones aprendidas en los procesos anteriores, de la misma participaron especialistas de la sociedad civil, academia y del sector público. La participación en la elaboración del Plan se canalizó a través de mesas temáticas, consultas públicas virtuales, talleres regionales y mesas nacionales. Se consideró la creación de foros multiactor (por temas/compromisos) para acompañar la implementación del plan y servir de base para la co-creación de los futuros planes de acción.","description_en":"This Action Plan includes commitments related to citizen security, education, infrastructure, health, sanitation, and the environment. It follows a thematic approach aligned with government priorities, national policies, and the strategic development plan: “Bicentennial Plan: Peru Towards 2021.”\n\nInternational organizations such as ECLAC and the OECD provided input for the plan’s formulation, and specific attention was paid to aligning action commitments with the Sustainable Development Goals (SDGs) of the 2030 Agenda.\n\nThe formulation process also took into account regional disparities. Before drafting the Plan, the Public Management Secretariat of the Presidency of the Council of Ministers conducted a consultation to collect lessons learned from previous processes. This consultation included civil society, academic experts, and public sector representatives. Participation was channeled through thematic working groups, virtual public consultations, regional workshops, and national forums. Multi-stakeholder forums (organized by theme/commitment) were proposed to support implementation and serve as a foundation for future co-creation efforts.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:8e619bd4-1e01-4365-beef-5956b0ff35d4","meta/deprecatedID":"uuid:0a89b25f-5a99-4e2a-b21f-9365ab3cfe29","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8e619bd4-1e01-4365-beef-5956b0ff35d4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:59","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8e619bd4-1e01-4365-beef-5956b0ff35d4"},{"_id":46410,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:00.726","end":"2025-11-07T14:25:00.726","id_drupal":"656","country":"hnd","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Honduras (2018-2020)","name_en":"Fourth National Open Government Action Plan of Honduras (2018-2020)","responsible_institution":[{"responsible_institution/institution":"Dirección General de Transparencia y Prevención de la Corrupción","responsible_institution/id_institution":"45252","responsible_institution/name_institution":"Dirección General de Transparencia y Prevención de la Corrupción"}],"coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","id_coordinator":"45152","name_coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","plan_number":"4","link":"4a976fa2-f754-4f8a-be5b-18e1449b1e67","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2018/08/Honduras_Action-Plan_2018-2020_ES_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El presente plan presenta un enfoque diferente al interior ya que no solo concentra sus esfuerzos en desarrollar acciones de gobierno abierto en la esfera del poder ejecutivo, sino que también se extendieron las medidas a los demás poderes del Estado, creando un plan del Estado abierto.\n\nPara ello se llevaron a cabo distintas etapas en nueve sectores principales del país, todo con el fin de convocar a los  distintos sectores de la sociedad, incluyendo ciudadanos, academia, y sector privado. Estas etapas se materializaron en la realización de notificación anticipada, primera etapa del proceso de co-creación, donde a través de la difusión de la iniciativa de consulta, tanto en medios presenciales como digitales, se buscó lograr una amplia convocatoria en instancias participativas, con la intención de generar una consulta pública basada en la participación de la ciudadanía. Una vez conformado el borrador del plan, se dispusieron instancias en línea en las jornadas de socialización, donde la ciudadanía pudo dar su opinión acerca de los compromisos. \n\nRespecto a los lineamientos generales del Plan, este incluye actividades relacionadas al fortalecimiento de las capacidades institucionales de las instituciones, tanto a través de la capacitación y entrenamiento de los funcionarios, como así también, a través de la modernización de canales de información y entrega de servicios, así como también a través del  desarrollo de instancias orientadas a sensibilizar a la población vulnerable.","description_en":"This plan presents a different approach as it not only focuses on developing open government actions within the executive branch but also extends measures to the other branches of government, creating a state-wide open government plan.\nFor this, various stages were carried out in nine main sectors of the country, all aimed at gathering different sectors of society, including citizens, academia, and the private sector. These stages materialized into early notification, the first phase of the co-creation process, where through the dissemination of the consultation initiative, both in-person and digital media, a broad call was made for participatory instances, with the intention of generating a public consultation based on citizen participation. Once the draft of the plan was created, online sessions were held during the socialization days, where citizens could give their opinion on the commitments.\n\nConcerning the general guidelines of the plan, it includes activities related to strengthening the institutional capacities of institutions, both through the training of public officials and the modernization of information channels and service delivery, as well as through the development of initiatives aimed at raising awareness among vulnerable populations.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de diseño del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2020/10/Honduras_Design_Report_2018-2020.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ddacd0b8-7aaa-46c7-99ae-3bc5fa4e41fb","meta/deprecatedID":"uuid:4c09951d-9a0b-4099-b01a-5254185d0118","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ddacd0b8-7aaa-46c7-99ae-3bc5fa4e41fb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:24:59","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ddacd0b8-7aaa-46c7-99ae-3bc5fa4e41fb"},{"_id":46411,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:01.452","end":"2025-11-07T14:25:01.452","id_drupal":"638","country":"col","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Colombia (2011-2013)","name_en":"First National Open Government Action Plan of Colombia (2011-2013)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Transparencia","responsible_institution/id_institution":"45340","responsible_institution/name_institution":"Secretaría de Transparencia"}],"coordinator":"Comité de Estado Abierto de Colombia","id_coordinator":"45149","name_coordinator":"Comité de Estado Abierto de Colombia","plan_number":"1","link":"18f6cf4e-4f58-4b41-8277-72165eb59476","primary_link":"https://drive.google.com/file/d/1-f4pThcY7lBmvaG0NcKRqtsBxLPSYWUs/view?pli=1","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2011-01-01","validity_applies_until":"yes","effective_until":"2013-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El primer Plan de Acción de Colombia, se basa en los principios del buen gobierno y busca mejorar los servicios prestados por las agencias públicas, alentar la participación civil, y promover el control en la ejecución de las políticas públicas.\n\nPara la definición del Plan de Acción, se creó un comité interinstitucional de seguimiento, coordinado por el Asesor Presidencial para el Buen Gobierno y la Eficiencia Administrativa. El Comité contó con la participación de la Secretaría de Transparencia de la Oficina del Presidente, el Programa de Gobierno Electrónico del Ministerio de Tecnologías de la Información y la Comunicación (\"Ministerio de TIC\"), el Departamento Nacional de Planeación (DNP) y el Ministerio de Gobierno.\nEl Comité también identificó oportunidades para socializar el Plan de Acción e involucrar a la sociedad en la construcción del documento a través de un foro en línea y Twitter, que planteó preguntas sobre temas tales como: información pública de interés general, los mejores mecanismos para alentar la participación, acciones que las Agencias gubernamentales deben implementar para mejorar la calidad de sus servicios, y las acciones en las que la comunidad estaría dispuesta a participar. Además de lo anterior, el Comité organizó un taller participativo con organizaciones de la sociedad civil, donde comentaron activamente el Plan de Acción, hicieron sugerencias y enriquecieron la versión inicial del documento.","description_en":"Colombia's first Action Plan is based on the principles of good governance and seeks to improve the services provided by public agencies, encourage civic participation, and promote oversight of public policy implementation. \n\nTo define the Action Plan, an interinstitutional monitoring committee was created, coordinated by the Presidential Advisor for Good Governance and Administrative Efficiency. The committee included the Transparency Secretariat of the President’s Office, the E-Government Program of the Ministry of ICT, the National Planning Department (DNP), and the Ministry of Government. The committee also identified opportunities to engage the public through an online forum and Twitter, asking questions on topics such as public interest information, effective participation mechanisms, and what actions agencies should take to improve services. Additionally, a participatory workshop with civil society organizations was held to discuss and enrich the draft Action Plan.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:85886717-04a1-4204-9d9a-e0d61f8e5edc","meta/deprecatedID":"uuid:5b75ef83-4166-4262-b8a3-839a2ce6f5ff","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"85886717-04a1-4204-9d9a-e0d61f8e5edc","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:00","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:85886717-04a1-4204-9d9a-e0d61f8e5edc"},{"_id":46412,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:02.175","end":"2025-11-07T14:25:02.175","id_drupal":"1007","country":"pan","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto Local de Chepo, Panamá (2024–2024)","name_en":"First Local Open Government Action Plan of Chepo, Panama (2024-2024)","responsible_institution":[{"responsible_institution/institution":"Alcaldía Municipal de Chepo","responsible_institution/id_institution":"45283","responsible_institution/name_institution":"Alcaldía Municipal de Chepo"}],"coordinator":"Proceso de cocreación multisectorial del Municipio de Chepo","id_coordinator":"45321","name_coordinator":"Proceso de cocreación multisectorial del Municipio de Chepo","plan_number":"1","primary_link":"https://www.opengovpartnership.org/documents/action-plan-chepo-panama-2024-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Chepo","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Primer Plan de Acción Local de Chepo, Panamá (2024–2024), marca la adhesión del distrito a la iniciativa de Gobierno Abierto Local (OGP Local). El proceso fue liderado por la Alcaldía Municipal de Chepo, con la participación activa de ciudadanía local, sociedad civil, sector privado y técnicos de distintas áreas institucionales.\n\nDurante la etapa de cocreación se desarrollaron espacios participativos donde se identificaron problemáticas prioritarias y se formularon compromisos colaborativamente. El plan se orienta a fortalecer la transparencia institucional, mejorar la gestión pública y ampliar los canales de participación ciudadana en el distrito.","description_en":"The First Local Action Plan of Chepo, Panama (2024–2024) marks the district’s adherence to the Local Open Government Partnership initiative (OGP Local). The process was led by the Municipal Government of Chepo, with the active participation of local citizens, civil society, the private sector, and technical experts from various institutional areas.\n\nDuring the co-creation phase, participatory spaces were developed to identify priority issues and collaboratively formulate commitments. The plan aims to strengthen institutional transparency, improve public management, and expand citizen participation channels in the district.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f2884916-6364-4cec-8cfb-829b08755f41","meta/deprecatedID":"uuid:6ea5c4be-4462-4f41-bc3c-ffb65b3f07cc","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f2884916-6364-4cec-8cfb-829b08755f41","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f2884916-6364-4cec-8cfb-829b08755f41"},{"_id":46413,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:02.907","end":"2025-11-07T14:25:02.907","id_drupal":"1008","country":"ury","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción – Montevideo, Uruguay, 2023 – 2025","name_en":"First Action Plan - Montevideo, Uruguay, 2023 - 2025","responsible_institution":[{"responsible_institution/institution":"Intendencia Municipal de Montevideo","responsible_institution/id_institution":"45251","responsible_institution/name_institution":"Intendencia Municipal de Montevideo"}],"coordinator":"Proceso de cocreación multisectorial de Montevideo","id_coordinator":"45067","name_coordinator":"Proceso de cocreación multisectorial de Montevideo","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-montevideo-uruguay-2023-2025/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Montevideo","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Primer Plan de Acción Local de Montevideo, Uruguay (2023–2025), marca la adhesión de la ciudad a la iniciativa de Gobierno Abierto Local (OGP Local). El proceso fue liderado por la Intendencia de Montevideo, con la participación activa de ciudadanía local, sociedad civil, academia, sector privado y técnicos de distintas áreas institucionales.\n\nDurante la etapa de cocreación se desarrollaron espacios participativos donde se identificaron problemáticas prioritarias y se formularon compromisos colaborativamente. El plan se orienta a fortalecer la transparencia institucional, mejorar la gestión cultural y ambiental, y ampliar los canales de participación ciudadana en la ciudad.","description_en":"The First Local Action Plan of Montevideo, Uruguay (2023–2025) marks the city’s commitment to the Local Open Government Partnership (OGP Local) initiative. The process was led by the Municipality of Montevideo, with the active participation of local citizens, civil society, academia, the private sector, and professionals from various institutional areas.\n\nDuring the co-creation phase, participatory spaces were developed to identify priority issues and collaboratively formulate commitments. The plan aims to strengthen institutional transparency, improve cultural and environmental management, and expand citizen participation channels in the city.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:5d0cdee5-74e4-4187-92a7-b1b9fa45e30a","meta/deprecatedID":"uuid:1dc60d20-e670-4602-bffd-1b3314f248d1","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5d0cdee5-74e4-4187-92a7-b1b9fa45e30a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:02","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:5d0cdee5-74e4-4187-92a7-b1b9fa45e30a"},{"_id":46414,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:03.660","end":"2025-11-07T14:25:03.660","id_drupal":"1006","country":"hnd","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Villanueva Cortés, Honduras, 2025 – 2025","name_en":"First Action Plan of Villanueva Cortés, Honduras, 2025 - 2025","responsible_institution":[{"responsible_institution/institution":"Alcaldía Municipal de Villanueva, Cortés","responsible_institution/id_institution":"45087","responsible_institution/name_institution":"Alcaldía Municipal de Villanueva, Cortés"}],"coordinator":"Proceso de cocreación multisectorial de Villanueva, Cortés","id_coordinator":"45194","name_coordinator":"Proceso de cocreación multisectorial de Villanueva, Cortés","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-villanueva-honduras-2025-2025/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Villanueva Cortés","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Primer Plan de Acción Local de Villanueva Cortés, Honduras (2025-2025) marca el inicio del municipio en la Alianza para el Gobierno Abierto (AGA). El proceso de cocreación contó con la participación de organizaciones de la sociedad civil, sector privado, academia, instituciones públicas y ciudadanía en general.\n\nDurante la etapa de cocreación, se realizaron sesiones de trabajo y talleres para identificar problemáticas locales prioritarias y formular soluciones de forma colaborativa. Estos espacios permitieron la consolidación de los compromisos incluidos en el plan, centrados en mejorar la transparencia, fortalecer la participación ciudadana y facilitar el acceso a la información pública en Villanueva.\n\nAunque el plan no establece de forma explícita vínculos con los Objetivos de Desarrollo Sostenible (ODS), estos fueron enlazados metodológicamente por el ILPES.","description_en":"The First Local Action Plan of Villanueva Cortés, Honduras (2025–2025) marks the municipality’s entry into the Open Government Partnership (OGP). The co-creation process involved the participation of civil society organizations, the private sector, academia, public institutions, and the general public.\n\nDuring the co-creation phase, working sessions and workshops were held to identify local priority issues and collaboratively develop solutions. These spaces enabled the consolidation of the commitments included in the plan, which focus on improving transparency, strengthening citizen participation, and facilitating access to public information in Villanueva.\n\nAlthough the plan does not explicitly reference the Sustainable Development Goals (SDGs), these were methodologically linked by ILPES.\n\n¿Quieres que prepare una versión más breve para redes o un resumen ejecutivo?\n\n\n\n\n\n\n\n\n\n","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:557c0b95-e378-4ec7-a718-4ed856fea46e","meta/deprecatedID":"uuid:863b0b37-81cc-47fc-892f-278fa6113a68","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"557c0b95-e378-4ec7-a718-4ed856fea46e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:02","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:557c0b95-e378-4ec7-a718-4ed856fea46e"},{"_id":46415,"start":"2025-11-07T14:25:04.389-04:00","end":"2026-04-06T12:58:37.626-04:00","id_drupal":"893","country":"guy","theme":"territorial_planning","original_language":"en","name_es":"Plan Nacional de Uso de la Tierra de Guyana (2013)","name_en":"Guyana National Land Use Plan (2013)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Recursos Naturales y Medio Ambiente de Guyana","responsible_institution/id_institution":"45203","responsible_institution/name_institution":"Ministerio de Recursos Naturales y Medio Ambiente de Guyana"}],"link":"2ecc7f7d-d426-4301-b232-3c2d00dfd35f","primary_link":"https://glsc.gov.gy/wp-content/uploads/2017/05/National-Land-Use-Plan-Final-Oct-2013.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2063-01-01","effective_today":"yes","temporality":"long_term","description_es":"El principal objetivo del Plan Nacional de Uso del Suelo (NLUP) es proporcionar un marco estratégico que guíe el desarrollo del suelo en Guyana. En este sentido, el NLUP se basa en diversas políticas y estrategias nacionales que tienen una relación directa con el uso y la gestión del suelo. Uno de sus objetivos principales es permitir que los recursos financieros se orienten hacia usos óptimos del suelo a nivel regional. Con este propósito, el NLUP ha sido elaborado a partir de una política de promoción activa del uso múltiple del suelo.\n\nEl NLUP no es prescriptivo, ya que no pretende zonificar áreas del país para usos específicos del suelo, sino más bien sugerir una serie de opciones para áreas particulares que sirvan como guía para los responsables de la toma de decisiones y que atraigan inversiones. En línea con lo anterior, otro objetivo del NLUP es incorporar un componente espacial a la planificación del desarrollo, de modo que se muestre, en un solo mapa o en una serie de mapas, la situación actual, la ubicación de los recursos, dónde existe potencial y qué conexiones podrían ser necesarias para desarrollar dichos recursos.","description_en":"The primary objective of the National Land Use Plan (NLUP) is to provide a strategic framework to guide land development in Guyana. As such the NLUP is built upon a number of national policies and strategies that have a direct relevance for land use and land management. A main objective of the NLUP is to enable financial resources to be targeted at optimal land uses at the regional level. To this regard, the NLUP has been compiled from a policy of active promotion of multiple land use. \n\nThe NLUP is not prescriptive in that it does not aim to zone areas of the country for particular land uses, rather it aims to suggest a number of options for particular areas that can then guide decision-makers and attract inward investment. In conjunction with the above, a further aim of the NLUP is to provide a spatial element to development planning, to show on one map, or a series of maps, what the current situation is, where resources are located, where potential exists and what linkages may be necessary to develop those resources.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:e08fd643-95cc-4666-91a5-2f89ee570ab2","meta/deprecatedID":"uuid:09371bb5-ec5c-4154-adda-8a99f26d76d4","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e08fd643-95cc-4666-91a5-2f89ee570ab2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e08fd643-95cc-4666-91a5-2f89ee570ab2"},{"_id":46416,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:05.176","end":"2025-11-07T14:25:05.176","id_drupal":"2300","country":"gtm","theme":"open_government","original_language":"es","name_es":"Sexto Plan de Acción Nacional de Gobierno Abierto de Guatemala (2023-2025)","name_en":"Sixth National Open Government Action Plan of Guatemala (2023-2025)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"44996","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"6","link":"5d1a20c4-4c66-4016-9f80-3cb7ba588e58","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2023/08/Guatemala_Action-Plan_2023-2025_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El proceso de cocreación del 6to Plan de Acción incluyó reuniones del Comité Técnico de Gobierno Abierto para la definición de las temáticas de los compromisos, reuniones entre las organizaciones de la sociedad civil y las instituciones públicas para validar dichas temáticas y mesas de cocreación de compromisos e hitos del plan. También recibieron orientaciones por parte de la Alianza para el Gobierno Abierto y el Mecanismo de Revisión Independiente.","description_en":"The co-creation process of the 6th Action Plan included meetings of the Technical Committee for Open Government to define the topics of the commitments, meetings between civil society organizations and public institutions to validate those topics, and co-creation tables for commitments and milestones of the plan. They also received guidance from the Open Government Partnership and the Independent Review Mechanism.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://gobiernoabierto.transparencia.gob.gt/tablero6pan/","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:723321f0-bfbf-4d73-b2bf-5565c68804d8","meta/deprecatedID":"uuid:6cd06882-cb18-4c00-88ed-8668ece3d795","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"723321f0-bfbf-4d73-b2bf-5565c68804d8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:04","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:723321f0-bfbf-4d73-b2bf-5565c68804d8"},{"_id":46417,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:05.896","end":"2025-11-07T14:25:05.896","id_drupal":"2295","country":"chl","theme":"open_government","original_language":"es","name_es":"Primer Plan de Gobierno Abierto de San Joaquín (2024)","name_en":"First Open Government Plan of San Joaquín (2024)","responsible_institution":[{"responsible_institution/institution":"Municipalidad de San Joaquín","responsible_institution/id_institution":"45106","responsible_institution/name_institution":"Municipalidad de San Joaquín"}],"plan_number":"1","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Comuna de San Joaquín","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","visible_description":"yes","description_es":"El proceso de cocreación del Primer Plan de Acción de la Municipalidad de San Joaquín de Chile comenzó con la coordinación y capacitación interna de las unidades y corporaciones municipales, mediante jornadas de sensibilización. Luego, el COnsejo de la Sociedad Civil de San Joaquín (COSOC) priorizó las temáticas de mujer y emprendimiento, seguridad y salud, con la finalidad de crear propuestas en torno a los pilares de gobierno abierto. En conjunto con la gestión local, se definió trabajar también en iniciativas de transparencia proactiva.\n\nEn la primera instancia participativa, junto con representantes del COSOC, se convocó a dirigentes de organizaciones comunales ligadas a las temáticas priorizadas. En esta jornada, se elaboraon diagnósticos sobre las principales necesidades e inquietudes respecto a las temáticas de trabajo, proponiendo ideas e iniciativas preliminares respecto al gobierno abierto municipal. En esta jornada, se contó con la participación de 24 organizaciones comunales.\n\nDespués, se realizaron nuevos encuentros participativos, con la finalidad de profundizar en los resultados de la primera jornada y elaborar propuestas de gobierno abierto que se someterán a consulta ciudadana. En estos espacios, participaron 38 organizaciones comunales. La consulta ciudadana se realizó a través de la plataforma San Joaquín Decide y puntos presenciales de votación.","description_en":"The co-creation process of the First Action Plan of the Municipality of San Joaquín in Chile began with internal coordination and training of municipal units and corporations through awareness workshops. The San Joaquín Civil Society Council (COSOC) prioritized the themes of women and entrepreneurship, safety, and health to generate proposals aligned with open government principles. In collaboration with local management, it was also decided to work on proactive transparency initiatives. In the first participatory session, together with COSOC representatives, leaders of community organizations linked to the prioritized topics were invited. In this session, diagnostics were made on the main needs and concerns, proposing preliminary ideas and initiatives on municipal open government. This session involved 24 community organizations. Later, further participatory meetings were held to deepen the outcomes of the first session and develop open government proposals to be submitted to public consultation. These meetings involved 38 community organizations. The citizen consultation was conducted through the \"San Joaquín Decide\" platform and in-person voting points.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2fcbed60-32a1-4a10-97fb-62381d34b62c","meta/deprecatedID":"uuid:cc9e0d46-86c0-4c11-a7ee-705dbf8c4355","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2fcbed60-32a1-4a10-97fb-62381d34b62c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:04","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2fcbed60-32a1-4a10-97fb-62381d34b62c"},{"_id":46418,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:06.624","end":"2025-11-07T14:25:06.624","id_drupal":"1668","country":"chl","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción de Gobierno Abierto de Chile (2020-2022)","name_en":"Fifth Open Government Action Plan of Chile (2020-2022)","responsible_institution":[{"responsible_institution/institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile","responsible_institution/id_institution":"45342","responsible_institution/name_institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile"}],"coordinator":"Mesa Nacional de Estado Abierto de Chile","id_coordinator":"45154","name_coordinator":"Mesa Nacional de Estado Abierto de Chile","plan_number":"5","link":"01c9139b-21c7-4ff3-89c1-559ccff33d9e","primary_link":"https://www.ogp.gob.cl/wp-content/uploads/2021/05/CHILE-5to-plan-de-accio%CC%81n-mayo2021.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El proceso de cocreación del Quinto Plan de Acción de Gobierno Abierto se enfrentó al estallido social de octubre de 2019, lo que implicó un cambio social y político profundo. Por ende, los distintos organismos públicos han adaptado su quehacer institucional a una nueva mirada centrada en los ciudadanos y sus necesidades. El estallido social también implicó una sensación de necedidad de un cambio profundo en todo el país, profundizando en acciones para reducir la desigualdad y avanzar hacia una sociedad más inclusiva. Sumado al estallido social, el proceso de cocreación del plan estuvo inmerso en la crisis sanitaria del COVID-19. En efecto, todo el proceso se vio afectado por estas dos circunstancias. \n\nDesde agosto de 2020 la Mesa de Gobierno Abierto y la Comisión de Integridad Pública y Transparencia del Ministerio Secretaría General de la Presidencia asumieron el desafío de la cocreación del quinto Plan de Acción. En el proceso se incluyeron instancias de difusión y sensibilización en Gobierno Abierto, una colaboración y trabajo en red, espacios de participación virtuales, trazabilidad y rendición de cuentas, involucramiento de la sociedad civil y academia y un avance hacia un Estado Abierto. ","description_en":"The co-creation process of the Fifth Open Government Action Plan faced the social unrest of October 2019, which marked a deep social and political shift. As a result, various public agencies adapted their institutional practices to a new citizen-centered approach. The unrest also reflected a collective sense of the need for profound change nationwide, prompting deeper actions to reduce inequality and move toward a more inclusive society. In addition to the social upheaval, the plan’s co-creation process unfolded during the COVID-19 health crisis. Indeed, the entire process was impacted by these two major events.\n\nSince August 2020, the Open Government Roundtable and the Public Integrity and Transparency Commission of the Ministry General Secretariat of the Presidency took on the challenge of co-creating the Fifth Action Plan. The process included awareness and outreach activities on Open Government, collaboration and networking, virtual participation spaces, traceability and accountability mechanisms, and the involvement of civil society and academia in the advancement toward an Open State.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://www.ogp.gob.cl/panel-de-seguimiento/","pga/pga_mechanism_text_es":"Informe de revisión del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_text_en":"Chile Results Report 2020-2022 - For Public Comment - Independent Reporting Mechanism ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/09/Chile_Action-Plan-Review_2020-2022.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0ee7f6c4-4175-40c0-acce-18ee3aeb4bef","meta/deprecatedID":"uuid:0c3ff90d-2609-475e-9100-d2b28c9c3d89","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0ee7f6c4-4175-40c0-acce-18ee3aeb4bef","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0ee7f6c4-4175-40c0-acce-18ee3aeb4bef"},{"_id":46419,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:07.748","end":"2025-11-07T14:25:07.749","id_drupal":"2297","country":"chl","theme":"open_government","original_language":"es","name_es":"Sexto Plan de Acción Nacional de Estado Abierto de Chile (2023-2027)","name_en":"Sixth Open Government Action Plan of Chile (2023-2027)","responsible_institution":[{"responsible_institution/institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile","responsible_institution/id_institution":"45342","responsible_institution/name_institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile"}],"coordinator":"Mesa Nacional de Estado Abierto de Chile","id_coordinator":"45154","name_coordinator":"Mesa Nacional de Estado Abierto de Chile","plan_number":"6","link":"29121a23-caf0-4bd2-8221-5da08334a769","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2024/01/Chile_Action-Plan_2023-2027_December.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El proceso de cocreación del Sexto Plan de Acción de Estado Abierto de Chile se distribuyó en las siguientes etapas: talleres de Estado abierto, consulta ciudadana y mapeo del sector público, mesas de cocreación, mesas de redacción de compromisos, Foro Ampliado de Estado Abierto, y la entrega oficial del plan. En total, se realizaron 16 mesas de cocreación, siendo 11 virtuales y 5 presenciales.","description_en":"The co-creation process of Chile’s Sixth Open State Action Plan was carried out in the following stages: open state workshops, public consultation and public sector mapping, co-creation tables, commitment drafting tables, Expanded Open State Forum, and the official delivery of the plan. In total, 16 co-creation tables were held—11 virtual and 5 in person.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://www.ogp.gob.cl/panel-de-seguimiento/","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1b6e6e42-a704-45ec-8a9f-47b9443d1bcd","meta/deprecatedID":"uuid:bd501f74-f592-4fb2-8fb1-87d718367842","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1b6e6e42-a704-45ec-8a9f-47b9443d1bcd","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1b6e6e42-a704-45ec-8a9f-47b9443d1bcd"},{"_id":46420,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:08.622","end":"2025-11-07T14:25:08.622","id_drupal":"2299","country":"cri","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción Nacional de Estado Abierto de Costa Rica (2023-2027)","name_en":"Fifth National Open Government Action Plan of Costa Rica (2023-2027)","responsible_institution":[{"responsible_institution/institution":"Coordinación de Gobierno Abierto ","responsible_institution/id_institution":"45438","responsible_institution/name_institution":"Coordinación de Gobierno Abierto "}],"coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","id_coordinator":"45439","name_coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","plan_number":"5","link":"adbc4205-e58d-4d9a-ada6-644fa181fd28","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2023/12/Costa-Rica_Action-Plan_2023-2027_December.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El proceso de cocreación del V Plan de Acción tuvo un enfoque de solución de problemas y se estructuró en cuatro etapas principales: preparación y planificación; convocatoria y divulgación; cocreación; y redacción técnica del compromiso de cada área temática. En la etapa de cocreación, se realizaron 4  talleres nacionales presenciales, en los cuales participaron 72 personas, una consulta ciudadana y talleres con personas especialistas.\n\nEste plan se encuentra vinculado a la Agenda 2030 para el Desarrollo Sostenible.","description_en":"The co-creation process for the Fifth Action Plan had a problem-solving focus and was structured in four main stages: preparation and planning; call and dissemination; co-creation; and technical drafting of each thematic area’s commitment. During the co-creation stage, 4 national in-person workshops were held, with 72 participants, along with a citizen consultation and specialist workshops. This plan is linked to the 2030 Agenda for Sustainable Development.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f07ce636-3a02-477e-828b-5d4ddc4a5888","meta/deprecatedID":"uuid:6692a243-e0d7-4803-a1a1-4fb683341f17","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f07ce636-3a02-477e-828b-5d4ddc4a5888","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f07ce636-3a02-477e-828b-5d4ddc4a5888"},{"_id":46421,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:09.333","end":"2025-11-07T14:25:09.333","id_drupal":"642","country":"chl","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Chile (2016-2018)","name_en":"Third National Open Government Action Plan of Chile (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile","responsible_institution/id_institution":"45342","responsible_institution/name_institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile"}],"coordinator":"Mesa Nacional de Estado Abierto de Chile","id_coordinator":"45154","name_coordinator":"Mesa Nacional de Estado Abierto de Chile","plan_number":"3","link":"22f88830-9298-4e61-928d-1dbe13b7bfe8","primary_link":"https://www.ogp.gob.cl/wp-content/uploads/2019/09/Plan-de-Accion-2016-2018-Chile-Oficial.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El proceso de construcción y desarrollo de este Plan contó con cuatro etapas: Priorización de temas; Discusión en mesas de trabajo temáticas; Selección de propuestas y redacción del plan de acción y; Proceso de consulta.\n\nPriorización: una vez acordado un cronograma de acción conjunta, se procedió a un ejercicio de priorización, para definir las áreas temáticas para la presentación de potenciales compromisos. Del acuerdo entre sociedad civil y gobierno se acordaron 5 ejes principales, los cuales se sometieron a votación en línea por parte de sociedad civil. Mientras que por parte de gobierno, se realizó un proceso de levantamiento de propuestas entre los servicios y organismos públicos vía oficio.\nDiscusión en mesas de trabajo temáticas: estas consistieron en una instancia de discusión de las propuestas levantadas en la etapa anterior en formato de mesas de trabajo dividas en las cinco áreas temáticas.\nSelección de propuestas y redacción del plan de acción: el gobierno en conjunto con la Mesa Permanente OGP realizaron un trabajo de revisión de las propuestas presentadas, dando prioridad a aquellas que fueron evaluadas positivamente en las mesas de trabajo, con el fin de incorporarlas al Tercer Plan de Acción.\nProceso de consulta: una vez elaboradas y revisadas todas las fichas de compromisos, el borrador de Plan de Acción fue sometido a consulta pública en línea.\n\nEl plan cuenta con compromisos en diversas áreas temáticas: recursos naturales y medio ambiente; políticas sociales y educacionales; modernización del Estado, transparencia e integridad pública; implementación de la Alianza para el Gobierno Abierto.","description_en":"The construction and development process of this Plan followed four stages: Topic prioritization; Discussion in thematic working groups; Proposal selection and drafting of the action plan; and Consultation process.\n\nPrioritization: Once a joint action schedule was agreed upon, a prioritization exercise was conducted to define the thematic areas for potential commitments. Five main axes were agreed upon by civil society and government, which were then submitted to an online vote by civil society. Meanwhile, the government carried out a proposal-gathering process among public services and agencies via formal correspondence. Discussion in thematic working groups: These consisted of reviewing the proposals collected in the previous stage through discussion tables divided into the five thematic areas. Proposal selection and action plan drafting: The government, together with the Permanent OGP Table, reviewed the submitted proposals, prioritizing those evaluated positively in the working groups, in order to include them in the Third Action Plan. Consultation process: Once all commitment drafts had been prepared and reviewed, the draft Action Plan was submitted to an online public consultation. \n\nThe plan includes commitments in various thematic areas: natural resources and the environment; social and educational policies; state modernization, transparency, and public integrity; and implementation of the Open Government Partnership.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0531072b-eaeb-4364-ba72-010fa35186d2","meta/deprecatedID":"uuid:1cdc0e5b-a333-4895-913f-906374caaf27","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0531072b-eaeb-4364-ba72-010fa35186d2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:08","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0531072b-eaeb-4364-ba72-010fa35186d2"},{"_id":46422,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:10.067","end":"2025-11-07T14:25:10.067","id_drupal":"623","country":"gtm","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Guatemala (2014-2016)","name_en":"Second National Open Government Action Plan of Guatemala (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"44996","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"2","link":"7fd93dbe-b65a-44cf-9b52-d5183d175bda","primary_link":"https://gobiernoabierto.transparencia.gob.gt/wp-content/uploads/SEGUNDO-PLAN-DE-ACCION-GUATEMALA-2014-2016.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El proceso de desarrollo del Segundo Plan de Acción de Gobierno Abierto de Guatemala 2014-2016 se efectuó priorizando las necesidades que el Gobierno y la sociedad civil necesitaban mejorar en pro de la transparencia y lucha Contra la Corrupción. Durante su período de implementación, este plan fue actualizado, aumentando el número de compromisos. Para elaborar el plan, se convocó a una mesa de trabajo a las Organizaciones de la Sociedad Civil que trabajan en la Iniciativa de Gobierno Abierto.","description_en":"The development of the Second Open Government Action Plan (2014-2016) prioritized the needs of both the government and civil society in improving transparency and fighting corruption. During its implementation period, the plan was updated, with additional commitments. A working group was convened, including civil society organizations working on Open Government initiatives.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Guatemala14-15_IRM_Spanish_Final_0.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:a386f272-c14b-4f11-bfc9-bd5d42e192f3","meta/deprecatedID":"uuid:45771ab0-d5ac-408c-b91f-394fe5d93066","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a386f272-c14b-4f11-bfc9-bd5d42e192f3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a386f272-c14b-4f11-bfc9-bd5d42e192f3"},{"_id":46423,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:10.802","end":"2025-11-07T14:25:10.802","id_drupal":"658","country":"dom","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción de Gobierno Abierto de República Dominicana (2018-2020)","name_en":"Fourth Open Government Action Plan of the Dominican Republic (2018-2020)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana","responsible_institution/id_institution":"45523","responsible_institution/name_institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana"}],"coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","id_coordinator":"44999","name_coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","plan_number":"4","link":"6215fdde-c864-4a0f-9769-260240e8a2cc","primary_link":"https://gobiernoabierto.gob.do/wp-content/uploads/2021/12/Cuarto-Plan-de-Accion.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El proceso de diseño del Cuarto Plan de Acción de Gobierno Abierto de República Dominicana, se conformó a través del desarrollo de consultas públicas, las cuales se desarrollaron en dos etapas, orientadas a  crear instancias colaborativas en conjunto con el sector público, el sector privado y la sociedad civil. En primer lugar, se difundió y sensibilizo acerca de las actividades participativas en redes sociales, portales de Gobierno Abierto, y correo electrónico, donde se comunicó la realización de las consultas públicas presenciales y virtuales.\n\nEn segundo lugar, se realizaron 10 mesas de mesas de trabajo interactivas a través de todo el territorio nacional, donde los distintos actores pudieron manifestar sus propuestas a las autoridades, conformando así el estado de situación de las principales necesidades y prioridades del país, destacándose acciones orientadas a trabajar en salud, educación, tecnología, infraestructura, entre otras. Fueron convocadas autoridades de los distintos niveles de gobierno locales y sectoriales.\n\nRespecto a los compromisos acordados estos apuntan principalmente a fortalecer la prestación de servicios públicos, a través del fortalecimiento de capacidades públicas en materias de rendición de cuentas y fomento a la participación.","description_en":"The design process for the Fourth Open Government Action Plan of the Dominican Republic involved public consultations in two stages, aimed at creating collaborative spaces with the public, private sectors, and civil society. First, there was dissemination and awareness-raising of participatory activities through social media, Open Government portals, and email, where the public was informed about the in-person and virtual consultations. Second, 10 interactive working groups were held across the country, where various actors expressed their proposals to authorities, forming the current situation on the country’s main needs and priorities, with actions related to health, education, technology, infrastructure, and more. Authorities from various levels of government and sectoral authorities were invited. The commitments mainly aim to strengthen public service delivery through enhanced public accountability and promotion of participation.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de diseño del Mecanismo de Revisión Independiente","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/07/Dominican-Republic_Design_Report_2018-2020.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:17b497fb-af1a-456d-a20e-e7826dcef87a","meta/deprecatedID":"uuid:afd0f5a7-c7a1-466a-aebb-8ce552dab3cd","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"17b497fb-af1a-456d-a20e-e7826dcef87a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:17b497fb-af1a-456d-a20e-e7826dcef87a"},{"_id":46424,"start":"2025-11-07T14:25:11.515-03:00","end":"2025-12-30T12:07:35.218-03:00","id_drupal":"1238","country":"slv","theme":"public_investment","original_language":"es","name_es":"Programa Anual de Inversión Pública (PAIP) 2021 de El Salvador","name_en":"Annual Public Investment Program (PAIP) 2021 of El Salvador","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión y Crédito Público","responsible_institution/id_institution":"45211","responsible_institution/name_institution":"Dirección General de Inversión y Crédito Público"}],"link":"5b8c4c8a-d2ae-443a-956f-1112e3e33fc0","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Programa Anual de Inversión Pública es un instrumento de planeación elaborado por la Dirección General de Inversión y Crédito Público tomando como referencia la programación plurianual de presupuesto, de acuerdo con lo establecido en la Ley Orgánica de Administración Financiera (Ley AFI). Si bien este no es de acceso público, en su lugar se pueden consultar los avances mensuales del mismo en el portal del Ministerio de Hacienda. En los informes de avance se puede conocer el progreso de la ejecución del presupuesto de inversión desagregado por fuente de financiamiento, sector, entidad ejecutora y proyecto de inversión. También se puede consultar la lista completa de proyectos en ejecución donde se detalla el monto total de inversión (en dólares americanos), el monto programado y ejecutado para el mes que se reporta y el porcentaje de avance en ejecución financiera acumulado.","description_en":"The Annual Public Investment Program is a planning instrument prepared by the General Directorate of Investment and Public Credit based on the multiannual budget programming, in accordance with the Organic Law of Financial Administration (AFI Law).\nAlthough this document is not publicly available, monthly progress reports can be accessed on the Ministry of Finance’s website.\nThese reports show the progress of investment budget execution, disaggregated by source of financing, sector, executing entity, and investment project. They also include a complete list of ongoing projects, detailing the total investment amount (in US dollars), the amount programmed and executed for the reported month, and the cumulative financial execution progress percentage.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El listado de de proyectos se divide por institución ejecutora, muestra el código de proyecto, nombre, monto programado anual (dólares americanos), monto ejecutado durante el mes reportado y porcentaje de ejecución del presupuesto total acumulado.","pip/pip_project_list_en":"The list of projects is divided by executing institution and shows the project code, name, annual programmed amount (US dollars), amount executed during the reported month, and the percentage of execution of the total cumulative budget.","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_costing_es":"Muestra el costeo para cada uno de los proyectos de inversión","pip/pip_costing_en":"It shows the costing for each of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con presupuesto asignado.","pip/pip_budget_en":"The investment projects included in the plan have an allocated budget.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"Se menciona la ubicación geográfica en el listado de proyectos.","pip/pip_territorialization_en":"The geographic location is mentioned in the list of projects.","pip/pip_indicators":"no","pip/pip_priorization":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"actor","link_block/actor_link":"Ministerio de Hacienda de El Salvador","link_block/actor_id":"45052","link_block/actor_name":"Ministerio de Hacienda de El Salvador"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:6954166b-296a-4fe6-a01e-89440c7e9c13","meta/deprecatedID":"uuid:7990087e-a18c-424c-a710-3d8b29122e26","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6954166b-296a-4fe6-a01e-89440c7e9c13","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:6954166b-296a-4fe6-a01e-89440c7e9c13"},{"_id":46425,"start":"2025-11-07T14:25:12.332-03:00","end":"2025-12-30T12:11:16.978-03:00","id_drupal":"1239","country":"gtm","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública 2023 de Guatemala","name_en":"Public Investment Program 2023 of Guatemala","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Inversión para el Desarrollo","responsible_institution/id_institution":"45216","responsible_institution/name_institution":"Subsecretaría de Inversión para el Desarrollo"}],"link":"20a84e4b-c3eb-4f90-b43e-c87bcb453fd3","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","description_es":"El Programa de Inversión Pública (PIP) es elaborado anualmente por la Subsecretaría de Inversión para el Desarrollo de la SEGEPLAN, de acuerdo con lo establecido en la Ley Orgánica del Presupuesto y su Reglamento. \n\nEl PIP para el Ejercicio Fiscal 2023, constituye el documento descriptivo que presenta el registro de los proyectos de las entidades públicas de inversión del Estado, distribuidas sectorial y geográficamente, los cuales fueron priorizados a través de un conjunto de criterios técnicamente establecidos. El PIP incluye información sobre ejecución de gasto del gobierno y ambiente macroeconómico en el país, detalla la vinculación de la inversión pública con el Plan Nacional de Desarrollo 2032, la distribución de la inversión pública de acuerdo con los lineamientos de la Política General de Gobierno 2020-2024. \n\nEl listado de proyectos de inversión se muestra desagregado por Entidades del Gobierno Central, Empresas Públicas no Financieras Nacionales, y Consejos Departamentales con datos generales (Nombre de proyecto, unidad ejecutora, monto programado anual y monto programado total).","description_en":"The Public Investment Program (PIP) is prepared annually by the Investment for Development Undersecretariat of SEGEPLAN, in accordance with the provisions of the Organic Budget Law and its Regulations.\nThe PIP for Fiscal Year 2023 is the descriptive document that presents the record of projects from public investment entities of the State, distributed by sector and geography, prioritized through a set of technically established criteria. The PIP includes information on government spending execution and the country’s macroeconomic environment. It also details the alignment of public investment with the 2032 National Development Plan, and the distribution of public investment in line with the 2020–2024 General Government Policy.\nThe list of investment projects is broken down by Central Government Entities, National Non-Financial Public Enterprises, and Departmental Councils, including general data (project name, executing unit, annual programmed amount, and total programmed amount).","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"Se especifica el número de proyectos por sector, el nombre completo del proyecto, su ubicación geográfica por departamento y entidad ejecutora.","pip/pip_project_list_en":"The number of projects by sector is specified, along with the full project name, its geographic location by department, and the executing entity.","pip/pip_period":"annual","pip/pip_costing":"yes","pip/pip_costing_es":"El Plan de Inversiones muestra el costeo total individual de los proyectos de inversión.","pip/pip_costing_en":"The Investment Plan shows the total individual costing of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos de inversión incluidos en el plan cuentan con presupuesto asignado.","pip/pip_budget_en":"The investment projects included in the plan have an allocated budget.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El Programa de Inversión analiza la inversión pública por territorio, así también muestra la ubicación geográfica de los proyectos de inversión.","pip/pip_territorialization_en":"The Investment Program analyzes public investment by territory and also shows the geographic location of the investment projects.","pip/pip_indicators":"yes","pip/pip_indicators_es":"Las estrategias nacionales/ sectoriales incluyen indicadores de producto.","pip/pip_indicators_en":"The national/sectoral strategies include output indicators.","pip/pip_priorization":"yes","pip/pip_priorization_es":"Los proyectos son priorizados de acuerdo con los lineamientos de la Política General de Gobierno, el Plan Nacional de Desarrollo y las Prioridades Nacionales de Desarrollo.","pip/pip_priorization_en":"Projects are prioritized in accordance with the guidelines of the General Government Policy, the National Development Plan, and the National Development Priorities.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Nacional de Desarrollo: Katun Nuestra Guatemala 2032","link_block/plan_id":"46572","link_block/plan_name":"Plan Nacional de Desarrollo: Katun Nuestra Guatemala 2032"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:d88a5d87-0b76-4a8d-976b-2d85c1487980","meta/deprecatedID":"uuid:e7ff6fe5-8e66-4e5a-ae77-098a0fcdff1d","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d88a5d87-0b76-4a8d-976b-2d85c1487980","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:11","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d88a5d87-0b76-4a8d-976b-2d85c1487980"},{"_id":46426,"start":"2025-11-07T14:25:13.046-03:00","end":"2025-12-30T12:22:56.873-03:00","id_drupal":"1370","country":"nic","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública 2023 (y proyección a 2026) de Nicaragua","name_en":"Public Investment Program 2023 (and projection to 2026) of Nicaragua","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversión Pública","responsible_institution/id_institution":"45267","responsible_institution/name_institution":"Dirección General de Inversión Pública"}],"instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Programa de Inversión Pública es uno de los instrumentos de planificación más importantes del gobierno de Nicaragua, ya que permite llevar a la práctica las políticas, los planes y programas de gobierno, con el fin de alcanzar los objetivos y metas de mediano y largo plazo que ha propuesto al país. Para asegurar una alta calidad de la inversión pública, la Dirección General de Inversiones Públicas como ente rector promueve y apoya en un proceso contínuo, a los equipos profesionales y técnicos del SNIP en los ministerios, instituciones públicas y gobiernos locales que cumplen funciones de inversión pública, con el objeto de desarrollar en conjunto y eficazmente las tareas estratégicas que le son encomendadas.\n\nEl Programa de Inversión Pública es elaborado por la Dirección General de Inversión Pública, de acuerdo con lo establecido en la Ley 550. Este documento se incorpora como anexo a la Ley de Presupuesto de Nicaragua.\n\nLa programación multianual de 2023 a 2026 lista los proyectos por institución y los montos asignados para cada año. Además, para el año 2023 se detalla cada proyecto con sus obras asociadas, por institución, sector, departamento y municipio según fuentes de financiamiento tanto para recursos internos como externos.","description_en":"The Public Investment Program is one of the most important planning instruments of the Nicaraguan government, as it enables the implementation of policies, plans, and government programs to achieve the medium- and long-term goals and objectives proposed for the country.\nTo ensure high-quality public investment, the General Directorate of Public Investments, as the governing body, continuously promotes and supports professional and technical teams of the SNIP in ministries, public institutions, and local governments responsible for public investment. The aim is to jointly and effectively carry out the strategic tasks assigned.\nThe Public Investment Program is prepared by the General Directorate of Public Investment, in accordance with Law 550. This document is annexed to Nicaragua’s Budget Law.\nThe multiannual programming for 2023 to 2026 lists projects by institution and the amounts allocated per year. Additionally, for 2023, each project is detailed with its associated works by institution, sector, department, and municipality, according to sources of financing (domestic and external).","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El listado permite conocer el nombre del proyecto, entidad responsable, fuente de financiamiento y el presupuesto programado para cada uno de los años que comprende el programa.","pip/pip_project_list_en":"The list makes it possible to identify the project name, the responsible entity, the source of financing, and the budget programmed for each of the years covered by the program.","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_costing_es":"El programa detalla el costeo individual de los proyectos de inversión.","pip/pip_costing_en":"The program details the individual costing of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"El programa de inversión contempla presupuesto asignado para el primer año y proyectado para los años subsecuentes.","pip/pip_budget_en":"The investment program includes an allocated budget for the first year and projected budgets for subsequent years.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"Es posible conocer los proyectos y monto de inversión de los mismos por departamento y municipalidad, así como la entidad responsable del proyecto.","pip/pip_territorialization_en":"It is possible to identify the projects and their investment amounts by department and municipality, as well as the entity responsible for each project.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"Sí, todos los proyectos en el programa de inversión fueron previamente considerados como priorizados. En 2023, la Política de Inversión Pública estará enfocada en elevar la eficiencia, el rendimiento e impacto de la inversión pública en el crecimiento económico y la reducción de la pobreza, incorporando iniciativas de inversión con criterios de reducción de riesgos a desastres y adaptación sustentable e inclusiva a la variabilidad climática y el cambio climático.","pip/pip_priorization_en":"Yes, all projects in the investment program were previously considered and prioritized. In 2023, the Public Investment Policy will focus on increasing the efficiency, performance, and impact of public investment on economic growth and poverty reduction, incorporating investment initiatives with disaster risk reduction criteria and sustainable and inclusive adaptation to climate variability and climate change.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley 550 de Administración Financiera y del Régimen Presupuestario de Nicaragua","link_block/legal_id":"49695","link_block/legal_name":"Ley 550 de Administración Financiera y del Régimen Presupuestario de Nicaragua"},{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de Nicaragua","link_block/snip_id":"46759","link_block/snip_name":"Sistema Nacional de Inversión Pública de Nicaragua"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:2b6b621d-b542-4de1-aad5-c8004e0eeb06","meta/deprecatedID":"uuid:9f424db8-2615-4d6d-9734-82f085084354","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2b6b621d-b542-4de1-aad5-c8004e0eeb06","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2b6b621d-b542-4de1-aad5-c8004e0eeb06"},{"_id":46427,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:13.773","end":"2025-11-07T14:25:13.773","id_drupal":"1765","country":"arg","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción Nacional de Gobierno Abierto de Argentina (2022-2024)","name_en":"Fifth National Open Government Action Plan of Argentina (2022-2024)","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital","responsible_institution/id_institution":"45339","responsible_institution/name_institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital"}],"coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","id_coordinator":"45146","name_coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","plan_number":"5","link":"41cd45df-7a18-442c-80aa-f7a1a34398fd","primary_link":"https://www.argentina.gob.ar/sites/default/files/quinto_plan_de_accion_nacional_de_gobierno_abierto_2022-2024.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Quinto Plan de Acción contiene 7 compromisos que buscan implementar políticas transformadoras que aborden problemas públicas. Se incluyen temáticas como: desinstitucionalización y la inclusión social de personas con padecimiento mental; participación pública en temas ambientales; acceso a la información en salud; género y desigualdades.\n\nEl Quinto Plan de Acción es resultado de un trabajo colaborativo, liderado por la Mesa Nacional de Gobierno Abierto. Participaron más de 320 personas de 18 provincias. Fomraron parte 30 organizaciones de la sociedad civil y 6 áreas del Estado Nacional. Se realizaron talleres participativos para identificar los principales desafíos en las temáticas acordadas. También, se recibieron propuestas ciudadanas con soluciones a esos desafíos plantreados y se desarrollaron encuentros de diálogo en el cual los organismos responsables recibieron feedback sobre los compromisos formulados por parte de la ciudadanía. A su vez, se potenció la participación federal, mediante reuniones en formato digital. Por último, para potenciar la participación ciudadana en la implementación del plan (se había encontrado que para el Cuarto Plan, la participación ciudadana fue más alta durante la cocreación del plan que en la implementación), se incorporó un componente participativo en todos los compromisos.","description_en":"The Fifth Action Plan contains 7 commitments aimed at implementing transformative policies that address public issues. Topics include: deinstitutionalization and social inclusion of people with mental health conditions; public participation in environmental issues; access to health information; gender and inequalities.\n\nThe Fifth Action Plan is the result of collaborative work led by the National Open Government Roundtable. Over 320 people from 18 provinces participated. Thirty civil society organizations and six national government areas were involved. Participatory workshops were held to identify the main challenges in the agreed-upon topics. Citizen proposals with solutions to those challenges were received, and dialogue sessions were held where the responsible agencies received feedback on the formulated commitments from the public. Federal participation was also enhanced through digital meetings. Finally, to strengthen citizen involvement in the plan’s implementation (as it had been found that during the Fourth Plan, citizen participation was higher during co-creation than during implementation), a participatory component was added to all commitments.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Último informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto (Revisión del Plan de Acción 2022-2024)","pga/pga_mechanism_text_en":"Latest report of the Open Government Partnership Independent Review Mechanism (Action Plan Review 2022-2024)","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2023/11/Argentina_Action-Plan-Review_2022-2024.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2eb45784-c9ae-4046-8ae8-0b8cb6f5b2ca","meta/deprecatedID":"uuid:91027a95-45bd-4dc2-bd0c-10d11d4d8351","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2eb45784-c9ae-4046-8ae8-0b8cb6f5b2ca","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2eb45784-c9ae-4046-8ae8-0b8cb6f5b2ca"},{"_id":46428,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:14.498","end":"2025-11-07T14:25:14.498","id_drupal":"1874","country":"hnd","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción de Estado Abierto de Honduras (2023-2025)","name_en":"Fifth Open Government Action Plan of Honduras (2023-2025) ","responsible_institution":[{"responsible_institution/institution":"Dirección General de Transparencia y Prevención de la Corrupción","responsible_institution/id_institution":"45252","responsible_institution/name_institution":"Dirección General de Transparencia y Prevención de la Corrupción"}],"coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","id_coordinator":"45152","name_coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","plan_number":"5","link":"2ed785eb-63aa-401c-bec5-561a2d4f9c56","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2023/08/Honduras_Action-Plan_2023-2025_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Quinto Plan de Acción de Honduras se cocreó con un enfoque territorial en los 18 departamentos del país, para priorizar la voz y acción ciudadana y asegurar la representatividad de la diversidad de los actores del país. El plan está compuesto por compromisos priorizados de la agenda pública del país y está alineado con otros instrumentos como la Agenda 2030 para el Desarrollo Sostenible, el Plan de Gobierno Bicentenario 2022-2026, el Mecanismo de Examen de la Convención de las Naciones Unidas contra la Corrupción (UNCAC), la Estrategia Nacional de Transparencia y Anticorrupción de Honduras (ENTAH), el Compromiso de Lima: Gobernabilidad Democrática frente a la Corrupción, entre otros.\n\nEl plan contó con la participación de más de 4.000 personas, para culminar con el establecimiento de 14 compromisos y 57 hitos. Para cocrear el plan, se inició con la planificación y desarrollo de 3 jornadas esenciales: sensibilización; consulta oficial; socialización/validación. Se contó con la participación de 14 sectores nacionales y se visitaron los 18 departamentos del país.","description_en":"The Fifth Action Plan of Honduras was co-created with a territorial approach in the 18 departments of the country, to prioritize citizen voice and action and ensure the representativeness of the country’s diverse actors. The plan is composed of prioritized commitments from the country’s public agenda and is aligned with other instruments such as the 2030 Agenda for Sustainable Development, the Bicentennial Government Plan 2022-2026, the United Nations Convention Against Corruption Review Mechanism (UNCAC), the National Strategy for Transparency and Anti-Corruption of Honduras (ENTAH), the Lima Commitment: Democratic Governance Against Corruption, among others.\nThe plan included the participation of more than 4,000 people, resulting in the establishment of 14 commitments and 57 milestones. To co-create the plan, three essential stages were carried out: awareness-raising; official consultation; and socialization/validation. Fourteen national sectors participated, and all 18 departments of the country were visited.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de resultados de transición de Honduras 2018-2021 del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2023/04/Honduras_Transitional-Results-Report_2018-2021.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:4b5daccf-d024-46ee-af9e-cfcad375509b","meta/deprecatedID":"uuid:12214c82-f5c1-4e5d-81c0-e4573fd98d86","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4b5daccf-d024-46ee-af9e-cfcad375509b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:13","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4b5daccf-d024-46ee-af9e-cfcad375509b"},{"_id":46429,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:15.228","end":"2025-11-07T14:25:15.228","id_drupal":"1690","country":"ury","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción Nacional de Gobierno Abierto de Uruguay (2021-2024)","name_en":"Fifth National Open Government Action Plan of Uruguay (2021-2024)","responsible_institution":[{"responsible_institution/institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay","responsible_institution/id_institution":"45242","responsible_institution/name_institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","id_coordinator":"45001","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","plan_number":"5","link":"1eee808c-2a08-4018-8770-ba6975e2a713","primary_link":"https://www.gub.uy/agencia-gobierno-electronico-sociedad-informacion-conocimiento/book/6187/download","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Quinto Plan de Acción de Uruguay será el primer plan del país que contendrá iniciativas de Parlamento Abierto, de Justicia Abierta, organismos de Administración Central y de Gobiernos Departamentales. Los compromisos abarcan el fortalecimiento de la transparencia y rendición de cuentas en diversas temáticas: compras públicas, gestión y políticas de salud, beneficios entregados al sector empresarial, uso de la Inteligencia Artificial en el Estado y las políticas ambientales. \n\nPara el proceso de cocreación del plan, participaron personas pertenecientes a diferentes grupos de la población en situación de mayor vulnerabilidad y desigualdad: personas en situación de discapacidad, personas mayores, personas afrodescendientes y mujeres. Con su particiapción se busca recoger y transversalizar sus aportes y perspectivas en diferentes iniciativas. En total, 497 personas participaron del proceso, además de 153 instituciones y organizaciones diferentes. ","description_en":"The Fifth Action Plan of Uruguay will be the country's first plan to include initiatives for Open Parliament, Open Justice, central government agencies, and local governments. The commitments cover strengthening transparency and accountability in various areas: public procurement, health management and policies, benefits provided to the business sector, use of Artificial Intelligence in government, and environmental policies.\n\nFor the co-creation process of the plan, people from different groups of the population facing greater vulnerability and inequality participated: people with disabilities, elderly people, Afro-descendant individuals, and women. Their participation aims to collect and mainstream their contributions and perspectives into various initiatives. In total, 497 people participated in the process, along with 153 different institutions and organizations.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://miradordegobiernoabierto.agesic.gub.uy/SigesVisualizador/gu/o/GA","pga/pga_mechanism_text_es":"Informe de revisión del Mecanismo de Revisión Independiente ","pga/pga_mechanism_text_en":"Uruguay Action Plan Review 2021-2024 - Independent Reporting Mechanism ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2023/04/Uruguay_Action-Plan-Review_2021-2024.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:a7fe4dc7-1246-4710-9268-4be0d754e279","meta/deprecatedID":"uuid:93549740-8ac7-417d-83e7-2a64078bb21c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a7fe4dc7-1246-4710-9268-4be0d754e279","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:14","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:a7fe4dc7-1246-4710-9268-4be0d754e279"},{"_id":46430,"start":"2025-11-07T14:25:15.965-04:00","end":"2026-04-06T12:46:42.922-04:00","id_drupal":"2372","country":"chl","theme":"territorial_planning","original_language":"es","name_es":"Política Nacional de Ordenamiento Territorial","name_en":"National Territorial Planning Policy","responsible_institution":[{"responsible_institution/institution":"Comisión Interministerial de Ciudad, Vivienda y Territorio (COMICIVYT) de Chile","responsible_institution/id_institution":"45181","responsible_institution/name_institution":"Comisión Interministerial de Ciudad, Vivienda y Territorio (COMICIVYT) de Chile"}],"link":"4d26a12c-353d-4494-8600-ed53a1d513ef","primary_link":"https://www.comicivyt.cl/wp-content/uploads/2025/03/PNOT_2024_Final-ALTA.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","effective_today":"no","temporality":"long_term","description_es":"En las últimas dos décadas, Chile ha avanzado hacia la construcción de una mirada intersectorial que integre el desarrollo económico, social y ambiental. También, ha avanzado hacia una mejor comprensión de la complejidad y dinamismo territorial expresada en los ámbitos urbano y rural. Asimismo, son relevantes las nuevas perspectivas para el sector primario exportador y su eventual agregación de valor, las necesidades de adaptación y ampliación de la escala de las infraestructuras y la logística del país, el uso del potencial en materia de energías renovables, el turismo de borde costero y de intereses especiales, la localización de proyectos de inversión y la exposición de la población a riesgos de origen natural y antrópico, entre otros. Los aspectos mencionados constituyen asuntos que deben ser abordados desde una perspectiva global.\n\nLo anterior apunta a la necesidad de elaboración de una Política Nacional de Ordenamiento Territorial, que se constituya como articuladora de políticas, planes e instrumentos, con la capacidad de conducir y coordinar las iniciativas con incidencia territorial, multiplicando las oportunidades de los habitantes y mejorando su calidad de vida. Tam - bién busca la construcción de un territorio armónico, integrado, seguro y comprensivo de la diversa y amplia geografía de nuestro país, expresando sus potenciales y propiciando la dinamización de sus riquezas económicas, ambientales, sociales y culturales. En definitiva, la PNOT impulsa un proceso de desarrollo sustentable, integrando las dimensiones social, económica y ambiental, con identidad territorial.\n\nEsta Política está en sintonía con el proceso de reforma político-administrativa impulsada en el marco del fortalecimiento de la regionalización del país, con el desarrollo de políticas y planes estratégicos de carácter sectorial e intersectorial, y con los procesos de integración económica, social y cultu - ral, tanto en el ámbito nacional como regional.\n\nEste instrumento es de alcance nacional y orienta la acción tanto de los órganos del Estado como de los actores privados con incidencia territorial en un horizonte temporal de 30 años. Esta Política será actualizada cuando existan cambios estructurales que modifiquen sustanti - vamente el contexto que da origen a sus fundamentos esenciales. Su implemen - tación se desarrolla tanto mediante la definición de ejes estratégicos, objetivos y directrices, así como sobre la base de un conjunto de acciones que deben ser impulsadas como parte de los mecanismos de gobernanza.\n\nLa PNOT de Chile fue aprobada a través del Decreto 469 del Ministerio del Interior y Seguridad Pública y está vigente desde su publicación en el Diario Oficial el 5 de julio de 2021.","description_en":"Over the past two decades, Chile has made progress toward building a cross-sectoral approach that integrates economic, social, and environmental development. It has also advanced in developing a better understanding of the complexity and dynamism of its territory, as expressed in both urban and rural areas. Additionally, new perspectives are emerging around the export-oriented primary sector and the potential for value addition, the need to adapt and expand infrastructure and logistics at scale, the use of renewable energy potential, coastal and special-interest tourism, the location of investment projects, and the population's exposure to natural and human-induced risks, among other issues. These matters must be addressed from a comprehensive, global perspective.\n\nThis context highlights the need to develop a National Land-Use Policy (PNOT), designed to serve as a coordinating framework for policies, plans, and instruments. It aims to steer and align initiatives with territorial impact, expanding opportunities for the population and improving their quality of life. It also seeks to build a harmonious, integrated, and safe territory that reflects the diversity and vastness of Chile’s geography, unlocking its potential and fostering the revitalization of its economic, environmental, social, and cultural assets. Ultimately, the PNOT promotes a sustainable development process that integrates social, economic, and environmental dimensions with a strong territorial identity.\n\nThis Policy aligns with the ongoing political and administrative reform process aimed at strengthening the country’s regionalization, the development of sectoral and cross-sectoral strategic policies and plans, and the processes of economic, social, and cultural integration at both the national and regional levels.\n\nThe instrument has national scope and guides the actions of both State institutions and private actors with territorial impact, within a 30-year time frame. The Policy will be updated when structural changes substantially alter the context that gave rise to its foundational principles. Its implementation is structured around the definition of strategic pillars, objectives, and guidelines, and is supported by a set of actions to be promoted through governance mechanisms.\n\nChile’s National Land-Use Policy (PNOT) was approved through Decree No. 469 of the Ministry of the Interior and Public Security and has been in effect since its publication in the Official Gazette on July 5, 2021.\n\nApproval Decree of Chile's PNOT: [link]\n\nInterministerial Commission on Cities, Housing and Territory (COMICIVYT) of Chile","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:d78742ae-5747-4047-b86c-618b07fee003","meta/deprecatedID":"uuid:4d59afa8-f5d1-4b13-9dea-cb0dc6a2be55","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d78742ae-5747-4047-b86c-618b07fee003","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d78742ae-5747-4047-b86c-618b07fee003"},{"_id":46431,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:16.697","end":"2025-11-07T14:25:16.697","id_drupal":"2298","country":"col","theme":"open_government","original_language":"es","name_es":"V Plan de Acción Nacional de Estado Abierto de Colombia (2023-2025)","name_en":"Fifth National Open Government Action Plan of Colombia (2023-2025)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Transparencia","responsible_institution/id_institution":"45340","responsible_institution/name_institution":"Secretaría de Transparencia"}],"coordinator":"Comité de Estado Abierto de Colombia","id_coordinator":"45149","name_coordinator":"Comité de Estado Abierto de Colombia","plan_number":"5","link":"f99ccd89-c670-4cf0-adcc-d732be05925a","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2024/01/Colombia_Action-Plan_2023-2025_December.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Quinto Plan de Acción Nacional de Estado Abierto de Colombia incluye compromisos del ejecutivo del orden nacional y territorial, órganos de control, altas cortes y por primera vez en la historia de la AGA, y en la rama legislativa desde sus dos cámaras: Senado de la República y Cámara de Representantes.\n\nDurante el proceso de cocreación, el Comité de Estado Abierto de Colombia identificó temas relevantes, los cuales fueron priorizados por la ciudadanía. En este proceso de priorización participaron 471 personas del sector público, privado, organizaciones de la sociedad civil y ciudadanía en general. Además, participaron 26 departamentos. Luego, se realizaron diálogos regionales de cocreación para incentivar la participación de la ciudadanía en la definición de problemas y soluciones que servirían como insumos para la construcción de los compromisos. 792 personas participaron en los diálogos regionales de cocreación.\n","description_en":"The Fifth National Open Government Action Plan of Colombia includes commitments from the national and territorial executive, control bodies, high courts, and for the first time in the history of the OGP, from the legislative branch, including both the Senate of the Republic and the House of Representatives. During the co-creation process, the Open Government Committee of Colombia identified relevant topics, which were prioritized by citizens. 471 people from the public sector, private sector, civil society organizations, and the general public participated in this prioritization process. Additionally, 26 departments were involved. Regional co-creation dialogues were held to encourage citizen participation in defining problems and solutions, which served as input for building the commitments. 792 people participated in the regional co-creation dialogues.","linking_sdg_plans":"no","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Colombia_Final_2012_web_0.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:bf13614e-13c1-424c-91f0-309123a78634","meta/deprecatedID":"uuid:6d03b41d-fe5e-41f2-9e9e-6ce97922886c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bf13614e-13c1-424c-91f0-309123a78634","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:bf13614e-13c1-424c-91f0-309123a78634"},{"_id":46432,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:17.416","end":"2025-11-07T14:25:17.416","id_drupal":"1767","country":"ecu","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción de Gobierno Abierto Ecuador (2022-2024)","name_en":"Second Open Government Action Plan of Ecuador (2022-2024)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"45534","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Grupo Núcleo de Ecuador","id_coordinator":"45005","name_coordinator":"Grupo Núcleo de Ecuador","plan_number":"2","link":"6cc7ebd9-8238-40b3-a60c-e8f98aeca8a7","primary_link":"https://www.gobiernoabierto.ec/plan-de-accion-2022-2024/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Segundo Plan de Acción de Ecuador lleva adelante su visión de Estado Abierto y participativo, con un enfoque en derechos humanos, interculturalidad, medio ambiente y género. \n\nEl proceso de cocreación del plan tuvo 5 etapas: mapeo temático y territorial de actores; recepción de propuestas ciudadanas; análisis y evaluación de propuestas; selección de compromisos; y formalización del PAGA II y rendición de cuentas. Para apoyar el proceso de cocreación del plan, el país participó de curso virtual sobre gobierno abierto dictado por ILPES-CEPAL que incluía como trabajo final una propuesta que podría ser considerada dentro de los compromisos del Segundo PAGA. En general, en el proceso de cocreación del plan participaron 1.260 personas, de las cuales 692 eran de género masculino, 559 de género femenino; 4 no binario y 5 que señalan como otro.","description_en":"Ecuador’s Second Action Plan advances its vision of an Open and participatory State, with a focus on human rights, interculturality, the environment, and gender.\n\nThe co-creation process of the plan had five stages: thematic and territorial mapping of actors; reception of citizen proposals; analysis and evaluation of proposals; selection of commitments; and formalization of the Second PAGA (Open Government Action Plan) and accountability. To support the co-creation process, the country participated in a virtual course on open government provided by ILPES-ECLAC, which included a final assignment that could be considered as a proposal for the Second PAGA commitments. In total, 1,260 people participated in the co-creation process, including 692 men, 559 women, 4 non-binary individuals, and 5 who identified as other.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://www.gobiernoabierto.ec/seguimiento-paga/#","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1d504d0f-0109-4454-be32-5bdd6def4b2b","meta/deprecatedID":"uuid:577d6232-9908-4bb4-9759-43a0a967e3a7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1d504d0f-0109-4454-be32-5bdd6def4b2b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:16","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1d504d0f-0109-4454-be32-5bdd6def4b2b"},{"_id":46433,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:18.127","end":"2025-11-07T14:25:18.127","id_drupal":"2347","country":"jam","theme":"open_government","original_language":"en","name_es":"Segundo Plan Nacional de Gobierno Abierto de Jamaica (2024-2026)","name_en":"Jamaica's Second National Open Government Action Plan (2024-2026)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Hacienda y Servicio Público de Jamaica","responsible_institution/id_institution":"45143","responsible_institution/name_institution":"Ministerio de Hacienda y Servicio Público de Jamaica"}],"plan_number":"2","link":"8e1d78b4-cb5f-42a9-9253-b9050d9716a2","primary_link":"https://observatorioplanificacion.cepal.org/sites/default/files/plan/files/Jamaica_Action-Plan_2024-2026_EN.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","visible_description":"yes","description_es":"El Segundo Plan de Acción de Jamaica integra los principios de gobierno abierto en todos sus compromisos, mediante secciones específicas que abordan la relevancia de cada propuesta en términos de transparencia, participación ciudadana, rendición de cuentas y fortalecimiento institucional. Además, el plan alinea los compromisos con los Objetivos de Desarrollo Sostenible (ODS) de la Agenda 2030, destacando especialmente aquellos relacionados con la acción climática, la justicia, la igualdad y la innovación institucional. En los compromisos 5 y 7, los vínculos con los ODS fueron identificados por el ILPES con base en el contenido y los objetivos de cada propuesta. Cada compromiso incluye hitos verificables, actores responsables y cronogramas definidos para su seguimiento.\n\nEl Segundo Plan de Acción comprende siete compromisos que abordan problemáticas públicas en diversos sectores, impulsados por instituciones del Poder Ejecutivo, en coordinación con organismos autónomos y representantes de la sociedad civil. El proceso de cocreación del plan fue liderado por el Foro Multiactor de Gobierno Abierto, compuesto equitativamente por representantes del gobierno y de la sociedad civil, con el apoyo de entidades como el Ministerio de Finanzas y Servicio Público. La metodología de cocreación incluyó sesiones temáticas virtuales enfocadas en la reflexión colaborativa, la revisión de avances del plan anterior y la identificación de nuevos desafíos. Este enfoque permitió el desarrollo conjunto de soluciones centradas en la apertura y el servicio a la ciudadanía.\n\nEl proceso de consulta se llevó a cabo en dos fases principales. Inicialmente, entre diciembre de 2023 y enero de 2024, se realizaron sesiones temáticas virtuales para identificar prioridades sectoriales. Posteriormente, en abril tuvo lugar una reunión nacional virtual para revisar avances, seguida por una segunda ronda de revisión de compromisos entre mayo y junio de 2024, que incorporó aportes de actores públicos y sociales. Este enfoque por fases aseguró la relevancia, viabilidad y orientación ciudadana de cada compromiso propuesto.\n\nLos espacios de participación reunieron a representantes del sector público, sociedad civil, sector privado, sindicatos, grupos juveniles, academia y comunidades religiosas. A través de estas interacciones, se recopilaron insumos para cada compromiso, así como sugerencias para su implementación y seguimiento. En total, se definieron siete compromisos que cumplen con los criterios de gobierno abierto y reflejan los intereses comunes de múltiples sectores. Este plan continúa con la trayectoria iniciada por el Primer Plan de Acción de Jamaica, reforzando el compromiso del país con una gobernanza pública abierta, colaborativa y centrada en la ciudadanía.","description_en":"Jamaica’s Second Action Plan integrates open government principles into all its commitments through specific sections addressing the relevance of each proposal regarding transparency, citizen participation, accountability, and institutional strengthening. Additionally, the plan aligns commitments with the Sustainable Development Goals (SDGs) of the 2030 Agenda, highlighting those particularly related to climate action, justice, equality, and institutional innovation. For Commitments 5 and 7, the SDG linkages were identified by ILPES based on the substance and objectives of each proposal. Each commitment includes verifiable milestones, responsible actors, and defined timelines for monitoring.\n\nThe Second Action Plan comprises seven commitments addressing public issues across various sectors, driven by institutions within the Executive Branch, in coordination with autonomous bodies and civil society representatives. The plan’s co-creation process was led by the Open Government Multi-stakeholder Forum, equally composed of government and civil society representatives, with support from entities such as the Ministry of Finance and Public Service. The co-creation methodology involved thematic virtual sessions focusing on collaborative reflection, review of progress from the previous plan, and identification of new challenges. This approach fostered the joint development of solutions emphasizing openness and citizen service.\n\nThe consultation process was carried out in two main phases. Initially, from December 2023 to January 2024, thematic virtual sessions were held to identify sectoral priorities. Subsequently, a national virtual meeting took place in April to review progress, followed by a second round of commitment reviews from May to June 2024, incorporating feedback from public and social stakeholders. This phased approach ensured the relevance, feasibility, and citizen-centered focus of each proposed commitment.\n\nParticipation spaces brought together representatives from the public sector, civil society, private sector, labor unions, youth groups, academia, and religious communities. Through these interactions, inputs were collected for each commitment, along with suggestions on implementation and monitoring. In total, seven commitments were defined that fulfill open government criteria and reflect the common interests of multiple sectors. This plan continues the trajectory initiated by Jamaica’s First Action Plan, reinforcing the country’s commitment to open, collaborative, and citizen-centered public governance.","linking_sdg_plans":"no","pga/pga_mechanism_text_en":"Latest report from the Independent Reporting Mechanism of the Open Government Partnership ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2024/09/Jamaica_Results-Report_-2021%E2%80%932023.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:8e9a19f3-8945-4ec2-9c92-5aa7c43a0ffc","meta/deprecatedID":"uuid:569cc346-b546-410b-8bdc-190216c30750","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8e9a19f3-8945-4ec2-9c92-5aa7c43a0ffc","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8e9a19f3-8945-4ec2-9c92-5aa7c43a0ffc"},{"_id":46434,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:18.853","end":"2025-11-07T14:25:18.853","id_drupal":"612","country":"arg","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Argentina (2015-2017)","name_en":"Second National Open Government Action Plan of Argentina (2015-2017)","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital","responsible_institution/id_institution":"45339","responsible_institution/name_institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital"}],"coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","id_coordinator":"45146","name_coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","plan_number":"2","link":"61509969-6cd3-48b7-aa0e-31efdb879d1f","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Argentina_NAP2_V.2.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El segundo Plan de Acción de la República Argentina para el bienio 2015-2017 se presenta con la particularidad de haberse elaborado en dos etapas. Desde la Coordinación de Gobierno Abierto, en 2015 todavía dependiente de la Jefatura de Gabinete de Ministros, se lideró el trabajo de elaboración del Plan teniendo en cuenta que sería implementado en su mayoría por un nuevo gobierno. En ese contexto, se decidió presentar en julio de 2015 una primera versión del Plan de Acción Nacional con seis compromisos, uno de los cuales instaba a generar nuevos compromisos de medio término. El sexto compromiso del Plan abría la posibilidad al gobierno entrante, de proponer nuevos compromisos realizables en el transcurso de un año; y a los organismos con compromisos asumidos, la oportunidad de introducir modificaciones a los hitos o en los plazos de cumplimiento.\n\nSe acordó abordar el trabajo en ocho mesas temáticas: 1. Hábitat y desarrollo humano; 2. Trabajar en Argentina; 3. Acceso a la información, transparencia y datos abiertos; 4. Transformación productiva; 5. Justicia y derechos humanos; 6. Ciencia, tecnología e innovación; 7. Ciudadanía saludable; 8. Cultura y desarrollo. De las mesas temáticas participaron  miembros de Organizaciones de la Sociedad Civil, ciudadanos que asistieron de manera no organizada, y funcionarios de los organismos públicos. Luego, se realizó un proceso de consulta pública a través de una plataforma web. En las semanas siguientes a la finalización de la consulta, la Coordinación de Gobierno Abierto mantuvo reuniones con los organismos responsables para consolidar los compromisos teniendo en cuenta los comentarios de los participantes.","description_en":"Argentina’s Second Action Plan for the 2015–2017 period was developed in two stages. The Open Government Coordination Office—then under the Chief of the Cabinet of Ministers—led the plan’s drafting in 2015, considering that it would be largely implemented by a new government. In this context, a first version of the National Action Plan was presented in July 2015 with six commitments, one of which called for generating new mid-term commitments. The sixth commitment allowed the incoming government to propose new commitments achievable within one year and allowed agencies with existing commitments to modify their milestones or deadlines.\n\nWork was organized into eight thematic roundtables: 1. Habitat and human development; 2. Working in Argentina; 3. Access to information, transparency, and open data; 4. Productive transformation; 5. Justice and human rights; 6. Science, technology, and innovation; 7. Healthy citizenship; 8. Culture and development. Participants included members of civil society organizations, unorganized citizens, and officials from public agencies. A public consultation was later held via an online platform. In the weeks following the consultation, the Open Government Coordination Office held meetings with responsible agencies to consolidate the commitments, taking into account participant feedback.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f01ff5ef-26a1-4d4a-b51c-67abbd183950","meta/deprecatedID":"uuid:de1cbfa2-d189-4eef-bdbc-1f30a8cf1eeb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f01ff5ef-26a1-4d4a-b51c-67abbd183950","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f01ff5ef-26a1-4d4a-b51c-67abbd183950"},{"_id":46435,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:19.568","end":"2025-11-07T14:25:19.568","id_drupal":"613","country":"pan","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Panamá (2015-2017)","name_en":"Second National Open Government Action Plan of Panama (2015-2017)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia","responsible_institution/id_institution":"45253","responsible_institution/name_institution":"Dirección de Transparencia"}],"coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","id_coordinator":"45147","name_coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","plan_number":"2","link":"e173b05a-3e7e-4550-b01b-8551d8888890","primary_link":"https://gobiernoabierto.gob.pa/wp-content/uploads/2024/05/Plan-de-Accion-Nacional-de-Gobierno-Abierto-2015-2017.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El segundo Plan de Acción de la República de Panamá 2015-2017, es el resultado de un proceso abierto y participativo entre veintiún instituciones públicas y dieciocho representantes escogidos por más de cuarenta organizaciones de la sociedad civil. La metodología utilizada fue la de mesas temáticas, las cuales permitieron identificar compromisos que responden a preocupaciones ciudadanas.\n\nSe realizaron mesas temáticas en catorce temas: ambiente, fuerzas policiales y seguridad ciudadana, justicia, derecho a la información, gestión documental, rendición de cuentas, servicios públicos, contrataciones públicas, presupuesto, declaraciones patrimoniales y conflictos de intereses, elecciones, participación ciudadana, datos de gobierno abierto/apertura de datos y carrera administrativa, contemplados en el Programa de Trabajo de la elaboración del segundo Plan de Acción.\n\nSe acordó que durante el período de implementación del Plan de Acción se realizaría un monitoreo por parte de miembros de la sociedad civil e instituciones públicas, a través de un Mecanismo de Diálogo Permanente (una comisión conformada por representantes de la sociedad civil e instituciones públicas).","description_en":"Panama’s Second Action Plan (2015–2017) resulted from an open and participatory process involving twenty-one public institutions and eighteen representatives selected by more than forty civil society organizations. The methodology involved thematic working groups that identified commitments responding to citizens’ concerns.\n\nWorking groups covered fourteen topics: environment, police forces and citizen security, justice, right to information, document management, accountability, public services, public procurement, budgeting, asset declarations and conflict of interest, elections, citizen participation, open government data/data openness, and civil service. These themes were outlined in the Work Program for drafting the Second Action Plan.\n\nIt was agreed that a monitoring process would take place during the implementation period, led by both civil society and public institutions through a Permanent Dialogue Mechanism (a commission made up of representatives from both sectors).\n","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:fb5eff18-a1d2-400f-9dcb-2bce640c1198","meta/deprecatedID":"uuid:2ce71c91-a113-41eb-9734-98fccf2df34e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"fb5eff18-a1d2-400f-9dcb-2bce640c1198","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:fb5eff18-a1d2-400f-9dcb-2bce640c1198"},{"_id":46436,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:20.306","end":"2025-11-07T14:25:20.306","id_drupal":"629","country":"per","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Perú (2015-2017)","name_en":"Second National Open Government Action Plan of Peru (2015-2017)","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública","responsible_institution/id_institution":"45341","responsible_institution/name_institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Perú","id_coordinator":"45348","name_coordinator":"Foro Multiactor de Gobierno Abierto de Perú","plan_number":"2","link":"a2abe351-3648-43ac-82ba-5854fa1ea96a","primary_link":"https://cdn.www.gob.pe/uploads/document/file/3124208/II%20Plan%20de%20Acci%C3%B3n%20de%20Gobierno%20Abierto.pdf.pdf?v=1653328086","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Segundo Plan de Acción incluyó compromisos en transparencia y acceso a la información pública, participación ciudadana, rendición de cuentas y mejora de servicios públicos. Las propuestas de compromisos fueron hechas por entidades públicas de los tres niveles de gobierno; así como tambien  fueron producto de talleres que se realiza con en distintas regiones del país. \n\nSe puso en funcionamiento una Comisión Multisectorial de naturaleza permanente para el seguimiento y la implementación del Plan. La misma fue integrada por entidades públicas y sociedad civil.","description_en":"Peru’s Second Action Plan included commitments on transparency and access to public information, citizen participation, accountability, and improvement of public services. Commitment proposals came from public entities at all three levels of government, as well as from regional workshops held throughout the country.\n\nA Permanent Multisectoral Commission was established to monitor and implement the plan, composed of public entities and civil society.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:dcf2f176-c2dc-4cb5-9bea-8dca6277b860","meta/deprecatedID":"uuid:be52173d-f168-4313-9305-4969833d7e58","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dcf2f176-c2dc-4cb5-9bea-8dca6277b860","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:19","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dcf2f176-c2dc-4cb5-9bea-8dca6277b860"},{"_id":46437,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:21.025","end":"2025-11-07T14:25:21.025","id_drupal":"640","country":"col","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Colombia (2017-2019)","name_en":"Third National Open Government Action Plan of Colombia (2017-2019)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Transparencia","responsible_institution/id_institution":"45340","responsible_institution/name_institution":"Secretaría de Transparencia"}],"coordinator":"Comité de Estado Abierto de Colombia","id_coordinator":"45149","name_coordinator":"Comité de Estado Abierto de Colombia","plan_number":"3","link":"1fc663b8-e094-4597-949e-2b7b90063cd7","primary_link":"https://somosmas.org/aga/docs/III-Plan-Colombia_GobAb.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El tercer Plan de Acción Nacional se desarrolla desde el enfoque de Estado Abierto y en un nuevo escenario político y social en Colombia, incorporando al proceso de la Alianza para el Gobierno Abierto (AGA) a las tres ramas del poder público, los órganos de control y los gobiernos sub-nacionales. En este sentido, las prioridades que se han decidido abordar a través del Plan de Acción Nacional de la AGA son: Participación ciudadana en el seguimiento a la implementación del Acuerdo de Paz; Transparencia y participación ciudadana en el sector justicia; Acceso a la información pública y uso de datos abiertos; Lucha contra la corrupción en el Estado; Participación ciudadana incidente en políticas públicas.\n\nEste Plan comenzó con la identificación de 48 entidades de la institucionalidad pública nacional,  que aportan directamente al cumplimiento de los fines planteados. Las entidades del Gobierno Nacional invitadas fueron 30. Se organizaron 41 Mesas de Trabajo con los representantes de cada uno de los sectores (Gobierno Nacional, academia, sector privado y sociedad civil) para identificar tanto los desafíos del Gobierno Abierto en el país, como los aspectos estratégicos para la construcción del Plan. Asimismo, se llevaron a cabo siete sesiones técnicas para el desarrollo conjunto de las propuestas de los compromisos, además de varias videoconferencias, para guiar a las entidades interesadas en el desarrollo de todas las propuestas.  Las propuestas de los compromisos seleccionados por el Comité de Seguimiento fueron retroalimentadas por los ciudadanos. Para ello, se aplicó una consulta ciudadana abierta durante tres semanas a través de la Urna de Cristal. Además, se implementaron estrategias de divulgación de la consulta en las redes sociales. El Tercer Plan de Acción se enmarcó en una metodología de co-creación consolidada, además de una voluntad política de inclusión de las regiones de Colombia. ","description_en":"The third National Action Plan is developed from an Open State approach and within a new political and social context in Colombia, incorporating all three branches of public power, oversight bodies, and subnational governments into the Open Government Partnership (OGP) process. In this context, the priorities chosen to be addressed through the OGP National Action Plan are: Citizen participation in monitoring the implementation of the Peace Agreement; Transparency and citizen participation in the justice sector; Access to public information and the use of open data; Combating corruption in the State; and Meaningful citizen participation in public policy.\n\nThis Plan began with the identification of 48 national public institutions that directly contribute to achieving its stated objectives. Thirty national government entities were invited to participate. A total of 41 working groups were organized with representatives from each sector (national government, academia, private sector, and civil society) to identify both the open government challenges in the country and the strategic elements needed to build the Plan. In addition, seven technical sessions were held to jointly develop the proposed commitments, along with several videoconferences to guide interested entities in the formulation of their proposals. The commitment proposals selected by the Monitoring Committee were submitted for public feedback. To this end, an open public consultation was conducted for three weeks via the Urna de Cristal platform. Outreach strategies were also implemented through social media to promote the consultation. The Third Action Plan was framed within a consolidated co-creation methodology, supported by a strong political will to include Colombia’s regions.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1913f9be-03d6-4b97-9cdc-a67105179c7e","meta/deprecatedID":"uuid:64c0fbf4-c955-4608-9784-32a0b1e4e89a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1913f9be-03d6-4b97-9cdc-a67105179c7e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:20","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1913f9be-03d6-4b97-9cdc-a67105179c7e"},{"_id":46438,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:21.754","end":"2025-11-07T14:25:21.754","id_drupal":"1763","country":"dom","theme":"open_government","original_language":"es","name_es":"V Plan de Acción de la República Dominicana ante la Alianza para el Gobierno Abierto (2022-2024)","name_en":"Fifth Open Government Plan of the Dominican Republic to the Open Government Partnership (2022-2024)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana","responsible_institution/id_institution":"45523","responsible_institution/name_institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana"}],"coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","id_coordinator":"44999","name_coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","plan_number":"5","link":"7f60e62e-15bb-462f-bc2e-193d5c2d52bc","primary_link":"https://gobiernoabierto.gob.do/wp-content/uploads/2023/01/5to-Plan-de-Accion-de-Gobierno-Abierto-de-la-Republica-Dominicana-2022-2024-DIGITAL.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El V Plan de Acción transversaliza el enfoque de género y la inclusión social en todos sus compromisos, al incluir varios apartados que se refieren específicamente al impacto en género y las brechas de desigualdad. Además, en este plan los compromisos son vinculados a los Objetivos de Desarrollo de la Agenda 2030 para el Desarrollo Sostenible a nivel de objetivos y metas, y cada compromiso cuenta con indicadores de seguimiento.\n\nEl proceso de cocreación del V Plan de Acción fue coordinado por el Foro Multiactor de Gobierno Abierto, conformado por representantes de gobierno, la sociedad civil, el sector privado y la academia. La metodología del proceso tomó como base la metodología de Design thinking, para construir ideas innovadoras orientadas a soluciones y centradas en el ciudadano. Una vez se priorizaron los temas por el Foro Multiactor a través de un proceso de socialización, se convocó a la ciudadanía a participar en talleres y encuentros. Se desarrollaron mesas territoriales presenciales y mesas temáticas virtuales. Los talleres y encuentros presenciales contaron con la participación de 576 personas entre sociedad civil y gobierno. En los encuentros virtuales, participaron 416 personas. En otras palabras, en total, el proceso contó con la participación de 992 personas.","description_en":"The Fifth Action Plan integrates a gender and social inclusion approach across all its commitments, addressing gender impact and inequality gaps. Additionally, the commitments in this plan are linked to the Sustainable Development Goals of the 2030 Agenda, both in terms of objectives and targets, and each commitment includes follow-up indicators. The co-creation process for the Fifth Action Plan was coordinated by the Open Government Multi-Actor Forum, composed of representatives from the government, civil society, the private sector, and academia. The process used the Design Thinking methodology to develop innovative ideas focused on solutions and citizen-centered. After prioritizing topics by the Multi-Actor Forum through a socialization process, citizens were invited to participate in workshops and meetings. In-person territorial tables and virtual thematic tables were developed. A total of 576 people from civil society and government participated in the in-person workshops, and 416 people participated in the virtual meetings, totaling 992 participants.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://tablero.gobiernoabierto.gob.do/panel/","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1f5eacf8-780d-43b4-8111-84e8f5876267","meta/deprecatedID":"uuid:b3d03fab-8c00-49fd-9dd0-5a2266391227","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1f5eacf8-780d-43b4-8111-84e8f5876267","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:20","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1f5eacf8-780d-43b4-8111-84e8f5876267"},{"_id":46439,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:22.489","end":"2025-11-07T14:25:22.489","id_drupal":"1001","country":"dom","theme":"open_government","original_language":"es","name_es":"VI Plan de Acción de la República Dominicana ante la Alianza para el Gobierno Abierto (2024-2028)","name_en":"Sixth Open Government Plan of the Dominican Republic to the Open Government Partnership (2024-2028)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana","responsible_institution/id_institution":"45523","responsible_institution/name_institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana"}],"coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","id_coordinator":"44999","name_coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","plan_number":"6","link":"1d95920a-d58f-4def-a339-fba57b527790","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2025/01/Dominican-Republic_Action-Plan_2024-2028_ES.pdf\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El VI Plan de Acción transversaliza el enfoque de género y la inclusión social en todos sus compromisos, al incluir varios apartados que buscan responder a las preguntas \"¿De qué manera el compromiso promueve elementos de género o el combate a brechas de desigualdad?\", \"¿De qué manera este problema afecta a mujeres y hombres?\", y \"¿El problema afecta a una población en situación de vulnerabilidad específica?\". A su vez, en este plan los compromisos son vinculados a los Objetivos de Desarrollo de la Agenda 2030 para el Desarrollo Sostenible a nivel de objetivos. Por último, cada compromiso cuenta con indicadores de seguimiento.\n\nEl Sexto Plan de Acción contiene 10 compromisos que abordan desafíos sociales en diferentes áreas de impacto e incluye compromisos del Poder Ejecutivo y el Poder Judicial. El proceso de cocreación del V Plan de Acción fue coordinado por el Foro Multiactor de Gobierno Abierto, conformado por representantes de gobierno, la sociedad civil, el sector privado y la academia. La metodología usada para cocrear el plan se basó en la metodología de Design Thinking a los fines de construir ideas innovadoras orientadas a soluciones y centradas en el ciudadano. Esta metodología propició la colaboración constructiva, tan importante en los procesos de cocreación. El proceso de consulta contó de dos momentos. Un primer momento en el que se sensibilizó a los presentes sobre la iniciativa de Gobierno Abierto en general, el compromiso de la República Dominicana, la experiencia de los Planes de Acción anteriores y las expectativas para el VI Plan de Acción (criterios y principios generales); y un segundo momento en el que se realizaba una dinámica a los fines de facilitar la recolección de las problemáticas y posibles soluciones.\n\nLos talleres y encuentros presenciales contaron con la participación de quinientas sesenta (560) personas entre Sociedad Civil y Gobierno, de las cuales doscientas cincuenta y cuatro (254) fueron mujeres y trescientos seis (306) fueron hombres. Por su lado los encuentros virtuales, contaron con la participación de doscientos veinte y tres (223) personas. Para un total de setecientos ochenta y tres (783) participantes en el proceso consultivo de cocreación de este VI Plan de Acción. Se recibieron un total de doscientas noventa (290) propuestas de soluciones a problemáticas y retos. Resultando ciento treinta y una (131) propuestas que cumplieron con los principios de Gobierno Abierto.","description_en":"The Sixth Action Plan mainstreams a gender and social inclusion perspective across all of its commitments by incorporating several sections aimed at addressing the following questions: “How does the commitment promote gender-related elements or address inequality gaps?”, “How does this issue affect women and men?”, and “Does the issue affect a population in a specific situation of vulnerability?” Additionally, the commitments in this plan are aligned with the Sustainable Development Goals (SDGs) of the 2030 Agenda at the goal level. Each commitment also includes monitoring indicators.\n\nThe Sixth Action Plan includes 10 commitments that address social challenges across different areas of impact and features commitments from both the Executive and Judicial branches. The co-creation process of the Sixth Action Plan was coordinated by the Multi-Stakeholder Open Government Forum, composed of representatives from government, civil society, the private sector, and academia. The methodology used to co-create the plan was based on Design Thinking, aimed at generating innovative, citizen-centered, solution-oriented ideas. This methodology fostered constructive collaboration, which is key to co-creation processes.\n\nThe consultation process consisted of two phases. The first phase focused on raising awareness among participants about the Open Government initiative, the Dominican Republic’s commitment, the experience of previous Action Plans, and expectations for the Sixth Action Plan (including general principles and criteria). The second phase involved an interactive session to help identify problems and potential solutions.\n\nThe in-person workshops and meetings brought together 560 participants from both civil society and government, including 254 women and 306 men. The virtual sessions involved 223 participants, bringing the total number of participants in the co-creation consultation process for the Sixth Action Plan to 783. A total of 290 proposals were received, of which 131 met the principles of Open Government.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:641883b2-9198-49ff-ba17-3bdbcb500bb1","meta/deprecatedID":"uuid:36c415e2-36de-4b79-a2ef-689cc3ca3472","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"641883b2-9198-49ff-ba17-3bdbcb500bb1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:21","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:641883b2-9198-49ff-ba17-3bdbcb500bb1"},{"_id":46440,"start":"2025-11-07T14:25:23.215-03:00","end":"2026-04-06T12:47:03.919-04:00","id_drupal":"20004","country":"chl","theme":"territorial_planning","original_language":"es","name_es":"Planes Regionales de Ordenamiento Territorial","name_en":"Regional Land Use Plans","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Desarrollo Regional y Adminstrativo (Subdere)","responsible_institution/id_institution":"45024","responsible_institution/name_institution":"Subsecretaría de Desarrollo Regional y Adminstrativo (Subdere)"}],"link":"b798ff4a-91a3-489c-af12-201bd2a31624","primary_link":"https://www.subdere.gov.cl/sites/default/files/documentos/articles-83896_recurso_1_1.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Regiones","type_territorial_unit_en":"Regions","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"El Plan Regional de Ordenamiento Territorial (PROT) es un instrumento que orienta el uso y la organización del territorio de cada región mediante lineamientos estratégicos y una macrozonificación regional, con el objetivo de promover su desarrollo sustentable. De acuerdo con la Ley N.º 19.175, el plan establece condiciones para la localización de determinadas infraestructuras, actividades productivas y sistemas de disposición y tratamiento de residuos en áreas no sometidas a planificación urbanística, y es de cumplimiento obligatorio para los ministerios y servicios públicos que operan en la región.","description_en":"The Regional Land Use Plan (PROT) is a tool that guides the use and organization of each region’s territory through strategic guidelines and regional macro-zoning, with the aim of promoting sustainable development. In accordance with Law No. 19,175, the plan establishes conditions for the location of certain infrastructure, productive activities, and waste disposal and treatment systems in areas not subject to urban planning, and is mandatory for ministries and public services operating in the region.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:0fbdc802-677e-404d-a037-a9356e317feb","meta/deprecatedID":"uuid:06991c31-04be-4ed8-a8aa-467fdf94ed41","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0fbdc802-677e-404d-a037-a9356e317feb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:22","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0fbdc802-677e-404d-a037-a9356e317feb"},{"_id":46441,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:23.927","end":"2025-11-07T14:25:23.927","id_drupal":"1749","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad Urbana Sustentable Zona Metropolitana de Colima Villa Alvarez","name_en":"Comprehensive Sustainable Urban Mobility Plan for the Colima-Villa Álvarez Metropolitan Area","responsible_institution":[{"responsible_institution/institution":"Secretaría de Movilidad del Estado de Colima y Secretaría de Infraestructura y Desarrollo Urbano","responsible_institution/id_institution":"45454","responsible_institution/name_institution":"Secretaría de Movilidad del Estado de Colima y Secretaría de Infraestructura y Desarrollo Urbano"}],"link":"d797b706-45b6-4745-8db5-1849796764e0","primary_link":"https://admiweb.col.gob.mx/archivos_prensa/banco_img/file_613a5ae64bb3d_VIIInformeEjecutivoColimaF.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Zona Metropolitana Colima – Villa de Álvarez","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"Elaborar el Plan Integral de Movilidad Urbana Sustentable para la Zona Metropolitana de Colima Villa de Álvarez, del cual se deriven acciones que permitan hacer eficiente los traslados de las personas y bienes, como sustento para el desarrollo económico y social de su población, constituyendo un instrumento que responda a las expectativas de usuarios, transportistas, operadores del servicio, autoridades y población en general; bajo un marco normativo justo, considerando la realidad que imponen la situación socioeconómica del país, del Estado y de los Municipios de la zona metropolitana de Colima.","description_en":"Develop the Sustainable Urban Mobility Master Plan for the Colima–Villa de Álvarez Metropolitan Zone, leading to actions that improve the movement of people and goods, supporting economic and social development, and reflecting the expectations of users, transport operators, authorities, and the general public. It must align with a fair regulatory framework and the socioeconomic reality of the country, state, and municipalities.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Consolidar un sistema metropolitano de movilidad. Reestrcuturar los recorridos y nuevos programas de servicio operacional. Implementar vehículos de tecnología limpia y crear un programa de modernización de la flota. Difundir el nuevo sistema con una imágen e identidad específica. Crear un sistema online correspondiente al nuevo sistema metropolitano de movilidad propuesto. Adquirir nuevos vehículos que incluyan el acceso para personas con discapacidad. Implementar una infraestructura adecuada para la operación del transporte público (paraderos, señaleticas, carriles exclusivos, áreas de ascenso y descenso, equipamiento).","pmu/pmu_prioritization_en":"Consolidate a metropolitan mobility system. Restructure routes and new operational service programs. Implement cleantech vehicles and create a fleet modernization program. Disseminate the new system with a specific image and identity. Create an online system corresponding to the proposed new metropolitan mobility system. Acquire new vehicles that include access for people with disabilities. Implement an adequate infrastructure for the operation of public transport (stops, signage, exclusive lanes, ascent and descent areas, equipment).","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","pmu/pmu_budget":"1597683","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0feed976-c78c-43f6-8580-b5e60552d444","meta/deprecatedID":"uuid:24f8252c-6b8c-4e03-b3b7-ff240f33b0d8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0feed976-c78c-43f6-8580-b5e60552d444","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0feed976-c78c-43f6-8580-b5e60552d444"},{"_id":46442,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:24.649","end":"2025-11-07T14:25:24.649","id_drupal":"1752","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan Integral de Movilidad Urbana Sustentable de Mérida","name_en":"Comprehensive Sustainable Urban Mobility Plan for Mérida","responsible_institution":[{"responsible_institution/institution":"Instituto Municipal de Planeación","responsible_institution/id_institution":"45508","responsible_institution/name_institution":"Instituto Municipal de Planeación"}],"link":"71352e1e-0ae5-40a9-9db2-7b4a113d20f7","primary_link":"https://www.merida.gob.mx/implan/content/documents/movilidad-urbana/PIMUS_2024.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Merida","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"Elaborar un plan estratégico para orientar las políticas, los programas y los proyectos de movilidad urbaan sustentable en el municipio de Mérida. Las líneas estratégicas son: 1. Diseño y planeación urbana; 2. Transporte público; 3. Modos no motorizados; 4. Vehículo privado; 5. Carga; 6. Institucionalidad y normativa ","description_en":"Develop a strategic plan to guide policies, programs, and sustainable urban mobility projects in the municipality of Mérida. The strategic lines are: 1. Urban design and planning; 2. Public transportation; 3. Non-motorized modes; 4. Private vehicles; 5. Freight; 6. Institutional framework and regulations.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"vision","pmu/pmu_implementation_es":"Transporte público eficiente y bajo en emisiones de GEIs","pmu/pmu_implementation_en":"Efficient public transport with low GHG emissions","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"\"*Peatón: habilitación de red peatonal y ciclista, fomento a la cultura peatonal y ciclista. Habilitar calles en particular y espacios públicos e general para que sea accesible, seguro y confortable. *Bicicleta: ampliación de red de infraestructura ciclista, sistema de bici estacionamiento en espacios públicos y privados, programa de Bici-escuela. *Transporte público: dotación de infraestructura accesible, renovación de flota vehicular, optimización de rutas, implementación de pago electrónico y mejora de calidad del servicio, ampliación de la oferta municipal de transporte. *Transporte privado: gestión del vehículo privado y su estacionamiento, monitoreo del desempeño ambiental de los vehículos\"","pmu/pmu_prioritization_en":"\"*Pedestrian: enabling of pedestrian and bicycle network, promotion of pedestrian and cyclist culture. Enable streets in particular and public spaces in general so that it is accessible, safe and comfortable. * Bicycle: expansion of the cycling infrastructure network, bicycle parking system in public and private spaces, Bike-school program. *Public transport: provision of accessible infrastructure, renewal of the vehicle fleet, optimization of routes, implementation of electronic payment and improvement of service quality, expansion of the municipal transport offer. *Private transport: management of private vehicles and their parking, monitoring of the environmental performance of vehicles\"","pmu/pmu_gender_es":"\"El objetivo es incorporar la inclusión de los grupos vulnerables y el enfoque de género en todo el sistema de movilidad urbana. Para tal efecto, se propone medir tanto la (1) capacitación y sensibilización de los operarios de los sistemas de transporte público, como (2) la incidencia de casos de discriminación y acoso en los modos de traslado masivos. Para lo cual será necesario contar con información desagregada por género y por grupo poblacional. Acciones: *Programa de capacitación integral, sensibilización y protocolos de seguridad con perspectiva de género a operadores del transporte. *Integración de perspectiva de género e inclusión en los sistemas de transporte público\"","pmu/pmu_gender_en":"\"The objective is to incorporate the inclusion of vulnerable groups and the gender approach throughout the urban mobility system. To this end, it is proposed to measure both the (1) training and awareness of operators of public transport systems, and (2) the incidence of cases of discrimination and harassment in mass modes of transport. For this, it will be necessary to have information disaggregated by gender and by population group. Actions: *Comprehensive training program, awareness and safety protocols with a gender perspective for transport operators. *Integration of gender perspective and inclusion in public transport systems\"","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f8360fc6-4b19-4c30-b511-90ba51712c62","meta/deprecatedID":"uuid:3ab9a0d5-4c96-4a9c-95a0-efbc790ee076","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f8360fc6-4b19-4c30-b511-90ba51712c62","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f8360fc6-4b19-4c30-b511-90ba51712c62"},{"_id":46443,"start":"2025-11-07T14:25:25.519-04:00","end":"2026-04-30T11:59:19.475-04:00","id_drupal":"1710","country":"col","theme":"mobility","original_language":"es","name_es":"Plan Maestro de Movilidad de Bogotá (Revisión y actualización 2018)","name_en":"Bogotá Master Mobility Plan (Review and Update 2018)","responsible_institution":[{"responsible_institution/institution":"Secretaría Distrital de Movilidad","responsible_institution/id_institution":"45366","responsible_institution/name_institution":"Secretaría Distrital de Movilidad"}],"primary_link":"https://www.movilidadbogota.gov.co/web/sites/default/files/Paginas/29-12-2019/22._anexo_2_acta_comite_27_noviembre_2018.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Capital de Bogotá","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2038-01-01","effective_today":"yes","temporality":"long_term","description_es":"En 2038 en Bogotá no habrá pérdida de vidas humanas asociadas a la movilidad. Su sistema de movilidad será seguro, eficiente, inteligente, amigable con el medio ambiente, e inclusivo. Generar un sistema de  movilidad donde la seguridad  es primordial y las fatalidades son inaceptables. Aportar a la competitividad de la ciudad, promoviendo un sistema de movilidad seguro, eficiente y articulado con la política territorial urbanaregional. Promover el acceso y disfrute democrático, igualitario y con calidad al sistema de movilidad y a las oportunidades que brinda la ciudad. Aportar a la reducción de la huella ecológica de la ciudad.","description_en":"By 2038, there will be no loss of human life related to mobility in Bogotá. Its mobility system will be safe, efficient, smart, environmentally friendly, and inclusive. Establish a system where safety is paramount and fatalities are unacceptable. Enhance the city’s competitiveness by promoting a safe, efficient system aligned with urban-regional land policy. Promote democratic, equal, and quality access to mobility systems and urban opportunities. Contribute to reducing the city’s ecological footprint.","linking_sdg_plans":"yes","sdg":"sdg_11","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"Se incorpora a nivel de un objetivo específico y acciones como: -Formulación del Plan de movilidad eléctrica y demás tecnologías cero directas de material particulado -Promoción de energías limpias en vehículos livianos -Desarrollo de estrategia para la instalación de estaciones de recarga para vehículos eléctricos","pmu/pmu_implementation_en":"It is incorporated at the level of a specific objective and actions such as: -Formulation of the Electric Mobility Plan and other direct zero particulate matter technologies -Promotion of clean energies in light vehicles -Development of a strategy for the installation of charging stations for electric vehicles","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Cuando las condiciones de movilidad de la ciudad lo exijan, la administración distrital adoptará el Metro, y adelantará los estudios pertinentes de factibilidad como componente del Sistema de Transporte Publico Integrado.(29) pg 12 se habla maás de transporte publico que de buses en particular. Prioridad en la construcción de vías para peatones y ciclousuarios (8); Implementación de corredores para ciclorrutas (9); Promoción del transporte no motorizado; Optimización de la red de ciclo rutas (14); Facilitar instalaciones o mobiliario destinado al estacionamiento de bicicletas (14); Incentivará la dotación de zonas amarillas fuera de vía, sitios de espera para vehículos tipo taxi, donde serán despachados atendiendo a una solicitud de la ciudadanía (13)","pmu/pmu_prioritization_en":"When the city's mobility conditions require it, the district administration will adopt the Metro, and will carry out the pertinent feasibility studies as a component of the Integrated Public Transport System. (29) PG 12 There is more talk of public transport than of buses in particular. Priority in the construction of roads for pedestrians and bicycle users (8); Implementation of corridors for bike paths (9); Promotion of non-motorized transport; Optimization of the cycle path network (14); Provide facilities or furniture for the parking of bicycles (14); It will encourage the provision of yellow off-road zones, waiting places for taxi-type vehicles, where they will be dispatched in response to a request from citizens (13)","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género y no se menciona la institucionalización de una perspectiva de género","pmu/pmu_gender_en":"No project includes a gender perspective and there is no mention of the institutionalization of a gender perspective","pmu/pmu_budget":"1171852650","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:dfb13ff9-ab0b-407d-8aa9-77fdd4428975","meta/deprecatedID":"uuid:47bec904-fdc6-4daf-ad38-3f5bc147ee20","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dfb13ff9-ab0b-407d-8aa9-77fdd4428975","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:24","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dfb13ff9-ab0b-407d-8aa9-77fdd4428975"},{"_id":46444,"start":"2025-11-07T14:25:26.299-04:00","end":"2026-04-06T12:48:05.309-04:00","id_drupal":"726","country":"cri","theme":"territorial_planning","original_language":"es","name_es":"Plan Nacional de Ordenamiento Territorial de Costa Rica","name_en":"National Territorial Planning Plan of Costa Rica","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica","responsible_institution/id_institution":"44992","responsible_institution/name_institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica"}],"link":"0f8423a8-7640-420e-b6b9-c3a7d6f08614","primary_link":"https://www.mivah.go.cr/Documentos/politicas_directrices_planes/pnot/PLANOT_2013-12-03.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"medium_term","description_es":"En el marco de la Política Nacional de Ordenamiento Territorial (2012-2040)  se formuló el Plan Nacional de Ordenamiento Territorial (PLANOT) 2014-2020, instrumento direccionador del quehacer local, regional y nacional, en el ámbito de la planificación y el ordenamiento territorial.\nEl ordenamiento territorial en Costa Rica se promueve por medio de la regulación y promoción de asentamientos humanos y actividades económicas y sociales de la población, así como el desarrollo físico-espacial, con el fin de lograr la armonía entre el mayor bienestar de la población, el aprovechamiento de los recursos naturales y la conservación del ambiente.\n\nTodo ello a partir de:\n(a) la localización óptima de las actividades productivas, los asentamientos humanos, las zonas de uso público y recreativo, las redes de comunicación y transporte, las áreas silvestres y otras obras vitales de infraestructura, como unidades energéticas y distritos de riego y avenamiento;\n(b) la orientación del uso sostenible de los elementos del ambiente;\n(c) el desarrollo sostenible equilibrado de las diferentes zonas del país;\n(d) la promoción de la participación activa de los habitantes y la sociedad organizada en la elaboración y aplicación de los planes de ordenamiento territorial y en los planes reguladores de las ciudades.","description_en":"Within the framework of the National Land Use Policy (2012–2040), the National Land Use Plan (PLANOT) 2014–2020 was formulated as a guiding instrument for local, regional, and national action in the field of territorial planning and land use management.\nTerritorial planning in Costa Rica is promoted through the regulation and promotion of human settlements, economic and social activities of the population, and physical-spatial development, aiming to achieve harmony between improved well-being for the population, sustainable use of natural resources, and environmental conservation.\n\nAll of this is based on:\n(a) the optimal location of productive activities, human settlements, public and recreational use areas, communication and transportation networks, wilderness areas, and other vital infrastructure works such as energy units and irrigation and drainage districts;\n(b) the promotion of the sustainable use of environmental elements;\n(c) the balanced and sustainable development of the country’s different regions;\n(d) the encouragement of active participation by citizens and organized civil society in the development and implementation of land-use plans and urban regulatory plans.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:fa4bb4c0-d8e7-4a56-ab8e-cfb36cbac6b9","meta/deprecatedID":"uuid:8f9ee3f3-a477-4f5f-904d-225db2288768","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"fa4bb4c0-d8e7-4a56-ab8e-cfb36cbac6b9","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:25","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:fa4bb4c0-d8e7-4a56-ab8e-cfb36cbac6b9"},{"_id":46445,"start":"2025-11-07T14:25:27.043-04:00","end":"2026-04-06T11:55:18.215-04:00","id_drupal":"20001","country":"blz","theme":"territorial_planning","original_language":"en","name_es":"Política Nacional de Uso del Suelo 2025-2035","name_en":"National Land Use Policy 2025-2035","responsible_institution":[{"responsible_institution/institution":"Ministerio de Recursos Naturales, Petroleo y Minería","responsible_institution/id_institution":"45470","responsible_institution/name_institution":"Ministerio de Recursos Naturales, Petroleo y Minería"}],"instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2035-01-01","effective_today":"yes","temporality":"long_term","description_es":"Falta descripción","description_en":"Falta descripción","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:1fdbcaf6-ed28-4fe3-b49d-0e46f40e6895","meta/deprecatedID":"uuid:0787517f-2abe-4fee-ac42-f2467c389b2b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1fdbcaf6-ed28-4fe3-b49d-0e46f40e6895","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1fdbcaf6-ed28-4fe3-b49d-0e46f40e6895"},{"_id":46446,"start":"2025-11-07T14:25:27.774-04:00","end":"2026-04-06T11:55:47.044-04:00","id_drupal":"20002","country":"bol","theme":"territorial_planning","original_language":"es","name_es":"Plan Sectorial de Desarrollo Integral (PSDI) para Vivir Bien. Sector Vivienda y Urbanismo 2021-2025","name_en":"Sectoral Plan for Integral Development (PSDI) for Living Well Housing and Urbanism Sector 2021-2025","responsible_institution":[{"responsible_institution/institution":"Viceministerio de Vivienda y Urbanismo","responsible_institution/id_institution":"45033","responsible_institution/name_institution":"Viceministerio de Vivienda y Urbanismo"}],"link":"cfd3ccaf-f2f9-4675-86ad-05551cc229d9","primary_link":"https://www.oopp.gob.bo/wp-content/uploads/2023/05/PSDI-MOPSV-VMVU.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","description_es":"Falta descripción","description_en":"Falta descripción","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:c45b56d6-1d7d-47ad-a704-8ed68e1112ba","meta/deprecatedID":"uuid:a54a1132-2fbb-4896-8702-58ad47b7b2fa","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c45b56d6-1d7d-47ad-a704-8ed68e1112ba","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:26","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c45b56d6-1d7d-47ad-a704-8ed68e1112ba"},{"_id":46447,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:28.517","end":"2025-11-07T14:25:28.517","id_drupal":"641","country":"ury","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Uruguay (2016-2018)","name_en":"Third National Open Government Action Plan of Uruguay (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay","responsible_institution/id_institution":"45242","responsible_institution/name_institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","id_coordinator":"45001","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","plan_number":"3","link":"470cec94-653c-41f5-816b-d9535f0a50ca","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Uruguay_3-Plan-Accion_GA_V22.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"En el Plan de Acción Nacional de Gobierno Abierto 2016-2018, Uruguay establece compromisos agrupados en 12 ejes temáticos. Los compromisos que se presentan en este plan, han sido generados total o parcialmente a través del mecanismo de Mesas de Diálogo con la participación de actores de gobierno, sociedad civil y la academia. \nLos 12 ejes temáticos buscan integrar los pilares y valores del Gobierno Abierto (Transparencia, Rendición de Cuentas, Participación y Colaboración Ciudadana e Innovación Tecnológica) en diferentes políticas públicas específicas. Se trabajo sobre temáticas como participación ciudadana, monitoreo de derechos humanos, justicia y anti-corrupción, medio ambiente, empresas, industria y energía, educación, salud, desarrollo social, entre otros. \n\nEl proceso de elaboración del plan se llevó a cabo en varias etapas. Se realizaron talleres de lanzamiento; se convocó y articuló a organismos públicos; se llevaron a cabo mesas de diálogo con la ciudadanía para identificar propuestas; y finalmente los compromisos fueron remitidos a consulta pública. La versión final del plan fue difundida a la ciudadanía.","description_en":"In the 2016-2018 National Action Plan for Open Government, Uruguay sets out commitments grouped into 12 thematic areas. The commitments presented in this plan were generated either fully or partially through the Dialogue Tables mechanism, with the participation of government actors, civil society, and academia.\n\nThe 12 thematic areas aim to integrate the pillars and values of Open Government (Transparency, Accountability, Citizen Participation and Collaboration, and Technological Innovation) into various specific public policies. Topics addressed include citizen participation, human rights monitoring, justice and anti-corruption, the environment, business, industry and energy, education, health, social development, among others.\n\nThe process of creating the plan took place in several stages. Launch workshops were held; public institutions were called and coordinated; dialogue tables with citizens were conducted to identify proposals; and finally, the commitments were sent for public consultation. The final version of the plan was disseminated to the public.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://miradordegobiernoabierto.agesic.gub.uy/SigesVisualizador/gu/o/GA","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b82d2d60-1c52-4efc-8a1b-cfae259ce8e1","meta/deprecatedID":"uuid:fcb85866-c296-4cc7-9dd5-b48132b9124c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b82d2d60-1c52-4efc-8a1b-cfae259ce8e1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:27","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b82d2d60-1c52-4efc-8a1b-cfae259ce8e1"},{"_id":46448,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:29.248","end":"2025-11-07T14:25:29.248","id_drupal":"611","country":"mex","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de México (2013-2015)","name_en":"Second National Open Government Action Plan of Mexico (2013-2015)","responsible_institution":[{"responsible_institution/institution":"Secretaría de la Función Pública de México","responsible_institution/id_institution":"45276","responsible_institution/name_institution":"Secretaría de la Función Pública de México"}],"coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","id_coordinator":"45155","name_coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","plan_number":"2","link":"d0512662-c332-422e-8f02-9e90bd8a9637","primary_link":"https://portal-transparencia.buengobierno.gob.mx/gobierno-abierto/mexico-en-la-alianza-para-el-gobierno-abierto/segundo-plan-de-accion/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2015-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"En este plan de acción se formularon líneas de trabajo bajo cinco grandes objetivos, para promover la transparencia y rendición de cuentas y consolidar un México Abierto: Gobierno centrado en la ciudadanía; Presupuesto abierto y participativo; Datos abiertos para el desarrollo; Empoderamiento y participación ciudadana; Gobernanza de recursos naturales.                                                                                      \n\nSe acordó que la ejecución del plan estaría guiada por una metodología de seguimiento y evaluación que contempla la elaboración de planes de trabajo para cada uno de los compromisos acordados entre funcionarios y organizaciones de la sociedad civil responsables, quienes establecerán metas semestrales e indicadores. Asimismo, se implementaría un Tablero de Control Público para presentar la información de los avances de los compromisos.\n\nEl Plan  se construyó con base en una metodología que asegura la participación y el consenso de distintos sectores de la ciudadanía en diálogo con funcionarios públicos. Así, los compromisos que componen el plan provienen de dos fuentes. Por un lado, se realizaron nueve mesas de trabajo temáticas, en las cuales se convocó a funcionarios públicos, organizaciones de la sociedad civil y actores clave para determinar compromisos en áreas prioritarias. Por otro lado, el Gobierno Federal generó de manera proactiva propuestas de proyectos, de entre los cuales el Secretariado Técnico Tripartito definió cuáles serían incorporados al Plan de Acción.","description_en":"The action plan was formulated around five main objectives to promote transparency and accountability, aiming to consolidate an Open Mexico:\n\nCitizen-centered government\n\nOpen and participatory budgeting\n\nOpen data for development\n\nEmpowerment and citizen participation\n\nGovernance of natural resources\n\nIt was agreed that the execution of the plan would be guided by a methodology for follow-up and evaluation, including the development of work plans for each of the commitments agreed upon by government officials and civil society organizations. These would include semiannual goals and indicators. A Public Control Dashboard would be implemented to present progress on commitments.\n\nThe plan was constructed with a methodology ensuring the participation and consensus of various sectors of society in dialogue with public officials. Thus, the commitments in the plan come from two sources: nine thematic working tables, which convened public officials, civil society organizations, and key actors to determine commitments in priority areas, and proactive proposals by the federal government, from which the Tripartite Technical Secretariat selected the ones to be included in the Action Plan.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://tablero.gobabiertomx.org/","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:5a49cc0b-41e0-4c03-bafd-1728cc822fe3","meta/deprecatedID":"uuid:f21dc27d-58da-46f6-82db-414596fd525c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5a49cc0b-41e0-4c03-bafd-1728cc822fe3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:28","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:5a49cc0b-41e0-4c03-bafd-1728cc822fe3"},{"_id":46449,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:30.071","end":"2025-11-07T14:25:30.071","id_drupal":"624","country":"pry","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Paraguay (2016-2018)","name_en":"Third National Open Government Action Plan of Paraguay (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","id_coordinator":"45441","name_coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","plan_number":"3","link":"bea9a951-0cfd-4492-98ca-b29c58b9e234","primary_link":"https://www.stp.gov.py/v1/wp-content/uploads/2020/03/Plan-de-Accio%CC%81n-de-Gobierno-Abierto-Paraguay-2016-2018.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"En este plan los principales objetivos fueron:\n1- Mejorar la calidad de vida de la gente vinculando el Plan de Acción de Gobierno Abierto con el Plan Nacional de Desarrollo Paraguay 2030 (PND 2030) y los Objetivos de Desarrollo Sostenible de la Agenda 2030;\n2- Aumentar el involucramiento de la Sociedad Civil en el proceso de co-creación y reforzar el principio de participación ciudadana en todos los compromisos del Plan; y\n3- Incluir compromisos que involucren a instituciones del gobierno por fuera del Poder Ejecutivo y a gobiernos regionales.\n\nEl Plan fue co-creado con la participación de organizaciones de la sociedad civil, sector académico, organismos de trabajo internacionales e instituciones públicas. La metodología utilizada promovió la participación ciudadana y posibilitó la construcción de consensos entre los participantes en los grupos temáticos y sesiones de trabajo. Dichos grupos fueron: reducción de pobreza y desarrollo social; educación; salud; ambiente y recursos naturales; seguridad y contraloría ciudadana; acceso a la información pública, datos abiertos y transparencia; continuidad de planes de acción; e inclusión de nuevos actores.\n\nIgualmente para la organización de la convocatoria, teniendo en cuenta la especificidad de las mesas, se elaboró un mapa de actores que ayudó a que en cada mesa estén presentes representantes de la sociedad civil claves de cada tema, instituciones públicas y ciudadanía en general. Los consensos logrados en cada grupo fueron materializados en compromisos, compartidos y puestos a consulta de los participantes y ciudadanía mediante los diferentes canales de difusión utilizados, para luego ser remitidos a la Mesa Conjunta de Gobierno Abierto para su revisión.","description_en":"The main objectives of this plan were:\n\nTo improve the quality of life for people by linking the Open Government Action Plan with Paraguay's National Development Plan 2030 (PND 2030) and the Sustainable Development Goals of the 2030 Agenda.\n\nTo increase the involvement of civil society in the co-creation process and reinforce the principle of citizen participation in all the commitments of the Plan.\n\nTo include commitments that involve government institutions outside the Executive Branch and regional governments.\n\nThe Plan was co-created with the participation of civil society organizations, the academic sector, international work organizations, and public institutions. The methodology used promoted citizen participation and enabled the construction of consensus among participants in thematic groups and working sessions. These groups were: poverty reduction and social development; education; health; environment and natural resources; security and citizen oversight; access to public information, open data, and transparency; continuity of action plans; and inclusion of new actors.\n\nSimilarly, for organizing the call, considering the specificity of the groups, an actor map was created to ensure that each group had representatives from key civil society organizations on each topic, public institutions, and the general public. The consensus reached in each group was materialized in commitments, shared, and put out for consultation with the participants and the public through the different communication channels used. These were then submitted to the Joint Open Government Committee for review.\n","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:0e664202-90ff-4978-8bf8-6ddda706402d","meta/deprecatedID":"uuid:84980eae-6705-4166-9b5c-9e87c74b5306","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0e664202-90ff-4978-8bf8-6ddda706402d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0e664202-90ff-4978-8bf8-6ddda706402d"},{"_id":46450,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:30.789","end":"2025-11-07T14:25:30.789","id_drupal":"626","country":"per","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Perú (2012-2014)","name_en":"First National Open Government Action Plan of Peru (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública","responsible_institution/id_institution":"45341","responsible_institution/name_institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Perú","id_coordinator":"45348","name_coordinator":"Foro Multiactor de Gobierno Abierto de Perú","plan_number":"1","link":"d2f052b0-5ec4-425e-bfc8-ff2b62dabb22","primary_link":"https://cdn.www.gob.pe/uploads/document/file/3124176/I%20Plan%20de%20Acci%C3%B3n%20de%20Gobierno%20Abierto.pdf.pdf?v=1653327645","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"En este Plan se asumen compromisos para mejorar la transparencia y el acceso a al información pública, aumentar la integridad pública, promover la participación ciudadana, así como el gobierno electrónico y mejora de los servicios públicos. El documento fue revisado y actualizado con posterioridad a su presentación.\n\nPara la formulación de compromisos se realizó una convocatoria a entidades expertas en transparencia y rendición de cuentas para la elaboración de propuestas. Asimismo, se creó un grupo de trabajo para la formulación del plan compuesto por organismos públicos y sociedad civil.","description_en":"This Plan includes commitments to improve transparency and access to public information, enhance public integrity, promote citizen participation, and advance e-government and public service delivery. The document was reviewed and updated after its initial release.\n\nTo formulate commitments, expert organizations on transparency and accountability were invited to submit proposals. A working group composed of public bodies and civil society was established to draft the plan.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:68c44769-3b5e-4836-bdee-6f236d4bbf41","meta/deprecatedID":"uuid:143aeadb-c6b8-4541-9340-8a43102e2169","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"68c44769-3b5e-4836-bdee-6f236d4bbf41","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:68c44769-3b5e-4836-bdee-6f236d4bbf41"},{"_id":46451,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:31.514","end":"2025-11-07T14:25:31.514","id_drupal":"619","country":"hnd","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Honduras (2016-2018)","name_en":"Third National Open Government Action Plan of Honduras (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Dirección General de Transparencia y Prevención de la Corrupción","responsible_institution/id_institution":"45252","responsible_institution/name_institution":"Dirección General de Transparencia y Prevención de la Corrupción"}],"coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","id_coordinator":"45152","name_coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","plan_number":"3","link":"b1051dbc-b7f9-433d-bb04-cd0aaac642aa","primary_link":"https://agah.stlcc.gob.hn/wp-content/uploads/2022/10/III-PAGAH-2016-2018-ESspanol.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"En este plan se retoman algunos compromisos del plan anterior. Asimismo, todos los compromisos se encuentran agrupados por temas: Control de la Corrupción, Acceso a la información, Gasto Público, Compras, Recursos Naturales y Ambiente, Servicios Públicos y Gobierno Digital. En términos generales, los compromisos responden a los siguientes desafíos: i) Aumento a la integridad pública; ii) Gestión eficiente y eficaz de los recursos públicos, iii) Mejora de los servicios públicos; y iv) Creación de comunidades más seguras.\n\nHonduras ha desarrollado el III Plan de Acción de Gobierno Abierto 2016-2018 siguiendo el proceso completo de consulta pública con representantes del sector público, privado, académico, sociedad civil y cooperación internacional. De igual manera, se desarrollaron jornadas de sensibilización en las que participaron personas en diferentes ciudades del país. En ellas se compartió información sobre antecedentes, relevancia, principios, desafíos y resultados de la Alianza de Gobierno Abierto en Honduras.\nEl proceso de consultas incluyó reuniones presenciales en siete regiones del país. Posteriormente se realizaron jornadas de socialización del borrador del Plan para obtener retroalimentación ciudadana en la preparación de la versión final. Además, se planificó un foro para consultas periódicas con los actores interesados durante la implementación del plan de acción a cargo del Consejo Interinstitucional de la AGAH.","description_en":"This plan incorporates some commitments from the previous plan. All commitments are grouped by topics: Corruption Control, Access to Information, Public Spending, Procurement, Natural Resources and Environment, Public Services, and Digital Government. In general terms, the commitments address the following challenges: i) Increasing public integrity; ii) Efficient and effective management of public resources; iii) Improvement of public services; and iv) Creation of safer communities.\nHonduras developed the 3rd Open Government Action Plan 2016-2018 following the full public consultation process with representatives from the public, private, academic, civil society sectors, and international cooperation. Similarly, awareness-raising days were held, with participants from different cities in the country. Information about the background, relevance, principles, challenges, and outcomes of the Open Government Partnership in Honduras was shared. The consultation process included in-person meetings in seven regions of the country. Subsequently, socialization days of the draft plan were held to gather citizen feedback for the preparation of the final version. Additionally, a forum was planned for periodic consultations with stakeholders during the implementation of the action plan, led by the Interinstitutional Council of AGAH.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9989e7bc-8f10-4efb-9706-5087fa4a8d56","meta/deprecatedID":"uuid:b467690a-b688-4a20-ae70-ea4f28c3227b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9989e7bc-8f10-4efb-9706-5087fa4a8d56","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:30","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9989e7bc-8f10-4efb-9706-5087fa4a8d56"},{"_id":46452,"start":"2025-11-07T14:25:32.234-04:00","end":"2026-04-08T14:59:01.836-04:00","id_drupal":"1859","country":"per","theme":"open_government","original_language":"es","name_es":"V Plan de Acción de Gobierno Abierto de Perú (2023-2024)","name_en":"Fifth Open Government Action Plan of Peru (2023-2024)","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública","responsible_institution/id_institution":"45341","responsible_institution/name_institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Perú","id_coordinator":"45348","name_coordinator":"Foro Multiactor de Gobierno Abierto de Perú","plan_number":"5","link":"abbd71a5-1311-4b61-aab6-0bab5b616432","primary_link":"https://cdn.www.gob.pe/uploads/document/file/4246942/V%20Plan%20de%20Acci%C3%B3n%20de%20Gobierno%20Abierto.pdf?v=1690410468","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"En los últimos años, Perú ha avanzado hacia un modelo de Estado Abierto, en el que tanto el Poder Ejecutivo como el Legislativo y el Judicial han adoptado compromisos en materia de Gobierno Abierto, y este paradigma ha atravezado todos los niveles de gobierno y los organismos autónomos. Este Quinto Plan de Acción de Perú aborda compromisos de los tres poderes del Estado. \n\nEl proceso de cocreación del plan tuvo cinco etapas: preparatoria; comprensión de problemas; cocreación; validación de compromisos; y aprobación y difusión. En la primera etapa se realizaron elecciones de temáticas, consulta pública e identificación de actores y elaboración de diagnósticos. En la etapa de comprensión de problemas, se llevaron a cabo talleres de discusión de problemas y talleres de lluvia de ideas. En la tercera etapa se desarrollaron talleres de cocreación de compromisos. En la etapa de validación de compromisos se tuvo como objetivo que las entidades a cargo de los compromisos los adecuaran en el formato establecido por la AGA con plazos e indicadores. Por último, la etapa de aprobación y difusión consistía en la elaboración de informes que sustentan la aprobación del plan..","description_en":"In recent years, Peru has advanced toward an Open State model, in which the Executive, Legislative, and Judicial branches have all adopted Open Government commitments. This paradigm has permeated all levels of government and autonomous bodies. Peru’s Fifth Action Plan includes commitments from all three branches of government.\n\nThe plan’s co-creation process followed five stages: preparatory; problem understanding; co-creation; validation of commitments; and approval and dissemination.\n\nThe preparatory stage included topic selection, public consultation, stakeholder identification, and diagnostics.\n\nThe second stage focused on understanding problems through problem discussion workshops and brainstorming sessions.\n\nIn the third stage, co-creation workshops were held to develop commitments.\n\nThe fourth stage involved adapting commitments to the AGA’s standard format, with deadlines and indicators, by the responsible institutions.\n\nThe final stage entailed producing reports to support the plan’s approval and dissemination.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","meta/instanceID":"uuid:144250cf-1491-4291-b800-b3afa28348cf","meta/deprecatedID":"uuid:d3cbba44-127f-4c71-9785-6fa83d57fc31","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"144250cf-1491-4291-b800-b3afa28348cf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:144250cf-1491-4291-b800-b3afa28348cf"},{"_id":46453,"start":"2025-11-07T14:25:32.957-03:00","end":"2025-12-30T12:18:53.471-03:00","id_drupal":"1820","country":"hnd","theme":"public_investment","original_language":"es","name_es":"Programa de Inversión Pública Plurianual 2022-2025","name_en":"Multi-Year Public Investment Program 2022-2025","responsible_institution":[{"responsible_institution/institution":"Dirección General de Inversiones Públicas","responsible_institution/id_institution":"45217","responsible_institution/name_institution":"Dirección General de Inversiones Públicas"}],"link":"c86ca5e7-01f7-4742-9758-5d4c25a1ae25","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"medium_term","description_es":"En observancia de los Artículos 59 y 60 de la Ley Orgánica del Presupuesto, el Programa Plurianual de Inversión Pública, actualizable anualmente, se formula basado en la política de inversión pública que dicte el Poder Ejecutivo e incluye las prioridades, objetivos, resultados, y orientaciones de las asignaciones presupuestarias de las Instituciones Públicas. Es responsabilidad de las UPEGs o Unidades Equivalentes, elaborar el Programa Plurianual de Inversión Pública Institucional que ampare el Plan Anual de Inversiones, con el fin de reflejarlo en el presupuesto del ejercicio fiscal correspondiente. En el Programa Plurianual de Inversión Pública se incluyen aquellos  proyectos de inversión que se asocian con el logro de las prioridades establecidas en los lineamientos de política de inversión acordados por el Gobierno, que cuenten con el Dictamen Técnico o Nota de Prioridad según corresponda y que dispongan de financiamiento asegurado y el portafolio de proyectos estratégicos que requieren de financiamiento para su ejecución.\n\nEl Programa presenta el listado de proyectos de inversión por sector y por institución para los años 2022 al 2025 y los montos asignados a cada uno.","description_en":"In compliance with Articles 59 and 60 of the Organic Budget Law, the Multiannual Public Investment Program, which can be updated annually, is formulated based on the public investment policy established by the Executive Branch. It includes priorities, objectives, outcomes, and budget allocation guidelines for Public Institutions. It is the responsibility of the UPEGs or equivalent units to prepare the Institutional Multiannual Public Investment Program, which supports the Annual Investment Plan, to be reflected in the corresponding fiscal year budget.\nThe Multiannual Public Investment Program includes those investment projects aligned with the priorities defined in the Government's agreed investment policy guidelines, that have a Technical Opinion or Priority Note as applicable, secured funding, and form part of the portfolio of strategic projects requiring financing for execution.\nThe Program includes a list of investment projects by sector and institution for the years 2022 to 2025, along with the amounts allocated to each.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El listado de proyectos indica el nombre de la institución responsable, nombre de proyecto, monto de inversión estimado para cada uno de los años.","pip/pip_project_list_en":"The list of projects indicates the name of the responsible institution, the project name, and the estimated investment amount for each year.","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_costing_es":"El Programa de Inversiones muestra el costeo anual estimado para cada uno de los proyectos de inversión.","pip/pip_costing_en":"The Investment Program shows the estimated annual costing for each of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"El programa de inversión muestra montos de inversión plurianuales indicativos.","pip/pip_budget_en":"The Investment Program shows indicative multi-year investment amounts.","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Inversión Pública de Honduras","link_block/snip_id":"46757","link_block/snip_name":"Sistema Nacional de Inversión Pública de Honduras"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:157ab934-8c8b-4f69-859c-8381cffaeddb","meta/deprecatedID":"uuid:65d61a29-e9ac-4983-b3e4-cac455efaa62","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"157ab934-8c8b-4f69-859c-8381cffaeddb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:32","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:157ab934-8c8b-4f69-859c-8381cffaeddb"},{"_id":46454,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:33.681","end":"2025-11-07T14:25:33.681","id_drupal":"654","country":"pry","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Paraguay (2018-2020)","name_en":"Fourth National Open Government Action Plan of Paraguay (2018-2020)","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","id_coordinator":"45441","name_coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","plan_number":"4","link":"6c79375a-b1c0-4164-89d6-3bf80fe326b1","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2019/01/Paraguay_Action-Plan_2018-2020.docx","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Este documento fue elaborado bajo la coordinación de la Secretaría Técnica de Planificación para el Desarrollo Económico y Social (STP) con el apoyo del Programa de Democracia y Gobernabilidad de la Agencia de los Estados Unidos para el Desarrollo Internacional (USAID/Paraguay) y el Centro de Estudios Ambientales y Sociales (CEAMSO).\n\nParaguay se ha comprometido a implementar los planes de acción nacionales de gobierno abierto como herramientas efectivas para contribuir al logro de los objetivos de la Agenda 2030 para el Desarrollo Sostenible y de los ejes estratégicos del Plan Nacional de Desarrollo Paraguay 2030.\n\nEste cuarto Plan de Acción que presenta Paraguay constituye una plataforma en la que se han cocreado compromisos, introduciendo los principios de gobierno abierto en 17 áreas temáticas, que conforman un amplio espectro de políticas públicas íntimamente vinculados a los objetivos de desarrollo, en el entendimiento de que esos principios, pilares fundamentales de una sociedad democrática, pueden contribuir decisivamente para mejorar la calidad de las políticas públicas. En este plan hay compromisos del Poder Ejecutivo, de órganos constitucionales autónomos, del Poder Judicial y del Parlamento.\n\nEn la cocreación del plan se ha buscado mejorar la calidad de la participación, lo que se ha logrado con la información previa a los participantes a través de intercambios virtuales y documentos distribuidos antes de los talleres presenciales, la respuesta formal del gobierno a cada una de las propuestas presentadas en los talleres, y la selección de los compromisos a través del voto de los participantes. La revisión del plan estuvo a cargo del Comité Evaluador con representación paritaria de gobierno y sociedad civil, electos por la Mesa Conjunta, y la aprobación final estuvo a cargo de la Mesa Conjunta, en reunión con amplia participación de los participantes del proceso, tanto de gobierno como sociedad civil.","description_en":"This document was prepared under the coordination of the Technical Secretariat for Economic and Social Development Planning (STP), with support from USAID/Paraguay’s Democracy and Governance Program and the Center for Environmental and Social Studies (CEAMSO).\n\nParaguay is committed to implementing national Open Government Action Plans as effective tools to advance the Sustainable Development Goals (SDGs) of the 2030 Agenda and the strategic pillars of the Paraguay 2030 National Development Plan.\nThis Fourth Action Plan provides a platform for co-created commitments, introducing open government principles in 17 thematic areas. These cover a broad spectrum of public policies closely tied to development goals, recognizing that such principles—cornerstones of a democratic society—can decisively improve policy quality. This plan includes commitments from the Executive Branch, autonomous constitutional bodies, the Judiciary, and the Parliament.\nEfforts were made to improve the quality of participation during co-creation. Participants received background information in advance via virtual exchanges and distributed documents. The government formally responded to each proposal made during the workshops, and commitments were selected through participant voting. The plan was reviewed by an Evaluation Committee with equal representation from government and civil society—elected by the Joint Roundtable—and final approval was granted in a broadly participatory meeting of both sectors.\n","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de resultados de transición del Mecanismo de Revisión Independiente","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2022/03/Paraguay_Transitional-Results-Report_2018-2020.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:d1bcdffb-a3e6-4972-bca4-a011cc134f5e","meta/deprecatedID":"uuid:6dd85cb6-198f-4c5f-ad79-75cd58411ce7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d1bcdffb-a3e6-4972-bca4-a011cc134f5e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:32","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d1bcdffb-a3e6-4972-bca4-a011cc134f5e"},{"_id":46455,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:34.398","end":"2025-11-07T14:25:34.398","id_drupal":"598","country":"dom","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de República Dominicana (2016-2018)","name_en":"Third National Open Government Action Plan of the Dominican Republic (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana","responsible_institution/id_institution":"45523","responsible_institution/name_institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana"}],"coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","id_coordinator":"44999","name_coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","plan_number":"3","link":"d7d3a929-e7d6-464e-8283-0dd1fca1c835","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2017/05/RepDom_NAP3_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Este Plan de Acción contiene compromisos en distintas áreas temáticas: Salud; Educación; Medio Ambiente; Seguridad Ciudadana; Administración Publica; Transparencia; Tecnología; Gestión Municipal; Justicia; Gestión Legislativa.\n\nSe utilizaron diversos canales para generar una mayor participación y colaboración ciudadana. Entre ellos, consultas presenciales realizadas en gran parte del territorio nacional, redes sociales, correo electrónico, portal de Gobierno Abierto y una consulta online abierta durante todo el periodo de co-creación del Plan. Con la finalidad de hacer la consulta al más amplio nivel, se colocó a disposición del público el cronograma de consultas públicas en el Portal de Gobierno Abierto, así como de las mesas de trabajo sectoriales, y se realizó un despliegue territorial.\n\nEn cada encuentro celebrado fueron utilizadas mesas temáticas y se realizaron ejercicios interactivos en donde los participantes expresaron cuales iniciativas quisieran ver impulsar desde el gobierno en las que se le dé participación a la ciudadanía en la elaboración de políticas públicas y mejoramiento de servicios básicos.\n\nEste plan de acción se articula con la \"Estrategia Nacional de Desarrollo 2010-2030. Un viaje de transformación hacia un país mejor\".","description_en":"This Action Plan contains commitments in various thematic areas: Health, Education, Environment, Citizen Security, Public Administration, Transparency, Technology, Municipal Management, Justice, and Legislative Management. Various channels were used to increase citizen participation and collaboration, including in-person consultations throughout much of the country, social media, email, Open Government portal, and an online consultation during the entire co-creation period. To ensure widespread participation, a schedule of public consultations and sectoral working tables was published on the Open Government Portal, along with territorial outreach. In each meeting, thematic tables were used, and interactive exercises allowed participants to express what initiatives they would like to see promoted by the government in which citizens are involved in policy-making and the improvement of basic services. This action plan is aligned with the “National Development Strategy 2010-2030: A Journey of Transformation Towards a Better Country.”","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:e4413e42-bb87-4474-b0a1-9ea61cd6b213","meta/deprecatedID":"uuid:27a7747c-6478-4f0b-9547-d19eb04cbac9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e4413e42-bb87-4474-b0a1-9ea61cd6b213","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:33","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e4413e42-bb87-4474-b0a1-9ea61cd6b213"},{"_id":46456,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:35.123","end":"2025-11-07T14:25:35.123","id_drupal":"639","country":"col","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Colombia (2015-2017)","name_en":"Second National Open Government Action Plan of Colombia (2015-2017)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Transparencia","responsible_institution/id_institution":"45340","responsible_institution/name_institution":"Secretaría de Transparencia"}],"coordinator":"Comité de Estado Abierto de Colombia","id_coordinator":"45149","name_coordinator":"Comité de Estado Abierto de Colombia","plan_number":"2","link":"98ef7cd6-9657-4301-be85-66293581040c","primary_link":"https://drive.google.com/file/d/1_baj4F6c2c6a1xYGU1hpRvP_aFoacj3W/view","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Este Plan fue construido a partir de los aprendizajes del primer Plan de Acción (2011-2013), y teniendo como referencia el Plan Nacional de Desarrollo 2014-2018 “Todos por un Nuevo País: paz, equidad y educación”, con el liderazgo de la Secretaría de Transparencia (ST) de la Presidencia de la República, bajo las orientaciones del Comité de Seguimiento de la Alianza para el Gobierno Abierto (AGA) de Colombia, y con el apoyo técnico y financiero de la Unión Europea.\n\nEl Plan propone que la aplicación de los principios de transparencia, participación ciudadana y rendición de cuentas contribuya a la inclusión social  y territorial, como nutriente del actual proceso de paz en el país. Acogiendo la propuesta de la sociedad civil, el segundo Plan tiene un foco sectorial, y en este sentido la mayoría de los compromisos se relacionan con alguno de los sectores priorizados: educación, salud, inclusión social, justicia y ambiente. \n\nAdicionalmente, se definió trabajar con una perspectiva territorial, tanto en el sentido de promover que la mayoría de las acciones que concretan los compromisos de las entidades nacionales se lleven a cabo o se materialicen en departamentos y/o municipios del país, como en la dirección de promover el fortalecimiento institucional territorial a partir de la aplicación de los principios AGA.\n\nEl objetivo del Plan, la ruta a seguir en su construcción, el cronograma, las metodologías a aplicar, la estrategia de participación ciudadana, y las tareas de sensibilización y divulgación, fueron definidas en el Comité de Seguimiento AGA Colombia. Se destaca del proceso participativo la realización de una encuesta entre organizaciones sociales para priorizar los temas sectoriales foco del Plan y los ejercicios ciudadanos de retroalimentación del borrador elaborado por las entidades gubernamentales involucradas, a través de siete talleres realizados en distintas regiones del país (Bogotá, Cali, Medellín, Bucaramanga, Montería y Villavicencio), en los que participaron organizaciones sociales, veedores ciudadanos y funcionarios de entidades territoriales y de órganos de control, y a través de la consulta ciudadana en una plataforma virtual.","description_en":"This Plan was developed based on the lessons learned from the first Action Plan (2011–2013), and with reference to the 2014–2018 National Development Plan “Everyone for a New Country: peace, equity, and education.” It was led by the Transparency Secretariat (ST) of the Presidency of the Republic, under the guidance of the Monitoring Committee of the Open Government Partnership (OGP) of Colombia, and with the technical and financial support of the European Union.\n\nThe Plan proposes that the application of the principles of transparency, citizen participation, and accountability contribute to social and territorial inclusion, as a key component of the current peace process in the country. Following a proposal from civil society, the second Plan adopts a sectoral focus, meaning that most of the commitments relate to one of the prioritized sectors: education, health, social inclusion, justice, and environment.\n\nAdditionally, the Plan was designed with a territorial perspective, both in terms of promoting the implementation of most of the actions stemming from national entities' commitments at the departmental and/or municipal level, and in terms of fostering territorial institutional strengthening through the application of OGP principles.\n\nThe objective of the Plan, the roadmap for its development, the timeline, the methodologies to be applied, the citizen participation strategy, and the awareness-raising and outreach tasks were all defined by the OGP Colombia Monitoring Committee. A highlight of the participatory process was the implementation of a survey among social organizations to prioritize the sectoral themes of the Plan, as well as the citizen feedback activities on the draft prepared by the involved government entities. These activities included seven workshops held in different regions of the country (Bogotá, Cali, Medellín, Bucaramanga, Montería, and Villavicencio), with the participation of social organizations, citizen oversight groups, and officials from territorial entities and oversight bodies, as well as a public consultation via an online platform.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://agacolombia.org/planes-de-accion/cuarto-plan/seguimiento-a-la-implementacion-del-plan/","pga/pga_mechanism_text_es":"Informe de revisión del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_text_en":"Colombia Action Plan Review 2020-2022 - Independent Reporting Mechanism","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/07/Colombia_Action-Plan-Review_2020-2022.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:dd42da03-eb46-42c5-af97-bee9948da9dc","meta/deprecatedID":"uuid:3a18f4c9-a821-4d4c-a6bc-73beb02e98f8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dd42da03-eb46-42c5-af97-bee9948da9dc","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dd42da03-eb46-42c5-af97-bee9948da9dc"},{"_id":46457,"start":"2025-11-07T14:25:35.836-03:00","end":"2026-04-06T12:04:40.827-04:00","id_drupal":"20003","country":"bra","theme":"territorial_planning","original_language":"pt","name_es":"Política Nacional de Ordenamiento Territorial de Brasil","name_en":"National Territorial Planning Policy of Brazil","responsible_institution":[{"responsible_institution/institution":"Secretaria Nacional de Políticas de Desarrolo Regional y Territorial","responsible_institution/id_institution":"45160","responsible_institution/name_institution":"Secretaria Nacional de Políticas de Desarrolo Regional y Territorial"},{"responsible_institution/institution":"Grupo de Trabajo Interministerial para la Elaboración de la Propuesta de la Política Nacional de Ordenamiento Territorial (PNOT)","responsible_institution/id_institution":"45183","responsible_institution/name_institution":"Grupo de Trabajo Interministerial para la Elaboración de la Propuesta de la Política Nacional de Ordenamiento Territorial (PNOT)"}],"link":"aae4c318-99de-4d0f-965a-e7ba0f7a10a1","primary_link":"https://www.gov.br/mdr/pt-br/assuntos/desenvolvimento-regional/politica-nacional-de-ordenamento-territorial","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","description_es":"La Política Nacional de Ordenamiento Territorial (PNOT) es una iniciativa inédita del Gobierno Federal de Brasil, actualmente en proceso de formulación. Su objetivo es organizar el uso del territorio nacional de manera estratégica, sostenible y cooperativa, promoviendo la integración entre políticas públicas y reduciendo conflictos sociales, ambientales y económicos.\n\nPrevista en la Constitución Federal de 1988, la PNOT busca establecer una base común para orientar políticas sectoriales que inciden sobre el territorio, como infraestructura, medio ambiente, desarrollo urbano y atención a comunidades tradicionales. La política está siendo desarrollada por un Grupo de Trabajo Interministerial (GTI-PNOT), creado por el Decreto Nº 11.920/2024, con plazo hasta 2026 para presentar una propuesta consolidada.\n\n*Entre sus pilares destacan:*\n• Resiliencia territorial, para fortalecer la capacidad de respuesta de los territorios ante cambios y adversidades.\n• Contratualización territorial, que propone acuerdos entre actores públicos y sociales para gestionar intereses diversos.\n• Planeamiento estratégico, que considera el territorio como un espacio de relaciones sociales, culturales y económicas, más allá de su dimensión física.\n\nLa PNOT representa una política estructurante que busca evitar la superposición de acciones gubernamentales y establecer nuevos paradigmas para la gestión territorial en Brasil.","description_en":"The National Territorial Planning Policy (PNOT) is a groundbreaking initiative by Brazil’s Federal Government, currently under development. Its main goal is to strategically organize the use of national territory in a sustainable and cooperative manner, integrating public policies and reducing social, environmental, and economic conflicts.\n\nEstablished by the 1988 Federal Constitution, the PNOT aims to provide a common framework to guide sectoral policies that affect the territory, such as infrastructure, environment, urban development, and support for traditional communities. The policy is being developed by an Interministerial Working Group (GTI-PNOT), created by Decree No. 11.920/2024, with a deadline to present a consolidated proposal by 2026.\n\n*Key pillars include:*\n• Territorial resilience, to enhance the ability of regions to respond to changes and challenges.\n• Territorial contractualization, promoting agreements among public and social actors to manage diverse and often conflicting interests.\n• Strategic planning, viewing territory not just as land, but as a space of social, cultural, and economic relationships.\n\nThe PNOT is a structuring policy designed to prevent overlapping government actions and introduce new paradigms for territorial governance in Brazil.","linking_sdg_plans":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"articulation","link_block/articulation_link":"Mecanismo de articulación/coordinación entre la planificación sectorial y territorial en Brasil","link_block/articulation_id":"46773","link_block/articulation_name":"Mecanismo de articulación/coordinación entre la planificación sectorial y territorial en Brasil"},{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Decreto Nº 11.920/2024","link_block/external_link_text_en":"Decree No. 11.920/2024","link_block/external_link_text_url":"https://www2.camara.leg.br/legin/fed/decret/2024/decreto-11920-14-fevereiro-2024-795315-publicacaooriginal-171046-pe.html"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:b1240ff1-e229-4a43-873d-bfd457d15c47","meta/deprecatedID":"uuid:7fdfcdb9-3157-4edf-8f8b-9d1aad050b25","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b1240ff1-e229-4a43-873d-bfd457d15c47","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:34","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b1240ff1-e229-4a43-873d-bfd457d15c47"},{"_id":46458,"start":"2025-11-07T14:25:36.556-03:00","end":"2026-04-06T12:52:12.428-04:00","id_drupal":"20008","country":"gtm","theme":"territorial_planning","original_language":"es","name_es":"Política Nacional de Ordenamiento Territorial de Guatemala (PNOT)","name_en":"Guatemala National Land Use Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Agricultura, Ganadería y Alimentación de Guatemala","responsible_institution/id_institution":"45330","responsible_institution/name_institution":"Ministerio de Agricultura, Ganadería y Alimentación de Guatemala"},{"responsible_institution/institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala","responsible_institution/id_institution":"45131","responsible_institution/name_institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala"}],"link":"7d15023d-cd1b-4c3a-a334-19335b101272","primary_link":"https://www.maga.gob.gt/download/Poli%25CC%2581tica-Nacional-de-Ordenamiento-Territorial.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","description_es":"La Política Nacional de Ordenamiento Territorial de Guatemala (PNOT) establece el marco estratégico para orientar la organización, uso y gestión del territorio en el país. Su objetivo es promover un desarrollo territorial equilibrado, sostenible e inclusivo, articulando las políticas sectoriales con la planificación territorial en los distintos niveles de gobierno. La política busca fortalecer la coordinación institucional, reducir las desigualdades territoriales y orientar los procesos de planificación y gestión del suelo, incluyendo instrumentos como los Planes de Desarrollo Municipal y Ordenamiento Territorial (PDM-OT).","description_en":"Guatemala’s National Land Use Policy (PNOT) establishes the strategic framework to guide the organization, use, and management of land in the country. Its objective is to promote balanced, sustainable, and inclusive territorial development by aligning sectoral policies with land use planning at various levels of government. The policy seeks to strengthen institutional coordination, reduce territorial inequalities, and guide land planning and management processes, including instruments such as Municipal Development and Land Use Plans (PDM-OT).","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:c13934c9-9f0e-4c67-a33d-5b6a1885932e","meta/deprecatedID":"uuid:01930a3e-494e-419b-aeab-5a072fe3c697","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c13934c9-9f0e-4c67-a33d-5b6a1885932e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:35","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c13934c9-9f0e-4c67-a33d-5b6a1885932e"},{"_id":46459,"start":"2025-11-07T14:25:37.551-03:00","end":"2026-04-06T12:56:03.556-04:00","id_drupal":"20009","country":"gtm","theme":"territorial_planning","original_language":"es","name_es":"Política Nacional de Vivienda y Asentamientos Humanos 2020-2032 de Guatemala","name_en":"National Housing and Human Settlements Policy 2020–2032","responsible_institution":[{"responsible_institution/institution":"Ministerio de Agricultura, Ganadería y Alimentación de Guatemala","responsible_institution/id_institution":"45330","responsible_institution/name_institution":"Ministerio de Agricultura, Ganadería y Alimentación de Guatemala"},{"responsible_institution/institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala","responsible_institution/id_institution":"45131","responsible_institution/name_institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala"}],"link":"c7684853-d98e-4fe8-805d-f0c69247a3b1","primary_link":"https://portal.segeplan.gob.gt/segeplan/wp-content/uploads/2023/04/Politica-de-Vivienda-y-Asentamientos-Humanos.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2032-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Política Nacional de Vivienda y Asentamientos Humanos 2020-2032 de Guatemala establece el marco estratégico para orientar las acciones del Estado en materia de vivienda, desarrollo urbano y mejoramiento de asentamientos humanos. Su objetivo es garantizar el acceso a una vivienda adecuada y promover el desarrollo ordenado y sostenible de las ciudades y comunidades, mediante la articulación de políticas públicas, la coordinación institucional y el fortalecimiento de la planificación territorial. La política busca reducir el déficit habitacional, mejorar las condiciones de los asentamientos precarios y fomentar soluciones de vivienda accesibles, integradas al desarrollo territorial y urbano del país.","description_en":"Guatemala’s National Housing and Human Settlements Policy 2020–2032 establishes the strategic framework to guide State action in housing, urban development, and the improvement of human settlements. Its objective is to guarantee access to adequate housing and to promote the orderly and sustainable development of cities and communities through the articulation of public policies, institutional coordination, and the strengthening of territorial planning. The policy seeks to reduce the housing deficit, improve conditions in precarious settlements, and foster accessible housing solutions integrated into the country’s territorial and urban development.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:474a921c-c360-4068-8ccd-374ae433c5cc","meta/deprecatedID":"uuid:4da23e97-7bbd-4b11-bba2-49702bdf220c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"474a921c-c360-4068-8ccd-374ae433c5cc","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:36","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:474a921c-c360-4068-8ccd-374ae433c5cc"},{"_id":46460,"start":"2025-11-07T14:25:38.285-03:00","end":"2026-04-06T13:04:02.719-04:00","id_drupal":"20010","country":"mex","theme":"territorial_planning","original_language":"es","name_es":"Programa Nacional de Ordenamiento Territorial y Desarrollo Urbano 2021-2024","name_en":"National Program for Land Use Planning and Urban Development 2021-2024","responsible_institution":[{"responsible_institution/institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)","responsible_institution/id_institution":"45027","responsible_institution/name_institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)"}],"link":"b5386467-3850-48d4-8dd5-24fa7490bd81","primary_link":"https://www.gob.mx/cms/uploads/attachment/file/643102/PNOTDU_VERSION_FINAL_28.05.2021-comprimido.pdf","instrument_type":"program","instrument_type2":"program","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","description_es":"Falta descripción","description_en":"Falta descripción","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:8d06542d-ac4f-4a60-9767-771e4d9cd95a","meta/deprecatedID":"uuid:40edf456-f3c8-4860-840c-af0f62298c08","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8d06542d-ac4f-4a60-9767-771e4d9cd95a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:37","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8d06542d-ac4f-4a60-9767-771e4d9cd95a"},{"_id":46461,"start":"2025-11-07T14:25:39.014-03:00","end":"2026-04-06T12:54:17.849-04:00","id_drupal":"20011","country":"kna","theme":"territorial_planning","original_language":"en","name_es":"Plan Nacional de Desarrollo Físico de Saint Christopher. Visión 2040: Hacia un estado insular sostenible","name_en":"Saint Christopher National Physical Development Plan. Vision 2040: Towards a Sustainable Island State","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Sostenible, Medio Ambiente, Acción Climática y Empoderamiento de Circunscripciones de Saint Kitts y Nevis","responsible_institution/id_institution":"44932","responsible_institution/name_institution":"Ministerio de Desarrollo Sostenible, Medio Ambiente, Acción Climática y Empoderamiento de Circunscripciones de Saint Kitts y Nevis"}],"link":"c2080edf-ac72-45b5-bd18-97f09e6d6fa1","primary_link":"https://www.gov.kn/wp-content/uploads/2024/06/Updated-NPDP-Poster.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"El Saint Christopher National Physical Development Plan. Vision 2040: Towards a Sustainable Island State es el principal instrumento de planificación territorial de Saint Kitts (Saint Christopher). El plan establece una visión de largo plazo para orientar el desarrollo físico y territorial de la isla, promoviendo un uso sostenible del suelo, la protección de los recursos naturales y el desarrollo equilibrado de asentamientos humanos, infraestructura y actividades económicas. Asimismo, busca fortalecer la resiliencia ambiental y climática, mejorar la gestión del territorio y apoyar un modelo de desarrollo sostenible para el país hacia el año 2040.","description_en":"The Saint Christopher National Physical Development Plan. Vision 2040: Towards a Sustainable Island State is the main territorial planning instrument for Saint Kitts (Saint Christopher). The plan establishes a long-term vision to guide the island’s physical and spatial development, promoting sustainable land use, the protection of natural resources, and the balanced development of settlements, infrastructure, and economic activities. It also seeks to strengthen environmental and climate resilience, improve territorial management, and support a sustainable development model for the island towards 2040.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:baca8ac5-ec39-404e-adaf-71ded696b37d","meta/deprecatedID":"uuid:875d743e-66c5-4e7d-bc69-c03ceac376cf","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"baca8ac5-ec39-404e-adaf-71ded696b37d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:38","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:baca8ac5-ec39-404e-adaf-71ded696b37d"},{"_id":46462,"start":"2025-11-07T14:25:39.728-04:00","end":"2026-04-06T13:05:25.688-04:00","id_drupal":"20012","country":"per","theme":"territorial_planning","original_language":"es","name_es":"Lineamientos de política para el Ordenamiento Territorial","name_en":"Policy Guidelines for Land Use Planning","responsible_institution":[{"responsible_institution/institution":"Ministerio del Ambiente (MINAM) de Perú","responsible_institution/id_institution":"45414","responsible_institution/name_institution":"Ministerio del Ambiente (MINAM) de Perú"}],"link":"5172c3f7-9644-41a9-8140-29df6537df15","primary_link":"https://www.minam.gob.pe/ordenamientoterritorial/wp-content/uploads/sites/18/2013/10/Lineamientos-Politica-OT.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2010-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Falta descripción","description_en":"Falta descripción","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:19c879fb-a865-4da0-9414-4a9eab58b270","meta/deprecatedID":"uuid:a899e337-5130-4363-9d8a-e1b450cb664c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"19c879fb-a865-4da0-9414-4a9eab58b270","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:38","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:19c879fb-a865-4da0-9414-4a9eab58b270"},{"_id":46463,"start":"2025-11-07T14:25:40.461-04:00","end":"2026-04-06T12:22:15.030-04:00","id_drupal":"20013","country":"tto","theme":"territorial_planning","original_language":"en","name_es":"Estrategia Nacional de Desarrollo Espacial","name_en":"National Spatial Development Strategy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación y Desarrollo Sostenible de Trinidad y Tabago","responsible_institution/id_institution":"45123","responsible_institution/name_institution":"Ministerio de Planificación y Desarrollo Sostenible de Trinidad y Tabago"}],"link":"30070c64-7502-4668-9125-21b8c77bd85d","primary_link":"https://www.planning.gov.tt/OurTnTOurFuture/documents/Core_Strategy_Regional_Guidance_web.pdf","instrument_type":"strategy","instrument_type2":"strategy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2033-01-01","effective_today":"yes","temporality":"long_term","description_es":"Falta descripción","description_en":"Falta descripción","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:2da2d36b-fbf0-4911-92d4-d6428b5748a2","meta/deprecatedID":"uuid:530cbdc4-20ce-4300-91c2-f4635c1b8a0e","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2da2d36b-fbf0-4911-92d4-d6428b5748a2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:39","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2da2d36b-fbf0-4911-92d4-d6428b5748a2"},{"_id":46464,"start":"2025-11-07T14:25:41.176-04:00","end":"2026-04-08T09:12:50.310-04:00","id_drupal":"100103","country":"bol","theme":"urban_development","original_language":"es","name_es":"Política Nacional de Desarrollo Integral de Ciudades  (PNDIC)","name_en":"National Policy on Comprehensive Urban Development (PNDIC)","responsible_institution":[{"responsible_institution/institution":"Dirección General de Ordenamiento Urbano –DGOU","responsible_institution/id_institution":"45434","responsible_institution/name_institution":"Dirección General de Ordenamiento Urbano –DGOU"}],"link":"483774ad-30be-48de-b159-9f3f06daf82c","primary_link":"https://publicacionesonuhabitat.org/onuhabitatmexico/politica-nacional-desarrollo-integral-ciudades-bolivia.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"subnational","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Fue aprobada en 2024, convirtiéndose en instrumento nacional para la planificación urbana integral. Es un instrumento de alcance nacional que permite establecer una visión común para el desarrollo integral de las áreas urbanas con diversa extensión, población y tasas de crecimiento. A través de esta política, el país puede lograr resultados tangibles en la gobernanza urbana, abordando cuestiones clave de planificación y coordinación intersectorial en beneficio de todo el territorio nacional. La Política Nacional de Desarrollo Integral de Ciudades (PNDIC) es un conjunto coherente, informado y estructurado de objetivos, lineamientos estratégicos y de acción para un proceso de toma de decisiones, derivados del Sector Hábitat y Vivienda del Estado Plurinacional de Bolivia, con el objetivo de lograr la visión de desarrollo del PGDES y el Ordenamiento Territorial (OT).","description_en":"It was approved in 2024, becoming the national instrument for comprehensive urban planning. It is a nationwide instrument that establishes a shared vision for the integrated development of urban areas of varying size, population, and growth rates. Through this policy, the country can achieve tangible results in urban governance, addressing key issues of planning and intersectoral coordination for the benefit of the entire national territory.\n\nThe National Policy for the Integral Development of Cities (PNDIC) is a coherent, informed, and structured set of objectives, strategic guidelines, and actions for a decision-making process derived from the Habitat and Housing Sector of the Plurinational State of Bolivia, aimed at achieving the development vision established in the Economic and Social Development Plan (PGDES) and Territorial Planning (OT).","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:d5b7afd1-e63a-442d-96cc-8089e7513bcf","meta/deprecatedID":"uuid:cba3bc15-f047-4f16-bbdc-31506f6984cf","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d5b7afd1-e63a-442d-96cc-8089e7513bcf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:40","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d5b7afd1-e63a-442d-96cc-8089e7513bcf"},{"_id":46465,"start":"2025-11-07T14:25:41.904-03:00","end":"2026-01-09T09:02:00.529-03:00","id_drupal":"1737","country":"chl","theme":"mobility","original_language":"es","name_es":"Plan maestro de transporte de Santiago 2025","name_en":"Master Transportation Plan of Santiago 2025","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Transportes/ Programa de Vialidad y Transporte Urbano SECTRA","responsible_institution/id_institution":"44960","responsible_institution/name_institution":"Subsecretaría de Transportes/ Programa de Vialidad y Transporte Urbano SECTRA"}],"primary_link":"https://www.mtt.gob.cl/wp-content/uploads/2014/02/plan_maestro_2025_2.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Área Metropolitana de Santiago","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","description_es":"Generar un programa coordinado de proyectos de los distintos modos e instituciones que satisfaga los siguientes objetivos: Eficiencia: se trata de ofrecer la mejor movilidad en el marco de los recursos disponibles, cuidando el aumento en consumo de energía y espacio destinado a la vialidad,  reduciendo las emisiones y los accidentes. Este objetivo apunta a fortalecer el transporte público y recomienda el crecimiento de la ciudad alrededor de ejes de transporte masivo. Equidad: los beneficios de la movilidad deben estar gradualmente al alcance de todos, superando diferencias en la provisión de acceso y servicios. Apunta a velar por un nivel de accesibilidad homogéneo en todos los puntos de la ciudad y proteger formas vulnerables de transporte como la caminata y la bicicleta. Sustentabilidad: un buen sistema de transporte es sustentable en tres dimensiones: ambiental, a través del control de emisiones y consumo de combustibles; económica, asegurando la viabilidad financiera de los servicios, y social, cuidando que el grado de aceptación del sistema no se deteriore. Seguridad: incorporando en las propuestas de diseño y gestión, elementos que permitan reducir los índices de accidentes y los costos asociados a sus impactos, que a la fecha alcanzan un nivel equivalente a 1,5% del PIB.","description_en":"Generate a coordinated program of projects across different modes and institutions to achieve the following objectives:\n\nEfficiency: provide the best mobility within available resources, limit increased energy consumption and road use, reduce emissions and accidents. Strengthen public transport and recommend urban growth along mass transit axes.\n\nEquity: mobility benefits must be gradually accessible to all, bridging access and service provision gaps. Ensure homogeneous accessibility citywide and protect vulnerable transport modes like walking and cycling.\n\nSustainability: a good transport system is sustainable in three dimensions: environmental (emission and fuel control), economic (financial viability), and social (public system acceptance).\n\nSafety: design and management proposals must include elements to reduce accident rates and their socioeconomic costs, currently equal to 1.5% of GDP.","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"Es deseable apoyar el uso de modalidades de transporte que no produzcan contaminación local, en particular la bicicleta, motocicleta y automóvil eléctrico; una forma de apoyo es privilegiar su uso en los primeros años para acelerar su adopción. (54) - Se está estudiando además la factibilidad de incorporar a la flota Transantiago buses híbridos y eléctricos que aportarían a disminuir las emisiones. (82) - Se propone adoptar una política de fomento y apoyo al uso de vehículos eléctricos de dos ruedas (especialmente bicicletas), creando puntos de recarga pagados y privilegiados (104) - Bus Eléctrico año 2020 (Para la situación del Plan se considera como medida 10% de flota al año 2025). (133)\"","pmu/pmu_implementation_en":"It is desirable to support the use of modes of transport that do not produce local pollution, in particular bicycles, motorcycles and electric cars; One form of support is to privilege its use in the early years to accelerate its adoption. (54) - The feasibility of incorporating hybrid and electric buses into the Transantiago fleet is also being studied, which would contribute to reducing emissions. (82) - It is proposed to adopt a policy to promote and support the use of electric two-wheeled vehicles (especially bicycles), creating paid and privileged charging points (104) - Electric Bus year 2020 (For the situation of the Plan, 10% of fleet by 2025 is considered as a measure). (133)\"","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"En referencia al transporte público se considera el Metro donde se propone ampliar la red - Trenes suburbanos : El Plan Maestro contempla ampliar la red de servicios de tren de cercanía por su poder estructurante. (p.73) - Sobre el sistema de BRT no se plantea ningún proyecto en concreto. La componente ciclovía del PMTS 2025, se basa en el estudio desarrollado por el Gobierno Regional Metropolitano (p110) El Plan Maestro no contempla proyectos de infraestructura específicos para este tipo de servicio, pero sí lineamientos de política y definiciones básicas a seguir (p.89) La propuesta planteada por el PMTS 2025 es que en los proyectos de transporte se trate la caminata como un modo más y sea considerada explícitamente al momento de diseñar infraestructura en zonas urbanas consolidadas y potenciales. (p109)","pmu/pmu_prioritization_en":"In reference to public transport, the Metro is considered where it is proposed to expand the network - Suburban trains: The Master Plan contemplates expanding the network of commuter train services due to its structuring power. (p.73) - No specific project is proposed on the BRT system. The bike path component of the PMTS 2025 is based on the study developed by the Metropolitan Regional Government (p110) The Master Plan does not contemplate specific infrastructure projects for this type of service, but it does contemplate policy guidelines and basic definitions to be followed (p.89) The proposal put forward by the PMTS 2025 is that in transport projects the walk is treated as one more mode and is explicitly considered when designing infrastructure in consolidated and potential urban areas. (p109)","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","pmu/pmu_budget":"11317826615","meta/instanceID":"uuid:aeeb387b-7150-41c2-aa69-240ace96bd35","meta/deprecatedID":"uuid:0853f076-c90a-4d84-a567-a55302948f8f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"aeeb387b-7150-41c2-aa69-240ace96bd35","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:40","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:aeeb387b-7150-41c2-aa69-240ace96bd35"},{"_id":46466,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:42.632","end":"2025-11-07T14:25:42.632","id_drupal":"2056","country":"per","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de La Libertad 2018-2020","name_en":"Second Open Government Action Plan of La Libertad 2018-2020","responsible_institution":[{"responsible_institution/institution":"Subgerencia de Tecnologías de la Información de La Libertad","responsible_institution/id_institution":"45296","responsible_institution/name_institution":"Subgerencia de Tecnologías de la Información de La Libertad"}],"coordinator":"Consejo Regional de Gobierno Abierto de La Libertad","id_coordinator":"45080","name_coordinator":"Consejo Regional de Gobierno Abierto de La Libertad","plan_number":"2","link":"5b1f089a-e33b-4038-84d2-2bd3afb05fc3","primary_link":"https://gobiernoabierto.regionlalibertad.gob.pe/plan-de-accion-documentos/321-plan-de-accion-de-gobierno-abierto-de-la-libertad-2018-2020/file","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Región La Libertad","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"La Libertad se unió a  Alianza para el Gobierno Abierto  en 2016. El segundo plan de acción presenta compromisos relacionados con la participación ciudadana, el fortalecimiento de la sociedad civil, la alfabetización digital y la anemia y la desnutrición en los niños.","description_en":"La Libertad joined the Open Government Partnership in 2016. Its second action plan includes commitments related to citizen participation, strengthening civil society, digital literacy, and addressing childhood anemia and malnutrition.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:cdff626e-4e9e-47be-b058-b84592d69135","meta/deprecatedID":"uuid:65ae915b-3b59-476a-8773-ef32c0436577","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"cdff626e-4e9e-47be-b058-b84592d69135","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:41","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:cdff626e-4e9e-47be-b058-b84592d69135"},{"_id":46467,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:43.359","end":"2025-11-07T14:25:43.359","id_drupal":"620","country":"gtm","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Guatemala (2012-2014)","name_en":"First National Open Government Action Plan of Guatemala (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"44996","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"1","link":"3e064d74-7d84-407b-921b-2486af8ae071","primary_link":"https://gobiernoabierto.transparencia.gob.gt/wp-content/uploads/guatemala_plan_de_accion_2012.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Guatemala presentó un Plan de Acción centrado en la agilización de la administración pública y el combate contra la corrupción. En el país, la transparencia ha sido un pilar fundamental en las políticas públicas para combatir la corrupción y es, a la vez, una condición necesaria para implementar los Acuerdos de Paz firmados en 1996.","description_en":"Guatemala presented an action plan focused on streamlining public administration and combating corruption. Transparency has been a key element of public policies to fight corruption, and is also a necessary condition for implementing the Peace Accords signed in 1996. ","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Guatemala_final_2012.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b8c48577-8d77-4258-8776-9c0310266dce","meta/deprecatedID":"uuid:65d6dd26-ce80-4741-b6f0-d73a3aba6982","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b8c48577-8d77-4258-8776-9c0310266dce","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b8c48577-8d77-4258-8776-9c0310266dce"},{"_id":46468,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:44.173","end":"2025-11-07T14:25:44.173","id_drupal":"2166","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Jalisco 2016-2018","name_en":"First Open Government Action Plan of Jalisco 2016-2018","responsible_institution":[{"responsible_institution/institution":"Instituto de Transparencia, Información Pública y Protección de Datos Personales","responsible_institution/id_institution":"45109","responsible_institution/name_institution":"Instituto de Transparencia, Información Pública y Protección de Datos Personales"}],"coordinator":"Secretariado Técnico de Gobierno Abierto de Jalisco","id_coordinator":"45466","name_coordinator":"Secretariado Técnico de Gobierno Abierto de Jalisco","plan_number":"1","link":"35748080-5d1e-41c6-893d-bd6515b556c9","primary_link":"https://www.chihuahua1071.com/webs/2025/gobiernoabiertojalisco.org.mx/v2/wp-content/uploads/2021/11/1er_PAL_GA_JALISCO.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Jalisco","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Jalisco se unió a  Alianza para el Gobierno Abierto como parte de la cohorte 2020.El primer plan de acción incluye compromisos relacionados con  anticorrupción e integridad,  prestación de servicios públicos, trabajo y género.","description_en":"Jalisco joined the Open Government Partnership as part of the 2020 Cohort. The first action plan includes commitments related to anti-corruption and integrity, public service delivery, work, and gender.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:dcbbf824-0e75-4a6a-86b2-5eb6902031b4","meta/deprecatedID":"uuid:9e0e86df-c847-4aea-b7e8-5b74b553090d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dcbbf824-0e75-4a6a-86b2-5eb6902031b4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dcbbf824-0e75-4a6a-86b2-5eb6902031b4"},{"_id":46469,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:44.899","end":"2025-11-07T14:25:44.899","id_drupal":"2167","country":"mex","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Jalisco 2019-2021","name_en":"Second Open Government Action Plan of Jalisco 2019-2021","responsible_institution":[{"responsible_institution/institution":"Instituto de Transparencia, Información Pública y Protección de Datos Personales","responsible_institution/id_institution":"45109","responsible_institution/name_institution":"Instituto de Transparencia, Información Pública y Protección de Datos Personales"}],"coordinator":"Secretariado Técnico de Gobierno Abierto de Jalisco","id_coordinator":"45466","name_coordinator":"Secretariado Técnico de Gobierno Abierto de Jalisco","plan_number":"2","link":"3809e7d4-720f-41cd-ab4d-6c79c500255d","primary_link":"https://www.chihuahua1071.com/webs/2025/gobiernoabiertojalisco.org.mx/v2/wp-content/uploads/2022/02/Segundo-Plan-de-Accion-Local-2019-2020-de-Gobierno-Abierto-Jalisco-VF-1.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Jalisco","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Jalisco se unió a  Alianza para el Gobierno Abierto como parte de la cohorte 2020.El segundo plan de acción incluye compromisos relacionados con anticorrupción e integridad, espacio cívico,  prestación de servicios públicos, participación ciudadana y datos abiertos.","description_en":"Jalisco joined the Open Government Partnership as part of the 2020 Cohort. The second action plan includes commitments related to anti-corruption and integrity, civic space, public service delivery, citizen participation, and open data.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:365ce05b-fd67-42db-9fce-c5a971d8b542","meta/deprecatedID":"uuid:3cce05e1-8858-41eb-83e1-7eb1c9b1aaa3","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"365ce05b-fd67-42db-9fce-c5a971d8b542","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:365ce05b-fd67-42db-9fce-c5a971d8b542"},{"_id":46470,"start":"2025-11-07T14:25:45.627-04:00","end":"2026-04-15T16:40:40.147-04:00","id_drupal":"2049","country":"mex","theme":"open_government","original_language":"es","name_es":"3er Plan de Acción de Gobierno Abierto de Jalisco 2021-2024","name_en":"Third Open Government Action Plan of Jalisco 2021-2024","responsible_institution":[{"responsible_institution/institution":"Instituto de Transparencia, Información Pública y Protección de Datos Personales","responsible_institution/id_institution":"45109","responsible_institution/name_institution":"Instituto de Transparencia, Información Pública y Protección de Datos Personales"}],"coordinator":"Secretariado Técnico de Gobierno Abierto de Jalisco","id_coordinator":"45466","name_coordinator":"Secretariado Técnico de Gobierno Abierto de Jalisco","plan_number":"3","link":"682337fe-fb76-4fc0-a37c-6cd3ced8c545","primary_link":"https://www.gobiernoabiertojalisco.org.mx/v2/wp-content/uploads/2022/02/Tercer-Plan-de-Accion-Local-2020-2021VF.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Jalisco","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"Jalisco se unió a  Alianza para el Gobierno Abierto como parte de la cohorte 2020.El tercer plan de acción incluye compromisos relacionados con transparencia y control de la corrupción, y fortalecimiento de la participación ciudadana.","description_en":"Jalisco joined the Open Government Partnership as part of the 2020 Cohort. The third action plan includes commitments related to transparency and corruption control, and strengthening citizen participation.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:c58e7c48-8ac4-41b4-8609-eb9d5edbc861","meta/deprecatedID":"uuid:9467b8dd-2115-411e-a4fc-d3d01ea267d5","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c58e7c48-8ac4-41b4-8609-eb9d5edbc861","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:45","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c58e7c48-8ac4-41b4-8609-eb9d5edbc861"},{"_id":46471,"start":"2025-11-07T14:25:47.319-04:00","end":"2026-04-06T12:53:20.654-04:00","id_drupal":"725","country":"cri","theme":"territorial_planning","original_language":"es","name_es":"Política Nacional de Ordenamento Territorial 2012 a 2040","name_en":"National Territorial Planning Policy of Costa Rica 2012 a 240","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica","responsible_institution/id_institution":"44992","responsible_institution/name_institution":"Ministerio de Vivienda y Asentamientos Humanos de Costa Rica"}],"link":"63032553-047b-47b2-aee0-d1e3468348f8","primary_link":"https://www.mivah.go.cr/Documentos/politicas_directrices_planes/pnot/PNOT_2012-2040.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"La  Política de Nacional de Ordenamiento Territorial (2012-2040) presenta lineamientos en tres ejes de desarrollo territorial que buscan afianzar el principio del bien común sobre el interés particular:\n\n1. Calidad del hábitat: Cuyos lineamientos buscan sentar las bases para la gestión de asentamientos humanos, seguros y poli funcionales en el marco de ciudades compactas y planificadas.\n\n2. Protección y Manejo Ambiental: Eje que busca armonizar las diversas actividades humanas con el ambiente y a través de sus lineamientos responder a coyunturas globales como el cambio climático, la degradación del suelo y la diversidad biológica.\n\n3. Competitividad territorial: Basada en el fortalecimiento de las capacidades locales, la promoción de la tecnología y la reforma legal que nos permita tener normas que permitan una gestión territorial ágil y contemporánea.\n\nEsta Política busca integrar un marco de objetivos comunes entre una serie de actores institucionales y al mismo tiempo, constituir una guía para la planificación estratégica del territorio costarricense, con una perspectiva de largo plazo y coordinación interinstitucional.\n\n \n\nEstos objetivos comunes están asociados a un conjunto de “metas país” a corto, mediano y largo plazo, las cuales están relacionadas con una serie de temas, que engloban los lineamientos estratégicos que son expresados de forma operativa en el Plan Nacional de Ordenamiento Territorial (PLANOT). El PLANOT actúa como el instrumento interinstitucional para la coordinación de agendas y acciones legales, administrativas y financieras.","description_en":"The National Land-Use Policy (2012–2040) sets out guidelines across three territorial development pillars aimed at reinforcing the principle of the common good over individual interests:\n\n1. Habitat quality: This pillar provides guidelines to lay the foundation for managing safe, multifunctional human settlements within the framework of compact, planned cities.\n2. Environmental protection and management: This axis seeks to harmonize human activities with the environment, with guidelines designed to respond to global challenges such as climate change, soil degradation, and biodiversity loss.\n3. Territorial competitiveness: Based on strengthening local capacities, promoting technology, and advancing legal reforms to enable agile and modern land-use management.\n\nThis Policy aims to establish a framework of shared objectives among various institutional actors and, at the same time, serve as a guide for the strategic planning of Costa Rica’s territory, with a long-term perspective and interinstitutional coordination.\n\nThese shared objectives are linked to a set of short-, medium-, and long-term “national goals,” which address a range of issues encompassed by the strategic guidelines, and are operationalized through the National Land-Use Plan (PLANOT). PLANOT functions as the interinstitutional instrument for coordinating legal, administrative, and financial agendas and actions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:57564766-8176-4e60-aa08-6210b4f7959a","meta/deprecatedID":"uuid:909dbdaa-c52c-4bb4-9bb1-a1bad4b5b777","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"57564766-8176-4e60-aa08-6210b4f7959a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:57564766-8176-4e60-aa08-6210b4f7959a"},{"_id":46472,"start":"2025-11-07T14:25:48.041-03:00","end":"2025-12-30T12:29:52.504-03:00","id_drupal":"1371","country":"per","theme":"public_investment","original_language":"es","name_es":"Programa Multianual de Inversiones del Estado (PMIE) 2021-2023 de Perú","name_en":"Multi-Year State Investment Program (PMIE) 2021-2023 of Peru","responsible_institution":[{"responsible_institution/institution":"Dirección General de Programación Multianual de Inversiones","responsible_institution/id_institution":"45385","responsible_institution/name_institution":"Dirección General de Programación Multianual de Inversiones"}],"link":"7a353dd6-97c7-401c-9e15-2e8b9f35157a","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"La Dirección General de Programación Multianual de Inversiones elabora anualmente el Programa Multianual de Inversiones del Estado (PMIE) con un horizonte de 3 años, este programa integra todos los Programas Multianuales de Inversiones (PMI). Los PMI, son elaborados por las Oficinas de Programación Multianual de Inversiones del Sector, Gobierno Regional o Gobierno Local. El listado de proyectos muestra la cartera completa de los proyectos de inversión indicando detalles generales como entidad responsable, fase actual del proyecto, el monto total de inversión, programación anual de inversiones, código único de inversiones, y presupuesto devengado (en el caso de los proyectos de arrastre). Como parte de su proceso de construcción los sectores identifican brechas en infraestructura y acceso a servicios, y a partir de este análisis establecen metas multianuales en el cierre de dichas brechas. Este diagnóstico permite también establecer criterios de priorización sectoriales que asignan un valor numérico a cada uno de los criterios y así poder dar un orden de prioridad a los proyectos que integran el PMI. Estos criterios son utilizados por los Gobiernos Regionales y Locales de acuerdo con los sectores de que se traten los proyectos que integran sus propios PMI.\n\nEl PMIE 2021-2023 destaca las brechas más importantes identificadas por cada uno de los sectores, los criterios de priorización por sector. Este documento también ofrece un análisis detallado de la composición de la cartera de inversión pública tales como inversiones programadas según nivel de gobierno, inversiones programadas según función, inversiones programadas según tipo de inversión, inversiones programadas según su función por departamento. El documento principal del PMIE, contiene un listado con las 5 inversiones más importantes de los sectores representativos (Transporte, educación, salud, saneamiento, agropecuario y energía), incluyendo una breve descripción del proyecto, monto total programado, y monto programado para el periodo 2021-2023. La siguiente sección presenta un análisis de las inversiones por sector vinculadas a las principales brechas identificadas, y la proyección estimada en el cierre de brechas conforme las inversiones se materialicen.","description_en":"The General Directorate of Multiannual Investment Programming prepares the State Multiannual Investment Program (PMIE) annually, with a three-year outlook. This program integrates all Multiannual Investment Programs (PMIs), which are prepared by the Multiannual Investment Programming Offices at the sectoral, regional, or local government level.\nThe project list includes the full portfolio of investment projects, indicating general details such as responsible entity, current project phase, total investment amount, annual investment programming, unique investment code, and budget executed (in the case of continuing projects).\nAs part of its formulation process, sectors identify infrastructure and service access gaps, and based on this analysis, establish multiannual targets for closing such gaps. This diagnostic also informs the definition of sector-specific prioritization criteria, assigning numerical values to each criterion to rank project priority within each PMI. These criteria are used by Regional and Local Governments depending on the sectors covered by their respective PMIs.\nThe 2021–2023 PMIE highlights the most important gaps identified by each sector and their prioritization criteria. It also provides a detailed analysis of the public investment portfolio composition, including investments programmed by level of government, by function, by type of investment, and by function by department. The main PMIE document includes a list of the five most important investments in key sectors (transportation, education, health, sanitation, agriculture, and energy), including a brief project description, total programmed amount, and amount programmed for 2021–2023. The next section presents an analysis of sectoral investments linked to the main identified gaps and projected gap closure as investments are realized.","linking_sdg_plans":"yes","pip/pip_project_list":"yes","pip/pip_project_list_es":"El listado de proyectos detalla el nombre del proyecto, código único de inversiones, costo total de la inversión, y programación anual de la inversión (horizonte de 3 años), presupuesto devengado.","pip/pip_project_list_en":"The list of projects details the project name, unique investment code, total investment cost, annual investment programming (three-year horizon), and the accrued budget.","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_costing_es":"El Programa de Inversiones muestra el costeo total individual de los proyectos de inversión.","pip/pip_costing_en":"The Investment Program shows the total individual costing of the investment projects.","pip/pip_budget":"yes","pip/pip_budget_es":"El programa de inversión contempla presupuesto asignado para el primer año y proyectado para los años subsecuentes.","pip/pip_budget_en":"The investment program includes an allocated budget for the first year and projected budgets for subsequent years.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El Programa Multianual de Inversiones del Estado PMIE detalla las principales inversiones públicas por departamento.","pip/pip_territorialization_en":"The State Multiannual Investment Program (PMIE) details the main public investments by department.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"Cada Ministerio establece sus propios criterios de priorización sectoriales, a partir de esto se elabora una lista de priorización de los proyectos de inversión nuevos, con un puntaje asignado a cada proyecto de acuerdo al cumplimiento de los criterios de priorización.","pip/pip_priorization_en":"Each Ministry establishes its own sectoral prioritization criteria. Based on these, a prioritized list of new investment projects is prepared, with a score assigned to each project according to its compliance with the prioritization criteria.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"snip","link_block/snip_link":"Sistema Nacional de Programación Multianual y Gestión de Inversiones - Invierte.pe de Perú","link_block/snip_id":"46762","link_block/snip_name":"Sistema Nacional de Programación Multianual y Gestión de Inversiones - Invierte.pe de Perú"}],"__version__":"vLkfVRQgpZUqPYUdunwjBx","meta/instanceID":"uuid:7408cab3-4112-4288-98d0-484c96d8b6bf","meta/deprecatedID":"uuid:5bbea664-401c-42ef-b5ab-382df0880241","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7408cab3-4112-4288-98d0-484c96d8b6bf","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7408cab3-4112-4288-98d0-484c96d8b6bf"},{"_id":46473,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:48.754","end":"2025-11-07T14:25:48.754","id_drupal":"609","country":"mex","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de México (2011-2013)","name_en":"First National Open Government Action Plan of Mexico (2011-2013) ","responsible_institution":[{"responsible_institution/institution":"Secretaría de la Función Pública de México","responsible_institution/id_institution":"45276","responsible_institution/name_institution":"Secretaría de la Función Pública de México"}],"coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","id_coordinator":"45155","name_coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","plan_number":"1","link":"4ac3a0d2-4ef6-4121-a35a-2604ff17a0fe","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2017/05/Mexico_Action_Plan_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2011-01-01","validity_applies_until":"yes","effective_until":"2013-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"La elaboración de este plan se desarrolló en dos fases. La primer versión del plan se presentó en 2011, pero solo incluyó unas pocas recomendaciones de la sociedad civil. Es por ello que se formuló una segunda versión del plan, en la cual se trabajó de forma colaborativa con la sociedad civil, a través del Secretariado Técnico Tripartito.","description_en":"This plan was developed in two phases. The first version of the plan was presented in 2011, but it only included a few recommendations from civil society. Therefore, a second version of the plan was formulated, working collaboratively with civil society through the Tripartite Technical Secretariat.\n","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://tablero.gobabiertomx.org/","pga/pga_mechanism_text_es":"Informe del mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:dff50803-7aeb-4e25-b8c4-426a5e4c7f9b","meta/deprecatedID":"uuid:51f67d97-f1ab-458f-93c2-b2f83690230f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dff50803-7aeb-4e25-b8c4-426a5e4c7f9b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dff50803-7aeb-4e25-b8c4-426a5e4c7f9b"},{"_id":46474,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:49.475","end":"2025-11-07T14:25:49.475","id_drupal":"615","country":"hnd","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Honduras (2012-2014)","name_en":"First National Open Government Action Plan of Honduras (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Dirección General de Transparencia y Prevención de la Corrupción","responsible_institution/id_institution":"45252","responsible_institution/name_institution":"Dirección General de Transparencia y Prevención de la Corrupción"}],"coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","id_coordinator":"45152","name_coordinator":"Mesa Técnica de Seguimiento de la Alianza de Gobierno Abierto de Honduras","plan_number":"1","link":"9a5bf108-e806-419e-930d-5d9e9fecf140","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"La elaboración de este primer Plan de Acción de Gobierno Abierto tiene por objetivo definir metas de corto plazo, así como otras de más largo alcance del Gobierno de Honduras orientadas  sobre los principios generales impulsados por la Alianza para el Gobierno Abierto (AGA). Los tres ejes sobre los que se construyeron los compromisos del Plan son: aumento de la integridad pública, administración efectiva de los recursos públicos y mejora de los servicios públicos.\n\nLa sociedad civil participó en la propuesta de ciertos compromisos del plan y durante la implementación de los mismos. El gobierno hizo uso de espacios consultivos\nformales e informales con representantes de las partes interesadas.\n\nEl plan de acción se encuentra enmarcado en los principios orientadores y objetivos nacionales de la \"Visión de País 2010- 2038 y el Plan de Nación 2010-2022\".","description_en":"The development of this first Open Government Action Plan aims to define short-term goals, as well as more long-term goals for the Government of Honduras, oriented toward the general principles promoted by the Open Government Partnership (OGP). The three pillars on which the plan’s commitments were built are: increasing public integrity, effective management of public resources, and improving public services.\nCivil society participated in proposing certain commitments of the plan and during their implementation. The government used formal and informal consultative spaces with representatives of stakeholders.\n\nThe action plan is framed within the guiding principles and national objectives of the \"Country Vision 2010-2038 and the National Plan 2010-2022.\"","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Honduras_final_web_2012_0.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:996f70bd-ad40-4f25-882b-5656c5f79a02","meta/deprecatedID":"uuid:54056a91-a24e-448a-b6c2-a22d19e7667e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"996f70bd-ad40-4f25-882b-5656c5f79a02","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:48","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:996f70bd-ad40-4f25-882b-5656c5f79a02"},{"_id":46475,"start":"2025-11-07T14:25:50.199-03:00","end":"2025-11-11T13:11:09.299-03:00","id_drupal":"2296","country":"bra","theme":"open_government","original_language":"pt","name_es":"Sexto Plan de Acción Nacional de Gobierno Abierto de Brasil (2023-2027)","name_en":"Sixth National Open Government Action Plan of Brazil (2023-2027)","responsible_institution":[{"responsible_institution/institution":"Secretaria de Transparencia y Prevensión de la Corrupción","responsible_institution/id_institution":"45014","responsible_institution/name_institution":"Secretaria de Transparencia y Prevensión de la Corrupción"}],"coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","id_coordinator":"45002","name_coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","plan_number":"6","link":"de5d804f-77dd-49b6-90c0-9b0af2acf4e5","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"La elaboración del Sexto Plan de Acción Nacional se basó en la metodología adoptada en los tres planes anteriores, la cual comprende tres fases de trabajo: i) Definición de Temas; ii) Talleres de Cocreación; y iii) Aprobación del Plan. Los temas fueron seleccionados en dos categorías: aquellos priorizados por el gobierno federal y los propuestos por la sociedad civil. Los talleres de cocreación fueron reuniones colaborativas que contaron con la participación de 155 personas, en representación de 80 instituciones, entre ellas 47 organizaciones de la sociedad civil y 33 entidades gubernamentales.","description_en":"The development of the 6th National Action Plan was based on the methodology adopted in the last three plans, which includes three work phases: i) Themes Definition; ii) Co-creation Workshops; and iii) Approval of the Plan. The themes were selected into two categories, those prioritized by the federal government, and those indicated by civil society. The cocreation workshops were collaborative meetings involving 155 people representing 80 institutions, 47 civil society organizations and 33 government entities.","linking_sdg_plans":"no","__version__":"vSXeMtyk63M8JxuiLGRBWU","meta/instanceID":"uuid:4f1e30cd-7b22-4b33-8343-2663ba79cc48","meta/deprecatedID":"uuid:1da1b23c-8b44-4475-a51c-c0d3825e942e","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4f1e30cd-7b22-4b33-8343-2663ba79cc48","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:49","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4f1e30cd-7b22-4b33-8343-2663ba79cc48"},{"_id":46476,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:50.920","end":"2025-11-07T14:25:50.920","id_drupal":"2171","country":"per","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de La Libertad 2016-2017","name_en":"First Open Government Action Plan of La Libertad 2016-2017","responsible_institution":[{"responsible_institution/institution":"Gobierno Regional de La Libertad (GRLL)","responsible_institution/id_institution":"45139","responsible_institution/name_institution":"Gobierno Regional de La Libertad (GRLL)"}],"plan_number":"1","link":"49b0fc3f-da6b-4f33-bce8-484533574fa4","primary_link":"https://gobiernoabierto.regionlalibertad.gob.pe/plan-de-accion-documentos/146-plan-de-accion-de-gobierno-abierto-de-la-libertad/file","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Región La Libertad","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"La Libertad se unió a  Alianza para el Gobierno Abierto  en 2016. El primer plan de acción presenta compromisos relacionados con seguridad, saneamiento, sector agrario y laboral.","description_en":"La Libertad’s first action plan includes commitments related to security, sanitation, agriculture, and the labor sector.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f6288521-1fda-492f-beb7-53dc3e8cfad0","meta/deprecatedID":"uuid:4c62b461-043e-4d81-bc14-ac4100ad9314","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f6288521-1fda-492f-beb7-53dc3e8cfad0","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:50","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f6288521-1fda-492f-beb7-53dc3e8cfad0"},{"_id":46477,"start":"2025-11-07T14:25:51.644-03:00","end":"2026-01-09T09:02:31.702-03:00","id_drupal":"1709","country":"ecu","theme":"mobility","original_language":"es","name_es":"Plan Maestro de Movilidad para el Distrito Metropolitano de Quito 2009-2025","name_en":"Master Mobility Plan for the Metropolitan District of Quito 2009-2025","responsible_institution":[{"responsible_institution/institution":"Empresa Municipal de Movilidad y Obras Públicas - Gerencia de Planificación de la Movilidad","responsible_institution/id_institution":"44958","responsible_institution/name_institution":"Empresa Municipal de Movilidad y Obras Públicas - Gerencia de Planificación de la Movilidad"}],"instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Metropolitano de Quito","validity_applies_from":"yes","effective_since":"2009-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","description_es":"La movilidad de las personas y bienes en el territorio del DMQ, se realiza en condiciones idóneas es decir: eficientes, eficaces y equitativas; aporta al mejoramiento  sostenible de la economía metropolitana y ciudadana, a la sostenibilidad ambiental, a la salud pública, a la seguridad vial y en general, al fomento de la calidad de vida de la población que se asienta en su jurisdicción y a la generación de una nueva cultura para la movilidad ciudadana.","description_en":"The mobility of people and goods in the DMQ occurs under optimal conditions — efficient, effective, and equitable — contributing to the sustainable improvement of the metropolitan and citizen economy, environmental sustainability, public health, road safety, overall quality of life, and the development of a new citizen mobility culture.","linking_sdg_plans":"yes","pmu/pmu_implementation":"vision","pmu/pmu_implementation_es":"Se plantea electromovilidad a nivel de la visión del plan, como una opción viable para el desarrollo de la movilidad urbana y se ejemplifica con proyectos como el Programa Metrobús–Q Fase III (2017–2021 )","pmu/pmu_implementation_en":"Electromobility is proposed at the level of the plan's vision, as a viable option for the development of urban mobility and is exemplified by projects such as the Metrobus–Q Phase III Program (2017–2021)","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Se consideran: Sistema integrado de transporte público, lineas estratégicas (70); programas y proyecto (72). Se dedica presupuesto, cronograma, zona dentro de la ciudad. Se planifica como transporte publico, incluyendo multimodalidad entre BRT y Tren urbano Infraestructura de ciclovias, circuitos turísticos y ecológicos (84). Se asigna presupuesto Peatonalización del centro histórico, ampliacion aceras, construcción de pasos peatonales segregados, redes peatonales. Se asigna presupuesto. En la gestión del tráfico se establece la gestión de estacionamientos (90), Considerando el proyecto de sistema de estacionamientos tarifado (94)","pmu/pmu_prioritization_en":"The following are considered: Integrated public transport system, strategic lines (70); programmes and project (72). Budget, schedule, area within the city are dedicated. It is planned as public transport, including multimodality between BRT and urban train Infrastructure of bicycle lanes, tourist and ecological circuits (84). Budget is allocated Pedestrianization of the historic center, widening sidewalks, construction of segregated pedestrian crossings, pedestrian networks. Budget is assigned. In traffic management, parking management is established (90), considering the project for a fee-based parking system (94)","pmu/pmu_gender_es":"Se considera mediante la participación equitativa de género y de los gru- pos vulnerables en los procesos del Sistema de Movilidad. (60) en consideración a los principios y lineamientos del PMM.","pmu/pmu_gender_en":"It is considered through the equitable participation of gender and vulnerable groups in the processes of the Mobility System. (60) in consideration of the principles and guidelines of the PMM.","pmu/pmu_budget":"4287518","meta/instanceID":"uuid:0328961a-053e-4f01-b39a-7641197e6107","meta/deprecatedID":"uuid:779aa089-a6cd-49cb-b659-96fed9d98dec","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0328961a-053e-4f01-b39a-7641197e6107","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:50","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:0328961a-053e-4f01-b39a-7641197e6107"},{"_id":46478,"start":"2025-11-07T14:25:52.358-04:00","end":"2026-04-06T12:56:45.998-04:00","id_drupal":"876","country":"dma","theme":"territorial_planning","original_language":"en","name_es":"Política Nacional de Uso del Suelo de Dominica","name_en":"National Land Use Policy of Dominica","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación, Desarrollo Económico e Inversión","responsible_institution/id_institution":"45121","responsible_institution/name_institution":"Ministerio de Planificación, Desarrollo Económico e Inversión"}],"link":"968fbe64-8f7a-4c90-a765-fcd9d418e5b5","primary_link":"https://physicalplanning.gov.dm/images/dominica_national_land_use_policy.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"La Política Nacional de Uso del Suelo (PNUS) proporciona orientación sobre asuntos relacionados con la planificación del uso del suelo en la Mancomunidad de Dominica. Esta política sienta las bases para todas las decisiones relacionadas con el uso del suelo y describe la mejor manera de gestionar el desarrollo con el fin de mejorar la calidad de vida de los dominicanos, a través del desarrollo económico y social, la protección de la salud y la seguridad humanas, y la conservación del medio ambiente natural.\n\nLa Política Nacional de Uso del Suelo fue desarrollada mediante:\n- El análisis y la recopilación de políticas existentes en Dominica\n- Una Evaluación Ambiental Estratégica para examinar la política y asegurar su armonización con políticas generales\n- Un programa de consulta y colaboración con los actores interesados\n- La aplicación de principios de buena planificación, así como de buenas prácticas regionales y globales\n\nEste plan se encuentra habilitado por la Ley de Planificación Física (2002). Conforme a dicha ley, la autoridad de planificación puede elaborar un Plan Nacional de Desarrollo Físico para orientar las decisiones sobre el uso del suelo en el país.\n\nLa Política Nacional de Uso del Suelo representa la política general que guiará la elaboración del Plan Nacional de Desarrollo Físico. Por lo tanto, este plan debe establecer una declaración de los objetivos y propósitos principales, y la Política Nacional de Uso del Suelo constituye dichos objetivos y propósitos fundamentales respecto a la orientación del desarrollo y los usos del suelo en Dominica.","description_en":"The National Land Use Policy (NLUP) provides direction for issues related to land use planning in the Commonwealth of Dominica. The National Land Use Policy sets the foundation for all land use decisions and describes how best to manage development to improve quality of life for Dominicans, through economic and social development, protecting human health and safety, and conserving the natural environment. \n\nThis National Land Use Policy was developed through:\n- Analysis and compilation of existing policies in Dominica\n- A Strategic Environmental Assessment to examine the policy and ensure harmonisation with overarching policies\n- A program of consultation and collaboration with stakeholders\n- Applying the principles of good planning, and regional and global best practices\n\nThis plan is enabled through the Physical Planning Act (2002). Under the Act, the planning authority may prepare a National Physical\nDevelopment Plan to guide land use planning decisions in the country.\n\nThe National Land Use Policy represents the overarching policy that will guide the development of the National Physical Development Plan. Therefore, the National  Physical Development Plan must set out a statement of the principle aims and objectives of the plan and the National Land Use Policy constitutes these principle aims and objectives with respect to directing development and land uses in Dominica.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:f5a3d084-92b4-48d6-849a-a7aec8b1d860","meta/deprecatedID":"uuid:2d1b2066-d888-492d-8c14-e73f53e268e9","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f5a3d084-92b4-48d6-849a-a7aec8b1d860","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:51","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f5a3d084-92b4-48d6-849a-a7aec8b1d860"},{"_id":46479,"start":"2025-11-07T14:25:53.084-03:00","end":"2026-04-08T09:09:26.307-04:00","id_drupal":"100100","country":"arg","theme":"urban_development","original_language":"es","name_es":"Política Nacional Urbana","name_en":"National Urban Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Territorial y Hábitat","responsible_institution/id_institution":"45444","responsible_institution/name_institution":"Ministerio de Desarrollo Territorial y Hábitat"}],"link":"b3dda745-06ef-438f-8036-c91bb9af19b7","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Política Nacional Urbana (PNU) de Argentina es un instrumento estratégico que busca orientar de manera coordinada y coherente el proceso de urbanización y el desarrollo territorial del país, en línea con los compromisos asumidos en la Nueva Agenda Urbana y la Agenda 2030 para el Desarrollo Sostenible. Su elaboración se realizó entre el gobierno nacional, las provincias, los municipios y ONU-Habitat a lo largo de un proceso participativo que incluyó el Foro Urbano Nacional, donde participaron actores públicos, privados, académicos y sociales para identificar los desafíos urbanos prioritarios. \n\nLa PNU no es solo un diagnóstico, sino una herramienta que guía la acción pública al establecer una visión de desarrollo urbano sostenible, inclusivo y equitativo para Argentina. Propone una serie de ejes temáticos y lineamientos que buscan mejorar la coordinación vertical (entre niveles de gobierno) y horizontal (entre sectores y políticas), promoviendo la integración entre planificación, infraestructura, movilidad, suelos urbanos, equidad socio-habitacional, economía urbana, gestión ambiental y gobernanza local. \n\nUno de los objetivos centrales de la política es asegurar que el crecimiento urbano contribuya al desarrollo sostenible, reduciendo desigualdades territoriales y sociales, promoviendo ciudades más resilientes, compactas y sostenibles, en las cuales el acceso a servicios básicos, suelo urbano asequible y una mejor calidad de vida sean prioridades compartidas. Asimismo, la PNU enfatiza el fortalecimiento de marcos institucionales y la participación de diversos actores para garantizar su implementación efectiva a largo plazo. \n\nAunque no es una ley con fuerza de obligatorio cumplimiento como tal, la PNU representa un *marco de política pública orientador* que sirve de referencia para diseñar y alinear políticas, programas y acciones urbanas desde el nivel nacional hasta el local, con el fin de promover mayor cohesión en la planificación territorial y una gestión urbana sostenible y equitativa.","description_en":"The National Urban Policy (NUP) of Argentina is a strategic policy instrument designed to provide coordinated and coherent guidance for urbanization and territorial development across the country, aligned with Argentina’s commitments under the New Urban Agenda and the 2030 Agenda for Sustainable Development. Its development involved a collaborative process between the national government, provinces, municipalities, and UN-Habitat, including participation in the National Urban Forum with public, private, academic, and civil society stakeholders to identify key urban challenges. \n\nThe NUP goes beyond diagnosis by offering a guiding framework that outlines a vision for sustainable, inclusive, and equitable urban development in Argentina. It proposes thematic axes and policy guidelines aimed at improving both vertical coordination (between levels of government) and horizontal coordination (across sectors and policies), fostering integration among planning, infrastructure, mobility, land access, socio-housing equity, urban economy, environmental management, and local governance. \n\nA central objective of the policy is to ensure that urban growth contributes to sustainable development by reducing territorial and social inequalities and promoting more resilient, compact, and sustainable cities where access to basic services, affordable urban land, and improved quality of life are shared priorities. The NUP also emphasizes strengthening institutional frameworks and engaging diverse actors to support its long-term implementation. \n\nWhile not a law with mandatory legal force in itself, the NUP serves as a national public policy framework that guides the design and alignment of urban policies, programs, and actions from national to local levels, with the aim of fostering greater cohesion in territorial planning and sustainable, equitable urban governance.","linking_sdg_plans":"yes","sdg":"sdg_9 sdg_10 sdg_11 sdg_13 sdg_16 sdg_17","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley 25.675 General del Ambiente","link_block/legal_id":"49723","link_block/legal_name":"Ley 25.675 General del Ambiente"},{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Ley N.º 24.449 de Tránsito y Seguridad Vial","link_block/external_link_text_en":"Law No. 24,449 on Traffic and Road Safety","link_block/external_link_text_url":"https://www.cda.org.ar/detalle_normativa.php?id=7988"},{"link_block/link_type":"external","link_block/external_link_type":"actor","link_block/external_link_text_es":"ONU-HABITAT Argentina","link_block/external_link_text_en":"UN-HABITAT Argentina","link_block/external_link_text_url":"https://onu-habitat.org/index.php/component/content/category/45-argentina?Itemid=355"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:94d4f4cf-ff74-418c-a4c1-701d81806b8d","meta/deprecatedID":"uuid:73dcaa16-7dc8-4a12-9931-6e0a6068b5d2","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"94d4f4cf-ff74-418c-a4c1-701d81806b8d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:94d4f4cf-ff74-418c-a4c1-701d81806b8d"},{"_id":46480,"start":"2025-11-07T14:25:53.820-04:00","end":"2026-04-06T12:09:13.491-04:00","id_drupal":"988","country":"ury","theme":"territorial_planning","original_language":"es","name_es":"Directrices Departamentales de Ordenamiento Territorial y Desarrollo Sostenible de Uruguay","name_en":"Departmental Guidelines on Territorial Planning and Sustainable Development of Uruguay","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Ordenamiento Territorial","responsible_institution/id_institution":"45172","responsible_institution/name_institution":"Ministerio de Vivienda y Ordenamiento Territorial"}],"link":"CREO QUE HABÍA QUE SACARLA","primary_link":"https://www.impo.com.uy/bases/leyes/18308-2008","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos","type_territorial_unit_en":"Departments","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Las Directrices Departamentales de Ordenamiento Territorial y Desarrollo Sostenible constituyen el instrumento que establece el ordenamiento estructural del territorio departamental, determinando las principales decisiones sobre el proceso de ocupación, desarrollo y uso del mismo. Tienen como objeto fundamental planificar el desarrollo integrado y ambientalmente sostenible del territorio departamental, mediante el ordenamiento del suelo y la previsión de los procesos de transformación del mismo. Es de competencia exclusiva de los Gobiernos Departamentales la elaboración y aprobación de las Directrices Departamentales.","description_en":"The Departmental Guidelines for Land Use Planning and Sustainable Development are the instruments that define the structural planning of the departmental territory, setting out the main decisions regarding its occupation, development, and use. Their main objective is to plan the integrated and environmentally sustainable development of the departmental territory by organizing land use and anticipating transformation processes. The drafting and approval of these Guidelines are the exclusive responsibility of Departmental Governments.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:f40ed020-fc73-47b9-b74d-a0a81ea3008b","meta/deprecatedID":"uuid:70e94cac-82fb-48d2-b5f4-1fd5a933129b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f40ed020-fc73-47b9-b74d-a0a81ea3008b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f40ed020-fc73-47b9-b74d-a0a81ea3008b"},{"_id":46481,"start":"2025-11-07T14:25:54.556-03:00","end":"2026-04-06T12:57:09.644-04:00","id_drupal":"2202","country":"jam","theme":"territorial_planning","original_language":"en","name_es":"Política Nacional de Tierras","name_en":"National Land Policy","responsible_institution":[{"responsible_institution/institution":"Primer Ministro de Jamaica","responsible_institution/id_institution":"45483","responsible_institution/name_institution":"Primer Ministro de Jamaica"}],"link":"345120bc-fe41-4001-984f-b804f326bc64","primary_link":"https://websitearchive2020.nepa.gov.jm/new/services_products/subsites/planning/docs/nat_land_policy.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"1997-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"La Política Nacional de Tierras de Jamaica establece el marco para orientar el uso, la gestión y el desarrollo sostenible de los recursos territoriales del país. Su objetivo es promover una utilización eficiente, equitativa y productiva de la tierra, en coherencia con las prioridades de desarrollo socioeconómico nacional. La política busca mejorar los procesos de planificación, gestión y regulación del uso del suelo, así como eliminar barreras legales, administrativas y de gestión que dificultan una adecuada administración del territorio. Asimismo, orienta la formulación de estrategias, programas y proyectos destinados a fortalecer la protección, conservación y aprovechamiento sostenible de los recursos físicos del país.","description_en":"The National Land Policy of Jamaica establishes the framework to guide the use, management, and sustainable development of the country’s land resources. Its objective is to promote the efficient, equitable, and productive use of land, in line with national socio-economic development priorities. The policy seeks to improve planning, management, and regulation processes related to land use, while also addressing and removing legal, administrative, and managerial barriers that hinder effective territorial management. It also guides the formulation of strategies, programs, and projects aimed at strengthening the protection, conservation, and sustainable use of the country’s physical resources.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:1b6686cd-eb71-42f5-8ec3-7f87886b3e41","meta/deprecatedID":"uuid:f72fdae0-1d71-4456-902f-5334c0eabfa1","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1b6686cd-eb71-42f5-8ec3-7f87886b3e41","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1b6686cd-eb71-42f5-8ec3-7f87886b3e41"},{"_id":46482,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:55.292","end":"2025-11-07T14:25:55.292","id_drupal":"989","country":"ury","theme":"territorial_planning","original_language":"es","name_es":"Ordenanzas Departamentales de Ordenamiento Territorial y Desarrollo Sostenible de Uruguay","name_en":"Departmental Ordinances on Territorial Planning and Sustainable Development of Uruguay ","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Ordenamiento Territorial","responsible_institution/id_institution":"45172","responsible_institution/name_institution":"Ministerio de Vivienda y Ordenamiento Territorial"}],"link":"CREO QUE HABÍA QUE SACARLA","primary_link":"https://www.impo.com.uy/bases/leyes/18308-2008","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Departamentos","type_territorial_unit_en":"Departments","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Las Ordenanzas Departamentales de Ordenamiento Territorial y Desarrollo Sostenible constituyen el instrumento con las determinaciones generales respecto a la gestión, planificación y actuación territorial en toda la jurisdicción del departamento. Es de competencia exclusiva de los Gobiernos Departamentales la elaboración y aprobación de las Directrices Departamentales.","description_en":"Departmental Ordinances for Land Use Planning and Sustainable Development are the instruments that establish general provisions for territorial management, planning, and implementation across the entire departmental jurisdiction. The drafting and approval of Departmental Guidelines are the exclusive responsibility of Departmental Governments.","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:163cbffe-d063-4c1d-96cb-15faecf0ed68","meta/deprecatedID":"uuid:7a224deb-29b9-4a37-a9e1-7c85d6e28cb3","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"163cbffe-d063-4c1d-96cb-15faecf0ed68","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:54","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775493714,"uid":"validation_status_on_hold","by_whom":"paulinestockins","color":"#0000ff","label":"On Hold"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:163cbffe-d063-4c1d-96cb-15faecf0ed68"},{"_id":46483,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:56.045","end":"2025-11-07T14:25:56.045","id_drupal":"2058","country":"per","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Lima 2022-2024","name_en":"First Open Government Action Plan of Lima 2022-2024","responsible_institution":[{"responsible_institution/institution":"Subgerencia de Gobierno Digital e Innovación de Lima","responsible_institution/id_institution":"45000","responsible_institution/name_institution":"Subgerencia de Gobierno Digital e Innovación de Lima"}],"plan_number":"1","link":"2d0dd9a2-f071-426c-94d4-edf1c3409519","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2021/04/PAGA-Lima-2022-.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Lima","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Lima se unió a  Alianza para el Gobierno Abierto  como parte de la cohorte 2020.  El primer plan de acción presenta compromisos relacionados con la innovación para la transparencia y  la participación  ciudadana.","description_en":"Lima joined the Open Government Partnership as part of the 2020 cohort. Its first action plan includes commitments related to innovation for transparency and citizen participation.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:3d14bdc1-ca04-4a7e-afbb-9207604603f7","meta/deprecatedID":"uuid:57bd2f97-765a-4ab7-8584-860547a0af20","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"3d14bdc1-ca04-4a7e-afbb-9207604603f7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:55","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:3d14bdc1-ca04-4a7e-afbb-9207604603f7"},{"_id":46484,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:56.782","end":"2025-11-07T14:25:56.782","id_drupal":"625","country":"gtm","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Guatemala (2016-2018)","name_en":"Third National Open Government Action Plan of Guatemala (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"44996","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"3","link":"a825ee7f-d0fe-46f0-bd29-00834430b571","primary_link":"https://gobiernoabierto.transparencia.gob.gt/wp-content/uploads/3er-Plan-de-Accion-Nacional-de-Gobierno-Abierto-ESPA%C3%91OL.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Los compromisos del Plan de Acción Nacional 2016-2018, se diseñaron a partir del establecimiento de cinco ejes temáticos: 1. Acceso a la Información Pública y Archivos Institucionales 2. Innovación tecnológica 3. Participación ciudadana 4. Rendición de Cuentas 5. Transparencia Fiscal.\n\nPara la elaboración del plan, por un lado, se creó un espacio de consulta ciudadana dentro del portal de Gobierno Abierto de Guatemala, que permitió generar estadísticas e insumos de opinión ciudadana muy importantes para la creación de los compromisos en las mesas temáticas.Durante esta etapa, también se realizaron reuniones con Ministerios de Estado, Secretarías, organismos de Estado, Sociedad Civil, Academia y diversos actores, con el objetivo de sensibilizar sobre el tema de Gobierno Abierto. Asimismo, también se implementaron “Foros de Consulta Abierta de Opinión Ciudadana sobre los cinco ejes del Plan de Acción Nacional”, un ejercicio participativo inclusivo y abierto, que abarcó tres departamentos del país: Guatemala, Quetzaltenango y Alta Verapaz. Por otro lado, también se llevaron a cabo dos rondas de Mesas Temáticas con el objetivo de crear propuestas de metas y compromisos de gobierno abierto. En las mismas participaron delegados técnicos y altas autoridades de entidades públicas, organizaciones de sociedad civil, y otros actores interesados.","description_en":"The National Action Plan 2016-2018 was developed around five thematic areas: 1) Access to Public Information and Institutional Archives, 2) Technological Innovation, 3) Citizen Participation, 4) Accountability, and 5) Fiscal Transparency.\n\nFor the development of the plan, a citizen consultation space was created within the Guatemala Open Government portal, which allowed for the generation of statistics and citizen input that were crucial for the creation of commitments in the thematic tables. During this stage, meetings were also held with Ministries of State, Secretariats, state agencies, civil society, academia, and various stakeholders, with the aim of raising awareness about the topic of Open Government. Additionally, \"Open Consultation Forums on Citizen Opinion about the Five Themes of the National Action Plan\" were implemented. This was an inclusive and open participatory exercise that covered three departments of the country: Guatemala, Quetzaltenango, and Alta Verapaz. Furthermore, two rounds of Thematic Tables were held with the goal of creating proposals for goals and commitments in open government. These meetings involved technical delegates and high-ranking officials from public entities, civil society organizations, and other interested stakeholders.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ee01254a-8c30-41e3-8826-d192e28b9516","meta/deprecatedID":"uuid:9bec3bc2-6627-4c06-9e42-074978d7b12f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ee01254a-8c30-41e3-8826-d192e28b9516","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:55","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ee01254a-8c30-41e3-8826-d192e28b9516"},{"_id":46485,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:57.499","end":"2025-11-07T14:25:57.499","id_drupal":"577","country":"dom","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de República Dominicana (2012-2014)","name_en":"First National Open Government Action Plan of the Dominican Republic (2012-2014)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana","responsible_institution/id_institution":"45523","responsible_institution/name_institution":"Dirección de Transparencia y Gobierno Abierto - Dirección General de Ética e Integridad Gubernamental (DIGEIG) de República Dominicana"}],"coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","id_coordinator":"44999","name_coordinator":"Foro Multiactor para el Gobierno Abierto de República Dominicana","plan_number":"1","link":"46b51f68-e79d-4213-ab28-d26d2725672f","primary_link":"https://gobiernoabierto.gob.do/wp-content/uploads/2021/12/OGP-ACTION-PLAN-PLAN-DE-ACCION-REPUBLICA-DOMINICANA_0.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2012-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Los compromisos del Plan se enmarcan en los siguientes pilares establecidos por el gobierno de República Dominicana: Construir un Estado social y democrático de derecho; Lograr un marco jurídico eficiente, que permita planificar, controlar, supervisar y fiscalizar el gasto público; Propugnar por políticas públicas de combate a la corrupción y promoción de la transparencia; Implementar proyectos de gobierno electrónico (e-government), para un Estado más eficiente; Apoderar al ciudadano de herramientas para la fiscalización de las ejecutorias del Estado.\n\nEl primer plan de la República Dominicana incorporó varios compromisos del amplio proceso de consulta de la Iniciativa Anticorrupción Participativa (IPAC), pero no se abrió un proceso de consulta específico para el Plan de Acción. La IPAC fue la base del primer Plan de Acción de la República Dominicana ante la Alianza para el Gobierno Abierto. La iniciativa se propuso: (a) recopilar información disponible sobre experiencias exitosas de promoción de transparencia; (b) identificar carencias de información en el tema y cómo suplirlas; (c) compilar y analizar la información, y (d) recomendar acciones concretas a la Presidencia de la República.","description_en":"The commitments of the plan are framed within the following pillars established by the Dominican government: Building a social and democratic state under the rule of law; Achieving an efficient legal framework to plan, control, supervise, and audit public spending; Advocating for public policies combating corruption and promoting transparency; Implementing e-government projects for a more efficient state; Empowering citizens with tools to oversee state performance. The first plan of the Dominican Republic included commitments from the broad consultation process of the Participatory Anti-Corruption Initiative (IPAC), but no specific consultation was held for the Action Plan. IPAC formed the basis of the first Dominican Action Plan before the Open Government Partnership. The initiative aimed to: (a) gather information on successful transparency promotion experiences; (b) identify information gaps and ways to address them; (c) compile and analyze information, and (d) recommend concrete actions to the Presidency.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/DR_final_web_2012_0.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:095c8599-f669-4e71-ab5a-39b51940c447","meta/deprecatedID":"uuid:61db2802-65cb-42b1-8c59-6698cf90e8de","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"095c8599-f669-4e71-ab5a-39b51940c447","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:56","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:095c8599-f669-4e71-ab5a-39b51940c447"},{"_id":46486,"start":"2025-11-07T14:25:58.222-04:00","end":"2026-08-06T14:57:12.313-04:00","id_drupal":"1766","country":"pry","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción de Gobierno Abierto Paraguay (2022-2024)","name_en":"Fifth Open Government Action Plan of Paraguay (2022-2024)","responsible_institution":[{"responsible_institution/institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)","responsible_institution/id_institution":"45231","responsible_institution/name_institution":"Secretaría Técnica de Planificación del Desarrollo Económico y Social (STP)"}],"coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","id_coordinator":"45441","name_coordinator":"Mesa Conjunta de Gobierno Abierto de Paraguay","plan_number":"5","link":"711fd73e-5e69-4822-998a-39ff510507d3","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2022/12/Paraguay_Action-Plan_2022-2024_Revised_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Los compromisos del Quinto Plan de Acción están alineados con el Plan Nacional de Desarrollo Paraguay 2030; el Plan Nacional de Integridad, Transparencia y Anticorrupción 2021-2025 y la Agenda 2030 para el Desarrollo Sostenible, así como también con los sectores y ejes priorizados del Gobierno Nacional.\n\nPara la cocreación de este plan, se realizaron varias actividades, entre ellas: consulta pública para definir temas y problemáticas; definición de compromisos mediante mesas de cocreación y formulación de hojas de rutas; sistematización de los resultados de la consulta pública; talleres de mesas temáticas de cocreación; y herramienta de seguimiento. El proceso de cocreación se caracterizó por ser un proceso mixto (reuniones presenciales y virtuales), combinó el uso de herramientas de participación ciudadana digital sincrónicas como asincrónicas y en el diseño de las mesas se propuso un proceso con participación descentralizada, amplia y diversa. En total participaron 198 personas, de las cuales 123 provenían de instituciones públicas, 30 de la sociedad civil; 15 de la academia; 4 de organismos internacionales; 2 del sector privado y 4 de título personal.","description_en":"The commitments of the Fifth Action Plan are aligned with the National Development Plan Paraguay 2030; the National Integrity, Transparency, and Anti-Corruption Plan 2021-2025; and the 2030 Agenda for Sustainable Development, as well as with the sectors and prioritized areas of the National Government.\n\nFor the co-creation of this plan, several activities were carried out, including: public consultation to define issues and problems; definition of commitments through co-creation tables and the formulation of roadmaps; systematization of the results from the public consultation; thematic co-creation workshops; and a monitoring tool. The co-creation process was characterized as a mixed process (both in-person and virtual meetings), combining the use of synchronous and asynchronous digital citizen participation tools. In the design of the tables, a decentralized, broad, and diverse participation process was proposed. A total of 198 people participated, of whom 123 were from public institutions, 30 from civil society, 15 from academia, 4 from international organizations, 2 from the private sector, and 4 on a personal basis.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:c232b505-50e9-47d9-82e5-3861ee397c6d","meta/deprecatedID":"uuid:9e1292e6-ed3f-40df-99ec-0ef35de2b68b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c232b505-50e9-47d9-82e5-3861ee397c6d","meta/rootUuid":"uuid:c232b505-50e9-47d9-82e5-3861ee397c6d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:57","_tags":[],"_notes":[],"_validation_status":{"timestamp":1786976479,"uid":"validation_status_approved","by_whom":"paulinestockins","label":"Approved"},"_submitted_by":"hcastellaro"},{"_id":46487,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:58.932","end":"2025-11-07T14:25:58.932","id_drupal":"472","country":"cri","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Costa Rica (2017-2019)","name_en":"Third National Open Government Action Plan of Costa Rica (2017-2019)","responsible_institution":[{"responsible_institution/institution":"Coordinación de Gobierno Abierto ","responsible_institution/id_institution":"45438","responsible_institution/name_institution":"Coordinación de Gobierno Abierto "}],"coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","id_coordinator":"45439","name_coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","plan_number":"3","link":"e103b9c3-ac2d-4fab-87bb-3f1766d1ddae","primary_link":"https://presidenciacr-my.sharepoint.com/personal/gobiernoabierto_presidencia_go_cr/_layouts/15/onedrive.aspx?id=%2Fpersonal%2Fgobiernoabierto%5Fpresidencia%5Fgo%5Fcr%2FDocuments%2FP%C3%A1gina%20gob%20abierto%2Fplanes%20de%20acci%C3%B3n%2FIII%20PAGA%2Epdf&amp;parent=%2Fpersonal%2Fgobiernoabierto%5Fpresidencia%5Fgo%5Fcr%2FDocuments%2FP%C3%A1gina%20gob%20abierto%2Fplanes%20de%20acci%C3%B3n&amp;ga=1","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Los compromisos que se encuentran en este Plan de Acción buscan fortalecer la integridad en la función pública, la rendición de cuentas, el derecho ciudadano al acceso a la información pública y la participación ciudadana por medio de la construcción de un Estado Abierto, y promoviendo como principales fundamentos la transparencia, la colaboración, la participación, la rendición de cuentas y la innovación tecnológica.\n\nLa construcción de las propuestas del Plan se generó a partir de la selección de 5 de los Objetivos de Desarrollo Sostenible de la Agenda 2030, acompañado de una convocatoria abierta y el aporte de cada uno de los poderes de la República. \n\nEl Plan de Acción se enmarca en el Plan Nacional de Desarrollo “Alberto Cañas Escalante” (2015-2018), en el que se define como tercer pilar de gobierno, la gestión de un gobierno transparente y cercano a los ciudadanos. El cual pretende incentivar la participación, acceso a información, pero sobre todo la interacción entre el Estado y la ciudadanía.\n\nLos compromisos son producto de un proceso de co-creación, consulta y trabajo en equipo con distintos sectores: gobierno, academia, sector privado y organizaciones de sociedad civil; lo cual permitió el acercamiento de estos según sus ejes temáticos o espacios de especialización.","description_en":"The commitments in this plan seek to strengthen integrity in public service, accountability, the citizen's right to access public information, and citizen participation through the creation of an Open State, promoting transparency, collaboration, participation, accountability, and technological innovation as the main foundations. The plan’s proposals were generated based on the selection of 5 of the Sustainable Development Goals (SDGs) from the 2030 Agenda, with contributions from each of the government branches. The Action Plan is framed within the “Alberto Cañas Escalante” National Development Plan (2015-2018), which defines transparent governance as a key pillar, promoting citizen participation, access to information, and interaction between the State and citizens. The commitments come from a co-creation process, consultations, and teamwork with various sectors: government, academia, the private sector, and civil society, enabling closer alignment between these sectors according to their thematic focuses.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:c4054191-cd5b-42ff-8c29-3b0493856374","meta/deprecatedID":"uuid:4bc418de-70e8-4c64-aced-7f900d35fb33","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c4054191-cd5b-42ff-8c29-3b0493856374","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:58","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c4054191-cd5b-42ff-8c29-3b0493856374"},{"_id":46488,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:25:59.650","end":"2025-11-07T14:25:59.650","id_drupal":"1741","country":"per","theme":"mobility","original_language":"es","name_es":"Plan Maestro para el Transporte Urbano del Area Metropolitana de Lima Callao","name_en":"Master Plan for Urban Transport in the Lima-Callao Metropolitan Area","link":"b545f4d3-c83c-4ebb-8123-879deb10b90e","primary_link":"https://openjicareport.jica.go.jp/pdf/11798261_01.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Área Metropolitana de Lima-Callao","validity_applies_from":"yes","effective_since":"2005-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"long_term","description_es":"Mitigación de la congestión de tránsito asegurando mejor funcionalidad para las actividades urbanas. Mediante una estrategia de Alta Prioridad para el Sistema de Transporte Público ","description_en":"Mitigate traffic congestion to ensure better functionality for urban activities through a High-Priority Strategy for the Public Transport System.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"Se hace referencia al tren electrico.","pmu/pmu_implementation_en":"Reference is made to the electric train.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"La estrategia central es dar mayor prioridad al sistema de transporte público.","pmu/pmu_prioritization_en":"The central strategy is to give greater priority to the public transport system.","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","pmu/pmu_budget":"5500000000","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:e584634e-409b-4d22-a23a-24685fa11cc1","meta/deprecatedID":"uuid:64c2ec98-855d-4bb2-96c7-5266630065bb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e584634e-409b-4d22-a23a-24685fa11cc1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:58","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e584634e-409b-4d22-a23a-24685fa11cc1"},{"_id":46489,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:00.384","end":"2025-11-07T14:26:00.384","id_drupal":"813","country":"per","theme":"urban_development","original_language":"es","name_es":"Planes de Desarrollo Urbano Locales de Perú","name_en":"Local Urban Development Plans of Peru","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda, Construcción y Saneamiento de Perú","responsible_institution/id_institution":"45264","responsible_institution/name_institution":"Ministerio de Vivienda, Construcción y Saneamiento de Perú"}],"link":"a40c1f1f-5b42-40b2-ac12-384ab272393b","primary_link":"https://www.gob.pe/institucion/programa-nuestras-ciudades/informes-publicaciones/5063656-pautas-para-la-implementacion-de-planes-de-desarrollo-urbano","instrument_type":"plan","territorial_scale":"subnational","type_territorial_unit_es":"Ciudades","type_territorial_unit_en":"Cities","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"medium_term","description_es":"Los Planes Urbanos Locales son el instrumento técnico - normativo y de gestión básico para promover, orientar y regular desarrollo urbano sostenible de centros poblados urbanos.\n\nLos Planes Urbanos Locales comprenden a los siguientes instrumentos:\n\na) Plan de Desarrollo Metropolitano\n b) Plan de Desarrollo Urbano - PDU\n c) Plan Urbano Distrital - PUD\n d) Esquema de Ordenamiento Urbano","description_en":"Local Urban Plans are the basic technical, regulatory, and management instruments designed to promote, guide, and regulate the sustainable urban development of populated urban centers.\n\nLocal Urban Plans include the following instruments:\n\na) Metropolitan Development Plan\nb) Urban Development Plan (PDU)\nc) District Urban Plan (PUD)\nd) Urban Planning Scheme","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ec3fa371-611f-472e-9fbc-8b17bcf5fc35","meta/deprecatedID":"uuid:90fe1bfa-c5c4-4ae0-af23-cfad1c66c13a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ec3fa371-611f-472e-9fbc-8b17bcf5fc35","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:25:59","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ec3fa371-611f-472e-9fbc-8b17bcf5fc35"},{"_id":46490,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:01.208","end":"2025-11-07T14:26:01.208","id_drupal":"1688","country":"jam","theme":"open_government","original_language":"en","name_es":"Primer Plan Nacional de Gobierno Abierto de Jamaica (2021-2023)","name_en":"Jamaica's First National Open Government Plan (2021-2023)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Hacienda y Servicio Público de Jamaica","responsible_institution/id_institution":"45143","responsible_institution/name_institution":"Ministerio de Hacienda y Servicio Público de Jamaica"}],"coordinator":"Foro Multiactor de Jamaica","id_coordinator":"45006","name_coordinator":"Foro Multiactor de Jamaica","plan_number":"1","link":"f65cfa9b-c75d-4a44-b622-53daf98d03bf","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2022/01/Jamaica_Action-Plan_2021-2023.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Los preparativos para el Primer Plan de Acción Nacional de Jamaica incluyeron la aprobación de cuatro áreas temáticas por parte del Foro Multiactor (MSF, por sus siglas en inglés): Justicia y Derechos Humanos; Recursos Naturales, Medio Ambiente y Clima; Acceso a la Información; y Juventud. Con la aprobación de estas áreas temáticas, el MSF organizó varias rondas de reuniones de los grupos de consulta de partes interesadas de la AGA, con el fin de debatir y desarrollar propuestas de compromisos para cada área temática.\n\nLos participantes en estas consultas incluyeron representantes de ministerios, departamentos y agencias gubernamentales, organizaciones de la sociedad civil, el sector privado, sindicatos, organizaciones religiosas, organizaciones juveniles y el ámbito académico.","description_en":"Preparations for Jamaica's First National Action Plan included the approval of 4 thematic areas by the Multi-Stakeholder Forum (MSF): Justice and Human Rights; Natural Resources; Environment and Climate; Access to Information; and Youth. With the approval of these thematic areas, the MSF organized several rounds of meetings of OGP stakeholder consultation groups in order to discuss and develop proposed commitments for each thematic area. \n\nThe participants in these consultations included representatives of government ministries, departments and agencies, civil society organizations, the private sector, trade unions, faith-based organizations, youth organizations and academia. ","linking_sdg_plans":"no","pga/pga_mechanism_text_en":"Action Plan Review by the Independent Reporting Mechanism - for public comment ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2022/07/Jamaica_Action-Plan-Review_2021-2023_For-Public-Comments.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:78363fe0-b443-472c-8a24-c98ed45fc770","meta/deprecatedID":"uuid:787c980d-c751-4e67-8bd5-e0d94aaa8b11","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"78363fe0-b443-472c-8a24-c98ed45fc770","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:00","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:78363fe0-b443-472c-8a24-c98ed45fc770"},{"_id":46491,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:01.924","end":"2025-11-07T14:26:01.924","id_drupal":"1997","country":"bra","theme":"open_government","original_language":"pt","name_es":"1er Plan de Acción de Gobierno Abierto de Osasco 2021-2024","name_en":"1º Plano de Ação de Governo Aberto de Osasco 2021-2024 / First Open Government Action Plan of Osasco 2021-2024","responsible_institution":[{"responsible_institution/institution":"Departamento de Governo Aberto e Fortalecimento da Cidadania - Secretaria de Planejamento e Gestão de Osasco","responsible_institution/id_institution":"45065","responsible_institution/name_institution":"Departamento de Governo Aberto e Fortalecimento da Cidadania - Secretaria de Planejamento e Gestão de Osasco"}],"coordinator":"Foro Municipal de Gobierno Abierto de Osasco","id_coordinator":"45535","name_coordinator":"Foro Municipal de Gobierno Abierto de Osasco","plan_number":"1","link":"453e72ec-2ed3-45a2-8bae-781d9d37b0eb","primary_link":"https://www.opengovpartnership.org/documents/action-plan-osasco-brazil-2021-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Município de Osasco","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Osasco se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con las comunidades marginadas y la participación ciudadana.","description_en":"Osasco joined the Open Government Partnership as part of the 2020 cohort. The first action plan includes commitments related to marginalized communities and citizen participation.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:79d4fb69-edbe-408b-85fc-231a81ce8a83","meta/deprecatedID":"uuid:08a5f62d-9463-4598-86d6-d8a66b3e27a1","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"79d4fb69-edbe-408b-85fc-231a81ce8a83","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:79d4fb69-edbe-408b-85fc-231a81ce8a83"},{"_id":46492,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:02.642","end":"2025-11-07T14:26:02.642","id_drupal":"628","country":"slv","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de El Salvador (2013-2014)","name_en":"First Open Government National Action Plan of El Salvador (2013-2014)\n","responsible_institution":[{"responsible_institution/institution":"Secretaría para Asuntos Estratégicos de la Presidencia, Subsecretaría de Transparencia y Anticorrupción","responsible_institution/id_institution":"45061","responsible_institution/name_institution":"Secretaría para Asuntos Estratégicos de la Presidencia, Subsecretaría de Transparencia y Anticorrupción"}],"plan_number":"1","link":"10bdd5aa-0953-451f-9087-a4295801a951","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2014-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Luego de la presentación del plan en 2012, se realizó una evaluación de cumplimiento para incorporar medidas de fortalecimiento o de seguimiento a lo ya ejecutado, con el fin de dar cumplimiento efectivo y mantener la visión estratégica. La evaluación se realizó con Organizaciones No Gubernamentales vinculadas al tema de transparencia y anticorrupción en el país y sus aportes fueron incorporados en la actualización del plan; de la cual se realizaron dos validaciones. La primera con las instituciones públicas encargadas de cada una de las acciones específicas propuestas para que dieran su aval y aceptaran liderar los diferentes procesos; la segunda fue una revisión conjunta con las organizaciones de sociedad civil.\n\nEl presente plan incorpora una serie de acciones destinadas al uso de las herramientas de transparencia y acceso a la información que mejoren la calidad de la participación ciudadana y añade el uso de las Tecnologías de Información y Comunicación como instrumento que produzca y facilite la información y la interacción entre los entes públicos y la ciudadanía por medio de la transformación de datos en poder de los entes estatales.\n\nLa consulta para la elaboración del plan incorporó talleres y reuniones presenciales con especialistas en los diferentes ejes de acción que impulsa la Alianza para el Gobierno Abierto. Fueron invitados y participaron representantes de diferentes entes de la administración pública, organizaciones de la sociedad civil, organizaciones no gubernamentales (ONG's), sindicatos, gremiales empresariales y universidades. Las propuestas surgidas fueron consultadas en un sitio web especialmente diseñado para ello, de libre acceso público y con posibilidad de comentarse desde cualquier red social.","description_en":"Following the presentation of the plan in 2012, a compliance evaluation was conducted to incorporate measures for strengthening or following up on what had already been implemented, with the aim of ensuring effective compliance and maintaining the strategic vision. The evaluation was carried out with non-governmental organizations involved in transparency and anti-corruption issues in the country, and their contributions were incorporated into the updated version of the plan. This update underwent two validation processes: the first with public institutions responsible for each of the proposed specific actions, in order to obtain their endorsement and commitment to lead the various processes; and the second, a joint review with civil society organizations.\n\nThe current plan includes a series of actions aimed at using transparency and access to information tools to improve the quality of citizen participation. It also introduces the use of Information and Communication Technologies (ICTs) as instruments to generate and facilitate information and interaction between public entities and citizens by transforming data held by state institutions.\n\nThe consultation process for developing the plan included workshops and in-person meetings with specialists in the various areas of action promoted by the Open Government Partnership. Representatives from different public administration entities, civil society organizations, non-governmental organizations (NGOs), labor unions, business associations, and universities were invited and participated. The proposals generated were made available for public consultation on a specially designed website, which was open to the public and allowed for comments via any social media platform.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ec5e9ea1-b245-45c7-bfd2-18124f308264","meta/deprecatedID":"uuid:bc70fe00-0ebf-4178-bf28-ba2dccd2b247","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ec5e9ea1-b245-45c7-bfd2-18124f308264","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ec5e9ea1-b245-45c7-bfd2-18124f308264"},{"_id":46493,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:03.362","end":"2025-11-07T14:26:03.362","id_drupal":"2001","country":"chl","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Maipú 2023-2024","name_en":"First Open Government Action Plan of Maipú 2023-2024","responsible_institution":[{"responsible_institution/institution":"Unidad de Planificación y Desarrollo - Secretaría Comunal de Planificación de Maipú","responsible_institution/id_institution":"45113","responsible_institution/name_institution":"Unidad de Planificación y Desarrollo - Secretaría Comunal de Planificación de Maipú"}],"coordinator":"Grupo Motor de Maipú","id_coordinator":"44965","name_coordinator":"Grupo Motor de Maipú","plan_number":"1","primary_link":"https://www.opengovpartnership.org/documents/action-plan-maipu-chile-2023-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Comuna de Maipú","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Maipú se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022.El primer plan de acción incluye compromisos relacionados con la seguridad y protección ciudadana, acciones ambientales y climáticas, y refuerzo del espacio cívico.","description_en":"Maipú joined the Open Government Partnership as part of the 2022 cohort. Its first action plan includes commitments related to public safety and protection, environmental and climate action, and strengthening civic space.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9e6a61c0-8073-4fce-9466-92bcaa093474","meta/deprecatedID":"uuid:0ac9b81c-fd0b-4407-bc50-3cf34238c816","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9e6a61c0-8073-4fce-9466-92bcaa093474","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:02","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9e6a61c0-8073-4fce-9466-92bcaa093474"},{"_id":46494,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:04.076","end":"2025-11-07T14:26:04.076","id_drupal":"1753","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad Urbana Sustentable de Tijuana","name_en":"Comprehensive Sustainable Urban Mobility Plan for Tijuana","responsible_institution":[{"responsible_institution/institution":"Instituto Metropolitano de Planeación de Tijuana (IMPLAN)","responsible_institution/id_institution":"45233","responsible_institution/name_institution":"Instituto Metropolitano de Planeación de Tijuana (IMPLAN)"}],"link":"833234a3-f2f0-4136-8e02-f4c8d53482ac","primary_link":"https://implan.tijuana.gob.mx/implan/planes-y-programas/pimus.aspx","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Tijuana","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"Mejorar la movilidad de las personas y las mercancías que diariamente transitan en la ciudad mediante la ampliación y perfección de las dinámicas de movilidad de la población que reside en Tijuana. Considera los siguientes ejes temáticos: ambiental, urbano, económico, social, de vialidad y transporte, institucional. Además se consideran ejes transversales: riegos y resiliencia, derecho a la ciudad y justicia socio-espacial, inteligencia urbana. ","description_en":"Improve the mobility of people and goods moving through the city daily by expanding and enhancing the mobility dynamics of Tijuana's residents. Thematic areas include: environmental, urban, economic, social, road and transport, institutional. Cross-cutting themes include risks and resilience, right to the city and socio-spatial justice, urban intelligence.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"Instalar centros de carga de vehículos eléctricos y demás dispositivos para la movilidad motorizada de energía renovable.","pmu/pmu_implementation_en":"Install charging centres for electric vehicles and other devices for motorised mobility of renewable energy.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"\"*Transporte privado: reducir la demanda excesiva de movilidad por modalidad de vehículos privados. *Peatón: gestionar proyectos para la peatonalización de polígonos susceptibles en el municipio de Tijuana. Peatonalizar las calles principales con alta afluencia comercial y densidad de edificación, a corto plazo. Programa integral de banquetas y cruces peatonales. *Bicicleta: añadir rutas troncales que incluyan ciclo vias y ejes peatonales para crear circuitos de movilidad. Crear circuitos de ciclovías que articulen zonas residenciales con sub-centros urbanos. *Transporte público: mejorar la eficacia del transporte público, optimizando la operación del tránsito y complementando la infraestructura. \"","pmu/pmu_prioritization_en":"\"*Private transport: reduce the excessive demand for mobility by private vehicles. *Pedestrian: manage projects for the pedestrianization of susceptible polygons in the municipality of Tijuana. Pedestrianize the main streets with high commercial influx and building density, in the short term. Comprehensive program of sidewalks and pedestrian crossings. *Bicycle: add trunk routes that include cycle paths and pedestrian axes to create mobility circuits. Create circuits of bicycle lanes that articulate residential areas with urban sub-centers. *Public transport: improve the efficiency of public transport, optimising the operation of traffic and complementing infrastructure. \"","pmu/pmu_gender_es":"\"Implementar acciones para garantizar la seguridad ciudadana en el espacio público y desplazamientos, especialmente de las mujeres, adultos mayores y jóvenes. -Implementar programas de capacitación a servidores públicos en temas de género y diversidad social, especialmente a aquellos encargados del diseño, planeación, operaición o administración de las infraestructuras y servicios de movilidad\".","pmu/pmu_gender_en":"\"Implement actions to guarantee citizen safety in public space and displacement, especially of women, the elderly and young people. -Implement training programs for public servants on gender and social diversity issues, especially those in charge of the design, planning, operation or administration of mobility infrastructures and services.\"","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:5e80784a-aadb-434f-b52c-34a99293050c","meta/deprecatedID":"uuid:d832a4b3-fa35-43f2-a06a-5c9aee32c703","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5e80784a-aadb-434f-b52c-34a99293050c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:5e80784a-aadb-434f-b52c-34a99293050c"},{"_id":46495,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:04.786","end":"2025-11-07T14:26:04.786","id_drupal":"1987","country":"arg","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Mendoza 2021-2023","name_en":"First Open Government Action Plan of Mendoza 2021-2023","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto y Participación Ciudadana","responsible_institution/id_institution":"45015","responsible_institution/name_institution":"Dirección de Gobierno Abierto y Participación Ciudadana"}],"coordinator":"Mesa Participa Mendoza","id_coordinator":"45075","name_coordinator":"Mesa Participa Mendoza","plan_number":"1","link":"05f01169-9649-4d49-b88d-aadf4bb8fa37","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2021/08/Plan-de-Accion-de-Gobierno-Abierto-de-la-Ciudad-de-Mendoza-1.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Mendoza","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Mendoza se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con el cambio climático, la participación pública y los datos abiertos.\n","description_en":"Mendoza joined the Open Government Partnership as part of the 2020 cohort. The first action plan includes commitments related to climate change, public participation, and open data.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:4e7e09d0-1fb2-4487-b3da-1524aaedd114","meta/deprecatedID":"uuid:fadcc572-cccc-436c-a1ca-59c87ceb3e46","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4e7e09d0-1fb2-4487-b3da-1524aaedd114","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4e7e09d0-1fb2-4487-b3da-1524aaedd114"},{"_id":46496,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:05.501","end":"2025-11-07T14:26:05.501","id_drupal":"1989","country":"arg","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Rosario 2021-2023","name_en":"First Open Government Action Plan of Rosario 2021-2023","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto - Secretaría de Modernización y Cercanía","responsible_institution/id_institution":"44985","responsible_institution/name_institution":"Dirección de Gobierno Abierto - Secretaría de Modernización y Cercanía"}],"coordinator":"Mesa de Diálogo de Gobierno Abierto de Rosario","id_coordinator":"45114","name_coordinator":"Mesa de Diálogo de Gobierno Abierto de Rosario","plan_number":"1","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Rosario","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Rosario se unió a Alianza para el Gobierno Abierto  como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con género, prestación de servicios públicos, datos abiertos y anticorrupción.","description_en":"Rosario joined the Open Government Partnership as part of the 2020 cohort. The first action plan includes commitments related to gender, public service delivery, open data, and anti-corruption.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:91f9c5b3-d791-4b1a-b910-aa68f24b0e52","meta/deprecatedID":"uuid:3a05bb5b-1887-4cf8-8af6-20f51076379e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"91f9c5b3-d791-4b1a-b910-aa68f24b0e52","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:04","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:91f9c5b3-d791-4b1a-b910-aa68f24b0e52"},{"_id":46497,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:06.225","end":"2025-11-07T14:26:06.225","id_drupal":"2050","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Monterrey 2022-2024","name_en":"First Open Government Action Plan of Monterrey 2022-2024","responsible_institution":[{"responsible_institution/institution":"Secretaría de Innovación y Gobierno Abierto de Monterrey","responsible_institution/id_institution":"45361","responsible_institution/name_institution":"Secretaría de Innovación y Gobierno Abierto de Monterrey"}],"coordinator":"Foro Multiactor de la Coalición Nuevo León Abierto","id_coordinator":"45104","name_coordinator":"Foro Multiactor de la Coalición Nuevo León Abierto","plan_number":"1","link":"9deea526-5c3f-4788-9c1c-ff9684d1b738","primary_link":"https://www.nl.gob.mx/es/publicaciones/plan-de-accion-local-de-gobierno-abierto-2022-2024-de-nuevo-leon","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Monterrey","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Monterrey se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022. El primer plan de acción presenta compromisos relacionados con los derechos a la información, participación ciudadana, infraestructura, responsabilidad social e inclusión. Este plan es un trabajo en cosorcio entre Monterrey, el Estado de Nuevo León y San Pedro de Garza García que forman la Coalición Nuevo León Abierto.","description_en":"Monterrey joined the Open Government Partnership as part of the 2022 Cohort. The first action plan presents commitments related to the right to information, citizen participation, infrastructure, social responsibility, and inclusion. This plan is a collaborative effort between Monterrey, the State of Nuevo León, and San Pedro de Garza García, forming the Nuevo León Open Coalition.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9e16dec5-f8e7-472a-b345-64bfbc9cd816","meta/deprecatedID":"uuid:2b4ad636-5f59-4829-b103-4e251dc3753a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9e16dec5-f8e7-472a-b345-64bfbc9cd816","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:05","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9e16dec5-f8e7-472a-b345-64bfbc9cd816"},{"_id":46498,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:07.152","end":"2025-11-07T14:26:07.152","id_drupal":"2043","country":"col","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Nariño 2019-2021","name_en":"First Open Government Action Plan of Nariño 2019-2021","responsible_institution":[{"responsible_institution/institution":"Secretaría TIC, Innovación y Gobierno Abierto de Nariño","responsible_institution/id_institution":"45543","responsible_institution/name_institution":"Secretaría TIC, Innovación y Gobierno Abierto de Nariño"}],"coordinator":"Foro de Cocreación de Nariño","id_coordinator":"45368","name_coordinator":"Foro de Cocreación de Nariño","plan_number":"1","link":"bd6253cb-8026-4295-a430-20c9d4d84506","primary_link":"https://www.opengovpartnership.org/documents/narino-colombia-action-plan-2019-2021/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Departamento de Nariño","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Nariño se unió a Alianza para el Gobierno Abierto como parte de la cohorte de 2018. El primer plan de acción incluye compromisos relacionados con los datos abiertos, la prestación de servicios públicos y la lucha contra la corrupción.","description_en":"Nariño joined the Open Government Partnership as part of the 2018 cohort. The first action plan includes commitments related to open data, public service delivery, and the fight against corruption.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:f2badab4-5a87-47f0-bf89-31ecfdf4da90","meta/deprecatedID":"uuid:ad681e86-6758-404f-8f16-83665a2c3808","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f2badab4-5a87-47f0-bf89-31ecfdf4da90","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f2badab4-5a87-47f0-bf89-31ecfdf4da90"},{"_id":46499,"start":"2025-11-07T14:26:07.878-04:00","end":"2026-04-09T18:10:00.975-04:00","id_drupal":"2051","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Nuevo León (Estado) 2022-2024","name_en":"First Open Government Action Plan of Nuevo León (State) 2022-2024","responsible_institution":[{"responsible_institution/institution":"Secretaría de Participación Ciudadana","responsible_institution/id_institution":"45108","responsible_institution/name_institution":"Secretaría de Participación Ciudadana"},{"responsible_institution/institution":"Gobierno Municipal de San Pedro Garza García","responsible_institution/id_institution":"45062","responsible_institution/name_institution":"Gobierno Municipal de San Pedro Garza García"},{"responsible_institution/institution":"Gobierno Municipal de Monterrey","responsible_institution/id_institution":"45539","responsible_institution/name_institution":"Gobierno Municipal de Monterrey"}],"coordinator":"Foro Multiactor de la Coalición Nuevo León Abierto","id_coordinator":"45104","name_coordinator":"Foro Multiactor de la Coalición Nuevo León Abierto","plan_number":"1","link":"17e16c88-3202-4c01-8f9c-c66e63bd1f6b","primary_link":"https://www.nl.gob.mx/es/publicaciones/plan-de-accion-local-de-gobierno-abierto-2022-2024-de-nuevo-leon","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Nuevo León","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Nuevo León (Estado) se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022. El primer plan de acción presenta compromisos relacionados con la participación ciudadana con foco en niñas, niños y adolescentes, derecho a la información, innovación y datos abiertos.  Este plan es un trabajo en cosorcio entre Monterrey, el Estado de Nuevo León y San Pedro de Garza García que forman la Coalición Nuevo León Abierto.","description_en":"Nuevo León (State) joined the Open Government Partnership as part of the 2022 Cohort. The first action plan includes commitments related to citizen participation, focusing on children and adolescents, the right to information, innovation, and open data. This plan is a collaborative effort between Monterrey, the State of Nuevo León, and San Pedro de Garza García, forming the Nuevo León Open Coalition.","linking_sdg_plans":"no","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","meta/instanceID":"uuid:2125a840-2209-4589-b39e-e11f1b5b07b0","meta/deprecatedID":"uuid:e62003ac-bdfe-49f8-b3fb-b58a2b9858b1","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2125a840-2209-4589-b39e-e11f1b5b07b0","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2125a840-2209-4589-b39e-e11f1b5b07b0"},{"_id":46500,"start":"2025-11-07T14:26:08.630-03:00","end":"2026-01-13T17:00:27.619-03:00","id_drupal":"1691","country":"bra","theme":"open_government","original_language":"pt","name_es":"Quinto Plan de Acción Nacional de Gobierno Abierto de Brasil (2021-2023)","name_en":"Fifth National Open Government Action Plan of Brazil (2021-2023)","responsible_institution":[{"responsible_institution/institution":"Secretaria de Transparencia y Prevensión de la Corrupción","responsible_institution/id_institution":"45014","responsible_institution/name_institution":"Secretaria de Transparencia y Prevensión de la Corrupción"}],"coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","id_coordinator":"45002","name_coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","plan_number":"5","link":"495310b1-a008-434d-a5c0-e8d15c83b627","primary_link":"https://www.gov.br/cgu/pt-br/governo-aberto/a-ogp/planos-de-acao/5o-plano-de-acao-brasileiro/5-plano-acao-nacional-30-03-2022.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El 5º Plan de Acción Nacional de Gobierno Abierto de Brasil se creó en el contexto de la pandemia de COVID-19, por lo que fue necesario un gran esfuerzo de coordinación entre entidades gubernamentales y organizaciones de la sociedad civil para establecer una forma innovadora de garantizar la participación e inclusión en el proceso.\n\nLos compromisos se definieron en 72 mesas de trabajo virtuales para la cocreación, con 141 personas que representaban a 79 instituciones. De estas, 41 eran organizaciones de la sociedad civil y 38 eran entidades públicas. La metodología de trabajo estuvo alineada con los objetivos del proceso y, aunque se desarrolló de forma virtual, no representó un impedimento para asegurar que se cumplieran las metas propuestas para la discusión.","description_en":"Brazil’s Fifth National Action Plan on Open Government was created in the context of the COVID-19 pandemic, requiring significant coordination efforts between government entities and civil society organizations to establish an innovative approach to ensuring participation and inclusion in the process.\n\nThe commitments were defined through 72 virtual co-creation workshops, involving 141 participants representing 79 institutions. Of these, 41 were civil society organizations and 38 were public entities. The working methodology was aligned with the process and did not pose an obstacle to achieving the proposed objectives of the discussions.","linking_sdg_plans":"no","meta/instanceID":"uuid:7255e389-2f06-428f-b083-3acde80b392b","meta/deprecatedID":"uuid:d8bbabcd-2665-44e2-8d1b-76e661ca4e4e","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7255e389-2f06-428f-b083-3acde80b392b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:7255e389-2f06-428f-b083-3acde80b392b"},{"_id":46501,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:09.359","end":"2025-11-07T14:26:09.359","id_drupal":"1759","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad Urbana Sustentable Ciudad de Manzanillo","name_en":"Comprehensive Sustainable Urban Mobility Plan for the City of Manzanillo","responsible_institution":[{"responsible_institution/institution":"Secretaría de Movilidad del Estado de Colima y Secretaría de Infraestructura y Desarrollo Urbano","responsible_institution/id_institution":"45454","responsible_institution/name_institution":"Secretaría de Movilidad del Estado de Colima y Secretaría de Infraestructura y Desarrollo Urbano"}],"link":"77ba3dfe-e81d-4a7d-8fdb-874b15cd57af","primary_link":"https://admiweb.col.gob.mx/archivos_prensa/banco_img/file_613a5ced1987e_VIIInformeEjecutivoManzanilloF.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Manzanillo","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"Orientar, promover e impulsar la movilidad urbana y el desarrollo sustentable de la Ciudad de Manzanillo,teniendo como principal objetivo el bienestar y la calidad de vida de la ciudadanía.","description_en":"Guide, promote, and boost urban mobility and sustainable development in Manzanillo, with the main goal of improving citizens' well-being and quality of life.\n","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:691c99f4-48b7-45d0-9fb3-34b13484bc31","meta/deprecatedID":"uuid:a0c2215e-d931-4c26-8009-30ee156f4f24","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"691c99f4-48b7-45d0-9fb3-34b13484bc31","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:08","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:691c99f4-48b7-45d0-9fb3-34b13484bc31"},{"_id":46502,"start":"2025-11-07T14:26:10.089-03:00","end":"2026-01-13T16:59:59.803-03:00","id_drupal":"632","country":"bra","theme":"open_government","original_language":"pt","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Brasil (2016-2018)","name_en":"Third National Open Government Action Plan of Brazil (2016-2018)","responsible_institution":[{"responsible_institution/institution":"Secretaria de Transparencia y Prevensión de la Corrupción","responsible_institution/id_institution":"45014","responsible_institution/name_institution":"Secretaria de Transparencia y Prevensión de la Corrupción"}],"coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","id_coordinator":"45002","name_coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","plan_number":"3","link":"d50be327-c14c-4f1a-963a-e75132012243","primary_link":"https://www.gov.br/cgu/pt-br/governo-aberto/central-de-conteudo/documentos/3o-plano-de-acao-versao-final.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","validity_applies_until":"yes","effective_until":"2018-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Los compromisos del Tercer Plan Nacional de Acción se desarrollaron mediante una estrecha colaboración entre el gobierno y la sociedad civil. Cada compromiso refleja las principales demandas relacionadas con los temas priorizados e indica qué acciones vinculadas al Gobierno Abierto se implementarán para avanzar en cada asunto.\n\nPor primera vez desde que Brasil participa en la Alianza para el Gobierno Abierto (OGP), se reconoce la participación de los poderes Legislativo y Judicial en el proceso de elaboración del plan de acción nacional.\n\nSe llevaron a cabo reuniones de co-creación, que materializaron el trabajo colaborativo entre el gobierno y la sociedad, y permitieron un amplio debate entre expertos sobre cada uno de los temas priorizados. Las reuniones de co-creación fueron conducidas conjuntamente por el Grupo de Trabajo y la GE-CIGA, y cada tema se desarrolló en dos fases distintas: la primera discutió los desafíos y la segunda determinó los compromisos. Los talleres contaron con la participación de representantes del gobierno (a nivel federal, estatal y municipal) y de la sociedad civil, incluyendo personas de la academia y del sector privado.\n\nLos compromisos del plan están vinculados a los “Objetivos de Desarrollo Sostenible de la Agenda 2030”.","description_en":"The commitments of Brazil’s Third National Action Plan were developed through a close partnership between the government and civil society. Each commitment reflects the main demands related to the prioritized issues and outlines the open government actions to be implemented to advance the topic.\n\nFor the first time since Brazil began participating in the Open Government Partnership (OGP), the Legislative and Judiciary branches were involved in the national action plan development process.\n\nCo-creation meetings were held, embodying collaborative work between government and society, and allowing for broad debate among experts in each prioritized theme. These co-creation sessions were jointly led by the Working Group and GE-CIGA, and each topic was developed in two distinct phases: the first focused on identifying challenges, and the second on defining commitments. The workshops were attended by representatives from government (at federal, state, and municipal levels) and from civil society, including members of academia and the private sector.\n\nThe plan’s commitments are aligned with the “Sustainable Development Goals of the 2030 Agenda.”","linking_sdg_plans":"no","meta/instanceID":"uuid:cd2f8f90-e36c-4268-9398-81ea3ea4fc94","meta/deprecatedID":"uuid:353c6bca-831a-4f03-9ef8-7323c7e5a0e8","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"cd2f8f90-e36c-4268-9398-81ea3ea4fc94","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:cd2f8f90-e36c-4268-9398-81ea3ea4fc94"},{"_id":46503,"start":"2025-11-07T14:26:10.810-03:00","end":"2026-01-13T16:58:49.964-03:00","id_drupal":"627","country":"bra","theme":"open_government","original_language":"pt","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Brasil (2014-2016)","name_en":"Second National Open Government Action Plan of Brazil (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Secretaria de Transparencia y Prevensión de la Corrupción","responsible_institution/id_institution":"45014","responsible_institution/name_institution":"Secretaria de Transparencia y Prevensión de la Corrupción"}],"coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","id_coordinator":"45002","name_coordinator":"Comité Interministerial de Gobierno Abierto (CIGA) de Brasil","plan_number":"2","link":"3020e25f-50d7-4d75-b230-b6b293e86020","primary_link":"https://repositorio.cgu.gov.br/bitstream/1/66738/1/2_plano_de_acao_portugu%c3%aas.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Para la formulación de este segundo Plan, se desarrolló un mayor número de acciones, se involucraron más agencias gubernamentales y se aplicó un proceso de consulta más amplio. Con este Plan de Acción, el país ha buscado fortalecer su compromiso con la transparencia en las acciones del gobierno y con la prevención y el combate a la corrupción. Además, pretende reafirmar los ideales democráticos de participación ciudadana en los procesos de toma de decisiones.\n\nEl Plan de Acción fue formulado conjuntamente por el gobierno y diversos sectores de la sociedad civil. A través de un Grupo de Trabajo creado para apoyar el proceso de formulación y el seguimiento de la implementación del Plan, la sociedad civil pudo participar activamente en los debates sobre los compromisos propuestos. Los ciudadanos participaron en diálogos virtuales realizados en una plataforma en línea. Además, se llevó a cabo un diálogo presencial entre el gobierno y las organizaciones de la sociedad civil. Las propuestas fueron sugeridas y priorizadas por la sociedad civil y, posteriormente, enviadas para su evaluación por los órganos del Gobierno Federal. Paralelamente al diálogo virtual, varias agencias gubernamentales formularon sus propias propuestas.","description_en":"For the formulation of this Second Action Plan, a greater number of actions were developed, more government agencies and institutions were involved, and a broader consultation process was applied. With this Action Plan, the country aimed to strengthen its commitment to transparency in government actions and to the prevention and fight against corruption. Additionally, it seeks to reaffirm democratic ideals of citizen participation in decision-making processes.\n\nThe Action Plan was jointly formulated by the government and various sectors of civil society. Through a Working Group established to support the formulation and monitoring of the Plan’s implementation, civil society was able to actively participate in the discussions around the proposed commitments. Citizens participated in virtual dialogues conducted on an online platform. Additionally, a face-to-face dialogue was held between the government and civil society organizations. The proposals were suggested and prioritized by civil society and then submitted for evaluation by federal government bodies. In parallel to the virtual dialogue, several government agencies and institutions developed their own proposals.","linking_sdg_plans":"no","meta/instanceID":"uuid:cffea5aa-ab49-4f6d-abda-e02ff624e4c0","meta/deprecatedID":"uuid:b119165d-8bbb-41e3-a792-4f548b5b066d","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"cffea5aa-ab49-4f6d-abda-e02ff624e4c0","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:cffea5aa-ab49-4f6d-abda-e02ff624e4c0"},{"_id":46504,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:11.533","end":"2025-11-07T14:26:11.533","id_drupal":"1672","country":"pan","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Panamá (2021-2023)","name_en":"Fourth National Open Government Action Plan of Panama (2021-2023)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia","responsible_institution/id_institution":"45253","responsible_institution/name_institution":"Dirección de Transparencia"}],"coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","id_coordinator":"45147","name_coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","plan_number":"4","link":"4621a369-f8b6-4fd6-9ca9-79676eb593c8","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2021/08/Panama_Action-Plan_2021-2023_Updated_20211230_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Para el desarrollo del Cuarto Plan de Acción Nacional, se consideraron 10 áreas temáticas para la acción estratégica: transparencia e integridad púbilca; recursos naturales y medio abiente; políticas sociales y educacionales; modernización del estado; Parlamento Abierto; acceso a la información; transparencia agropecuaria; presupuestos abiertos; y Justicia Abierta. \n\nEl proceso de cocreación de este cuarto Plan de Acción se llevó a cabo mediante una articulación entre el Gobierno y la sociedad civil para fortalecer la transparencia, rendición de cuentas, participación ciudadana y el uso de tecnologías de comunicación. Se realizaron consultas y encuestas para la definición de las líneas temáticas, mesas de cocreación, reuniones y jornadas de sensibilización y capacitaciones técnicas. ","description_en":"The Fourth Action Plan of Paraguay was developed through co-creation with civil society organizations and government entities, covering 17 thematic areas, including transparency, public integrity, access to information, and citizen participation. The process emphasized a high quality of participation, with government responses to proposals and commitment selection through voting by participants.\n\nThe plan for Peru's Fourth Action includes commitments in security, education, infrastructure, health, sanitation, and the environment. The plan is aligned with national development priorities and the Sustainable Development Goals, with a focus on citizen participation and the co-creation of future action plans.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de revisión del Mecanismo de revisión Independiente de la Alianza para el Gobierno Abierto - para comentario público","pga/pga_mechanism_text_en":"Panama Action Plan Review 2021-2023 - Independent Reporting Mechanism","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2022/05/Panama_Action-Plan-Review_2021-2023_For-Public-Comment.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:d84ea5e3-35da-4a36-bbe7-5ba9ab395c87","meta/deprecatedID":"uuid:812d1271-f000-4ee3-a902-1096a5ea0d5e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d84ea5e3-35da-4a36-bbe7-5ba9ab395c87","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d84ea5e3-35da-4a36-bbe7-5ba9ab395c87"},{"_id":46505,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:12.256","end":"2025-11-07T14:26:12.256","id_drupal":"616","country":"arg","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Argentina (2017-2019)","name_en":"Third National Open Government Action Plan of Argentina (2017-2019)","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital","responsible_institution/id_institution":"45339","responsible_institution/name_institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital"}],"coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","id_coordinator":"45146","name_coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","plan_number":"3","link":"ca3c2f4c-0f77-4822-9c6a-395f2ee95e6e","primary_link":"https://www.argentina.gob.ar/sites/default/files/tercer_plan_de_accion_nacional_de_gobierno_abierto.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Para el tercer Plan Nacional de Gobierno Abierto se trabajó en la formulación de compromisos más amplios y robustos que en los planes anteriores, mediante la incorporación de áreas temáticas consideradas prioritarias tales como cambio climático, compras y contrataciones, género y transparencia presupuestaria, entre otras.\n\nSe institucionalizó el trabajo colaborativo entre gobierno y sociedad civil con la creación de la Mesa Nacional de Gobierno Abierto conformada por 4 representantes\nde cada una de las partes. Asimismo, se planteó ampliar la participación de las organizaciones de la sociedad civil, en especial de aquellas radicadas fuera de la ciudad de Buenos Aires. En tal sentido, se propuso federalizar el tercer Plan de Acción a través de la realización de seis encuentros regionales, en los que participaron la Coordinación de Gobierno Abierto y organizaciones de la sociedad civil especializadas en la temática, con el fin de convocar y sensibilizar a organizaciones civiles de las provincias, buscando además relevar sus demandas para ser consideradas como posibles compromisos de acción.","description_en":"For the Third National Open Government Action Plan, work focused on formulating broader and more robust commitments than in previous plans, by incorporating priority thematic areas such as climate change, procurement, gender, and budget transparency, among others.\n\nCollaborative work between government and civil society was institutionalized with the creation of the National Open Government Roundtable, composed of four representatives from each side. The plan also aimed to increase participation from civil society organizations, especially those located outside the city of Buenos Aires. To that end, the Third Action Plan was designed to be more federal in scope, with six regional meetings involving the Open Government Coordination and specialized civil society organizations, aiming to engage provincial organizations and gather their demands for potential commitments.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:8c504e69-9f70-483f-ac0a-ba9e46df01ac","meta/deprecatedID":"uuid:1e8fdde4-745b-450a-8102-e6eeba237c3b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8c504e69-9f70-483f-ac0a-ba9e46df01ac","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:11","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8c504e69-9f70-483f-ac0a-ba9e46df01ac"},{"_id":46506,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:12.974","end":"2025-11-07T14:26:12.974","id_drupal":"985","country":"gtm","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Guatemala (2018-2020)","name_en":"Fourth National Open Government Action Plan of Guatemala (2018-2020)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"44996","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"4","link":"f81d6d31-47ee-48ed-879e-9afdf88df7b6","primary_link":"https://gobiernoabierto.transparencia.gob.gt/wp-content/uploads/4to-Plan-de-Accion-Nacional-de-Gobierno-Abierto-2018-2020-FINAL-28-12-2018.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Para la co-creación y construcción técnica de los compromisos para el 4to. Plan de Acción Nacional de Gobierno Abierto, se realizaron mesas de trabajo/diálogo en las cuales se presentaron propuestas sobre metas, temas o proyectos específicos considerados como prioritarios en el marco del eje transversal y las áreas de trabajo del Plan.\n\nLa construcción de los compromisos se hizo en conjunto con la participación de los sectores interesados, teniendo en cuenta que los delegados de las entidades y organizaciones propuestas como responsables del compromiso o meta estuviesen presentes durante la discusión. El proceso de participación ciudadana incluyó la realización de  seis Foros de Consulta Ciudadana en 6 departamentos del país.\n\nPrevio a iniciar el programa de actividades del proceso de co-creación del 4to. Plan, el Instituto Nacional de Administración Pública -INAP- y el Proyecto Participación Cívica/USAID, capacitaron a un grupo de facilitadores de las instituciones públicas, organizaciones de sociedad civil y observadores, para que apoyaran directamente el proceso de co-creación.\n\nEl objetivo principal de los Talleres fue la co-creación de un Plan de Acción Nacional de Gobierno Abierto que lograra contener acciones concretas y efectivas que contribuyan con diversas temáticas primarias para la población, a través de el fortalecimiento de la transparencia, los mecanismos de anti-corrupción y fortalecimiento institucional. Además, se consideró que los compromisos sean transversales a las agendas de importancia para el país, tales como:  la Política General de Gobierno 2016-2020; los Lineamientos Generales de Política; la Agenda 2030 y los Objetivos de Desarrollo Sostenible; el Plan K´atun: Nuestra Guatemala 2032 y las Metas Estratégicas de Desarrollo.   ","description_en":"For the co-creation and technical construction of the commitments for the 4th National Action Plan on Open Government, working/dialogue tables were held where proposals were presented on goals, topics, or specific projects considered priorities within the framework of the cross-cutting axis and the areas of work of the Plan.\nThe construction of the commitments was done in conjunction with the participation of interested sectors, taking into account that the delegates of the entities and organizations proposed as responsible for the commitment or goal were present during the discussion. The citizen participation process included the organization of six Citizen Consultation Forums in 6 departments of the country.\n\nBefore starting the activities program for the co-creation process of the 4th Plan, the National Institute of Public Administration (INAP) and the Civic Participation Project/USAID trained a group of facilitators from public institutions, civil society organizations, and observers to directly support the co-creation process.\n\nThe main objective of the Workshops was the co-creation of a National Action Plan on Open Government that would contain concrete and effective actions contributing to various primary issues for the population, through strengthening transparency, anti-corruption mechanisms, and institutional strengthening. Additionally, it was considered that the commitments should be transversal to the country’s important agendas, such as: the General Government Policy 2016-2020; the General Policy Guidelines; the 2030 Agenda and the Sustainable Development Goals; the K'atun Plan: Our Guatemala 2032 and the Strategic Development Goals.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2bfe2513-479e-4741-acd3-3b91f60d465b","meta/deprecatedID":"uuid:4d8fceb3-f91c-4d4d-863d-d8c14a698e74","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2bfe2513-479e-4741-acd3-3b91f60d465b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2bfe2513-479e-4741-acd3-3b91f60d465b"},{"_id":46507,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:13.683","end":"2025-11-07T14:26:13.683","id_drupal":"986","country":"slv","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de El Salvador (2018-2020)","name_en":"Fourth Open Government National Action Plan of El Salvador (2018–2020)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Participación, Transparencia y Anticorrupción (SPTA) de la Presidencia","responsible_institution/id_institution":"44993","responsible_institution/name_institution":"Secretaría de Participación, Transparencia y Anticorrupción (SPTA) de la Presidencia"}],"plan_number":"4","link":"3de63396-b5ff-4757-9b5b-6a8f10b65ba7","primary_link":"https://www.opengovpartnership.org/documents/el-salvador-action-plan-2018-2020/","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"medium_term","visible_description":"yes","description_es":"Para la construcción del PAN 2018-2020, se realizó una reunión con las organizaciones pertenecientes al Observatorio de Gobierno Abierto para definir la metodología, el cronograma y las temáticas para realizar la consulta con la población. Se realizó una consulta electrónica y talleres presenciales. Participaron 15 instituciones públicas y 9 organizaciones sociales.\n\nSe definió concentrar la consulta en los siguientes tópicos, los cuales se tomaron de la propuesta realizada por las organizaciones del Observatorio de Gobierno Abierto: derechos humanos, medio ambiente, transparencia del gasto público, salud, transparencia en inversión social, educación, obra pública.\n\nLos compromisos del Plan se encuentran vinculados al Plan Quinquenal de Gobierno  2014-2019 y a la Agenda 2030 y los Objetivos de Desarrollo Sostenible.","description_en":"For the development of the 2018–2020 National Action Plan (NAP), a meeting was held with organizations that are part of the Open Government Observatory to define the methodology, timeline, and topics for conducting public consultations. An online consultation and in-person workshops were carried out. Fifteen public institutions and nine civil society organizations participated.\n\nThe consultation focused on the following topics, which were taken from a proposal developed by the organizations of the Open Government Observatory: human rights, environment, transparency in public spending, health, transparency in social investment, education, and public works.\n\nThe commitments in the Plan are linked to the 2014–2019 Five-Year Government Plan and to the 2030 Agenda and the Sustainable Development Goals.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Mecanismo de Revisión Independiente (IRM): El Salvador Informe de resultados de transición 2018–2020","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:85d155c7-bfb0-460d-bdb2-44caed64ea08","meta/deprecatedID":"uuid:07fee659-72a4-4f6d-aa7b-b98c8894ec33","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"85d155c7-bfb0-460d-bdb2-44caed64ea08","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:85d155c7-bfb0-460d-bdb2-44caed64ea08"},{"_id":46508,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:14.406","end":"2025-11-07T14:26:14.406","id_drupal":"617","country":"pan","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción Nacional de Gobierno Abierto de Panamá (2017-2019)","name_en":"Third National Open Government Action Plan of Panama (2017-2019)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia","responsible_institution/id_institution":"45253","responsible_institution/name_institution":"Dirección de Transparencia"}],"coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","id_coordinator":"45147","name_coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","plan_number":"3","link":"b26ee9b8-fe2a-4216-86b3-cfb3dca8634b","primary_link":"https://gobiernoabierto.gob.pa/wp-content/uploads/2024/05/Plan-de-Accion-Nacional-de-Gobierno-Abierto-2017-2019-espanol-v2.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2017-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Para la elaboración del Plan de Acción Nacional de Gobierno Abierto 2017-2019, se identificaron problemáticas sociales, políticas o económicas de relevancia para el país. En virtud de ello, se seleccionaron cinco para trabajar los compromisos del plan:  1. Anticorrupción; 2. Contrataciones públicas; 3. Transparencia parlamentaria; 4. Mejoramiento de los servicios públicos (transporte, salud y agua); 5. Educación.\n\nEl proceso de desarrollo del Plan de Acción Nacional de Gobierno Abierto 2017-2019 se llevó a cabo mediante una metodología abierta y participativa entre la sociedad civil y el sector público, en aras de fortalecer la transparencia, la rendición de cuentas y la participación ciudadana en el gobierno, buscando incentivar a distintos sectores del país para que se involucren en la apertura del mismo. Se llevaron a cabo actividades de sensibilización y capacitación técnica, así como también mesas de trabajo.\n\nEl plan de acción se encuentra articulado con el \"Plan Estratégico de Gobierno 2015-2019 -Un sólo país\".","description_en":"For the development of the 2017–2019 National Open Government Action Plan, social, political, and economic issues of national relevance were identified. As a result, five priority areas were selected to guide the plan’s commitments:\n\nAnti-corruption\n\nPublic procurement\n\nParliamentary transparency\n\nImprovement of public services (transport, health, and water)\n\nEducation\n\nThe development process of the 2017–2019 Action Plan followed an open and participatory methodology involving both civil society and the public sector, with the goal of strengthening transparency, accountability, and citizen participation in government. It also sought to encourage engagement from various sectors of society. Awareness-raising activities, technical training, and working groups were held.\n\nThe action plan is aligned with the 2015–2019 Strategic Government Plan – “One Country”.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:02cea33c-1171-4860-8a1d-df9638c3259e","meta/deprecatedID":"uuid:12db38e0-59eb-443d-9894-f092aa8764b9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"02cea33c-1171-4860-8a1d-df9638c3259e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:13","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:02cea33c-1171-4860-8a1d-df9638c3259e"},{"_id":46509,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:15.222","end":"2025-11-07T14:26:15.222","id_drupal":"1673","country":"per","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Perú (2019-2021)","name_en":"Fourth National Open Government Action Plan of Peru (2019-2021)","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública","responsible_institution/id_institution":"45341","responsible_institution/name_institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Perú","id_coordinator":"45348","name_coordinator":"Foro Multiactor de Gobierno Abierto de Perú","plan_number":"4","link":"0b1b183f-e948-469c-8254-e64b56de6200","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2020/01/Peru_Action-Plan_2019-2021.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2021-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Para la formulación del Cuarto Plan de Acción de Gobierno Abierto de Perú, se mantuvo el enfoque participativo y descentralizado del Tercer Plan de Acción. La definición de las temáticas a abordar en el plan incluyó un análisis previo independiente con apoyo de la Organización para la Cooperación y el Desarrollo Económico (OCDE) el cual revisó la experiencia y tendencias regionales. A partir de lo anterior, se realizaron consultas públicas y se definieron las temáticas de ambiente e industrias extractivas, educación, infreauestructura y contrataciones, justicia, programas sociales, salud, seguridad ciudadana y calidad regulatoria. \n\nEl proceso de co-creación del Plan incluyó a diversos actores sociales, como organizaciones de la sociedad civil, academia, germios empresariales, colegios profecionales agencias de cooperaicón y entidades de la administración pública. Para el desarrollo de la metodología, se tomò en consideración experiencias internacionales en la elaboración de los planes de Gobierno Abierto, como Panamá, Chile y Argentina, y al mismo tiempo países miembros de la OCDE como Canadá, Estados Unidos e Inglaterra. ","description_en":"For the formulation of Peru’s Fourth Open Government Action Plan, a participatory and decentralized approach—similar to that of the Third Plan—was maintained. The selection of plan topics was informed by an independent prior analysis with support from the Organisation for Economic Co-operation and Development (OECD), which reviewed regional experiences and trends. Based on this, public consultations were conducted, leading to the identification of the following priority themes: environment and extractive industries, education, infrastructure and procurement, justice, social programs, health, citizen security, and regulatory quality.\n\nThe co-creation process involved a wide range of stakeholders, including civil society organizations, academia, business associations, professional bodies, development agencies, and public administration entities. The methodology drew on international experiences with Open Government planning processes in countries such as Panama, Chile, and Argentina, as well as OECD members like Canada, the United States, and the United Kingdom.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://www.gob.pe/institucion/pcm/informes-publicaciones/3005239-iv-plan-de-accion-de-gobierno-abierto","pga/pga_mechanism_text_es":"Informe de diseño del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/05/Peru_Design_Report_2019-2021.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:548f59a6-c098-46e8-97e1-d4ed4cf5a64c","meta/deprecatedID":"uuid:94f52b28-c4a4-4ff4-90b5-fe5f8b254a24","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"548f59a6-c098-46e8-97e1-d4ed4cf5a64c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:14","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:548f59a6-c098-46e8-97e1-d4ed4cf5a64c"},{"_id":46510,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:15.930","end":"2025-11-07T14:26:15.930","id_drupal":"1999","country":"chl","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Peñalolén 2021-2024","name_en":"First Open Government Action Plan of Peñalolén 2021-2024","responsible_institution":[{"responsible_institution/institution":"Dirección de Control y Gobierno Abierto de Peñalolén","responsible_institution/id_institution":"45511","responsible_institution/name_institution":"Dirección de Control y Gobierno Abierto de Peñalolén"}],"coordinator":"Mesa de Gobierno Abierto de Peñalolén","id_coordinator":"44941","name_coordinator":"Mesa de Gobierno Abierto de Peñalolén","plan_number":"1","link":"620834f3-7ab0-4f73-ae89-8bdea7383be4","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-penalolen-chile-2021-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Comuna de Peñalolén","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Peñalolén se unió a  Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con la inclusión, la prestación de servicios públicos y el cambio climático.\n\n \n\nEl Primer Plan de Acción cuenta con 3 compromisos:\nCompromiso 1: Construyendo un Peñalolén más verde\nCompromiso 2: Promoción de una administración amigable e inclusiva para las personas con discapacidad\nCompromiso 3: Estar conectado lo hace todo más fácil - Para una gestión municipal más eficiente","description_en":"Peñalolén joined the Open Government Partnership as part of the 2020 cohort. Its first action plan includes commitments related to inclusion, public service delivery, and climate change. The First Action Plan includes 3 commitments: Commitment 1: Building a Greener Peñalolén; Commitment 2: Promoting a Friendly and Inclusive Administration for People with Disabilities; Commitment 3: Being Connected Makes Everything Easier – For More Efficient Municipal Management.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:45ee210c-3347-4704-afa0-57aeb6c93379","meta/deprecatedID":"uuid:ea6b88ad-d239-48ed-adfd-4b1f1411d765","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"45ee210c-3347-4704-afa0-57aeb6c93379","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:45ee210c-3347-4704-afa0-57aeb6c93379"},{"_id":46511,"start":"2025-11-07T14:26:16.667-03:00","end":"2026-04-10T12:22:26.709-04:00","id_drupal":"2107","country":"chl","theme":"urban_development","original_language":"es","name_es":"Política Nacional de Desarrollo Urbano","name_en":"National Urban Development Policy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Vivienda y Urbanismo (MINVU)","responsible_institution/id_institution":"45169","responsible_institution/name_institution":"Ministerio de Vivienda y Urbanismo (MINVU)"},{"responsible_institution/institution":"Consejo Nacional de Desarrollo Territorial","responsible_institution/id_institution":"45370","responsible_institution/name_institution":"Consejo Nacional de Desarrollo Territorial"}],"link":"7743d594-01d4-4bbf-993f-7aafa2bdf4a4","primary_link":"https://cndt.cl/wp-content/uploads/2024/03/Politica_Nacional-_de_Desarrollo-_Urbano-1.pdf","instrument_type":"policy","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Política nacional que, en conjunto con las políticas nacionales de ordenamiento territorial y de desarrollo rural, buscan orientar estratégicamente el desarrollo de los diversos territorios del país, en articulación con las estrategias regionales de desarrollo.\n\nEsta política de desarrollo urbano tiene como objetivo central el generar condiciones para una mejor calidad de vida de las personas y reconoce como principios rectores los de gradualidad, descentralización, equidad, integración social, participación, identidad, compromiso, calidad, eficiencia, adaptabilidad, resiliencia y seguridad. La política formula objetivos generales dentro de cinco ámbitos temáticos: Integración Social, Desarrollo Económico, Equilibrio Ambiental, Identidad y Patrimonio, e Institucionalidad y Gobernanza. Desde 2024 se encuentra en proceso de revisión y actualización\n\nLa actual Política Nacional de Desarrollo Urbano fue elaborada en 2014 por el Ministerio de Vivienda y Urbanismo, se encuentra vigente, y corresponde actualizarla cada 10 años. A partir de la ley 21.074 de 2018, corresponde a la Comisión Interministerial de Ciudad, Vivienda y Territorio (COMICIVYT) su elaboración, actualización e implementación. En el año 2024 la COMICIVYT comenzó su proceso de actualización en conjunto con el Consejo nacional de Desarrollo Territorial (CNDT).","description_en":"National policy which, together with the national land-use planning and rural development policies, seeks to strategically guide the development of the country’s various territories, in coordination with regional development strategies.\n\nThis urban development policy has as its central objective the creation of conditions for a better quality of life for people, and recognizes as guiding principles the following: gradualism, decentralization, equity, social integration, participation, identity, commitment, quality, efficiency, adaptability, resilience, and safety. The policy sets out general objectives within five thematic areas: Social Integration, Economic Development, Environmental Balance, Identity and Heritage, and Institutional Framework and Governance. Since 2024, it has been undergoing a process of review and update.\n\nThe current National Urban Development Policy was prepared in 2014 by the Ministry of Housing and Urbanism. It remains in force and must be updated every ten years. Pursuant to Law No. 21,074 of 2018, the Interministerial Commission on City, Housing and Territory (COMICIVYT) is responsible for its formulation, updating, and implementation. In 2024, COMICIVYT began the process of updating the policy in coordination with the National Council for Territorial Development (CNDT).","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:e56a03df-0914-4e34-b712-4d124a46fbc9","meta/deprecatedID":"uuid:ae75b90e-af43-4a3f-b239-1691944849a3","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e56a03df-0914-4e34-b712-4d124a46fbc9","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e56a03df-0914-4e34-b712-4d124a46fbc9"},{"_id":46512,"start":"2025-11-07T14:26:17.397-03:00","end":"2026-01-29T12:27:06.262-03:00","id_drupal":"1742","country":"bra","theme":"mobility","original_language":"pt","name_es":"Plano de Mobilidade de São Paulo 2015","name_en":"São Paulo Mobility Plan 2015 / São Paulo Mobility Plan 2015","responsible_institution":[{"responsible_institution/institution":"Secretaria Municipal de Transportes","responsible_institution/id_institution":"45300","responsible_institution/name_institution":"Secretaria Municipal de Transportes"}],"link":"23eeed95-38ea-409f-892e-87621f3c1cee","primary_link":"https://www.prefeitura.sp.gov.br/cidade/secretarias/upload/chamadas/planmobsp_v072__1455546429.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de São Paulo/ Ciudad de São Paulo","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2031-01-01","effective_today":"yes","temporality":"long_term","description_es":"Promover la accesibilidad universal en el transporte público y a los componentes de los sistemas municipales de movilidad urbana. Junto con optimizar el uso del sistema vial en un entorno adecuado para el desplazamiento de los modos activos. Igualmente mejorar la logística del transporte de carga; consolidar la gestión democrática en la mejora de la movilidad urbana. Por otra parte, se plantea reducir el número de accidentes de tráfico y muertes; los tiempos de viaje y las emisiones a la atmósfera.","description_en":"Promote universal accessibility in public transport and urban mobility system components. Also, optimize road system use in an adequate environment for active modes of transport. Improve freight transport logistics; consolidate democratic governance in mobility improvement. Reduce traffic accidents and fatalities, travel times, and atmospheric emissions.","linking_sdg_plans":"yes","sdg":"sdg_11 sdg_12 sdg_13","pmu/pmu_implementation":"vision","pmu/pmu_implementation_es":"Se plantea a nivel de fomentar la renovación o adaptación de la flota de transporte urbano público y privado, con el objetivo de reducir las emisiones de gases de efecto invernadero y la contaminación acústica, y la reducción de los gastos de combustible en el uso de vehículos propulsados por fuentes de energía renovables o combustibles menos contaminantes como el gas natural vehicular, híbridos o electricidad;\" (PDE, p.117)- garantizar el suministro, la distribución de bienes y carga, el flujo de producción y la prestación de servicios, con vehículos de carga con mayor eficiencia logística y menor impacto ambiental dando preferencia siempre que sea posible a los vehículos eléctricos, pequeños, mixtos, especiales y no motorizados; (Objetivos transporte de carga, p 123)- Programa Ecofrota trató de sustituir la flota por otros combustibles (p 149)\"","pmu/pmu_implementation_en":"It is proposed at the level of promoting the renewal or adaptation of the public and private urban transport fleet, with the aim of reducing greenhouse gas emissions and noise pollution, and the reduction of fuel costs in the use of vehicles powered by renewable energy sources or less polluting fuels such as vehicular natural gas.  hybrids or electrics;\" (PDE, p.117)- guarantee the supply, distribution of goods and cargo, the flow of production and the provision of services, with cargo vehicles with greater logistical efficiency and lower environmental impact, giving preference whenever possible to electric, small, mixed, special and non-motorized vehicles; (Cargo transport objectives, p 123)- Ecofrota Program tried to replace the fleet with other fuels (p 149)\"","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"La compañia de metro tiene un programa de expansión de su red de alta capacidad que actualmente incluye cuatro frentes de trabajo simultaneas (p.159). Se presentan como se entenderá la red de metro en la ciudad pero de manera general y no proyectos particulares. Se puede deber a que la gobernanza del metro depende de una compañia publica y otra privada. Se presenta al 2015 iniciar operación Red de Madrugada; iniciar construcción de redes y terminales, consolidar red de paso exclusivo. Y nuevo sistema de gestión de movilidad a pie junto con la nueva ley de veredas.","pmu/pmu_prioritization_en":"The metro company has an expansion program of its high-capacity network that currently includes four simultaneous work fronts (p.159). They are presented as the metro network will be understood in the city but in a general way and not in particular projects. It may be because the governance of the metro depends on a public and a private company. It is presented in 2015 to start operation Red de Madrugada; start construction of networks and terminals, consolidate exclusive passage network. And a new mobility management system on foot along with the new sidewalk law.","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","meta/instanceID":"uuid:e1c502ae-28af-4d4b-8879-f7494c131cef","meta/deprecatedID":"uuid:3750be24-fd46-45de-8ac4-019ac2832844","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e1c502ae-28af-4d4b-8879-f7494c131cef","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:16","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e1c502ae-28af-4d4b-8879-f7494c131cef"},{"_id":46513,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:18.111","end":"2025-11-07T14:26:18.111","id_drupal":"2168","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Quintana Roo 2021-2022","name_en":"First Open Government Action Plan of Quintana Roo 2021-2022","responsible_institution":[{"responsible_institution/institution":"Secretaría de la Contraloría (SECOES)","responsible_institution/id_institution":"45096","responsible_institution/name_institution":"Secretaría de la Contraloría (SECOES)"}],"coordinator":"Grupo Motor de Quintana Roo","id_coordinator":"45290","name_coordinator":"Grupo Motor de Quintana Roo","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/inception-report-action-plan-quintana-roo-mexico-2021-2022/+","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Quintana Roo","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Quintana Roo se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción presenta compromisos relacionados con participación ciudadana y apertura fiscal.","description_en":"Quintana Roo joined the Open Government Partnership as part of the 2020 Cohort. The first action plan presents commitments related to citizen participation and fiscal openness.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2772cafb-faac-4351-b32a-4dd1b3a40097","meta/deprecatedID":"uuid:66f94c13-75fc-4b57-982d-9bbe890a4b24","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2772cafb-faac-4351-b32a-4dd1b3a40097","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2772cafb-faac-4351-b32a-4dd1b3a40097"},{"_id":46514,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:18.831","end":"2025-11-07T14:26:18.831","id_drupal":"2053","country":"mex","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Quintana Roo 2023-2025","name_en":"Second Open Government Action Plan of Quintana Roo 2023-2025","responsible_institution":[{"responsible_institution/institution":"Secretaría de la Contraloría (SECOES)","responsible_institution/id_institution":"45096","responsible_institution/name_institution":"Secretaría de la Contraloría (SECOES)"}],"coordinator":"Grupo Motor de Quintana Roo","id_coordinator":"45290","name_coordinator":"Grupo Motor de Quintana Roo","plan_number":"2","primary_link":"https://www.opengovpartnership.org/documents/action-plan-quintana-roo-mexico-2023-2025/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Quintana Roo","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Quintana Roo se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El segundo plan de acción presenta compromisos relacionados con el desarrollo sostenible del Estado, el fortalecimiento de la apertura fiscal, la anticorrupción ambiental y la modernización.","description_en":"Quintana Roo joined the Open Government Partnership as part of the 2020 Cohort. The second action plan includes commitments related to the state's sustainable development, strengthening fiscal openness, environmental anti-corruption, and modernization.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:950318b1-5d83-41b2-8abc-be69e827546f","meta/deprecatedID":"uuid:47f71126-0c4e-4620-859f-f86be98a19c9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"950318b1-5d83-41b2-8abc-be69e827546f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:950318b1-5d83-41b2-8abc-be69e827546f"},{"_id":46515,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:19.549","end":"2025-11-07T14:26:19.549","id_drupal":"2164","country":"ecu","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Quito 2019","name_en":"First Open Government Action Plan of Quito 2019","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación del Municipio del Distrito Metropolitano de Quito","responsible_institution/id_institution":"45362","responsible_institution/name_institution":"Secretaría de Planificación del Municipio del Distrito Metropolitano de Quito"}],"coordinator":"Consejo Consultivo de Gobierno Abierto del MDMQ","id_coordinator":"45284","name_coordinator":"Consejo Consultivo de Gobierno Abierto del MDMQ","plan_number":"1","link":"a451e15f-fa6f-4721-b764-fdda65a3f231","primary_link":"https://zonales.quito.gob.ec/wp-content/uploads/Plan-de-Accion-de-Gobierno-Abierto-MDMQ.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Metropolitano de Quito","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2019-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Quito se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El 1er Plan de Acción de Quito fue presentado antes de su adhesión a la AGA. El primer plan de acción presenta compromisos relacionados con transparencia, colaboración y participación ciudadana.","description_en":"Quito joined the Open Government Partnership (OGP) as part of the 2020 cohort. The first Action Plan was presented prior to joining OGP. The first action plan includes commitments related to transparency, collaboration, and citizen participation.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9da006cf-2c03-4ff4-b131-eac3d0fc177f","meta/deprecatedID":"uuid:b55cb1ba-fa80-4cef-b394-4701a813bd99","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9da006cf-2c03-4ff4-b131-eac3d0fc177f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776197772,"uid":"validation_status_on_hold","by_whom":"ilpes_anonimo","color":"#0000ff","label":"On Hold"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9da006cf-2c03-4ff4-b131-eac3d0fc177f"},{"_id":46516,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:20.275","end":"2025-11-07T14:26:20.275","id_drupal":"2046","country":"ecu","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Quito 2022-2023","name_en":"2nd Open Government Action Plan of Quito 2022-2023","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación del Municipio del Distrito Metropolitano de Quito","responsible_institution/id_institution":"45362","responsible_institution/name_institution":"Secretaría de Planificación del Municipio del Distrito Metropolitano de Quito"}],"coordinator":"Consejo Consultivo de Gobierno Abierto del MDMQ","id_coordinator":"45284","name_coordinator":"Consejo Consultivo de Gobierno Abierto del MDMQ","plan_number":"2","link":"3e13aadd-8f96-4471-b98e-8a0881a14183","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2022/11/SEGUNDO-PLAN-DE-ACCIO%CC%81N-DE-GOBIERNO-ABIERTO-DMQ-LVSEP2022-1.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Metropolitano de Quito","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Quito se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El segundo plan de acción presenta compromisos relacionados con mejorar los niveles de participación e incidencia en la toma de decisiones locales, la implementación de los parámetros internacionales de Parlamento Abierto y la promoción de procesos de desarrollo económico local, entre otros.\n\n \n\nEl Segundo Plan de Acción cuenta con 5 compromisos:\nCompromiso 1: Desarrollar procesos de formación y educación para la participación ciudadana efectiva en Quito\nCompromiso 2: Repotenciación del Geoportal del Municipio del Distrito Metropolitano de Quito\nCompromiso 3: Fortalecer la gestión de la información publicada en el portal de gobierno abierto del municipio\nCompromiso 4: Implementación de los parámetros internacionales de Parlamento Abierto en la gestión del Concejo Metropolitano de Quito\nCompromiso 5: Co-crear un programa para promover procesos de desarrollo económico local en Quito","description_en":"Quito joined the Open Government Partnership (OGP) as part of the 2020 cohort. The Second Action Plan includes commitments aimed at improving participation and influence in local decision-making, implementing international open parliament standards, and promoting local economic development processes, among others.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1ffe8159-821d-4949-b1ad-95f4b5f5e870","meta/deprecatedID":"uuid:1eac63ee-a4f7-4716-9d37-7aac0ac0c7b7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1ffe8159-821d-4949-b1ad-95f4b5f5e870","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:19","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1ffe8159-821d-4949-b1ad-95f4b5f5e870"},{"_id":46517,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:20.996","end":"2025-11-07T14:26:20.996","id_drupal":"2057","country":"dom","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Salcedo 2023-2024","name_en":"First Open Government Action Plan of Salcedo 2023-2024","responsible_institution":[{"responsible_institution/institution":"Gerencia de Planificación de Salcedo","responsible_institution/id_institution":"45201","responsible_institution/name_institution":"Gerencia de Planificación de Salcedo"}],"coordinator":"Consejo Municipal de Desarrollo Ampliado de Salcedo","id_coordinator":"45043","name_coordinator":"Consejo Municipal de Desarrollo Ampliado de Salcedo","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-salcedo-dominican-republic-2023-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Salcedo","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Salcedo se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022. El primer plan de acción presenta compromisos relacionados con el fortalecimiento y promoción de la participación comunitaria, la consolidación de programas de atención a la tercera edad y la habilitación de parques urbanos.","description_en":"Salcedo joined the Open Government Partnership as part of the 2022 cohort. The first action plan presents commitments related to strengthening and promoting community participation, consolidating programs for elderly care, and the development of urban parks.\n\n\n\n\n\n","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1601336a-64bd-4dbf-a93d-f5838abaf641","meta/deprecatedID":"uuid:5ee7735b-3ccc-4586-8533-2d92f09e36bb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1601336a-64bd-4dbf-a93d-f5838abaf641","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:20","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1601336a-64bd-4dbf-a93d-f5838abaf641"},{"_id":46518,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:21.719","end":"2025-11-07T14:26:21.719","id_drupal":"2054","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de San Pedro Garza García 2022-2024","name_en":"First Open Government Action Plan of San Pedro Garza García 2022-2024","responsible_institution":[{"responsible_institution/institution":"Secretaría de Innovación y Participación Ciudadana","responsible_institution/id_institution":"44986","responsible_institution/name_institution":"Secretaría de Innovación y Participación Ciudadana"}],"coordinator":"Foro Multiactor de la Coalición Nuevo León Abierto","id_coordinator":"45104","name_coordinator":"Foro Multiactor de la Coalición Nuevo León Abierto","plan_number":"1","link":"69cfa282-2602-4691-8e75-03d4c84ed03f","primary_link":"https://www.nl.gob.mx/es/publicaciones/plan-de-accion-local-de-gobierno-abierto-2022-2024-de-nuevo-leon","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de San Pedro Garza García ","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"San Pedro Garza García se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022. El primer plan de acción presenta compromisos relacionados con el derecho a la información, la inclusión, la gobernanza digital y la contratación abierta.  Este plan es un trabajo en cosorcio entre Monterrey, el Estado de Nuevo León y San Pedro de Garza García que forman la Coalición NX82:X91uevo León Abierto.","description_en":"San Pedro Garza García joined the Open Government Partnership as part of the 2022 Cohort. The first action plan includes commitments related to the right to information, inclusion, digital governance, and open contracting. This plan is a collaborative effort between Monterrey, the State of Nuevo León, and San Pedro de Garza García, forming the Nuevo León Open Coalition.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:71ed94a5-1ed5-4351-b9ce-9f3caca55954","meta/deprecatedID":"uuid:92e96156-fdf6-4d4b-b237-eaf33d3e0df9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"71ed94a5-1ed5-4351-b9ce-9f3caca55954","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:20","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:71ed94a5-1ed5-4351-b9ce-9f3caca55954"},{"_id":46519,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:22.445","end":"2025-11-07T14:26:22.445","id_drupal":"1993","country":"bra","theme":"open_government","original_language":"pt","name_es":"1er Plan de Acción de Gobierno Abierto de Santa Catarina 2021-2022","name_en":"1º Plano de Ação de Governo Aberto de Santa Catarina 2021-2022 / First Open Government Action Plan of Santa Catarina 2021-2022","responsible_institution":[{"responsible_institution/institution":"Controladoria-Geral do Estado de Santa Catarina","responsible_institution/id_institution":"45086","responsible_institution/name_institution":"Controladoria-Geral do Estado de Santa Catarina"}],"coordinator":"Grupo Motor de Santa Catarina","id_coordinator":"44946","name_coordinator":"Grupo Motor de Santa Catarina","plan_number":"1","link":"466d5b75-32ee-4937-b0c7-5a6eb207ab7d","primary_link":"https://dados.sc.gov.br/dataset/e691c2fd-6b36-46cc-96c1-ca8c8b91b2f7/resource/18bb72a8-e2d8-419d-8f08-c20b63166763/download/1-plano-governo-aberto.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Santa Catarina","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Santa Catarina se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con la lucha contra la corrupción, la prestación de servicios públicos y la apertura fiscal.","description_en":"Santa Catarina joined the Open Government Partnership as part of the 2020 cohort. The first action plan includes commitments related to fighting corruption, public service delivery, and fiscal openness.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:8f7b052e-369b-4f17-9acf-9f79ed4718d4","meta/deprecatedID":"uuid:208ec817-c2b9-41d1-b6ab-feb0d437f1ce","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8f7b052e-369b-4f17-9acf-9f79ed4718d4","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:21","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8f7b052e-369b-4f17-9acf-9f79ed4718d4"},{"_id":46520,"start":"2025-11-07T14:26:23.173-03:00","end":"2026-01-09T09:02:54.764-03:00","id_drupal":"1736","country":"chl","theme":"mobility","original_language":"es","name_es":"Plan Integral de Movilidad 2019-2029 Comuna de Santiago de Chile","name_en":"Comprehensive Mobility Plan 2019-2029 for the Commune of Santiago de Chile","responsible_institution":[{"responsible_institution/institution":"Ilustre Municipalidad de Santiago","responsible_institution/id_institution":"45555","responsible_institution/name_institution":"Ilustre Municipalidad de Santiago"}],"instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Comuna de Santiago","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2029-01-01","effective_today":"yes","temporality":"long_term","description_es":"Santiago, como comuna capital de Chile, ofrece lugares de encuentro para la diversidad de ciudadanos, funciones y culturas, para vecinos, visitantes y turistas.","description_en":"Santiago, as the capital commune of Chile, offers meeting spaces for diverse citizens, functions, and cultures, for residents, visitors, and tourists.","linking_sdg_plans":"yes","pmu/pmu_implementation":"projects","pmu/pmu_implementation_es":"\"Iniciativa de Zona Verde de Transporte de Santiago (ZVTS) para reducir las emisiones de Gases de Efecto Invernadero generadas por el transporte, se definen dos líneas: 1. Promoción de vehículos livianos de cero y baja emisión (ZLEV): taxis y flota vehicular de la municipalidad, a través del uso de vehículos de cero y baja emisión, como por ejemplo vehículos eléctricos o híbridos. 2. Buses de cero y baja emisión (ZLEV) para el transporte público: buses del sistema de transporte público de pasajeros a través del uso de vehículos de cero y baja emisión, como por ejemplo buses eléctricos o híbridos.\"","pmu/pmu_implementation_en":"\"Santiago Green Transport Zone Initiative (ZVTS) to reduce greenhouse gas emissions generated by transport, two lines are defined: 1. Promotion of zero and low emission light vehicles (ZLEV): taxis and the municipality's vehicle fleet, through the use of zero and low emission vehicles, such as electric or hybrid vehicles. 2. Zero and low emission buses (ZLEV) for public transport: buses of the public passenger transport system through the use of zero and low emission vehicles, such as electric or hybrid buses.","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Se define la promoción de vehículos livianos de cero y baja emisión (ZLEV): busca reducir el impacto en las emisiones de GEI producidos por taxis y por la flota vehicular de la municipalidad, a través del uso de vehículos de cero y baja emisión, como por ejemplo vehículos eléctricos o híbridos. Convenio mandato, denominado “Plan Centro”, que entrega recursos para construcción de obras: Remodelación vías de transporte público en el centro de Santiago. Vías priorizadas para los buses / Plan Centro. Medidas de mitigación y mejoramiento de otras vías de la comuna","pmu/pmu_prioritization_en":"The promotion of zero- and low-emission light vehicles (ZLEV) is defined: it seeks to reduce the impact on GHG emissions produced by taxis and by the municipality's vehicle fleet, through the use of zero and low-emission vehicles, such as electric or hybrid vehicles. Mandate agreement, called \"Plan Centro\", which provides resources for the construction of works: Remodeling of public transport roads in downtown Santiago. Prioritized roads for buses / Plan Centro. Mitigation and improvement measures for other roads in the commune","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género y no se menciona la institucionalización de una perspectiva de género","pmu/pmu_gender_en":"No project includes a gender perspective and there is no mention of the institutionalization of a gender perspective","meta/instanceID":"uuid:d0b1d9a7-7283-4b70-8db4-7005339ac9e1","meta/deprecatedID":"uuid:d6cc1e43-2237-4446-b06d-c694d6e89339","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"aPJUaqc6gbHKCdcXQV3bYh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d0b1d9a7-7283-4b70-8db4-7005339ac9e1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:22","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d0b1d9a7-7283-4b70-8db4-7005339ac9e1"},{"_id":46521,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:23.894","end":"2025-11-07T14:26:23.894","id_drupal":"2047","country":"ecu","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Santo Domingo de los Tsáchilas 2021-2023","name_en":"First Open Government Action Plan of Santo Domingo de los Tsáchilas 2021-2023","responsible_institution":[{"responsible_institution/institution":"Dirección de Planificación","responsible_institution/id_institution":"45281","responsible_institution/name_institution":"Dirección de Planificación"}],"coordinator":"Foro Provincial Multisectorial de Santo Domingo de los Tsáchilas","id_coordinator":"45020","name_coordinator":"Foro Provincial Multisectorial de Santo Domingo de los Tsáchilas","plan_number":"1","link":"347a96d3-f7e4-43fb-8f12-470912d8a7cd","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Santo Domingo de los Tsáchilas","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Santo Domingo de los Tsáchilas se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020.El primer plan de acción incluye compromisos relacionados con la participación ciudadana y los datos abiertos.","description_en":"Santo Domingo de los Tsáchilas joined OGP as part of the 2020 cohort. The first action plan includes commitments related to citizen participation and open data.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:17c26500-ad1f-4990-b207-7f23d810980a","meta/deprecatedID":"uuid:838e6ba9-5445-406d-9ae9-78c280e1dff8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"17c26500-ad1f-4990-b207-7f23d810980a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:26:22","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:17c26500-ad1f-4990-b207-7f23d810980a"},{"_id":46522,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:26:24.614","end":"2025-11-07T14:26:24.614","id_drupal":"2165","country":"ecu","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Santo Domingo de los Tsáchilas 2024-2025","name_en":"Second Open Gove