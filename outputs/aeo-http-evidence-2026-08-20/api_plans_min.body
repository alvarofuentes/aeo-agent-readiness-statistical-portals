%B3n%20%20-%20Cartagena.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Turístico y Cultural de Cartagena de Indias","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Cartagena de Indias se unió a Alianza para el Gobierno Abierto  como parte de la cohorte 2022. El primer plan de acción incluye compromisos relacionados con las compras públicas y la rendición de cuentas para la planificación y las finanzas públicas.","description_en":"Cartagena de Indias joined the Open Government Partnership as part of the 2022 cohort. The first action plan includes commitments related to public procurement and accountability for planning and public finances.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:bc84a4cb-cc32-4aa7-8f78-fbea7f81a398","meta/deprecatedID":"uuid:ed01962d-a3e5-4b54-8701-dd946adf5e0f","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bc84a4cb-cc32-4aa7-8f78-fbea7f81a398","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:57","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:bc84a4cb-cc32-4aa7-8f78-fbea7f81a398"},{"_id":46649,"start":"2025-11-07T14:27:58.985-04:00","end":"2026-04-08T09:17:52.061-04:00","id_drupal":"905","country":"hti","theme":"urban_development","original_language":"fr","name_es":"Plan Communal de Développement (PCD) de Haití","name_en":"Municipal Development Plans (PCD) of Haiti","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","description_es":"Este plan es el instrumento de planificación de las iniciativas locales para el desarrollo sostenible. Debe elaborarse de manera participativa con los actores y las comunidades, y seguir las directrices del Plan Estratégico de Desarrollo de Haití.","description_en":"This plan is the planning instrument for local initiatives for sustainable development. It must be developed in a participatory manner with stakeholders and communities, and follow the guidelines of Haiti’s Strategic Development Plan.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:4bac6d8b-cf4f-4a70-b190-de120ef4ccbe","meta/deprecatedID":"uuid:ce1a6f80-b992-4b45-8a8e-17558bbbbd3c","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"4bac6d8b-cf4f-4a70-b190-de120ef4ccbe","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:58","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:4bac6d8b-cf4f-4a70-b190-de120ef4ccbe"},{"_id":46650,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:27:59.906","end":"2025-11-07T14:27:59.906","id_drupal":"2048","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Chihuahua (municipio) 2023-2024","name_en":"1st Open Government Action Plan of Chihuahua (municipality) 2023-2024","responsible_institution":[{"responsible_institution/institution":"Coordinación de Transparencia, Gobierno Abierto y Archivos de Chihuaha","responsible_institution/id_institution":"45093","responsible_institution/name_institution":"Coordinación de Transparencia, Gobierno Abierto y Archivos de Chihuaha"}],"coordinator":"Grupo Impulsor de Gobierno Abierto de Chihuahua","id_coordinator":"45193","name_coordinator":"Grupo Impulsor de Gobierno Abierto de Chihuahua","plan_number":"1","link":"135a63ed-6b37-43c8-9100-fbb2a4a3e8f6","primary_link":"https://micrositios.inai.org.mx/gobiernoabiertoytransparencia/wp-content/uploads/2023/09/Plan-de-Accio%CC%81n-de-Gobierno-Abierto-2023-.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Chihuahua","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Chihuahua (Municipio) se unió a  Alianza para el Gobierno Abierto  como parte de la cohorte 2022. El primer plan de acción incluye compromisos para aumentar la conciencia pública sobre los programas de prevención de la violencia, promover espacios de diálogo y participación ciudadana en temas de emprendimiento y establecer un grupo de trabajo multidisciplinario para colaborar en la planificación y el seguimiento de las decisiones rurales.","description_en":"Chihuahua (Municipality) joined OGP as part of the 2022 cohort. The first action plan includes commitments to raise public awareness about violence prevention programs, promote spaces for dialogue and citizen participation on entrepreneurship issues, and establish a multidisciplinary working group to collaborate on rural decision-making.\n","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:bba7bf5d-7cbe-4dcb-8f99-1cf91c1245f2","meta/deprecatedID":"uuid:4b046d18-0ab2-4037-9051-7655ae3c8655","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bba7bf5d-7cbe-4dcb-8f99-1cf91c1245f2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:27:59","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:bba7bf5d-7cbe-4dcb-8f99-1cf91c1245f2"},{"_id":46651,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:00.810","end":"2025-11-07T14:28:00.810","id_drupal":"1669","country":"col","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Colombia (2020-2022)","name_en":"Fourth National Open Government Action Plan of Colombia (2020-2022)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Transparencia","responsible_institution/id_institution":"45340","responsible_institution/name_institution":"Secretaría de Transparencia"}],"coordinator":"Comité de Estado Abierto de Colombia","id_coordinator":"45149","name_coordinator":"Comité de Estado Abierto de Colombia","plan_number":"4","link":"99caaebd-3621-4d87-acf1-db2c5b87412e","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2020/12/Colombia_Action-Plan_2020-2022.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Colombia se ha visto inmerso en una ola de protestas y movilizaciones que rechazan la corrupción, la opacidad, el uso indebido de los recursos públicos y, por otra parte, en la pandemia del COVID-19. Debido a lo anterior, la confianza y la cohesión social también se han visto afectadas. Por esto, el Cuarto Plan de Acción Nacional de Gobierno Abierto de Colombia tiene un enfoque de Estado que abarca a las entidades del ejecutivo a nivel nacional y local, órganos de control y las altas cortes para recuperar la confianza ciudadana en la institucionalidad pública. \n\nEl Comité de Estado Abierto, con el apoyo del OGP Multi-Donor Trust Fund, diseñó la metodología para el proceso de construcción de este Cuarto Plan de Acción de manera consensuada. En primer lugar, se definieron las áreas temáticas a traves de una consulta ciudadana mediante una encuesta en la que participaron 806 ciudadanos de 29 departamentos. Luego, se identificaron las problemáticas y/o propuestas institucionales para después generar los compromisos. Finalmente, se redactaron y adoptaron los compromisos por parte de las entidades.  ","description_en":"Colombia has experienced a wave of protests and social mobilizations rejecting corruption, lack of transparency, and the misuse of public resources, while also facing the challenges posed by the COVID-19 pandemic. As a result, public trust and social cohesion have been significantly affected. In response, Colombia's Fourth Open Government National Action Plan adopts a state-wide approach that includes national and local executive entities, oversight bodies, and high courts, aiming to restore citizens’ trust in public institutions.\n\nThe Open State Committee, with support from the OGP Multi-Donor Trust Fund, designed the methodology for the co-creation of this Fourth Action Plan through a consensus-based process. First, thematic areas were defined through a public consultation involving a survey in which 806 citizens from 29 departments participated. Subsequently, institutional challenges and/or proposals were identified, which then informed the development of the commitments. Finally, the commitments were drafted and adopted by the respective institutions.","linking_sdg_plans":"no","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Colombia_Progress-Report_2015-2017.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:39073f5e-2c45-4f79-8c64-e1070530335b","meta/deprecatedID":"uuid:680b9b57-c6c1-4bea-b501-7fe37c57976e","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"39073f5e-2c45-4f79-8c64-e1070530335b","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:00","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:39073f5e-2c45-4f79-8c64-e1070530335b"},{"_id":46652,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:01.731","end":"2025-11-07T14:28:01.731","id_drupal":"1670","country":"cri","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Costa Rica (2019-2022)","name_en":"Fourth National Open Government Action Plan of Costa Rica (2019-2022)","responsible_institution":[{"responsible_institution/institution":"Coordinación de Gobierno Abierto ","responsible_institution/id_institution":"45438","responsible_institution/name_institution":"Coordinación de Gobierno Abierto "}],"coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","id_coordinator":"45439","name_coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","plan_number":"4","link":"9fc15cd9-3cde-4423-a7e9-c2aab06daef9","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2020/01/Costa-Rica_Action-Plan_2019-2022_Revised_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Con la pandemia del COVID-19, la Comisión Nacional para un Gobierno Abierto tomó la decisión de ampliar el plazo de ejecución del Plan de Acción para agosto de 2022. Cuando se presentó la primera versión de este plan en 2019, no se había considerado algún compromiso de la Asamblea Legislativa. Sin embargo, en 2020 el Directorio Legislativo aprobó su compromiso, resultando en un noveno compromiso en el Plan de Acción relacionado con el Poder Legislativo. De esta forma, este plan cuenta con compromisos de todos los Poderes del Estado. Su enfoque transversal es el fomento de la transparencia, la rendición de cuentas, la innovación y la participación de la ciudadanía en los procesos de gestión pública de los tres Poderes del Estado. \n\nLa motivación principal de este Plan de Acción es gobernar con la ciudadanía y no para la ciudadanía. En efecto, el plan fue cocreado mediante una estrecha relación y colaboración entre las instituciones públicas, la sociedad civil, el sector privado y la academia. Se establecieron 9 principios para el proceso: transparencia y confianza, participación informada, toma de decisiones con base en evidencia, aprendizaje en conjunto, enfoque en el beneficiario final, participación inclusiva, participación continua, alineación con prioridades de gobierno y metas país y visión nacional. El proceso de cocreación consistió en definr las áreas temáticas del plan, priorizar los problemas por cada área temática, diseñar las propuestas de solución para cada problema identificado y se redactar los compromisos de cada área a partir del problema priorizado.","description_en":"With the COVID-19 pandemic, the National Open Government Commission decided to extend the Action Plan's execution deadline to August 2022. When the first version of the plan was presented in 2019, there was no commitment from the Legislative Assembly. However, in 2020, the Legislative Directorate approved its commitment, resulting in the inclusion of a ninth commitment related to the Legislative Power. Thus, the plan now includes commitments from all three branches of government. Its cross-cutting approach promotes transparency, accountability, innovation, and citizen participation in the public management processes of all three branches of government. The main motivation for this Action Plan is to govern with citizens, not for them. The plan was co-created through close collaboration between public institutions, civil society, the private sector, and academia. Nine principles were established for the process: transparency and trust, informed participation, evidence-based decision-making, joint learning, focus on the end beneficiary, inclusive participation, continuous participation, alignment with government priorities and national goals. The co-creation process consisted of defining thematic areas of the plan, prioritizing issues within each area, designing solutions for each prioritized issue, and drafting the commitments based on the prioritized problem.","linking_sdg_plans":"no","pga/pga_mechanism_text_es":"Informe de diseño del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_text_en":"Costa Rica Results Report 2019-2022 – For Public Comment - Independent Reporting Mechanism ","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/04/Costa-Rica_Design_Report_2019-2021.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:b2e2fee9-b4f2-4eb6-99f4-fed24b43d792","meta/deprecatedID":"uuid:c166032c-643d-47c5-956c-104ada5d05fc","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"b2e2fee9-b4f2-4eb6-99f4-fed24b43d792","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:b2e2fee9-b4f2-4eb6-99f4-fed24b43d792"},{"_id":46653,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:02.641","end":"2025-11-07T14:28:02.641","id_drupal":"621","country":"cri","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Costa Rica (2015-2017)","name_en":"Second National Open Government Action Plan of Costa Rica (2015-2017)","responsible_institution":[{"responsible_institution/institution":"Coordinación de Gobierno Abierto ","responsible_institution/id_institution":"45438","responsible_institution/name_institution":"Coordinación de Gobierno Abierto "}],"coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","id_coordinator":"45439","name_coordinator":"Comisión Nacional para un Estado Abierto de Costa Rica","plan_number":"2","link":"d4cdf6a5-0624-420a-b7e0-ccaaa90a3847","primary_link":"https://observatorioplanificacion.cepal.org/sites/default/files/plan/files/2_Segundo%20Plan%20de%20Acci%C3%B3n%20Costa%20Rica%20%281%29.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2015-01-01","validity_applies_until":"yes","effective_until":"2017-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Consolidar un gobierno abierto y transparente es uno de los tres pilares del \"Plan Nacional de Desarrollo 2015-2018\". De esta forma, se trata de establecer un nuevo paradigma dirigido a transformar la cultura política, empoderando a la ciudadanía por un lado y fortaleciendo el servicio público por el otro, al garantizar una gestión pública más transparente, ética, eficiente y participativa. Asimismo, el Plan se caracteriza por contar con una perspectiva de Estado Abierto, considerando desde el inicio la necesidad de una participación protagónica y permanente de la sociedad civil.\n\nSe destaca el proceso de construcción de prioridades desde la sociedad civil, denominado \"Yo soy Gobierno Abierto\", cuyo producto fue la priorización de las necesidades que los ciudadanos participantes en veinte convocatorias visualizaron desde sus respectivos territorios. Este proceso que lideró Abriendo Datos con el apoyo de la Asociación Centro Ciudadano de Estudios para una Sociedad Abierta (ACCESA) y Estudios Manatí, logró consolidar un acercamiento efectivo en el territorio nacional a través de talleres realizados en distintas regiones, y que fueron base fundamental para el proceso de construcción de los compromisos de este plan.\n\nConjuntamente a las acciones de sociedad civil, se ha dado la tarea de amalgamar una serie de enlaces interinstitucionales, no solo del Poder Ejecutivo sino también desde el Poder Judicial y la Defensoría de los Habitantes, que han asumido el compromiso de ser los agentes de cambio necesarios para la debida apropiación de la cultura de gobierno abierto en sus respectivas instituciones. ","description_en":"Consolidating an open and transparent government is one of the three pillars of the “National Development Plan 2015-2018.” The goal is to establish a new paradigm aimed at transforming the political culture by empowering citizens and strengthening public service by ensuring more transparent, ethical, efficient, and participatory public management. The Plan features an Open State perspective, emphasizing the need for continuous, active citizen participation. It highlights the “I am Open Government” initiative, which prioritized needs identified by citizens in 20 calls from their respective territories. This process, led by Abriendo Datos with support from ACCESA and Estudios Manatí, effectively engaged citizens across the country through workshops, which were key to the construction of the plan's commitments.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:d4616bf0-e1b0-4eec-90aa-bbdbda86f610","meta/deprecatedID":"uuid:e8829754-68fd-4d94-8015-f73b7531ad4c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"d4616bf0-e1b0-4eec-90aa-bbdbda86f610","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:d4616bf0-e1b0-4eec-90aa-bbdbda86f610"},{"_id":46654,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:03.572","end":"2025-11-07T14:28:03.572","id_drupal":"1991","country":"bra","theme":"open_government","original_language":"pt","name_es":"1er Plan de Acción de Gobierno Abierto de Contagem 2022-2024","name_en":"1º Plano de Ação de Governo Aberto de Contagem 2022-2024 / First Open Government Action Plan of Contagem 2022-2024","responsible_institution":[{"responsible_institution/institution":"Controladoria Geral do Município de Contagem","responsible_institution/id_institution":"45099","responsible_institution/name_institution":"Controladoria Geral do Município de Contagem"}],"coordinator":"Controladoria Geral do Município de Contagem","id_coordinator":"45099","name_coordinator":"Controladoria Geral do Município de Contagem","plan_number":"1","link":"efb5673c-7c3b-40da-894b-1a7f3f4b1084","primary_link":"https://www.portal.contagem.mg.gov.br/imgeditor/Plano%20de%20Governo%20Aberto%20-%20Assinado%20pela%20Prefeita.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Município de Contagem","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Contagem se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2022. El primer plan de acción presenta compromisos relacionados con el acceso a la información, la participación ciudadana, la integridad del sector público y la justicia.","description_en":"Contagem joined the Open Government Partnership as part of the 2022 cohort. The first action plan includes commitments related to access to information, citizen participation, public sector integrity, and justice.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:e6bff81b-b58b-4c36-a287-5a02c318b067","meta/deprecatedID":"uuid:83da40b4-fede-4901-82a8-e524c421d039","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e6bff81b-b58b-4c36-a287-5a02c318b067","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:02","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:e6bff81b-b58b-4c36-a287-5a02c318b067"},{"_id":46655,"start":"2025-11-07T14:28:04.483-03:00","end":"2026-01-12T10:20:28.163-03:00","id_drupal":"1981","country":"arg","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Córdoba (ciudad) 2021-2023","name_en":"First Open Government Action Plan of Córdoba (city) 2021-2023","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación, Modernización y Relaciones Internacionales","responsible_institution/id_institution":"45115","responsible_institution/name_institution":"Secretaría de Planificación, Modernización y Relaciones Internacionales"}],"coordinator":"Foro Multiactor de Córdoba","id_coordinator":"45055","name_coordinator":"Foro Multiactor de Córdoba","plan_number":"1","link":"bcf1cc1e-a562-4d75-bd10-1bf49e68bd45","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Córdoba","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Córdoba (Ciudad) se unió a Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con la prestación de servicios públicos. Este plan se trabaja en consorcio con la provincia de Córdoba.","description_en":"Córdoba (City) joined the Open Government Partnership in the 2020 cohort. The first action plan includes commitments related to public service delivery. This plan is being developed jointly with the Province of Córdoba.","linking_sdg_plans":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"1er Plan de Acción de Gobierno Abierto de Córdoba (provincia) 2021-2023","link_block/plan_id":"46656","link_block/plan_name":"1er Plan de Acción de Gobierno Abierto de Córdoba (provincia) 2021-2023"}],"meta/instanceID":"uuid:8b13d5ca-3329-4f16-af74-6f2a82399644","meta/deprecatedID":"uuid:720dce10-0ba1-42c1-b2fa-7f7fb3656066","__version__":"vLkfVRQgpZUqPYUdunwjBx","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8b13d5ca-3329-4f16-af74-6f2a82399644","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8b13d5ca-3329-4f16-af74-6f2a82399644"},{"_id":46656,"start":"2025-11-07T14:28:05.395-03:00","end":"2026-04-13T14:57:30.131-04:00","id_drupal":"1983","country":"arg","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de la Provincia de Córdoba (2021-2023)","name_en":"1st Open Government Action Plan of the Province of Córdoba (2021-2023)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Fortalecimiento Institucional","responsible_institution/id_institution":"45130","responsible_institution/name_institution":"Secretaría de Fortalecimiento Institucional"}],"coordinator":"Foro Multiactor de Córdoba","id_coordinator":"45055","name_coordinator":"Foro Multiactor de Córdoba","plan_number":"1","link":"0f3ae3cf-d9cf-4e73-81d0-4391045d31f7","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Córdoba","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Córdoba (Provincia) se unió a  Alianza para el Gobierno Abierto  como parte de la cohorte 2020. El primer plan de acción incluye compromisos relacionados con los ODS, género, datos abiertos y prestación de servicios públicos. Este plan se trabaja en consorcio con la ciudad de Córdoba.","description_en":"Córdoba (Province) joined the Open Government Partnership in the 2020 cohort. The first action plan includes commitments related to the SDGs, gender, open data, and public service delivery. This plan is being developed jointly with the City of Córdoba.","linking_sdg_plans":"no","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"1er Plan de Acción de Gobierno Abierto de Córdoba (ciudad) 2021-2023","link_block/plan_id":"46655","link_block/plan_name":"1er Plan de Acción de Gobierno Abierto de Córdoba (ciudad) 2021-2023"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:912869c3-3e42-468b-8e39-757b28dc9e78","meta/deprecatedID":"uuid:9835ab73-2577-4b21-ad3e-694d1abd53be","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"912869c3-3e42-468b-8e39-757b28dc9e78","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:04","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:912869c3-3e42-468b-8e39-757b28dc9e78"},{"_id":46657,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:06.322","end":"2025-11-07T14:28:06.323","id_drupal":"2044","country":"cri","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Curridabat 2023-2024","name_en":"First Open Government Action Plan of Curridabat 2023-2024","responsible_institution":[{"responsible_institution/institution":"Municipalidad de Curridabat","responsible_institution/id_institution":"45462","responsible_institution/name_institution":"Municipalidad de Curridabat"}],"plan_number":"1","primary_link":"https://www.opengovpartnership.org/documents/action-plan-curridabat-costa-rica-2023-2024/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Cantón de Curridabat","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2024-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Curridabat se unió a  Alianza para el Gobierno Abierto como parte de la cohorte 2020. El primer plan de acción presenta compromisos relacionados con el arte y la cultura, la institucionalización y la integración de principios de gobierno abierto en el municipio.","description_en":"Curridabat joined the Open Government Partnership as part of the 2020 cohort. The first action plan presents commitments related to art and culture, institutionalization, and the integration of open government principles within the municipality.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:8120b4ac-1b58-440a-955c-152962ed0c05","meta/deprecatedID":"uuid:11b7b9ba-b9ba-44d7-b17e-c020dfb969d7","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8120b4ac-1b58-440a-955c-152962ed0c05","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:05","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:8120b4ac-1b58-440a-955c-152962ed0c05"},{"_id":46658,"start":"2025-11-07T14:28:07.234-04:00","end":"2026-04-06T12:45:03.797-04:00","id_drupal":"881","country":"grd","theme":"territorial_planning","original_language":"en","name_es":"Plan Físico de Granada","name_en":"Physical Plan of Grenada","responsible_institution":[{"responsible_institution/institution":"Unidad de Planificación Física de Granada","responsible_institution/id_institution":"45198","responsible_institution/name_institution":"Unidad de Planificación Física de Granada"}],"link":"1bbfbf37-b318-4418-b052-efca1b91038d","primary_link":"https://grenadaparliament.gd/wp-content/uploads/2021/08/Act-No.-23-of-2016-Physical-Planning-and-Development-Control-Act.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2016-01-01","effective_today":"no","temporality":"medium_term","description_es":"De acuerdo con la Ley de Planificación Física y Control del Desarrollo (Physical Planning and Development Control Act), el Plan Físico debe establecer prescripciones para el uso del suelo que reflejen los resultados de un proceso de planificación integrado. Debe incluir todos los mapas y materiales descriptivos necesarios para ilustrar las propuestas que contiene, con el nivel de detalle apropiado para el conjunto de Granada o para el área específica de Granada a la que se aplique el plan.\n\nUn Plan Físico puede, según corresponda:\n1. Asignar terrenos para la conservación o para su uso o desarrollo con fines agrícolas, residenciales, industriales, comerciales, turísticos u otros propósitos de cualquier clase especificada en el plan.\n2. Prever el desarrollo de infraestructuras, edificios públicos, espacios abiertos y otras obras de inversión del sector público.","description_en":"According to the Physical Planning and Development Control Act, the Physical Planning Act must set out prescriptions for the use of land which represent the results of an integrated planning process and include all maps and descriptive matter necessary to illustrate the proposals made in it with such degree of detail as is appropriate to Grenada as a whole or the are of Grenada to which the plan relates. \n\nA Physical plan may as appropriate:\n1. Allocate land for conservation or for use or development for agricultural, residential, industrial, commercial, toursim or other purposes of any class specified in the plan.\n2. Make provision for the development infrastructure, public buildings, open spaces and other public sector investement works.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:45524744-efbf-4015-828e-ee78eca5f5a3","meta/deprecatedID":"uuid:201f7196-d2aa-4d07-981a-4cebcc7c9b79","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"45524744-efbf-4015-828e-ee78eca5f5a3","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:06","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:45524744-efbf-4015-828e-ee78eca5f5a3"},{"_id":46659,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:08.292","end":"2025-11-07T14:28:08.292","id_drupal":"1674","country":"ecu","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Ecuador (2019-2022)","name_en":"First National Open Government Action Plan of Ecuador (2019-2022)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"45534","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Grupo Núcleo de Ecuador","id_coordinator":"45005","name_coordinator":"Grupo Núcleo de Ecuador","plan_number":"1","link":"b702de20-91f9-4145-97b7-b583a4ce1dbd","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2020/01/Ecuador_Action-Plan_2019-2022_Revised_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"Debido a la pandemia del COVID-19, el primer Plan de Acción de Ecuador amplió su plazo de ejecución hasta el 2022. Este plan fue cocreado con aportes de diversos sectores y se llevó a cabo mediante reuniones presenciales y virtuales. Desde el 2017 el Gobierno de Ecuador se ha centrado en la lucha contra la corrupción y en el diálogo como mecanismos para la recuperación de la confianza en la Administración del Estado. \n\nLa metodología para la construcción del plan tuvo como característica fundamental y transversal la cocreación en todo el proceso. En este sentido, se reconoce la importancia de la participación y colaboración para diseñar e implementar propuestas acordes a los problemas fundamentales de la sociedad. Se establecieron tres niveles de participación: la ciudadanía en general, el Grupo de Trabajo de Gobierno Abierto y el Grupo Núcleo (foro multiactor). El proceso consistió en la recepción de problemas y soluciones, agrupación e integración de propuestas, evaluación y selección de dichas propuestas, confirmación con responsables y contrapartes, rendición de cuentas y, finalmente, la formalización del Plan de Acción. ","description_en":"Due to the COVID-19 pandemic, Ecuador’s first action plan extended its implementation period until 2022. This plan was co-created with contributions from various sectors through both in-person and virtual meetings. Since 2017, the Ecuadorian government has focused on the fight against corruption and dialogue as mechanisms for restoring trust in the state administration.\n\nThe methodology for developing the plan was characterized by co-creation at all stages. The importance of participation and collaboration to design and implement proposals addressing society’s key problems was recognized. Three levels of participation were established: the general public, the Open Government Working Group, and the Core Group (multi-stakeholder forum). The process included the reception of problems and solutions, grouping and integration of proposals, evaluation and selection of proposals, confirmation with responsible parties, accountability, and final formalization of the Action Plan.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://www.gobiernoabierto.ec/seguimiento-paga/","pga/pga_mechanism_text_es":"Informe de diseño del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/09/Ecuador_Design_Report_2019-2021.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:2a0d4b01-cac9-4a12-ada0-343266ed4ac8","meta/deprecatedID":"uuid:004d253a-14ef-49e0-b1a4-070431404bd8","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2a0d4b01-cac9-4a12-ada0-343266ed4ac8","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:07","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:2a0d4b01-cac9-4a12-ada0-343266ed4ac8"},{"_id":46660,"start":"2025-11-07T14:28:09.405-03:00","end":"2026-04-28T10:24:13.487-04:00","id_drupal":"1756","country":"ury","theme":"mobility","original_language":"es","name_es":"Plan de movilidad Montevideo","name_en":"Montevideo Mobility Plan","responsible_institution":[{"responsible_institution/institution":"Intendencia de Montevideo","responsible_institution/id_institution":"45251","responsible_institution/name_institution":"Intendencia de Montevideo"}],"link":"e2c2492a-4556-4854-8d3a-a44dcbd8ef17","primary_link":"https://montevideo.gub.uy/sites/default/files/documentos/plan_de_movilidad.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city dam","city":"Ciudad de Montevideo","dam":"Departamento de Montevideo","validity_applies_from":"yes","effective_since":"2010-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"Desarrollar e implementar un modelo de movilidad de personas y mercaderías racional, eficiente y seguro para Montevideo y el territorio metropolitano. Optimizar y democratizar los modos de transporte, la accesibilidad y la conectividad de las estructuras y sistemas territoriales contribuyendo al desarrollo urbano y social. Potenciar la infraestructura vial de la ciudad y adecuarla a las necesidades de desplazamientos y flujos circulatorios para optimizar las inversiones y minimizar el mantenimiento. Minimizar las externalidades ambientales negativas de la movilidad. Promover la seguridad vial en el departamento.","description_en":"Develop and implement a rational, efficient, and safe model for the mobility of people and goods in Montevideo and the metropolitan area. Optimize and democratize transport modes, accessibility, and connectivity of territorial systems to foster urban and social development. Enhance the city’s road infrastructure to meet flow and movement needs, optimize investment, and minimize maintenance. Minimize environmental externalities from mobility. Promote road safety in the department.","linking_sdg_plans":"yes","sdg":"sdg_11","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"Busca implementar seis corredores exclusivos para líneas troncales, implementar corredores y vías preferenciales. Lograr mover usurios desde el transporte individual hacia el STM mejorando la calidad de los servicios e implementado un sistema de incentivos en los P+R. Crear una Unidad Reguladora de Movilidad Metropolitana. Mejorar la infraestructura de terminales, intercambios y paradas. Aplicar estándares de calidad y cobertura en los servicios de transporte. Incentivar la prioridad en la circulación del transporte público a través de carriles exclusivos y preferenciales. Establecer un sistema de control y fiscalización del nivel del servicio. Tener un monitoreo permanente de la demanda para el rediseño mediante la creación del Observatorio de Movilidad","pmu/pmu_prioritization_en":"It seeks to implement six exclusive corridors for trunk lines, implement corridors and preferential roads. To be able to move users from individual transport to the STM, improving the quality of services and implementing a system of incentives in the P+R. Create a Metropolitan Mobility Regulatory Unit. Improve the infrastructure of terminals, interchanges and stops. Apply quality and coverage standards in transportation services. Encourage priority in the circulation of public transport through exclusive and preferential lanes. Establish a system of control and supervision of the level of service. Have permanent monitoring of demand for redesign through the creation of the Mobility Observatory","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:f1220a9a-93d4-46fe-a951-88e0607ce51e","meta/deprecatedID":"uuid:d8841c49-db44-4603-a9a2-0367afad0695","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"f1220a9a-93d4-46fe-a951-88e0607ce51e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:08","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:f1220a9a-93d4-46fe-a951-88e0607ce51e"},{"_id":46661,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:10.450","end":"2025-11-07T14:28:10.450","id_drupal":"1758","country":"mex","theme":"mobility","original_language":"es","name_es":"Plan integral de movilidad Urbana Sustentable Zona Metropolitana de Tecomán","name_en":"Comprehensive Sustainable Urban Mobility Plan for the Tecomán Metropolitan Area","responsible_institution":[{"responsible_institution/institution":"Secretaría de Movilidad del Estado de Colima y Secretaría de Infraestructura y Desarrollo Urbano","responsible_institution/id_institution":"45454","responsible_institution/name_institution":"Secretaría de Movilidad del Estado de Colima y Secretaría de Infraestructura y Desarrollo Urbano"}],"link":"9935909a-73c5-48e8-8866-d293d629fd0b","primary_link":"https://admiweb.col.gob.mx/archivos_prensa/banco_img/file_613a5c6a92562_VIIInformeEjecutivoTecomanF.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Zona Metropolitana de Tecomán","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2040-01-01","effective_today":"yes","temporality":"long_term","description_es":"Desarrollar el Plan de Movilidad Urbana Sustentable que cumpla con los criterios de planeación, conectividad, intermodalidad, cobertura y universalidad en los proyectos de desarrollo urbano y ordenamiento del territorio para el Estado de Colima a un corto, mediano y largo plazo. • Implementar el Programa de Fortalecimiento Institucional que coadyuve las acciones en conjunto con transparencia y eficiencia para el cumplimiento de las metas en periodos establecidos. • Implementar el programa de Modernización del Transporte Público, con el Sistema Integrado de Transporte Regional (SITR) y la infracción con los distintos medios de transporte. A fin de otorgar mayor cobertura a la zona metropolitana con un servicio de calidad, de acceso universal, incluyente y asequible para la población. • Orientar a la población al uso- no motorizado del transporte, a través de la concientización ambiental y la accesibilidad a medios de transporte sostenibles, sin impactos negativos al medio ambiente y la calidad del aire. A través de la ampliación, modificación, creación e incorporación de la red de ciclovías y áreas peatonales. • Evaluar el Estado actual del medio ambiente y el desarrollo sustentable de la ZMT, en protección de los recursos y el patrimonio natural del Estado, en compromiso con la Ley Sustentable para el Estado de Colima. • Planeación en las proyecciones de nuevas vialidades y rehabilitación de las existentes; que establezcan una interconexión con nuevos desarrollos urbanos en un corto, mediano y largo plazo, según el efecto de la expansión territorial. • Implementación de corredores inteligentes: Instalación de centros de control de sistema electrónico para el monitoreo continuo de vialidades y tránsito en cada municipio. • Renovación de los sistemas de control por semáforos nuevos y de mayor calidad, optimizando las fases y los tiempos en ola verde, de mayor visibilidad para los conductores, y en perfecta sincronía de colores. • Mantenimiento e identificación de vialidades con superficie de rodamiento en estado regular o malo. • Regularización de estacionamientos mediante la oferta de estacionamiento sobre la vía dentro de la Zona Metropolitana. • Implementación de un nuevo sistema de cobro a bordo de las unidades del transporte público.","description_en":"Develop a Sustainable Urban Mobility Plan aligned with planning, connectivity, intermodality, coverage, and universality criteria in urban development and territorial planning projects for the State of Colima in the short, medium, and long term.\n\nImplement an Institutional Strengthening Program to support joint actions with transparency and efficiency.\n\nImplement a Public Transport Modernization Program, using the Integrated Regional Transport System (SITR), integrating various transport modes for broader coverage, universal access, inclusivity, and affordability.\n\nPromote non-motorized transport through environmental awareness and accessibility to sustainable modes, without harming the environment or air quality. Expand, modify, and create cycle paths and pedestrian areas.\n\nAssess the current environmental state and sustainable development of the ZMT, protecting natural resources and heritage in line with Colima's Sustainable Law.\n\nPlan new roads and rehabilitate existing ones to interconnect new urban developments based on projected territorial expansion.\n\nImplement smart corridors: install electronic control centers for continuous traffic monitoring.\n\nRenew traffic light systems to optimize timing and visibility, ensuring better synchronization.\n\nMaintain and identify roads with fair or poor surfaces.\n\nRegulate parking availability within the Metropolitan Zone.\n\nImplement a new fare system for public transport vehicles.","linking_sdg_plans":"yes","pmu/pmu_implementation":"not_considered","pmu/pmu_prioritization_type":"public","pmu/pmu_prioritization_es":"\"Mejorar las condiciones de operación del sistema de transporte público con una visión de eficiencia, calidad y economía. • Propiciar la cobertura del servicio de transporte público en la Zona Metropolitana de Tecomán - Armería. • Proponer un esquema tarifario de integración de rutas. • Proponer sistemas eficientes de organización con la participación de los transportistas.• Proponer el uso de herramientas tecnológicas para establecer sistemas sustentables de transporte. • Proponer el uso de vehículos con capacidad adecuada a la demanda, con los mejores niveles de confort y con equipos con baja emisión de contaminantes. Disminuir los tiempos de ascenso y descenso de las unidades mediante la implementación de sistemas tecnológicos de pago y pre-pago. Proponer el uso de estaciones de fácil mantenimiento, limpias, cómodas, seguras y que consideren las condiciones climáticas de la localidad. Proponer una señalización clara para el usuario.• Proponer soluciones que signifiquen el menor costo en las posibles afectaciones en general. Como prioridad a los elementos antes descritos se debe de adicionar la intermodalidad y accesibilidad preferente.\"","pmu/pmu_prioritization_en":"\"Improve the operating conditions of the public transport system with a vision of efficiency, quality and economy. • To promote the coverage of the public transport service in the Metropolitan Area of Tecomán - Armería. • To propose a tariff scheme for the integration of routes. • Propose efficient organizational systems with the participation of carriers.• Propose the use of technological tools to establish sustainable transportation systems. • Propose the use of vehicles with adequate capacity for demand, with the best levels of comfort and with equipment with low pollutant emissions. Reduce the times of ascent and descent of the units through the implementation of technological payment and pre-payment systems. Propose the use of easy-to-maintain, clean, comfortable, safe stations that take into account the climatic conditions of the locality. Propose clear signage for the user.• Propose solutions that mean the lowest cost in the possible effects in general. As a priority to the elements described above, intermodality and preferential accessibility must be added.\"","pmu/pmu_gender_es":"Ningún proyecto incluye una perspectiva de género. Y no se menciona la institucionalización de una perspectiva de género.","pmu/pmu_gender_en":"No project includes a gender perspective. And there is no mention of the institutionalization of a gender perspective.","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:420b582a-b0bf-4ba1-b1b2-f7e67566b27e","meta/deprecatedID":"uuid:c5832385-eb54-4477-8a30-dea48ce1760c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"420b582a-b0bf-4ba1-b1b2-f7e67566b27e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:420b582a-b0bf-4ba1-b1b2-f7e67566b27e"},{"_id":46662,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:11.364","end":"2025-11-07T14:28:11.364","id_drupal":"1687","country":"gtm","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción Nacional de Gobierno Abierto de Guatemala (2021-2023)","name_en":"Fifth National Open Government Action Plan of Guatemala (2021-2023)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"44996","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"5","link":"7a16cd8e-f586-481d-9098-53a1f70da5c7","primary_link":"https://transparencia.gob.gt/wp-content/uploads/2022/07/5to-Plan-de-Accion-Nacional-Gobierno-Abierto-Guatemala-final.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2023-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El 5to Plan de Acción de Guatemala fue diseñado por 36 instituciones públicas y organizaciones de la sociedad civil. Este plan tiene como eje central la transparencia en la gestión pública y presupuesto del Estado. El plan toma en cuenta seis áreas temáticas para el desarrollo de sus compromisos: Gobierno digital y modernización de la gestión pública; educación, salud, seguridad alimentaria y nutricional; medio ambiente, cambio climático; migración y reducción de la pobreza; inclusión social y poblaciones en condiciones de vulnerabilidad y gestión y seguimiento de inicativas, tratados y convenios internacionales en materia de transparencia, anticorrupción y rendición de cuentas. \n\nPara crear el plan, se llevaron a cabo más de cien reuniones y actividades de cocreación, seis conversatorios ciudadanos, veintiséis reuniones de trabajo de cocreación de los compromisos, diecisiete reuniones de trabajo entre representantes de organizaciones de la sociedad civil e instituciones públicas, 35 reuniones del Comité Técnico de Gobierno Abierto (Foro Multiactor de Gobierno Abierto en Guatemala), y tres reuniones en seguimiento al proceso de cocreación entre la Alianza Mundial para el Gobierno Abierto, el Colectivo de Organizaciones Sociales y Punto de Contacto Técnico de Gobierno Abierto.","description_en":"The 5th Action Plan of Guatemala was designed by 36 public institutions and civil society organizations. This plan’s central focus is transparency in public management and the State budget. The plan takes into account six thematic areas for the development of its commitments: Digital government and modernization of public management; education, health, food security and nutrition; environment, climate change; migration and poverty reduction; social inclusion and populations in vulnerable conditions; and management and monitoring of initiatives, treaties, and international agreements on transparency, anti-corruption, and accountability.\nTo create the plan, more than one hundred co-creation meetings and activities were held, six citizen conversations, twenty-six co-creation working meetings for the commitments, seventeen working meetings between representatives of civil society organizations and public institutions, 35 meetings of the Technical Committee for Open Government (Multi-actor Open Government Forum in Guatemala), and three meetings to follow up on the co-creation process between the Open Government Partnership, the Collective of Social Organizations, and the Open Government Technical Contact Point.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://gobiernoabierto.transparencia.gob.gt/tablero-5to-plan/","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ef3427d0-2d72-40a2-a89b-03eb142c8fd9","meta/deprecatedID":"uuid:e68fb052-db91-49a0-bf0d-89565ebb430b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ef3427d0-2d72-40a2-a89b-03eb142c8fd9","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ef3427d0-2d72-40a2-a89b-03eb142c8fd9"},{"_id":46663,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:12.276","end":"2025-11-07T14:28:12.276","id_drupal":"2301","country":"pan","theme":"open_government","original_language":"es","name_es":"Quinto Plan de Acción Nacional de Gobierno Abierto de Panamá (2023-2025)","name_en":"Fifth National Open Government Action Plan of Panama (2023-2025)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transparencia","responsible_institution/id_institution":"45253","responsible_institution/name_institution":"Dirección de Transparencia"}],"coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","id_coordinator":"45147","name_coordinator":"Comisión Nacional de Gobierno Abierto de Panamá","plan_number":"5","link":"dad8ba51-26a3-4bdd-b5c7-91c73dfb1a66","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2023/08/Panama_Action-Plan_2023-2025.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2023-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El 5to Plan de Acción de Panamá garantiza avanzar en los compromisos generados en el 4to Plan de Acción, centrados en los principios de un gobierno abierto, transparencia, participación y colaboración, además de estar alineados a la Agenda 2030 para el Desarrollo Sostenible, específicamente el Objetivo 16 en sus metas 16.6, 16.7 y 16.10. Además, este Plan se encuentra alineado al Plan Estratégico de Gobierno 2019-2024. A su vez, el Plan se enmarca en el segundo eje estratégico del Plan Estratégico Institucional 2020-2024 de la Autoridad Nacional de Transparencia y Acceso a la Información, punto focal de la Alianza para el Gobierno Abierto. \n\nLos compromisos asumidos integran una perspectiva de género y un enfoque en la reducción de brechas de desigualdad, promoción de la participación ciudadana y buscan garantizar el derecho al acceso a la información mediante el uso de las Tecnologías de la Información y la Comunicación (TIC) como elemento importante del gobierno abierto.\n\nTodo el proceso de definición de compromisos fue articulado con las organizaciones de la sociedad civil que conforman la Comisión Nacional de Gobierno Abierto, se tomaron en cuenta las recomendaciones hechas por el Mecanismo de Revisión Independiente del Plan anterior al identificar compromisos de alto impacto a nivel nacional para el país, que se sostienen y potencian en este nuevo plan.","description_en":"Panama’s fifth action plan guarantees progress on the commitments made in the fourth action plan, centered on the principles of open government, transparency, participation, and collaboration, and aligned with the 2030 Sustainable Development Agenda, specifically Goal 16 and its targets 16.6, 16.7, and 16.10. The plan is also aligned with the 2019-2024 Government Strategic Plan.\n\nThe commitments include a gender perspective, a focus on reducing inequality gaps, promoting citizen participation, and ensuring the right to access information through the use of ICTs, which is a critical element of open government.\n\nThe process of defining commitments involved civil society organizations in the National Open Government Commission, incorporating recommendations from the Independent Review Mechanism of the previous plan to identify high-impact commitments at the national level. These commitments are carried forward and strengthened in this new plan.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:45d2f132-b498-4371-93b8-258e454327a7","meta/deprecatedID":"uuid:ddcc051b-2c16-4bd1-9d95-720e10d81a1b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"45d2f132-b498-4371-93b8-258e454327a7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:11","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:45d2f132-b498-4371-93b8-258e454327a7"},{"_id":46664,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:13.189","end":"2025-11-07T14:28:13.189","id_drupal":"636","country":"chl","theme":"open_government","original_language":"es","name_es":"Segundo Plan de Acción Nacional de Gobierno Abierto de Chile (2014-2016)","name_en":"Second National Open Government Action Plan of Chile (2014-2016)","responsible_institution":[{"responsible_institution/institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile","responsible_institution/id_institution":"45342","responsible_institution/name_institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile"}],"coordinator":"Mesa Nacional de Estado Abierto de Chile","id_coordinator":"45154","name_coordinator":"Mesa Nacional de Estado Abierto de Chile","plan_number":"2","link":"a35b891b-5b46-4980-ae8e-458ba9290b6e","primary_link":"https://www.ogp.gob.cl/wp-content/uploads/2019/06/Plan-de-Accion-2014-16-CHILE-OFICIAL.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El compromiso de un Gobierno Abierto es hoy una política de Estado en Chile. En esa dirección el país ha avanzado no sólo en la expedición de importantes normas al respecto, sino también en acciones para obtener mayores niveles de transparencia, eficiencia y participación ciudadana. En ese sentido, el gobierno ha venido impulsando una agenda de modernización de las instituciones públicas cuya finalidad es avanzar hacia un Estado totalmente al servicio de sus ciudadanos. El proceso de diseño del presente Plan de Acción de Chile tuvo dos momentos marcados por el cambio de gobierno. Luego del cual se redefinieron los  compromisos, tomando los ya elaborados como insumo básico, pero adecuándolos a los requerimientos de claridad en la definición de responsables, plazos, recursos, mecanismos de monitoreo y evaluación.\n\nPara iniciar el trabajo de elaboración del Plan, se convocó a la Mesa Permanente de gobierno abierto, compuesta tanto por representantes del gobierno como también de organizaciones de la sociedad civil para poder presentar un nuevo cronograma de trabajo. A partir de la primera reunión de la Mesa comenzó el trabajo de revisión de compromisos, de inclusión de nuevos compromisos formulados por miembros de la Mesa Permanente y el consiguiente debate. Para fortalecer el rol de la Mesa se ampliaron sus miembros sumando a organizaciones de la sociedad civil con foco específico en participación ciudadana, a la División de Coordinación Interministerial del Ministerio Secretaría General de la Presidencia y a la División de Organizaciones Sociales del Ministerio Secretaría General de Gobierno.","description_en":"The commitment to Open Government is now a state policy in Chile. In this direction, the country has made progress not only in enacting key regulations but also in implementing actions to enhance transparency, efficiency, and citizen participation. The government has promoted a public institution modernization agenda aimed at building a state fully at the service of its citizens. The design process of this Action Plan occurred in two stages marked by a change in government, after which the commitments were redefined using existing ones as a base, and adjusting them to include clear responsibilities, timelines, resources, and monitoring and evaluation mechanisms. To begin the development of the Plan, the Permanent Open Government Board was convened, composed of representatives from both the government and civil society organizations, to establish a new work schedule. From the Board's first meeting, a review of commitments began, including new proposals from Board members. To strengthen the Board's role, new members were added, including civil society organizations focused on citizen participation, and representatives from the Ministry of the Presidency and the Ministry of Government.","linking_sdg_plans":"no","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2001/01/Chile_EOTR_2014-2016_0.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:c8bb2f3e-250a-49c4-80a4-28e014dd9b47","meta/deprecatedID":"uuid:be90f278-2d47-4581-8d3d-1aae3a711bf9","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c8bb2f3e-250a-49c4-80a4-28e014dd9b47","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c8bb2f3e-250a-49c4-80a4-28e014dd9b47"},{"_id":46665,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:14.107","end":"2025-11-07T14:28:14.107","id_drupal":"1671","country":"mex","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de México (2019-2022)","name_en":"Fourth National Open Government Action Plan of Mexico (2019-2022) ","responsible_institution":[{"responsible_institution/institution":"Secretaría de la Función Pública de México","responsible_institution/id_institution":"45276","responsible_institution/name_institution":"Secretaría de la Función Pública de México"}],"coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","id_coordinator":"45155","name_coordinator":"Comité Coordinador de la Alianza para el Gobierno Abierto de México","plan_number":"4","link":"151599c9-9283-4a31-b146-fce6b9f61e82","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2019/12/Mexico_Action-Plan_2019-2022_Revised_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El contexto previo a la redacción de este Cuarto Plan se caracterizó por la mala reputación que el Gobierno mexicano adquirió, en cuanto los medios internacionales lo catalogaron como \"Gobierno Espía\" al salir a la luz varios casos de espionaje en contra de la sociedad civil. Lo anterior provocó una incertidumbre sobre la permanencia de México en la Alianza para el Gobierno Abierto. Sin embargo, el proceso de elaboración del plan representó un nuevo punto de partida que elevó expectativas acerca del gobierno abierto en el país. \n\nDurante ocho meses el Comité Coordinador, el foro multiactor del país, llevó a cabo un proceso de cocreación que incluyó la participación de más de 1.100 personas de manera virtual y 400 personas en forma presencial. Lo anterior dio como resultado 6 compromisos cocreados (del proceso de la consulta) y 7 compromisos proactivos (propuestos por el Gobierno y la sociedad civil).","description_en":"The context preceding the drafting of this Fourth Action Plan was marked by the negative reputation that the Mexican government acquired, as international media labeled it the \"Spy Government\" after several cases of espionage against civil society were revealed. This led to uncertainty regarding Mexico's continued participation in the Open Government Partnership. However, the process of developing the plan represented a fresh start that raised expectations for open government in the country.\n\nFor eight months, the Coordinating Committee, the country's multi-stakeholder forum, carried out a co-creation process that involved more than 1,100 virtual participants and 400 in-person participants. As a result, six co-created commitments (from the consultation process) and seven proactive commitments (proposed by the government and civil society) were formed.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://tablero.gobabiertomx.org/","pga/pga_mechanism_text_es":"Informe de resultados del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_text_en":"Mexico Results Report 2019-2022 - For Public Comment - Independent Reporting Mechanism","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2023/06/Mexico_Results-Report_2019-2022_for-public-comment.pdf","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:ea9fa867-dc1f-4a9c-8c73-4517810cab5f","meta/deprecatedID":"uuid:b8e8ecb8-37de-46dd-b78f-b004c6b6a26b","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ea9fa867-dc1f-4a9c-8c73-4517810cab5f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:13","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:ea9fa867-dc1f-4a9c-8c73-4517810cab5f"},{"_id":46666,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:15.014","end":"2025-11-07T14:28:15.014","id_drupal":"1667","country":"arg","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción Nacional de Gobierno Abierto de Argentina (2019-2022)","name_en":"Fourth National Open Government Action Plan of Argentina (2019-2022)","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital","responsible_institution/id_institution":"45339","responsible_institution/name_institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital"}],"coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","id_coordinator":"45146","name_coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","plan_number":"4","link":"e07f7a6e-1a1b-4fcb-ac66-092986e72705","primary_link":"https://nube.innovacion.gob.ar/s/ttS2c3xTFHDNfnj","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2019-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Cuarto Plan de Acción Nacional se inserta en un contexto golpeado por la crisis sanitaria y económica mundial. Comenzó a desarrollarse a inicios de 2019 como resultado de la cocreación entre diversas áreas del Estado, más de 70 organizaciones de la sociedad civil y 300 ciudadanos y ciudadanas. Debido a la pandemia del COVID-19 y sus efectos sobre la implementación de los compromisos, la Mesa Nacional de Gobierno Abierto acordó una extensión anual de la duración del plan, con previo acuerdo de la Alianza para el Gobierno Abierto. Por primera vez, este plan propone transversalizar la perspectiva de género y diversidad en la implementación de los compromisos. \n\nSe institucionalizó la instancia de coordinación entre Gobierno y Organizaciones de la Sociedad Civil mediante la Mesa Nacional de Gobierno Abierto. La Mesa lideró el proceso de cocreación del Cuarto Plan de Acción, estableciendo la metodología, identificando las temáticas clave, evaluando las propuestas recibidas y participando en las mesas de diálogo y mesas de redacción de los compromisos. Además, la Mesa realiza el seguimiento de la implementación de todos los compromisos del plan, a través de tableros de monitoreo público y organiza reuniones para dar a conocer los avances y desafíos en la implementación. \n\n","description_en":"The Fourth National Action Plan emerged in a context hit by the global health and economic crisis. It began to develop in early 2019 as a result of co-creation among various state areas, more than 70 civil society organizations, and 300 citizens. Due to the COVID-19 pandemic and its effects on the implementation of the commitments, the National Open Government Roundtable agreed to extend the duration of the plan by one year, with prior agreement from the Open Government Partnership. For the first time, this plan proposed mainstreaming a gender and diversity perspective in the implementation of its commitments.\n\nThe coordination mechanism between the Government and Civil Society Organizations was institutionalized through the National Open Government Roundtable. The Roundtable led the co-creation process of the Fourth Action Plan, establishing the methodology, identifying key topics, evaluating the proposals received, and participating in dialogue tables and drafting meetings. Additionally, the Roundtable monitors the implementation of all plan commitments through public monitoring dashboards and organizes meetings to communicate progress and challenges in implementation.","linking_sdg_plans":"no","pga/pga_monitoring_platform":"https://trello.com/cuartoplandeaccionnacionaldegobiernoabierto20192021","pga/pga_mechanism_text_es":"Informe de diseño del Mecanismo de Revisión Independiente de la Alianza para el Gobierno Abierto","pga/pga_mechanism_url":"https://www.opengovpartnership.org/wp-content/uploads/2021/04/Argentina_Design_Report_2019-2021.pdf","pga/pga_main_approach_es":"Perspectiva de género; diversidad","pga/pga_main_approach_en":"Gender perspective; diversity","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:85503ce8-ff73-4f09-84e2-7312e1c43b58","meta/deprecatedID":"uuid:dd583e30-a340-4ba4-a68d-6231ac6418ad","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"85503ce8-ff73-4f09-84e2-7312e1c43b58","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:14","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:85503ce8-ff73-4f09-84e2-7312e1c43b58"},{"_id":46667,"start":"2025-11-07T14:28:15.933-04:00","end":"2026-04-06T12:48:32.575-04:00","id_drupal":"742","country":"cub","theme":"territorial_planning","original_language":"es","name_es":"Esquema Nacional de Ordenamiento Territorial hasta el año 2030 (Acuerdo N° 8.928)","name_en":"National Territorial Planning Scheme until 2030 (Agreement No. 8.928)","responsible_institution":[{"responsible_institution/institution":"Instituto de Planificación Física de Cuba","responsible_institution/id_institution":"45334","responsible_institution/name_institution":"Instituto de Planificación Física de Cuba"}],"link":"0e64b95c-b608-4925-91b1-c954c77ac21c","primary_link":"https://www.gacetaoficial.gob.cu/sites/default/files/goc-2020-o75.pdf / https://www.inotu.gob.cu/sites/default/files/revista/Emigdia.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2020-01-01","validity_applies_until":"yes","effective_until":"2030-01-01","effective_today":"yes","temporality":"long_term","description_es":"El Esquema Nacional de Ordenamiento Territorial (ENOT) es el instrumento de planeamiento territorial que a partir de una visión estratégica de largo plazo ofrece propuestas integrales de distribución de las fuerzas productivas y de ordenamiento de las estructuras territoriales de carácter socioeconómicas, político administrativas y ambientales. Así, se establecen modelos de desarrollos territoriales flexibles y dinámicos para los horizontes de proyección del proceso inversionista a corto, mediano y largo plazos, en correspondencia con las escalas físico-espaciales.","description_en":"The National Land Use Framework (ENOT) is the territorial planning instrument that, based on a long-term strategic vision, provides integrated proposals for the distribution of productive forces and the organization of territorial structures of a socioeconomic, political-administrative, and environmental nature. Thus, it establishes flexible and dynamic territorial development models aligned with the projected timeframes of investment processes in the short, medium, and long term, in accordance with the physical-spatial scales.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:21cf479b-b35d-4c81-9340-dd86aa223564","meta/deprecatedID":"uuid:dd4b47ca-60e1-4c3e-97a0-422dc4edd410","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"21cf479b-b35d-4c81-9340-dd86aa223564","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:21cf479b-b35d-4c81-9340-dd86aa223564"},{"_id":46668,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:16.859","end":"2025-11-07T14:28:16.859","id_drupal":"2052","country":"mex","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Estado de México 2021-2022","name_en":"First Open Government Action Plan of Estado de México 2021-2022","responsible_institution":[{"responsible_institution/institution":"Instituto de Transparencia, Acceso a la Información Pública y Protección de Datos Personales del Estado de México y Municipios (INFOEM) / Secretaría de la Contraloría","responsible_institution/id_institution":"45112","responsible_institution/name_institution":"Instituto de Transparencia, Acceso a la Información Pública y Protección de Datos Personales del Estado de México y Municipios (INFOEM) / Secretaría de la Contraloría"}],"coordinator":"Secretariado Técnico Local del Estado de México","id_coordinator":"45315","name_coordinator":"Secretariado Técnico Local del Estado de México","plan_number":"1","link":"855ae95e-d961-46e9-9b9d-436c21e6111c","primary_link":"https://www.infoem.org.mx/doc/gobiernoAbierto/20211221_Plan_de_Accion_Local_Edomex.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de México","validity_applies_from":"yes","effective_since":"2021-01-01","validity_applies_until":"yes","effective_until":"2022-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Estado de México se unió a  Alianza para el Gobierno Abierto como parte de la Cohorte 2020. El primer plan de acción presenta compromisos relacionados con el acceso a la justicia, datos abiertos, acceso a la información y participación ciudadana. Este primer plan de acción es un trabajo en consorcio con Tlalnepantla de Baz.","description_en":"The State of Mexico joined the Open Government Partnership as part of the 2020 Cohort. The first action plan presents commitments related to access to justice, open data, access to information, and citizen participation. This first action plan is a collaborative effort with Tlalnepantla de Baz.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:1eb1c7d2-5e7a-4a08-abd1-d35dc77e4efa","meta/deprecatedID":"uuid:2966560a-bbfe-4a20-8c6b-944991629ac2","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1eb1c7d2-5e7a-4a08-abd1-d35dc77e4efa","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:16","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:1eb1c7d2-5e7a-4a08-abd1-d35dc77e4efa"},{"_id":46669,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:17.770","end":"2025-11-07T14:28:17.770","id_drupal":"669","country":"chl","theme":"open_government","original_language":"es","name_es":"Cuarto Plan de Acción de Gobierno Abierto de Chile (2018-2020)","name_en":"Fourth Open Government Action Plan of Chile (2018-2020)","responsible_institution":[{"responsible_institution/institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile","responsible_institution/id_institution":"45342","responsible_institution/name_institution":"Comisión Asesora Presidencial para la Integridad Pública y Transparencia de Chile"}],"coordinator":"Mesa Nacional de Estado Abierto de Chile","id_coordinator":"45154","name_coordinator":"Mesa Nacional de Estado Abierto de Chile","plan_number":"4","link":"9a59ece6-08f9-438b-b0e5-bf7fd5fb9a08","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2019/01/Chile_Action-Plan_2018-2020.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2018-01-01","validity_applies_until":"yes","effective_until":"2020-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El fin último del trabajo de co-creación para la elaboración del presente Plan de Acción fue establecer prioridades a nivel nacional que contuviesen una fuerte impronta\nciudadana. Además de la participación ciudadana como valor central, subyacen a este proceso inclusivo de co-creación los valores de no discriminación, apertura, inclusión y lenguaje claro.\n\nLa convocatoria a participar de las mesas de trabajo estuvo dirigida a representantes de servicios públicos, organizaciones de la sociedad civil, organizaciones sociales,\nacademia, sector privado y a la ciudadanía en general.\n\nLas propuestas de compromisos de acción fueron sistematizadas en ejes temáticos, los cuales dieron lugar a nueve mesas de trabajo: Educación y formación en Gobierno Abierto; Gobierno Abierto entre otros poderes del Estado; Gobierno Abierto a nivel subnacional; Inclusión, integración y derechos de las personas; Integridad en la función pública; Medio ambiente y recursos naturales; Participación ciudadana; Transparencia y datos abiertos; Políticas de transparencia y apertura fiscal. Las mesas de trabajo se desarrollaron en 7 regiones del país.\n\nLos compromisos en el plan se encuentran vinculados a los Objetivos de Desarrollo Sostenible de la Agenda 2030.","description_en":"The ultimate goal of the co-creation work for the development of this Action Plan was to establish national priorities with a strong citizen-driven focus. In addition to citizen participation as a core value, the inclusive co-creation process was guided by the values of non-discrimination, openness, inclusion, and plain language.\n\nThe call to participate in the working groups was extended to representatives of public services, civil society organizations, social organizations, academia, the private sector, and the general public.\n\nThe proposed action commitments were organized into thematic areas, which led to the creation of nine working groups: Education and training in Open Government; Open Government across other branches of the State; Open Government at the subnational level; Inclusion, integration, and people's rights; Public sector integrity; Environment and natural resources; Citizen participation; Transparency and open data; Transparency policies and fiscal openness. The working groups were held in 7 regions across the country.\n\nThe commitments in the plan are linked to the Sustainable Development Goals (SDGs) of the 2030 Agenda.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:9a99a952-4266-4bfa-8c3e-927cc9589550","meta/deprecatedID":"uuid:c328df90-996f-441a-9ac2-a29a0e1d7cdb","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9a99a952-4266-4bfa-8c3e-927cc9589550","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:9a99a952-4266-4bfa-8c3e-927cc9589550"},{"_id":46670,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:18.676","end":"2025-11-07T14:28:18.676","id_drupal":"610","country":"arg","theme":"open_government","original_language":"es","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Argentina (2013-2015)","name_en":"First National Open Government Action Plan of Argentina (2013-2015)","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital","responsible_institution/id_institution":"45339","responsible_institution/name_institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Servicios y País Digital"}],"coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","id_coordinator":"45146","name_coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","plan_number":"1","link":"c9b9f44c-515a-4b10-856d-e626537f2fc7","primary_link":"https://www.argentina.gob.ar/sites/default/files/plan_de_accion_de_la_republica_argentina_-_2013-2015.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2013-01-01","validity_applies_until":"yes","effective_until":"2015-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Gobierno Nacional juntamente con actores multisectoriales trabajó en la elaboración de la propuesta del Primer Plan de Acción de Gobierno Abierto de Argentina. Este plan de acción se sustentó en un proceso de consultas presenciales, realizado en forma colaborativa y horizontal en consonancia con los principios de Gobierno Abierto. Es decir, un gobierno que -con base en evidencias de integridad, confiabilidad y credibilidad- se abre a un proceso interactivo con los ciudadanos a través de una relación de doble vía en la que éstos pueden expresar sus opiniones o propuestas sobre políticas o proyectos gubernamentales, co-participar en la producción de bienes o servicios públicos y/o intervenir activamente en el seguimiento, control y evaluación de la gestión estatal.\n\nLa tarea se llevó a cabo en el marco del Grupo de Trabajo de Gobierno Abierto de la Agenda Digital Argentina, participando en él distintos actores  multisectoriales: organismos del Estado, universidades, ONGs y stakeholders involucrados en la temática. Para la formulación del Plan de Acción se habilitó también un foro virtual que ha permitido una participación abierta y federal. Allí se produjeron intercambios de experiencias, trazados de líneas y propuestas de trabajo, con el propósito de que estos fueran recogidos en la producción de acciones y políticas públicas específicas a plasmarse en dicho Plan.","description_en":"The National Government, together with multisectoral actors, worked on the proposal for Argentina’s First Open Government Action Plan. This action plan was based on an in-person consultation process, conducted in a collaborative and horizontal manner, in line with Open Government principles. That is, a government which—on the basis of integrity, reliability, and credibility—opens itself to an interactive process with citizens, through a two-way relationship where they can express opinions or proposals on policies or government projects, co-participate in the delivery of public goods or services, and/or actively engage in the monitoring, oversight, and evaluation of public management.\n\nThe effort was carried out within the framework of the Open Government Working Group of the Argentine Digital Agenda, with the participation of various multisectoral actors: government agencies, universities, NGOs, and stakeholders involved in the issue. A virtual forum was also made available for the development of the Action Plan, enabling open and federal participation. It served as a space for exchanging experiences, outlining approaches, and proposing work plans, with the aim of incorporating them into specific actions and public policies to be included in the Plan.\n\n","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:c7c7a02f-e2c3-4ed7-bea4-5fec3bdec25e","meta/deprecatedID":"uuid:781c9ff5-0f99-4556-9914-e6aae2e6cf48","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"c7c7a02f-e2c3-4ed7-bea4-5fec3bdec25e","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:17","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:c7c7a02f-e2c3-4ed7-bea4-5fec3bdec25e"},{"_id":46671,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2025-11-07T14:28:19.584","end":"2025-11-07T14:28:19.584","id_drupal":"1002","country":"tto","theme":"open_government","original_language":"en","name_es":"Primer Plan de Acción Nacional de Gobierno Abierto de Trinidad y Tabago (2014-2016)","name_en":"First Open Government National Action Plan of Trinidad and Tobago (2014-2016)\n","plan_number":"1","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2014-01-01","validity_applies_until":"yes","effective_until":"2016-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Marco Nacional para el Desarrollo Sostenible 2010 incluyó siete pilares interconectados. En particular, el Pilar 6 (\"Buen gobierno\") se conecta directamente con los principios de Gobierno Abierto, ya que busca promover un sector público que sea más efectivo y abierto a la participación ciudadana. De acuerdo con esto, el gobierno se ha comprometido a mejorar la eficiencia, la productividad y el servicio al cliente dentro de las agencias. Y es en el marco de este compromiso que ha diseñado su primer Plan de Acción. Este Plan de Acción se basa en estos esfuerzos para asegurar que los compromisos incluidos se enmarquen en una perspectiva a largo plazo. En muchos casos, este documento refleja los resultados de los esfuerzos de consulta anteriores y es coherente con las acciones que ya están en desarrollo. Al mismo tiempo, los objetivos incluidos aquí pretenden brindar un impulso adicional para lograr un sector público más transparente, responsable y abierto a la participación en Trinidad y Tobago, para fortalecer su capacidad de cumplir y cumplir las expectativas del público.","description_en":"The National Framework for Sustainable Development 2010 included seven interconnected pillars. In particular, Pillar 6 (“Good Governance”) is directly aligned with the principles of Open Government, as it seeks to promote a more effective public sector that is open to citizen participation. In line with this, the government has committed to improving efficiency, productivity, and customer service within public agencies. It is within the framework of this commitment that the first Action Plan has been designed.\n\nThis Action Plan builds on those efforts to ensure that the included commitments are framed within a long-term perspective. In many cases, this document reflects the results of previous consultation efforts and is consistent with actions already underway. At the same time, the objectives outlined here are intended to provide additional momentum toward achieving a more transparent, accountable, and participatory public sector in Trinidad and Tobago, in order to strengthen its capacity to meet and fulfill public expectations.","linking_sdg_plans":"no","__version__":"aPJUaqc6gbHKCdcXQV3bYh","meta/instanceID":"uuid:dc5b63ba-15d3-4049-9c4d-6e66e2af369c","meta/deprecatedID":"uuid:27714947-d646-4f46-aeca-ad634daa185d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"dc5b63ba-15d3-4049-9c4d-6e66e2af369c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T14:28:18","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"hcastellaro","meta/rootUuid":"uuid:dc5b63ba-15d3-4049-9c4d-6e66e2af369c"},{"_id":46673,"start":"2025-11-07T11:56:24.866-03:00","end":"2026-04-06T13:00:25.661-04:00","id_drupal":"758","country":"slv","theme":"territorial_planning","original_language":"es","name_es":"Plan Nacional de Ordenamiento Territorial de El Salvador","name_en":"National Territorial Planning Plan of El Salvador","responsible_institution":[{"responsible_institution/institution":"Ministerio de Medio Ambiente y Recursos Naturales de El Salvador","responsible_institution/id_institution":"45268","responsible_institution/name_institution":"Ministerio de Medio Ambiente y Recursos Naturales de El Salvador"},{"responsible_institution/institution":"Ministerio de Obras Públicas y de Transporte","responsible_institution/id_institution":"45293","responsible_institution/name_institution":"Ministerio de Obras Públicas y de Transporte"},{"responsible_institution/institution":"Ministerio de Vivienda","responsible_institution/id_institution":"45182","responsible_institution/name_institution":"Ministerio de Vivienda"}],"link":"34f4c0bc-59fa-4f9d-829d-0df59d4bc42f","primary_link":"https://es.slideshare.net/slideshow/plan-nacional-deordenamientoterritorial/22272963","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2004-01-01","validity_applies_until":"yes","effective_until":"2015-01-01","effective_today":"no","temporality":"long_term","description_es":"El Plan Nacional de Ordenamiento y Desarrollo Territorial debe promover una estrategia integral de intervención sobre el territorio nacional orientada a la gestión del territorio y de sus recursos bajo un enfoque de sostenibilidad, para esto propone y desarrolla propuestas y actuaciones en las siguientes materias:\n\n• Usos prioritarios a los que indicativamente deberían destinarse los distintos ámbitos del territorio nacional.\n• Regionalización del territorio nacional a fines de la planificación y gestión territorial.\n• Directrices estratégicas para la creación y desarrollo del sistema de ciudades.\n• Localización de las principales actividades a escala nacional, de tipo industrial, agropecuario, turísticas, etc.\n• Señalamiento y localización de las grandes infraestructuras de apoyo productivo y desarrollo social.\n• Identificación de los espacios con vulnerabilidad o fragilidad especial.\n• Señalamiento de los espacios sujetos a un régimen especial de conservación, protección y mejoramiento del medio ambiente y patrimonio cultural.\n• Estimación de un presupuesto de inversiones a nivel nacional, desagregado por regiones y sectores.","description_en":"The National Land Use and Development Plan should promote an integrated intervention strategy for national territory management and its resources under a sustainability approach. To this end, it proposes and develops actions and policies in the following areas:\n\n• Indicative priority land uses for different areas of the national territory;\n• Territorial regionalization for planning and management purposes;\n• Strategic guidelines for the creation and development of a system of cities;\n• Location of key activities at the national level (industrial, agricultural, tourism, etc.);\n• Designation and location of major infrastructure supporting production and social development;\n• Identification of environmentally or physically vulnerable areas;\n• Designation of areas under special conservation, protection, or cultural and environmental enhancement regimes;\n• Estimation of a national investment budget, broken down by regions and sectors.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:417bc2f4-55d9-4f69-9b52-3aea291e5720","meta/deprecatedID":"uuid:fe144f51-d8e4-4a80-8e56-4d6ee0db8a84","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"417bc2f4-55d9-4f69-9b52-3aea291e5720","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-07T15:00:22","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":null,"meta/rootUuid":"uuid:417bc2f4-55d9-4f69-9b52-3aea291e5720"},{"_id":46711,"start":"2025-11-14T11:01:41.892-03:00","end":"2026-01-14T15:07:01.515-03:00","country":"arg","theme":"public_investment","original_language":"es","name_es":"Plan Nacional de Inversiones Públicas 2026-2028 de Argentina","name_en":"National Public Investment Plan 2026–2028 of Argentina","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Inversión Pública","responsible_institution/id_institution":"45215","responsible_institution/name_institution":"Dirección Nacional de Inversión Pública"}],"link":"f35e95c4-9035-45d7-a4d1-dc5188c70ac4","primary_link":"https://www.argentina.gob.ar/sites/default/files/pnip_2026-2028.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2026-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El PNIP 2026-2028 es un documento formulado por la Dirección Nacional de Inversión Pública (DNIP) de la Administración Nacional, con una proyección plurianual, que sistematiza los programas y proyectos de inversión pública incluidos en el Proyecto de Ley de Presupuesto de 2026. \n\nEl plan articula la inversión pública como un complemento y potenciador de la inversión privada, buscando generar condiciones para el crecimiento económico, mercados más competitivos y dinámicos. \n\nPara el año 2026, se proyecta que la inversión pública nacional alcance el 0,4 % del Producto Bruto Interno (PBI). Los principales sectores de inversión serán: Energía / Combustibles / Minería (≈ 23,1 %), Transporte no vial (≈ 17,4 %), Defensa (≈ 16,3 %), Vialidad (≈ 12,3 %), Agua potable y alcantarillado (≈ 5,8 %) y Ciencia, Tecnología e Innovación (≈ 3,8 %). Respecto de la financiación, el 82 % provendrá de fuentes internas y el 18 % de fuentes externas. \n\nGeográficamente, la inversión se distribuye por regiones —por ejemplo, la región pampeana concentrará cerca del 67,3 % del total para 2026—, pero también hay inversiones de alcance nacional e interprovincial. \n\nEl plan destaca un conjunto de nueve iniciativas de inversión que representan más del 69 % del gasto público de inversión previsto para 2026; entre ellas figuran el Fondo Nacional de la Defensa (FONDEF), obras viales, transferencias para generación nuclear, infraestructura ferroviaria, equipamiento de seguridad, etc. \n\nMetodológicamente, el documento define claramente las categorías de inversión (inversión real directa, transferencias de capital, inversión financiera, aplicaciones financieras vinculadas con proyectos de inversión) y describe el papel del SNIP (Sistema Nacional de Inversiones Públicas) y de la DNIP en el proceso de formulación presupuestaria.","description_en":"The National Public Investment Plan (PNIP) 2026-2028 is a document prepared by the National Directorate of Public Investment (DNIP) of the Argentine National Administration, with a multi-year projection, which systematically organises the set of public investment programmes and projects included in the 2026 Budget Bill.\n\nThe plan frames public investment as a complement and amplifier of private investment, aiming to foster conditions for economic growth and more competitive and dynamic markets.\n\nFor the year 2026, public investment is projected to reach 0.4 % of GDP. The main investment sectors will be: Energy / Fuels / Mining (~23.1 %), Non-road Transport (~17.4 %), Defence (~16.3 %), Road Infrastructure (~12.3 %), Potable Water and Sewerage (~5.8 %) and Science, Technology & Innovation (~3.8 %). With regards to funding, 82 % will come from domestic sources and 18 % from external sources.\n\nGeographically, the investment is distributed across regions—for example, the Pampas region will account for approximately 67.3 % of the total for 2026—but there are also national and inter-provincial investments.\n\nThe plan highlights nine main investment initiatives that represent more than 69 % of the public investment expenditure foreseen for 2026; these include the National Defence Fund (FONDEF), road works, transfers for nuclear generation, railway infrastructure, security equipment, and so on.\n\nFrom a methodological standpoint, the document clearly defines the investment categories (direct real investment, capital transfers, financial investment, financial applications linked to investment projects) and describes the role of the National System of Public Investments (SNIP) and the DNIP in the budget formulation process.","linking_sdg_plans":"no","pip/pip_project_list":"yes","pip/pip_period":"multiannual","pip/pip_project_list_es":"El documento dispone de una cartera completa de proyectos en anexos, con más de mil iniciativas para el trienio, organizados por sector y con detalle del monto estimado de inversión.","pip/pip_project_list_en":"The document provides a comprehensive project portfolio in its annexes, with more than a thousand initiatives for the three-year period, organized by sector and detailing the estimated investment amounts.","pip/pip_costing":"no","pip/pip_budget":"yes","pip/pip_budget_es":"Los proyectos incorporados se vinculan directamente con el Proyecto de Ley de Presupuesto General de la Nación para 2026, y se muestran cifras agregadas de inversión pública proyectada para 2026 como parte de la programación plurianual.","pip/pip_budget_en":"The projects included are directly linked to the Draft Bill of the General State Budget for 2026, and aggregated figures of projected public investment for 2026 are presented as part of the multiannual programming.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"El plan contiene un anexo con la distribución geográfica de los proyectos, permitiendo conocer la localización provincial y regional de las inversiones programadas.","pip/pip_territorialization_en":"The plan includes an annex with the geographic distribution of projects, making it possible to identify the provincial and regional location of the planned investments.","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"Existe una Resolución Conjunta que establece criterios de priorización para la cartera de proyectos (por ejemplo proyectos iniciados, impacto en empleo, generación de divisas, balanza energética, desarrollo tecnológico y existencia de estudios de factibilidad), que se utiliza metodológicamente para ordenar la inclusión de iniciativas en la programación plurianual.","pip/pip_priorization_en":"There is a Joint Resolution that establishes prioritization criteria for the project portfolio (for example, projects already underway, employment impact, foreign exchange generation, energy balance, technological development, and the existence of feasibility studies), which is used methodologically to rank and determine the inclusion of initiatives in the multiannual programming.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley de Inversión Pública (Nro. 24.354) de Argentina","link_block/legal_id":"49748","link_block/legal_name":"Ley de Inversión Pública (Nro. 24.354) de Argentina"},{"link_block/link_type":"external","link_block/external_link_type":"legal","link_block/external_link_text_es":"Resolución Conjunta 18/2025 RESFC-2025-18-APN-SH#MEC","link_block/external_link_text_en":"Joint Resolution 18/2025 RESFC-2025-18-APN-SH#MEC","link_block/external_link_text_url":"https://www.boletinoficial.gob.ar/detalleAviso/primera/324449/20250425"}],"meta/instanceID":"uuid:cfeb2cb5-72b5-4066-a978-feebed69cd0c","meta/deprecatedID":"uuid:70a283c0-cfd4-4ba1-8f97-db62592da421","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"vSXeMtyk63M8JxuiLGRBWU","_version_":"v6WkdkjdFHkpnCedNzifZh","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"cfeb2cb5-72b5-4066-a978-feebed69cd0c","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2025-11-14T14:12:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1767722589,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":null,"meta/rootUuid":"uuid:cfeb2cb5-72b5-4066-a978-feebed69cd0c"},{"_id":50667,"start":"2026-01-07T13:10:10.314-03:00","end":"2026-04-06T12:43:23.331-04:00","country":"mex","theme":"territorial_planning","original_language":"es","name_es":"Programas Estatales de Ordenamiento Territorial y Desarrollo Urbano de México","name_en":"State Programs on Territorial Planning and Urban Development in Mexico","responsible_institution":[{"responsible_institution/institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)","responsible_institution/id_institution":"45027","responsible_institution/name_institution":"Secretaría de Desarrollo Agrario, Territorial y Urbano (SEDATU)"}],"primary_link":"https://www.gob.mx/sedatu/documentos/terminos-de-referencia-para-la-elaboracion-y-o-actualizacion-programas-estatales-de-ordenamiento-territorial-y-desarrollo-urbano-peotdu","instrument_type":"program","instrument_type2":"program","territorial_scale":"subnational","type_territorial_unit_es":"Estados (entidades federativas)","type_territorial_unit_en":"States (federal entities)","validity_applies_from":"no","validity_applies_until":"no","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"Los Programas Estatales de Ordenamiento Territorial y Desarrollo Urbano son los instrumentos propuestos por la Ley General de Asentamientos Humanos, Ordenamiento Territorial y Desarrollo Urbano, en los cuales lasentidades federativas, formulan los lineamientos estatales referentes al ordenamiento territorial y desarrollo urbano teniendo en cuenta lo establecido en el Artículo 29:\n\nI. Los lineamientos generales de articulación y congruencia con la estrategia nacional de ordenamiento territorial;\nII. El análisis y congruencia territorial con el programa nacional de ordenamiento territorial y desarrollo urbano, los programas de ordenamiento ecológico, de prevención de riesgos y de otros programas sectoriales que incidan en su ámbito territorial estatal, y\nIII. El marco general de leyes, reglamentos y normas y los planes territoriales de ámbitos territoriales más amplios o que se inscriben en el plan o programa en formulación.\n\nLos Programas Estatales de Ordenamiento Territorial y Desarrollo Urbano contendrán:\na) El análisis de la situación, las tendencias del territorio, y la enunciación de objetivos y resultados deseados, que deben abordarse simultáneamente; así como la forma en la cual se efectuará el diagnóstico y pronósticos tendenciales y normativos, que resumen la confrontación entre la realidad y lo deseado;\nb) Las estrategias a mediano y largo plazo para su implementación, su evaluación y selección de la más favorable para cerrar las brechas entre la situación, sus tendencias y el escenario deseado;\nc) La definición de las acciones y de los proyectos estratégicos que permitan su implementación;\nd) La determinación de metas y los mecanismos y periodos para la evaluación de resultados;\ne) Los instrumentos para el cumplimiento y ejecución del programa, y\nf) La congruencia con el atlas nacional de riesgos.","description_en":"The State Programs of Territorial Planning and Urban Development are the instruments proposed by the General Law of Human Settlements, Territorial Planning and Urban Development, in which the states formulate the state guidelines regarding territorial planning and urban development, taking into account the provisions of Article 29:\n\nI. The general guidelines for articulation and congruence with the national strategy for territorial planning;\nII. The analysis and territorial congruence with the national program of territorial planning and urban development, the programs of ecological planning, risk prevention and other sectoral programs that affect its state territorial scope, and\nIII. The general framework of laws, regulations and rules and the territorial plans of broader territorial areas or that are part of the plan or programme under formulation.\n\nThe State Programs for Territorial Planning and Urban Development shall contain:\na) The analysis of the situation, the trends of the territory, and the enunciation of objectives and desired results, which must be addressed simultaneously; as well as the way in which the diagnosis and trend and normative forecasts will be made, which summarize the confrontation between reality and what is desired;\nb) The medium and long-term strategies for its implementation, its evaluation and selection of the most favorable one to close the gaps between the situation, its trends and the desired scenario;\nc) The definition of the actions and strategic projects that allow their implementation;\nd) The determination of goals and the mechanisms and periods for the evaluation of results;\ne) The instruments for the fulfillment and execution of the program, and\nf) The congruence with the national atlas of risks.","linking_sdg_plans":"yes","sdg":"sdg_6 sdg_9 sdg_10 sdg_11 sdg_13 sdg_15","local_implementings":[{"local_implementings/local_implementing":"Entidades federativas y municipios de México","local_implementings/id_local_implementing":"44976","local_implementings/name_local_implementing":"Entidades federativas y municipios de México"}],"link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Ley General de Asentamientos Humanos, Ordenamiento Territorial y Desarrollo Urbano en México","link_block/legal_id":"49573","link_block/legal_name":"Ley General de Asentamientos Humanos, Ordenamiento Territorial y Desarrollo Urbano en México"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:bff77577-0916-46f3-9e8c-43554040827a","meta/deprecatedID":"uuid:2bda49d3-61b7-4381-9b59-1dfe435b470a","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bff77577-0916-46f3-9e8c-43554040827a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-01-07T16:29:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1769700988,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:bff77577-0916-46f3-9e8c-43554040827a"},{"_id":50678,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2026-01-14T15:54:28.452-03:00","end":"2026-01-14T16:14:19.891-03:00","country":"ecu","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo 2025-2029. Ecuador no se detiene","name_en":"National Development Plan 2025–2029. Ecuador Does Not Stop","responsible_institution":[{"responsible_institution/institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)","responsible_institution/id_institution":"45088","responsible_institution/name_institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)"}],"link":"de1a1790-d5c7-4b31-8be2-cc217a2a41cc","primary_link":"https://www.planificacion.gob.ec/wp-content/uploads/2025/08/PlanNacionalDeDesarrollo25-29_EcuadorNoSeDetiene.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2029-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo 2025–2029, Ecuador no se detiene constituye el principal instrumento de planificación estratégica del Estado ecuatoriano para el mediano plazo. El plan orienta la acción pública en torno a una visión de desarrollo que busca fortalecer la estabilidad económica, promover el crecimiento productivo, mejorar el bienestar de la población y consolidar la gobernabilidad democrática, en un contexto de desafíos sociales, fiscales y de seguridad.\n\nEl plan articula objetivos, políticas y lineamientos estratégicos que guían la formulación de políticas públicas, programas y proyectos a nivel nacional, sectorial y territorial. Asimismo, establece un marco de coherencia entre la planificación, la gestión pública y el presupuesto, promoviendo una acción estatal más focalizada, eficiente y orientada a resultados, en concordancia con los compromisos internacionales asumidos por el país, incluida la Agenda 2030 para el Desarrollo Sostenible.\n\nEl Plan Nacional de Desarrollo 2025–2029 incorpora además un capítulo específico sobre el Plan Plurianual de Inversiones Públicas, el cual forma parte del sistema de planificación y programación del Estado ecuatoriano y será abordado de manera separada en otra sección.","description_en":"The National Development Plan 2025–2029, Ecuador Does Not Stop is Ecuador’s main medium-term strategic planning instrument. It provides a comprehensive framework to guide public action, with the objective of strengthening economic stability, fostering productive growth, improving social well-being, and reinforcing democratic governance in a context marked by fiscal, social, and security challenges.\n\nThe plan sets out strategic objectives, policies, and guidelines that steer the design and implementation of public policies, programmes, and projects at the national, sectoral, and territorial levels. It also seeks to ensure coherence between planning, public management, and budgeting, promoting a more focused, efficient, and results-oriented approach to public action, in line with Ecuador’s international commitments, including the 2030 Agenda for Sustainable Development.\n\nThe National Development Plan 2025–2029 also includes a specific chapter on the Multi-Year Public Investment Plan, which forms part of the national planning and programming framework and is addressed separately in another section.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_8 sdg_9 sdg_10 sdg_11 sdg_12 sdg_13 sdg_14 sdg_15 sdg_16 sdg_17","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"yes","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Constitución de 2008 de la República de Ecuador","link_block/legal_id":"49388","link_block/legal_name":"Constitución de 2008 de la República de Ecuador"},{"link_block/link_type":"internal","link_block/internal_link_type":"snp","link_block/snp_link":"Sistema Nacional Descentralizado de Planificación Participativa de Ecuador","link_block/snp_id":"37668","link_block/snp_name":"Sistema Nacional Descentralizado de Planificación Participativa de Ecuador"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Planes de Desarrollo y Ordenamiento Territorial (PDOT)","link_block/plan_id":"46350","link_block/plan_name":"Planes de Desarrollo y Ordenamiento Territorial (PDOT)"}],"__version__":"vJxVxMgPzaH5tNTobC6hHi","meta/instanceID":"uuid:73ab44fc-f703-4596-858d-af320e19ca94","meta/deprecatedID":"uuid:7c888b02-abd3-44c4-bae6-b49c2890290c","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"73ab44fc-f703-4596-858d-af320e19ca94","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-01-14T19:48:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1768420154,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:73ab44fc-f703-4596-858d-af320e19ca94"},{"_id":50679,"start":"2026-01-14T16:50:54.338-03:00","end":"2026-01-14T18:05:16.031-03:00","country":"ecu","theme":"public_investment","original_language":"es","name_es":"Plan Plurianual de Inversiones 2025-2029 - Plan Nacional de Desarrollo 2025-2029. Ecuador no se detiene","name_en":"Multi-Year Investment Plan 2025–2029 – National Development Plan 2025–2029. Ecuador Does Not Stop","responsible_institution":[{"responsible_institution/institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)","responsible_institution/id_institution":"45088","responsible_institution/name_institution":"Secretaría Nacional de Planificación de Ecuador, ex Secretaría Nacional de Planificación y Desarrollo de Ecuador (SENPLADES)"}],"link":"de1a1790-d5c7-4b31-8be2-cc217a2a41cc","primary_link":"https://www.planificacion.gob.ec/wp-content/uploads/2025/08/PlanNacionalDeDesarrollo25-29_EcuadorNoSeDetiene.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2029-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Plan Plurianual de Inversiones 2025–2029 es el instrumento que programa y orienta la inversión pública del Estado ecuatoriano en el mediano plazo, estableciendo las prioridades de financiamiento para proyectos y programas de inversión en coherencia con los objetivos estratégicos del desarrollo nacional. Su función principal es traducir las orientaciones del Plan Nacional de Desarrollo en una programación plurianual de recursos, considerando la sostenibilidad fiscal y la capacidad de ejecución del sector público.\n\nEste plan organiza la inversión pública de manera estructurada, definiendo montos indicativos, sectores prioritarios y horizontes temporales, y constituye el marco de referencia para la formulación del Plan Anual de Inversiones y del Presupuesto General del Estado. A través de este enfoque plurianual, el Plan busca otorgar mayor previsibilidad, continuidad y coherencia a la inversión pública, fortaleciendo su contribución al desarrollo económico y social del país.\n\nEl Plan Plurianual de Inversiones 2025–2029 forma parte integrante del Plan Nacional de Desarrollo 2025–2029, Ecuador no se detiene y se articula con el sistema nacional de planificación, presupuesto, seguimiento y evaluación.","description_en":"The Multi-Year Investment Plan 2025–2029 is the instrument that programmes and guides public investment in Ecuador over the medium term, defining funding priorities for public investment programmes and projects in line with national development objectives. Its main purpose is to translate the strategic orientations of the National Development Plan into a multi-year allocation of public investment resources, taking into account fiscal sustainability and implementation capacity.\n\nThe plan structures public investment by setting indicative funding levels, priority sectors, and time horizons, and serves as the reference framework for the formulation of the Annual Investment Plan and the General State Budget. Through its multi-year approach, the plan aims to enhance predictability, continuity, and coherence in public investment, strengthening its contribution to economic and social development.\n\nThe Multi-Year Investment Plan 2025–2029 is an integral component of the National Development Plan 2025–2029, Ecuador Does Not Stop and is articulated with the national planning, budgeting, monitoring, and evaluation system.","linking_sdg_plans":"yes","sdg":"sdg_1 sdg_2 sdg_3 sdg_4 sdg_5 sdg_6 sdg_7 sdg_8 sdg_9 sdg_10 sdg_11 sdg_12 sdg_13 sdg_14 sdg_15 sdg_16 sdg_17","pip/pip_project_list":"no","pip/pip_period":"multiannual","pip/pip_costing":"yes","pip/pip_costing_es":"El Plan Plurianual de Inversiones 2025–2029 presenta el costeo agregado de la inversión pública, expresado en montos indicativos plurianuales asociados a los objetivos y ejes del Plan Nacional de Desarrollo. Este costeo permite dimensionar el esfuerzo fiscal previsto para la inversión pública en el mediano plazo y sirve como referencia para la programación presupuestaria anual.","pip/pip_costing_en":"The Multi-Year Investment Plan 2025–2029 explicitly includes aggregate costing of public investment, expressed through indicative multi-year funding amounts linked to the objectives and pillars of the National Development Plan. This costing framework provides an estimate of the fiscal effort allocated to public investment over the medium term and supports annual budget programming.","pip/pip_budget":"yes","pip/pip_budget_es":"El plan establece una asignación presupuestaria plurianual indicativa para la inversión pública, coherente con el marco fiscal y el Plan Nacional de Desarrollo. Estos montos orientan la formulación del Presupuesto General del Estado y del Plan Anual de Inversiones, sin constituir asignaciones presupuestarias definitivas.","pip/pip_budget_en":"The plan explicitly defines an indicative multi-year budget allocation for public investment, consistent with the fiscal framework and the National Development Plan. These allocations guide the formulation of the General State Budget and the Annual Investment Plan, without constituting binding budget appropriations.","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"yes","pip/pip_priorization_es":"El plan incorpora criterios de priorización de la inversión pública, alineados con los objetivos estratégicos del desarrollo nacional. Estos criterios orientan la asignación de recursos hacia sectores, políticas y áreas consideradas prioritarias, estableciendo un orden lógico para la programación de la inversión pública en el período 2025–2029.","pip/pip_priorization_en":"The plan explicitly includes public investment prioritisation criteria, aligned with national development objectives. These criteria guide the allocation of resources towards priority sectors and policies, establishing a structured framework for investment programming over the 2025–2029 period.","meta/instanceID":"uuid:6ed0b310-537d-4c19-86bc-c7d735f96cc5","meta/deprecatedID":"uuid:ef173c97-0eab-4d1e-ab7f-0341105e4ad4","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"vJxVxMgPzaH5tNTobC6hHi","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6ed0b310-537d-4c19-86bc-c7d735f96cc5","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-01-14T20:00:57","_tags":[],"_notes":[],"_validation_status":{"timestamp":1768424916,"uid":"validation_status_approved","by_whom":"hcastellaro","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:6ed0b310-537d-4c19-86bc-c7d735f96cc5"},{"_id":50989,"start":"2026-03-11T15:20:22.367-03:00","end":"2026-07-22T16:26:20.864-04:00","country":"pry","theme":"development_planning","original_language":"es","name_es":"Plan Nacional de Desarrollo Paraguay 2050","name_en":"National Development Plan Paraguay 2050","responsible_institution":[{"responsible_institution/institution":"Ministerio de Economía y Finanzas del Paraguay","responsible_institution/id_institution":"45228","responsible_institution/name_institution":"Ministerio de Economía y Finanzas del Paraguay"}],"link":"eaf687ac-7033-46ec-9f89-15f161166492","primary_link":"https://www.paraguay2050.gov.py/processes/pnd2050","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan Nacional de Desarrollo (PND) Paraguay 2050 es la hoja de ruta estratégica que guiará al país hacia un modelo de desarrollo inclusivo, sostenible y equitativo durante las próximas décadas.\n\nEl Plan se encuentra respaldado por la Constitución Nacional y su cumplimiento es obligatorio para el sector público, mientras que para el sector privado cumple una función orientadora.\n\nComo instrumento rector del Sistema Nacional de Planificación (SISPLAN), el PND Paraguay 2050 orienta la asignación de los recursos del Estado, asegura la coherencia entre los distintos planes y establece mecanismos de monitoreo para verificar su cumplimiento. Representa, además, un compromiso institucional dirigido a consolidar la planificación como eje del desarrollo nacional.\n\nEl PND Paraguay 2050 fue construido mediante un amplio proceso participativo, con la intervención activa de la ciudadanía, los organismos del Estado, la sociedad civil, el sector privado y otros actores. Su elaboración se basó en un enfoque de cocreación que buscó garantizar la inclusión, la transparencia y la pluralidad de voces, procurando que el Plan reflejara las prioridades y aspiraciones del Paraguay.\n\nEl documento se estructura en cuatro pilares:\n\n1. Personas y sociedad.\n2. Infraestructura, innovación y competitividad.\n3. Ambiente y energía.\n4. Instituciones, seguridad y proyección internacional.","description_en":"The Paraguay 2050 National Development Plan (NDP) is the strategic roadmap that will guide the country toward an inclusive, sustainable, and equitable development model over the coming decades.\n\nThe Plan is supported by the National Constitution. Its implementation is mandatory for the public sector, while it serves as a guiding framework for the private sector.\n\nAs the main instrument of the National Planning System (SISPLAN), the Paraguay 2050 NDP guides the allocation of State resources, ensures coherence among different plans, and establishes monitoring mechanisms to assess its implementation. It also represents an institutional commitment to consolidating planning as a central pillar of national development.\n\nThe Paraguay 2050 NDP was developed through a broad participatory process involving citizens, government institutions, civil society, the private sector, and other stakeholders. Its preparation was based on a co-creation approach aimed at ensuring inclusion, transparency, and a plurality of perspectives, so that the Plan would reflect Paraguay’s priorities and aspirations.\n\nThe document is structured around four pillars:\n\n1. People and society.\n2. Infrastructure, innovation, and competitiveness.\n3. Environment and energy.\n4. Institutions, security, and international projection.","linking_sdg_plans":"yes","ipd/ipd_vision_es":"En Paraguay, el desarrollo sostenible garantiza el bienestar de las personas y sus comunidades. Es un país donde todas las personas, sin distinción, acceden a oportunidades a lo largo de sus vidas, y viven en una sociedad que disfruta de condiciones óptimas de salud integral, educación de calidad, trabajo digno y seguridad. \n\nUna fuerza laboral calificada, respaldada por infraestructura moderna, tecnología de vanguardia, conectividad eficiente y un entorno propicio para el emprendimiento, la inversión y el crecimiento, impulsa una economía inclusiva, innovadora y competitiva, que genera de forma sostenida mayor valor agregado en bienes y servicios. \n\nEn su territorio, los recursos naturales son protegidos, valorados y gestionados de manera responsable,promoviendo la resiliencia climática y asegurando la sostenibilidad de un modelo energético diversificado.\n\nEl Estado social de derecho se consolida como pilar de la democracia, la equidad y el bienestar colectivo. Está presente en todo el país, rinde cuentas, se mantiene libre de corrupción y garantiza una gestión eficiente. \n\nProtege la integridad y los derechos de las personas, asegura una justicia competente, imparcial, oportuna e independiente, y promueve la participación activa de la ciudadanía en la construcción del bien común. A nivel internacional, Paraguay es protagonista en el contexto regional y se inserta estratégicamente en el escenario global, siendo reconocido por su riqueza natural y cultural, así como por promover una visión de apertura, cooperación y diálogo.","ipd/ipd_vision_en":"In Paraguay, sustainable development ensures the well-being of people and their communities. It is a country where everyone, without distinction, has access to opportunities throughout their lives and lives in a society that enjoys optimal conditions of comprehensive health, quality education, decent work, and security.\n\nA skilled workforce, supported by modern infrastructure, cutting-edge technology, efficient connectivity, and an enabling environment for entrepreneurship, investment, and growth, drives an inclusive, innovative, and competitive economy that sustainably generates greater added value in goods and services.\n\nThroughout its territory, natural resources are protected, valued, and managed responsibly, promoting climate resilience and ensuring the sustainability of a diversified energy model.\n\nThe social rule-of-law State is consolidated as a pillar of democracy, equity, and collective well-being. It is present throughout the country, remains accountable and free from corruption, and guarantees efficient public management.\n\nIt protects people’s integrity and rights, ensures a competent, impartial, timely, and independent justice system, and promotes the active participation of citizens in building the common good. At the international level, Paraguay plays a leading role in the regional context and positions itself strategically on the global stage, where it is recognized for its natural and cultural wealth, as well as for promoting openness, cooperation, and dialogue.","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"no","ipd/ipd_tracking":"yes","ipd/ipd_investment":"no","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Nacional de Desarrollo Paraguay 2030: Avances y actualización 2021","link_block/plan_id":"46604","link_block/plan_name":"Plan Nacional de Desarrollo Paraguay 2030: Avances y actualización 2021"},{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Nacional de Desarrollo Paraguay 2030","link_block/plan_id":"46603","link_block/plan_name":"Plan Nacional de Desarrollo Paraguay 2030"},{"link_block/link_type":"internal","link_block/internal_link_type":"legal","link_block/legal_link":"Constitución de 1992 de la República del Paraguay","link_block/legal_id":"49470","link_block/legal_name":"Constitución de 1992 de la República del Paraguay"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","_version__004":"vzVDKzD8ZctygZt9wp4LJD","meta/instanceID":"uuid:da055bb0-c042-496c-b41a-9ae505be4cc7","meta/deprecatedID":"uuid:b5df2a19-60cb-4d7b-bd66-a371b721bfa6","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"da055bb0-c042-496c-b41a-9ae505be4cc7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-03-11T18:44:52","_tags":[],"_notes":[],"_validation_status":{"timestamp":1773254758,"uid":"validation_status_approved","by_whom":"bsilva","color":"#00ff00","label":"Approved"},"_submitted_by":"bsilva","meta/rootUuid":"uuid:da055bb0-c042-496c-b41a-9ae505be4cc7"},{"_id":51001,"start":"2026-03-11T15:38:57.670-03:00","end":"2026-03-30T16:41:24.496-03:00","country":"bra","theme":"public_investment","original_language":"pt","name_es":"Plan Plurianual 2024-2027","name_en":"2024–2027 Multi-Year Plan","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación y Presupuesto","responsible_institution/id_institution":"45446","responsible_institution/name_institution":"Ministerio de Planificación y Presupuesto"}],"link":"1bb9d888-a947-426d-81a9-e8fd74d79962","primary_link":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/planoplurianual","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","description_es":"El Proyecto de Ley del Plano Plurianual (PPA) 2024-2027, se constituye como el principal instrumento de planificación de medio plazo del gobierno federal, orientado por una visión de futuro para 2027 que aspira a un país democrático, justo y ambientalmente sostenible. Es un instrumento que busca centrar las políticas públicas en la obtención de resultados y en la integración del planeamiento con el presupuesto. Introduce por primera vez los Indicadores-Clave Nacionales bajo un sistema de bandas, permitiendo medir el progreso socioeconómico y ambiental de manera flexible y realista.\nEl plan se organiza en tres ejes estratégicos y define seis prioridades de gobierno, tales como el combate al hambre, la educación básica y el Nuevo PAC, las cuales contarán con un monitoreo intensivo. Una característica fundamental es la implementación de agendas transversales para abordar problemas complejos, como los derechos de las mujeres, los pueblos indígenas y la igualdad racial, mediante un enfoque multidimensional. Asimismo, el proceso de elaboración destaca por un amplio diálogo social, recolectando millones de contribuciones ciudadanas a través de plataformas digitales y plenarias presenciales en todos los estados.\nLa regionalización de las metas es un pilar central del plan, buscando reducir las desigualdades territoriales mediante la coordinación con planes de desarrollo para la Amazonía, el Nordeste y el Centro-Oeste. En términos financieros, el PPA moviliza recursos por un total de R$ 13,3 billones, integrando tanto gastos directos como subsidios.","description_en":"The Draft Law of the Pluriannual Plan (PPA) 2024–2027 constitutes the principal medium-term planning instrument of the federal government, guided by a forward-looking vision for 2027 that aspires to a democratic, just, and environmentally sustainable country. It is designed to focus public policies on the achievement of results and to strengthen the integration between planning and budgeting. For the first time, it introduces National Key Indicators under a band-based system, enabling the flexible and realistic measurement of socioeconomic and environmental progress.\n\nThe Plan is structured around three strategic pillars and defines six government priorities—such as the fight against hunger, basic education, and the New PAC—which will be subject to intensive monitoring. A fundamental feature is the implementation of cross-cutting agendas to address complex issues, including women’s rights, Indigenous peoples, and racial equality, through a multidimensional approach. Furthermore, the formulation process stands out for its broad social dialogue, incorporating millions of citizen contributions gathered through digital platforms and in-person plenary sessions across all states.\n\nThe regionalization of targets constitutes a central pillar of the Plan, aiming to reduce territorial inequalities through coordination with development plans for the Amazon, the Northeast, and the Center-West regions. In financial terms, the PPA mobilizes resources totaling R$ 13.3 trillion, encompassing both direct expenditures and subsidies.","linking_sdg_plans":"no","pip/pip_project_list":"yes","pip/pip_period":"multiannual","pip/pip_project_list_es":"El plan incluye un listado detallado de Inversiones Plurianuales y de inversiones de empresas estatales no dependientes. Estos proyectos se definen como acciones presupuestarias que tienen fecha de inicio y término, impactando el programa en más de un ejercicio financiero.","pip/pip_project_list_en":"The plan includes a detailed list of multi-year investments and investments by non-affiliated state-owned enterprises. These projects are defined as budgetary initiatives with start and end dates that affect the program over more than one fiscal year.","pip/pip_costing":"yes","pip/pip_costing_es":"Los proyectos cuentan con un costo total estimado y una previsión de ejecución dentro del periodo del PPA. En las fichas individuales de los proyectos se detalla el \"Costo Total\" de la obra o adquisición, permitiendo conocer la magnitud financiera completa de la inversión.","pip/pip_costing_en":"The projects have an estimated total cost and are expected to be completed within the PPA period. The individual project fact sheets detail the “Total Cost” of the construction or acquisition, providing a clear picture of the full financial scope of the investment.","pip/pip_budget":"yes","pip/pip_budget_es":"El PPA estima recursos totales por R$ 13,3 billones para el periodo 2024-2027. Este monto se desglosa en recursos presupuestarios y recursos no presupuestarios (subsidios y créditos de instituciones financieras públicas). Para cada programa y proyecto, se presenta un \"Valor Anual Previsto\" que detalla la asignación para cada año del cuatrienio.","pip/pip_budget_en":"The PPA estimates total funding of R$ 13.3 trillion for the 2024–2027 period. This amount is broken down into budgetary and non-budgetary funds (grants and loans from public financial institutions). For each program and project, an “Estimated Annual Amount” is provided, detailing the allocation for each year of the four-year period.","pip/pip_territorialization":"yes","pip/pip_territorialization_es":"Las fichas de los programas incluyen secciones de \"Regionalización de la Meta\" donde se detallan los valores u objetivos para estados o regiones específicas, buscando estrechar la relación federativa. Existen mecanismos para distribuir las metas de los programas en el territorio y alinearlas con planes regionales de desarrollo, como los de la Amazonía (PRDA), el Nordeste (PRDNE) y el Centro-Oeste (PRDCO).","pip/pip_territorialization_en":"The program documents include sections titled “Regionalization of the Goal,” which detail the targets or objectives for specific states or regions, with the aim of strengthening federal ties. Mechanisms exist to distribute program goals across the country and align them with regional development plans, such as those for the Amazon (PRDA), the Northeast (PRDNE), and the Midwest (PRDCO).","pip/pip_indicators":"yes","pip/pip_indicators_es":"El PPA está orientado a resultados utilizando Indicadores-Clave Nacionales, que miden el progreso socioeconómico y ambiental del país. Además, cada programa de inversiones posee indicadores específicos y metas asociadas para medir objetivamente el alcance de los objetivos específicos y las \"entregas\" (productos o servicios).","pip/pip_indicators_en":"The PPA is results-oriented and uses National Key Indicators to measure the country’s socioeconomic and environmental progress. In addition, each investment program has specific indicators and associated targets to objectively measure the achievement of specific objectives and “deliverables” (products or services).","pip/pip_priorization":"yes","pip/pip_priorization_es":"No existe priorización de proyectos con metodología multicriterio, pero el plan define seis prioridades de gobierno que serán objeto de monitoreo: 1) Combate al Hambre y Reducción de Desigualdades, 2) Educación Básica, 3) Salud, 4) Programa de Aceleración del Crecimiento. 5) Neoindustrialización, Trabajo, Empleo y Renta, y 6) Combate a la Deforestación y Enfrentamiento de la Emergencia Climática.","pip/pip_priorization_en":"There is no prioritization of projects using a multi-criteria methodology, but the plan identifies six government priorities that will be monitored: 1) Combating Hunger and Reducing Inequality, 2) Basic Education, 3) Health, 4) Growth Acceleration Program. 5) Reindustrialization, Labor, Employment, and Income, and 6) Combating Deforestation and Addressing the Climate Emergency.","link_block":[{"link_block/link_type":"external","link_block/external_link_type":"platform","link_block/external_link_text_es":"PPA 2024-2027 (español)","link_block/external_link_text_en":"PPA 2024-2027 (español)","link_block/external_link_text_url":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/plano-plurianual/paginas/paginas-ppa-2024-2027/ppa-2024-2027-versao-espanhol"},{"link_block/link_type":"external","link_block/external_link_type":"platform","link_block/external_link_text_es":"PPA 2024-2027 (English)","link_block/external_link_text_en":"PPA 2024-2027 (English)","link_block/external_link_text_url":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/plano-plurianual/paginas/paginas-ppa-2024-2027"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","meta/instanceID":"uuid:0f944e8e-0cd6-4d8a-afa4-d52a895c5201","meta/deprecatedID":"uuid:6b47a511-4b8f-4999-a1ff-e285752295c3","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0f944e8e-0cd6-4d8a-afa4-d52a895c5201","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-03-18T20:04:09","_tags":[],"_notes":[],"_validation_status":{"timestamp":1774378845,"uid":"validation_status_approved","by_whom":"bsilva","color":"#00ff00","label":"Approved"},"_submitted_by":"bsilva","meta/rootUuid":"uuid:0f944e8e-0cd6-4d8a-afa4-d52a895c5201"},{"_id":51006,"start":"2026-03-18T17:03:58.990-03:00","end":"2026-03-24T16:40:59.672-03:00","country":"bra","theme":"public_investment","original_language":"es","name_es":"Anexos PPA 2024-2027. Proyecto de ley del Plan Plurianual (PPA). Volumen I","name_en":"Appendices to the 2024–2027 Multi-Year Plan (PPA). Draft Law on the Multi-Year Plan (PPA). Vo","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación y Presupuesto","responsible_institution/id_institution":"45446","responsible_institution/name_institution":"Ministerio de Planificación y Presupuesto"}],"link":"fad7b81f-5474-4676-9e01-99dbb198e68a","primary_link":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/plano-plurianual/paginas/paginas-ppa-2024-2027/ppa-2024-2027-versao-espanhol","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","description_es":"Este documento contempla los anexos del Proyecto de Ley del Plano Plurianual (PPA) 2024-2027, el cual constituye la herramienta matriz para la planificación gubernamental de mediano plazo en Brasil. Bajo la dirección del Ministerio de Planificación y Presupuesto, el texto contiene:\n\n• Dimensión estratégica, con visión de futuro, valores, directrices, ejes, objetivos estratégicos, indicadores clave nacionales y metas.\n• Resumen ejecutivo e información macroeconómica y fiscal.\n• Programas finales con valor y alcance global, objetivo,\npúblico destinatario, organismo responsable, objetivos\nespecíficos, indicadores y metas.","description_en":"This document includes the annexes to the Draft Law on the Multi-Year Plan (PPA) 2024–2027, which serves as the primary framework for medium-term government planning in Brazil. Under the direction of the Ministry of Planning and Budget, the text contains:\n\n• Strategic dimension, including a vision for the future, values, guidelines, pillars, strategic objectives, key national indicators, and targets.\n• Executive summary and macroeconomic and fiscal information.\n• Final programs with overall scope and value, objectives,\ntarget audience, responsible agency, specific objectives,\nindicators, and targets.","linking_sdg_plans":"no","pip/pip_project_list":"no","pip/pip_period":"multiannual","pip/pip_costing":"no","pip/pip_budget":"no","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"no","link_block":[{"link_block/link_type":"external"}],"meta/instanceID":"uuid:335fb464-2f49-43f8-a0cc-8a6c997f59b1","meta/deprecatedID":"uuid:b27db330-9cb8-487b-b06a-aab026d01652","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","__version__":"v7Skya3m8VENzbnTdYScGH","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"335fb464-2f49-43f8-a0cc-8a6c997f59b1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-03-24T19:27:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1774382000,"uid":"validation_status_on_hold","by_whom":"bsilva","color":"#0000ff","label":"On Hold"},"_submitted_by":"bsilva","meta/rootUuid":"uuid:335fb464-2f49-43f8-a0cc-8a6c997f59b1"},{"_id":51007,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2026-03-24T16:26:50.511-03:00","end":"2026-03-24T16:46:21.214-03:00","country":"bra","theme":"public_investment","original_language":"es","name_es":"Anexos PPA 2024-2027. Proyecto de ley del Plan Plurianual (PPA). Volumen II","name_en":"Appendices to the Multi-Year Plan (PPA) 2024–2027. Draft Multi-Year Plan (PPA) Bill. Volume II","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación y Presupuesto","responsible_institution/id_institution":"45446","responsible_institution/name_institution":"Ministerio de Planificación y Presupuesto"}],"link":"5d39850a-7fcf-41cd-b1ee-e7921a914035","primary_link":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/plano-plurianual/paginas/paginas-ppa-2024-2027/ppa-2024-2027-versao-espanhol","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"Anexo del PPA 2024-2027 que contiene:\n• Programas de Gestión \n• Agendas Transversales \n• Prioridades y Metas \n• Inversiones Plurianuales \n• Inversiones plurianuales de empresas estatales no dependientes","description_en":"Appendix to the 2024–2027 PPA, containing:\n• Management Programs \n• Cross-cutting Agendas \n• Priorities and Goals \n• Multi-year Investments \n• Multi-year investments by non-dependent state-owned enterprises","linking_sdg_plans":"no","pip/pip_project_list":"no","pip/pip_period":"multiannual","pip/pip_costing":"no","pip/pip_budget":"no","pip/pip_territorialization":"no","pip/pip_indicators":"no","pip/pip_priorization":"no","__version__":"v7Skya3m8VENzbnTdYScGH","meta/instanceID":"uuid:5000f486-4aa4-4880-b167-b0e39fac3287","meta/deprecatedID":"uuid:7c2600a6-d457-4573-a6fe-80a9fa594f69","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5000f486-4aa4-4880-b167-b0e39fac3287","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-03-24T19:46:31","_tags":[],"_notes":[],"_validation_status":{"timestamp":1774382002,"uid":"validation_status_on_hold","by_whom":"bsilva","color":"#0000ff","label":"On Hold"},"_submitted_by":"bsilva","meta/rootUuid":"uuid:5000f486-4aa4-4880-b167-b0e39fac3287"},{"_id":51036,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2026-04-05T18:10:44.251-04:00","end":"2026-04-05T18:14:04.698-04:00","country":"gtm","theme":"territorial_planning","original_language":"es","name_es":"Planes de Desarrollo Municipal y Ordenamiento Territorial (PDM-OT)","name_en":"Municipal Development and Land Use Planning Plans (PDM-OT)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Agricultura, Ganadería y Alimentación de Guatemala","responsible_institution/id_institution":"45330","responsible_institution/name_institution":"Ministerio de Agricultura, Ganadería y Alimentación de Guatemala"},{"responsible_institution/institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala","responsible_institution/id_institution":"45131","responsible_institution/name_institution":"Consejo Nacional de Desarrollo Urbano y Rural (CONADUR) de Guatemala"}],"link":"c7684853-d98e-4fe8-805d-f0c69247a3b1","primary_link":"https://portal.segeplan.gob.gt/segeplan/wp-content/uploads/2023/04/Politica-de-Vivienda-y-Asentamientos-Humanos.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"Los Planes de Desarrollo Municipal y Ordenamiento Territorial (PDM-OT) son instrumentos de planificación elaborados a nivel municipal en Guatemala que integran el desarrollo económico, social y ambiental con la organización del territorio. Estos planes establecen una visión de desarrollo del municipio, incluyen un diagnóstico territorial, definen lineamientos para el uso del suelo y priorizan proyectos estratégicos para orientar la inversión pública y el desarrollo local. Los PDM-OT buscan articular la planificación municipal con las políticas nacionales de desarrollo y ordenamiento territorial, promoviendo una gestión territorial más equilibrada y sostenible.","description_en":"Municipal Development and Land Use Planning Plans (PDM-OT) are planning instruments prepared at the municipal level in Guatemala that integrate economic, social, and environmental development with territorial organization. These plans establish a development vision for the municipality, include a territorial diagnosis, define guidelines for land use, and prioritize strategic projects to guide public investment and local development. The PDM-OT seek to align municipal planning with national development and land use planning policies, promoting more balanced and sustainable territorial management.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Política Nacional de Vivienda y Asentamientos Humanos 2020-2032 de Guatemala","link_block/plan_id":"46459","link_block/plan_name":"Política Nacional de Vivienda y Asentamientos Humanos 2020-2032 de Guatemala"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vxrtsoWXSMEMuTjhbWhxds","meta/instanceID":"uuid:6a8ceef2-32c1-46bf-a880-7b811f71abea","meta/deprecatedID":"uuid:e5cf07f3-2f21-495c-9339-f10bda3a6a8a","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6a8ceef2-32c1-46bf-a880-7b811f71abea","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-05T22:15:19","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775427353,"uid":"validation_status_approved","by_whom":"adiazmedel","color":"#00ff00","label":"Approved"},"_submitted_by":"adiazmedel","meta/rootUuid":"uuid:6a8ceef2-32c1-46bf-a880-7b811f71abea"},{"_id":51039,"start":"2026-04-05T21:23:02.246-04:00","end":"2026-04-05T21:29:31.116-04:00","country":"chl","theme":"urban_development","original_language":"es","name_es":"Propuesta de Actualización de la Política Nacional de Desarrollo Urbano","name_en":"Proposal for the Update of the National Urban Development Policy","responsible_institution":[{"responsible_institution/institution":"Consejo Nacional de Desarrollo Territorial","responsible_institution/id_institution":"45370","responsible_institution/name_institution":"Consejo Nacional de Desarrollo Territorial"}],"link":"85a462cd-df43-4062-b870-b96fdfc1c992","primary_link":"https://cndt.cl/wp-content/uploads/2026/03/Documento-Propuesta-CNDT-Actualizacion-PNDU-compressed.pdf","instrument_type":"policy","instrument_type2":"policy","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","effective_today":"no","temporality":"long_term","visible_description":"yes","description_es":"La Propuesta de Actualización de la Política Nacional de Desarrollo Urbano es un instrumento estratégico elaborado por el Consejo Nacional de Desarrollo Territorial (CNDT) para actualizar la PNDU vigente de 2014 frente a las transformaciones demográficas, sociales, ambientales, económicas y territoriales de la última década. La propuesta busca orientar el desarrollo urbano del país con foco en la equidad territorial, promoviendo ciudades y asentamientos urbanos más justos, resilientes, sustentables y habitables. Incorpora un enfoque territorial, principios transversales y ocho ámbitos temáticos (vivienda y hábitat residencial, espacio público, movilidad, identidades, sustentabilidad, desarrollo económico, planificación integrada y gestión de suelo, e institucionalidad y participación), y plantea la futura elaboración de un plan de acción para su implementación.","description_en":"The Proposal for the Update of the National Urban Development Policy is a strategic instrument prepared by the National Council for Territorial Development (CNDT) to update the current National Urban Development Policy (PNDU) adopted in 2014, in light of the demographic, social, environmental, economic, and territorial transformations of the last decade. The proposal seeks to guide the country’s urban development with a focus on territorial equity, promoting fairer, more resilient, sustainable, and livable cities and urban settlements. It incorporates a territorial approach, cross-cutting principles, and eight thematic areas (housing and residential habitat, public space, mobility, identities, sustainability, economic development, integrated planning and land management, and institutional framework and participation), and proposes the future preparation of an action plan for its implementation.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:9e8a5553-b87b-40a5-acd6-183abb18c814","meta/deprecatedID":"uuid:c14246d5-2e3a-410d-8b86-f36eeeea7715","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__001":"vxrtsoWXSMEMuTjhbWhxds","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9e8a5553-b87b-40a5-acd6-183abb18c814","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-06T01:27:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775438885,"uid":"validation_status_approved","by_whom":"adiazmedel","color":"#00ff00","label":"Approved"},"_submitted_by":"adiazmedel","meta/rootUuid":"uuid:9e8a5553-b87b-40a5-acd6-183abb18c814"},{"_id":51040,"formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2026-04-05T22:07:24.136-04:00","end":"2026-04-05T22:09:40.835-04:00","country":"kna","theme":"urban_development","original_language":"en","name_es":"Plan de Resiliencia Urbana para Greater Basseterre (2022-2037)","name_en":"Urban Resilience Plan for Greater Basseterre (2022-2037)","responsible_institution":[{"responsible_institution/institution":"Ministerio de Desarrollo Sostenible, Medio Ambiente, Acción Climática y Empoderamiento de Circunscripciones de Saint Kitts y Nevis","responsible_institution/id_institution":"44932","responsible_institution/name_institution":"Ministerio de Desarrollo Sostenible, Medio Ambiente, Acción Climática y Empoderamiento de Circunscripciones de Saint Kitts y Nevis"}],"link":"f1f2658e-7c53-4a9d-aed0-a436410a6141","primary_link":"https://www.gov.kn/wp-content/uploads/2024/06/Urban-Resilience-Plan-for-Greater-Basseterre-and-Playbook-FINAL-13Oct2022.pdf","instrument_type":"plan","instrument_type2":"plan","territorial_scale":"subnational","validity_applies_from":"yes","effective_since":"2022-01-01","validity_applies_until":"yes","effective_until":"2037-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"El Plan de Resiliencia Urbana para Greater Basseterre (Urban Resilience Plan for Greater Basseterre) es un plan integral de 15 años orientado a fortalecer la resiliencia urbana del área de Greater Basseterre frente a shocks y tensiones como inundaciones, huracanes, erosión costera, escasez de agua, pobreza, inseguridad y deterioro urbano. El plan organiza sus acciones en cinco áreas temáticas (Protect, Revitalize, Access, Shift y Engage) y tres prioridades transversales (Leadership, Capacity y Finance), con objetivos, proyectos y resultados orientados a proteger la infraestructura y el ambiente, mejorar las condiciones de vivienda, revitalizar el centro urbano, ampliar el acceso a espacios públicos y movilidad, y promover una gestión urbana más sostenible y resiliente.","description_en":"The Urban Resilience Plan for Greater Basseterre is a 15-year integrated plan aimed at strengthening the urban resilience of the Greater Basseterre area to shocks and stresses such as flooding, hurricanes, coastal erosion, water scarcity, poverty, insecurity, and urban deterioration. The plan structures its actions around five thematic areas (Protect, Revitalize, Access, Shift, and Engage) and three cross-cutting priorities (Leadership, Capacity, and Finance), with objectives, projects, and expected outcomes focused on protecting infrastructure and the environment, improving housing conditions, revitalizing the urban core, expanding access to public spaces and mobility, and promoting more sustainable and resilient urban management.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vxrtsoWXSMEMuTjhbWhxds","meta/instanceID":"uuid:e2c343ec-7094-4026-af9a-e2d9961b185a","meta/deprecatedID":"uuid:90f4d3e8-1aad-41f8-a729-41eb59dbd5df","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e2c343ec-7094-4026-af9a-e2d9961b185a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-06T02:09:46","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775441401,"uid":"validation_status_approved","by_whom":"adiazmedel","color":"#00ff00","label":"Approved"},"_submitted_by":"adiazmedel","meta/rootUuid":"uuid:e2c343ec-7094-4026-af9a-e2d9961b185a"},{"_id":51044,"start":"2026-03-13T11:16:47.224-03:00","end":"2026-04-08T12:43:25.727-04:00","country":"bra","theme":"development_planning","original_language":"pt","name_es":"Estrategia Brasil 2050.","name_en":"Brazil 2050 Strategy","responsible_institution":[{"responsible_institution/institution":"Ministerio de Planificación y Presupuesto","responsible_institution/id_institution":"45446","responsible_institution/name_institution":"Ministerio de Planificación y Presupuesto"}],"primary_link":"https://www.gov.br/planejamento/pt-br/assuntos/planejamento/Brasil2050","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2050-01-01","effective_today":"yes","temporality":"long_term","visible_description":"yes","description_es":"La Secretaría Nacional de Planificación lideró la elaboración participativa de una Estrategia Nacional a Largo Plazo, denominada Estrategia Brasil 2050. Esta estrategia busca garantizar una mayor previsibilidad en la acción gubernamental, mejorar el entorno empresarial e incrementar la transparencia. \nLa Estrategia se estructura con una Visión de futuro al 2050 y tres ejes con objetivos de largo plazo y orientaciones estratégicas. \n\n• Eje 1: Desarrollo social y garantía de derechos.\n• Eje 2: Desarrollo económico y sostenibilidad socioambiental y climática.\n• Eje 3: Fortalecimiento de las instituciones democráticas, las capacidades estatales y la soberanía nacional. \n\nLos objetivos y ejes nacionales son transversales y complementarios entre sí.\n\nContempla indicadores y metas a nivel nacional y de objetivos de largo plazo. \n\nConsidera perspectivas regionales con desglose de los indicadores clave en objetivos regionales y priorización de las orientaciones estratégicas por región.\n\nMás de 5.000 personas fueron consultadas en la elaboración del primer plan participativo a largo plazo de la historia en Brasil.","description_en":"The National Planning Secretariat led the participatory development of a Long-Term National Strategy, known as the Brazil 2050 Strategy. This strategy aims to ensure greater predictability in government action, improve the business environment, and increase transparency. \nThe Strategy is structured around a Vision for 2050 and three pillars with long-term objectives and strategic guidelines. \n\n• Pillar 1: Social development and the guarantee of rights.\n• Pillar 2: Economic development and socio-environmental and climate sustainability.\n• Pillar 3: Strengthening democratic institutions, state capacities, and national sovereignty. \n\nThe national objectives and priorities are cross-cutting and complementary to one another.\n\nIt includes indicators and targets at the national level and long-term objectives. \n\nIt takes regional perspectives into account, breaking down key indicators into regional objectives and prioritizing strategic guidelines by region.\n\nMore than 5,000 people were consulted in the development of the first long-term participatory plan in Brazil’s history.","linking_sdg_plans":"yes","ipd/ipd_type":"development","ipd/ipd_legal_framework":"yes","ipd/ipd_action_plan":"yes","ipd/ipd_participation":"yes","ipd/ipd_budget":"yes","ipd/ipd_tracking":"yes","ipd/ipd_investment":"no","ipd/ipd_indicators":"yes","ipd/ipd_other_instrument":"yes","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"Plan Plurianual de Brasil (2024-2027)","link_block/plan_id":"46546","link_block/plan_name":"Plan Plurianual de Brasil (2024-2027)"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","meta/instanceID":"uuid:0c26547f-e213-4686-8574-248f0faf4d34","meta/deprecatedID":"uuid:6430d40e-3321-4276-9044-d75c548e43ea","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"0c26547f-e213-4686-8574-248f0faf4d34","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-06T20:37:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775507872,"uid":"validation_status_approved","by_whom":"bsilva","color":"#00ff00","label":"Approved"},"_submitted_by":"bsilva","meta/rootUuid":"uuid:0c26547f-e213-4686-8574-248f0faf4d34"},{"_id":51046,"start":"2026-04-08T12:53:53.745-04:00","end":"2026-04-24T12:25:18.603-04:00","country":"arg","theme":"open_government","original_language":"es","name_es":"Sexto Plan de Acción Nacional de Gobierno Abierto de Argentina (2025-2027)","name_en":"Sixth National Open Government Action Plan of Argentina (2025-2027)","responsible_institution":[{"responsible_institution/institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Tecnologías de la Información y las Comunicaciones","responsible_institution/id_institution":"51112","responsible_institution/name_institution":"Dirección Nacional de Gobierno Abierto de Argentina - Subsecretaría de Tecnologías de la Información y las Comunicaciones"}],"coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","id_coordinator":"45146","name_coordinator":"Mesa Nacional de Gobierno Abierto de Argentina","plan_number":"6","link":"d8ccb5fa-bd0d-45cd-8128-ecccb89e70c1","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2026/01/Argentina_Action-Plan_2025-2027_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"no","description_es":"El Sexto Plan de Acción Nacional de Gobierno Abierto de Argentina (2025–2027) representa la continuidad del compromiso del país con la Alianza para el Gobierno Abierto, consolidando un enfoque de “Estado abierto” basado en la transparencia, la participación ciudadana, la rendición de cuentas y la innovación pública. El plan incluye 10 compromisos cocreados entre organismos del sector público, organizaciones de la sociedad civil y ciudadanía, en un proceso participativo que involucró a más de 150 actores y fue coordinado por la Mesa Nacional de Gobierno Abierto.\n\nEl plan se orienta a fortalecer la apertura y calidad de los datos públicos, así como a promover el uso de herramientas tecnológicas para mejorar la eficiencia del Estado y facilitar el acceso a la información. Asimismo, incorpora compromisos en áreas emergentes y estratégicas como la transparencia en estadísticas criminales, datos energéticos y mineros, política exterior, gobernanza de datos y fortalecimiento de capacidades institucionales. Este enfoque refleja una ampliación temática y una mayor articulación entre distintos poderes del Estado y niveles de gobierno.\n\nEn conjunto, el plan busca profundizar la institucionalización del gobierno abierto en Argentina mediante un modelo colaborativo y basado en evidencia. Sus objetivos principales son consolidar prácticas más transparentes e inclusivas, impulsar la innovación en la gestión pública y fortalecer la confianza ciudadana, avanzando hacia un Estado más abierto, eficiente y cercano a la ciudadanía.","description_en":"Argentina’s Sixth National Open Government Action Plan (2025–2027) continues the country’s commitment to the Open Government Partnership, reinforcing an “open state” approach grounded in transparency, citizen participation, accountability, and public innovation. The plan includes 10 co-created commitments developed through a participatory process involving public institutions, civil society organizations, and citizens, coordinated by the National Open Government Roundtable.\n\nThe plan focuses on strengthening the openness and quality of public data, while promoting the use of digital tools to enhance government efficiency and improve access to information. It also incorporates commitments in emerging and strategic areas such as criminal statistics transparency, energy and mining data, foreign policy transparency, data governance, and institutional capacity building. This reflects both thematic expansion and stronger coordination across branches and levels of government.\n\nOverall, the plan aims to deepen the institutionalization of open government in Argentina through a collaborative and evidence-based approach. Its main goals are to advance more transparent and inclusive practices, foster innovation in public management, and strengthen public trust, contributing to a more open, efficient, and citizen-centered state.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:72e5e030-e4f4-4c80-b93d-f59cc18cf666","meta/deprecatedID":"uuid:afa83f52-09ae-4563-a3c0-1ae0da939a69","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"72e5e030-e4f4-4c80-b93d-f59cc18cf666","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-08T17:01:30","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775667854,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:72e5e030-e4f4-4c80-b93d-f59cc18cf666"},{"_id":51048,"start":"2026-04-08T14:01:45.095-04:00","end":"2026-04-08T16:12:18.648-04:00","country":"ecu","theme":"open_government","original_language":"es","name_es":"Tercer Plan de Acción de Gobierno Abierto Ecuador (2025-2027)","name_en":"Third National Open Government Action Plan of Ecuador (2025-2027)","responsible_institution":[{"responsible_institution/institution":"Dirección de Gobierno Abierto","responsible_institution/id_institution":"45534","responsible_institution/name_institution":"Dirección de Gobierno Abierto"}],"coordinator":"Grupo Núcleo de Ecuador","id_coordinator":"45005","name_coordinator":"Grupo Núcleo de Ecuador","plan_number":"3","link":"da251c3e-b91d-4a05-897a-67b4a8b4eec2","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2026/01/Ecuador_Action-Plan_2025-2027_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","description_es":"El tercer Plan de Acción de Gobierno Abierto de Ecuador (2025–2027) constituye una hoja de ruta estratégica cocreada entre el gobierno, la sociedad civil, la academia y otros actores, orientada a fortalecer el modelo de “Estado abierto” en el país. Este plan recoge propuestas ciudadanas transformadas en compromisos concretos que buscan resolver problemas públicos mediante mayor transparencia, participación ciudadana, rendición de cuentas e innovación pública. En total, el plan incluye 12 compromisos organizados en varias áreas de política, reflejando la continuidad del proceso iniciado tras la adhesión de Ecuador a la Alianza para el Gobierno Abierto.\n\nEl plan se caracteriza por un enfoque multisectorial y colaborativo, en el que un grupo multiactor coordina tanto la cocreación como la implementación y el monitoreo de los compromisos. Entre sus principales orientaciones se encuentran el fortalecimiento del acceso a la información pública, el uso de tecnologías digitales para mejorar la apertura gubernamental, la promoción de la integridad y la lucha contra la corrupción, así como la ampliación de espacios de participación ciudadana inclusiva. En este sentido, el plan busca consolidar un modelo de gobernanza más transparente, participativo y responsivo, alineado con los principios internacionales de gobierno abierto.","description_en":"Ecuador’s third Open Government Action Plan (2025–2027) serves as a strategic roadmap co-created by government institutions, civil society, academia, and other stakeholders to strengthen the country’s “open state” model. The plan translates citizen proposals into concrete commitments aimed at addressing public challenges through enhanced transparency, citizen participation, accountability, and public innovation. It includes 12 commitments across several policy areas, continuing Ecuador’s trajectory within the Open Government Partnership.\n\nThe plan adopts a collaborative, multi-stakeholder approach, where a dedicated group oversees co-creation, implementation, and monitoring. Its core priorities include improving access to public information, leveraging digital technologies to advance openness, promoting integrity and anti-corruption measures, and expanding inclusive participation mechanisms. Overall, the plan seeks to consolidate a more transparent, participatory, and responsive governance model, aligned with international open government principles.","linking_sdg_plans":"yes","sdg":"sdg_17","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","meta/instanceID":"uuid:8572d7ca-f5fe-49b6-bff8-be37a0b1b2fb","meta/deprecatedID":"uuid:e86c0654-6f6d-4325-9aff-abaeb5d4b21b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"8572d7ca-f5fe-49b6-bff8-be37a0b1b2fb","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-08T18:07:10","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775671997,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:8572d7ca-f5fe-49b6-bff8-be37a0b1b2fb"},{"_id":51049,"start":"2026-04-08T14:08:17.523-04:00","end":"2026-04-08T15:45:38.195-04:00","country":"per","theme":"open_government","original_language":"es","name_es":"VI Plan de Acción de Estado Abierto de Perú (2026 - 2027)","name_en":"VI Open State Action Plan of Peru (2026–2027)","responsible_institution":[{"responsible_institution/institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública","responsible_institution/id_institution":"45341","responsible_institution/name_institution":"Subsecretaría de Administración Pública - Secretaría de Gestión Pública"}],"coordinator":"Foro Multiactor de Gobierno Abierto de Perú","id_coordinator":"45348","name_coordinator":"Foro Multiactor de Gobierno Abierto de Perú","plan_number":"6","link":"fd3a0dd9-cbf2-452e-8465-69fafa37b87c","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2026/01/Peru_Action-Plan_2025-2027_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2026-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El sexto Plan de Acción de Estado Abierto de Perú (2025–2027) representa una nueva etapa en la consolidación del enfoque de “Estado abierto”, ampliando la articulación entre los distintos poderes del Estado y actores no gubernamentales. Este plan, aprobado a fines de 2025, incluye 11 compromisos organizados en varias áreas de política pública, y continúa la trayectoria del país dentro de la Alianza para el Gobierno Abierto, fortaleciendo la institucionalización de sus principios en la gestión pública.\n\nEl plan se distingue por su énfasis en la participación ciudadana y el trabajo del Foro Multiactor, que coordina la cocreación, implementación y seguimiento de los compromisos. Entre sus prioridades se encuentran el fortalecimiento de la transparencia, la mejora del acceso a la información pública, la promoción de la integridad y la lucha contra la corrupción, así como la incorporación de enfoques de innovación y gobierno digital. En conjunto, busca avanzar hacia un Estado más abierto, inclusivo y confiable, situando a la ciudadanía en el centro de la gestión pública y alineándose con estándares internacionales de gobierno abierto.","description_en":"Peru’s sixth Open State Action Plan (2025–2027) marks a new phase in consolidating the “open state” approach, strengthening coordination across branches of government and with non-governmental stakeholders. Approved in late 2025, the plan includes 11 commitments across multiple policy areas, continuing Peru’s trajectory within the Open Government Partnership and reinforcing the institutionalization of open government principles in public administration.\n\nThe plan is characterized by its strong emphasis on citizen participation and the role of the Multi-Stakeholder Forum, which oversees co-creation, implementation, and monitoring. Its main priorities include enhancing transparency, improving access to public information, promoting integrity and anti-corruption measures, and leveraging innovation and digital government tools. Overall, it aims to build a more open, inclusive, and trustworthy state, placing citizens at the center of public governance and aligning with international open government standards.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","meta/instanceID":"uuid:ec05fa7b-9f2b-4670-b2d1-2ccc7bb52208","meta/deprecatedID":"uuid:5cbaf9d6-0736-4d59-9e42-ef70caf49e97","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"ec05fa7b-9f2b-4670-b2d1-2ccc7bb52208","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-08T18:13:03","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775672001,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:ec05fa7b-9f2b-4670-b2d1-2ccc7bb52208"},{"_id":51050,"start":"2026-04-08T14:13:55.376-04:00","end":"2026-04-08T15:06:40.019-04:00","country":"ury","theme":"open_government","original_language":"es","name_es":"Sexto Plan de Acción Nacional de Gobierno Abierto de Uruguay (2025-2029)","name_en":"Sixth National Open Government Action Plan of Uruguay (2025–2029)","responsible_institution":[{"responsible_institution/institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay","responsible_institution/id_institution":"45242","responsible_institution/name_institution":"Agencia de Gobierno Electrónico y Sociedad de la Información y del Conocimiento (AGESIC) de Uruguay"}],"coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","id_coordinator":"45001","name_coordinator":"Grupo de Trabajo de Gobierno Abierto de Uruguay","plan_number":"6","link":"149c8026-8454-4c96-953a-286b7452a4ef","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2025/09/Uruguay_Action-Plan-2025-2029_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2029-01-01","effective_today":"yes","temporality":"medium_term","visible_description":"yes","description_es":"El Sexto Plan de Acción Nacional de Gobierno Abierto de Uruguay (2025–2029) consolida la trayectoria del país como referente en la implementación del enfoque de “Estado abierto”, reafirmando su compromiso con la transparencia, la participación ciudadana y la rendición de cuentas. Por primera vez, el plan tiene una duración de cuatro años e incluye 41 compromisos impulsados por 24 instituciones públicas, cocreados con la participación de la sociedad civil, la academia y el sector privado.\n\nEl plan presenta un enfoque transversal que incorpora áreas clave de política pública como infancia y adolescencia, discapacidad, seguridad pública y financiamiento de los partidos políticos, ampliando el alcance tradicional del gobierno abierto. Asimismo, fortalece la integridad pública, la prevención de la corrupción y los mecanismos de rendición de cuentas, al tiempo que promueve el uso de datos, tecnologías digitales y nuevas formas de participación ciudadana.\n\nEn conjunto, este plan profundiza la institucionalización del gobierno abierto en Uruguay mediante procesos de cocreación más maduros y una articulación multisectorial más robusta. Su objetivo es consolidar un Estado más transparente, inclusivo y eficiente, alineado con estándares internacionales y orientado a generar valor público y confianza ciudadana.","description_en":"Uruguay’s Sixth National Open Government Action Plan (2025–2029) consolidates the country’s trajectory as a regional leader in advancing the “open state” approach, reaffirming its commitment to transparency, citizen participation, and accountability. For the first time, the plan spans four years and includes 41 commitments led by 24 public institutions, co-created with civil society, academia, and the private sector.\n\nThe plan adopts a cross-cutting approach that incorporates key public policy areas such as children and youth, disability, public security, and political party financing, thereby expanding the traditional scope of open government. It also strengthens public integrity, anti-corruption efforts, and accountability mechanisms, while promoting the use of data, digital technologies, and innovative participation tools.\n\nOverall, the plan deepens the institutionalization of open government in Uruguay through more mature co-creation processes and stronger multi-stakeholder coordination. It aims to build a more transparent, inclusive, and efficient state, aligned with international standards and focused on generating public value and trust.","linking_sdg_plans":"yes","sdg":"sdg_17","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","meta/instanceID":"uuid:7ec08f81-7b8d-4c38-b616-00ab03898ed2","meta/deprecatedID":"uuid:1efff3b6-5c84-409b-b448-6c9734c5d8c8","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__002":"vUYxaHyyVJjFUHybpDLhk6","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"7ec08f81-7b8d-4c38-b616-00ab03898ed2","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-08T18:18:27","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775672320,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:7ec08f81-7b8d-4c38-b616-00ab03898ed2"},{"_id":51089,"start":"2026-04-10T09:26:37.344-04:00","end":"2026-04-23T14:52:08.200-04:00","country":"arg","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Córdoba (ciudad) (2025-2027)","name_en":"2nd Open Government Action Plan of Córdoba (city) (2025–2027)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Planificación, Modernización y Relaciones Internacionales","responsible_institution/id_institution":"45115","responsible_institution/name_institution":"Secretaría de Planificación, Modernización y Relaciones Internacionales"}],"coordinator":"Foro Multiactor de Córdoba","id_coordinator":"45055","name_coordinator":"Foro Multiactor de Córdoba","plan_number":"2","link":"06580c32-236a-4c68-aefc-dd9ede9061cc","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/gravity_forms/24-6fb2e5a17f4b4b4e72048871008bb9f3/2026/02/Plan-de-Gobierno-Abierto-Cordoba-2026-2027.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Córdoba","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción de Gobierno Abierto de la Municipalidad de Córdoba 2025-2027 se desarrolló mediante un proceso de cocreación que siguió los estándares de la Alianza para el Gobierno Abierto (OGP), integrando a universidades, organizaciones civiles y diversas áreas municipales a través de cinco encuentros tanto presenciales como virtuales. Durante este ciclo, se emplearon metodologías participativas y herramientas digitales para facilitar el diálogo y la deliberación, permitiendo que la pluralidad de voces construyera consensos legítimos y definiera una hoja de ruta común basada en las necesidades reales de los sectores locales.\n\nEste plan se estructura formalmente en 2 compromisos estratégicos orientados a profundizar la apertura gubernamental y el empoderamiento ciudadano","description_en":"The 2025-2027 Open Government Action Plan of the Municipality of Córdoba was created through a co-creation process aligned with OGP standards, involving universities, civil society organizations, and various municipal departments over five hybrid sessions. This collaborative cycle utilized participatory methodologies and digital tools to facilitate dialogue and consensus-building, ensuring that the resulting roadmap was anchored in the diverse perspectives and actual needs of the city's different sectors.\n\nThe plan is formally composed of 2 strategic commitments designed to transform public management through transparency and accountability","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:1615818f-aa33-4b19-9a53-aa9dc41e5f54","meta/deprecatedID":"uuid:a7f1b9fb-ea4e-4736-80c4-948d1847a025","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1615818f-aa33-4b19-9a53-aa9dc41e5f54","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-10T13:35:43","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775828478,"uid":"validation_status_approved","by_whom":"paulinestockins","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:1615818f-aa33-4b19-9a53-aa9dc41e5f54"},{"_id":51098,"start":"2026-04-10T13:57:14.524-04:00","end":"2026-04-13T13:41:48.651-04:00","country":"cri","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Curridabat (2025-2028)","name_en":"2nd Open Government Action Plan of Curridabat (2025–2028)","responsible_institution":[{"responsible_institution/institution":"Municipalidad de Curridabat","responsible_institution/id_institution":"45462","responsible_institution/name_institution":"Municipalidad de Curridabat"}],"plan_number":"2","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-curridabat-costa-rica-2025-2028/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Cantón de Curridabat","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Segundo Plan de Acción de Gobierno Abierto de Curridabat (2025–2028) busca consolidar una gestión municipal más transparente, participativa y colaborativa, promoviendo el acceso a datos abiertos, la participación ciudadana y la innovación en los servicios públicos. El plan incluye 4 compromisos, centrados en la apertura de datos, el fortalecimiento de la participación (incluido el presupuesto participativo), la creación de una plataforma de servicios distritales y el desarrollo del proyecto de movilidad “Conexión Curridabat”.\n\nSu diseño se basó en un proceso de co-creación multiactor, que incluyó al gobierno local, sociedad civil y sector privado, mediante reuniones presenciales, presentaciones públicas y canales digitales. En total, se realizaron 10 reuniones abiertas y participaron diversos actores institucionales y sociales, con el objetivo de construir compromisos de manera colaborativa y fortalecer la transparencia y la rendición de cuentas.","description_en":"The Second Open Government Action Plan of Curridabat (2025–2028) aims to strengthen a more transparent, participatory, and collaborative municipal governance model, promoting open data, citizen participation, and innovation in public service delivery. The plan includes 4 commitments, focused on open data, strengthening participation (including participatory budgeting), developing a district service platform, and advancing the “Conexión Curridabat” mobility project.\n\nIts design followed a multi-stakeholder co-creation process, involving local government, civil society, and the private sector through in-person meetings, public presentations, and digital channels. A total of 10 public meetings were held, engaging diverse stakeholders to collaboratively define commitments and enhance transparency and accountability.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:1da46517-63fa-4ac7-923d-deef4c9d5b9f","meta/deprecatedID":"uuid:17fb7766-8514-4e45-a043-ec09c575c8e2","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__003":"vcKhXenSgJ29WWJq5RyHAt","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"1da46517-63fa-4ac7-923d-deef4c9d5b9f","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-10T18:00:58","_tags":[],"_notes":[],"_validation_status":{"timestamp":1775844967,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"ilpes_anonimo","meta/rootUuid":"uuid:1da46517-63fa-4ac7-923d-deef4c9d5b9f"},{"_id":51113,"start":"2026-04-13T11:59:22.105-04:00","end":"2026-04-13T14:55:50.266-04:00","country":"arg","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de la Provincia de Córdoba (2024-2027)","name_en":"2nd Open Government Action Plan of the Province of Córdoba (2024–2027)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Fortalecimiento Institucional","responsible_institution/id_institution":"45130","responsible_institution/name_institution":"Secretaría de Fortalecimiento Institucional"}],"coordinator":"Foro Multiactor de Córdoba","id_coordinator":"45055","name_coordinator":"Foro Multiactor de Córdoba","plan_number":"2","link":"fe73d0a9-3aea-4007-ac6f-fc7110652213","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-cordoba-province-argentina-2024-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Provincia de Córdoba","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Segundo Plan de Acción de Gobierno Abierto de la Provincia de Córdoba (2024–2027) es el instrumento estratégico mediante el cual el gobierno provincial consolida y profundiza su política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan da continuidad al primer plan (2021–2023) y busca institucionalizar prácticas de transparencia, participación ciudadana, rendición de cuentas e innovación pública en la gestión provincial y en los gobiernos locales.\n\nEl plan fue elaborado a través de un proceso de cocreación que involucró a organismos públicos, organizaciones de la sociedad civil, universidades y ciudadanía, mediante mesas de trabajo, instancias participativas y mecanismos de validación pública. Este enfoque colaborativo constituye un eje central tanto en el diseño como en la implementación y monitoreo del plan.\n\nEntre sus principales objetivos se encuentran: consolidar la apertura de datos como política de Estado, fortalecer la transparencia activa, promover la participación ciudadana y fomentar la gobernanza colaborativa entre distintos niveles de gobierno. Asimismo, el plan pone énfasis en la territorialización del gobierno abierto, apoyando a municipios y comunas mediante redes, programas de capacitación y asistencia técnica para la adopción de estos principios.\n\nEl plan incluye compromisos concretos vinculados al acceso a la información, los datos abiertos y la modernización de instrumentos como el Portal de Gestión Abierta. Además, promueve cambios culturales dentro de la administración pública para integrar el enfoque de gobierno abierto de manera transversal. Su implementación está prevista para el período 2024–2027 y contempla mecanismos de monitoreo independientes con participación académica.\n\nEn conjunto, este plan busca fortalecer la confianza ciudadana, mejorar la calidad de las políticas públicas y consolidar un modelo de gobernanza más inclusivo, transparente y colaborativo en la provincia.","description_en":"The Second Open Government Action Plan of the Province of Córdoba (2024–2027) is the strategic instrument through which the provincial government consolidates and advances its open government agenda within the framework of the Open Government Partnership (OGP) at the local level. Building on the first action plan (2021–2023), it aims to institutionalize practices of transparency, citizen participation, accountability, and public sector innovation across the provincial administration and local governments.\n\nThe plan was developed through a co-creation process involving public institutions, civil society organizations, academia, and citizens, using participatory mechanisms such as working groups, consultations, and validation processes. This collaborative approach is a core feature of both the design and implementation of the plan.\n\nIts main objectives include consolidating open data as a state policy, strengthening proactive transparency, promoting citizen participation, and fostering collaborative governance across different levels of government. The plan also emphasizes the territorialization of open government, supporting municipalities and local communities through training programs, networks, and technical assistance.\n\nThe plan includes specific commitments related to access to information, open data, and the modernization of tools such as the Open Management Portal. It also promotes cultural change within public administration to mainstream open government principles. Its implementation period runs from 2024 to 2027 and includes independent monitoring mechanisms involving academic institutions.\n\nOverall, the plan seeks to strengthen public trust, improve policy effectiveness, and consolidate a more inclusive, transparent, and collaborative governance model in the province.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:6c839362-41f1-4e44-a748-ff8225a29f4d","meta/deprecatedID":"uuid:5687750b-7a8d-4e30-a792-5be3ca446c9f","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__003":"vcKhXenSgJ29WWJq5RyHAt","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6c839362-41f1-4e44-a748-ff8225a29f4d","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T16:05:33","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104676,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:6c839362-41f1-4e44-a748-ff8225a29f4d"},{"_id":51114,"start":"2026-04-13T12:06:27.187-04:00","end":"2026-05-07T15:21:07.620-04:00","country":"arg","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Mendoza (2024–2027)","name_en":"2nd Open Government Action Plan of Mendoza (2024–2027)","responsible_institution":[{"responsible_institution/institution":"Dirección de Transformación Digital, Gobierno Abierto y Smart Cities","responsible_institution/id_institution":"51091","responsible_institution/name_institution":"Dirección de Transformación Digital, Gobierno Abierto y Smart Cities"}],"coordinator":"Foro Multisectorial de Mendoza","id_coordinator":"51165","name_coordinator":"Foro Multisectorial de Mendoza","plan_number":"2","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-mendoza-argentina-2026-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Mendoza","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Segundo Plan de Acción de Gobierno Abierto de Mendoza (2024–2027) es el instrumento estratégico mediante el cual la Ciudad de Mendoza consolida y profundiza su política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan da continuidad al proceso iniciado con el plan anterior (2021–2023) y busca integrar de manera transversal los principios de transparencia, participación ciudadana, rendición de cuentas y colaboración en la gestión pública.\n\nEl plan se basa en una visión de largo plazo orientada a fortalecer una cultura organizacional abierta, promoviendo el uso estratégico de datos, la toma de decisiones basada en evidencia y la innovación pública. En este contexto, el gobierno abierto es concebido como un pilar clave para mejorar la calidad de las políticas públicas, aumentar la eficiencia administrativa y fortalecer la confianza ciudadana en las instituciones.\n\nSu elaboración se llevó a cabo mediante un proceso de cocreación que involucró a actores gubernamentales, organizaciones de la sociedad civil, academia y otros actores del ecosistema local. Este enfoque participativo se refleja también en la implementación del plan, que contempla espacios de colaboración continua, mecanismos de monitoreo conjunto y la inclusión de grupos diversos en el diseño y seguimiento de los compromisos.\n\nEl plan incluye compromisos orientados, entre otros aspectos, a fortalecer la gobernanza de datos, mejorar el acceso a la información pública, ampliar los canales de participación ciudadana y abordar desafíos emergentes como el cambio climático y la innovación en la gestión pública.\n\nEn conjunto, el Segundo Plan de Acción busca consolidar un modelo de gobernanza más transparente, inclusivo e innovador, alineado con estándares internacionales y orientado a mejorar la calidad de vida de la ciudadanía.","description_en":"The Second Open Government Action Plan of Mendoza (2024–2027) is the strategic instrument through which the City of Mendoza consolidates and advances its open government agenda within the framework of the Open Government Partnership (OGP) at the local level. Building on the previous action plan (2021–2023), it aims to mainstream the principles of transparency, citizen participation, accountability, and collaboration across public administration.\n\nThe plan is grounded in a long-term vision focused on strengthening an open organizational culture, promoting the strategic use of data, evidence-based decision-making, and public sector innovation. In this context, open government is conceived as a key pillar for improving the quality of public policies, enhancing administrative efficiency, and strengthening public trust in institutions.\n\nIt was developed through a co-creation process involving government institutions, civil society organizations, academia, and other local stakeholders. This participatory approach is also reflected in the implementation phase, which includes ongoing collaboration spaces, joint monitoring mechanisms, and the inclusion of diverse groups in the design and follow-up of commitments.\n\nThe plan includes commitments aimed at strengthening data governance, improving access to public information, expanding citizen participation channels, and addressing emerging challenges such as climate change and innovation in public management.\n\nOverall, the Second Action Plan seeks to consolidate a more transparent, inclusive, and innovative governance model, aligned with international standards and focused on improving citizens’ quality of life.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:6fd5bb27-717b-41c6-b52c-8600583e2864","meta/deprecatedID":"uuid:ecd3a2dd-77d3-4df0-8db9-d30656e68f30","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"6fd5bb27-717b-41c6-b52c-8600583e2864","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T16:15:24","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104685,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:6fd5bb27-717b-41c6-b52c-8600583e2864"},{"_id":51115,"start":"2026-04-13T12:15:11.332-04:00","end":"2026-04-13T14:28:06.461-04:00","country":"arg","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Rosario (2025-2027)","name_en":"2nd Open Government Action Plan of Rosario (2025–2027)","responsible_institution":[{"responsible_institution/institution":"Secretaría de Cercanía y Gestión Ciudadana","responsible_institution/id_institution":"51092","responsible_institution/name_institution":"Secretaría de Cercanía y Gestión Ciudadana"}],"coordinator":"Mesa de Diálogo de Gobierno Abierto de Rosario","id_coordinator":"45114","name_coordinator":"Mesa de Diálogo de Gobierno Abierto de Rosario","plan_number":"2","link":"f6defa5d-e531-42f6-9143-20eb6b3a12a0","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-rosario-argentina-2025-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Rosario","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El 2do Plan de Acción de Gobierno Abierto de Rosario (2025–2027) es el instrumento estratégico mediante el cual el municipio consolida y profundiza su política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan da continuidad al proceso iniciado con el primer plan (2021–2023), incorporando aprendizajes y resultados previos para fortalecer un modelo de gobernanza más transparente, participativo e inclusivo.\n\nEl plan surge como una respuesta directa a las lecciones aprendidas del ciclo anterior, destacando la necesidad de fortalecer el rol de las organizaciones de la sociedad civil (OSC) como actores clave en el diseño, implementación y monitoreo de las políticas públicas. En este sentido, el plan coloca a la sociedad civil en el centro de su estrategia, promoviendo la cocreación como principio fundamental del gobierno abierto y reconociendo que una participación activa e informada es esencial para una democracia más legítima y efectiva.\n\nSu elaboración se llevó a cabo mediante un proceso de cocreación que involucró a distintas áreas del gobierno municipal —incluyendo la Secretaría de Cercanía y Gestión Ciudadana, la Secretaría de Salud Pública y la Jefatura de Gabinete— junto con organizaciones sociales, academia y ciudadanía. Este enfoque participativo se refleja también en su implementación, que contempla espacios de diálogo estructurados, mecanismos de evaluación participativa y el fortalecimiento de redes de actores locales.\n\nEntre sus principales objetivos se encuentran el fortalecimiento de las herramientas digitales de participación, la ampliación de canales de involucramiento ciudadano, la promoción de prácticas colaborativas —incluyendo en sectores como la salud— y el desarrollo de mecanismos de evaluación conjunta de políticas públicas. Asimismo, el plan busca consolidar una cultura de gobierno abierto mediante estrategias de comunicación accesibles y el uso de lenguaje claro.\n\nEn conjunto, el Segundo Plan de Acción de Rosario busca consolidar un ecosistema democrático más transparente, inclusivo y eficiente, en el que el gobierno y la ciudadanía colaboren activamente para diseñar respuestas públicas más legítimas, efectivas y sostenibles.","description_en":"The Second Open Government Action Plan of Rosario (2025–2027) is the strategic instrument through which the municipality consolidates and advances its open government agenda within the framework of the Open Government Partnership (OGP) at the local level. Building on the first action plan (2021–2023), it incorporates lessons learned and previous results to strengthen a more transparent, participatory, and inclusive governance model.\n\nThe plan emerges as a direct response to the lessons learned from the previous cycle, particularly highlighting the need to strengthen the role of civil society organizations (CSOs) as key actors in the design, implementation, and monitoring of public policies. In this regard, the plan places civil society at the center of its strategy, promoting co-creation as a fundamental principle of open government and recognizing that active and informed participation is essential for a more legitimate and effective democracy.\n\nIt was developed through a co-creation process involving various municipal departments —including the Secretariat of Citizen Engagement and Management, the Secretariat of Public Health, and the Municipal Chief of Staff— along with civil society organizations, academia, and citizens. This participatory approach is also reflected in the implementation phase, which includes structured dialogue spaces, participatory evaluation mechanisms, and the strengthening of local stakeholder networks.\n\nIts main objectives include strengthening digital participation tools, expanding channels for citizen engagement, promoting collaborative practices —including in sectors such as health— and developing mechanisms for joint policy evaluation. The plan also seeks to consolidate an open government culture through accessible communication strategies and the use of clear language.\n\nOverall, the Second Action Plan of Rosario aims to build a more transparent, inclusive, and efficient democratic ecosystem, where government and citizens actively collaborate to design more legitimate, effective, and sustainable public responses.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:61c39c1f-8c92-4082-82a2-50219485d266","meta/deprecatedID":"uuid:ae54d70c-8aee-4181-b0ee-16f80b1390a7","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__003":"vcKhXenSgJ29WWJq5RyHAt","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"61c39c1f-8c92-4082-82a2-50219485d266","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T16:21:29","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104802,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:61c39c1f-8c92-4082-82a2-50219485d266"},{"_id":51116,"start":"2026-04-13T12:22:32.653-04:00","end":"2026-04-13T15:01:40.514-04:00","country":"bol","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de La Paz (2025-2026)","name_en":"1st Open Government Action Plan of La Paz (2025–2026)","responsible_institution":[{"responsible_institution/institution":"Secretaría Ejecutiva Municipal","responsible_institution/id_institution":"51093","responsible_institution/name_institution":"Secretaría Ejecutiva Municipal"}],"plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-la-paz-bolivia-2025-2026/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de la Paz","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El 1er Plan de Acción de Gobierno Abierto de La Paz (2025–2026) es el instrumento estratégico mediante el cual el Gobierno Autónomo Municipal de La Paz inicia la implementación de una política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan marca un hito institucional al establecer por primera vez una agenda estructurada orientada a promover la transparencia, la participación ciudadana, la rendición de cuentas y la innovación en la gestión pública municipal.\n\nEl plan se concibe como un punto de partida para la consolidación de un modelo de gobernanza más abierto e inclusivo, alineado con estándares internacionales y adaptado al contexto local. En este sentido, busca fortalecer las capacidades institucionales del municipio para implementar prácticas de apertura, mejorar la relación entre el gobierno y la ciudadanía, y fomentar una cultura de colaboración en la toma de decisiones públicas.\n\nSu elaboración se llevó a cabo mediante un proceso de cocreación que involucró a distintas áreas del gobierno municipal, organizaciones de la sociedad civil, academia y ciudadanía. A través de mesas de trabajo, consultas públicas y espacios participativos, se definieron compromisos orientados a responder a prioridades locales y a fortalecer la legitimidad de las políticas públicas. Este enfoque participativo también se proyecta en la fase de implementación, que contempla mecanismos de seguimiento conjunto y evaluación participativa.\n\nEntre sus principales líneas de acción se encuentran el fortalecimiento de la transparencia y el acceso a la información pública, la promoción de la participación ciudadana mediante herramientas digitales y presenciales, y el impulso de iniciativas de innovación pública. Asimismo, el plan busca sentar las bases para la institucionalización del gobierno abierto en el municipio, asegurando su sostenibilidad en el tiempo.\n\nEn conjunto, el Primer Plan de Acción de La Paz representa un paso fundamental hacia la construcción de un gobierno más transparente, participativo e innovador, orientado a mejorar la calidad de vida de la ciudadanía y fortalecer la confianza en las instituciones públicas.","description_en":"The First Open Government Action Plan of La Paz (2025–2026) is the strategic instrument through which the Autonomous Municipal Government of La Paz initiates the implementation of an open government policy within the framework of the Open Government Partnership (OGP) at the local level. This plan represents an important institutional milestone, as it establishes for the first time a structured agenda aimed at promoting transparency, citizen participation, accountability, and innovation in municipal public management.\n\nThe plan is conceived as a starting point for consolidating a more open and inclusive governance model, aligned with international standards and adapted to the local context. In this regard, it seeks to strengthen the municipality’s institutional capacities to implement open government practices, improve the relationship between government and citizens, and foster a culture of collaboration in public decision-making.\n\nIt was developed through a co-creation process involving different municipal departments, civil society organizations, academia, and citizens. Through working groups, public consultations, and participatory spaces, commitments were defined to address local priorities and enhance the legitimacy of public policies. This participatory approach is also reflected in the implementation phase, which includes joint monitoring mechanisms and participatory evaluation processes.\n\nIts main lines of action include strengthening transparency and access to public information, promoting citizen participation through both digital and in-person tools, and advancing public innovation initiatives. The plan also aims to lay the foundations for the institutionalization of open government within the municipality, ensuring its sustainability over time.\n\nOverall, the First Action Plan of La Paz represents a key step toward building a more transparent, participatory, and innovative government, focused on improving citizens’ quality of life and strengthening trust in public institutions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:e365de97-504d-4a8f-a4ce-3cb9a215edc7","meta/deprecatedID":"uuid:052b85d7-e0cd-424c-a98d-f56159e1b08b","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__003":"vcKhXenSgJ29WWJq5RyHAt","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e365de97-504d-4a8f-a4ce-3cb9a215edc7","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T16:32:23","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104695,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:e365de97-504d-4a8f-a4ce-3cb9a215edc7"},{"_id":51117,"start":"2026-04-13T12:33:41.488-04:00","end":"2026-04-13T13:12:43.162-04:00","country":"col","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Bogotá (2025-2027)","name_en":"2nd Open Government Action Plan of Bogotá (2025–2027)","responsible_institution":[{"responsible_institution/institution":"Secretaría General","responsible_institution/id_institution":"45166","responsible_institution/name_institution":"Secretaría General"}],"coordinator":"Círculo de Gobierno Abierto de Bogotá","id_coordinator":"45060","name_coordinator":"Círculo de Gobierno Abierto de Bogotá","plan_number":"2","link":"59a6d86e-ebe5-4b71-8c15-633cf17b4e03","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-bogota-colombia-2025-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Distrito Capital de Bogotá","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Segundo Plan de Acción de Gobierno Abierto de Bogotá (2025–2026) es el instrumento estratégico mediante el cual el Distrito Capital consolida y profundiza su política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan da continuidad al primer plan de acción y se orienta a fortalecer un modelo de gobernanza basado en la transparencia, la participación ciudadana, la rendición de cuentas y la innovación pública.\n\nEl plan se construye a partir de los aprendizajes del ciclo anterior, incorporando mejoras en los mecanismos de articulación institucional y en la inclusión de actores diversos en los procesos de toma de decisiones. En este contexto, se busca avanzar hacia una mayor institucionalización del enfoque de gobierno abierto dentro de la administración distrital, integrándolo de manera transversal en diferentes sectores y políticas públicas.\n\nSu elaboración se desarrolló mediante un proceso de cocreación que involucró a entidades distritales, organizaciones de la sociedad civil, academia y ciudadanía. A través de espacios participativos, consultas y mesas de trabajo, se definieron compromisos orientados a responder a prioridades ciudadanas y a fortalecer la legitimidad de la acción pública. Este enfoque colaborativo también se refleja en la implementación del plan, que contempla mecanismos de seguimiento conjunto y evaluación participativa.\n\nEntre sus principales líneas de acción se encuentran el fortalecimiento de la transparencia y el acceso a la información pública, la mejora de los canales de participación ciudadana —tanto digitales como presenciales—, el impulso de estrategias de datos abiertos y el desarrollo de iniciativas de innovación pública. Asimismo, el plan incorpora enfoques transversales como la inclusión, la equidad y el uso de tecnologías para mejorar la relación entre el Estado y la ciudadanía.\n\nEn conjunto, el Segundo Plan de Acción de Bogotá busca consolidar un gobierno más abierto, inclusivo y efectivo, promoviendo la colaboración entre el sector público y la ciudadanía para mejorar la calidad de las políticas públicas y fortalecer la confianza en las instituciones.","description_en":"The Second Open Government Action Plan of Bogotá (2025–2027) is the strategic instrument through which the Capital District consolidates and advances its open government agenda within the framework of the Open Government Partnership (OGP) at the local level. Building on the first action plan, it aims to strengthen a governance model based on transparency, citizen participation, accountability, and public sector innovation.\n\nThe plan builds on lessons learned from the previous cycle, incorporating improvements in institutional coordination mechanisms and in the inclusion of diverse stakeholders in decision-making processes. In this context, it seeks to further institutionalize the open government approach within the district administration, integrating it across different sectors and public policies.\n\nIt was developed through a co-creation process involving district entities, civil society organizations, academia, and citizens. Through participatory spaces, consultations, and working groups, commitments were defined to address citizens’ priorities and enhance the legitimacy of public action. This collaborative approach is also reflected in the implementation phase, which includes joint monitoring mechanisms and participatory evaluation processes.\n\nIts main lines of action include strengthening transparency and access to public information, improving citizen participation channels —both digital and in-person—, advancing open data strategies, and promoting public innovation initiatives. The plan also incorporates cross-cutting approaches such as inclusion, equity, and the use of technology to improve the relationship between government and citizens.\n\nOverall, the Second Action Plan of Bogotá aims to consolidate a more open, inclusive, and effective government, fostering collaboration between public institutions and citizens to improve policy outcomes and strengthen trust in public institutions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:a3120628-b830-4d1d-979b-5e193bee48d1","meta/deprecatedID":"uuid:de935cb7-45eb-4eba-80cb-fb554978f5ad","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__003":"vcKhXenSgJ29WWJq5RyHAt","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a3120628-b830-4d1d-979b-5e193bee48d1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T16:36:05","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104790,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:a3120628-b830-4d1d-979b-5e193bee48d1"},{"_id":51118,"start":"2026-04-13T13:13:09.288-04:00","end":"2026-05-12T12:25:27.389-04:00","country":"col","theme":"open_government","original_language":"es","name_es":"1er Plan de Acción de Gobierno Abierto de Medellín (2025-2027)","name_en":"1st Open Government Action Plan of Medellín (2025–2027)","responsible_institution":[{"responsible_institution/institution":"Alcaldía de Medellín - Distrito Especial de Ciencia, Tecnología e Innovación","responsible_institution/id_institution":"51097","responsible_institution/name_institution":"Alcaldía de Medellín - Distrito Especial de Ciencia, Tecnología e Innovación"}],"coordinator":"Comité de Gobierno Abierto (2024-2028)","id_coordinator":"51417","name_coordinator":"Comité de Gobierno Abierto (2024-2028)","plan_number":"1","link":"7ef5bc93-41f0-4fa8-9133-20a258dce6e0","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2025/05/Medellin-Colombia.-Action-Plan.pdf","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city","city":"Ciudad de Medellín","validity_applies_from":"yes","effective_since":"2025-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El 1er Plan de Acción de Gobierno Abierto de Medellín (2025–2027) es el instrumento estratégico mediante el cual el municipio inicia la implementación de una política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan representa un hito institucional al establecer por primera vez una agenda estructurada orientada a promover la transparencia, la participación ciudadana, la rendición de cuentas y la innovación pública en la gestión municipal.\n\nEl plan se concibe como un punto de partida para consolidar un modelo de gobernanza más abierto, inclusivo y colaborativo, alineado con estándares internacionales y adaptado a las particularidades del contexto local. En este sentido, busca fortalecer las capacidades institucionales del municipio, mejorar la relación entre el gobierno y la ciudadanía, y fomentar una cultura de apertura en la toma de decisiones públicas.\n\nSu elaboración se desarrolló mediante un proceso de cocreación que involucró a entidades del gobierno municipal, organizaciones de la sociedad civil, academia y ciudadanía. A través de espacios participativos, consultas públicas y mesas de trabajo, se definieron compromisos orientados a responder a prioridades locales y a fortalecer la legitimidad de la acción pública. Este enfoque participativo también se refleja en la implementación del plan, que contempla mecanismos de seguimiento conjunto y evaluación participativa.\n\nEntre sus principales líneas de acción se encuentran el fortalecimiento de la transparencia y el acceso a la información pública, la promoción de la participación ciudadana mediante herramientas digitales y presenciales, el impulso de estrategias de datos abiertos y el desarrollo de iniciativas de innovación pública. Asimismo, el plan incorpora enfoques transversales como la inclusión, la equidad y el uso de tecnologías para mejorar la relación entre el Estado y la ciudadanía.\n\nEn conjunto, el Primer Plan de Acción de Medellín busca sentar las bases para la institucionalización del gobierno abierto en el municipio, promoviendo un modelo de gestión pública más transparente, participativo y orientado a resultados, con el objetivo de mejorar la calidad de vida de la ciudadanía y fortalecer la confianza en las instituciones.","description_en":"The 1st Open Government Action Plan of Medellín (2025–2027) is the strategic instrument through which the municipality initiates the implementation of an open government policy within the framework of the Open Government Partnership (OGP) at the local level. This plan represents an important institutional milestone, as it establishes for the first time a structured agenda aimed at promoting transparency, citizen participation, accountability, and public sector innovation in municipal governance.\n\nThe plan is conceived as a starting point for consolidating a more open, inclusive, and collaborative governance model, aligned with international standards and adapted to the local context. In this regard, it seeks to strengthen the municipality’s institutional capacities, improve the relationship between government and citizens, and foster a culture of openness in public decision-making.\n\nIt was developed through a co-creation process involving municipal government entities, civil society organizations, academia, and citizens. Through participatory spaces, public consultations, and working groups, commitments were defined to address local priorities and enhance the legitimacy of public action. This participatory approach is also reflected in the implementation phase, which includes joint monitoring mechanisms and participatory evaluation processes.\n\nIts main lines of action include strengthening transparency and access to public information, promoting citizen participation through both digital and in-person tools, advancing open data strategies, and fostering public innovation initiatives. The plan also incorporates cross-cutting approaches such as inclusion, equity, and the use of technology to improve the relationship between government and citizens.\n\nOverall, the First Action Plan of Medellín seeks to lay the foundations for the institutionalization of open government within the municipality, promoting a more transparent, participatory, and results-oriented public management model aimed at improving citizens’ quality of life and strengthening trust in public institutions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:86e705de-8883-4e2c-83f9-90139ec552ed","meta/deprecatedID":"uuid:72efde8c-f7ac-4a45-a413-6e0d339e40e5","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"86e705de-8883-4e2c-83f9-90139ec552ed","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T17:17:39","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104778,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:86e705de-8883-4e2c-83f9-90139ec552ed"},{"_id":51119,"start":"2026-04-13T13:53:50.770-04:00","end":"2026-05-07T15:26:27.495-04:00","country":"bra","theme":"open_government","original_language":"pt","name_es":"1er Plan de Acción de Gobierno Abierto del Estado de Goiás (2024–2026)","name_en":"1st Open Government Action Plan of the State of Goiás (2024–2026)","responsible_institution":[{"responsible_institution/institution":"Contraloría General del Estado de Goiás","responsible_institution/id_institution":"51273","responsible_institution/name_institution":"Contraloría General del Estado de Goiás"}],"coordinator":"Foro de Gobierno Abierto de Goiás","id_coordinator":"51274","name_coordinator":"Foro de Gobierno Abierto de Goiás","plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-state-of-goias-brazil-2024-2026/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dam","dam":"Estado de Goiás","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2026-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El 1er Plan de Acción de Gobierno Abierto del Estado de Goiás (2024–2026) es el instrumento estratégico mediante el cual el gobierno estadual de Goiás, en Brasil, inicia la implementación de una política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP). Este plan representa un hito institucional al establecer por primera vez una agenda estructurada orientada a promover la transparencia, la participación ciudadana, la rendición de cuentas y la innovación en la gestión pública a nivel estadual.\n\nEl plan se concibe como un punto de partida para consolidar un modelo de gobernanza más abierto, inclusivo y colaborativo, alineado con estándares internacionales y adaptado al contexto regional. En este sentido, busca fortalecer las capacidades institucionales del Estado, mejorar la relación entre el gobierno y la ciudadanía, y fomentar una cultura de apertura en la toma de decisiones públicas.\n\nSu elaboración se llevó a cabo mediante un proceso de cocreación que involucró a diversas instituciones del gobierno estadual, organizaciones de la sociedad civil, academia y ciudadanía. A través de espacios participativos, consultas públicas y mesas de trabajo, se definieron compromisos orientados a responder a prioridades locales y a fortalecer la legitimidad de la acción pública. Este enfoque participativo también se proyecta en la fase de implementación, que contempla mecanismos de seguimiento conjunto y evaluación participativa.\n\nEntre sus principales líneas de acción se encuentran el fortalecimiento de la transparencia y el acceso a la información pública, la promoción de la participación ciudadana, el impulso de políticas de datos abiertos y el desarrollo de iniciativas de innovación pública. Asimismo, el plan incorpora enfoques transversales como la integridad, la inclusión y el uso de tecnologías digitales para mejorar la gestión pública.\n\nEn conjunto, el Primer Plan de Acción de Goiás busca sentar las bases para la institucionalización del gobierno abierto en el ámbito estadual, promoviendo una administración más transparente, participativa y orientada a resultados, con el objetivo de mejorar la calidad de vida de la ciudadanía y fortalecer la confianza en las instituciones.","description_en":"The 1st Open Government Action Plan of the State of Goiás (2024–2026) is the strategic instrument through which the state government of Goiás, in Brazil, initiates the implementation of an open government policy within the framework of the Open Government Partnership (OGP). This plan represents an important institutional milestone, as it establishes for the first time a structured agenda aimed at promoting transparency, citizen participation, accountability, and innovation in public management at the state level.\n\nThe plan is conceived as a starting point for consolidating a more open, inclusive, and collaborative governance model, aligned with international standards and adapted to the regional context. In this regard, it seeks to strengthen institutional capacities, improve the relationship between government and citizens, and foster a culture of openness in public decision-making.\n\nIt was developed through a co-creation process involving various state government institutions, civil society organizations, academia, and citizens. Through participatory spaces, public consultations, and working groups, commitments were defined to address local priorities and enhance the legitimacy of public action. This participatory approach is also reflected in the implementation phase, which includes joint monitoring mechanisms and participatory evaluation processes.\n\nIts main lines of action include strengthening transparency and access to public information, promoting citizen participation, advancing open data policies, and fostering public innovation initiatives. The plan also incorporates cross-cutting approaches such as integrity, inclusion, and the use of digital technologies to improve public management.\n\nOverall, the First Action Plan of Goiás seeks to lay the foundations for the institutionalization of open government at the state level, promoting a more transparent, participatory, and results-oriented administration aimed at improving citizens’ quality of life and strengthening trust in public institutions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:bbf16594-e18a-4eb9-90f8-6c16825469f1","meta/deprecatedID":"uuid:0f3cf082-5bd1-4eb6-84cb-a55af05bf7e9","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"bbf16594-e18a-4eb9-90f8-6c16825469f1","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T17:58:01","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104770,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:bbf16594-e18a-4eb9-90f8-6c16825469f1"},{"_id":51120,"start":"2026-04-13T13:57:47.977-04:00","end":"2026-05-07T10:26:11.388-04:00","country":"bra","theme":"open_government","original_language":"pt","name_es":"1er Plan de Acción de Gobierno Abierto de Vitória da Conquista (2024–2025)","name_en":"1st Open Government Action Plan of Vitória da Conquista (2024–2025)","responsible_institution":[{"responsible_institution/institution":"Vitória da Conquista","responsible_institution/id_institution":"51095","responsible_institution/name_institution":"Vitória da Conquista"}],"plan_number":"1","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-vitoria-da-conquista-brazil-2024-2025/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipalidad de Vitória Da Conquista","validity_applies_from":"yes","effective_since":"2024-01-01","validity_applies_until":"yes","effective_until":"2025-01-01","effective_today":"no","temporality":"short_term","visible_description":"yes","description_es":"El Primer Plan de Acción de Gobierno Abierto de Vitória da Conquista (2024–2025) es el instrumento estratégico mediante el cual el gobierno municipal inicia la implementación de una política de gobierno abierto en el marco de la Alianza para el Gobierno Abierto (OGP) a nivel local. Este plan representa un hito institucional al establecer por primera vez una agenda estructurada orientada a promover la transparencia, la participación ciudadana, la rendición de cuentas y la innovación pública en la gestión municipal.\n\nEl plan se concibe como un punto de partida para consolidar un modelo de gobernanza más abierto, inclusivo y colaborativo, alineado con estándares internacionales y adaptado al contexto local. En este sentido, busca fortalecer las capacidades institucionales del municipio, mejorar la relación entre el gobierno y la ciudadanía, y fomentar una cultura de apertura en la toma de decisiones públicas.\n\nSu elaboración se llevó a cabo mediante un proceso de cocreación que involucró a diversas áreas del gobierno municipal, organizaciones de la sociedad civil, academia y ciudadanía. A través de espacios participativos, consultas públicas y mesas de trabajo, se definieron compromisos orientados a responder a prioridades locales y a fortalecer la legitimidad de la acción pública. Este enfoque participativo también se proyecta en la fase de implementación, que contempla mecanismos de seguimiento conjunto y evaluación participativa.\n\nEntre sus principales líneas de acción se encuentran el fortalecimiento de la transparencia y el acceso a la información pública, la promoción de la participación ciudadana mediante herramientas digitales y presenciales, el impulso de políticas de datos abiertos y el desarrollo de iniciativas de innovación pública. Asimismo, el plan incorpora enfoques transversales como la inclusión, la equidad y el uso de tecnologías digitales para mejorar la gestión municipal.\n\nEn conjunto, el Primer Plan de Acción de Vitória da Conquista busca sentar las bases para la institucionalización del gobierno abierto en el ámbito local, promoviendo una gestión más transparente, participativa y orientada a resultados, con el objetivo de mejorar la calidad de vida de la ciudadanía y fortalecer la confianza en las instituciones públicas.","description_en":"The First Open Government Action Plan of Vitória da Conquista (2024–2025) is the strategic instrument through which the municipal government initiates the implementation of an open government policy within the framework of the Open Government Partnership (OGP) at the local level. This plan represents an important institutional milestone, as it establishes for the first time a structured agenda aimed at promoting transparency, citizen participation, accountability, and public sector innovation in municipal governance.\n\nThe plan is conceived as a starting point for consolidating a more open, inclusive, and collaborative governance model, aligned with international standards and adapted to the local context. In this regard, it seeks to strengthen institutional capacities, improve the relationship between government and citizens, and foster a culture of openness in public decision-making.\n\nIt was developed through a co-creation process involving various municipal government departments, civil society organizations, academia, and citizens. Through participatory spaces, public consultations, and working groups, commitments were defined to address local priorities and enhance the legitimacy of public action. This participatory approach is also reflected in the implementation phase, which includes joint monitoring mechanisms and participatory evaluation processes.\n\nIts main lines of action include strengthening transparency and access to public information, promoting citizen participation through both digital and in-person tools, advancing open data policies, and fostering public innovation initiatives. The plan also incorporates cross-cutting approaches such as inclusion, equity, and the use of digital technologies to improve municipal management.\n\nOverall, the First Action Plan of Vitória da Conquista seeks to lay the foundations for the institutionalization of open government at the local level, promoting a more transparent, participatory, and results-oriented governance model aimed at improving citizens’ quality of life and strengthening trust in public institutions.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:a47c8176-f65a-4313-a931-7b60b17d7b09","meta/deprecatedID":"uuid:be072641-80e7-41db-9443-50cbd09d5b96","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"a47c8176-f65a-4313-a931-7b60b17d7b09","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-13T18:01:53","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776104755,"uid":"validation_status_approved","by_whom":"ilpes_anonimo","color":"#00ff00","label":"Approved"},"_submitted_by":"paulinestockins","meta/rootUuid":"uuid:a47c8176-f65a-4313-a931-7b60b17d7b09"},{"_id":51146,"start":"2026-04-21T11:02:11.968-04:00","end":"2026-04-28T12:28:13.233-04:00","country":"gtm","theme":"open_government","original_language":"es","name_es":"7° Plan de Acción Nacional de Gobierno Abierto (2026-2027)","name_en":"7th National Open Government Action Plan (2026-2027)","responsible_institution":[{"responsible_institution/institution":"Comisión Presidencial de Gobierno Abierto y Electrónico de Guatemala","responsible_institution/id_institution":"45249","responsible_institution/name_institution":"Comisión Presidencial de Gobierno Abierto y Electrónico de Guatemala"}],"coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","id_coordinator":"45156","name_coordinator":"Comité Técnico de Gobierno Abierto de Guatemala","plan_number":"7","link":"0a3cb99f-a577-4063-87b5-6988f4090782","primary_link":"https://www.opengovpartnership.org/wp-content/uploads/2026/04/Guatemala_Action-Plan_2026-2027_ES.pdf","instrument_type":"plan","territorial_scale":"national","validity_applies_from":"yes","effective_since":"2026-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El 7° Plan de Acción Nacional de Gobierno Abierto de Guatemala 2026-2027 es el resultado de un proceso de cocreación caracterizado por un enfoque descentralizado y de escucha activa, el cual trasladó el diálogo a 11 territorios prioritarios del país para integrar las demandas ciudadanas directamente desde sus comunidades. Este modelo incluyó la instalación de mesas técnicas donde participaron instituciones públicas, organizaciones de la sociedad civil y especialistas bajo una metodología de trabajo que garantizó la factibilidad técnica y presupuestaria de las propuestas. Un elemento distintivo de este ciclo fue la fase de \"Respuesta Razonada\", un ejercicio de transparencia obligatoria donde el Estado explicó públicamente cómo se integraron los aportes recolectados en las regiones, asegurando que la participación ciudadana fuera incidente y documentada.\n\nEl plan se estructura formalmente en 8 compromisos estratégicos que se desglosan en 56 hitos o metas verificables, diseñados para transformar la gestión pública bajo los pilares de transparencia y rendición de cuentas. Estos compromisos abordan áreas críticas como la seguridad alimentaria y nutricional, la prevención de la violencia contra las mujeres con pertinencia cultural y la mejora de la ruta de atención para la población migrante retornada. Asimismo, el documento contempla acciones para fortalecer la transparencia en la gestión del agua y el medio ambiente, la transformación digital de los servicios de pensiones civiles, la fiscalización de recursos otorgados a ONG, el aprovechamiento de datos abiertos y la lucha contra la corrupción mediante auditorías sociales en proyectos de desarrollo departamental.","description_en":"The 7th National Open Government Action Plan of Guatemala 2026-2027 is the result of a co-creation process characterized by a decentralized and active listening approach, which moved the dialogue to 11 priority territories of the country to integrate citizen demands directly from their communities. This model included the establishment of technical tables where public institutions, civil society organizations, and specialists participated under a work methodology that guaranteed the technical and budgetary feasibility of the proposals. A distinctive element of this cycle was the \"Reasoned Response\" phase, a mandatory transparency exercise where the State publicly explained how the contributions collected in the regions were integrated, ensuring that citizen participation was influential and documented\n\nThe plan is formally structured into 8 strategic commitments broken down into 56 milestones or verifiable goals, designed to transform public management under the pillars of transparency and accountability. These commitments address critical areas such as food and nutritional security, the prevention of violence against women with cultural relevance, and the improvement of the care pathway for the returned migrant population. Likewise, the document includes actions to strengthen transparency in water and environmental management, the digital transformation of civil pension services, the oversight of resources granted to NGOs, the utilization of open data, and the fight against corruption through social audits in departmental development projects.","__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","meta/instanceID":"uuid:5dd5ae0f-1600-4ece-978d-514faefb8656","meta/deprecatedID":"uuid:79380362-12b3-4694-9609-e07df89a9cab","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__003":"vJ7GsLZBMwSa245rkRDJcA","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"5dd5ae0f-1600-4ece-978d-514faefb8656","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-04-21T15:47:47","_tags":[],"_notes":[],"_validation_status":{"timestamp":1776787833,"uid":"validation_status_approved","by_whom":"bsilva","color":"#00ff00","label":"Approved"},"_submitted_by":"ilpes_anonimo","meta/rootUuid":"uuid:5dd5ae0f-1600-4ece-978d-514faefb8656"},{"_id":51280,"start":"2026-05-07T16:03:18.242-04:00","end":"2026-05-12T16:14:32.589-04:00","country":"bra","theme":"open_government","original_language":"pt","name_es":"2do Plan de Acción de Gobierno Abierto de Contagem (2026-2028)","name_en":"2nd Open Government Action Plan of Contagem (2026-2028)","responsible_institution":[{"responsible_institution/institution":"Controladoria Geral do Município de Contagem","responsible_institution/id_institution":"45099","responsible_institution/name_institution":"Controladoria Geral do Município de Contagem"}],"plan_number":"2","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-contagem-brazil-2026-2028/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Municipio de Contagem","validity_applies_from":"yes","effective_since":"2026-01-01","validity_applies_until":"yes","effective_until":"2028-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción de Gobierno Abierto de Contagem (2026–2028) busca consolidar una gestión pública más transparente, participativa y colaborativa, profundizando una cultura institucional de gobierno abierto ya en desarrollo en el municipio.\n\nEl plan se estructura en torno a compromisos cocreados entre gobierno, sociedad civil y academia, con énfasis en tres grandes líneas de acción:\n\n1. Ampliación del acceso a la justicia y resolución de conflictos, fortaleciendo mecanismos administrativos para mejorar la confianza institucional.\n2. Gobernanza ambiental y planificación urbana participativa, incorporando a la ciudadanía en decisiones sobre sostenibilidad y desarrollo territorial.\n3. Políticas de equidad de género e inclusión, mediante sistemas de información, indicadores y acciones específicas para mujeres y grupos vulnerables.\n\nAdemás, el plan refuerza herramientas ya existentes como la plataforma de participación ciudadana, la transparencia activa y los procesos digitales de consulta, integrando monitoreo independiente por una institución académica y mecanismos permanentes de seguimiento ciudadano.\n\nEn conjunto, el plan busca institucionalizar el gobierno abierto en Contagem, fortaleciendo la transparencia, la participación ciudadana y la rendición de cuentas como prácticas permanentes de la gestión pública.","description_en":"The Open Government Action Plan of Contagem (2026–2028) seeks to consolidate a more transparent, participatory, and collaborative public administration, deepening an institutional culture of open government that is already under development in the municipality.\n\nThe plan is structured around commitments co-created between government, civil society, and academia, with an emphasis on three main lines of action:\n\n1. Expansion of access to justice and conflict resolution, strengthening administrative mechanisms to enhance institutional trust.\n2. Environmental governance and participatory urban planning, involving citizens in decisions related to sustainability and territorial development.\n3. Gender equity and inclusion policies, through information systems, indicators, and targeted actions for women and vulnerable groups.\n\nIn addition, the plan reinforces existing tools such as the citizen participation platform, proactive transparency, and digital consultation processes, integrating independent monitoring by an academic institution and permanent citizen oversight mechanisms.\n\nOverall, the plan aims to institutionalize open government in Contagem, strengthening transparency, citizen participation, and accountability as permanent practices of public management.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"1er Plan de Acción de Gobierno Abierto de Contagem 2022-2024","link_block/plan_id":"46654","link_block/plan_name":"1er Plan de Acción de Gobierno Abierto de Contagem 2022-2024"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:9fcfc9c7-5c7c-48f7-8f41-2fc83cc0eb91","meta/deprecatedID":"uuid:4e116d9d-c80e-4a5f-a93d-2df265d6f8c2","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__004":"vzVDKzD8ZctygZt9wp4LJD","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"9fcfc9c7-5c7c-48f7-8f41-2fc83cc0eb91","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-05-07T20:09:12","_tags":[],"_notes":[],"_validation_status":{"timestamp":1778184558,"uid":"validation_status_approved","by_whom":"mbeck","color":"#00ff00","label":"Approved"},"_submitted_by":"ilpes_anonimo","meta/rootUuid":"uuid:9fcfc9c7-5c7c-48f7-8f41-2fc83cc0eb91"},{"_id":51477,"start":"2026-05-12T15:29:40.616-04:00","end":"2026-05-12T15:50:15.537-04:00","country":"col","theme":"open_government","original_language":"es","name_es":"2do Plan de Acción de Gobierno Abierto de Cartagena de Indias (2026-2027)","name_en":"2nd Open Government Action Plan of Cartagena de Indias (2026-2027)","responsible_institution":[{"responsible_institution/institution":"Secretaría General (Cartagena de Indias)","responsible_institution/id_institution":"51482","responsible_institution/name_institution":"Secretaría General (Cartagena de Indias)"}],"coordinator":"Foro Multiactor de Seguimiento","id_coordinator":"51476","name_coordinator":"Foro Multiactor de Seguimiento","plan_number":"2","primary_link":"https://www.opengovpartnership.org/es/documents/action-plan-cartagena-de-indias-colombia-2026-2027/","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"city dame","city":"Distrito Turístico y Cultural de Cartagena de Indias","validity_applies_from":"yes","effective_since":"2026-01-01","validity_applies_until":"yes","effective_until":"2027-01-01","effective_today":"yes","temporality":"short_term","visible_description":"yes","description_es":"El Plan de Acción de Gobierno Abierto de Cartagena de Indias (Colombia) 2026–2027 busca consolidar un modelo de gobernanza centrado en las personas. El plan fue cocreado entre la Alcaldía, organizaciones de la sociedad civil, academia, sector privado y comunidades locales, con el objetivo de fortalecer la confianza pública y mejorar la relación entre el Estado y la ciudadanía.\n\nEl plan prioriza compromisos con enfoque territorial y fortalecimiento institucional, entre los que destacan:\n\n1. La mejora de los canales digitales de acceso a trámites, servicios e información pública mediante la plataforma “Catalina”, para simplificar la experiencia ciudadana y facilitar el seguimiento de solicitudes.\n2. La promoción de una participación amplia e informada en la formulación del Plan de Ordenamiento Territorial, incorporando mecanismos de diálogo y consulta con comunidades urbanas y rurales.\n3. El fortalecimiento de espacios de participación territorial, como reuniones vecinales y mesas de trabajo comunitarias, para acercar la administración distrital a las necesidades locales.\n4. La creación de espacios de coordinación entre el sector público, privado y la ciudadanía para impulsar soluciones compartidas, alianzas y mecanismos de control social.\n\nAdemás, el plan incorpora mecanismos de seguimiento participativo e independiente, con participación de academia y sociedad civil, así como estrategias para garantizar una participación diversa e inclusiva de mujeres, jóvenes, personas con discapacidad, población afrodescendiente, víctimas y migrantes.\n\nEn conjunto, el plan busca fortalecer una gestión pública más abierta, colaborativa y cercana a la ciudadanía, utilizando la innovación y la participación como herramientas para mejorar la toma de decisiones y la calidad de los servicios públicos.","description_en":"The Cartagena de Indias (Colombia) Open Government Action Plan 2026–2027 seeks to consolidate a people-centered governance model. The plan was co-created by the Mayor’s Office, civil society organizations, academia, the private sector, and local communities, with the objective of strengthening public trust and improving the relationship between the State and citizens.\n\nThe plan prioritizes commitments focused on territorial approaches and institutional strengthening, including:\n\n1. Improving digital channels for access to procedures, services, and public information through the “Catalina” platform, in order to simplify the citizen experience and facilitate the tracking of requests.\n2. Promoting broad and informed participation in the formulation of the Land Use Plan, incorporating dialogue and consultation mechanisms with urban and rural communities.\n3. Strengthening territorial participation spaces, such as neighborhood meetings and community working groups, to bring the district administration closer to local needs.\n4. Creating coordination spaces among the public sector, private sector, and citizens to promote shared solutions, partnerships, and social oversight mechanisms.\n\nIn addition, the plan incorporates participatory and independent monitoring mechanisms involving academia and civil society, as well as strategies to ensure diverse and inclusive participation by women, youth, persons with disabilities, Afro-descendant populations, victims, and migrants.\n\nOverall, the plan seeks to strengthen a more open, collaborative, and citizen-centered public administration, using innovation and participation as tools to improve decision-making and the quality of public services.","link_block":[{"link_block/link_type":"internal","link_block/internal_link_type":"plan","link_block/plan_link":"1er Plan de Acción de Gobierno Abierto de Cartagena de Indias 2022-2023","link_block/plan_id":"46648","link_block/plan_name":"1er Plan de Acción de Gobierno Abierto de Cartagena de Indias 2022-2023"}],"__version__":"vhrnWECDdvGyX4fY8MZ8a4","_version_":"vCmfC7BgRr53k6xLDmHPZf","_version__001":"vt7J2J7wWgKgSPhR2UxuBv","_version__002":"vJhNfcuD6uxnH6YyjnC8a3","_version__003":"vMuzadaaB4cEDwPURqWvkV","meta/instanceID":"uuid:e853603c-fbed-4293-af8b-7d6fcaeffd18","meta/deprecatedID":"uuid:625efc2d-3721-4181-ba87-68a752dd1609","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","_version__004":"vzVDKzD8ZctygZt9wp4LJD","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"e853603c-fbed-4293-af8b-7d6fcaeffd18","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-05-12T19:38:15","_tags":[],"_notes":[],"_validation_status":{"timestamp":1778614722,"uid":"validation_status_approved","by_whom":"mbeck","color":"#00ff00","label":"Approved"},"_submitted_by":"ilpes_anonimo","meta/rootUuid":"uuid:e853603c-fbed-4293-af8b-7d6fcaeffd18"},{"_id":51495,"parsererror/h3":[{"parsererror/h3":"This page contains the following errors:"},{"parsererror/h3":"Below is a rendering of the page up to the first error."}],"parsererror/div":"error on line 42 at column 126: PCDATA invalid Char value 31","formhub/uuid":"625c1b08891a4c50b6d74679c480f87d","start":"2026-05-13T14:07:27.213-04:00","end":"2026-05-13T15:49:35.181-04:00","country":"col","theme":"mobility","original_language":"es","name_es":"Plan maestro de movilidad de Manizales","primary_link":"https://www.concejodemanizales.gov.co/gacetas--concejo-de-manizales/gaceta-n00188-manizales-plan-maestro-de-movilidad","instrument_type":"plan","territorial_scale":"subnational","territorial_unit":"dame","dame":"Manizales","validity_applies_from":"yes","effective_since":"2018-01-01","effective_today":"no","temporality":"long_term","_xform_id_string":"aPJUaqc6gbHKCdcXQV3bYh","_uuid":"2cf98a1b4edb4adba77e26f8f8dab10a","_attachments":[],"_status":"submitted_via_web","_geolocation":[null,null],"_submission_time":"2026-05-13T19:49:42","_tags":[],"_notes":[],"_validation_status":{"timestamp":1782920032,"uid":"validation_status_approved","by_whom":"bsilva","color":"#00ff00","label":"Approved"},"_submitted_by":"csandoval","meta/rootUuid":"uuid:2cf98a1b4edb4adba77e26f8f8dab10a"}]}
