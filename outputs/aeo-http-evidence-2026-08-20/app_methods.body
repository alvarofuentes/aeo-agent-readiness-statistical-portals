      function calculationJson(json){

        json.forEach((item, i) => {

            // renombramiento tema
            let theme = item.thematic;
            // renombrar territorial_development por territorial_planning
            item.thematic = theme.replace(/territorial_development/g, "territorial_planning");

        });

        return json;
      }




