      const option_typedoc = extraerValoresPorClave(filtro_actual, "publication_type");


      if(option_temas.length>0) {
        results = results.filter(x =>
          x.thematic?.split(' ').some(x => option_temas.includes(x))
        );
      }

      if(paises.length>0) {
        results = results.filter(x =>
          x.country?.split(' ').some(x => paises.includes(x))
        );
      }

      /* if(option_areas_met.length>0) {
        results = results.filter(x =>
