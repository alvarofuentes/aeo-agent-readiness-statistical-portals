  //Selector
  function loadDataToSelect(xf,node,id_select,title) {

      let results;
      if(xf=="all") {
        results = responseDataGlobal_result;
      } else {
        results=xf;
      }

      let var_3 = node;
      let themes = [];

      results.forEach((x, i) => {
          //themes.push(x[var_3]);

          // v2 con multi code separado espacio
          if(x[var_3]) {
          //x[var_3].split(" ").forEach(code => {
          x[var_3].split(/\s+/).forEach(code => {
            if (code.trim()) {
              themes.push(code);
            }
          });
          }

      });



      // 02. LISTA UNICA
      let themes_un_c = uniqueCount(themes);

      themes_un_c.forEach((x, i) => {
        let code = x.label;
        x.title = getLabelFromJson(code);
      });


      //themes EN SELECT
      if (load_one_time == 0) {

        //sort a-z a z

