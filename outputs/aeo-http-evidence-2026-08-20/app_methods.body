      loadDataToSelect_multiple(results,'country','multiselect2-menu','Todos los países');
      //loadDataToSelect_multiple(results,'methodologic_area','multiselect3-menu','Todas las áreas metodológicas');
      loadDataToSelect_multiple(results,'publication_type','multiselect4-menu','Todas los tipos de documento');
      load_one_time_function=1; //carga una sola vez para select multiples



      let var_0 = `_id`;

