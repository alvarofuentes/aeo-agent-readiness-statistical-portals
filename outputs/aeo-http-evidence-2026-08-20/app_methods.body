            results = results.filter(x =>
                palabras.every(y =>
                    (x.title_es && x.title_es.toLowerCase().includes(y)) ||
                    (x.title_en && x.title_en.toLowerCase().includes(y)) ||
                    (x.autor_es && x.autor_es.toLowerCase().includes(y))

                )
            );
          }

      });




