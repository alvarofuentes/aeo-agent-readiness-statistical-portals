<script src="assets/dashboard_svg_icons.js?v=7"></script>



<script>

  const theme_code = ["development_planning", "public_investment", "open_government", "territorial_development", "territorial_planning", "urban_development", "mobility"];

  let theme_titles = ['Planificación para el desarrollo', 'Inversión pública', 'Gobierno abierto', 'Desarrollo territorial', 'Desarrollo y Ordenamiento territorial', 'Desarrollo urbano', 'Movilidad urbana', 'Seguimiento, monitoreo y evaluación'];
  if (lang == "en") {
    theme_titles = ["Planning for development", "Public investment", "Open government", "Territorial development", "Land-use planning", "Urban development", "Urban mobility", 'Follow-up, monitoring and evaluation'];
  }

  //yellow v1 E0BB31  v2 DDA31C
  const theme_colors = ['#00BBD4', '#BA2E53', '#173668', '#93B54E', '#39855A', '#EA8B35', '#DDA31C', '#28ADB5'];
  const theme_colors_2 = ['#0092A7', '#961F3F', '#122A50', '#78913E', '#2F6A49', '#C5732B', '#B78516', '#218B91'];





  var icon = '<img style="margin-left:10px;margin-top:-50px;margin-right:18px;" src="images/svg/icon' + theme + '.svg" width="100px" />';
  let number_theme = theme - 1;
  document.getElementById('theme_name').innerHTML = icon + ' ' + theme_titles[number_theme];
  document.getElementById('theme_banner_1').style.backgroundColor = theme_colors[number_theme];

  document.getElementById('breadcrumb').innerHTML = '<a href="index.html?lang=es">Inicio</a> &nbsp;&raquo;&nbsp; Áreas de gestión pública &nbsp;&raquo;&nbsp; ' + theme_titles[number_theme];
  if (lang == "en") {
    document.getElementById('breadcrumb').innerHTML = '<a href="index.html?lang=en">Home</a> &nbsp;&raquo;&nbsp; Public management areas &nbsp;&raquo;&nbsp; ' + theme_titles[number_theme];
  }

  if (lang == "en") {
    document.getElementById('title_recursos').innerHTML = 'Resources and Tools of the Observatory';
    document.getElementById('title_cifras').innerHTML = 'Key Data of the Observatory';
    document.getElementById('title_recursos_externos').innerHTML = 'External resources';
    document.getElementById('link_red_snip').href = 'en/redsnip';
  }



  if (theme == 2) {
    document.getElementById('logo_circle').style.display = "block";
  }


  if (theme == 5 || theme == 6 || theme == 7) {
    document.getElementById('card_title_tag_theme').style.display = "block";
    document.getElementById('card_title_tag_theme').innerHTML = "Territorio";
  }



  //document.getElementById("theme_banner_1").style.backgroundImage = "url('images/bg/tema_"+theme+".jpg')";

  document.getElementById("theme_banner_1").style.setProperty(
    "--theme-banner",
    "url('images/bg/tema_" + theme + ".jpg')"
  );



  function addHTMLtoDiv(x, y) {
    document.getElementById(x).innerHTML = y;
    return false;
  }


  async function fetchJson(x, y) {
    try {
      const response = await fetch(x);
      if (!response.ok) {
        throw new Error('Error al cargar el archivo JSON');
      }
      const data = await response.json();
      if (y == 'desc') {
        displayDescription(data);
      }
      if (y == 'cont') {
        displayContent(data);
      }
      if (y == 'reso') {
        displayResourcesData(data);
      }
      if (y == 'extlink') {
        displayExternalLinkData(data);
      }
      if (y == 'cifras') {
        displayCifrasClaveData(data);
      }

    } catch (error) {
      console.error('Error:', error);
    }
  }



  function resaltarFrases(texto, frases) {
    frases.forEach(frase => {
      // Escapamos caracteres especiales para evitar errores en la expresión regular
      let fraseEscapada = frase.replace(/[-[\]{}()*+?.,\\^$|#\s]/g, "\\$&");

      // Creamos una expresión regular para la frase exacta
      let regex = new RegExp(fraseEscapada, "gi");

      // Reemplazamos la frase por la versión en negrita con <strong>
      texto = texto.replace(regex, `<strong>${frase}</strong>`);
    });

    return texto;
  }






  function displayDescription(y) {

    let z = y.filter(x => x.theme == theme);
    z.forEach(x => {
      let description = x.description_es;
      if (lang == "en") {
        description = x.description_en;
      }

      let parrafos = description.split("\r\n\\n\\n\r\n").map(p => `<p>${p}</p>`).join("");

      let frasesAResaltar = ["Instituto Latinoamericano y del Caribe de Planificación Económica y Social (ILPES)", "Latin American and Caribbean Institute for Economic and Social Planning (ILPES)"];

      let parrafos2 = resaltarFrases(parrafos, frasesAResaltar);

      if (x.context == "lac") {
        document.getElementById('theme_introduction').innerHTML = parrafos2;
      }

    });
  }


  let label_pais = 'PAISES';
  let label_cepal = 'CEPAL';
  let label_pais_width = '60';
  let label_cepal_margin = '70';
  if (lang == "en") {
    label_pais = 'COUNTRIES';
    label_cepal = 'ECLAC';
    label_pais_width = '90';
    label_cepal_margin = '100';
  }

  function displayResourcesData(y) {

    let z = y.filter(x => x.theme == theme);
    //let z = y;
    console.log(z);
    let cells = '<div class="row row-cols-1 row-cols-md-4 g-3" id="cards_resources">';

    z.forEach(x => {

      let foto = x.foto;
      let icon_paises = '';
      let name = x.title_es;
      let description = x.description_es;
      let paises = x.paises;
      let cepal = x.cepal;

      if (lang == "en") {
        name = x.title_en;
        description = x.description_en !== undefined ? x.description_en : description;
      }

      let color = theme_colors[number_theme];



      if (paises == 1 && cepal == 0) {
        icon_paises = `
        <div style="font-family: 'Roboto', sans-serif;position:absolute;right:5px;top:5px;background-color:#bbb;color:#fff;font-size:13px;font-weight:normal;width:${label_pais_width}px;text-align:center;">${label_pais}</div>
        `;
      }
      if (paises == 1 && cepal == 1) {
        icon_paises = `
        <div style="font-family: 'Roboto', sans-serif;position:absolute;right:5px;top:5px;background-color:#bbb;color:#fff;font-size:13px;font-weight:normal;width:${label_pais_width}px;text-align:center;">${label_pais}</div>
        <div style="font-family: 'Roboto', sans-serif;position:absolute;right:${label_cepal_margin}px;top:5px;background-color:#bbb;color:#fff;font-size:13px;font-weight:normal;width:60px;text-align:center;">${label_cepal}</div>
        `;
      }
      if (paises == 0 && cepal == 1) {
        icon_paises = `
        <div style="font-family: 'Roboto', sans-serif;position:absolute;right:5px;top:5px;background-color:#bbb;color:#fff;font-size:13px;font-weight:normal;width:60px;text-align:center;">${label_cepal}</div>
        `;
      }

      let de_alc = '';
      let link = x.link;
      //let svg_icon = svg_icon_methodology;
      let svg_icon = svg_undefined;

      let num_theme = theme;

      let image_icon_external_link = '';
      let window_open_target = '_self';
      let twoYears = new Date().getFullYear() - 2;

      if (link == 'marco-conceptual') {
        //link_f='marco-conceptual.html?lang=es&theme='+num_theme;
        link_f = 'include/pdf/Marco_conceptual_y_analitico_SNIP_es.pdf';
        if (lang == "en") { link_f = 'include/pdf/Marco_conceptual_y_analitico_SNIP_en.pdf'; };
        window_open_target = '_blank';
        svg_icon = svg_icon_methodology;
      } else if (link == 'planes' || link == 'politicas') {
        link_f = 'es/planes-programas-e-instrumentos/?theme=' + num_theme;
        if (lang == "en") { link_f = 'en/plans-programs-and-instruments/?theme=' + num_theme; };
        svg_icon = svg_icon_planes;
      } else if (link == 'snp') {
        link_f = 'es/sistemas-nacionales-de-planificacion';
        if (lang == "en") { link_f = 'en/national-planning-systems'; };
        svg_icon = svg_icon_snip;
      } else if (link == 'snip') {
        link_f = 'es/sistemas-nacionales-de-inversion-publica';
        if (lang == "en") { link_f = 'en/national-public-investment-systems'; };
        svg_icon = svg_icon_snip;
      } else if (link == 'normativas') {
        link_f = 'es/marcos-normativos/?theme=' + num_theme;
        if (lang == "en") { link_f = 'en/regulatory-frameworks/?theme=' + num_theme; };
        svg_icon = svg_icon_normativa;
      } else if (link == 'capacitacion') {
        link_f = 'https://www.cepal.org/es/actividades';
        if (theme == 1) {
          link_f = 'https://www.cepal.org/es/actividades?content_type=All&country=All&course_method=All&course_type=All&event_date_from=&event_date_to=&event_type=All&regional_office=All&related_project=All&sort_bef_combine=event_date_DESC&subsidiary_body=All&title=&topic=8360&work_area=8190#activities-list';
        } else if (theme == 2) {
          link_f = `https://www.cepal.org/es/actividades?content_type=All&country=All&course_method=All&course_type=All&event_date_from=${twoYears}-01-01&event_date_to=&event_type=All&regional_office=All&related_project=All&sort_bef_combine=event_date_DESC&subsidiary_body=All&title=%22inversi%C3%B3n%20p%C3%BAblica%22%20&topic=All&work_area=8190#activities-list`;
        } else if (theme == 3) {
          link_f = 'https://www.cepal.org/es/actividades?content_type=All&country=All&course_method=All&course_type=All&event_date_from=&event_date_to=&event_type=All&regional_office=All&related_project=All&sort_bef_combine=event_date_DESC&subsidiary_body=All&title=&topic=49&work_area=8190#activities-list';
        } else if (theme == 5) {
          link_f = 'https://www.cepal.org/es/actividades?content_type=All&country=All&course_method=All&course_type=All&event_date_from=&event_date_to=&event_type=All&regional_office=All&related_project=All&sort_bef_combine=event_date_DESC&subsidiary_body=All&title=%22inversi%C3%B3n%20p%C3%BAblica%22%20&topic=All&work_area=8190#activities-list';
        } else if (theme == 6) {
          link_f = 'https://www.cepal.org/es/actividades?content_type=All&country=All&course_method=All&course_type=All&event_date_from=&event_date_to=&event_type=All&regional_office=All&related_project=All&sort_bef_combine=event_date_DESC&subsidiary_body=All&title=%22urbano%22&topic=All&work_area=All#activities-list';
        } else if (theme == 7) {
          link_f = 'https://www.cepal.org/es/actividades?content_type=All&country=All&course_method=All&course_type=All&event_date_from=&event_date_to=&event_type=All&regional_office=All&related_project=All&sort_bef_combine=event_date_DESC&subsidiary_body=All&title=%25%22movilidad%20urbana%22%20&topic=All&work_area=All#activities-list';
        }
        svg_icon = svg_icon_capacitacion;
        image_icon_external_link = '<img src="images/extlink.png" height="20" style="margin-top:-3px;margin-left:8px;" />';
        window_open_target = '_blank';
      } else if (link == 'metodologias') {
        link_f = 'es/metodologias/?theme=' + num_theme;
        if (lang == "en") { link_f = 'en/methodologies/?theme=' + num_theme; };
        svg_icon = svg_icon_metodologia;
      } else if (link == 'documentos') {
        link_f = 'https://www.cepal.org/es/listado/cepal_publication';
        if (theme == 1) {
          link_f = 'https://www.cepal.org/es/listado/cepal_publication?title=&sort_bef_combine=date_DESC&date_from=&date_to=&publication_doc_type=All&publication_type=All&publication_biblevel=All&topic=8360&work_area=8190&subsidiary_body=All&country=All&related_project=All&regional_office=All';
        } else if (theme == 2) {
          link_f = 'https://www.cepal.org/es/listado/cepal_publication?title=%22inversi%C3%B3n+p%C3%BAblica%22&sort_bef_combine=date_DESC&date_from=&date_to=&publication_doc_type=All&publication_type=All&publication_biblevel=All&topic=All&work_area=8190&subsidiary_body=All&country=All&related_project=All&regional_office=All';
        } else if (theme == 3) {
          link_f = 'https://www.cepal.org/es/listado/cepal_publication?title=&sort_bef_combine=date_DESC&date_from=&date_to=&publication_doc_type=All&publication_type=All&publication_biblevel=All&topic=49&work_area=8190&subsidiary_body=All&country=All&related_project=All&regional_office=All';
        } else if (theme == 5) {
          link_f = 'https://www.cepal.org/es/listado/cepal_publication?title=%22territorial%22&sort_bef_combine=date_DESC&date_from=&date_to=&publication_doc_type=All&publication_type=All&publication_biblevel=All&topic=All&work_area=8190&subsidiary_body=All&country=All&related_project=All&regional_office=All';
        } else if (theme == 6) {
          link_f = 'https://www.cepal.org/es/listado/cepal_publication?title=urbano&sort_bef_combine=date_DESC&date_from=&date_to=&publication_doc_type=All&publication_type=All&publication_biblevel=All&topic=All&work_area=All&subsidiary_body=All&country=All&related_project=All&regional_office=All';
        } else if (theme == 7) {
          link_f = 'https://www.cepal.org/es/listado/cepal_publication?title=%22movilidad+urbana%22&sort_bef_combine=date_DESC&date_from=&date_to=&publication_doc_type=All&publication_type=All&publication_biblevel=All&topic=All&work_area=All&subsidiary_body=All&country=All&related_project=All&regional_office=All';
        }
        svg_icon = svg_icon_documentos;
        image_icon_external_link = '<img src="images/extlink.png" height="20" style="margin-top:-3px;margin-left:8px;" />';
        window_open_target = '_blank';
      } else if (link == 'mec-art-pst') {
        link_f = 'es/mecanismos-de-articulacion-institucional';
        if (lang == "en") { link_f = 'en/institutional-coordination-mechanisms'; };
        svg_icon = svg_mecanismos_articulacion;
      } else if (link == 'miembros-alianza-foro') {
        //link_f='miembros-alianza.html?lang=es&theme='+num_theme;
        //link_f='instituciones.html?lang=es&theme='+num_theme+'&miembros=alianza-gobierno-abierto';
        link_f = 'es/foros-multiactor-de-gobierno-abierto';
        if (lang == "en") { link_f = 'en/multi-stakeholder-open-government-forums'; };
        svg_icon = svg_miembros_aga;


      } else if (link == 'guia-investigacion') {
        //link_f='guia-iealac.html?lang=es&theme='+num_theme;
        link_f = 'https://biblioguias.cepal.org/EstadoAbierto';
        svg_icon = svg_guia_iea_lac;
        image_icon_external_link = '<img src="images/extlink.png" height="20" style="margin-top:-3px;margin-left:8px;" />';
        window_open_target = '_blank';


      } else {
        link_f = link;
      }

      if (link == 'planes' || link == 'normativas' || link == 'metodologias' || link == 'documentos') {
        de_alc = 'de América Latina y el Caribe';

        if (lang == "en") {
          de_alc = 'of Latin America and the Caribbean';
        }

      }



      if (!description) { description = `${name} ${de_alc}`; };

      if (foto) {

        cells += `
