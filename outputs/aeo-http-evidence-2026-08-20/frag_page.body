            <div class="card h-100 card_foto" style="background-image: url('images/bg_resources/${foto}.jpg'); background-size: cover; background-position: center; width: auto; height: 100vh;border:1px solid white;">
            </div>
          </div>
        `;

      } else {

        if (lang == "en") {
          link_f = link_f.replace("lang=es", "lang=en");
        }


        cells += `
        <div class="col" style="border:1px none green;">
          <div class="card h-100 card_resources" style="padding:20px;padding-top:30px;" <div class="miDiv" onmouseover="cambiarFondo(this)"   onclick="window.open('${link_f}','${window_open_target}');"    >
            ${icon_paises}

            <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top:-10px;">
              <tr>
                <td width="25%" valign="bottom">${svg_icon}</td>
                <td width="75%" valign="bottom" class="card_title_name">${name}${image_icon_external_link}</td>
              </tr>
            </table>

            <div class="card-body" style="margin-left:-20px;margin-right:-20px;">
              <div class="card_line" style="height:2px;background-color:${color};margin-bottom:10px;"></div>
              <div style="float:right;width:40px;border:1px none red;margin-right:0px; margin-left:10px;margin-top:10px;">${svg_icon_ir}</div>
              <div class="card_description" >${description}</div>
            </div>
          </div>
        </div>
      `;

      }


    });


    document.getElementById('boxes').innerHTML = cells + '</div>';

  }










  function displayExternalLinkData(y) {

    let z = y.filter(x => x.theme == theme);

    let cells = '';
    let color = theme_colors[number_theme];

    z.forEach(x => {

      let logo = x.logo;
      let title = x.title_es;
      let subtitle = x.subtitle_es;
      let description = x.description_es;
      let link = x.link_es;

      let text_ver = "Ver";
      if (lang == "en") {
        title = x.title_en;
        subtitle = x.subtitle_en;
        description = x.description_en;
        link = x.link_en;
        text_ver = "View";
        let logo_en = x.logo_en;
        if (logo_en) {
          logo = logo_en;
        }

      }

      if (!subtitle) { subtitle = ''; }

      cells += `
      <div class="container">
        <div class="row">
          <div class="col-md-3" style="text-align:right;border-right:4px solid ${color};padding-right:30px;">
            <img src="images/logo/${logo}.png" width="100%" style="margin-top:5px;">
          </div>
          <div class="col-md-9" style="padding:10px;padding-left:30px;">
            <div class="extlink_title">${title}</div>
            <div class="extlink_subtitle">${subtitle}</div>
            <div class="extlink_description">${description}</div>
            <div class="extlink_button"><a href="${link}" class="btn extlink_button_btn" target="_blank">${text_ver} &raquo;</a></div>
          </div>
        </div>
      </div>
    `;

    });

    document.getElementById('div_extlink').innerHTML = cells;

    if (theme == 1) {
      const elemento = document.getElementById('div_extlink');
      elemento.style.backgroundColor = '#fff'; // Fondo blanco
      elemento.style.borderTop = '5px solid #ddd'; // Borde superior
      elemento.style.borderBottom = '5px solid #ddd'; // Borde inferior
    } else {
      document.getElementById('div_extlink').style.backgroundColor = '#eee';
    }


    if (cells == '') {
      document.getElementById('div_extlink').style.display = 'none';
    }


  }








  function displayCifrasClaveData(y) {
    console.log(y)

    let z = y.filter(x => x.theme == theme);

    let cells = '';

    z.forEach(x => {

      let type = x.type;
      let title = x.title_es;
      let subtitle = x.subtitle_es;
      if (lang == "en") {
        title = x.title_en;
        subtitle = x.subtitle_en;
      }


      let cifra = '<div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>';

      // En Duro provisorio
      if (theme == 1 || theme == 3) {
        cifra = x.value;
      }


      let color = theme_colors[number_theme];

      let margin_bottom = '';
      if (theme == 1 || theme == 2 || theme == 3) { margin_bottom = 'margin-bottom:15px;'; }

      cells += `
      <div class="col" style="border:1px none green;${margin_bottom}">
        <div class="card h-100" style="padding:10px 30px;border:1px none green;background-color:#eee;"  >
          <div class="card-body" style="margin-left:-20px;margin-right:-20px;border:1px none red;">
            <div style="height:10px;width:40%;background-color:${color};position:absolute;bottom:-5px;left:0px;"></div>
            <div class="cifras_title" ><span id="data_key_type_${type}">${cifra}</span> ${title}</div>
            <div class="cifras_subtitle" >${subtitle}</div>
          </div>
        </div>
      </div>
    `;

    });

    if (cells == '') {
      document.getElementById('div_cifras').style.display = 'none';
    } else {
      //if(theme==1 || theme==2 || theme==3) {
      if (theme == 2) {
        document.getElementById('boxes_cifras').innerHTML = cells;
      } else {
        document.getElementById('boxes_cifras').innerHTML = '<div class="row row-cols-1 row-cols-md-4 g-3" id="cards_cifras">' + cells + '</div>';
        document.getElementById("div_boxes_cifras").className = "col-md-12";

      }

    }


    agregaIFrame();


  }




  fetchJson('include/json_data/json_resources.json?v=3', 'reso');
  fetchJson('include/json_data/json_extlink.json?v=3', 'extlink');
  fetchJson('include/json_data/json_cifras_titulos.json?v=3', 'cifras');
  fetchJson('include/json_data/json_theme_description.json?v=3', 'desc');






  loadAPIContentGlobal();

  function loadAPIContentGlobal() {

    let hexDate2 = new Date().getTime();

    let dataset_token = 'aGxrup3hXkyxrzf8Q3DCLt';

    fetch('https://api-kobo.cepal.org/api-kobo/data?dataset=' + dataset_token)
      //fetch('provisorio.json')
      .then(response => response.json())
      .then(json => {
        let results = json.results;

        let t_code = theme_code[number_theme];
        results = results.filter(x => x.theme == t_code);

        results = results.filter(x => x._validation_status.label == "Approved");

        let color_th = theme_colors[number_theme];

        results.sort(function (a, b) {
          return Number(a.orden) > Number(b.orden) ? 1 : Number(a.orden) < Number(b.orden) ? -1 : 0;
        });

        let cells = '';

        results.forEach((x, i) => {

          let id_content = x['_id'];
          let name = x['texto_vinculo_es'];
          let link = x['url_es'];
          let imagen_attach_name = x['imagen_es'];

          if (lang == "en") {
            name = x['texto_vinculo_en'];
            link = x['url_en'];
            imagen_attach_name = x['imagen_en'];
          }

          imagen_attach_name = imagen_attach_name.replace("@", "");

          let images = x['_attachments'];

          let image = '';
          images.forEach((items, ii) => {
            let filename = items.filename;
            let filename_name = filename.split("/").pop();
            if (filename_name == imagen_attach_name) {
              image = items.download_url;
              //image = image.slice(0, -13);
            };
          });

          let extension_imagen = imagen_attach_name.slice(-3);
          let style_width_auto = 'width:auto;max-width:300px;';
          if (extension_imagen == "svg") {
            style_width_auto = '';
          }

          if (image == 'https://kf-surveystat.cepal.org/api/v2/assets/aGxrup3hXkyxrzf8Q3DCLt/data/32904/attachments/7257' || image == 'https://kf-surveystat.cepal.org/api/v2/assets/aGxrup3hXkyxrzf8Q3DCLt/data/32904/attachments/7256') {
            image = 'images/logo/cosefin.jpg';
          }

          cells += `
              <div class="col">
                <div class="card h-100" style="padding:20px;padding-top:25px;">
                  <div align="center" class="div_bottom" style="min-height:110px;"><a href="${link}" target="_blank"><img src="${image}"  width="220px" border="0" style="max-height:90px;${style_width_auto}" ></a></div>
                  <div class="card-body">
                    <h5 class="card-title border_top" style="border-top:4px solid ${color_th};"><a href="${link}" target="_blank">${name}</a></h5>
                  </div>
                </div>
              </div>
            `;

        });


        document.getElementById('boxes_ext_resources').innerHTML = '<div class="row row-cols-1 row-cols-md-3 g-3" id="cards_resources">' + cells + '</div>';

        if (cells == '') {
          document.getElementById('div_recursos').style.display = 'none';
        }


      })
      .catch((error) => {
        console.error('Error al importar el archivo', error);
      });

  }















  function cambiarFondo(elemento) {
    // Guarda los colores originales para restaurarlos después
    const originalBackground = elemento.style.backgroundColor;
    const originalColor = elemento.style.color;

    // Cambia el fondo y el color del texto
    elemento.style.backgroundColor = theme_colors[number_theme];;
    elemento.style.color = "#ffffff";

    // Cambia el color de todos los textos dentro del div
    const textos = elemento.querySelectorAll("*");
    textos.forEach((text) => {
      text.dataset.originalColor = text.style.color; // Guarda el color original
      text.style.color = "#ffffff";
    });

    // Cambia el color de los SVG dentro del div
    const svgs = elemento.querySelectorAll("svg");
    svgs.forEach((svg) => {
      svg.querySelectorAll(".cls-1").forEach((element) => {
        element.dataset.originalFill = element.style.fill; // Guarda el color original
        element.dataset.originalStroke = element.style.stroke;
        element.style.fill = "#ffffff";
        element.style.stroke = "#ffffff";
      });
    });

    const cardLines = elemento.querySelectorAll(".card_line");
    cardLines.forEach((cardLine) => {
      cardLine.dataset.originalBackground = cardLine.style.backgroundColor; // Guarda el color original
      cardLine.style.backgroundColor = "#ffffff";
    });


    // Muestra una alerta con el nuevo color de fondo
    //alert("El color de fondo es: " + elemento.style.backgroundColor);

    // Evento para restaurar colores cuando se hace mouseout
    elemento.addEventListener("mouseout", function () {
      elemento.style.backgroundColor = originalBackground;
      elemento.style.color = originalColor;

      textos.forEach((text) => {
        text.style.color = text.dataset.originalColor || "";
      });

      svgs.forEach((svg) => {
        svg.querySelectorAll(".cls-1").forEach((element) => {
          element.style.fill = element.dataset.originalFill || "";
          element.style.stroke = element.dataset.originalStroke || "";
        });
      });

      cardLines.forEach((cardLine) => {
        cardLine.style.backgroundColor = cardLine.dataset.originalBackground || "";
      });

    }, { once: true }); // Se ejecuta solo una vez para evitar múltiples eventos
  }





  function agregaIFrame() {


    if (theme == 1) {

      let title_chart_tema_1 = 'Planes nacionales de desarrollo vigentes según temporalidad';
      if (lang == "en") { title_chart_tema_1 = 'Current national development plans by temporality'; };

      document.getElementById("boxes_if_cifras_12").innerHTML = `
        <div class="col" style="width:100%;margin-top:50px;text-align:center;border:1px none red;">
          <div id="title_kpi_charts" style="font-size:24px !important;">${title_chart_tema_1}</div>
          <iframe src="include/echart_maps/chart_planning_for_development.html?v=2&lang=${lang}" scrolling="no" width="100%" height="950px" style="border:none;"></iframe>
        </div>
      `;

    } else if (theme == 2) {

      let url_ver_en_geoportal = 'es/geoportal';
      let texto_ver_en_geoportal = 'Ver en el Geoportal';
      if (lang == "en") {
        url_ver_en_geoportal = 'en/geoportal';
        texto_ver_en_geoportal = 'View in the Geoportal';
      }

      document.getElementById("boxes_if_cifras").innerHTML = `
        <div class="col" style="width:100%">
          <iframe src="include/echart_maps/map_chart_public_investment.html?v=5&lang=${lang}" scrolling="no" width="100%" height="610px" style="border:none;"></iframe>
          <div style="width:100%;"><a href="${url_ver_en_geoportal}" target="_blank" class="btn btn-primary" style="width:100%;">${texto_ver_en_geoportal} <img src="iframe/img/icon_map.png" height="24px" style="margin-top:-3px;" /></a></div>
        </div>
      `;


    } else if (theme == 3) {

      let title_chart_tema_2 = 'Número de planes de acción de gobierno abierto elaborados en la región según escala territorial';
      if (lang == "en") { title_chart_tema_2 = 'Number of open government action plans developed in the region, by territorial scale'; };

      document.getElementById("boxes_if_cifras_12").innerHTML = `
        <div class="col" style="width:100%;margin-top:50px;text-align:center;border:1px none red;">
          <div id="title_kpi_charts" style="font-size:24px !important;">${title_chart_tema_2}</div>
          <iframe src="include/echart_maps/chart_open_government.html?v=2&lang=${lang}" scrolling="no" width="100%" height="530px" style="border:none;"></iframe>
        </div>
      `;

    }


    cambiaColorBtn();

  }


  function cambiaColorBtn() {

    // 1. Crear un estilo CSS personalizado
    const style = document.createElement('style');
    style.innerHTML = `
  .custom-btn {
    background-color: ${theme_colors[number_theme]} !important;
    border-color: ${theme_colors[number_theme]} !important;
    color: white !important;
    transition: background-color 0.3s ease;
  }

  .custom-btn:hover {
    background-color: ${theme_colors_2[number_theme]} !important;
    border-color: ${theme_colors_2[number_theme]} !important;
  }
`;
    document.head.appendChild(style);

    // 2. Aplicar la clase al botón
    const btn = document.querySelector('.btn-primary');
    if ($('.btn-primary').length > 0) {
      btn.classList.add('custom-btn');
    }
  }




</script>


