<script>
  const path = window.location.pathname;
  const btn = document.getElementById("opt_export_excel");

  if (
    path.includes("/es/sistemas-nacionales-de-inversion-publica/") ||
    path.includes("/en/national-public-investment-systems/")
  ) {
    btn.style.display = "block";
  }
</script>

    <script>
        let itime = d.getTime();
        var scriptElm = document.createElement('script');
        scriptElm.src = `iframe/sistemas/sistemas.js?v=${itime}`;
        document.body.appendChild(scriptElm);
    </script>




    <script>


    function seleccionarTexto() {
      let plzField = document.getElementById("search_by_words");
      plzField.select();
      document.getElementById("if_selected").value=1;
    }


    $(document).ready(function() {
      let plzField = document.getElementById("search_by_words");
      plzField.addEventListener("keyup", function(event) {
        if (event.keyCode === 13) {
          buscadorListado();
        }

        if (event.keyCode === 46 || event.keyCode === 8) {
            let if_selected = document.getElementById("if_selected").value;
            if(if_selected==1) {
              buscadorListado();
            }
        }
        document.getElementById("if_selected").value=0;
      });

    });



    document.querySelector('#general_title').addEventListener('mouseenter', () => {
      document.querySelectorAll('select').forEach(select => {
        select.blur();
      });
    });


  </script>


<style>
  .bloque_links_separador { border-top:1px solid #777; margin-top:15px; }
  .bloque_links { border-bottom:1px dotted #BBB; padding:5px 0px; }
  .tab-pane { padding-top:10px; }
  .xsvg_blinks { filter: invert(46%) sepia(72%) saturate(820%) hue-rotate(176deg) brightness(70%) contrast(95%); }
  .snp_title_autoridades { margin-top:10px; margin-bottom:-10px; font-size:18px; font-family: "RobotoCondensed-Medium", sans-serif !important; color:#111; text-transform:uppercase; }
  .listado_box_planes { font-size:18px; }
  .nav1-link_t1, .nav1-link_t2, .nav1-link_t5 { margin-left:0px !important; }
  .nav-pills { margin-left:0px !important; }
  .item_por_pais { border-bottom:1px dotted #eee; }
  .title_planes_vigentes { font-family: "RobotoCondensed-Medium", sans-serif !important; font-size:18px; color:#111; text-transform:uppercase;  }
  .title_banco_proyectos { font-family: "RobotoCondensed-Medium", sans-serif !important; font-size:16px; color:#111; text-transform:uppercase; margin-top:15px; margin-bottom:-5px;  }
  .ver_fich_pais { font-size:13px; font-family: "RobotoCondensed-Regular", sans-serif !important; margin-left:10px; }
</style>

<input type="hidden" id="if_selected" value="0" />
