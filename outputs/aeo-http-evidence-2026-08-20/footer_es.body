    function muestraMenu() {
      $('#menu_total_web').show();
    }


    function applyCustomLeftBar__v1(tdId, color = '#FC9303', width = '6px', heightPercent = 95) {
      const td = $('#' + tdId);
      const content = td.text().trim();

      td.css('position', 'relative').html(`
        <div style="position:absolute; left:0; top:${(100 - heightPercent) / 2}%; height:${heightPercent}%; width:${width}; background-color:${color};"></div>
        <div style="padding-left:7px;">${content}</div>
      `);
    }


    function applyCustomLeftBar(tdId, color = '#FC9303', width = '6px', heightPercent = 95) {
      return false;
