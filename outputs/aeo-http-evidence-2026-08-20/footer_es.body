<script type="text/javascript">

  var scriptElm = document.createElement('script');
  scriptElm.src = `include/text.js?v=${time}`;
  document.body.appendChild(scriptElm);


  //if(lang=="en") { c = 'es'; } else { c = 'en'; };


  var scriptElm = document.createElement('script');
  scriptElm.src = `include/tag_title.js?v=${time}&x=2`;
  document.body.appendChild(scriptElm);


  if(lang=="en") {
    $("body").append("<span class='ir_arriba_obs'><a href='https://ee-surveystat.cepal.org/x/f6AtOvCC/?lang=en' target='_blank'><img id='hover' src='images/observacion_edit.png' width='50px' /></a> <div id='txt_inf_obs'>Report updates</a></div></span>");

  } else {
    $("body").append("<span class='ir_arriba_obs'><a href='https://ee-surveystat.cepal.org/x/f6AtOvCC' target='_blank'><img id='hover' src='images/observacion_edit.png' width='50px' /></a> <div id='txt_inf_obs'>Informar actualizaciones</a></div></span>");
  }



  const hover = document.getElementById("hover");
  const target = document.getElementById("txt_inf_obs");

  hover.addEventListener("mouseenter", () => {
    target.style.display = "block";
  });

  hover.addEventListener("mouseleave", () => {
    target.style.display = "none";
  });

</script>



<style>

  .ir_arriba_obs {
  		padding:0px;	font-size:18px;	color:#fff;
  		position: fixed;	bottom:20px;	right:5px;
  	border-radius:30px;	letter-spacing:1px;	opacity:0.9;
  	filter:alpha(opacity=70); /* IE < 9.0 */
  }


  #hover { opacity:1; }
  #hover:hover { opacity:1; }

  #txt_inf_obs { display:none; background-color:#EFECB4; padding:2px 20px; color:#000; position:absolute; top:10px; right:55px; width:285px; border-radius:8px 8px 0px 8px; text-align:center; }



  @media (min-width: 1920px) {
      .container {
          width: 1600px !important;
          max-width: 1600px !important;
      }
  }
</style>



