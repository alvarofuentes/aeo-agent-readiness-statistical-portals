function loadAPIPlanesInstrumentos() {
  let hexDate = new Date().getTime();
  let dataset_token='aPJUaqc6gbHKCdcXQV3bYh';
  //let filtros_fields='&fields=["_id","name_es","name_en","has_parent","parent_id"]';
  let filtros_fields='';
  fetch('https://api-kobo.cepal.org/api-kobo/data?dataset='+dataset_token+filtros_fields)
    .then(response => response.json())
    .then(json => {
        responseDataPlans_result = json.results; // para bloque links (function nombreDesdeID())
        loadAPIInstitutionsActors()
    })
    .catch((error) => {
        console.error('Error al leer api instituciones', error);
    });
}




function loadAPIInstitutionsActors() {
  let hexDate = new Date().getTime();
  let dataset_token='aMXsEC6SyQngvcTa3fSC93';
  let filtros_fields='&fields=["_id","name_es","name_en","has_parent","parent_id"]';
  fetch('https://api-kobo.cepal.org/api-kobo/data?dataset='+dataset_token+filtros_fields)
    .then(response => response.json())
    .then(json => {
        responseDataInstitutions_result = json.results; // para bloque links (function nombreDesdeID())
        loadAPIContentGlobal()
    })
    .catch((error) => {
        console.error('Error al leer api instituciones', error);
    });
}




function loadAPIContentGlobal() {

var hexDate = new Date().getTime();
var dataset_token='aMXsEC6SyQngvcTa3fSC93';

let filter_by_query='';
if(get_id>0) {
  filter_by_query='&query={"_id":"'+get_id+'"}';
} else {
  filter_by_query='&query={"_validation_status.label":"Approved"}';
}

fetch('https://api-kobo.cepal.org/api-kobo/data?dataset='+dataset_token+'&content=1&survey=1'+filter_by_query)
    .then(response => response.json())
    .then(json => {
        responseDataGlobal = json;
        responseDataGlobal_result = json.results;
        responseDataGlobal_result = calculationJson(responseDataGlobal_result);
        //console.log(json);
        showData('all','all');
        editColorScroll(color_table_head);
    })
    .catch((error) => {
        console.error('Error al importar el archivo', error);
    });

  }






if(miembros=='alianza-gobierno-abierto') {
  document.getElementById('general_title').style.display = "none";
  document.getElementById('cell_select_theme').style.display = "none";
  document.getElementById('texto_alianza').style.display = "block";

if(get_lang=='en') {
  document.getElementById('ogp_title').innerHTML = "Members of the Open Government Partnership and Multi-Stakeholder Forums";
  document.getElementById('ogp_description').innerHTML = `
Members of the Open Government Partnership <a href="https://www.opengovpartnership.org/" target="_blank">https://www.opengovpartnership.org/</a> (OGP) endorse the Open Government Declaration, develop action plans in consultation with civil society, and commit to a public and independent evaluation of their progress. To participate in the OGP, governments must demonstrate their commitment to open government by meeting a set of (minimum) performance criteria across key dimensions that are especially important for increasing government responsiveness, strengthening citizen engagement, and combating corruption, as well as adhering to the norms and values ​​of democratic governance set out in the Open Government Declaration. Basic eligibility is determined through assessments of countries' performance in four critical open government areas: fiscal transparency, access to information, asset disclosure, and citizen engagement.

  `;

}

}



let items_mn = [];
let indiceActual = 0;


  function showData(type_filter,filter) {

    //reset
    items_mn = [];
    indiceActual = 0;


      let results = responseDataGlobal_result;


      if(miembros=='alianza-gobierno-abierto') {
        results = results.filter(x => x['responsible_coordinator'] == "responsible" || x['responsible_coordinator'] == "coordinator");
      } else {
        results = results.filter(x => x.visible_in_table == "yes");
      }

      console.log("OPENN");
      console.log(results);


      if(get_country.length === 3) {
        results = results.filter(x => x.country == get_country);
      }



    if(miembros=='alianza-gobierno-abierto') {

      results.sort(function(a, b) {
        const countryOrder = a.country.localeCompare(b.country);
        if (countryOrder !== 0) return countryOrder;

        const terrScale = a.territorial_scale.localeCompare(b.territorial_scale);
        if (terrScale !== 0) return terrScale;

        const terrScale1 = (a.subnational_area ?? '').localeCompare(b.subnational_area ?? '');
        if (terrScale1 !== 0) return terrScale1;

        const terrScale2 = (a.municipality ?? '').localeCompare(b.municipality ?? '');
        if (terrScale2 !== 0) return terrScale2;

        const terrScale3 = (a.city ?? '').localeCompare(b.city ?? '');
        if (terrScale3 !== 0) return terrScale3;

        //const terrScale1 = a.subnational_area.localeCompare(b.subnational_area);
        //if (terrScale1 !== 0) return terrScale1;



        const respCoord = a.responsible_coordinator.localeCompare(b.responsible_coordinator);
        if (respCoord !== 0) return respCoord;

        return 0;
      });

    } else {

      results.sort(function(a, b) {
        // Orden por country
        const countryOrder = a.country.localeCompare(b.country);
        if (countryOrder !== 0) return countryOrder;

        // Orden nombre A-Z
        const nameOrder = a.name_es.localeCompare(b.name_es);
        if (nameOrder !== 0) return nameOrder;

        return 0;
      });


    };


    //-------------------------------- ORDEN PADRE HIJO 4 NIVELES
    let var_0 = `_id`;
    let var_2 = `name_es`;
    let var_2_en = `name_en`;




    let number_theme_icon = get_url_theme;

    let id_last_content;
    countGlobalResultsFilter=0;


    if(miembros=='alianza-gobierno-abierto') { } else {

    function cargaDatosenTablaOrdenaNiveles(nivel,listado,listado_padres) {


      let results_ordenado_por_niveles = [];


      let idsToRemove = [];
      let cuenta_lista = 0;

      if(nivel==0) {

        listado.forEach((x, i) => {
          let has_parent = x['has_parent'];
          let id = x['_id'];

            if(has_parent=="no") {
              idsToRemove.push(id);
              cuenta_lista++;

              numeracion = cuenta_lista * 1000000000000000000;
              x['orden_listado'] = numeracion;
              x['orden_listado_nivel'] = 0;

              results_ordenado_por_niveles.push(x); //NUEVA LISTA

          }

        });






      } else if(nivel==1 || nivel==2) {

        listado.forEach((x, i) => {
          let parent_id = x['parent_id'];
          let id = x['_id'];

              const datos_padre = listado_padres.find(item => item._id == parent_id); //busca padre

              if(datos_padre) {

                idsToRemove.push(id);
                cuenta_lista++;

                let orden_padre = datos_padre.orden_listado;

                  if(nivel==1) {
                  orden_padre = (cuenta_lista * 1000000000000) + orden_padre;
                } if(nivel==2) {
                  orden_padre = (cuenta_lista * 1000000) + orden_padre;
                } if(nivel==3) {
                  orden_padre = (cuenta_lista * 1000) + orden_padre;
                } else {
                  orden_padre = (cuenta_lista * 1) + orden_padre;
                }

                x['orden_listado'] = orden_padre;
                x['orden_listado_nivel'] = nivel;

                results_ordenado_por_niveles.push(x); //NUEVA LISTA

              }

        });



      }


      if(idsToRemove.length>0) {
        const idsToRemoveSet = new Set(idsToRemove);
        results = results.filter(item => !idsToRemoveSet.has(item._id));
      }


      return results_ordenado_por_niveles;

    }


    result_con_orden_nivel_0 = cargaDatosenTablaOrdenaNiveles(0,results,0);
    result_con_orden_nivel_1 = cargaDatosenTablaOrdenaNiveles(1,results,result_con_orden_nivel_0);
    result_con_orden_nivel_2 = cargaDatosenTablaOrdenaNiveles(2,results,result_con_orden_nivel_1);
    result_con_orden_nivel_3 = cargaDatosenTablaOrdenaNiveles(3,results,result_con_orden_nivel_2);
    result_con_orden_nivel_4 = cargaDatosenTablaOrdenaNiveles(4,results,result_con_orden_nivel_3);


    let result_niveles = [...result_con_orden_nivel_0, ...result_con_orden_nivel_1, ...result_con_orden_nivel_2, ...result_con_orden_nivel_3, ...result_con_orden_nivel_4];


    result_niveles.sort( function( a, b ) {
      return a.orden_listado < b.orden_listado ? -1 : a.orden_listado > b.orden_listado ? 1 : 0;
    });



        results=result_niveles;

    }







      //filta por select
      let filtro_actual = $("#filter_selected").val();

      const option_temas = extraerValoresPorClave(filtro_actual, "theme");
      const paises = extraerValoresPorClave(filtro_actual, "country"); // ["chl", "col"]
      const inst_type = extraerValoresPorClave(filtro_actual, "institution_type");
      const terr_scale = extraerValoresPorClave(filtro_actual, "territorial_scale");
      const activ_today = extraerValoresPorClave(filtro_actual, "active_today");


      if(option_temas.length>0) {
        results = results.filter(x =>
          x.theme?.split(' ').some(x => option_temas.includes(x))
        );
      }

      if(paises.length>0) {
        results = results.filter(x =>
          x.country?.split(' ').some(x => paises.includes(x))
        );
      }

      if(inst_type.length>0) {
        results = results.filter(x =>
          x.institution_type?.split(' ').some(x => inst_type.includes(x))
        );
      }

      if(terr_scale.length>0) {
        results = results.filter(x =>
          x.territorial_scale?.split(' ').some(x => terr_scale.includes(x))
        );
      }

      if(activ_today.length>0) {
        results = results.filter(x =>
          x.active_today?.split(' ').some(x => activ_today.includes(x))
        );
      }


      let encontro_palabra_buscar = 0;

      let array_filters = filtro_actual.split(";");
      array_filters.forEach((item, i) => {
        let array_filters_type = item.split(",");
          let type = array_filters_type[0];
          let name = array_filters_type[1];


          if(country) {
            results = results.filter(x => x.country == country);
          }

          if(get_id_iso) {
            results = results.filter(x => x.country == get_id);
          }

          if(type=="busca") {
            var palabras = name.toLowerCase().split(" ");

            results = results.filter(x =>
                palabras.every(y =>
                    (x.name_es && x.name_es.toLowerCase().includes(y)) ||
                    (x.name_en && x.name_en.toLowerCase().includes(y)) ||
                    (x.parent_actor && x.parent_actor.toLowerCase().includes(y)) ||
                    (x.authority_type && x.authority_type.toLowerCase().includes(y))

                )
            );
            encontro_palabra_buscar = 1;
          }

      });




      let results_count = results.length;
      console.log(results);



      if(results_count>0) {
        loadDataToSelect(results,'theme','select_theme','Todas las áreas de gestión pública');
        loadDataToSelect(results,'country','select_paises','Países');

        loadDataToSelect_multiple(results,'theme','multiselect1-menu','Todas las áreas de gestión pública');
        loadDataToSelect_multiple(results,'country','multiselect2-menu','Todos los países');
        loadDataToSelect_multiple(results,'institution_type','multiselect3-menu','Todos los tipos');
        loadDataToSelect_multiple(results,'territorial_scale','multiselect4-menu','Todos las escalas territoriales');
        loadDataToSelect_multiple(results,'active_today','multiselect6-menu','Todos los estados');
        load_one_time_function=1; //carga una sola vez para select multiples

      }




      let list_content='';
      let list_char_content='';


      if(miembros=="alianza-gobierno-abierto") {

        list_content += '<thead><tr style="background-color:'+color_table_head+';color:white;font-size:14px;width:99.99%; display:table;border-bottom:1px solid white;">'+
        '<td width="3%"> </td>'+
        '<td width="7%" style="padding-left:15px;">'+tabla_title_ogp[1]+'</td>'+
        '<td width="8%">'+tabla_title_ogp[5]+'</td>'+
        '<td width="6%">'+tabla_title_ogp[2]+'</td>'+
        '<td width="8%">'+tabla_title_ogp[4]+'</td>'+
        '<td width="23%">'+tabla_title_ogp[3]+'</td>'+
        '<td width="16%" style="border-left:1px none white;" >'+tabla_title_ogp[6]+'</td>'+
        '<td width="6%" style="padding-right:16px;">'+tabla_title_ogp[9]+'</td>'+
        '</tr></thead>'+
        '<tbody style="overflow-y: scroll;max-height:600px;display:block;width:100%;border:5px none red;" >'+
        '';

      } else {


        list_content += '<thead><tr style="background-color:'+color_table_head+';color:white;font-size:14px;width:99.99%; display:table;border-bottom:1px solid white;">'+
        '<td width="4%">'+tabla_title[0]+'</td>'+
        //'<td width="5%">'+tabla_title[1]+'</td>'+
        '<td width="60%">'+tabla_title[2]+'</td>'+
        '<td width="10%">'+tabla_title[5]+'</td>'+
        '<td width="10%">'+tabla_title[3]+'</td>'+
        '<td width="10%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_title[4]+'</td>'+
        '</tr></thead>'+
        '<tbody id="content_list_table_body" style="overflow-y: scroll;max-height:600px;display:block;width:100%;border:5px none red;" >'+
        '';

      }






      cargaDatosenTabla();


      function cargaDatosenTabla(nivel) {


        let name_foro_coordinator = '';
        let pais_coordinador='';
        let escale_del_coordinador='';

        let link_url_instituciones = 'es/instituciones';
        if(lang=="en") {
          link_url_instituciones = 'en/institutions';
        }

        results.forEach((x, i) => {


          items_mn.push({
            id: x['_id'],
            name: x['name_es']
          });

          let original_language = x['original_language'];
          let tag_name_lang = "&nbsp;<span class='original_language' title='idioma original / original language'>("+original_language+")</span>";
          if(original_language==get_lang) {
            tag_name_lang='';
          }

            //Icono 1 País

            let data_iso_country = x['country'];
            if(!data_iso_country) {
              data_iso_country = 'lac';
            }

            let iso_lowercase = data_iso_country.toLowerCase();

            let coutry_name_label = getLabelFromJson(iso_lowercase);


            let label_icon_country = iso_lowercase;
