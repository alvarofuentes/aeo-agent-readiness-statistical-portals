  function getDataFromParentActor(x,y,z,w) {
    let filter_parent='';
    if(z=='national'){
      filter_parent = responseDataGlobal_result.filter(item => item.territorial_scale == 'national');
      filter_parent = filter_parent.filter(item => item.theme == 'open_government');
      filter_parent = filter_parent.filter(item => item.responsible_coordinator == 'responsible');
      filter_parent = filter_parent.filter(item => item.country == w);
    } else {
      filter_parent = responseDataGlobal_result.filter(item => item._id == x);
    }



    return filter_parent;
  }







  //Selector
  function loadDataToSelect(xf,node,id_select,title) {

      let results;
      if(xf=="all") {
        results = responseDataGlobal_result;
      } else {
        results=xf;
      }

      let var_3 = node;
      let themes = [];

      results.forEach((x, i) => {
          //themes.push(x[var_3]);

          // v2 con multi code separado espacio
          if(x[var_3]) {
          x[var_3].split(" ").forEach(code => {
            if (code.trim()) {
              themes.push(code);
            }
          });
          }

      });

      // 02. LISTA UNICA
      let themes_un_c = uniqueCount(themes);

      //themes EN SELECT
      if (load_one_time == 0) {

        //sort a-z a z

        if(node=='effective_since') {
          themes_un_c.sort( function( a, b ) {
            return a.label > b.label ? -1 : a.label < b.label ? 1 : 0;
          });
        } else if (node=='country') {
          themes_un_c.sort( function( a, b ) {
            return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
          });
        } else {
          themes_un_c.sort( function( a, b ) {
            //return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
            return a.count > b.count ? -1 : a.count < b.count ? 1 : 0;
          });
        }




        document.getElementById(id_select).innerHTML = '<option value="all">'+title+'</option>';

        let name_label_api;

        let texto="";
        let ocurrencia=0;

        let theme_general=0;
        if(get_url_theme>0) {
          theme_general=1;
        }

        themes_un_c.forEach(x => {
            let label = x.label;
            let count = x.count;

            //LABEL para select
            let x_label_2 = getLabelFromJson(label);
            //let x_label_2 = label;

            ocurrencia = buscaOcurrencia(label);
            if(ocurrencia==1) { texto = "selected"; } else { texto = ""; };

            //if(label==undefined) {} else {
            if(label==undefined || label=='N/A') {} else {

            if(x_label_2=='No_Vigente') { x_label_2="No vigente"; };

            document.getElementById(id_select).insertAdjacentHTML('beforeend', `<option ${texto} value="${label}">${x_label_2} (${count})</option>`);
            }
        });

      }
  }






  //Selector
  function loadDataToSelect_multiple(xf,node,id_select,title) {

      let results;
      if(xf=="all") {
        results = responseDataGlobal_result;
      } else {
        results=xf;
      }

      let var_3 = node;
      let themes = [];
      let escalas = [];

      let countttt=1;
      results.forEach((x, i) => {
          escalas.push(x['territorial_scale']);
          //themes.push(x[var_3]);

          // v2 con multi code separado espacio
          if(x[var_3]) {
          //x[var_3].split(" ").forEach(code => { //separa por un espacio
          //x[var_3].split(/ {1,2}/).forEach(code => { //separa por uno o dos espacio
          x[var_3].split(/\s+/).forEach(code => { // solucion definitiva, esto separa por cualquier tipo de espacio (incluso non-breaking space y espacios Unicode)
            if (code.trim()) {
              themes.push(code);
            }
          });
          }
          countttt++;
      });



      // 02. LISTA UNICA
      let themes_un_c = uniqueCount(themes);
      let escala_un_c = uniqueCount(escalas);

      //themes EN SELECT
      if (load_one_time_function == 0) {

        //sort a-z a z
        const ordenPersonalizado_temas = ["development_planning","public_investment","open_government","territorial_development","territorial_planning","urban_development","mobility"];
        const ordenPersonalizado_escala = ["international","national","subnational","ogp_local"];
        //console.log(node);
        if(node=='xxmethodologic_area') {
          themes_un_c.sort( function( a, b ) {
            return a.label > b.label ? -1 : a.label < b.label ? 1 : 0;
          });

        } else if (node=='theme') {

          themes_un_c.sort(function(a, b) {

            const indexA = ordenPersonalizado_temas.indexOf(a.label);
            const indexB = ordenPersonalizado_temas.indexOf(b.label);

            // Si no está en el patrón, lo mandamos al final
            return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
          });



        } else if (node=='territorial_scale' && miembros=='alianza-gobierno-abierto') {

          escala_un_c.sort(function(a, b) {

            const indexAe = ordenPersonalizado_escala.indexOf(b.label);
            const indexBe = ordenPersonalizado_escala.indexOf(a.label);

            // Si no está en el patrón, lo mandamos al final
            return (indexAe === -1 ? Infinity : indexAe) - (indexBe === -1 ? Infinity : indexBe);
          });


        } else if (node=='country') {
          themes_un_c.sort( function( a, b ) {
            return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
          });
        } else {
          themes_un_c.sort( function( a, b ) {
            //return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
            return a.count > b.count ? -1 : a.count < b.count ? 1 : 0;
          });
        }




        //document.getElementById(id_select).innerHTML = '<option value="all">'+title+'</option>';

        let name_label_api;

        let texto="";
        let ocurrencia=0;

        let theme_general=0;
        if(get_url_theme>0) {
          theme_general=1;
        }

        themes_un_c.forEach(x => {
            let label = x.label;
            let count = x.count;

            //LABEL para select
            let x_label_2 = getLabelFromJson(label);
            if(!x_label_2) {
               x_label_2 = label;
            }
            //let x_label_2 = label;

            ocurrencia = buscaOcurrencia(label);
            if(ocurrencia==1) { texto = "selected"; } else { texto = ""; };

            //if(label==undefined) {} else {
            if(label==undefined || label=='N/A') {} else {

            if(x_label_2=='No_Vigente') { x_label_2="No vigente"; };

            document.getElementById(id_select).insertAdjacentHTML('beforeend', `<label><input type="checkbox" value="${label}" role="option" aria-label="${x_label_2}"> ${x_label_2}</label>`);
            }
        });

        activarMultiselectListener("multiselect1-menu", function (checkbox) {
          updateOutput(); // función que maneja el cambio
        });

        activarMultiselectListener("multiselect2-menu", function (checkbox) {
          updateOutput();
        });

        activarMultiselectListener("multiselect3-menu", function (checkbox) {
          updateOutput();
        });

        activarMultiselectListener("multiselect4-menu", function (checkbox) {
          updateOutput();
        });

        activarMultiselectListener("multiselect6-menu", function (checkbox) {
          updateOutput();
        });


      }
  }




  function activarMultiselectListener(id_select, callback) {
    const container = document.getElementById(id_select);
    if (!container) return;

    container.addEventListener('change', function (e) {
      if (e.target && e.target.matches('input[type="checkbox"]')) {
        callback?.(e.target); // Ejecuta la función que tú definas
      }
    });
  }














      //Filtra datos unicos para selectores
      function uniqueCount(data) {
          let unique = data.filter((value, index, array) => array.indexOf(value) === index);
          let unique_count = [];
          unique.forEach((x, i) => {
              let label_original = x;
              let count = data.filter(elem => elem == x).length;
              unique_count.push({
                  'label': x,
                  'count': count
              })
          });
          return unique_count;
      }













      function visualizaPaises() {
        visualizaSelect('select_paises','country');
      }

      function visualizaThemes() {
        visualizaSelect('select_theme','theme');
      }




      function visualizaSelect(id_select,node) {
        let data_label = document.getElementById(id_select).value;

        if(data_label=="all") {
          resetFilters("all");
          return false;
        }

        let filtro_actual = $("#filter_selected").val();
        $("#filter_selected").val(filtro_actual+";"+node+","+data_label);

        //reload list whith filter
        showData(node,data_label);

        //resetea filtros

        $("#display_filters").show();
        displayFilters();
      }









      function displayFilters() {
        let filtro_actual = $("#filter_selected").val();

        let total_filters_badge_v2 = "";

        let array_filters = filtro_actual.split(";");
        let largo_arr_filter = array_filters.length;
        array_filters.forEach((item, i) => {
          let array_filters_type = item.split(",");
            let type = array_filters_type[0];
            let name = array_filters_type[1];

            if(type==0 || name==0 || type!='busca') {}  else {

              let name_lang = getLabelFromJson(name);
              //let name_lang = name;

              //horizontal version
              total_filters_badge_v2+="<span class='badge_remove_filter_v2' style='margin-right:8px' data-filter='"+type+","+name+"'>   "+name_lang+" <span class='b_rem_close'><img src=\"iframe/img/icon_filter_reset.png\" height=\"13px\" style=\"margin-top:-4px\" /></span> </span> ";
            }

        });

        document.getElementById('display_filters').innerHTML = '';

        //horizontal version
        let reset_all_filters = ` <span id="opt_remove_all_filters">|&nbsp; <span class="button_filter" onclick="resetFilters(1)" style="padding:3px 6px;" > <span id="filter_opt_2_v2">Reset</span> <img src=\"iframe/img/icon_filter_reset.png\" height=\"13px\" style=\"margin-top:-4px\" /></span> </span>  `;
        document.getElementById('display_filters').innerHTML = '<span id="filter_opt_1">Filters</span> '+total_filters_badge_v2+reset_all_filters;

        $.each(ficha_iapt_filters_labels, function (i, html_content) {
            $("#" + i).html(html_content[0 + language_number]);
        });

        removeClickJS();

        if(largo_arr_filter<3) {
          $("#opt_remove_all_filters").hide();
        } else {
          $("#opt_remove_all_filters").show();
        }


      }













      function resetFilters(x) {

        if(x=="allword") {

          let filtro_actual = $("#filter_selected").val();
          filtro_actual = filtro_actual.replace(/;busca,[^;]*/g, ""); //elimina busqueda anterior del filter_selected
          $("#filter_selected").val(filtro_actual);

          displayFilters();
          showData("all","all");


        } else {

        $("#select_theme").val("all");

        if(x=="word"){}else{
        $("#search_by_words").val("");
        }

        $("#display_filters").hide();
        $("#filter_selected").val("0");

        showData("all","all");


        //loadTheme("all");
        loadDataToSelect('all','theme','select_theme','Temas');

        clearSelections('multiselect1');
        clearSelections('multiselect2');
        clearSelections('multiselect3');
        clearSelections('multiselect4');

        $("#display_filters").html("");

        }

      }








      function buscaOcurrencia(v) {
        let valret=0;

        if(v==undefined || v=="") {
          //return valret;
        }

        let filtro_actual = $("#filter_selected").val();



        let array_filters = filtro_actual.split(";");
        array_filters.forEach((item, i) => {
          let array_filters_type = item.split(",");
            let type = array_filters_type[0];
            let name = array_filters_type[1];

            if(v==name) {
              valret=1;
              return valret;
            }

        });

        return valret;
      }









      function buscadorListado() {
        let keyword = document.getElementById("search_by_words").value;
        let largo = keyword.length;
        if(largo<1) {
          resetFilters("allword");
          showData("all","all");
          return false;
        }
        if(largo>3) {


          let filtro_actual = $("#filter_selected").val();
          //evita 2 busquedas
          filtro_actual = filtro_actual.replace(/;busca,[^;]*/g, ""); //elimina busqueda anterior del filter_selected
          $("#filter_selected").val(filtro_actual+";busca,"+keyword);


          //resetFilters("word");
          showData("by_keyword",keyword);


        } else {
          showData("all","all");
          document.getElementById("search_by_words").value='';
        }

        //$("#filter_selected").val("");
        $("#display_filters").show();
        displayFilters();

      }













      function removeClickJS(){
        const spans = document.querySelectorAll('.badge_remove_filter_v2');
          spans.forEach(span => {
              span.addEventListener('click', function() {
                  const filterValue = span.getAttribute('data-filter');
                  removeFilterFromList(filterValue);
              });
          });
      }


      function removeFilterFromList(x) {

        if (x.includes('busca')) {
          document.getElementById('search_by_words').value = "";
          document.getElementById('display_filters').style.display = "none";
        }


        let input = document.getElementById('filter_selected').value;
        let regex = new RegExp(`;?${x}`);
        let nuevoInput = input.replace(regex, '');
        document.getElementById('filter_selected').value = nuevoInput;

        displayFilters();
        showData('all','all');

        if(nuevoInput=='0') {
          $("#display_filters").hide();
        }

        return false;
      }











      //Label segun idioma desde Json Kobo nodo choices
      function getLabelFromJson(label) {

        if(label) {
          let largo_label = label.length;
          //if(largo_label===3) { label = label.toUpperCase(); };
        }

        if(label=="territorial_planning") {
          let teme_5_name="Desarrollo y Ordenamiento Territorial";
          if(languageGlobal=="en") {
            teme_5_name="Territorial Development and Planning";
          }
          return teme_5_name;
        }


        name_label_api_default_multilanguage = `label`;
        let label_from_api='';
        let name_label_api;
        let responseData = responseDataGlobal.choices;
        if(languageGlobal=="es") {
           name_label_api = `label::Espanol (es)`;
        } else if(languageGlobal=="en") {
           name_label_api = `label::English (en)`;
        }
        let x_label = responseData.filter(element=>element.name == label)[0];
        let x_label_2;

        if(x_label) {
            x_label_2 = x_label[name_label_api];

            if(!x_label_2) {
              x_label_2 = x_label[name_label_api_default_multilanguage];
            }

        } else {
            x_label_2 = label;
        }

        //provisorio
        if(x_label_2=="Bolivia") {
          x_label_2="Bolivia (Est. Plur. de)";
          if(languageGlobal=="en") { x_label_2="Bolivia (Plur. State of)"; }
        }
        if(x_label_2=="Venezuela") {
          x_label_2="Venezuela (Rep. Bol. de)";
          if(languageGlobal=="en") { x_label_2="Venezuela (Bol. Rep. of)"; }
        }

        if(miembros=='alianza-gobierno-abierto') {
          if(x_label=="ogp_local" || x_label_2=="ogp_local") {
            x_label_2="Local";
          }
        }


        return x_label_2;

      }









      //Switch listado / ficha
      function view_list_detail(x,number_theme) {
          if (x == 1) {
              document.getElementById("content_list").style.display = "block";
              document.getElementById("content_detail").style.display = "none";
              //parent.document.getElementById("iframe_content").style.height="1200px";

              const urlactual = new URL(window.location.href);
              urlactual.searchParams.delete("id");
              window.history.pushState({}, "", urlactual);

              document.title = title_page;

          } else if (x == 3) {
              window.scrollTo({top: 0});
              document.getElementById("content_list").style.display = "none";
              document.getElementById("content_detail").style.display = "block";
          }
      }


      function title_webpage(name) {
          let current_title = document.title;
          document.title = name + " | " + current_title;
          return false;
      }




