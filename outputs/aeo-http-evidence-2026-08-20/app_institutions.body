          //leads
          let data_leads = data_detail[0]['leads'];
          if(data_leads) {
            document.getElementById("detail_leads").style.display = "block";

            if(data_leads=="open_government_responsible"){
              document.getElementById("detail_leads").innerHTML = 'Institución responsable de Gobierno Abierto';
              if(get_lang=="en") {
                document.getElementById("detail_leads").innerHTML = 'Open Government responsible institution';
              }
            } else if(data_leads=="open_government_coordinator") {
              document.getElementById("detail_leads").innerHTML = 'Foro multiactor';
              if(get_lang=="en") {
                document.getElementById("detail_leads").innerHTML = 'Multi-Stakeholder Forum';
              }
            } else {
              // verificar si hay 2 temas
              let leads_code = data_leads.split(' ');
              let separador = '';
              if(leads_code.length>1) {
                let data_leads_labels = '';
                leads_code.forEach((item, i) => {
                  if(i>0) { separador=', '; };
                  if(i+1==leads_code.length) { separador=' y '; if(get_lang=="en") { separador=' and '; }  };
                  data_leads_labels+= separador + getLabelFromJson(item);
                });
                data_leads=data_leads_labels;
              } else {
                data_leads=getLabelFromJson(data_leads);
              }

              document.getElementById("detail_leads").innerHTML = 'Institución responsable de '+data_leads;
              if(get_lang=="en") {
                document.getElementById("detail_leads").innerHTML = 'Institution responsible for '+data_leads;
              }
            }







          } else {
            document.getElementById("detail_leads").style.display = "none";
          }







