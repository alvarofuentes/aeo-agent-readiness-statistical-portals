            function calculationJson(json){

              json.forEach((item, i) => {

                if(miembros=='alianza-gobierno-abierto') {
                  let terr_scal = item.territorial_scale;
                  if(terr_scal=="subnational") {
                    item.territorial_scale = "ogp_local";
                  }
                }


                  //provisorio
                  let theme_renombrar = item.theme;
                  if(theme_renombrar=="public_investment development_planning") {
                    item.theme = "public_investment";
                  }

              });


              return json;
            }





  function getMultiCodeFromJson____v1____Tags(valor) {
    return valor
      .split(/\s+/)                      // separa en array
      .map(getLabelFromJson)         // transforma cada uno
      .join(", ");                     // une con espacio
  }



  function getMultiCodeFromJsonTags(valor) {
    return valor
      .split(/\s+/) // separa por espacios
      .map(tag => {
        const cssClass = getCssClassForValue(tag); // función que decide la clase CSS
        const label = getLabelFromJson(tag); // tu función que transforma el valor
        return `<span class="badge bg-secondary" style="background-color:${cssClass} !important;font-size:0.9em;">${label}</span>`;
      })
      .join(", ");
  }

  // Función que asigna clase CSS según el valor
  function getCssClassForValue(tag) {

    let number_index_theme = theme_code.indexOf(tag)+1;
    let bg_color_theme = theme_colors_light[number_index_theme];

    return bg_color_theme;

  }



  function getEnglishNameOfInstitution(x) {
    let name='no';
    let array_results = responseDataGlobal_result;

    if(get_id>0) {

    var hexDate = new Date().getTime();
    let query_filter_by_id='&query={"_id":"'+x+'"}';
    fetch('https://api-kobo.cepal.org/api-kobo/data?dataset=aMXsEC6SyQngvcTa3fSC93'+query_filter_by_id)
        .then(response => response.json())
        .then(json => {
            array_results = json.results;
            name = array_results[0].name_en;
            document.getElementById('label_data_successor_name').innerHTML = name;
            return false;
        })
        .catch((error) => {
            console.error('Error al importar el archivo', error);
        });

      } else {
        let get_institution = array_results.filter(item => item._id == x);
        if(get_institution.length==1) {
          name = get_institution[0].name_en;
          document.getElementById('label_data_successor_name').innerHTML = name;
        }
        return false;

      }

  }


    function formatosTexto(texto) {
      //Texto saltos linea
      texto = texto.replace(/\n/g, "<br/>");
      texto = texto.replace(/\n\n/g, "<br/>");
      // Texto negrita: reemplaza *palabra o frase* por <b>palabra o frase</b>
      texto = texto.replace(/\*(.*?)\*/g, '<b>$1</b>');
      return texto;
    }

           // INICIO DESCARGA


document.getElementById("btnExport").addEventListener("click", function () {

    let table = document.getElementById("content_list_table");
    let rows = table.querySelectorAll("tr");

    let csv = [];

    rows.forEach(row => {
        let cols = row.querySelectorAll("td, th");
        let rowData = [];

        cols.forEach((col, index) => {


    let text = col.innerText || col.textContent || "";
    text = text.trim();

  //  1. Si está vacío → buscar imagen (vigencia)
    if (!text) {
        let img = col.querySelector("img");
        if (img) {
            text = img.getAttribute("title") || "";
        }
    }

    // 2. Limpieza extra
    text = text.replace(/\s+/g, " ").trim();

    rowData.push('"' + text.replace(/"/g, '""') + '"');
});

        csv.push(rowData.join(","));
    });

  let BOM = "\uFEFF"; // clave para Excel

  // Validar que hay datos
if (rows.length === 0) {
    alert("No hay datos para exportar");
    return;
}

// Detectar número de columnas (usando la primera fila ya procesada)
let totalCols = csv[0].split(",").length;

//probando título dinámico según tema url
// Obtener parámetro theme desde el URL
let params = new URLSearchParams(window.location.search);
let theme = params.get("theme");

// Detectar idioma
let isEnglish = window.location.href.includes("/en/");

// Mapa de títulos por tema
let titulo = isEnglish 
    ? "Members of the Open Government Partnership and Multi-Stakeholder Forums"
    : "Miembros de la Alianza para el gobierno abierto y foros multiactor";


let fuente_es = "Fuente: Comisión Económica para América Latina y el Caribe (CEPAL), Observatorio Regional de Planificación para el Desarrollo de América Latina y el Caribe [en línea] https://observatorioplanificacion.cepal.org";

let fuente_en = "Source: Economic Commission for Latin America and the Caribbean (ECLAC), Regional Observatory on Planning for Development in Latin America and the Caribbean [online] https://observatorioplanificacion.cepal.org/en";
  
let fuente = isEnglish ? fuente_en : fuente_es;
let tituloRow = Array(totalCols).fill("");
tituloRow[0] = '"' + titulo.replace(/"/g, '""') + '"';

// Crear fila de fuente
let fuenteRow = ['"' + fuente.replace(/"/g, '""') + '"'];

// Insertar título al inicio
csv.unshift(tituloRow.join(","));

// Línea vacía después del título
//csv.splice(1, 0, "");

// Línea vacía antes de la fuente
csv.push("");

// Insertar fuente al final
csv.push(fuenteRow.join(","));

// Crear archivo
let csvFile = new Blob([BOM + csv.join("\n")], { type: "text/csv;charset=utf-8;" });

    let downloadLink = document.createElement("a");
    downloadLink.download = "datos_tabla.csv";
    downloadLink.href = window.URL.createObjectURL(csvFile);
    downloadLink.style.display = "none";

    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
});

