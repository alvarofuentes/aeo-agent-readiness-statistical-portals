      function determinarFrasesDesdeArticulo(palabra) {
          const ultimaLetra = palabra.slice(-1).toLowerCase();
          palabra = palabra.toLowerCase();

          if (ultimaLetra === 'a') {
              return 'todas las '+palabra+'s';
          } else if (ultimaLetra === 'o') {
              return 'todos los '+palabra+'s';
            } else if (ultimaLetra === 'n') {
              return 'todos los '+palabra+'es';
          } else {
              return 'todas las '+palabra+'s';
          }
      }








      function verificarIsoPais(dato) {
        return typeof dato === 'string' && /^[a-zA-Z]{3}$/.test(dato);
      }




      function formatearFechaDiaMesAgno(fechaStr) {
        const [anio, mes, dia] = fechaStr.split("-");
        return `${dia}-${mes}-${anio}`;
      }




      function getMultiCodeFromJson(valor) {
        return valor
          .split(" ")                      // separa en array
          .map(getLabelFromJson)         // transforma cada uno
          .join(", ");                     // une con espacio
      }


      // tags
      function getMultiCodeFromJsonTags(valor) {
        return [...new Set( valor
          .split(/\s+/) // separa por espacios
          .map(tag => {
            const cssClass = getCssClassForValue(tag); // función que decide la clase CSS
            const label = getLabelFromJson(tag); // tu función que transforma el valor
            return `<span class="badge bg-secondary" style="background-color:${cssClass} !important;font-size:0.9em;">${label}</span>`;
          }))]
          .join(", ");
      }

      // Función que asigna clase CSS según el valor
      function getCssClassForValue(tag) {

        let number_index_theme = theme_code.indexOf(tag)+1;
        let bg_color_theme = theme_colors_light[number_index_theme];

        return bg_color_theme;

      }
















      function levenshteinDistance(a, b) {
        const matrix = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));

        for (let i = 0; i <= a.length; i++) matrix[i][0] = i;
        for (let j = 0; j <= b.length; j++) matrix[0][j] = j;

        for (let i = 1; i <= a.length; i++) {
          for (let j = 1; j <= b.length; j++) {
            const cost = a[i - 1] === b[j - 1] ? 0 : 1;
            matrix[i][j] = Math.min(
              matrix[i - 1][j] + 1,      // eliminación
              matrix[i][j - 1] + 1,      // inserción
              matrix[i - 1][j - 1] + cost // sustitución
            );
          }
        }

        return matrix[a.length][b.length];
      }

      function similarityPercentage(str1, str2) {
        const clean1 = str1.toLowerCase().replace(/[^\w\s]/gi, '');
        const clean2 = str2.toLowerCase().replace(/[^\w\s]/gi, '');

        const distance = levenshteinDistance(clean1, clean2);
        const maxLength = Math.max(clean1.length, clean2.length);

        const similarity = ((maxLength - distance) / maxLength) * 100;
        return similarity.toFixed(2); // porcentaje con 2 decimales
      }



      function formatDateToMonthYear(dateString, language = 'es') {
        const date = new Date(dateString);
        date.setHours(date.getHours() + 12);

        const monthNames = {
          es: [
            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
          ],
          en: [
            'January', 'February', 'March', 'April', 'May', 'June',
            'July', 'August', 'September', 'October', 'November', 'December'
          ]
        };

        const month = monthNames[language]?.[date.getMonth()];
        const year = date.getFullYear();

        return `${month} ${year}`;
      }


      function linkify(text) {
        const urlRegex = /(https?:\/\/[^\s\)]+)/g;

        return text.replace(urlRegex, function(url) {
          return `<a href="${url}" target="_blank">${url}</a>`;
        });
      }











