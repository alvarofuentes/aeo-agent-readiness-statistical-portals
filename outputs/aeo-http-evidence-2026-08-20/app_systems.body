          // Imagen asociada al Ciclo de la Inversión Pública (Infografía)
          // Se obtiene desde los mismos campos de la API: infog_project_cycle_es / infog_project_cycle_en
          // Intentamos la clave en minúsculas (tal como en tu API) y hacemos fallback a la variante con mayúscula por compatibilidad.
          let info_6_img = data_detail[0]['project_cycle/infog_project_cycle_es'] || data_detail[0]['project_cycle/Infog_project_cycle_es'];
          if(!info_6_img || get_lang=="en") { info_6_img = data_detail[0]['project_cycle/infog_project_cycle_en'] || data_detail[0]['project_cycle/Infog_project_cycle_en']; }
