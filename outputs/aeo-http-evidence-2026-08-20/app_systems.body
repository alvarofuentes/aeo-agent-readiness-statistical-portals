                  <a href="${imagen_descarga}" download style="font-size:0.9em; color:#0066cc; text-decoration:underline;">
                    ${get_lang=='en' ? 'Download original image' : 'Descargar imagen original'}
                  </a>
                </div>
              </div>
            `;
