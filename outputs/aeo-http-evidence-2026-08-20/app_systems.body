      function determinarFrasesDesdeArticulo(palabra) {
          const ultimaLetra = palabra.slice(-1).toLowerCase();
          palabra = palabra.toLowerCase();

          if (ultimaLetra === 'a') {
              return 'todas las '+palabra+'s';
          } else if (ultimaLetra === 'o') {
              return 'todos los '+palabra+'s';
            } else if (ultimaLetra === 'n') {
              return 'todos los '+palabra+'es';
          } else {
              return 'todas las '+palabra+'s';
          }
      }








      function verificarIsoPais(dato) {
        return typeof dato === 'string' && /^[a-zA-Z]{3}$/.test(dato);
      }



      function linkify_v1(text) {
        const urlRegex = /(https?:\/\/[^\s]+)/g;
        return text.replace(urlRegex, function(url) {
          return `<a href="${url}" target="_blank">${url}</a>`;
        });
      }


      //excluye los caracteres finales no deseados:
      function linkify(text) {
        const urlRegex = /(https?:\/\/[^\s\)]+)/g;

        return text.replace(urlRegex, function(url) {
          return `<a href="${url}" target="_blank">${url}</a>`;
        });
      }





      function formatosTexto(texto) {
        //Texto saltos linea
        texto = texto.replace(/\n/g, "<br/>");
        texto = texto.replace(/\n\n/g, "<br/>");
        // Texto negrita: reemplaza *palabra o frase* por <b>palabra o frase</b>
        texto = texto.replace(/\*(.*?)\*/g, '<b>$1</b>');
        return texto;
      }



