let responseDataGlobal;
let responseDataGlobal_result;


function loadAPISistemas() {

  var hexDate = new Date().getTime();

  if(get_url_theme==1) {
    var dataset_token='auat7fCzxrGEmcpQWiTZLu';
  } else if(get_url_theme==2) {
    var dataset_token='aLtk2nwgLUq4A4hNcJv6xR';
  } else if(get_url_theme==5) {
    var dataset_token='a6VSfrLiDjiG4YYpAmdFb3';
  }

let filter_by_query='';
if(get_id>0) {
  filter_by_query='&query={"_id":"'+get_id+'"}';
} else {
  filter_by_query='&query={"_validation_status.label":"Approved"}';
}

fetch('https://api-kobo.cepal.org/api-kobo/data?dataset='+dataset_token+'&content=1&survey=1'+filter_by_query)
    .then(response => response.json())
    .then(json => {
        responseDataGlobal = json;
        responseDataGlobal_result = json.results;
        showData('all','all');
        editColorScroll(color_table_head);
    })
    .catch((error) => {
        console.error('Error al importar el archivo', error);
    });
}





  function showData(type_filter,filter) {

      let results = responseDataGlobal_result;

      if(get_url_theme==1 || get_url_theme==2 || get_url_theme==5) {
        results.sort( function( a, b ) {
          return a.country < b.country ? -1 : a.country > b.country ? 1 : 0;
        });
      }



      //filta por select
      let filtro_actual = $("#filter_selected").val();


      const paises = extraerValoresPorClave(filtro_actual, "country"); // ["chl", "col"]


      if(paises.length>0) {
        results = results.filter(x =>
          x.country?.split(' ').some(x => paises.includes(x))
        );
      }





      let array_filters = filtro_actual.split(";");
      array_filters.forEach((item, i) => {
        let array_filters_type = item.split(",");
          let type = array_filters_type[0];
          let name = array_filters_type[1];


          if(get_id_iso) {
            results = results.filter(x => x.country == get_id);
          }

          if(country) {
            results = results.filter(x => x.country == country);
          }

          if(type=="busca") {
            var palabras = name.toLowerCase().split(" ");

            results = results.filter(x =>
                palabras.every(y =>
                    (x.snp_name_es && x.snp_name_es.toLowerCase().includes(y)) ||
                    (x.snp_name_es && x.snp_name_es.toLowerCase().includes(y)) ||
                    (x.formulation_es && x.formulation_es.toLowerCase().includes(y))

                )
            );
          }

      });




      let results_count = results.length;



      if(results_count>0) {
        let label_select_paises="Países";
        if(get_lang=="en") { label_select_paises="Countries"; };
        loadDataToSelect(results,'country','select_paises',label_select_paises);

        loadDataToSelect_multiple(results,'country','multiselect1-menu','Todos los países');
        load_one_time_function=1; //carga una sola vez para select multiples

      }






      let var_0 = `_id`;

      let var_2;
      let var_2_en;
      if(get_url_theme==1) {
        var_2 = `snp_name_es`;
        var_2_en = `snp_name_en`;
      } else if(get_url_theme==2) {
        var_2 = `snip_name_es`;
        var_2_en = `snip_name_en`;
      } else if(get_url_theme==5) {
        var_2 = `national/national_mechanism_es`;
        var_2_en = `national/national_mechanism_en`;
      }




      let list_content='';
      let list_char_content='';



      if(get_url_theme==2) {
        list_content += '<thead>'+
        '<tr style="background-color:'+color_table_head+';color:white;font-size:14px;width:99.99%; display:table;border-bottom:1px solid white;">'+
        '<td width="5%">'+tabla_snip_title[0]+'</td>'+
        '<td width="16%">'+tabla_snip_title[1]+'</td>'+
        '<td width="16%">'+tabla_snip_title[2]+'</td>'+
        '<td width="16%">'+tabla_snip_title[3]+'</td>'+
        '<td width="16%">'+tabla_snip_title[4]+'</td>'+
        '<td width="16%">'+tabla_snip_title[5]+'</td>'+
        '<td width="6%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_snip_title[6]+'</td>'+
        '</tr></thead>'+
        '<tbody style="overflow-y: scroll;max-height:600px;display:block;width:100%;border:5px none red;" >'+
        '';

      } else {
        list_content += '<thead><tr style="background-color:'+color_table_head+';color:white;font-size:14px;width:99.99%; display:table;border-bottom:1px solid white;">'+
        '<td width="6%">'+tabla_title[0]+'</td>'+
        '<td width="84%">'+tabla_title[1]+'</td>'+
        '<td width="10%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_title[2]+'</td>'+
        '</tr></thead>'+
        '<tbody style="overflow-y: scroll;max-height:600px;display:block;width:100%;border:5px none red;" >'+
        '';

      }






      let number_theme_icon = get_url_theme;


      let id_last_content;
      countGlobalResultsFilter=0;
      results.forEach((x, i) => {

          //Icono 1 País

          let data_iso_country = x['country'];
          if(!data_iso_country) {
            data_iso_country = 'lac';
          }

          let iso_lowercase = data_iso_country.toLowerCase();

