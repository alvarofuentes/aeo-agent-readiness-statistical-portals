            let t2_instr_id_legal = x['legal_primary_instrument_id'];

            let t2_instit = x['responsible_es'];
            let t2_banco_proy = x['project_bank_name_es'];
            if(get_lang=="en") { t2_banco_proy = x['project_bank_name_en']; };
