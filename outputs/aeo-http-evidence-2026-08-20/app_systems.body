            '<td valign="top" width="15%"> ' + label_href_t2_instr_legal +'</td>'+
            '<td valign="top" width="15%"> '+actores_por_pais+'</td>'+
            '<td valign="top" width="15%"><a target="_blank" href="'+t2_banco_proy_url+'"> ' + t2_banco_proy +'</a></td>'+
            '<td valign="top" width="15%"> '+planes_por_pais+'</td>'+
            '<td valign="top" width="5%" align="center" style="cursor: pointer;" onclick="viewDetailContent(' + x[var_0] + ','+number_theme_icon+')"  ><img src="iframe/img/icon_list_ficha.png" /></td>'+
            '</tr>';

          } else {

            list_content += '<tr class="table_initiative_name initiative_row" id="initiative_row_' + x[var_0] + '" style="width:100%; display:table;" >'+
            '<td width="6%"> ' + icon_1_flag +'</td>'+
            '<td width="80%" style="cursor: pointer;" onclick="viewDetailContent(' + x[var_0] + ','+number_theme_icon+')" >'+nombre_plan+'</td>'+
            '<td width="14%" align="center" style="cursor: pointer;" onclick="viewDetailContent(' + x[var_0] + ','+number_theme_icon+')"  ><img src="iframe/img/icon_list_ficha.png" /></td>'+
            '</tr>';

          }





          id_last_content=x[var_0];
          countGlobalResultsFilter++;
      });


      list_content +='</tbody>';
      list_char_content +='</tbody>';


      if(get_id>0 && get_url_theme>0) {

        document.getElementById('option_back_list').style.display = "none";
        viewDetailContent(get_id,get_url_theme);

      }

