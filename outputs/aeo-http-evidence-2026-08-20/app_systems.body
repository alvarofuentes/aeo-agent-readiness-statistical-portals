      fetchJson('include/json_data/json_theme_description_table.json?v=3','desc');

      async function fetchJson(x,y) {
          try {
              const response = await fetch(x);
              if (!response.ok) {
                  throw new Error('Error al cargar el archivo JSON');
              }
              const data = await response.json();
              if(y=='desc'){
                displayDescription(data);
              }

          } catch (error) {
              console.error('Error:', error);
          }
      }


      function displayDescription(y) {

          let z = y.filter(x => x.theme == get_url_theme);
          z.forEach(x => {
            let description = x.description_es;
            if(get_lang=="en") {
              description = x.description_en;
            }

            let parrafos2 = description.split("\r\n\\n\\n\r\n").map(p => `<p>${p}</p>`).join("");

            if(x.context=="system") {
              document.getElementById('general_description').innerHTML = parrafos2;
            }

          });
      }




      function buscaIDLegalFramework (x) {
        let get_item = responseDataLegalFrameworks_result.filter(item => item.legal_framework_es == x);
        if(get_item.length==1) {
          let id = get_item[0]['_id'];
          let url;
          if(get_lang=="en") {
            url = `<a target="_blank" href='en/regulatory-frameworks/?id=${id}'>${x}</a>`;
          } else {
            url =  `<a target="_blank" href='es/marcos-normativos/?id=${id}'>${x}</a>`;
          }
          return url;
        } else {
          return 'no';
        }
      }


      function buscaNombreLegalFramework(x) {
        let get_item = responseDataLegalFrameworks_result.filter(item => item._id == x);
        if(get_item.length==1) {
          let name = get_item[0]['legal_framework_es'];
          if(get_lang=="en") {
            name = get_item[0]['legal_framework_en'];
          }
          let url;
          if(get_lang=="en") {
            url = `<a target="_blank" href='en/regulatory-frameworks/?id=${x}'>${name}</a>`;
          } else {
            url =  `<a target="_blank" href='es/marcos-normativos/?id=${x}'>${name}</a>`;
          }
          return url;
        } else {
          return 'no';
        }
      }



      function buscaIDPlan (x) {
        let get_item = responseDataPlans_result.filter(item => item.name_es == x);
        if(get_item.length==1) {
          let id = get_item[0]['_id'];
          let url;
          if(get_lang=="en") {
            url = `<a target="_blank" href='en/plans-programs-and-instruments/?id=${id}'>${x}</a>`;
          } else {
            url =  `<a target="_blank" href='es/planes-programas-e-instrumentos/?id=${id}'>${x}</a>`;
          }
          return url;
        } else {
          return 'no';
        }
      }


      function buscaActoresPorPais (x,lang) {

        let link = 'es/instituciones';
        //let link_rednip = 'es/redsnip';
        if(lang=="en") {
          link = 'en/institutions';
          //link_rednip = 'en/redsnip';
        }

        let square_margin_left = 'margin-left:0px;width:3px;height:3px;border-radius:2px;margin-top:8px;margin-right:4px;';
        let square_2 = '<div style="background-color:#BC2F54;float:left;margin-right:3px;'+square_margin_left+'"></div>';
        console.log("AQUII"+x);console.log(responseDataInstitutions_result);
        let actores = responseDataInstitutions_result.filter(item => item.country == x && item.territorial_scale === "national" && item.leads?.includes("public_investment") );
        console.log(actores);
        let listado='';
        actores.forEach((item, i) => {

          let id = item['_id'];
          let actor_mas_parent =  buscaNombreInstitucionDesdeId(id,lang)
          listado += `<div class="item_por_pais">${square_2} ${actor_mas_parent}</div>`;


        });
        if(listado!=''){
          return listado;
        }

        return '';
      }




      function buscaPlanesPorPais (x,ficha) {

        let link = 'es/planes-programas-e-instrumentos';
        if(lang=="en") {
          link = 'en/plans-programs-and-instruments';
        }

        let square_margin_left = 'margin-left:0px;width:3px;height:3px;border-radius:2px;margin-top:8px;margin-right:4px;';
        let square_2 = '<div style="background-color:#BC2F54;float:left;margin-right:3px;'+square_margin_left+'"></div>';

        let planes=[];
        if(get_url_theme==1) {
            planes = responseDataPlans_result.filter(item => item.country == x && item.theme == "development_planning" && item.territorial_scale === "national" && item.effective_today == "yes" );
        } else if(get_url_theme==2) {
          planes = responseDataPlans_result.filter(item => item.country == x && item.theme == "public_investment" && item.territorial_scale === "national" && item.effective_today == "yes" );
        } else if(get_url_theme==5) {
          planes = responseDataPlans_result.filter(item => item.country == x && item.theme == "territorial_planning" && item.territorial_scale === "national" && item.effective_today == "yes" );
        }

        let listado='';
        planes.forEach((item, i) => {
          let nombre = item['name_es'];
          let id = item['_id'];
          if(get_lang=="en") { nombre = item['name_en']; };
          let icon = '';
          if(ficha==1) {
            icon = `<img class="svg_blinks" src="iframe/img/svg/links/link_type_plan.svg" width="20px" height="20px">`;
            square_2='';
          }
          listado +=`<div class="item_por_pais">${square_2}${icon} <a href="${link}/?id=${id}">${nombre}</a></div>`;
        });
        if(listado!=''){
          return listado;
        }

        return '';
      }



      function getParentNameEnglish(x,y) {
        let name='nd';
        let get_parent = responseDataInstitutions_result.filter(item => item._id == x);
        if(get_parent.length==1) {
          name = get_parent[0].name_en;
        }
        if(name=='nd') { name=y; }
        return name;
      }

            // INICIO DESCARGA


document.getElementById("btnExport").addEventListener("click", function () {

    let table = document.getElementById("content_list_table");
    let rows = table.querySelectorAll("tr");

    let csv = [];

    rows.forEach(row => {
        let cols = row.querySelectorAll("td, th");
        let rowData = [];

        cols.forEach((col, index) => {

    // Saltar las últimas 2 columnas (Ver ficha / Descargar)
    if (index >= cols.length - 1) return;

    let text = col.innerText || col.textContent || "";
    text = text.trim();

    // 1. Si está vacío → buscar imagen (vigencia)
    if (!text) {
        let img = col.querySelector("img");
        if (img) {
            text = img.getAttribute("title") || "";
        }
    }

    // 2. Limpieza extra
    text = text.replace(/\s+/g, " ").trim();

    rowData.push('"' + text.replace(/"/g, '""') + '"');
});

        csv.push(rowData.join(","));
    });

  let BOM = "\uFEFF"; // clave para Excel

  // Validar que hay datos
if (rows.length === 0) {
    alert("No hay datos para exportar");
    return;
}

// Detectar número de columnas (usando la primera fila ya procesada)
let totalCols = csv[0].split(",").length;

//probando título dinámico según tema url
// Obtener parámetro theme desde el URL
let params = new URLSearchParams(window.location.search);
let theme = params.get("theme");

// Detectar idioma
let isEnglish = window.location.href.includes("/en/");

// Mapa de títulos por tema
let titulo = isEnglish 
    ? "National Public Investment Systems"
    : "Sistemas Nacionales de Inversión Pública";


let fuente_es = "Fuente: Comisión Económica para América Latina y el Caribe (CEPAL), Observatorio Regional de Planificación para el Desarrollo de América Latina y el Caribe [en línea] https://observatorioplanificacion.cepal.org";

let fuente_en = "Source: Economic Commission for Latin America and the Caribbean (ECLAC), Regional Observatory on Planning for Development in Latin America and the Caribbean [online] https://observatorioplanificacion.cepal.org/en";
  
let fuente = isEnglish ? fuente_en : fuente_es;
let tituloRow = Array(totalCols).fill("");
tituloRow[0] = '"' + titulo.replace(/"/g, '""') + '"';

// Crear fila de fuente
let fuenteRow = ['"' + fuente.replace(/"/g, '""') + '"'];

// Insertar título al inicio
csv.unshift(tituloRow.join(","));

// Línea vacía después del título
//csv.splice(1, 0, "");

// Línea vacía antes de la fuente
csv.push("");

// Insertar fuente al final
csv.push(fuenteRow.join(","));

// Crear archivo
let csvFile = new Blob([BOM + csv.join("\n")], { type: "text/csv;charset=utf-8;" });

    let downloadLink = document.createElement("a");
    downloadLink.download = "datos_tabla.csv";
    downloadLink.href = window.URL.createObjectURL(csvFile);
    downloadLink.style.display = "none";

    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
});

