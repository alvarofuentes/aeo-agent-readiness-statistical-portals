          if(info_6_img) {
            let imagen_src = info_6_img.trim();
            let imagen_descarga = '';

            // Si la API devuelve un nombre de archivo pero el registro tiene attachments,
            // buscamos el attachment correspondiente y usamos su download_url.
            if(!imagen_src.match(/^(https?:\/\/|\/|data:)/) && data_detail[0]._attachments) {
              for(let item of data_detail[0]._attachments) {
                let filename_name = item.filename.split('/').pop();
                if(filename_name === imagen_src) {
                  imagen_src = item.download_url.replace("/?format=json", "");
                  break;
                }
              }
            }

            imagen_descarga = imagen_src;

