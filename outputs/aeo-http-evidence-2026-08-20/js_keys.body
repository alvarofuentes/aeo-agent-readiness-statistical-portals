console.log("data key loading");

var hexDate = new Date().getTime();



loadAPIContentGlobal();

function loadAPIContentGlobal() {

  let filtros_fields='&fields=["_id","name_es","name_en"]&query={"_validation_status.label":"Approved"}';

  fetch('https://api-kobo.cepal.org/api-kobo/data?dataset=aPJUaqc6gbHKCdcXQV3bYh'+filtros_fields)
    .then(response => response.json())
    .then(json => {
        let count = json.count;
        let results = json.results;
        //console.log(results);
        document.getElementById('data_key_type_planes').innerHTML = count;
    })
    .catch((error) => {
        console.error('Error al importar el archivo', error);
    });
  }





  loadAPIInstituciones();

  function loadAPIInstituciones() {

    let filtros_fields='&fields=["_id","name_es","name_en"]&query={"has_parent":"no","record_type":"unique","visible_in_table":"yes","_validation_status.label":"Approved"}';

    fetch('https://api-kobo.cepal.org/api-kobo/data?dataset=aMXsEC6SyQngvcTa3fSC93'+filtros_fields)
      .then(response => response.json())
      .then(json => {
          let count = json.count;
          let results = json.results;
          //console.log(results);
          document.getElementById('data_key_type_instituciones').innerHTML = count;
      })
      .catch((error) => {
          console.error('Error al importar el archivo', error);
      });
    }




