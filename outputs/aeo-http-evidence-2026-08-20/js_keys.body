    loadAPILegalFrameworks();

    function loadAPILegalFrameworks() {

      let filtros_fields='&fields=["_id","legal_framework_es","legal_framework_en"]&query={"_validation_status.label":"Approved"}';

      fetch('https://api-kobo.cepal.org/api-kobo/data?dataset=aqpKMBhQZJ7QXra8gcyJnn'+filtros_fields)
        .then(response => response.json())
        .then(json => {
            let count = json.count;
