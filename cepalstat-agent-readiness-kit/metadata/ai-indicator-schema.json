{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CEPALSTAT AI-friendly statistical indicator",
  "type": "object",
  "required": ["indicator_id","canonical_name","unit","frequency","geography","definition","source","human_page_url","api_endpoint","semantic_fingerprint","disambiguation_rules"],
  "properties": {
    "indicator_id": {"type":"string"},
    "canonical_name": {"type":"string"},
    "preferred_label": {"type":"string"},
    "alternate_labels": {"type":"array","items":{"type":"string"}},
    "natural_language_queries": {"type":"array","items":{"type":"string"}},
    "unit": {"type":"string"},
    "frequency": {"type":"string"},
    "reference_period": {"type":"string"},
    "geography": {"type":"string"},
    "geography_level": {"type":"string"},
    "dimensions": {"type":"array","items":{"type":"object"}},
    "price_basis": {"type":"string"},
    "volume_or_current": {"type":"string"},
    "reference_year": {"type":["integer","null"]},
    "currency": {"type":"string"},
    "definition": {"type":"string"},
    "interpretation": {"type":"string"},
    "source": {"type":"string"},
    "producer": {"type":"string"},
    "related_indicators": {"type":"array","items":{"type":"string"}},
    "similar_indicators": {"type":"array","items":{"type":"string"}},
    "do_not_confuse_with": {"type":"array","items":{"type":"string"}},
    "do_not_use_when": {"type":"array","items":{"type":"string"}},
    "semantic_fingerprint": {"type":"string"},
    "disambiguation_rules": {"type":"array","items":{"type":"string"}},
    "human_page_url": {"type":"string","format":"uri"},
    "citation_url": {"type":"string","format":"uri"},
    "api_endpoint": {"type":"string","format":"uri"}
  }
}
