  //Selector
  function loadDataToSelect(xf,node,id_select,title) {

      let results;
      if(xf=="all") {
        results = responseDataGlobal_result;
      } else {
        results=xf;
      }

      let var_3 = node;
      let themes = [];

      results.forEach((x, i) => {
          themes.push(x[var_3]);
      });

      // 02. LISTA UNICA
      let themes_un_c = uniqueCount(themes);

      themes_un_c.forEach((x, i) => {
        let code = x.label;
        x.title = getLabelFromJson(code);
      });


      //themes EN SELECT
      if (load_one_time == 0) {

        //sort a-z a z

        let ordenPersonalizado = ["Nacional", "Intermedia", "Local"];
        let ordenPersonalizado_temporalidad = ["Largo Plazo", "Mediano Plazo", "Corto Plazo"];
        let ordenPersonalizado_temas = ["Planificación para el Desarrollo", "Inversión Pública", "Gobierno Abierto", "Desarrollo Territorial", "Desarrollo y Ordenamiento Territorial", "Desarrollo Urbano", "Movilidad Urbana Sostenible"];

        if(get_lang=="en") {
          ordenPersonalizado = ["National", "Subnational", "Local"];
          ordenPersonalizado_temporalidad = ["Long term", "Medium term", "Short term"];
          ordenPersonalizado_temas = ["Planificación para el Desarrollo", "Inversión Pública", "Gobierno Abierto", "Desarrollo Territorial", "Desarrollo y Ordenamiento Territorial", "Desarrollo Urbano", "Movilidad Urbana Sostenible"];
        }


        //console.log(node);
        if(node=='effective_since') {
          themes_un_c.sort( function( a, b ) {
            return a.label > b.label ? -1 : a.label < b.label ? 1 : 0;
          });
        } else if (node=='territorial_scale') {

          themes_un_c.sort(function(a, b) {
            //console.log(a.title);
            const indexA = ordenPersonalizado.indexOf(a.title);
            const indexB = ordenPersonalizado.indexOf(b.title);

            // Si no está en el patrón, lo mandamos al final
            return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
          });

        } else if (node=='temporality_calc') {

          themes_un_c.sort(function(a, b) {
            //console.log(a.title);
            const indexA = ordenPersonalizado_temporalidad.indexOf(a.title);
            const indexB = ordenPersonalizado_temporalidad.indexOf(b.title);

            // Si no está en el patrón, lo mandamos al final
            return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
          });

        } else if (node=='theme') {

          themes_un_c.sort(function(a, b) {
            const indexA = ordenPersonalizado_temas.indexOf(a.title);
            const indexB = ordenPersonalizado_temas.indexOf(b.title);

            // Si no está en el patrón, lo mandamos al final
            return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
          });


        } else if (node=='country') {
          /*
          themes_un_c.sort( function( a, b ) {
            return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
          });
          */
          themes_un_c.sort( function( a, b ) {
            return a.title < b.title ? -1 : a.title > b.title ? 1 : 0;
          });

        } else {
          themes_un_c.sort( function( a, b ) {
            //return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
            return a.count > b.count ? -1 : a.count < b.count ? 1 : 0;
          });
        }




        document.getElementById(id_select).innerHTML = '<option value="all">'+title+'</option>';

        let name_label_api;

        let texto="";
        let ocurrencia=0;

        let theme_general=0;
        if(get_url_theme>0) {
          theme_general=1;
        }

        themes_un_c.forEach(x => {
            let label = x.label;
            let count = x.count;

            //LABEL para select
            let x_label_2 = getLabelFromJson(label);
            //let x_label_2 = label;

            ocurrencia = buscaOcurrencia(label);
            if(ocurrencia==1) { texto = "selected"; } else { texto = ""; };

            //if(label==undefined) {} else {
            if(label==undefined || label=='N/A') {} else {

            if(x_label_2=='No_Vigente') { x_label_2="No vigente"; };

            if(label!='') {
            document.getElementById(id_select).insertAdjacentHTML('beforeend', `<option ${texto} value="${label}">${x_label_2} (${count})</option>`);
            }
            }
        });

      }
  }








        //Selector
        function loadDataToSelect_multiple(xf,node,id_select,title) {

            let results;
            if(xf=="all") {
              results = responseDataGlobal_result;
            } else {
              results=xf;
            }

            let var_3 = node;
            let themes = [];

            let countttt=1;
            results.forEach((x, i) => {
                //themes.push(x[var_3]);

                // v2 con multi code separado espacio
                if(x[var_3]) {
                //x[var_3].split(" ").forEach(code => { //separa por un espacio
                //x[var_3].split(/ {1,2}/).forEach(code => { //separa por uno o dos espacio
                x[var_3].split(/\s+/).forEach(code => { // solucion definitiva, esto separa por cualquier tipo de espacio (incluso non-breaking space y espacios Unicode)
                  if (code.trim()) {
                    themes.push(code);
                  }
                });
                }
                countttt++;
            });



            // 02. LISTA UNICA
            let themes_un_c = uniqueCount(themes);

            themes_un_c.forEach((x, i) => {
              let code = x.label;
              x.title = getLabelFromJson(code);
            });


            //themes EN SELECT
            if (load_one_time_function == 0) {

              //sort a-z a z
              let ordenPersonalizado = ["Nacional", "Intermedia", "Local"];
              let ordenPersonalizado_temporalidad = ["Largo Plazo", "Mediano Plazo", "Corto Plazo"];
              let ordenPersonalizado_temas = ["Planificación para el Desarrollo", "Inversión Pública", "Gobierno Abierto", "Desarrollo Territorial", "Desarrollo y Ordenamiento Territorial", "Desarrollo Urbano", "Movilidad Urbana Sostenible"];

              if(get_lang=="en") {
                ordenPersonalizado = ["National", "Subnational", "Local"];
                ordenPersonalizado_temporalidad = ["Long term", "Medium term", "Short term"];
                ordenPersonalizado_temas = ["Planning for Development", "Public investment", "Open government", "Territorial Development", "Territorial Development and Planning", "Urban Development", "Sustainable Urban Mobolity"];
              }

              if (node=='territorial_scale') {

                themes_un_c.sort(function(a, b) {
                  //console.log(a.title);
                  const indexA = ordenPersonalizado.indexOf(a.title);
                  const indexB = ordenPersonalizado.indexOf(b.title);

                  // Si no está en el patrón, lo mandamos al final
                  return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
                });

              } else if (node=='temporality_calc') {

                themes_un_c.sort(function(a, b) {
                  //console.log(a.title);
                  const indexA = ordenPersonalizado_temporalidad.indexOf(a.title);
                  const indexB = ordenPersonalizado_temporalidad.indexOf(b.title);

                  // Si no está en el patrón, lo mandamos al final
                  return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
                });

              } else if (node=='theme') {

                themes_un_c.sort(function(a, b) {
                  const indexA = ordenPersonalizado_temas.indexOf(a.title);
                  const indexB = ordenPersonalizado_temas.indexOf(b.title);

                  // Si no está en el patrón, lo mandamos al final
                  return (indexA === -1 ? Infinity : indexA) - (indexB === -1 ? Infinity : indexB);
                });


              } else if (node=='country') {
                /*
                themes_un_c.sort( function( a, b ) {
                  return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
                });
                */
                themes_un_c.sort( function( a, b ) {
                  return a.title < b.title ? -1 : a.title > b.title ? 1 : 0;
                });

              } else {
                themes_un_c.sort( function( a, b ) {
                  //return a.label < b.label ? -1 : a.label > b.label ? 1 : 0;
                  return a.count > b.count ? -1 : a.count < b.count ? 1 : 0;
                });
              }



              //document.getElementById(id_select).innerHTML = '<option value="all">'+title+'</option>';

              let name_label_api;

              let texto="";
              let ocurrencia=0;

              let theme_general=0;
              if(get_url_theme>0) {
                theme_general=1;
              }

              themes_un_c.forEach(x => {
                  let label = x.label;
                  let count = x.count;

                  //LABEL para select
                  let x_label_2 = getLabelFromJson(label);
                  if(!x_label_2) {
                     x_label_2 = label;
                  }
                  //let x_label_2 = label;

                  ocurrencia = buscaOcurrencia(label);
                  if(ocurrencia==1) { texto = "selected"; } else { texto = ""; };

                  //if(label==undefined) {} else {
                  if(label==undefined || label=='N/A') {} else {

                  if(x_label_2=='No_Vigente') { x_label_2="No vigente"; };

                  document.getElementById(id_select).insertAdjacentHTML('beforeend', `<label><input type="checkbox" value="${label}" role="option" aria-label="${x_label_2}"> ${x_label_2}</label>`);
                  }
              });

              activarMultiselectListener("multiselect1-menu", function (checkbox) {
                updateOutput(); // función que maneja el cambio
              });

              activarMultiselectListener("multiselect2-menu", function (checkbox) {
                updateOutput();
              });

              activarMultiselectListener("multiselect3-menu", function (checkbox) {
                updateOutput();
              });

              activarMultiselectListener("multiselect4-menu", function (checkbox) {
                updateOutput();
              });

              activarMultiselectListener("multiselect5-menu", function (checkbox) {
                updateOutput();
              });

              activarMultiselectListener("multiselect6-menu", function (checkbox) {
                updateOutput();
              });



            }
        }




        function activarMultiselectListener(id_select, callback) {
          const container = document.getElementById(id_select);
          if (!container) return;

          container.addEventListener('change', function (e) {
            if (e.target && e.target.matches('input[type="checkbox"]')) {
              callback?.(e.target); // Ejecuta la función que tú definas
            }
          });
        }






      //Filtra datos unicos para selectores
      function uniqueCount(data) {
          let unique = data.filter((value, index, array) => array.indexOf(value) === index);
          let unique_count = [];
          unique.forEach((x, i) => {
              let label_original = x;
              let count = data.filter(elem => elem == x).length;
              unique_count.push({
                  'label': x,
                  'count': count
              })
          });
          return unique_count;
      }











