      function leeJsonCompromisos(x,escala) {

        let url = 'https://api-kobo.cepal.org/api-kobo/data?dataset=aeZ5KFGUWe33kaWnowRHH9&content=1&survey=1&query={"plan_id":"'+x+'","_validation_status.label":"Approved"}';
        //console.log(url);
        fetch(url)
            .then(response => response.json())
            .then(json => {
                let data = json.results;
                let choices = json.choices;
                let count = json.count;
                if(count>0) {
                  //console.log("data compromisos");
                  //console.log(data);
                  displayDetailsCompromisos(data,escala,choices);
                } else {
                  document.getElementById('detail_compromisos').style.display="none";
                }
            })
            .catch((error) => {
                console.error('Error al importar el archivo', error);
            });



      }






