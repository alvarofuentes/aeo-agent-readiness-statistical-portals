            let data_c_8 = x['ipd/ipd_other_instrument'];
            data_c_8 = validaIconoActivacion(data_c_8);

            let array_all_car = [0,data_c_1,data_c_2,data_c_3,data_c_4,data_c_5,data_c_6,data_c_7,data_c_8];
