        }




      }





      window.addEventListener('popstate', function (event) {
        if (enFicha) {
          view_list_detail(1,0);
          enFicha = false;
        } else {
          history.back();
        }
      });








      if(get_url_theme>0) { } else {
        document.getElementById('general_description').style.display="none";
      }

      fetchJson('include/json_data/json_theme_description_table.json?v=3','desc');

      async function fetchJson(x,y) {
          try {
              const response = await fetch(x);
              if (!response.ok) {
                  throw new Error('Error al cargar el archivo JSON');
              }
              const data = await response.json();
              if(y=='desc'){
                displayDescription(data);
              }

          } catch (error) {
              console.error('Error:', error);
          }
      }


      function displayDescription(y) {

          let z = y.filter(x => x.theme == get_url_theme);
          z.forEach(x => {
            let description = x.description_es;
            if(get_lang=="en") {
              description = x.description_en;
            }

            let parrafos2 = description.split("\r\n\\n\\n\r\n").map(p => `<p>${p}</p>`).join("");

            if(x.context=="plan") {
              document.getElementById('general_description').innerHTML = parrafos2;
            }

          });
      }









        // Seleccionamos todos los íconos con tooltip
        const icons = document.querySelectorAll('.info-icon');

        icons.forEach(icon => {
          // Crear elemento tooltip
          const tooltip = document.createElement('div');
          tooltip.className = 'tooltip';
          tooltip.innerText = icon.getAttribute('data-tooltip');
          document.body.appendChild(tooltip);

          // Mostrar tooltip al pasar el mouse
          icon.addEventListener('mouseenter', (e) => {
            tooltip.classList.add('show');
            const rect = icon.getBoundingClientRect();
            tooltip.style.top = rect.top - tooltip.offsetHeight - 5 + window.scrollY + 'px';
            tooltip.style.left = rect.left + rect.width / 2 - tooltip.offsetWidth / 2 + window.scrollX + 'px';
          });

          // Ocultar tooltip al salir el mouse
          icon.addEventListener('mouseleave', () => {
            tooltip.classList.remove('show');
          });
        });



// INICIO DESCARGA


document.getElementById("btnExport").addEventListener("click", function () {

    let table = document.getElementById("content_list_table");
    let rows = table.querySelectorAll("tr");

    let csv = [];

    rows.forEach(row => {
        let cols = row.querySelectorAll("td, th");
        let rowData = [];

        cols.forEach((col, index) => {

    // Saltar las últimas 2 columnas (Ver ficha / Descargar)
    if (index >= cols.length - 2) return;

    let text = col.innerText || col.textContent || "";
    text = text.trim();

    // 1. Si está vacío → buscar imagen (vigencia)
    if (!text) {
        let img = col.querySelector("img");
        if (img) {
            text = img.getAttribute("title") || "";
        }
    }

    // 2. Limpieza extra
    text = text.replace(/\s+/g, " ").trim();

    rowData.push('"' + text.replace(/"/g, '""') + '"');
});

        csv.push(rowData.join(","));
    });

  let BOM = "\uFEFF"; // clave para Excel

  // Validar que hay datos
if (rows.length === 0) {
    alert("No hay datos para exportar");
    return;
}

// Detectar número de columnas (usando la primera fila ya procesada)
let totalCols = csv[0].split(",").length;

//probando título dinámico según tema url
// Obtener parámetro theme desde el URL
let params = new URLSearchParams(window.location.search);
let theme = params.get("theme");

// Detectar idioma
let isEnglish = window.location.href.includes("/en/");

// Mapa de títulos por tema
let titulos_es = {
    "1": "Planes nacionales de desarrollo",
    "2": "Planes de inversión pública",
    "3": "Planes de acción de gobierno abierto",
    "5": "Instrumentos de desarrollo y ordenamiento territorial",
    "6": "Instrumentos de desarrollo urbano",
    "7": "Planes de movilidad urbana sostenible"
};

let titulos_en = {
    "1": "National development plans",
    "2": "Public Investment Plans",
    "3": "Open Government Action Plans",
    "5": "Territorial Development and Planning Instruments",
    "6": "Urban Development Instruments",
    "7": "Sustainable Urban Mobility Plans"
};

// Asignar título según idioma y theme
let titulo = isEnglish 
    ? (titulos_en[theme] || "Plans, policies, and public management instruments")
    : (titulos_es[theme] || "Planes, políticas e instrumentos de gestión pública");


let fuente_es = "Fuente: Comisión Económica para América Latina y el Caribe (CEPAL), Observatorio Regional de Planificación para el Desarrollo de América Latina y el Caribe [en línea] https://observatorioplanificacion.cepal.org";

let fuente_en = "Source: Economic Commission for Latin America and the Caribbean (ECLAC), Regional Observatory on Planning for Development in Latin America and the Caribbean [online] https://observatorioplanificacion.cepal.org/en";
  
let fuente = isEnglish ? fuente_en : fuente_es;
let tituloRow = Array(totalCols).fill("");
tituloRow[0] = '"' + titulo.replace(/"/g, '""') + '"';

// Crear fila de fuente
let fuenteRow = ['"' + fuente.replace(/"/g, '""') + '"'];

// Insertar título al inicio
csv.unshift(tituloRow.join(","));

// Línea vacía después del título
//csv.splice(1, 0, "");

// Línea vacía antes de la fuente
csv.push("");

// Insertar fuente al final
csv.push(fuenteRow.join(","));

// Crear archivo
let csvFile = new Blob([BOM + csv.join("\n")], { type: "text/csv;charset=utf-8;" });

    let downloadLink = document.createElement("a");
    downloadLink.download = "datos_tabla.csv";
    downloadLink.href = window.URL.createObjectURL(csvFile);
    downloadLink.style.display = "none";

    document.body.appendChild(downloadLink);
    downloadLink.click();
    document.body.removeChild(downloadLink);
});

