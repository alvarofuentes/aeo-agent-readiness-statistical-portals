          }








          view_list_detail(3,number_theme);

          return false;
      }



      function determinarFrasesDesdeArticulo(palabra) {
          const ultimaLetra = palabra.slice(-1).toLowerCase();
          palabra = palabra.toLowerCase();

          if (ultimaLetra === 'a') {
              return 'todas las '+palabra+'s';
          } else if (ultimaLetra === 'o') {
              return 'todos los '+palabra+'s';
            } else if (ultimaLetra === 'n') {
              return 'todos los '+palabra+'es';
          } else {
              return 'todas las '+palabra+'s';
          }
      }









/* SE REEMPLZÓ LA API aw8PGXvdiurSGxw3P22M6K POR aYbx6ChfCoXf5ijcPYEhoG */

      function getApiDetailsTheme1DevelopmentPlanning(x) {
        
        let dir = 'https://api-kobo.cepal.org/api-kobo/data?dataset=aYbx6ChfCoXf5ijcPYEhoG&query={"plan_id":"'+x+'"}';

        fetch(dir)
            .then(response => response.json())
            .then(json => {
                //console.log("ver plan: "+x);
                //console.log(json);
                let data = json.results[0];
                let count = json.count;
                if(count>0) {
                  displayDetailsTheme1DevelopmentPlanning(data);
                } else {
                  document.getElementById('detail_ejes_01').innerHTML = '';
                }
            })
            .catch((error) => {
                console.error('Error al importar el archivo', error);
            });

            return false;
      };

