                <path fill="#1565EA"  d="M19.32,0C8.65,0,0,8.65,0,19.32s8.65,19.32,19.32,19.32,19.32-8.65,19.32-19.32S29.99,0,19.32,0ZM21.36,27.5l-1.36-1.46,6.15-5.71H8.49v-2h17.66l-6.15-5.71,1.36-1.46,8.8,8.18-8.8,8.18Z" />
