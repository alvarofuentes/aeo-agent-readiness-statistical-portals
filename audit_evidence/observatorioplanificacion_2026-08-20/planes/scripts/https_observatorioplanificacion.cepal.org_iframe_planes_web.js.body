function loadAPIContentGlobal() {
var hexDate = new Date().getTime();

let filter_by_query='';
if(get_id>0) {
  filter_by_query='&query={"_id":"'+get_id+'"}';
} else {
  if(theme_name!='') {
    filter_by_query='&query={"_validation_status.label":"Approved","theme":{"$regex":"'+theme_name+'"}}';
  } else {
    filter_by_query='&query={"_validation_status.label":"Approved"}';
  }
  
}

//API v2 sept 25
fetch('https://api-kobo.cepal.org/api-kobo/data?dataset=aPJUaqc6gbHKCdcXQV3bYh&content=1&survey=1'+filter_by_query)
    .then(response => response.json())
    .then(json => {
        responseDataGlobal = json;
        responseDataGlobal_result = json.results;
        //console.log('responseDataGlobal_result',responseDataGlobal_result);
        responseDataGlobal_result = calculationJson(responseDataGlobal_result);

        if(territorial_scale!="") {
          $("#territorial_scale").val(territorial_scale).change();
          showData("territorial_scale",territorial_scale);
        } else {
          showData('all','all');
        }

        editColorScroll(color_table_head);

        if(get_url_theme==1 || get_url_theme==2) {
          $("#opt_theme_1").show();
        };

    })
    .catch((error) => {
        console.error('Error al importar el archivo', error);
    });
  }
















  let items_mn = [];
  let indiceActual = 0;


  function showData(type_filter,filter) {

      //reset
      items_mn = [];
      indiceActual = 0;

      let results = responseDataGlobal_result;

      if (type_filter == 'all' || filter == 'all') {
        //sin filtro
      } else if (type_filter == 'themes') {
        //filtro por sector economico
        results = results.filter(x => x.theme == filter);
      }

      //siempre filtra por el tema si hay parametro
      if(get_url_theme>0) {
        results = results.filter(x => x.theme == theme_name);
      }

      //filta por select
      let filtro_actual = $("#filter_selected").val();

      const option_temas = extraerValoresPorClave(filtro_actual, "theme");
      const option_type = extraerValoresPorClave(filtro_actual, "instrument_type");
      const option_paises = extraerValoresPorClave(filtro_actual, "country"); // ["chl", "col"]
      const option_escala = extraerValoresPorClave(filtro_actual, "territorial_scale");
      const option_tempo = extraerValoresPorClave(filtro_actual, "temporality_calc");
      const option_vig = extraerValoresPorClave(filtro_actual, "vigency");

      if(option_temas.length>0) {
        results = results.filter(x =>
          x.theme?.split(' ').some(x => option_temas.includes(x))
        );
      }

      if(option_type.length>0) {
        results = results.filter(x =>
          x.instrument_type?.split(' ').some(x => option_type.includes(x))
        );
      }

      if(option_paises.length>0) {
        results = results.filter(x =>
          x.country?.split(' ').some(x => option_paises.includes(x))
        );
      }

      if(option_escala.length>0) {
        results = results.filter(x =>
          x.territorial_scale?.split(' ').some(x => option_escala.includes(x))
        );
      }

      if(option_tempo.length>0) {
        results = results.filter(x =>
          x.temporality_calc?.split(' ').some(x => option_tempo.includes(x))
        );
      }

      if(option_vig.length>0) {
        results = results.filter(x =>
          x.effective_today_calc?.split(' ').some(x => option_vig.includes(x))
        );
      }

      let array_filters = filtro_actual.split(";");
      array_filters.forEach((item, i) => {
        let array_filters_type = item.split(",");
          let type = array_filters_type[0];
          let name = array_filters_type[1];


          if(country) {
            results = results.filter(x => x.country == country);
          }

          if(type=="busca") {
            var palabras = name.toLowerCase().split(" ");

            results = results.filter(x =>
                palabras.every(y =>
                    (x.name_es && x.name_es.toLowerCase().includes(y)) ||
                    (x.name_en && x.name_en.toLowerCase().includes(y)) ||
                    (x.theme_instrument && x.theme_instrument.toLowerCase().includes(y))

                )
            );
          }
      });


      //ordena
      if(get_url_theme==3) {

          results.sort(function (a, b) {
            const countryOrder = a.country.localeCompare(b.country);
            if (countryOrder !== 0) return countryOrder;

            const scaleOrder = { national: 0, subnational: 1 };
            const territorialOrder =
              (scaleOrder[a.territorial_scale] ?? 99) - (scaleOrder[b.territorial_scale] ?? 99);
            if (territorialOrder !== 0) return territorialOrder;
            if (a.territorial_scale === 'subnational' && b.territorial_scale === 'subnational') {
 
              const locA = a.dame || a.city || a.dam || '';
              const locB = b.dame || b.city || b.dam || '';
        
              const locationOrder = locA.localeCompare(locB);
              if (locationOrder !== 0) return locationOrder;
            }

            return Number(b.plan_number) - Number(a.plan_number);
          });


      } else if(get_url_theme>0) {


        results.sort(function (a, b) {
          const countryOrder = a.country.localeCompare(b.country);
          if (countryOrder !== 0) return countryOrder;

          return new Date(b.effective_since) - new Date(a.effective_since);
        });


      } else {

        results.sort(function (a, b) {
          const countryOrder = a.country.localeCompare(b.country);
          if (countryOrder !== 0) return countryOrder;

          const scaleOrder = { national: 0, subnational: 1 };
          const territorialOrder =
            (scaleOrder[a.territorial_scale] ?? 99) - (scaleOrder[b.territorial_scale] ?? 99);
          if (territorialOrder !== 0) return territorialOrder;

          return new Date(b.effective_since) - new Date(a.effective_since);
        });

      }


      let results_count = results.length;

      if(results_count>0) {

      loadDataToSelect(results,'theme','select_theme','Todas las áreas de gestión pública');
      loadDataToSelect(results,'temporality_calc','select_temporalidad','Temporalidad');
      loadDataToSelect(results,'effective_today_calc','select_vigencia','Vigencia');
      loadDataToSelect(results,'instrument_type','select_ppi','Tipo de instrumento');
      loadDataToSelect(results,'country','select_paises','Países');
      loadDataToSelect(results,'territorial_scale','select_escala','Escala territorial');
      loadDataToSelect(results,'effective_since','select_fecha','Fecha');

      loadDataToSelect_multiple(results,'theme','multiselect1-menu','x');
      loadDataToSelect_multiple(results,'instrument_type','multiselect2-menu','x');
      loadDataToSelect_multiple(results,'country','multiselect3-menu','x');
      loadDataToSelect_multiple(results,'territorial_scale','multiselect4-menu','x');
      loadDataToSelect_multiple(results,'temporality_calc','multiselect5-menu','x');
      loadDataToSelect_multiple(results,'effective_today_calc','multiselect6-menu','x');
      load_one_time_function=1; //carga una sola vez para select multiples

      }


      let var_0 = `_id`;
      let var_1 = `theme`;
      let var_2 = `name_es`;
      let var_2_en = `name_en`;
      let var_3 = `instrument_type`;
      //let var_4 = `effective_today`;
      let var_5 = `territorial_scale`;


      let list_content='';
      let list_char_content='';

      let fila_tipo_o_area = '<td width="7%">'+tabla_title[5]+'</td>';
      if(get_url_theme==2 || get_url_theme==3 || get_url_theme==0) {
        fila_tipo_o_area = '';
      } else if(get_url_theme==6) {
        fila_tipo_o_area = '<td width="7%">'+tabla_title[5]+'</td>';
      } else if(get_url_theme==7) {
        fila_tipo_o_area = '';
      }

      let fila_escala = '<td width="9%">'+tabla_title[11]+'</td>';
      if(get_url_theme==1) {
        fila_escala = '';
      }

      let fila_temporalidad = '<td width="9%">'+tabla_title[10]+'</td>';
      if(get_url_theme==3 || get_url_theme==4) {
        fila_temporalidad = '';
      }

      let fila_prior_modal = '';
      if(get_url_theme==7) {
        fila_prior_modal = '<td width="9%">'+tabla_title[8]+'</td>';
      }


      let fila_fechas = '<td width="5%">'+tabla_title[2]+'</td>';
      if(get_url_theme==7) {
        fila_fechas = '<td width="3%">'+tabla_title[3]+'</td><td width="4%">'+tabla_title[4]+'</td>';
      }

      let fila_instrumento = '';
      if(get_url_theme==0) {
        fila_instrumento = '<td width="2%">'+tabla_title[1]+'</td>';
      }


      list_content += '<thead><tr style="background-color:'+color_table_head+';color:white;font-size:14px;width:99.99%; display:table;border-bottom:1px solid white;">'+
      '<td width="4%">'+tabla_title[0]+'</td>'+
      fila_instrumento+
      fila_fechas+
      fila_tipo_o_area+
      '<td width="23%">'+tabla_title[7]+'</td>'+
      fila_prior_modal+
      '<td width="7%">'+tabla_title[9]+'</td>'+
      fila_temporalidad+
      fila_escala+
      '<td width="14%">'+tabla_title[12]+'</td>'+
      '<td width="5%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_title[13]+'</td>'+
      '<td width="5%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_title[14]+'</td>'+
      '<tr></thead>'+
      '<tbody style="overflow-y: scroll;max-height:600px;display:block;width:100%;border:5px none red;" >'+
      //'<tbody style="display:block;width:100%;" >'+
      '';



      if(get_url_theme==1) {

      list_char_content += '<thead><tr style="background-color:'+color_table_head+';color:white;font-size:14px;xwidth:99.99%; xdisplay:table;border-bottom:1px solid white;">'+
      '<td width="4%">'+tabla_charact_title[0]+'</td>'+
      '<td width="25%">'+tabla_charact_title[1]+'</td>'+
      '<td width="7%">'+array_char_label[0]+'</td>'+
      '<td width="7%">'+array_char_label[1]+'</td>'+
      '<td width="7%">'+array_char_label[2]+'</td>'+
      '<td width="7%">'+array_char_label[3]+'</td>'+
      '<td width="7%">'+array_char_label[4]+'</td>'+
      '<td width="7%">'+array_char_label[5]+'</td>'+
      '<td width="7%">'+array_char_label[6]+'</td>'+
      '<td width="7%">'+array_char_label[7]+'</td>'+
      '<td width="5%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_charact_title[2]+'</td>'+
      '<td width="5%" style="border-left:1px none white;" id="filter_table_col_1" >'+tabla_charact_title[3]+'</td>'+
      '</thead>'+
      '<tbody style="overflow-y: scroll;max-height:600px;display:block;width:100%;border:5px none red;" >'+
      '';

    } else if(get_url_theme==2) {

      list_char_content += '<thead><tr style="background-color:'+color_table_head+';color:white;font-size:14px;xwidth:99.99%; xdisplay:table;border-bottom:1px solid white;">'+
      '<td width="4%">'+tabla_charact_title[0]+'</td>'+
      '<td width="25%">'+tabla_charact_title[1]+'</td>'+
      '<td width="7%">'+array2_char_label[0]+'</td>'+
      '<td width="7%">'+array2_char_label[1]+'</td>'+
