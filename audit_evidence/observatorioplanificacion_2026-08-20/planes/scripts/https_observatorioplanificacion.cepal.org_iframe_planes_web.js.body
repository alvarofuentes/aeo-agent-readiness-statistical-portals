      function visualizaSelect(id_select,node) {
        let data_label = document.getElementById(id_select).value;

        if(data_label=="all") {
          resetFilters("all");
          return false;
        }

        let filtro_actual = $("#filter_selected").val();
        $("#filter_selected").val(filtro_actual+";"+node+","+data_label);

        //reload list whith filter
        showData(node,data_label);

        //resetea filtros

        $("#display_filters").show();
        displayFilters();
      }




















      function displayFilters() {
        let filtro_actual = $("#filter_selected").val();

        let total_filters_badge_v2 = "";

        let array_filters = filtro_actual.split(";");
        let largo_arr_filter = array_filters.length;
        array_filters.forEach((item, i) => {
          let array_filters_type = item.split(",");
            let type = array_filters_type[0];
            let name = array_filters_type[1];

            if(type==0 || name==0 || type!='busca') {}  else {

              let name_lang = getLabelFromJson(name);
              //let name_lang = name;

              if(name_lang=="No_Vigente") { name_lang="No Vigente"; }
              //horizontal version
              total_filters_badge_v2+="<span class='badge_remove_filter_v2' style='margin-right:8px' data-filter='"+type+","+name+"'>   "+name_lang+" <span class='b_rem_close'><img src=\"iframe/img/icon_filter_reset.png\" height=\"13px\" style=\"margin-top:-4px\" /></span> </span> ";
            }

        });

        document.getElementById('display_filters').innerHTML = '';

        //horizontal version
        let reset_all_filters = ` <span id="opt_remove_all_filters">|&nbsp; <span class="button_filter" onclick="resetFilters(1)" style="padding:3px 6px;" > <span id="filter_opt_2_v2">Reset</span> <img src=\"iframe/img/icon_filter_reset.png\" height=\"13px\" style=\"margin-top:-4px\" /></span> </span>  `;
        document.getElementById('display_filters').innerHTML = '<span id="filter_opt_1">Filters</span> '+total_filters_badge_v2+reset_all_filters;

        $.each(ficha_iapt_filters_labels, function (i, html_content) {
            $("#" + i).html(html_content[0 + language_number]);
        });

        removeClickJS();

        if(largo_arr_filter<3) {
          $("#opt_remove_all_filters").hide();
        } else {
          $("#opt_remove_all_filters").show();
        }


      }













      function resetFilters(x) {

        if(x=="allword") {

          let filtro_actual = $("#filter_selected").val();
          filtro_actual = filtro_actual.replace(/;busca,[^;]*/g, ""); //elimina busqueda anterior del filter_selected
          $("#filter_selected").val(filtro_actual);

          displayFilters();
          showData("all","all");


        } else {

        $("#select_theme").val("all");

        if(x=="word"){}else{
        $("#search_by_words").val("");
        }

        $("#display_filters").hide();
        $("#filter_selected").val("0");

        showData("all","all");


        //loadTheme("all");
        loadDataToSelect('all','theme','select_theme','Temas');


        clearSelections('multiselect1');
        clearSelections('multiselect2');
        clearSelections('multiselect3');
        clearSelections('multiselect4');
        clearSelections('multiselect5');
        clearSelections('multiselect6');



        $("#display_filters").html("");

        }

      }








      function buscaOcurrencia(v) {
        let valret=0;

        if(v==undefined || v=="") {
          //return valret;
        }

        let filtro_actual = $("#filter_selected").val();



        let array_filters = filtro_actual.split(";");
        array_filters.forEach((item, i) => {
          let array_filters_type = item.split(",");
            let type = array_filters_type[0];
            let name = array_filters_type[1];

            if(v==name) {
              valret=1;
              return valret;
            }

        });

        return valret;
      }









      function buscadorListado() {
        let keyword = document.getElementById("search_by_words").value;
        let largo = keyword.length;
        if(largo<1) {
          resetFilters("allword");
          showData("all","all");
          return false;
        }
        if(largo>3) {


          let filtro_actual = $("#filter_selected").val();
          //evita 2 busquedas
          filtro_actual = filtro_actual.replace(/;busca,[^;]*/g, ""); //elimina busqueda anterior del filter_selected
          $("#filter_selected").val(filtro_actual+";busca,"+keyword);


          //resetFilters("word");
          showData("by_keyword",keyword);


        } else {
          showData("all","all");
          document.getElementById("search_by_words").value='';
        }

        //$("#filter_selected").val("");
        $("#display_filters").show();
        displayFilters();

      }













      function removeClickJS(){
        const spans = document.querySelectorAll('.badge_remove_filter_v2');
          spans.forEach(span => {
              span.addEventListener('click', function() {
                  const filterValue = span.getAttribute('data-filter');
                  removeFilterFromList(filterValue);
              });
          });
      }


      function removeFilterFromList(x) {

        if (x.includes('busca')) {
          document.getElementById('search_by_words').value = "";
          document.getElementById('display_filters').style.display = "none";
        }


        let input = document.getElementById('filter_selected').value;
        let regex = new RegExp(`;?${x}`);
        let nuevoInput = input.replace(regex, '');
        document.getElementById('filter_selected').value = nuevoInput;

        displayFilters();
        showData('all','all');

        if(nuevoInput=='0') {
          $("#display_filters").hide();
        }

        return false;
      }







      function calculationJson(json){

        json.forEach((item, i) => {

            json[i].temporality_calc = item.temporality;

            let effective_today = item.effective_today;
            if(effective_today=="no") {
              json[i].effective_today_calc = 'No_Vigente';
              if(get_lang=="en") { json[i].effective_today_calc = 'Inactive'; }
            } else if(effective_today=="yes") {
              json[i].effective_today_calc = 'Vigente';
              if(get_lang=="en") { json[i].effective_today_calc = 'Active'; }
            } else {
              json[i].effective_today_calc = '';
            }


            //format fechas
            if (item?.effective_since && /^\d{4}-\d{2}-\d{2}$/.test(item.effective_since)) {
              item.effective_since = item.effective_since.slice(0, 4);
            }

            if (item?.effective_until && /^\d{4}-\d{2}-\d{2}$/.test(item.effective_until)) {
              item.effective_until = item.effective_until.slice(0, 4);
            }



            //si es local o si es intermediate ponerl subnacional
            //provisorio
            let escala_renombrar = item.territorial_scale;
            if(escala_renombrar=="local" || escala_renombrar=="intermediate" ) {
              item.territorial_scale = "subnational";
            }





        });

        //console.log(json);


        return json;
      }



























      //Label segun idioma desde Json Kobo nodo choices
      function getLabelFromJson(label) {

        if(label) {
          let largo_label = label.length;
          //if(largo_label===3) { label = label.toUpperCase(); }; //provisorio
        }

        if(label=="territorial_planning") {
          let teme_5_name="Desarrollo y Ordenamiento Territorial";
          if(languageGlobal=="en") {
            teme_5_name="Territorial Development and Planning";
          }
          return teme_5_name;
        }


        name_label_api_default_multilanguage = `label::Espanol (es)`;
        let label_from_api='';
        let name_label_api;
        let responseData = responseDataGlobal.choices;
        if(languageGlobal=="es") {
           name_label_api = `label::Espanol (es)`;
        } else if(languageGlobal=="en") {
           name_label_api = `label::English (en)`;
        }
        let x_label = responseData.filter(element=>element.name == label)[0];
        let x_label_2;

        if(x_label) {
            x_label_2 = x_label[name_label_api];

            if(!x_label_2) {
              x_label_2 = x_label[name_label_api_default_multilanguage];
            }

        } else {
            x_label_2 = label;
        }

        //provisorio
        if(x_label_2=="subnational" || x_label_2=="Subnational") {
          x_label_2="Subnacional";
          if(languageGlobal=="en") {x_label_2="Subnational";}
        }
        if(x_label_2=="Bolivia") {
          x_label_2="Bolivia (Est. Plur. de)";
          if(languageGlobal=="en") { x_label_2="Bolivia (Plur. State of)"; }
        }
        if(x_label_2=="Venezuela") {
          x_label_2="Venezuela (Rep. Bol. de)";
          if(languageGlobal=="en") { x_label_2="Venezuela (Bol. Rep. of)"; }
        }


        return x_label_2;

      }








      //Switch listado / ficha
      function view_list_detail(x,number_theme) {
          if (x == 1) {
              document.getElementById("content_list").style.display = "block";
              document.getElementById("content_detail").style.display = "none";
              //parent.document.getElementById("iframe_content").style.height="1100px";

              const urlactual = new URL(window.location.href);
              urlactual.searchParams.delete("id");
              window.history.pushState({}, "", urlactual);

              document.title = title_page;

          } else if (x == 3) {
              parent.window.scrollTo({top: 0});
              document.getElementById("content_list").style.display = "none";
              document.getElementById("content_detail").style.display = "block";

          }
      }














