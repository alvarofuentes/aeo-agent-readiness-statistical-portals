/* AQUÍ LA ESTRUCTURA NUEVA */

function displayDetailsTheme1DevelopmentPlanning(x) {

    let html = '';
    let items = x.items;

    items.sort((a,b) => Number(a['items/order']) - Number(b['items/order']));

    items.forEach((item, index) => {

        let level = item['items/level'];
        let levelNumber = level.split("_")[1];

        let title = (get_lang=="en")
            ? item['items/title_en'] ?? item['items/title_es']
            : item['items/title_es'];

        let description = (get_lang=="en")
            ? item['items/description_en'] ?? item['items/description_es']
            : item['items/description_es'];

        let sdg = item['items/sdg'];
        let icons = '';

        if(sdg) {
            let sdg_array = sdg.split(" ");
            sdg_array.forEach(code => {
                let num = code.split("_")[1];
                icons += `<img src="images/ods/${num}_es_c.png"
                                alt="${code}"
                                height="28px" />`;
            });
        }

        // Detectar si tiene hijos aunque no sean inmediatos
     let hasChildren = false;

let currentLevel = Number(levelNumber);

for (let j = index + 1; j < items.length; j++) {

    let nextLevel = Number(items[j]['items/level'].split("_")[1]);

    if (nextLevel > currentLevel) {
        hasChildren = true;
        break;
    }

    if (nextLevel <= currentLevel) {
        break; // ya salimos de su “bloque”
    }
}

        html += `
            <div class="plan-item level-${levelNumber}" data-level="${levelNumber}">
                <div class="plan-header" onclick="toggleLevelFromHeader(this)">
                    ${hasChildren 
                        ? `<span class="toggle">▸</span>` 
                        : `<span class="toggle-placeholder"></span>`
                    }
                    <span class="plan-title">${title ?? ''}</span>
                    <span class="plan-ods">${icons}</span>
                </div>
                ${description ? `<div class="plan-description">${description}</div>` : ''}
            </div>
        `;
    });

    document.getElementById('detail_ejes_01').innerHTML = html;

    collapseInitially();
}



/* ===============================
   TOGGLE PROGRESIVO POR NIVEL
=================================*/

function toggleLevelFromHeader(header) {

    let toggle = header.querySelector('.toggle');
    if (!toggle) return; // si no tiene hijos, no hacer nada

    let parent = header.closest('.plan-item');
    let level = Number(parent.dataset.level);
    let next = parent.nextElementSibling;

    let isOpening = toggle.innerHTML === "▸";
    toggle.innerHTML = isOpening ? "▾" : "▸";

    while(next && Number(next.dataset.level) > level) {

        let nextLevel = Number(next.dataset.level);

        if (isOpening) {

            // Mostrar  nivel inferior
          if (isOpening) {

    let firstChildLevel = null;

    let temp = parent.nextElementSibling;

    while (temp && Number(temp.dataset.level) > level) {

        let tempLevel = Number(temp.dataset.level);

        // detectar el primer nivel hijo real
        if (firstChildLevel === null) {
            firstChildLevel = tempLevel;
        }

        // mostrar solo ese nivel (aunque sea 3, 4, etc.)
        if (tempLevel === firstChildLevel) {
            temp.classList.add("visible");
        }

        temp = temp.nextElementSibling;
    }

}

        } else {

            // Al cerrar, ocultar todos los descendientes
            next.classList.remove("visible");

            let innerToggle = next.querySelector('.toggle');
            if (innerToggle) innerToggle.innerHTML = "▸";
        }

        next = next.nextElementSibling;
    }
}



/* ===============================
   ESTADO INICIAL
=================================*/

function collapseInitially() {

    let items = document.querySelectorAll('.plan-item');

    // Ocultar todo
    items.forEach(item => {
        item.classList.remove("visible");
    });

    // Mostrar solo nivel 1
    document.querySelectorAll('.plan-item.level-1')
        .forEach(item => item.classList.add("visible"));

    // Resetear flechas
    document.querySelectorAll('.toggle')
        .forEach(t => t.innerHTML = "▸");
}



function showOnlyLevel1() {
    collapseInitially();
}



function expandAll() {

    document.querySelectorAll('.plan-item').forEach(el => {
        el.classList.add("visible");

        let toggle = el.querySelector('.toggle');
        if (toggle) toggle.innerHTML = "▾";
    });
}

