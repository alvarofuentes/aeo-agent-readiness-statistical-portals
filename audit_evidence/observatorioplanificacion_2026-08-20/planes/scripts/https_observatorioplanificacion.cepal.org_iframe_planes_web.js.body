          <!-- Línea separadora -->
          <line x1="3" y1="9" x2="21" y2="9" stroke="${icon_svg_color_date}" stroke-width="2"/>
          <!-- Cuadrados (días) -->
          <rect x="6" y="11" width="3" height="3" fill="${icon_svg_color_date}"/>
          <rect x="10.5" y="11" width="3" height="3" fill="${icon_svg_color_date}"/>
          <rect x="15" y="11" width="3" height="3" fill="${icon_svg_color_date}"/>
          <rect x="6" y="15.5" width="3" height="3" fill="${icon_svg_color_date}"/>
          <rect x="10.5" y="15.5" width="3" height="3" fill="${icon_svg_color_date}"/>
          <rect x="15" y="15.5" width="3" height="3" fill="${icon_svg_color_date}"/>
          </svg>
          `;


          document.getElementById('detail_date').style.display = 'block';
          if(validity_applies_from=="no" && validity_applies_until=="no") {
            document.getElementById('detail_date').innerHTML = '';
            document.getElementById('detail_date').style.display = 'none';
          } else if(data_fecha_hasta=='' || validity_applies_until=="no") {
            document.getElementById('detail_date').innerHTML = svg_calendar + data_fecha;
          } else {
            document.getElementById('detail_date').innerHTML = svg_calendar + data_fecha+'-'+data_fecha_hasta;
          }




