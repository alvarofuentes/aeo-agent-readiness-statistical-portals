document.addEventListener("keydown", function (event) {
  if (event.ctrlKey) {
    if (event.key.toLowerCase() === "m") {
      event.preventDefault(); // opcional
      procesarSiguienteItem();
    }
  }
});


document.addEventListener("keydown", function (event) {
  if (event.ctrlKey) {
    if (event.key.toLowerCase() === "j") {
      event.preventDefault(); // opcional
      procesarAnteriorItem();
    }
  }
});

function procesarSiguienteItem() {
    let largo = items_mn.length;
    largo = largo-1;

    if(largo<indiceActual) {
      console.log("finlistado");
      return false;
    }
    //console.log(largo);
    const x = items_mn[indiceActual];
    let n = x.id;
    let m = x.name;
    //console.log(n+' '+m);
    viewDetailContent(n,0);
    indiceActual++;
}

function procesarAnteriorItem() {
    indiceActual--;
    if(indiceActual<0) {
      console.log("iniciolistado");
      indiceActual=0;
      return false;
    }
    const x = items_mn[indiceActual];
    let n = x.id;
    let m = x.name;
    viewDetailContent(n,0);
}







function buscaNombreInstitucionDesdeId(x,lang,nivel) {
  let get_item = responseDataInstitutions_result.filter(item => item._id == x);
  //console.log("get_item "+x);
  //console.log(get_item);
  if(get_item.length==1) {
    let name = get_item[0]['name_es'];
    if(lang=="en") {
      name = get_item[0]['name_en'];
    }

    let parent_name='';
    if(nivel==1) { } else {
      let has_parent = get_item[0]['has_parent'];
      if(has_parent=="yes") {
        let parent_id = get_item[0]['parent_id'];
        parent_name=", "+buscaNombreInstitucionDesdeId(parent_id,lang,1);  // con 1 toma un padre, si se deja vacio toma el padre, del padre
      }
    }

    let url;
    if(lang=="en") {
      url = `<a target="_blank" href='en/institutions/?id=${x}'>${name}</a>${parent_name}`;
    } else {
      url =  `<a target="_blank" href='es/instituciones/?id=${x}'>${name}</a>${parent_name}`;
    }
    return url;
  } else {
    return 'no';
  }
}






function editColorScroll(color) {

  //var color = '#ff0000';
  var colorBar = ajustarColor(color, 10);
  var colorMasClaro = ajustarColor(color, 50);
  var colorMasOscuro = ajustarColor(color, -5);

  const style = document.createElement('style');
  style.textContent = `
    tbody::-webkit-scrollbar-track {
      background: ${colorMasClaro};
    }
    tbody::-webkit-scrollbar-thumb {
      background: ${colorBar};
    }
    tbody::-webkit-scrollbar-thumb:hover {
      background: ${colorMasOscuro};
    }
  `;
  document.head.appendChild(style);

}







function ajustarColor(color, porcentaje) {
  const num = parseInt(color.slice(1), 16),
    amt = Math.round(2.55 * porcentaje),
    R = (num >> 16) + amt,
    G = ((num >> 8) & 0x00FF) + amt,
    B = (num & 0x0000FF) + amt;
  return (
    '#' +
    (0x1000000 +
      (R < 255 ? (R < 1 ? 0 : R) : 255) * 0x10000 +
      (G < 255 ? (G < 1 ? 0 : G) : 255) * 0x100 +
      (B < 255 ? (B < 1 ? 0 : B) : 255))
      .toString(16)
      .slice(1)
  );
}






function getQueryVariable(variable) {
    var query = window.location.search.substring(1);
    var vars = query.split("&");
    for (var i = 0; i < vars.length; i++) {
        var pair = vars[i].split("=");
        if (pair[0] == variable) {
            return pair[1];
        }
    }
    return false;
};






