    <script>
        const d2 = new Date();
        let itime = d2.getTime();
        var scriptElm = document.createElement('script');
        scriptElm.src = `iframe/planes/web.js?v=${itime}`;
        document.body.appendChild(scriptElm);
    </script>









    <script>


    function seleccionarTexto() {
      let plzField = document.getElementById("search_by_words");
      plzField.select();
      document.getElementById("if_selected").value=1;
    }


    $(document).ready(function() {
      let plzField = document.getElementById("search_by_words");
      plzField.addEventListener("keyup", function(event) {
        if (event.keyCode === 13) {
          buscadorListado();
        }

        if (event.keyCode === 46 || event.keyCode === 8) {
            let if_selected = document.getElementById("if_selected").value;
            if(if_selected==1) {
              buscadorListado();
            }
        }
        document.getElementById("if_selected").value=0;
      });




      document.getElementById("theme_1_ver_char").onclick = function() {
          document.getElementById("content_list_char").style.display = "block";
          document.getElementById("content_list_table").style.display = "none";
          document.getElementById("theme_1_ver_char").classList.add('active');
          document.getElementById("theme_1_ver_plan").classList.remove('active');
      };

      document.getElementById("theme_1_ver_plan").onclick = function() {
          document.getElementById("content_list_char").style.display = "none";
          document.getElementById("content_list_table").style.display = "table";
          document.getElementById("theme_1_ver_char").classList.remove('active');
          document.getElementById("theme_1_ver_plan").classList.add('active');
      };


    });



    document.querySelector('#general_title').addEventListener('mouseenter', () => {
      document.querySelectorAll('select').forEach(select => {
        select.blur();
      });
    });






  </script>

  <style>
    #theme_1_ver_plan { text-transform:uppercase; margin-right:-5px; }
    .navtabs.active  { background-color:#E8F1F9 !important;  }
    #theme_1_ver_char { text-transform:uppercase; }

    .bloque_links_separador { border-top:1px solid #777; margin-top:15px; }
    .bloque_links { border-bottom:1px dotted #BBB; padding:5px 0px; }

    .detail_content_title_1, .detail_content_title { border:1px none red; padding-left:5px; }
    .detail_content_title { margin-top:-5px; }

    .ver_fich_pais { font-size:14px; font-family: "RobotoCondensed-Regular", sans-serif !important; margin-left:10px; }
    .ver_fich_pais a { text-decoration: none !important; color: #006FAA !important; }
    .ver_fich_pais a:hover { text-decoration: underline !important; }
    #link_country_sheet { margin-left:50px; margin-top:-15px; }

    </style>


<input type="hidden" id="if_selected" value="0" />
