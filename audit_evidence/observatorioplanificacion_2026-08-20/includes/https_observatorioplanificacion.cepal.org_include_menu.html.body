<style>
  .ppal_menu_item {
    margin-right:-20px !important;
    text-transform:none !important;
    font-size:18px !important;
    font-family: "RobotoCondensed-Medium",sans-serif !important;
    font-weight:400;
  }


  .submenu_stats {
    position:absolute;
    width:100%;
    top:40px;
    background-color:white;
    border:1px solid #A6D2E2;
    padding:20px;
    left:0px;
    display:none;
    font-size:14px !important;

  }
  .submenu_stats li .nav-link {
    padding-left:0px;
    margin:0px;
    font-size:18px !important;
    text-transform:none !important;
    font-family: "RobotoCondensed-Regular",sans-serif !important;
  }
  .submenu_stats li {
     list-style-type: none;
     xmargin-left:-20px;
     xmargin-right:-20px;
     border-bottom:1px none #A6D2E2;

  }



  .menu_stat_1 { display:block; }
  .menu_stat_2 { display:none; }
  .navbar-nav { background-color:white; }
  @media only screen and (max-width: 1200px) {
    .menu_stat_1 { display:none; }
    .menu_stat_2 { display:block; }
    .ppal_menu_item {
      font-size:18px !important;
      }
  }

  @media only screen and (max-width: 900px) {
    .menu_stat_1 { display:none; }
    .menu_stat_2 { display:block; }
    .ppal_menu_item {
      font-size:15px !important;
      }
  }


  @media only screen and (max-width: 765px) {
    .menu_stat_1 { display:block; }
    .menu_stat_2 { display:none; }
    .ppal_menu_item {
      font-size:18px !important;
      }
    .navbar-nav { background-color:#CEE2EC;
      border-radius:10px;
     }
  }


  .nav-link img, .menu_icon { float:left; margin-right:8px; }


  nav a:hover { color:#173668 !important; background-color:#C8E7EA; text-decoration:none; }
  .submenu_stats li .nav-link:hover { background-color:#fff;  border-left:4px solid #1D3F59; }



  /* Cambiar el color al hacer clic */
  a.dropdown-item:focus,
  a.dropdown-item:active {
      background-color: #C8E7EA !important; /* Color personalizado */
  }




  #itemenu_disabled:hover { background-color:white;cursor:default;color:#377D9B !important; }


  .menu_rectangle { margin-top:-25px; margin-left:5px; width:15px;height:45px; position:absolute;border-left:1px dotted #ABB; border-bottom:1px dotted #ABC; }



</style>

<script>

$(document).ready(function () {

  function verSubMenuStat(x) {
    document.querySelectorAll(".submenu_stats").forEach(function(element) {
        element.style.display = "none";
    });
    if(x!=0) {
      document.getElementById(x).style.display = 'block';
    }
  }
  function ocultarSubMenuStat(x) {
    document.getElementById(x).style.display = 'none';
  }



  //document.getElementById('btn_showMenuMobile').onclick = showMenuMobile;

  function showMenuMobile(){
    let navbar = document.getElementById('navbarNavCSTAT');
    navbar.classList.toggle('show');
  };



  if(lang=="en") {

    document.querySelectorAll(".dropdown-item").forEach(item => {
        item.setAttribute("href", item.getAttribute("href").replace("lang=es", "lang=en"));
    });

    let theme_titles_menu_2 = ["Planning for development", "Public investment", "Open government", "Territorial development", "Land-use planning", "Urban development", "Urban mobility",'Follow-up, monitoring and evaluation'];

    theme_titles_menu_2.forEach((item, i) => {
      let num = i+1;
      let div_name = 'ppal_menu_2_'+num;
      document.getElementById(div_name).innerHTML = item;
    });


    let titles_menu_3 = ['Plans, programs, and instruments', 'Regulatory frameworks', 'Methodologies'];
    titles_menu_3.forEach((item, i) => {
      let num = i+1;
      let div_name = 'ppal_menu_3_'+num;
      document.getElementById(div_name).innerHTML = item;
    });

    let titles_menu_4 = ['Institutions', 'National planning systems', 'National public investment systems', 'Territorial coordination mechanisms', 'Multi-stakeholder open government forums'];
    titles_menu_4.forEach((item, i) => {
      let num = i+1;
      let div_name = 'ppal_menu_4_'+num;
      document.getElementById(div_name).innerHTML = item;
    });

    let titles_menu_7add = ['Frequently Asked Questions', 'Glossary'];
    titles_menu_7add.forEach((item, i) => {
      let num = i+1;
      let div_name = 'ppal_menu_7_ar'+num;
      document.getElementById(div_name).innerHTML = item;
    });


 //se agregó traducción a Notas Informativas;

    let titles_menu_7 = ['News','Briefing Notes','Courses and workshops'];
    titles_menu_7.forEach((item, i) => {
      let num = i+1;
      let div_name = 'ppal_menu_7_'+num;
      let icon = '<img src="images/extlink.png" height="16" style="margin-top:-3px;margin-left:3px;" />';
      document.getElementById(div_name).innerHTML = item+' '+icon;
    });

 // Cambiar URLs del menú 7 a versión en inglés, faltaba que llevaran al inglés (solo esos ítems)
document.querySelector("#menu_7 a[href*='cepal_news']").setAttribute(
  "href",
  "https://www.cepal.org/en/list/cepal_news?title=&sort_bef_combine=date_DESC&date_from=&date_to=&news_type=2&topic=All&work_area=8190&subsidiary_body=All&country=All&related_project=All&regional_office=All"
);

document.querySelector("#menu_7 a[href*='cepal_note']").setAttribute(
  "href",
  "https://www.cepal.org/en/list/cepal_note?title=&sort_bef_combine=date_DESC&date_from=&date_to=&topic=All&work_area=8190&subsidiary_body=All&country=All&related_project=All&regional_office=All"
);

document.querySelector("#menu_7 a[href*='cepal_course']").setAttribute(
  "href",
  "https://www.cepal.org/en/activities?work_area=8190"
);

    let titles_menu_100 = ['Countries', 'Geoportal', 'News', 'Courses and workshops'];
    titles_menu_100.forEach((item, i) => {
      let num = i+1;
      let div_name = 'ppal_menu_m100_'+num;
      let icon = '<img src="images/extlink.png" height="16" style="margin-top:-3px;margin-left:3px;" />';
      if(num==3 || num==4) {} else { icon =''; };
      document.getElementById(div_name).innerHTML = item+' '+icon;
    });


    document.getElementById('ppal_menu_m100').innerHTML = 'More';


  }


});

</script>






