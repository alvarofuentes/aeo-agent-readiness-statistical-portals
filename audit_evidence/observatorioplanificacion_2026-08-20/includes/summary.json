    "body_excerpt": "\nfunction getQueryVariable(variable) {\n    var query = window.location.search.substring(1);\n    var vars = query.split(\"&\");\n    for (var i=0; i < vars.length; i++) {\n        var pair = vars[i].split(\"=\");\n        if (pair[0] == variable) {\n            return pair[1];\n        }\n    }\n    return false;\n}\n\n\n\nfunction scrollTopPage (){\n  $(\"body\").append(\"<span class='ir-arriba icon-arrow-up2'><img src='images/icon-top.png' width='55px' /></span>\");\n\t$('.ir-arriba').click(function(){\n\t\t$('body, html').animate({\n\t\t\tscrollTop: '0px'\n\t\t}, 300);\n\t});\n\n\t$(window).scroll(function(){\n\t\tif($(this).scrollTop()>0){\n\t\t\t$('.ir-arriba').slideDown(300);\n\t\t} else {\n\t\t\t$('.ir-arriba').fadeOut(300);\n\t\t}\n\t});\n}\n\n\nconst d = new Date();\nlet time = d.getTime();\nif(!Number(time)) { time=Math.floor(Math.random() * 100000000000) + 1; };\n\n$(document).ready(function () {\n//$(\"section\").first().addClass(\"container\");\n//$(\"section\").first().attr( 'id', 'web-content' );\n});\n\nvar lang = getQueryVariable(\"lang\");\nvar theme = getQueryVariable(\"theme\");\n//var plan_id_number = getQueryVariable(\"plan_id\");\nvar id = getQueryVariable(\"id\");\nvar miembros = getQueryVariable(\"miembros\");\nvar country = getQueryVariable(\"country\");\n//var program = getQueryVariable(\"program\");\n\nif(!lang) {\n  //infiere desde URL\n  const langURL = window.location.href;\n  if (langURL.includes(\"en/\")) {\n    var lang = \"en\";\n  } else {\n    var lang = \"es\";\n  }\n}\n"
  }
